Actor WeaponStay : CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  Inventory.Amount 1
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag("DROPPED",0)
	TNT1 A 0 A_ChangeFlag("INVENTORY.NEVERRESPAWN",1)
	Stop
  }
}

Actor WeaponStayToken : Inventory {}

Actor OPWeaponToken : Inventory {}

Actor AdvancedFuckonomicon : RandomSpawner
{ //this weapon doesn't even work outside of LCA, why is it still used?
  DropItem "OccultSpellbook", 256, 20 //vile staff is superior
  DropItem "FantasyStaff", 256, 10 //also as far as I know, nothing drops this,
  DropItem "VileStaff", 256, 1	 //but I'm replacing it just to make sure
}
