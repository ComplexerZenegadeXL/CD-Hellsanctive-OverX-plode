//You should not need to replace these actors unless you are going to use RandomSpawners, which for the love of Satan I don't know why
//you would want to.
Actor CFWeaponSpawnerFX
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("misc/spawn",CHAN_VOICE)
	TNT1 A 0 A_SpawnItemEx("NewItemFog",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor CFWeaponSpawnerBase
{
  +RANDOMIZE
  +THRUACTORS
  -COUNTITEM
  +NOINTERACTION
  //+SERVERSIDEONLY
  var int user_tid;
  var int user_weapon;
  var int user_class;
  var int user_specials[6];
  States
  {
  Nope:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CFCheckWeaponsFlags") == 1,"Respawn")
	Stop
  Pickup:
	TNT1 A 0
	Stop
  SpawnCheck:
	TNT1 A 35 A_JumpIf(ACS_NamedExecuteWithResult("AreYouThere?",user_tid,user_class) == 0,"Nope")
	Loop
  Respawn:
	TNT1 A 1035
	TNT1 A 0 A_SpawnItemEx("CFWeaponSpawnerFX",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFWeaponSpawner",user_class)
	Stop
  }
}

Actor CFChainsawSpawner : CFWeaponSpawnerBase replaces Chainsaw
{
  SpawnID 32
  States
  {
  Spawn:
	TNT1 A 0
	CSAW A 4
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting",special,args[0],args[1])
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting2",args[2],args[3],args[4])
	"####" "#" 0 ACS_NamedExecuteWithResult("CFWeaponSpawner",1)
  SpawnLoop:
    "####" "#" 1
	Wait
  }
}

