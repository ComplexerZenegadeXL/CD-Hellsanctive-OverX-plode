Actor LegendaryRuneSpawner : CustomInventory
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(256,"Spawn1","Spawn2","Spawn3")
	Stop
  Spawn1:
    TNT1 A 0 A_DropItem("LegendaryRune",1)
	Stop
  Spawn2:
    TNT1 A 0 A_DropItem("VitalityRune",1)
	Stop
  Spawn3:
    TNT1 A 0 A_DropItem("AgilityRune",1)
	Stop
  }
}

