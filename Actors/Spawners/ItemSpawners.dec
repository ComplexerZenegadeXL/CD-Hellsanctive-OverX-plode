Actor MineAmmoRandomizer : CustomInventory
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(64,"Spawn2")
  Spawn1:
    TNT1 A 0 A_DropItem("Mineammo",1)
	Stop
  Spawn2:
    TNT1 A 0 A_DropItem("Springmine",1)
	Stop
  }
}

Actor CFBarrelSpawnerBase
{
  Game Doom
  +SHOOTABLE
  +THRUACTORS
  +NOBLOCKMAP
  +NOINTERACTION
  +MOVEWITHSECTOR
  +RELATIVETOFLOOR
  +DONTBLAST
  +NOTARGET
  +NOPAIN
  +RANDOMIZE
  +NOTONAUTOMAP
  +SERVERSIDEONLY
  Health 2147483647
  Mass 2147483647
  Speed 0
  var int user_tid;
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  CheckBarrel:
	TNT1 A 35 A_JumpIf(ACS_NamedExecuteWithResult("CheckBarrel",user_tid) == 0,"Death")
	Loop
  Remove:
    TNT1 A 0
	Stop
  Death:
	TNT1 A 5 A_Die
	TNT1 A 1050 A_BarrelDestroy
	TNT1 A 5 A_Respawn
	Wait
  }
}

Actor CFBarrelSpawner : CFBarrelSpawnerBase Replaces ExplosiveBarrel
{
  SpawnID 125
  States
  {
  Spawn:
	TNT1 A 0
	BAR1 A 4
	"####" "#" 0 ACS_NamedExecuteWithResult("CFBarrelSpawner")
  SpawnLoop:
    "####" "#" 1
	Wait
  }
}

Actor CommanderDevastator : CustomInventory
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(256,"Spawn1","Spawn2")
	Stop
  Spawn1:
    TNT1 A 0 A_DropItem("DemonTechDevastatorGiver",1)
	Stop
  Spawn2:
    TNT1 A 0 A_DropItem("CommanderDevUpgrade",1)
	Stop
  }
}

Actor CFItemSpawnerBase
{
  +RANDOMIZE
  +THRUACTORS
  -COUNTITEM
  +NOINTERACTION
  //+SERVERSIDEONLY
  var int user_tid;
  var int user_class;
  var int user_specials[6];
  States
  {
  CheckItem:
	TNT1 A 35 A_JumpIf(ACS_NamedExecuteWithResult("CheckItem",user_tid,user_class) == 0,"Respawn")
	Loop
  Remove:
    TNT1 A 0
	Stop
  Respawn:
	TNT1 A 1035
	TNT1 A 0 A_SpawnItemEx("CFWeaponSpawnerFX",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFItemSpawner",user_class)
	Stop
  }
}

//You should not need to replace these actors unless you are going to use RandomSpawners, which for the love of Satan I don't know why
//you would want to.
Actor CFHealthBonusSpawner : CFItemSpawnerBase Replaces HealthBonus
{
  SpawnID 152
  States
  {
  Spawn:
	TNT1 A 0
	BON1 A 4
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting",special,args[0],args[1])
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting2",args[2],args[3],args[4])
	"####" "#" 0 ACS_NamedExecuteWithResult("CFItemSpawner",1)
  SpawnLoop:
    "####" "#" 1
	Wait
  }
}

