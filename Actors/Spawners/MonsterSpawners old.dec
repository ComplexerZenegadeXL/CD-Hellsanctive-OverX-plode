//You should not need to replace these actors unless you are going to use RandomSpawners, which for the love of Satan I don't know why
//you would want to.
Actor CFMonsterSpawnerBase
{
  Game Doom
  Health 2147483647
  Mass 2147483647
  Speed 0
  +ISMONSTER
  +SHOOTABLE
  +THRUACTORS
  +NOBLOCKMAP
  +NOINTERACTION
  +MOVEWITHSECTOR
  +RELATIVETOFLOOR
  +DONTBLAST
  +NOTARGET
  +NODAMAGE
  +NOPAIN
  +RANDOMIZE
  +NOTONAUTOMAP
  +SERVERSIDEONLY
  var int user_tid;
  var int user_class;
  var int user_specials[6];
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  CheckIfDead:
	TNT1 A 35 A_JumpIf(ACS_NamedExecuteWithResult("IsHeAliveorDead?",user_tid,user_class) == 0,"Death")
	Loop
  }
}

Actor CFZombieSpawner : CFMonsterSpawnerBase replaces Zombieman
{
  Radius 20
  Height 56
  States
  {
  Spawn:
	POSS A 4
	"####" "#" 0 ACS_NamedExecuteAlways("SpecialSetting",0,special,args[0],args[1])
	"####" "#" 0 ACS_NamedExecuteAlways("SpecialSetting2",0,args[2],args[3],args[4])
	//"####" "#" 0 ACS_NamedExecuteAlways("RemoveSpecials")
	"####" "#" 1 A_SetUserVar("user_class",1)
	"####" "#" 0 ACS_NamedExecuteWithResult("CFMonsterSpawner",1)
    "####" "#" 1
	Wait
  Die:
	TNT1 A 2 A_Die
	Goto Death
  Death:
	TNT1 A 100 A_Fall
    Stop
  }
}

