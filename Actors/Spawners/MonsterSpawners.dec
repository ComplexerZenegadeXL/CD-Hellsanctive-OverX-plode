//You should not need to replace these actors unless you are going to use RandomSpawners, which for the love of Satan I don't know why
//you would want to.
Actor CFMonsterSpawnerBase
{
  Game Doom
  Health 2147483647
  Mass 20
  Speed 8
  Radius 20
  Height 56
  //+COUNTKILL
  +SHOOTABLE
  +SOLID
  +ACTIVATEIMPACT
  +CANPUSHWALLS
  +CANUSEWALLS
  +ACTIVATEMCROSS
  +MOVEWITHSECTOR
  +RELATIVETOFLOOR
  +DONTBLAST
  +NOTARGET
  +NOPAIN
  +RANDOMIZE
  +NOTONAUTOMAP
  +LOOKALLAROUND
  +SEEINVISIBLE
  //+SERVERSIDEONLY  Don't use
  //+NODAMAGE
  //+NOINTERACTION //This needed for sv_nomonsters??
  //+THRUACTORS
  //+NOBLOCKMAP 
  //+ISMONSTER
  var int user_tid;
  var int user_class;
  var int user_specials[6];
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  SpawnLoop:
	"####" AB 10 A_LookEx(LOF_NOSOUNDCHECK,0,0,0,360,"ItsTime")
	"####" AB 10 A_LookEx(0,0,0,0,360,"See")
	//"####" AB 10 A_JumpIfHealthLower(2147483647,"ItsTime")
	Loop
  See:
	//"####" "#" 4 A_JumpIfTargetInLOS("ItsTime",0,0,0,0)
	//"####" "#" 4 A_LookEx(LOF_NOSIGHTCHECK,0,0,1024,360,"ItsTime")
	"####" "#" 0 A_LookEx(LOF_NOSOUNDCHECK,0,0,0,360,"ItsTime")
	"####" AA 4 A_Chase("ItsTime","ItsTime")
	"####" "#" 0 A_LookEx(LOF_NOSOUNDCHECK,0,0,0,360,"ItsTime")
	"####" BB 4 A_Chase("ItsTime","ItsTime")
	"####" "#" 0 A_LookEx(LOF_NOSOUNDCHECK,0,0,0,360,"ItsTime")
	"####" CC 4 A_Chase("ItsTime","ItsTime")
	"####" "#" 0 A_LookEx(LOF_NOSOUNDCHECK,0,0,0,360,"ItsTime")
	"####" DD 4 A_Chase("ItsTime","ItsTime")
	Loop
  CheckIfDead:
	TNT1 A 70 A_JumpIf(ACS_NamedExecuteWithResult("IsHeAliveorDead?",user_tid,user_class) == 0,"Death")
	Loop
  }
}

Actor CFZombieSpawner : CFMonsterSpawnerBase replaces Zombieman
{
  SpawnID 4
  States
  {
  Spawn:
	POSS A 4
	"####" "#" 0 ACS_NamedExecuteAlways("SpecialSetting",0,special,args[0],args[1])
	"####" "#" 0 ACS_NamedExecuteAlways("SpecialSetting2",0,args[2],args[3],args[4])
	"####" "#" 1 A_SetUserVar("user_class",1)
	"####" "#" 0 ACS_NamedExecuteAlways("CCardsJump")
	"####" "#" 1
	Goto SpawnLoop
  ItsTime:
	"####" "#" 0 ACS_NamedExecuteWithResult("CFMonsterSpawner",1)
	"####" "#" 1
	Wait
  Die:
	TNT1 A 2 A_Die
	Goto Death
  XDeath:
  Death:
	TNT1 A 100 A_Fall
    Stop
  }
}

