Actor CFBackpackSpawnerBase
{
  +RANDOMIZE
  +THRUACTORS
  -COUNTITEM
  +NOINTERACTION
  +SERVERSIDEONLY
  var int user_tid;
  var int user_class;
  var int user_specials[6];
  States
  {
  CheckBackpack:
	TNT1 A 35 A_JumpIf(ACS_NamedExecuteWithResult("CheckBackpack",user_tid) == 0,"Respawn")
	Loop
  Remove:
    TNT1 A 0
	Stop
  Respawn:
	TNT1 A 1035
	TNT1 A 0 A_SpawnItemEx("CFWeaponSpawnerFX",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFBackpackSpawner")
	Stop
  }
}

Actor CFBackpackSpawner : CFBackpackSpawnerBase Replaces Backpack
{
  SpawnID 144
  RenderStyle "None"
  States
  {
  Spawn:
	TNT1 A 0
	BPAK A 4
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting",special,args[0],args[1])
	"####" "#" 0 ACS_NamedExecuteWithResult("SpecialSetting2",args[2],args[3],args[4])
	TNT1 A 0 ACS_NamedExecuteWithResult("CFBackpackSpawner")
  SpawnLoop:
    "####" "#" 1
	Wait
  }
}

Actor CFBackpackSpawner2 : CFBackpackSpawner Replaces ModdedBackpack {}
