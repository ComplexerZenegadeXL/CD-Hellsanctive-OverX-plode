Actor BaseNemesisKaboom
{
  Projectile
  Speed 3
  Scale 1.3
  Renderstyle Subtract
  Alpha 0.75
  Damage (0)
  +DONTSPLASH
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FXPW A 1 Bright A_PlaySound("weapons/rocklx")
	FXPW ABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor NemesisKaboom : BaseNemesisKaboom
{
  +NOCLIP
  +NOBLOCKMAP
  +NOINTERACTION
  +CLIENTSIDEONLY
}

