Actor WhiteHellionSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("WhiteHellionSmoke",frandom(-15,15),frandom(-15,15),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor WhiteHellionSmoke : GhostFire
{
  Scale 0.44
  RenderStyle Normal
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	FIW1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}