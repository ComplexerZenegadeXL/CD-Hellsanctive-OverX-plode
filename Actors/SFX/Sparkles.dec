Actor EnergyProjectileSparkWhite : EnergyProjectileSparkRed
{
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
	Spawn:
	SPKW A 3 Bright A_FadeOut(0.1)
	Loop
  }
}

Actor EPSW1 : EnergyProjectileSparkWhite { Scale 0.065 }

Actor EPSW2 : EnergyProjectileSparkWhite { Scale 0.055 }

Actor EPSW3 : EnergyProjectileSparkWhite { Scale 0.045 }

Actor EPSW4 : EnergyProjectileSparkWhite { Scale 0.035 }

Actor EPSW5 : EnergyProjectileSparkWhite { Scale 0.025 }

Actor EPSW6 : EnergyProjectileSparkWhite { Scale 0.015 }

Actor WhiteParticleSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("EPSW1",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSW2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("EPSW3",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSW4",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("EPSW5",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSW6",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
  }
}