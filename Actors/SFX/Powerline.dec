Actor LegendaryGoldPowerLine : BluePowerLine
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  Translation "80:111=160:167"
  Scale 0.32
  States
  {
  Spawn:
   SPFX A 5 Bright
   TNT1 A 0 A_Jump(128,"FadeOut2")
  Normal:
   SPFX AAAA 1 Bright A_FadeOut(0.05)
   Stop
  FadeOut2:
   SPFX AAAA 1 Bright A_FadeOut(0.075)
   Stop
  }
}

Actor LegendaryGoldPowerLineSpawner : BluePowerLineSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 1 A_SpawnItemEx("LegendaryGoldPowerLine",frandom(-40,40),frandom(-40,40),frandom(0,60),0,0,2,0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}