//========
// Sparks
//========

Actor EnergyProjectileSparkRed
{
  Height 0
  Radius 0
  Mass 0
  Damage 0
  +THRUACTORS
  +NOTELEPORT
  +DONTSPLASH
  +DOOMBOUNCE
  +CLIENTSIDEONLY
  +MISSILE
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  //+NOINTERACTION
  RenderStyle Add
  BounceFactor 0.5
  Gravity 0.4
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A Random(5,7)
  SpawnLoop:
	SPKR A 2 Bright A_FadeOut(0.08)
	Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

