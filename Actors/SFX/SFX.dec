  Death:
	TNT1 A 0 A_SpawnItemEx("SmallBloodSpot",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	BDRP BCDEFGH 2
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

