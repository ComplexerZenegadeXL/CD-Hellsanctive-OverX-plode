Actor CeilingBloodDrip
{
  Health 1
  Radius 1
  Height 6
  Mass 1
  Scale 0.25
  RenderStyle Translucent
  Alpha 0.8
  +CLIENTSIDEONLY
  +NOTELEPORT
  +SPAWNCEILING
  +THRUACTORS
  +CORPSE
  +FORCEYBILLBOARD
