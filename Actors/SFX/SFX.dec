	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	Loop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("NewFlyingBloodTrail",0,0,0,1)
	Loop
  CeilingBlood:
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 1 A_SpawnItemEx("BloodSpotCeiling",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	Stop
  Crash:
	TNT1 A 0 A_SetScale(0.8,0.8)
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 0 A_SpawnItemEx("NewBloodSpot",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	BDRP BCDEFGH 2
	Stop
  Death:
	TNT1 A 0 A_GiveInventory("BloodSmearToken",1)
  Smear:
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_SetGravity(0)
	TNT1 A 0 A_SetScale(0.8,0.8)
	FBCR A 10
	FBCR B 10 A_SetGravity(frandom(0.1,0.4))
  Cont:
	FBCR CCCCCDDDDD 1 A_CheckFloor("Crash")
	Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}
 
