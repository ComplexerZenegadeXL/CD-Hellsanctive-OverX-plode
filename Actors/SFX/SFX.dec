Actor DSPGore
{
  Health 1
  Radius 4
  Height 4
  +CLIENTSIDEONLY
  +CORPSE
  +NOTELEPORT
  +MOVEWITHSECTOR
  +THRUACTORS
  States
  {
  Spawn:
	SIMP OPQRST 3
	Goto FallingLoop
  FallingLoop:
	SIMP U 1
	Loop
  Crash:
  Death:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("Gore/Splat")
	SIMP U -1
	Stop
  }
}

Actor DSPBloodDrop : DSPGore
{
  +DONTSPLASH
  RenderStyle Translucent
  Alpha 0.8
  Scale 0.3
  States
  {
  Spawn:
	BDRP A 1
	Loop
  Crash:
  Death:
	BDRP BCDEFGH 2
	Stop
  }
}*/

Actor BodyPart1
{
  Health 1
  Height 2
  Radius 2
  Scale 0.75
  +CLIENTSIDEONLY
  +CORPSE
  +NOTELEPORT
  +MOVEWITHSECTOR
  +THRUACTORS
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	GIB1 AABBCCDD 2 A_SpawnItemEx("RedGibTrail",0,0,0,frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE)
	Loop
  Crash:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("gib/bounce")
	GIB1 E 525
	"####" "###########" 8 A_FadeOut(0.1,1)
	Stop
  }
}

