Actor RedGibTrail : NewFlyingBloodTrail
{
  Scale 0.175
  Alpha 0.85
  +NOGRAVITY
  -LOWGRAVITY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SetScale(frandom(0.15,0.2),frandom(0.15,0.2))
	BLOS AABBCDEFGHIJ 2 A_FadeOut(0.025)
	Stop
  }
}

