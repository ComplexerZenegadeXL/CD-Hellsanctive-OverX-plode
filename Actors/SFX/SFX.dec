	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 AAAA 6 A_SpawnItemEx("LightMastermindSpiderPart",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  }
}

Actor BlackArachnoBrainGenerator : GibbedGenerator
{
  States 
  { 
  Spawn:
	TNT1 A 0
	TNT1 A 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 AAAA 4 A_SpawnItemEx("BlackArachnoSpiderPart",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 AA 4 A_SpawnItemEx("BlackArachnoSpiderPart",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  }
}

