//======================
// "Hitscan" Projectile
//======================

Actor ProjectileBullet : FastProjectile
{
  Height 1
  Radius 1
  Speed 350
  Damage (0)
  +NOEXTREMEDEATH
  +NOTIMEFREEZE
  +BLOODSPLATTER
  Decal BulletChip
  States
  {
  Spawn:
    TNT1 A 1
    Loop
  Death:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("ModdedBulletPuff",0,0,0,0,0,0,0)
    Stop
  XDeath:
    TNT1 A 1
    Stop
  }
}

Actor SentientExplosiveTracer : FastProjectile
{
  Height 1
  Radius 1
  Speed 100
  Scale 0.8
  Damage (Random(5,10))
  RenderStyle Add
  Alpha 0.85
  DeathSound "sentient/chaingunex"
  DamageType "CerChainguns"
  Decal "DoomImpScorch"
  -FORCERADIUSDMG
  +RANDOMIZE
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TRAC A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("SentientExplosiveEffect",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    MISL B 4 Bright A_Explode(Random(15,30),72,0)
    MISL CD 3 Bright
    Stop
  }
}

Actor BabySentientExplosiveTracer : SentientExplosiveTracer
{
  DamageType "Baby15K"
  Scale 0.6
  States
  {
  Spawn:
    TRAC A 1 Bright
	Loop
  }
}

Actor SentientExplosiveEffect
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom16", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

