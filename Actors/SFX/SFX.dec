//=========
// Casings
//=========

Actor BulletCasing
{
  Radius 3
  Scale 0.18
  +MISSILE
  +CLIENTSIDEONLY
  +NOTELEPORT	
  +DOOMBOUNCE
  +THRUACTORS
  +DROPOFF
  BounceFactor 0.5
  WallBounceFactor 0.25
  BounceCount 3
  Seesound "weapons/casing1"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	CAS2 ABCDEFGH 2
	Loop
  Death:
    TNT1 A 0 A_Jump(128,3)
    CAS2 C 100
    CAS2 C 5 A_FadeOut(0.10)
    Goto Death+2
    CAS2 G 100
	CAS2 G 5 A_FadeOut(0.10)
	Goto Death+4
  Vanilla:
	TNT1 A 0
	Stop
  }
}

Actor ShellCasing : BulletCasing
{
  Scale 0.24
  Seesound "weapons/casing2"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	REDC ABCDEFGH 2
	Loop
  Death:
    TNT1 A 0 A_Jump(128,3)
    REDC C 100
    REDC C 5 A_FadeOut(0.10)
    Goto Death+2
    REDC G 100
	REDC G 5 A_FadeOut(0.10)
	Goto Death+4
  }
}
