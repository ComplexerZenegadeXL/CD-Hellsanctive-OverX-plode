Actor GibbedGenerator
{
  +NOTELEPORT
  +NOTONAUTOMAP
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  +NOGRAVITY
  States 
  { 
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 AA 0 A_CustomMissile("RedBloodCloud",frandom(25,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NewFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(6,12))
	TNT1 AA 1 A_CustomMissile("RedBloodCloud",frandom(25,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NewFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(6,12))
	TNT1 A 0 A_Jump(256,"BodyParts1","BodyParts2")
	Stop
  BloodPool:
	TNT1 A 0 A_SpawnItem("LargeBloodPool",0,0,0,1)
	Goto Standard+2
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckFloor("BloodPool2")
	TNT1 A 0 A_CustomMissile("RedBloodCloud",frandom(25,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("NewFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(6,12))
	TNT1 A 1 A_CustomMissile("RedBloodCloud",frandom(25,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 1 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("NewFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(6,12))
	TNT1 A 0 A_Jump(256,"BodyParts1","BodyParts2")
	Stop
  BodyParts1:
	TNT1 A 0 A_SpawnItemEx("BodyPart1",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("BodyPart2",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("BodyPart3",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("BodyPart4",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  BodyParts2:
	TNT1 A 0 A_SpawnItemEx("BodyPart5",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("BodyPart6",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("BodyPart7",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("BodyPart8",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  BloodPool2:
	TNT1 A 0 A_SpawnItem("LargeBloodPool",0,0,0,1)
	Goto Reduced+2
  Vanilla:
    TNT1 A 0
	Stop
  }
}

