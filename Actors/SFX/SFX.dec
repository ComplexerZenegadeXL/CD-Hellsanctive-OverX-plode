Actor CFKaboom
{
  Speed 3
  Damage 0
  Renderstyle Add
  Alpha 0.75
  Projectile
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOGRAVITY
  +MISSILE
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOCLIP
  Scale 1.3
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FXPO A 1 Bright A_PlaySound("weapons/rocklx")
	FXPO ABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

