// Puffs, Blood, Gibs
//====================

Actor ModdedBulletPuff replaces BulletPuff
{
  Radius 0
  Height 0
  VSpeed 1
  Mass 5
  Scale 0.75
  RenderStyle Translucent
  Alpha 0.5
  DamageType "Normal"
  +NOBLOCKMAP
  +NOGRAVITY
  +ALLOWPARTICLES
  +RANDOMIZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("DetectFloorPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DetectCeilingPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	PUFF A 2 Bright
	PUFF B 2 Bright A_Jump(32,"RicochetPuff","RicochetPuffAlt")
	PUFF CDEF 2 A_ChangeVelocity(0,0,frandom(0,2))
    Stop
  RicochetPuff:
	TNT1 A 0 A_PlaySound("puff/ricochet")
	TNT1 A 0 A_SpawnItemEx("RicochetSpark",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto Spawn+5
  RicochetPuffAlt:
	TNT1 A 0 A_PlaySound("puff/ricochet")
	TNT1 A 0 A_SpawnItemEx("RicochetSpark2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto Spawn+5
  }
}

Actor DetectFloorPuff
{
  Radius 2
  Height 4 //4
  +MISSILE
  +NOTELEPORT
  +NOBLOCKMAP
  +THRUACTORS
  +MOVEWITHSECTOR
  +NODAMAGETHRUST
  +DONTSPLASH
  +NOTONAUTOMAP
  States
  {
  Spawn:
	TNT1 A 4
	Stop
  Death:
	TNT1 A 0 A_CheckFloor("FloorPuff")
	Stop
  FloorPuff:
	TNT1 A 0 A_SpawnItemEx("FloorPuffDecal",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Stop
  }
}

Actor DetectCeilingPuff : DetectFloorPuff
{
  States
  {
  Spawn:
	TNT1 A 4
	Stop
  Death:
	TNT1 A 0 A_CheckCeiling("CeilingPuff")
	Stop
  CeilingPuff:
	TNT1 A 0 A_SpawnItemEx("CeilingPuffDecal",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Stop
  }
}

Actor FloorPuffDecal
{
  Radius 0
  Height 0
  Scale 0.6
  RenderStyle Translucent
  Alpha 0.8
  +NOTELEPORT
  +NOBLOCKMAP
  +MOVEWITHSECTOR
  +DONTGIB
  +THRUACTORS
  +DONTSPLASH
  +FLOORCLIP
  +FLOORHUGGER
  States
  {
  Spawn:
    BDEC A 525 NoDelay A_SpawnItemEx("PuffDecalGlowFloor",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    BDEC AAAAAAAAAA 8 A_FadeOut(0.1)
    Stop
  }
}

Actor CeilingPuffDecal : FloorPuffDecal
{
  +NOGRAVITY
  +SPAWNCEILING
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ThrustThingZ(0,100,0,1)
	TNT1 A 0 A_SpawnItemEx("PuffDecalGlowCeiling",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    BDEC A 525
    BDEC A 8 A_FadeOut(0.1)
    Goto Spawn+4
  }
}

Actor PuffDecalGlowFloor
{
  Radius 0
  Height 0
  Scale 0.5
  RenderStyle Add
  +NOTELEPORT
  +NOBLOCKMAP
  +MOVEWITHSECTOR
  +DONTGIB
  +THRUACTORS
  +CLIENTSIDEONLY
  +DONTSPLASH
  +FLOORCLIP
  States
  {
  Spawn:
	BDEG A 10 Bright
  Cont:
	BDEG A 1 Bright A_FadeOut(0.025)
	Loop
  }
}

