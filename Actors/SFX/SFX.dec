	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	Loop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL A 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL B 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL C 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBOL D 1 A_SpawnItem("SmallFlyingBloodTrail6",0,0,0,1)
	Loop
  CeilingBlood:
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 1 A_SpawnItemEx("BloodSpotCeiling6",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	Stop
  Crash:
	TNT1 A 0 A_SetScale(0.4,0.4)
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 0 A_SpawnItemEx("SmallBloodSpot6",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	BDR6 BCDEFGH 2
	Stop
  Death:
	TNT1 A 0 A_GiveInventory("BloodSmearToken",1)
  Smear:
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_SetGravity(0)
	TNT1 A 0 A_SetScale(0.4,0.4)
	FBC6 A 10
	FBC6 B 10 A_SetGravity(frandom(0.1,0.4))
  Cont:
	FBC6 CCCCCDDDDD 1 A_CheckFloor("Crash")
	Loop
	}
}

Actor NewBloodSpot
{
  Radius 2
  Height 2
  Scale 0.4
  RenderStyle Translucent
  Alpha 0.8
  +CLIENTSIDEONLY
  +NOTELEPORT
  +NOBLOCKMAP
  +MOVEWITHSECTOR
  +DONTGIB
  +FLOORCLIP
  States
  {
  Spawn:
	TNT1 A 0
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
    BSPT A 525
	Goto Fade
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
    BSPT A 262
	Goto Fade
  Fade:
    BSPT A 8 A_FadeOut(0.1)
    Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

