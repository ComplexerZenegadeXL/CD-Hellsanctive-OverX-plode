    TNT1 A 0 A_Jump(128,3)
    ECEL A 100
    ECEL A 5 A_FadeOut(0.10)
    Goto Death+2
    ECEL G 100
	ECEL G 5 A_FadeOut(0.10)
	Goto Death+4
  }
}

Actor DemonTechEmptyMag : BulletCasing
{
  Scale 0.4
  SeeSound "weapons/emptydrum"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	EDTM ABCD 3  
	Loop
  Death:
    TNT1 A 0 A_Jump(128,3)
    EDTM A 100
    EDTM A 5 A_FadeOut(0.10)
    Goto Death+2
    EDTM C 100
	EDTM C 5 A_FadeOut(0.10)
	Goto Death+4
  }
}

