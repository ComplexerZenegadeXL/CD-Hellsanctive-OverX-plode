	TNT1 A 0 A_SpawnItemEx("NewFlyingBlood6",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)	
	TNT1 A 1 A_Jump(128,"ExtraBlood")	
	Stop
  ExtraBlood:
	TNT1 A 0 A_SpawnItemEx("SmallFlyingBlood6",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
	Stop
  }
}

Actor NewBloodSplatter : NewBlood replaces BloodSplatter {}

Actor BloodSpray
{
  Height 4
  Radius 4
  Mass 5
  Alpha 0.85
  RenderStyle Translucent
  Scale 0.45
  Gravity 0.2
  +NOTELEPORT
  +NOBLOCKMAP
  +THRUACTORS
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A Random(4,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BLOS ABCDEFGHIJ 2
	Stop
  Vanilla:
	TNT1 A 0 A_SetGravity(0.4)
	TNT1 A 0 A_SetScale(0.85,0.85)
	BLBD CBA 7	
	Stop
  }
}

Actor GibSpray : BloodSpray
{
  Scale 0.9
  States
  {
