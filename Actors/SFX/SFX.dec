Actor RailgunImpact : FastProjectile
{
  Speed 100
  Radius 1
  Height 1
  RenderStyle Add
  Alpha 0.85
  +RANDOMIZE
  +THRUACTORS
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("RailgunImpactEffect",0,0,0,0,0,0,0)
	Stop
  }
}

Actor RailgunImpactRed : RailgunImpact
{
  -THRUACTORS
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("RailgunImpactEffectRed",0,0,0,0,0,0,0)
	Stop
  }
}

