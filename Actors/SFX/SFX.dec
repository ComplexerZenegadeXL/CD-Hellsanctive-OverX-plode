Actor NewFlyingBlood
{
  Scale 0.1
  Health 1
  Radius 2
  Height 2
  Decal "SmallBloodSmear"
  +MISSILE
  +THRUACTORS
  +CLIENTSIDEONLY
  +CORPSE
  +NOTELEPORT
  +NOBLOCKMAP
