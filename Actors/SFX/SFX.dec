Actor NewBlood replaces Blood
{
  Height 2
  Radius 2
  Mass 5
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +ALLOWPARTICLES
  States
  {
  Spawn:
  Spray:
    TNT1 A Random(4,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("FleshHit",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BloodSpray",0,0,0,frandom(-1,1),frandom(-1,1),frandom(1,2),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
	TNT1 A 0 A_SpawnItemEx("NewFlyingBlood",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)	
	TNT1 A 1 A_Jump(128,"ExtraBlood")	
	Stop
  ExtraBlood:
	TNT1 A 0 A_SpawnItemEx("SmallFlyingBlood",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_TRANSFERTRANSLATION)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

