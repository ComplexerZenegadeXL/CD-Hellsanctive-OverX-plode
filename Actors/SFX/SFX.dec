Actor RedBloodCloud
{
  Radius 1
  Height 1
  Speed 2
  Damage 0
  Renderstyle Translucent
  Alpha 0.75
  Scale 1
  Projectile
  +NOTELEPORT
  +DONTSPLASH
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	RBSP ABCDEFGHIJKLM 3 A_FadeOut(0.025)
	Stop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	RBSP ABCDEFGHIJKLM 3 A_FadeOut(0.075)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

