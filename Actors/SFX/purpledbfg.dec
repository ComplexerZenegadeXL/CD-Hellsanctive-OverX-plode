Actor PurpleDBFGBoltExp
{
  +NODAMAGETHRUST
  +MTHRUSPECIES
  +THRUSPECIES
  +NOBLOCKMAP
  +NOTELEPORT 
  +FORCERADIUSDMG
  +BLOODLESSIMPACT
  +NOBLOCKMAP
  +DONTHARMSPECIES
  +NOGRAVITY
  Renderstyle Add
  Alpha 0.95
  DamageType "C0mm4nder"
  RenderStyle Add
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0 Radius_Quake(5,60,0,10,0)
    TNT1 A 0 A_SpawnItemEx("PurpleDTBFGLightningSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop:
	C3PP A 1 Bright A_SpawnItemEx("PurpleDBFGBallTrail", 0, frandom(-2,2), frandom(-2,2), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticle", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto SpawnLoop
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop2:
	C3PP B 1 Bright A_SpawnItemEx("PurpleDBFGBallTrail", 0, frandom(-2,2), frandom(-2,2), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticle", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto SpawnLoop2
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticle", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpB", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
	SpawnLoop3:
	C3PP C 1 Bright A_SpawnItemEx("PurpleDBFGBallTrail", 0, frandom(-2,2), frandom(-2,2), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticle", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto SpawnLoop3
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop4:
	C3PP A 1 Bright A_SpawnItemEx("PurpleDBFGBallTrail", 0, frandom(-2,2), frandom(-2,2), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticle", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto SpawnLoop4
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpC", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    TNT1 A 0 A_StopSound(CHAN_VOICE)
    TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("Weapons/dbfgexplode", CHAN_AUTO, 1.0, False, ATTN_NONE)
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwaveLrg", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItemEx("PurpleDBFGBallExp")
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpImpact")
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallShockwaveLrg", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0
	//TNT1 A 0 A_PlaySound("Weapons/dbfgexplode", CHAN_BODY, 1.0, False, ATTN_NONE)
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpB", random(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpC", random(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    C3PX AB 3 Bright A_FadeOut(0.05)
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltLrgExpB", random(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltLrgExpC", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    C3PX C 3 Bright A_FadeOut(0.045)
	C3PX D 3 Bright A_FadeOut(0.035)
    TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExtLrgExpB", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpC", random(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	C3PX AB 3 Bright A_FadeOut(0.05)
    //TNT1 AA 0 A_SpawnItemEx("PurpleDBFGBoltLrgExpB", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    //TNT1 AAA 0 A_SpawnItemEx("PurpleDBFGBoltLrgExpC", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
	C3PX C 3 Bright A_FadeOut(0.045)
	C3PX D 3 Bright A_FadeOut(0.035)
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpB", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    //TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExtLrgExpC", frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(-1,1), frandom(0,360))
    C3PX E 3 Bright A_FadeOut(0.025)
	C3PX F 3 Bright A_FadeOut(0.015)
	C3PX G 4 Bright A_FadeOut(0.065)
  Continuous:
	C3PX G 1 Bright A_FadeOut(0.065)
	Loop
  }
}

Actor PurpleDBFGBoltExpB : PurpleDBFGBoltExp
