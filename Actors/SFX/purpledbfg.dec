Actor PurpleDBFGBoltExpStruckGlowX : LightPurpleGuruStruckGlowX { }
Actor PurpleDBFGBoltExpStruckGlowY : LightPurpleGuruStruckGlowY { }
Actor PurpleDBFGBoltExpChunkSpark : LightPurpleGuruChunkSpark { }
Actor PurpleDBFGBoltExpSphereSmoke : LightPurpleGuruSphereSmoke { DamageType "C0mm4nder" }

Actor PurpleDBFGBoltExpImpact
{
  +DONTHARMSPECIES
  +MTHRUSPECIES
  +THRUSPECIES
  +NOBLOCKMAP
  +NOTELEPORT 
  +BLOODLESSIMPACT
  +NOGRAVITY
  DamageType "C0mm4nder"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	TNT1 A 0 A_Explode(512,256,0,1)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpStruckGlowX",0,0,10,0,0,0,0,128,0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpStruckGlowY",0,0,10,0,0,0,0,128,0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExpImpactFlareSpawner",0,0,10,0,0,0,0,128,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("PurpleDBFGBoltExpSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),0,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("PurpleDBFGBoltExpChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("PurpleDBFGBoltExpChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	Stop
  }
}

