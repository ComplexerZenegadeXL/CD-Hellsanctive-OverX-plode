Actor PurpleBaseEffect
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +NOCLIP
  +NONETID
  States
  {
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor LightPurpleGuruStruckGlowX : BlueGuruStruckGlowX
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 0 //A_SetScale(ScaleX +0.1, ScaleY +0.025)
    G5FL A 1 Bright A_FadeOut(0.01)
    Loop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LightPurpleGuruStruckGlowY : BlueGuruStruckGlowY
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    G5FL A 0 //A_SetScale(ScaleX +0.025, ScaleY +0.1)
    G5FL A 1 Bright A_FadeOut(0.01)
    Loop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LightPurpleStruckGlow : CFGuruEffectInheritance
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	G5FL A 2 Bright A_FadeOut(0.05)
    Loop
  }
}

Actor LightPurpleGuruChunkSpark : BlueGuruChunkSpark
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    G5SP ABCDEF 2 Bright A_FadeOut(0.1)
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LightPurpleGuruSphereSmoke : BlueGuruSmokeInheritance
{
  Projectile
  Scale 1.8
  RenderStyle Translucent
  Alpha 0.45
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AA 1 A_Jump(256,"Spawn1","Spawn2","Spawn3")
  Spawn1:
	TNT1 A 0 A_SetScale(ScaleX -0.002, ScaleY -0.002)
	TNT1 A 0 A_JumpIf(Alpha<0.3,2)
	TNT1 A 0 A_Explode(10,200,0)
	G5SM A 4 Bright A_FadeOut(0.0065,1)
	Loop
  Spawn2:
	TNT1 A 0 A_SetScale(ScaleX -0.002, ScaleY -0.002)
	TNT1 A 0 A_JumpIf(Alpha<0.3,2)
	TNT1 A 0 A_Explode(10,200,0)
	G5SM B 4 Bright A_FadeOut(0.0065,1)
	Loop
  Spawn3:
	TNT1 A 0 A_SetScale(ScaleX -0.002, ScaleY -0.002)
	TNT1 A 0 A_JumpIf(Alpha<0.3,2)
	TNT1 A 0 A_Explode(10,200,0)
	G5SM C 4 Bright A_FadeOut(0.0065,1)
	Loop
  }
}

Actor PurpleDBFGBallParticleFloater : PurpleBaseEffect
{
  Height 0
  Radius 0
  Mass 0
  Damage 0
  +THRUACTORS
  +DONTSPLASH
  +DOOMBOUNCE
  +MISSILE
  +FORCEXYBILLBOARD
  -NOGRAVITY
  RenderStyle Add
  BounceFactor 0.6
  Gravity 0.2
  Scale 0.06
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	SSKP ABC 2 Bright A_FadeOut(0.015)
    Loop
  }
}

Actor PurpleDBFGShockAttack : DTBFGTracerAttack
{
  DamageType "C0mm4nder"
  Obituary "%o got shocked by %k's D-BFG."
  -FRIENDLY
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(16,32),0,NONE,"Purple",RGF_SILENT|RGF_NOPIERCING,1,2,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor PlayerPurpleDBFGShockAttack : PurpleDBFGShockAttack
{
  Species "Player"
  DamageType "PlayerDBFG2"
  +FRIENDLY
}

Actor PurpleDBFGBallTrail : PurpleBaseEffect
{
  Alpha 0.70
  Renderstyle Add
  Scale 1.0
  States
  {
  Spawn:
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	P3FL ABC 2 Bright A_FadeOut(0.10)
    P3FL DEF 2 Bright A_FadeOut(0.10)
    TNT1 AAAA 2 A_FadeOut(0.10)
	Stop
  }
}

Actor PurpleDBFGBallParticle : PurpleBaseEffect
{
  Scale 0.5
  Alpha 0.75
  Renderstyle Add
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
   	TNT1 A 0 A_ChangeVelocity(frandom(-1.6,1.6), frandom(-1.6,1.6), frandom(-1.6,1.6), 0)
	SSKP A 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP C 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP A 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
	SSKP C 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075))
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBallParticleTrail", 0, 0, 0, 0)
    Loop
  }
}

Actor PurpleDBFGBallParticleTrail : PurpleBaseEffect
{
  Scale 0.5
  Alpha 0.75
  Renderstyle Add
  States
  {
	Spawn:
	  TNT1 A 0
   	  TNT1 A 0 A_ChangeVelocity(frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(-0.2, 0.2), 0)
	  //BGFL ABC 1 Bright A_FadeOut(0.05+random(0.0075,-0.0075))
      P3FL ABC 2 Bright A_FadeOut(0.10)
   	  TNT1 A 0 A_ChangeVelocity(frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(-0.2, 0.2), 0)
      P3FL DEF 2 Bright A_FadeOut(0.10)
	  TNT1 A 0 A_ChangeVelocity(frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(-0.2, 0.2), 0)
      TNT1 AAAA 2 A_FadeOut(0.10)
  	  Stop
  }
}


