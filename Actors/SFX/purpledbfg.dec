Actor PurpleDBFGBoltSmlExpB : PurpleDBFGBoltExpB
{
  Scale 0.5
  States
  {
    Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_PlaySound("Weapons/dbfgwave", CHAN_AUTO)
    C3P1 A 3 Bright A_FadeOut(0.05)
	C3P1 B 3 Bright A_FadeOut(0.05)
	C3P1 C 3 Bright A_FadeOut(0.045)
	C3P1 D 3 Bright A_FadeOut(0.035)
	C3P1 E 3 Bright A_FadeOut(0.025)
	C3P1 F 3 Bright A_FadeOut(0.015)
	C3P1 G 3 Bright A_FadeOut(0.065)
  Continuous:
	C3P1 G 1 Bright A_FadeOut(0.065)
	Loop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

