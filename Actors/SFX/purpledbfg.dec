    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	C3P2 A 3 Bright A_FadeOut(0.05)
	C3P2 B 3 Bright A_FadeOut(0.05)
	C3P2 C 3 Bright A_FadeOut(0.045)
	C3P2 D 3 Bright A_FadeOut(0.035)
	C3P2 E 3 Bright A_FadeOut(0.025)
	C3P2 F 3 Bright A_FadeOut(0.015)
	C3P2 G 3 Bright A_FadeOut(0.065)
  Continuous:
	C3P2 G 1 Bright A_FadeOut(0.065)
	Loop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

