Actor WhiteKaboom : CFKaboom //taken from ??
{
  Scale 0.85
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FXPW AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05,1)
	Stop
  }
}
Actor WhiteKaboom2 : WhiteKaboom { Scale 0.45 }

Actor PurpleKaboom : CFKaboom
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
    Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FXP2 A 1 Bright A_PlaySound("weapons/rocklx")
	FXP2 ABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

