//-------------------------------------------
//             Scarlet
//-------------------------------------------
Actor ScarletProjParticle : BaseProjectileParticle
{
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	CLBA A 1 Bright
	Goto Spawn2
  }
}

