	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
    Loop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
    FBLD A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD A 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD B 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD C 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLD D 1 A_SpawnItem("EnragedFlyingBloodTrail",0,0,0,1)
    Loop
  Crash:
	TNT1 A 0 A_SetScale(0.8,0.8)
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 0 A_SpawnItemEx("EnragedBloodSpot",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	BDRP BCDEFGH 2
	Stop
  }
}

