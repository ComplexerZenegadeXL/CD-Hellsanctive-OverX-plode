Actor EnragedGibbedGenerator : GibbedGenerator
{ 
  +NOTIMEFREEZE
  States 
  { 
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 AA 0 A_CustomMissile("EnragedBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EnragedFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 AA 2 A_CustomMissile("EnragedBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EnragedFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 0 A_Jump(256,"BodyParts1")
	Stop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 A 0 A_CustomMissile("EnragedBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("EnragedFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 2 A_CustomMissile("EnragedBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 1 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("EnragedFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 0 A_Jump(256,"BodyParts1")
	Stop
  BodyParts1:
	TNT1 A 0 A_SpawnItemEx("EnragedBodyPart1",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("EnragedBodyPart2",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("EnragedBodyPart3",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("EnragedBodyPart4",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  }
}

