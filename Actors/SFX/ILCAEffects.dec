Actor EnragedBulletPuff : LegModdedBulletPuff
{
  DamageType "Legendary"
  Decal "ELegBulletChip"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("EnragedDetectFloorPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EnragedDetectCeilingPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	PUFF A 2 Bright
	PUFF B 2 Bright A_Jump(32,"RicochetPuff","RicochetPuffAlt")
	PUFF CDEF 2 A_ChangeVelocity(0,0,frandom(0,2))
    Stop
  }
}

