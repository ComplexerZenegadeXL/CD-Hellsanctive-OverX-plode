Actor NemesisGibbedGenerator : BlackGibbedGenerator
{
  +NOTIMEFREEZE
  States 
  { 
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 AA 0 A_CustomMissile("NemesisBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSprayBlack",0,0,frandom(25,50),FRandom(-2,2),FRandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 AA 2 A_CustomMissile("NemesisBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSprayBlack",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 0 A_Jump(256,"BodyParts1","BodyParts2")
	Stop
  Standard:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckFloor("BloodPool2")
	TNT1 A 0 A_CustomMissile("NemesisBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibSprayBlack",0,0,frandom(25,50),FRandom(-2,2),FRandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("NemesisFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 2 A_CustomMissile("NemesisBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibSprayBlack",0,0,frandom(25,50),FRandom(-2,2),FRandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("NemesisFlyingBlood",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6))
	TNT1 A 0 A_Jump(256,"BodyParts1","BodyParts2")
	Stop
  BodyParts1:
	TNT1 A 0 A_SpawnItemEx("NemesisBodyPart1",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("NemesisBodyPart2",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("NemesisBodyPart3",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("NemesisBodyPart4",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  BodyParts2:
	TNT1 A 0 A_SpawnItemEx("NemesisBodyPart5",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("NemesisBodyPart6",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("NemesisBodyPart7",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("NemesisBodyPart8",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  }
}

Actor NemesisFlyingBlood : NewFlyingBlood3
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	Loop
  Reduced:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIfInventory("BloodSmearToken",1,"Smear")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1 
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB A 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB B 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB C 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1
	TNT1 A 0 A_CheckCeiling("CeilingBlood")
	TNT1 A 0 A_JumpIf(WaterLevel > 1, "Vanilla")
	FBLB D 1 A_SpawnItem("NemesisFlyingBloodTrail",0,0,0,1)
	Loop
  Crash:
    TNT1 A 0 A_SetScale(0.8,0.8)
	TNT1 A 0 A_PlaySound("Gibs")
	TNT1 A 0 A_SpawnItemEx("NemesisBloodSpot",0,0,0,0,0,0,0,SXF_TRANSFERTRANSLATION|SXF_NOCHECKPOSITION)
	BDR2 BCDEFGH 2
	Stop
  }
}

