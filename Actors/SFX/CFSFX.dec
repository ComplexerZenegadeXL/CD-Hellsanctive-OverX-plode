	Stop
  }
}

Actor CFPurpleParticleSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  +NONETID
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("EPSP1",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_SpawnItemEx("EPSP2",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_SpawnItemEx("EPSP3",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_SpawnItemEx("EPSP4",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_SpawnItemEx("EPSP5",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_SpawnItemEx("EPSP6",0,0,0,frandom(0,8),frandom(0,8),frandom(1,4),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 1
	Stop
