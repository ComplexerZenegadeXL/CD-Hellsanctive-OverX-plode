Actor ShadowSmoke
{
  Height 8
  Radius 4
  Mass 1
  Gravity 0.02
  Speed 20
  Scale 0.5
  RenderStyle Translucent
  Alpha 0.5
  Bouncecount 500
  +DROPOFF
  +NOTARGET
  -NOGRAVITY
  +THRUACTORS
  +NOINTERACTION
  +NOBLOCKMAP
  +DONTSPLASH
  +NOTELEPORT
  +DOOMBOUNCE
  +NONSHOOTABLE
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	NSMK ABCDEFGHIJKLMMM 1 Bright A_FadeOut(0.06,0)
	NSMK M 1 Bright A_FadeOut(0.7,1)
	Wait
  Vanilla:
	TNT1 A 1
	Stop
  Death:
	TNT1 A 1
	Stop
  }
}

