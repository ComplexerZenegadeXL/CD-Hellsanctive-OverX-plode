Actor RedLightning 
{
  +NOGRAVITY
  +EXTREMEDEATH
  +NOCLIP
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Renderstyle Add
  Height 32
  Radius 16
  Scale 2
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_PlaySoundEx("BFlan/Lightning",7)    
	TNT1 A 0 Radius_Quake(175,8,512,1024,0)
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("RedLightningSpark",0,0,0,frandom(1,10),0,frandom(1,10),frandom(0,360),SXF_CLIENTSIDE)
	DV09 ABCBCAB 3 Bright
	Stop
  }     
}

Actor RedLightningSpark : LegCardiThunderSpark
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(80,4)
    SRPK ABC 2 Bright
	Loop
	SRPK DEF 4 Bright A_FadeOut(0.25)
	Stop
   Death:
	SRPK DEF 4 Bright A_FadeOut(0.25)
	Stop	
  }
}

