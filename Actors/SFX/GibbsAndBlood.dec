Actor NewBloodOrange : NewBlood
{
  RenderStyle Translucent
  Alpha 0.8
  Scale 0.8
  +NONETID
  States
  {
  Spawn:
	TNT1 A Random(5,7)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BLBO A 2 A_SpawnItemEx("FleshHit",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BLBO B 2 A_SpawnItemEx("NewFlyingBlood5",0,0,0,frandom(-5,5),frandom(-5,5),frandom(3,6),0,SXF_TRANSFERTRANSLATION|SXF_CLIENTSIDE,0)
	BLBO CDE 2
	Stop
  }
}
