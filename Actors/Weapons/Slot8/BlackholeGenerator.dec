Actor PBlackHoleDamager : BlackSpawnerInheritance
{ 
  ReactionTime 90
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  -NOCLIP
  -NOBLOCKMAP
  Species "Player"
  DamageType "PlayerBHole"
  States 
  { 
  Spawn: 
	TNT1 A 0
	TNT1 A 0 A_SetAngle(Angle+15)
	TNT1 A 4 A_Explode(Random(75,80),512,0,0,256)
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 1 A_SpawnItemEx("PBlackDeathSequence",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	Stop
  }
}

Actor PBlackHoleSucker : BlackSpawnerInheritance
{ 
  ReactionTime 180
  +FORCERADIUSDMG
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Player"
  DamageType "PlayerBHole"
  States 
  {
  Spawn: 
	TNT1 A 0
	TNT1 A 0 A_SetAngle(Angle+10)
	TNT1 A 2 A_RadiusThrust(-10000,1000,RTF_NOIMPACTDAMAGE)
	TNT1 A 0 Bright A_RadiusGive("RMAnnihilate",1000,RGF_MONSTERS|RGF_CORPSES,1)
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0
	Stop
  } 
}

Actor RMAnnihilate : CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RMAnnihilateCheck",1,"Null")
	TNT1 A 0 A_JumpIfInventory("IsBoss",1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckActorMonster") != 1,"Null")
	TNT1 A 1 ACS_NamedExecuteAlways("RM_BlackHole",0)
	Stop
  }
}

Actor RMAnnihilateCheck : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -2
}

Actor RMAnnihilateBlock : Inventory {}

Actor RMAnnihilateFadeOut : CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckActorMonster") != 1,"HoldAndDestroy")
	TNT1 A 0 A_SetScale(ScaleX-0.1,ScaleY-0.1)
	TNT1 A 1 A_FadeOut(0.1,0)
	Stop
  }
}

Actor RMSetFlag : CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckActorMonster") != 1,"HoldAndDestroy")
	TNT1 A 0 A_ChangeFlag("NOTRIGGER",1)
	TNT1 A 0 A_ChangeFlag("NOBLOCKMAP",0)
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
	TNT1 A 0 A_ChangeFlag("SOLID",0)
