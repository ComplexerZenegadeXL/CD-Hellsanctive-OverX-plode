Actor PBlackHoleChunk : PBlackHoleProjectile
{
  Gravity 0.15
  -NOGRAVITY
  ReactionTime 20
  States
  {
  Spawn:
	TNT1 A 0 
	TNT1 A random(0,3)
	TNT1 A 0  A_PlaySound("PBlack/Suck",5,1.0,1,ATTN_NORM)
	Goto Looplet
  Looplet:
	"VOIP" A 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" BCD 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" E 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//"VOIP" I 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" FGH 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" I 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//"VOIP" A 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" JKL 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0 A_PlaySound("Weapons/MinibeliskDead",5)
	TNT1 A 0 A_Explode(250,128,0,1)
	TNT1 A 0 A_Quake(4,27,0,256,"none")
	TNT1 A 0 A_Quake(1,27,0,384,"none")
	TNT1 A 0 A_SpawnItemEx("PBlackChunkWaver",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailNormal",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailDark",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackChunkWaver",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VORX ABCD 1
	TNT1 AAAAAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailNormal",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(1.0,0.05),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailDark",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackChunkWaver",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VORX EFGH 1
	TNT1 AAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailNormal",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(1.0,0.05),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAA Random(1,2) A_SpawnItemEx("PBlackSmokeTrailDark",frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0.05,1.0),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackChunkWaver",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VORX IJKL 1
