Actor PBlackHoleFlame : BlackSpawnerInheritance
{
  Scale 0.1
  Renderstyle Add
  Alpha 0.5
  +FORCERADIUSDMG
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Player"
  DamageType "PlayerBHole"
  States
  {
  Spawn:
	TNT1 A 1 A_Jump(96,"Spawn2")
	Loop
  Spawn2:
	TNT1 A 1 A_Jump(256,"SpawnA","SpawnB","SpawnC","SpawnD")
	Stop
  SpawnA:
	TNT1 A 0 A_JumpIf(Alpha<0.18,2)
	TNT1 A 0 A_Explode(5,90,1)
	TNT1 A 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
	VODB A 1 A_FadeOut(0.01,1)
	Loop
  SpawnB:
	TNT1 A 0 A_JumpIf(Alpha<0.18,2)
	TNT1 A 0 A_Explode(5,90,1)
	TNT1 A 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
	VODB B 1 A_FadeOut(0.01,1)
	Loop
  SpawnC:
	TNT1 A 0 A_JumpIf(Alpha<0.18,2)
	TNT1 A 0 A_Explode(5,90,1)
	TNT1 A 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
	VODB C 1 A_FadeOut(0.01,1)
	Loop
  SpawnD:
	TNT1 A 0 A_JumpIf(Alpha<0.18,2)
	TNT1 A 0 A_Explode(5,90,1)
	TNT1 A 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
