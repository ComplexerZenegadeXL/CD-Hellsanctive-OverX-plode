Actor BlackholeGeneratorGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFBlackholeGeneratorPickup"
  Tag "$CFBlackholeGenerator"
  States
  {
  Spawn:
	DCAN A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",8,1)
	DCAN A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",45,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BlackholeGenerator",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BlackholeGenerator",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",96)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",50)
	Stop
  }
}

Actor BlackholeGeneratorSpawnerGiver : BlackholeGeneratorGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BlackholeGenerator",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BlackholeGenerator",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",96)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BlackholeGeneratorGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BlackholeGeneratorGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",50)
	Stop
  }
}

Actor BlackholeGeneratorGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor BlackholeGenerator : Weapon
{
  Weapon.SelectionOrder 2900
  Weapon.AmmoUse1 150
  Weapon.AmmoGive 0
  Weapon.SlotNumber 8
  Weapon.SlotPriority 4.0
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.PreferredSkin "Devastator-Marine"
  Weapon.Upsound "devastator/up"
  //Weapon.MinSelectionAmmo1 150
  Weapon.SelectionOrder 7000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  Inventory.PickupMessage "$CFBlackholeGeneratorPickup"
  Obituary "$CFBlackholeGeneratorObit"
  Tag "$CFBlackholeGenerator"
  States
  {
  Spawn:
	DCAN A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",8,1)
	DCAN A -1
	Stop
  Select:
	//TNT1 A 0 A_JumpIfInventory("RMLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("BlackholeGenerator",1)
	//Stop
  SelectLoop:
	DMAT A 1 A_Raise
	Loop
  Deselect:
	DMAT A 1 A_Lower
	Loop
  Ready:
 	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DMAT A 1 A_WeaponReady
	Loop
 Fire:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	DMAT A 30 A_PlayWeaponSound("BH/Charge")
	DMAT A 10 Bright
	TNT1 A 0 A_PlayWeaponSound("BH/Fire")
	TNT1 A 0 A_GunFlash
	DMAT B 4 Bright A_FireCustomMissile("PBlackHoleProjectile",0,0,0,0)
	TNT1 A 0 A_TakeInventory("DemonAmmo",150)
	DMAT CD 4 Bright
	DMAT A 10
	Goto Ready
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready
  Flash:
	TNT1 A 4 A_Light2
	TNT1 A 3 A_Light1
	TNT1 A 0 A_Light0
	Stop
  }
}

Actor BlackSpawnerInheritance
{
  +NOCLIP
  +NOGRAVITY
  +NOBLOCKMAP
  States
  {
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor PBlackSmokeInheritance
{
  Renderstyle Add
  +NOGRAVITY
  +NOBLOCKMAP
  +NOINTERACTION
  States
  {
  Spawn:
	TNT1 A 1 A_Jump(256,"SpawnA","SpawnB","SpawnC","SpawnD","SpawnE","SpawnF","SpawnG","SpawnH","SpawnI","SpawnJ","SpawnK")
	Stop
  HNNNG:
	"####" "#" 0 A_Jump(256,"GTFO Plus","GTFO Minus")
  "GTFO Plus":
	"####" "#" 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
	"####" "#" 1 A_FadeOut(0.01+frandom(-0.01,0.02),1)
	Loop
  "GTFO Minus":
	"####" "#" 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	"####" "#" 1 A_FadeOut(0.01+frandom(-0.01,0.02),1)
	Loop
  }
}

Actor PBlackSmokeTrailNormal : PBlackSmokeInheritance
{
  Scale 0.65
  Alpha 0.6
  +CLIENTSIDEONLY
  +NOINTERACTION
}

Actor PBlackSmokeTrailDark : PBlackSmokeTrailNormal
{
  Scale 0.5
  Renderstyle Stencil
  StencilColor Black
  Alpha 0.3
  +CLIENTSIDEONLY
  +NOINTERACTION
  States
  {
  "GTFO Plus":
	"####" "#" 0 A_SetScale(ScaleX +0.01, ScaleY +0.01)
	"####" "#" 1 A_FadeOut(0.005+frandom(-0.005,0.01),1)
	Loop
  "GTFO Minus":
	"####" "#" 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	"####" "#" 1 A_FadeOut(0.005-frandom(-0.005,0.01),1)
	Loop
  }
}

Actor PBlackHoleProjectile
{
  Projectile
  Height 6
  Radius 11
  Speed 30
  FastSpeed 40
  Scale 1.0
  Renderstyle Translucent
  Alpha 0.8
  Damage (0)
  +RIPPER
  +DONTBLAST
  +CANNOTPUSH
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +BLOODLESSIMPACT
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Player"
  DamageType "PlayerBHole"
  ReactionTime 10
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("PBlack/Suck",5,1.0,1,ATTN_NORM)
	Goto Looplet
  Looplet:
	TNT1 A 0 A_JumpIf(user_loop > 10,"Death")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	"VOIP" A 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" BCD 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" E 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" FGH 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" I 2 Bright A_SpawnItemEx("PBlackHoleTrailer",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"VOIP" JKL 2 Bright A_SpawnItemEx("PBlackHoleSmoker",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_PlaySound("PBlack/Blast",5,1.0,0)
	TNT1 A 0 A_SpawnItemEx("PBlackHoleSpawn",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	TNT1 A 1 A_SpawnItemEx("PBlackHoleSpawnDark",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor PBlackRingTrailer
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("PBlackRingNormalTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 1 A_SpawnItemEx("PBlackRingDarkTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop 
  Vanilla:
	TNT1 A 1
	Stop
  }
}

