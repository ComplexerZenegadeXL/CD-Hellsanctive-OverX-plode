Actor PlayerMushroomFireballs
{
  Radius 10
  Height 8
  Damage (Random(60,150)) //30
  Projectile  
  RenderStyle Translucent 
  Alpha 1
  Scale 1.0
  Speed 35
  SeeSound "imp/attack"
  DeathSound "comet/explosion"
  Species "Player"
  DamageType "PlayerPyro"
  BounceCount 3
  -NOGRAVITY
  +DOOMBOUNCE
  +SKYEXPLODE
  +DONTHURTSPECIES
  +SPECTRAL
  +FRIENDLY
  +DONTHARMSPECIES
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_PlaySoundEx("HFCyb/rocket", 1, 0, 2)
	Goto Fly
  Fly:
	FRTB AB 1 Bright A_SpawnItem("HFCybFireballTrail")
	Loop
  Death:
	TNT1 A 0 A_Explode(160,192)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, frandom(0,360),SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile ("OrangeParticleSpawner", 0, 0, frandom (0,360), CMF_AIMDIRECTION, frandom (0,180))
	TNT1 A 0 A_SpawnItemEx("PlayerSuperMeteor_m_Explosion",0,0,0,0,0,0,0,0,0)
	EXPL A 0 Radius_Quake(15,20,0,20,0)
	TNT1 AAAA 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke", 0, 0, 0, frandom(-1.25, 1.25),frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	BOOM ABCDEFGHIJKLMNOP 2 Bright
	Stop
  }
}

