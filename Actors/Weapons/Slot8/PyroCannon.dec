}

Actor PlayerSuperMeteor_m_Explosion : SuperMeteor_m_Explosion
{
  Species "Player"
  DamageType "PlayerPyro"
  States
  {
  Spawn:
	TNT1 A 1 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3, 28, 1, 4, 0)
	TNT1 A 0 A_Explode(256,256)
	Goto Death
  }
}

