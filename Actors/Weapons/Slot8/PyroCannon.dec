Actor PlayerPyroShot
{
  Projectile
  +SEEKERMISSILE
  +FORCERADIUSDMG
  +NOGRAVITY
  +MTHRUSPECIES
  +THRUSPECIES
  +DONTREFLECT
  +FRIENDLY
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  SeeSound "weapons/firbfi"
  DeathSound "weapons/hellex"
  Species "Player"
  DamageType "PlayerPyro"
  Obituary "$CFPlayerPyroShotObit"
  Alpha 1.0
  Scale 1.4
  RenderStyle Add
  Speed 45
  FastSpeed 50
  Damage (random(1000,2000))//300
  Radius 11
  Height 6
  States
  {
  Spawn:
    HFBA ABC 1 A_SpawnItemEx("PHFExTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_SeekerMissile(10,10)
    Goto Spawn+2
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,135,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,225,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("PFuelExplosion01",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_Mushroom("PlayerMushroomFireballs",8,MSF_STANDARD|MSF_DONTHURT)
	TNT1 A 0 A_Explode(random(4000,5000),400)
    HFBA DEFGHIJKLMN 1 Bright 
	TNT1 A 0 A_SpawnItemEx("PyroShotEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor MonsterExplode
{
  DamageType "MonsterExplode"
  Species "Player"
  +FORCERADIUSDMG
  +MTHRUSPECIES
  +THRUSPECIES
  +NODAMAGETHRUST
  States
  {
  Spawn:
	TNT1 A 1
	Goto Death
  Death:
	//TNT1 A 0 Radius_Quake(15,20,0,20,0)
	HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,135,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,225,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("MonsterExplosion",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	HFBA D 0 A_Mushroom("MonsterMushroomFireBalls",16,MSF_STANDARD|MSF_DONTHURT)
	TNT1 A 0 A_Explode(random(400,500),512,0)
    HFBA DEFGHIJKLMN 1 Bright 
	TNT1 A 0 A_SpawnItemEx("PyroShotEx",0,0,0,0,0,0,0)
	Stop
  }
}

