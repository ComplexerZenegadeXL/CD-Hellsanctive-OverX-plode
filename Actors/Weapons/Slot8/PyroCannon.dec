Actor PyroCannonGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFPyroCannonPickup"
  Tag "$CFPyroCannon"
  States
  {
  Spawn:
    WPYR A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",8,1)
	WPYR A -1
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",43,-1,5) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("PyroCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("PyroCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",99)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("Gas",50)
	Stop
  }
}

Actor PyroCannonSpawnerGiver : PyroCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PyroCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("PyroCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",99)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("PyroCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("PyroCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("Gas",50)
	Stop
  }
}

Actor PyroCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor PyroCannon : Weapon 24004
{
  Inventory.PickupMessage "$CFPyroCannonPickup"
  Obituary "$CFPyroCannonObit"
  Weapon.PreferredSkin "DemonTechBFG10K-Marine"
  Weapon.SelectionOrder 3
  Weapon.AmmoType "Gas"
  Weapon.AmmoType2 "Gas"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 8
  Weapon.SlotPriority 3.0
  Weapon.AmmoUse 150
  Weapon.Kickback 50
  //Weapon.MinSelectionAmmo1 150
  Weapon.SelectionOrder 7000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFPyroCannon"
  States
  {
  Spawn:
    WPYR A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",8,1)
	WPYR A -1
    Loop
  Ready:
	PYRG A 1 A_WeaponReady
    Loop
  Deselect:
    PYRG A 1 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("RMLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("PyroCannon",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_PlayWeaponSound("weapons/PCNNpickup")
    PYRG A 1 A_Raise
    Goto SelectLoop + 1
  Fire:
    TNT1 A 0 A_JumpIfInventory("Gas",150,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	PYRG A 5
    PYRG B 8 Bright A_GunFlash
	TNT1 A 0 A_PlaySound("weapons/PCNNF")
	TNT1 A 0 A_Recoil(38)
    PYRG C 10 Bright A_FireCustomMissile("PlayerPyroShot", 0, 0, 0, 0)
	TNT1 A 0 A_TakeInventory("Gas",150)
    PYRG DEFG 2 Bright
	TNT1 A 0 A_ZoomFactor(0.975)
	PYRG A 1 Bright Offset(2,34)
	TNT1 A 0 A_ZoomFactor(0.95)
	PYRG A 1 Bright Offset(4,36)
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam")
	PYRG AAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("LegendaryCannonSmoke",78+frandom(-4,4),0,-1,0)
    Goto Ready
  Flash:
    TNT1 A 8 A_Light1
    TNT1 A 10 A_Light2
    TNT1 A 15 A_Light1
    TNT1 A 1 A_Light0
    Stop
  }
}

Actor GasPickup : BulletMagPickup
{
  Scale 0.9
  Inventory.PickupMessage "$CFGasPickup"
  Inventory.PickupSound "misc/pickup"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
  SpawnLoop:
	AGAS A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",6,25)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",6) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

