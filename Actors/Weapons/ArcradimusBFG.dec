//PROJECTILE

Actor ArcradimusBall
{
  Radius 11
  Height 6
  Speed 10 // 10
  DamageType "Legendary"
  Damage (Random(50,75)) //125
  Projectile
  RenderStyle Add
  +FORCERADIUSDMG
  //+FOILINVUL
  +RIPPER
  +BLOODLESSIMPACT
  //+DONTBLAST
  -RANDOMIZE
  Scale 1.0
  Alpha 1.0
  //MissileType "ArcLesserProjectileTrail"
  SeeSound "Arcradimus/BFGFire"
  States
  {
  Spawn:
	TNT1 A 0
    // Green
	TNT1 A 0 A_PlaySound("Arcradimus/BFGBall",5,1.0,True)
	TNT1 A 0 A_Explode(60,128,0,1)
	TNT1 A 0 A_SpawnItemEx("ArcTrail",5,0,0,0,0,0,0,0,0)
    TNT1 A 0 A_Jump(224,2)
	TNT1 A 0 A_SpawnItemEx("ArcBallFluxShockwave",0,0,0,10,0,0,0,0,0)
    TNT1 A 0 A_Jump(32,2)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL A 1 Bright
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL A 1 Bright
    // Blue
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_Explode(60,128,0,1)
	TNT1 A 0 A_SpawnItemEx("ArcTrail",5,0,0,0,0,0,0,0,0)
    TNT1 A 0 A_Jump(224, 2)
	TNT1 A 0 A_SpawnItemEx("ArcBallFluxShockwave",0,0,0,10,0,0,0,0,0)
    TNT1 A 0 A_Jump(16, 2)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt5",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL B 1 Bright
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL B 1 Bright
    // Pink
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_Explode(60,128,0,1)
	TNT1 A 0 A_SpawnItemEx("ArcTrail",5,0,0,0,0,0,0,0,0)
    TNT1 A 0 A_Jump(224, 2)
	TNT1 A 0 A_SpawnItemEx("ArcBallFluxShockwave",0,0,0,10,0,0,0,0,0)
    TNT1 A 0 A_Jump(16, 2)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL C 1 Bright
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL C 1 Bright
    // Gold
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_Explode(60,128,0,1)
	TNT1 A 0 A_SpawnItemEx("ArcTrail",5,0,0,0,0,0,0,0,0)
    TNT1 A 0 A_Jump(224, 2)
	TNT1 A 0 A_SpawnItemEx("ArcBallFluxShockwave",0,0,0,10,0,0,0,0,0)
    TNT1 A 0 A_Jump(16, 2)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt5",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL D 1 Bright
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL D 1 Bright
    // Red
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_Explode(60,128,0,1)
	TNT1 A 0 A_SpawnItemEx("ArcTrail",5,0,0,0,0,0,0,0,0)
    TNT1 A 0 A_Jump(224, 2)
	TNT1 A 0 A_SpawnItemEx("ArcBallFluxShockwave",0,0,0,10,0,0,0,0,0)
    TNT1 A 0 A_Jump(16, 2)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt5",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL E 1 Bright
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL E 1 Bright
	Loop
  Death:
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_SpawnItem("Darkdesnuke")
	TNT1 A 0 A_Explode(Random(4000,6000),512,0,1)
	TNT1 A 0 A_BFGSpray("ArcSpray",15,20)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("ArcStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ArcStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	//TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("ArcSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),0,0)
	//TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("ArcChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	//TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("ArcChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	Stop
  }
}

Actor ArcradimusBallCharging : ArcradimusBall
{
  Speed 0
  -MISSILE
  -SOLID
  +THRUACTORS
  +NOINTERACTION
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +NOCLIP
  -NONETID
  States
  {
  Spawn:
    // Green
	TNT1 A 0 A_PlaySound("Arcradimus/BFGBall",CHAN_BODY,1.0,False)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL A 1 Bright A_FadeOut(0.01)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL A 1 Bright
    // Blue
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL B 1 Bright A_FadeOut(0.01)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL B 1 Bright
    // Pink
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL C 1 Bright A_FadeOut(0.01)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL C 1 Bright
    // Gold
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL D 1 Bright A_FadeOut(0.01)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL D 1 Bright
    // Red
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL E 1 Bright A_FadeOut(0.01)
    TNT1 A 0 A_SpawnItemEx("LCABFGChargeParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	HBAL E 1 Bright
	Loop
  Death:
    TNT1 A 1
	Stop
  }
}

