Actor LegendaryCoachgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryCoachgunPickup"
  Inventory.PickupSound "Coachgun/Pickup"
  Tag "$CFLegendaryCoachgun"
  States
  {
  Spawn:
	LSS0 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	LSS0 A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",27,12,12) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryCoachgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",40)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LegendaryCoachShells",Random(1,2))
	TNT1 A 0 A_GiveInventory("LegendaryShell",8)
	Stop
  }
}

Actor LegendaryCoachgunSpawnerGiver : LegendaryCoachgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryCoachgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",40)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryCoachgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryCoachgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LegendaryCoachShells",Random(1,2))
	TNT1 A 0 A_GiveInventory("LegendaryShell",8)
	Stop
  }
}

Actor LegendaryCoachgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryCoachgun : DoomWeapon
{
  Scale 0.85
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "DoubleBarrelSG-Marine"
  Decal "LegBulletChip"
  Weapon.KickBack 100
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 11.0
  Weapon.AmmoType "LegendaryCoachShells"
  Weapon.AmmoType2 "LegendaryShell"
  Weapon.SelectionOrder 1200
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFLegendaryCoachgunPickup"
  Inventory.PickupSound "Coachgun/Pickup"
  Obituary "$CFLegendaryCoachgunObit"
  Tag "$CFLegendaryCoachgun"
  States
  {
  Spawn:
	LSS0 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	LSS0 A -1 Bright
	Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("Coachgun/Pickup")
	LSS7 ABCDEFGH 1
  ReadyLoop:
	LSSG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryCoachgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	LSSG A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",2,"FireBoth")
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",1,"Reload")
	Goto Empty
  FireBoth:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireBothSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Coachgun/Fire1",1)
	TNT1 A 0 Radius_Quake(6,5,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 A 0 A_FireBullets(10,5,20,random(15,20),"LegendaryASGBulletPuff")
	LSSF AB 1 Bright Radius_Quake(6,5,0,1,0)
	LSSF CD 1 Bright
	LSSF EEFFGG 1
	LSSG AAA 1
  SSGReloadCheck:
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",2,2)
	LSSG A 2
	Goto ReadyLoop
	TNT1 A 0
	Goto ReloadBoth
  FireBothSpread:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Coachgun/Fire1",1)
	TNT1 A 0 Radius_Quake(6,5,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-8,8)+15.0,0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-8,8)-15.0,0,0,frandom(-8,8))
	TNT1 A 0 A_FireBullets(10+15.0,5,60,random(14,18),"LegendaryASGBulletPuff")
	LSSF AB 1 Bright Radius_Quake(6,5,0,1,0)
	LSSF CD 1 Bright
	LSSF EEFFGG 1
	LSSG AAA 1
	Goto SSGReloadCheck
  AltFire:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",1,1)
	Goto Reload
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",1)
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,6),0,0,frandom(-6,6))
	LSS9 G 1 Bright A_FireBullets(4,2,10,Random(15,20),"LegendaryASGBulletPuff")
	LSS9 H 1 Bright
	LSS9 IDEF 1
	LSSG A 2
	Goto ReadyLoop
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",1,1)
	Goto Reload
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",1)
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,-6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,-6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,-6)+15.0,0,0,frandom(-6,6))
	//TNT1 A 0 A_FireBullets(4+15.0,2,10,Random(15,20),"LegendaryASGBulletPuff")
	//TNT1 A 0 A_FireBullets(4+15.0,2,10,Random(15,20),"LegendaryASGBulletPuff")
	LSS9 G 1 Bright A_FireBullets(4+15.0,2,30,Random(14,18),"LegendaryASGBulletPuff")
	LSS9 H 1 Bright
	LSS9 IDEF 1
	LSSG A 2
	Goto ReadyLoop
  FireRight:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireRightSpread")
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",1)
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",Random(6,-6),0,0,Random(6,-6))
	LSS9 A 1 Bright A_FireBullets(4,2,10,Random(14,18),"LegendaryASGBulletPuff")
	LSS9 B 1 Bright
	LSS9 CDEF 1
	LSSG A 2
	Goto ReadyLoop
  FireRightSpread:
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	TNT1 A 0 A_TakeInventory("LegendaryCoachShells",1)
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-6,6)-15.0,0,0,frandom(-6,6))
	//TNT1 A 0 A_FireBullets(4+15.0,2,10,Random(20,28),"LegendaryASGBulletPuff")
	//TNT1 A 0 A_FireBullets(4+15.0,2,10,Random(20,28),"LegendaryASGBulletPuff")
	LSS9 A 1 Bright A_FireBullets(4+15.0,2,30,Random(14,18),"LegendaryASGBulletPuff")
	LSS9 B 1 Bright
	LSS9 CDEF 1
	LSSG A 2
	Goto ReadyLoop
  Empty:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",1,"Empty2")
	LSSG A 10 A_PlaySound("weapons/click")
	Goto ReadyLoop
  Empty2:
	LSSG A 10 A_PlaySound("weapons/click")
	Goto ReadyLoop
  Reload:
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",0,"ReadyLoop")	
	TNT1 A 0 A_JumpIfInventory("LegendaryCoachShells",1,"ReloadRight")	
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",2,"ReloadBoth")
	Goto Empty	
  ReloadBoth:
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",2,1)
	Goto ReadyLoop
	LSSG A 1
	LSSR BCDEFGHIJKLMNOP 1
	LSSR P 2 A_PlaySound("Coachgun/Open",7)
	TNT1 AA 0 A_SpawnItemEx("BlueShellCasing",25,-2,25,Random(2,4),Random(-6,-3),Random(3,6),0)
	LSS2 ABCDEFGHIJ 1
	TNT1 A 0 A_PlaySound("Coachgun/Load",7)
	TNT1 A 0 A_TakeInventory("LegendaryShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("LegendaryCoachShells",2)
	LSS2 KLMNO 1
	LSS3 ABCDEFGH 1
	LSS3 I 2 A_PlaySound("Coachgun/Close",7)
	LSS3 IJK 1
	LSSG A 2
	Goto ReadyLoop
  ReloadRight:
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",1,1)
	Goto ReadyLoop
	LSSR BCDEFGNOP 1
	LSS3 P 1 A_PlaySound("Coachgun/Open",7)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	LSS3 PQR 1
	LSSG UVWX 1
	TNT1 A 0 A_PlaySound("Coachgun/Load",7)
	TNT1 A 0 A_TakeInventory("LegendaryShell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("LegendaryCoachShells",1)
	LSS2 KLMNO 1
	LSS3 ABCDEFGH 1
	LSS3 I 2 A_PlaySound("Coachgun/Close",7)
	LSS3 IJK 1
	LSSG A 2
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LSS8 FEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	LSS8 ABCDEF 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LSS8 FEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1	
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	LSS8 ABCDEF 1
	Goto ReadyLoop
	}
}

Actor LegendaryCoachShells : Ammo
{
  +IGNORESKILL
  Inventory.Amount 0
  Inventory.MaxAmount 2
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 2
  Inventory.Icon "LSS0A0"
}
