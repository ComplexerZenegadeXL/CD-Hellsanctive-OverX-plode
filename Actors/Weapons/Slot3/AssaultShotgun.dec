Actor AssaultShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "AShotgun/Cock"
  Inventory.PickupMessage "$CFAssaultShotgunPickup"
  Tag "$CFAssaultShotgun"
  States
  {
  Spawn:
	SMAP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SMAP A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",65,5,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("AssaultShotgun",1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,1)
	TNT1 A 0 A_GiveInventory("AssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",31)
	TNT1 A 0 A_GiveInventory("ShotgunDrum",Random(6,12))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor AssaultShotgunSpawnerGiver : AssaultShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("AssaultShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("RapidShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,1)
	TNT1 A 0 A_GiveInventory("AssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",31)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("AssaultShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("AssaultShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ShotgunDrum",Random(6,12))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor AssaultShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor AssaultShotgun : DoomWeapon //16650
{
  //$Category Weapons/LCA
  //$Sprite SMAPA0
  //$Title "AssaultShotgun"
  Scale 0.85
  Weapon.PreferredSkin "AssaultSG-Marine"
  Weapon.KickBack 80
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 2.0
  Weapon.AmmoType "ShotgunDrum"
  Weapon.AmmoType2 "NewShell"
  Weapon.SelectionOrder 7000
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupSound "AShotgun/Cock"
  Inventory.PickupMessage "$CFAssaultShotgunPickup"
  Obituary "$CFAssaultShotgunObit"
  Decal "BulletChip"
  Tag "$CFAssaultShotgun"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States
  {
  Spawn:
    SMAP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SMAP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("AShotgun/Cock")
	ASGW A 1
	ASGR ABCDE 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    SMAG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect: 
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    SMAG A 1 A_Lower
    Goto Deselect+1
  Select:
	TNT1 A 0 A_Raise
    Wait	
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlayWeaponSound("AShotgun/Fire")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-5,5),0,0,frandom(-5,5))
    SMAF A 2 Bright A_FireBullets(5.0,3.0,8,Random(9,14),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
    SMAF B 2 Bright
    SMAG BCDE 1
	SMAG FA 2
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlayWeaponSound("AShotgun/Fire")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-5,5),0,0,frandom(-5,5))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-5,5)+15.0,0,0,frandom(-5,5))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-5,5)-15.0,0,0,frandom(-5,-5))
	//TNT1 A 0 A_FireBullets(5.0+15.0,3.0,8,Random(9,14),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(5.0+15.0,3.0,8,Random(9,14),"PlayerModdedBulletPuff",FBF_NORANDOM)
    SMAF A 2 Bright A_FireBullets(5.0+15.0,3.0,24,Random(9,14),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
    SMAF B 2 Bright
    SMAG BCDE 1
	SMAG FA 2
    Goto ReadyLoop
  Empty:
    SMAG A 10 A_PlaySound("weapons/click",CHAN_6)	
  Reload:
    TNT1 A 0 A_JumpIfInventory("ShotgunDrum",12,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto ReadyLoop
	SMAR ABCD 1
	SMAR EF 2
	SMAR G 6
	TNT1 A 0 A_JumpIfInventory("ShotgunDrum",1,"Reload2")
  ActualReload:   
    SMAR HI 1
	SMAR J 1 A_PlaySound("Weapons/ASGShellLoad",CHAN_6)
	SMAR K 1
	TNT1 A 0 A_TakeInventory("NewShell",1)
	TNT1 A 0 A_GiveInventory("ShotgunDrum",1)
	SMAR L 1
	TNT1 A 0 A_JumpIfInventory("ShotgunDrum",11,"FullCock")
	SMAR MN 1
	SMAR O 2
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheckReloading")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheckReloading")
	SMAR G 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"ActualReload")
  FullCock:
    SMAR P 3
    SMAR Q 2
    SMAR CBA 1
	SMAK A 1
	SMAK B 2
	SMAK C 3 A_PlaySound("AShotgun/Cock",CHAN_6)
	SMAK D 5
	SMAK E 2
	Goto ReadyLoop	
  Reload2:   
    SMAR HI 1
	SMAR J 1 A_PlaySound("Weapons/ASGShellLoad",CHAN_6)
	SMAR K 1
	TNT1 A 0 A_TakeInventory("NewShell",1)
	TNT1 A 0 A_GiveInventory("ShotgunDrum",1)
	SMAR L 1
	TNT1 A 0 A_JumpIfInventory("ShotgunDrum",12,"Full")
	SMAR MN 1
	SMAR O 2
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheckReloading")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheckReloading")
	SMAR G 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"Reload2")
  Full:
    SMAR P 3
    SMAR Q 2
    SMAR CBA 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeCheckReloading:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ActualReload	
  GrenadeToss:
  	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	ASGR EDCBA 1
	ASGW A 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineCheckReloading:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ActualReload
  MineToss:
  	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	ASGR EDCBA 1
	ASGW A 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor ShotgunDrum : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 12
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 12
  Inventory.Icon "ASTHA0"
  +IGNORESKILL
}
