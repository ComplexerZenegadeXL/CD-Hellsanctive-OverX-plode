	TNT1 A 0 A_SpawnItemEx("EPSG82",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSG92",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSG102",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSG112",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EPSG122",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 1
	Stop
  }
}

