Actor RedDemonTechProjectile
{
  PROJECTILE
  Height 4
  Radius 4
  Speed 80
  FastSpeed 100
  Damage 4
  Scale 0.06
  Decal RedDTRScorch
  +FORCERADIUSDMG
  +THRUSPECIES
  +DONTHARMSPECIES
  Species "Player"
  DamageType "PDTPuff"
  DeathSound "weapons/demontechex"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
  Normal:
	TNT1 A 0 A_Jump(128,"NormalFX")
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Loop
  NormalFX:
	TNT1 A 0 A_SpawnItemEx("RDTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),Random(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RDTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Goto Normal
  Spawn2:
	TNT1 A 0 A_Jump(128,"Spawn2FX")
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Loop
  Spawn2FX:
	TNT1 A 0 A_SpawnItemEx("RDTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RDTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTProjectileTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Goto Spawn2  
  Death:
	TNT1 A 0
	TNT1 A 0 A_CustomMissile("PlayerASFire",0,0,frandom(0,360),CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawnerDT",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("RedDTKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1 A_Explode(15,64,0)
	Stop
  }
}

