  {
  Spawn:
	TRA3 A 10 Bright
	Loop
  Death:
	TNT1 A 1 
	Stop
  }
}

Actor DemonShotgunPuff
{
  Height 6
  Radius 6
  Scale 0.3
  Renderstyle Add
  Alpha 0.85
  Decal "DoomImpScorch"
  +NOBLOCKMAP
  +NOGRAVITY
  +ACTIVATEIMPACT
  +ACTIVATEPCROSS
  +NOTELEPORT 
  +EXTREMEDEATH
  +PUFFONACTORS 
  +BLOODLESSIMPACT
  +FORCERADIUSDMG
  +ALWAYSPUFF
  +DONTHARMSPECIES
  +PUFFGETSOWNER
  Species "Player"
  DamageType "PDTPuff"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("RedDTKaboom2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFOG A 3 Bright A_Explode(Random(12,17),8,0)
	BFOG BCDEF 3 Bright
	Stop
  }
}

