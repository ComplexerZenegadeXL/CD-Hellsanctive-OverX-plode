Actor EnragedLegendaryASGGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFEnragedLegendaryASGPickup"
  Tag "$CFEnragedLegendaryASG"
  States
  {
  Spawn:
    IMAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	IMAP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",4,13,13) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryASG",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryASG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",35)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("EnragedLegendaryShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("EnragedLegendaryShell",8)
	Stop
  }
}

Actor EnragedLegendaryASGSpawnerGiver : EnragedLegendaryASGGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryASG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("EnragedLegendaryASG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",35)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("EnragedLegendaryASGGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryASGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("EnragedLegendaryShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("EnragedLegendaryShell",8)
	Stop
  }
}

Actor EnragedLegendaryASGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor EnragedLegendaryASG : DoomWeapon
{
  Scale 0.85
  Weapon.PreferredSkin "EnragedLegendaryASG-Marine"
  Weapon.KickBack 160
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 12.0
  Weapon.AmmoType "EnragedLegendaryShotgunDrum"
  Weapon.AmmoType2 "EnragedLegendaryShell"
  Weapon.SelectionOrder 800
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFEnragedLegendaryASGPickup"
  Decal "ELegBulletChip"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +NOTIMEFREEZE
  Tag "$CFEnragedLegendaryASG"
  States
  {
  Spawn:
    IMAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	IMAP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("LShotgun/Cock")
	EASG VWXYZ 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("EnragedASGMode1",1,"Ready2")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    EASG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EAS2 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  AltFire:
	TNT1 A 0 A_JumpIfInventory("EnragedASGMode1",1,"ChangeMode")
	TNT1 A 0 A_Print("$EnragedShotgunMessage1")
	TNT1 A 0 A_PlaySound("LShotgun/Cock")
	TNT1 A 0 A_GiveInventory("EnragedASGMode1")
	EASG A 3 Offset(0,34)
	EASG A 2 Offset(0,37)
	EASG A 2 Offset(0,40)
	EAS2 A 2 Offset(0,37)
	EAS2 A 3 Offset(0,34)
	TNT1 A 0 Offset(0,32)
	Goto Ready2
  ChangeMode:
	TNT1 A 0 A_Print("$EnragedShotgunMessage2")
	TNT1 A 0 A_PlaySound("LShotgun/Cock")
	TNT1 A 0 A_TakeInventory("EnragedASGMode1")
	EAS2 A 3 Offset(0,34)
	EAS2 A 2 Offset(0,37)
	EAS2 A 2 Offset(0,40)
	EASG A 2 Offset(0,37)
	EASG A 3 Offset(0,34)
	TNT1 A 0 Offset(0,32)
	Goto ReadyLoop
  Deselect: 
    TNT1 A 0 A_PlaySound("weapons/weapondown")
    EASG A 1 A_Lower
    Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("EnragedLegendaryASG",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait	
  Fire:
	TNT1 A 0 A_JumpIfInventory("EnragedASGMode1",1,"Fire2")
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RedShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-5,5),0,0,frandom(-5,5))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-10,10),0,0,frandom(-10,10))
    TNT1 A 0 A_FireBullets(3,1.5,3,Random(15,20),"EnragedModdedBulletPuff",0)
    EASG B 1 Bright A_FireBullets(6.2,3.4,4,Random(15,20),"EnragedModdedBulletPuff")
    EASG C 1 Bright
    EASG DEFG 1
	EASG HI 2
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("EnragedASGMode1",1,"Fire2")
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RedShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-5,5),0,0,frandom(-5,5))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-5,5)+15.0,0,0,frandom(-5,5))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-5,5)-15.0,0,0,frandom(-5,5))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-10,10),0,0,frandom(-10,10))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-10,10)+15.0,0,0,frandom(-10,10))
	TNT1 AAA 0 A_FireCustomMissile("RedSGTracer",frandom(-10,10)-15.0,0,0,frandom(-10,10))
    TNT1 A 0 A_FireBullets(3+15.0,1.5,9,Random(15,20),"EnragedModdedBulletPuff",0)
    EASG B 1 Bright A_FireBullets(6.2+15.0,3.4,12,Random(15,20),"EnragedModdedBulletPuff")
    EASG C 1 Bright
    EASG DEFG 1
	EASG HI 2
    Goto ReadyLoop
  Fire2:
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryShotgunDrum",3,"ActualFire2")
	Goto Empty2
  ActualFire2:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"ActualFire2Spread")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 AAA 0 A_SpawnItemEx("RedShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_TakeInventory("EnragedLegendaryShotgunDrum",3,TIF_NOTAKEINFINITE)
    EAS2 B 2 Bright A_FireCustomMissile("EnragedASGRail",0,0,0,0)
    EAS2 CC 1 Bright
    EAS2 DEFG 3
	EAS2 HI 6
    Goto ReadyLoop
  ActualFire2Spread:
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 AAA 0 A_SpawnItemEx("RedShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_TakeInventory("EnragedLegendaryShotgunDrum",3,TIF_NOTAKEINFINITE)
    EAS2 B 2 Bright A_FireCustomMissile("EnragedASGRail",0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("EnragedASGRail",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("EnragedASGRail",-15.0,0,0,0)
    EAS2 CC 1 Bright
    EAS2 DEFG 3
	EAS2 HI 6
    Goto ReadyLoop
  Empty:
    EASG A 10 A_PlaySound("weapons/click")
	Goto Reload
  Empty2:
	EAS2 A 10 A_PlaySound("weapons/click")
  Reload:
  	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryShotgunDrum",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("EnragedLegendaryShell",1,1)
	Goto ReadyLoop
	EASG JKLMN 1
	EASG O 2
	EASR A 2 A_PlaySound("lasgguy/asgout")
  	EASR B 3
	EASG U 40 A_FireCustomMissile("EnragedLegendaryEmptyDrumSpawner", 0, 0, 10, 1) 
	EASG TSR 1
	EASG Q 2
  ActualReload:
	TNT1 A 0 A_TakeInventory("EnragedLegendaryShell",1)
	TNT1 A 0 A_GiveInventory("EnragedLegendaryShotgunDrum",1)
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryShotgunDrum",16,2)
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryShell",1,"ActualReload")
	TNT1 A 0
	Goto Reload2
  Reload2:
	EASG P 3
	EASG O 6 A_PlaySound("lasgguy/asgin")
	EASG NMLKJ 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1,TIF_NOTAKEINFINITE)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EASG ZYXWV 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN KLM 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	EASG VWXYZ 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EASG ZYXWV 1
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	Goto Ready+1
  }
}

Actor EnragedASGMode1 : Inventory {}

Actor EnragedASGRail : DarkCyberRail
{
  Damage (Random(200,400)) //75
  MissileType "ELegRevRailgunTrail"
  Species "Player"
  DamageType "Legendary" 
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 1 Bright
    Loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveRed", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_SpawnItem("RailgunImpactEffectRed")
	Stop
  }
}

Actor EnragedLegendaryShotgunDrum : Ammo
{
  Inventory.Amount 16
  Inventory.MaxAmount 16
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 16
  Inventory.Icon "IMAPA0"
  +IGNORESKILL
  +NOTIMEFREEZE
}
Actor EnragedLegendaryEmptyDrum : BulletCasing
{
  Scale 0.2
  Seesound "weapons/emptydrum"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	IDRM ABCD 3 
	Loop
  Death:
	TNT1 A 0
    TNT1 A 0 A_Jump(128,3)
    IDRM A 100
    IDRM A 5 A_FadeOut(0.10)
    Goto Death+3
    IDRM C 100
	IDRM C 5 A_FadeOut(0.10)
	Goto Death+5
  }
}

Actor EnragedLegendaryShellPickup : LegendaryShellPickup
{
  Scale 0.3
  Inventory.PickupMessage "$CFEnragedLegendaryShellPickup"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	IESS A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",14,4)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",14) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor EnragedLegendaryShell : Ammo
{
  Scale 0.3
  Inventory.PickupMessage "$CFEnragedLegendaryShellPickup"
  Inventory.PickupSound "items/shell"
  Inventory.Amount 4
  Inventory.MaxAmount 40
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 90
  Inventory.Icon "IHELA0"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	IESS A -1
    Stop
  }
}

