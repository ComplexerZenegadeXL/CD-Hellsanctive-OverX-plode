Actor EnragedLegendaryShellBox : EnragedLegendaryShell
{
  Scale 0.75
  Inventory.Amount 10
  Inventory.PickupMessage "$CFEnragedLegendaryShellBoxPickup"
  Inventory.PickupSound "items/shellbox"
  Inventory.Icon "IBOXA0"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
