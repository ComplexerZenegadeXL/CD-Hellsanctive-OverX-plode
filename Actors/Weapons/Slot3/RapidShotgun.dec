Actor RapidShotgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFRapidShotgunPickup"
  Inventory.PickupSound "weapons/pickupssg"
  Tag "$CFRapidShotgun"
  States
  {
  Spawn: 
    HCNG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	HCNG A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",4,-1,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("RapidShotgun",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,3)
	TNT1 A 0 A_GiveInventory("RapidShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",44)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewShell",10)
	Stop
  }
}

Actor RapidShotgunSpawnerGiver : RapidShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RapidShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,3)
	TNT1 A 0 A_GiveInventory("RapidShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",44)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("RapidShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("RapidShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewShell",10)
	Stop
  }
}

Actor RapidShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor RapidShotgun : DoomWeapon
{ 
  Scale 0.8
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.SelectionOrder 700
  Weapon.PreferredSkin "Rapid-Shotgun-Marine"
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 8.0
  Weapon.AmmoType "NewShell"
  Weapon.AmmoType2 "NewShell"
  Weapon.SisterWeapon "PoweredRapidShotgun"
  //Weapon.MinSelectionAmmo1 1
  AttackSound "weapons/12gaugefire"
  Inventory.PickupMessage "$CFRapidShotgunPickup"
  Inventory.PickupSound "weapons/minigunpickup"
  Obituary "CFRapidShotgunObit"
  Tag "$CFRapidShotgun"
  Decal "BulletChip"
  var int user_thingtid;
  var int user_playertid;
  States 
  { 
  Spawn: 
    HCNG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	HCNG A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial",1)
	//TNT1 A 1
	//TNT1 A 0 ACS_NamedExecuteWithResult("SetTargetForWeapon")
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",10,0,1)
	TNT1 A -1
	Stop
  Flash: 
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light2 
    TNT1 A 0 A_Light0
    Goto LightDone 
  Ready:  
	TNT1 A 0 A_PlayWeaponSound("weapons/minigunpickup")
	CGRS ABCDE 1 
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    QCHG A 1 A_WeaponReady 
	Goto Ready+6
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)    
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	QCHG A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("RapidShotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	TNT1 A 1 A_Raise
	Wait 
  Fire:
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastSpin")
    TNT1 A 0 A_JumpIfInventory("RapidShotgunSpin",1,"Hold") 
    TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6)
    QCHG ABCDABCDABCDABCD 2
    TNT1 A 0 A_Refire
    TNT1 A 0 A_Playsound("HeavyChaingun/Down",6)
    Goto SpinStop
	FastSpin:
	TNT1 A 0 A_JumpIfInventory("RapidShotgunSpin",1,"FastHold")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6)
    QCHG ABCDABCDABCDABCD 4 //DBDB 1
    TNT1 A 0 A_Refire("FastHold")
    Goto FastHoldSpinStop
  Hold:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HoldSpread")
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1) 
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHold")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG E 4 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    QCHG BC 2
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG F 4 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")  
    QCHG BC 2
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG H 4 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM) 
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    QCHG BC 2
    TNT1 A 0 A_Refire
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    QCHG CDABCDABCDA 2 A_WeaponReady(WRF_NOSECONDARY)  
    QCHG BCD 2 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 2    
    QCHG CD 3 
    Goto Ready+6  
  HoldSpread:
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1) 
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHold")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,12,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
    QCHG E 4 Bright A_FireBullets(11.8+15.0,7.3,9,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    QCHG BC 2
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),Random(-90,-80),SXF_NOCHECKPOSITION)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,12,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
    QCHG F 4 Bright A_FireBullets(11.8+15.0,7.3,9,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")  
    QCHG BC 2 
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(15+15.0,12.2,4,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,12,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(15,20),"PlayerModdedBulletPuff",FBF_NORANDOM)
    QCHG H 4 Bright A_FireBullets(11.8+15.0,7.3,9,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    QCHG BC 2
    TNT1 A 0 A_Refire
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    QCHG CDABCDABCDA 2 A_WeaponReady(WRF_NOSECONDARY)  
    QCHG BCD 2 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 2    
    QCHG CD 3 
    Goto Ready+6  
  JustSpin: 
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastJustSpin")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1)  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
    QCHG DABCDABCDAB 2 A_JumpIfInventory("NewShell",1,"Hold")
    TNT1 A 0 A_Refire("JustSpin")
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    QCHG CDABCDABCDA 2 A_WeaponReady(WRF_NOSECONDARY)  
    QCHG BCD 2 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 2
    QCHG CD 3
    Goto Ready+6 	
  FastJustSpin: 
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
    QCHG DABCDABCDAB 4 A_JumpIfInventory("NewShell",1,"Hold")
    TNT1 A 0 A_Refire("FastJustSpin")
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)
    QCHG CDABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)
    QCHG BCD 4 A_WeaponReady(WRF_NOSECONDARY)
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 4
    QCHG CD 6
    Goto Ready+6
  SpinStop:
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    QCHG A 0 A_GiveInventory("RapidShotgunSpin",1)
    QCHG B 0 A_PlaySound("HeavyChaingun/Down",6) 
    QCHG ABCDABCDABCDA 2 A_WeaponReady(WRF_NOSECONDARY)  
    QCHG BCD 2 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 2    
    QCHG CD 3
    Goto Ready+6
  FastHoldSpinStop:
    QCHG A 0 A_GiveInventory("RapidShotgunSpin",1)
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)
	QCHG ABCDABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)  
    QCHG BCD 4 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    QCHG AB 4   
    QCHG CD 6
    Goto Ready+6  
  FastHold:
	TNT1 A 0 A_JumpIfNoAmmo("FastJustSpin")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG E 8 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("FastJustSpin")
    QCHG BC 4
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG F 8 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("FastJustSpin")
    QCHG BC 4
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(11,16),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    QCHG H 8 Bright A_FireBullets(11.8,7.3,3,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("FastJustSpin")
    QCHG BC 4
    TNT1 A 0 A_Refire("FastHold")
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)
    QCHG CDABCDABCDA 1 A_WeaponReady(WRF_NOSECONDARY)
    QCHG BCD 2 A_WeaponReady(WRF_NOSECONDARY)
    QCHG AB 2
    QCHG CD 3
    Goto Ready+6 
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+7	
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	CGRS EDCBA 1
	CGRS A 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  GrenadeCheck:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	Goto Ready+6
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	CGRS EDCBA 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 1
	HGRN EFGHI 1
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN K 1
	HGRN LMNO 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0
	Goto Ready+1	
  } 
} 

Actor RapidShotgunSpin : Inventory { -INVBAR }