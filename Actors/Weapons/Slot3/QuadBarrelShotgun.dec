Actor QuadBarrelShotgunGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFQuadBarrelShotgunPickup"
  Inventory.PickupSound "weapons/pickupqsg"
  Tag "$CFQuadBarrelShotgun"
  States
  {
  Spawn:
	QSGP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	QSGP A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",69,7,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("QuadBarrelShotgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("QuadBarrelShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",43)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("QuadShell",Random(2,4))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor QuadBarrelShotgunSpawnerGiver : QuadBarrelShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("QuadBarrelShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("QuadBarrelShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",43)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("QuadBarrelShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("QuadBarrelShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("QuadShell",Random(2,4))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor QuadBarrelShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor QuadBarrelShotgun : DoomWeapon //19346
{
  Scale 0.9
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "QuadBarrelSG-Marine"
  Weapon.KickBack 100
  //Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 4.0
  Weapon.AmmoType "QuadShell"
  Weapon.AmmoType2 "NewShell"
  Weapon.SelectionOrder 6500
  //Weapon.MinSelectionAmmo1 2
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFQuadBarrelShotgunPickup"
  Inventory.PickupSound "weapons/pickupqsg"
  Tag "$CFQuadBarrelShotgun"
  Obituary "$CFQuadBarrelShotgunObit"
  States
  {
  Spawn:
	QSGP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	QSGP A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickupqsg")
	QSRS ABCDEF 1
	QSRS GH 2
  ReadyLoop:
	QSGN A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Deselect: 
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	QSGN A 1 A_Lower
	Goto Deselect+1
  Select:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("QuadShell",4,"QuadFire")
	TNT1 A 0 A_JumpIfInventory("NewShell",2,"Reload")
	Goto Empty
  QuadFire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"QuadFireSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgfire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Recoil(2)
	TNT1 A 0 Radius_Quake(10,5,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",4)	
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-10,10))
	QS4F A 2 Bright A_FireBullets(11.8,7.3,32,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QS4F B 2 Bright
	QSGN CFG 1
	QSGN H 2
	QSER A 3
	QSER B 6
	QSGN GFEDC 2
  QuadReloadCheck:
	TNT1 A 0 A_JumpIfInventory("NewShell",4,2)
	QSGN S 2
	Goto ReadyLoop
	TNT1 A 0
	Goto ReloadFourShells+3
  QuadFireSpread:
	TNT1 A 0 A_PlaySound("weapons/qsgfire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Recoil(2)
	TNT1 A 0 Radius_Quake(10,5,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",4)	
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-10,10))
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)+15.0,0,0,frandom(-10,10))
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)-15.0,0,0,frandom(-10,10))
	QS4F A 2 Bright A_FireBullets(11.8+15.0,7.3,96,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QS4F B 2 Bright
	QSGN CFG 1
	QSGN H 2
	QSER A 3
	QSER B 6
	QSGN GFEDC 2
	Goto QuadReloadCheck
  AltFire:
	TNT1 A 0 A_JumpIfInventory("QuadShell",4,"FireUpper")
	TNT1 A 0 A_JumpIfInventory("QuadShell",2,1)
	Goto Reload
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	QSGF C 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QSGF D 2 Bright
	QREC ABCDE 1
	QSGN A 1
	Goto ReadyLoop
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("QuadShell",2,1)
	Goto Reload
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)+15.0,0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)-15.0,0,0,frandom(-8,8))
	QSGF C 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QSGF D 2 Bright
	QREC ABCDE 1
	QSGN A 1
	Goto ReadyLoop
  FireUpper:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireUpperSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	QSGF A 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QSGF B 2 Bright
	QREC ABCDE 1
	QSGN A 1
	Goto ReadyLoop	
  FireUpperSpread:
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("QuadShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)+15.0,0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)-15.0,0,0,frandom(-8,8))
	QSGF A 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	QSGF B 2 Bright
	QREC ABCDE 1
	QSGN A 1
	Goto ReadyLoop	
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	QSGN AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	TNT1 A 0 A_JumpIfInventory("NewShell",4,"ReloadFourShells")
	Goto ReadyLoop
  Reload:
	TNT1 A 0 A_JumpIfInventory("QuadShell",0,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("QuadShell",2,"ReloadTwoShells")
	TNT1 A 0 A_JumpIfInventory("NewShell",4,"ReloadFourShells")
	Goto Empty	
  ReloadFourShells:
	QSGN SRQ 2
	QSGN PJ 1
	QSGN K 1
	TNT1 AAAA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	QSGN L 1
	QSGR A 12 A_PlaySound("weapons/qsgopen",CHAN_6)
	QSGR B 1
	QSGR CD 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("QuadShell",2)
	QSGR E 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)
	QSGR F 3
	QSGR G 2
	QSGR H 1
	QSGR I 8
	QSGR JK 1
	QSGR LM 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("QuadShell",2)
	QSGR N 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	QSGR O 3
	QSGR P 2
	QSGR Q 1
	QSGN MNO 1
	QSGN P 1 A_PlaySound("weapons/qsgclose",CHAN_6)
	QSGN QRS 2
	QSGN A 2
	Goto ReadyLoop
  ReloadTwoShells:
	TNT1 A 0 A_JumpIfInventory("NewShell",2,1)
	Goto ReadyLoop
	QSGN SRQ 2
	QSGN P 1
	QSEX AB 1
	TNT1 AA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	QSEX C 1
	QSGR I 12 A_PlaySound("weapons/qsgopen",CHAN_6)
	QSGR JK 1
	QSGR LM 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("QuadShell",2)
	QSGR N 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	QSGR O 3
	QSGR P 2
	QSGR Q 1
	QSGN MNO 1
	QSGN P 1 A_PlaySound("weapons/qsgclose",CHAN_6)
	QSGN QRS 2
	QSGN A 2
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	QSHT EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	QSHT ABCDE 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	QSHT EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	QSHT ABCDE 1
	Goto ReadyLoop
  }
}

Actor QuadShell : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 4
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 4
  Inventory.Icon "QSGPA0"
  +IGNORESKILL
}
