Actor NemesisSawed-OffShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFNemesisSawedOffShotgunPickup"
  Inventory.PickupSound "Coachgun/Pickup"
  Tag "$CFNemesisSawedOffShotgun"
  States
  {
  Spawn:
	NSSW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	NSSW A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",7,15,17) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("NemesisSawed-OffShotgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("NemesisSawed-OffShotgun",1)
	TNT1 A 0 A_GiveInventory("NemesisPellets",Random(1,2))
	TNT1 A 0 A_GiveInventory("NemesisShell",8)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",42)
	Stop
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NemesisPellets",Random(1,2))
	TNT1 A 0 A_GiveInventory("NemesisShell",8)
	Stop
  }
}

Actor NemesisSawed-OffShotgunSpawnerGiver : NemesisSawed-OffShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("NemesisSawed-OffShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("NemesisSawed-OffShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",42)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("NemesisSawed-OffShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("NemesisSawed-OffShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NemesisPellets",Random(1,2))
	TNT1 A 0 A_GiveInventory("NemesisShell",8)
	Stop
  }
}

Actor NemesisSawed-OffShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor NemesisSawed-OffShotgun : DoomWeapon
{
  Scale 0.85
  Weapon.PreferredSkin "DoubleBarrelSG-Marine"
  Decal "DoomImpScorch"
  Weapon.KickBack 100
  Weapon.AmmoType "NemesisPellets"
  Weapon.AmmoType2 "NemesisShell"
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 14.0
  Weapon.SelectionOrder 300
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFNemesisSawedOffShotgunPickup"
  Inventory.PickupSound "Coachgun/Pickup"
  Obituary "$CFNemesisSawedOffShotgunObit"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFNemesisSawedOffShotgun"
  States
  {
  Spawn:
	NSSW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	NSSW A -1 Bright
	Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("Coachgun/Pickup")
	NSSZ ACDFGIKMP 1
  ReadyLoop:
	NSSD A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("NemesisSawed-OffShotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	NSSD A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",2,"FireBoth")
	TNT1 A 0 A_JumpIfInventory("NemesisShell",1,"Reload")
	Goto Empty
  FireBoth:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireBothSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire1",CHAN_WEAPON)
	TNT1 A 0 Radius_Quake(6,5,0,1,0)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAAAAAA 0 Bright A_FireCustomMissile("NemesisTracer",Random(8,-8),0,0,Random(8,-8))
	//TNT1 A 0 Bright A_FireBullets(6.2,3.1,26,0,"NemesisASGPuffExplodePlayer",0)
	//NSSF A 1 Bright A_FireBullets(6.2,3.1,26,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAAAAAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10),0,0,-4,0,frandom(-6,6))
	NSSF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10),0,0,-4,0,frandom(-6,6))
	NSSF B 1
	NSSF CD 1 Bright
	NSSF E 1 Bright Radius_Quake(6,5,0,1,0)
	NSSF F 1 Bright
	NSSF GH 1
	NSSD AAAAAA 1
  SSGReloadCheck:
	TNT1 A 0 A_JumpIfInventory("NemesisShell",2,1)
	Goto ReadyLoop
	NSSC D 2
	TNT1 A 0
	Goto ReloadBoth+4
  FireBothSpread:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire1",CHAN_WEAPON)
	TNT1 A 0 Radius_Quake(6,5,0,1,0)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAAAAAA 0 Bright A_FireCustomMissile("NemesisTracer",Random(8,-8),0,0,Random(8,-8))
	//TNT1 A 0 Bright A_FireBullets(6.2,3.1,26,0,"NemesisASGPuffExplodePlayer",0)
	//NSSF A 1 Bright A_FireBullets(6.2,3.1,26,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAAAAAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10),0,0,-4,0,frandom(-6,6))
	TNT1 AAAAAAAAAAAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10)+15.0,0,0,-4,0,frandom(-6,6))
	TNT1 AAAAAAAAAAAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10)-15.0,0,0,-4,0,frandom(-6,6))
	NSSF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10),0,0,-4,0,frandom(-6,6))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10)+15.0,0,0,-4,0,frandom(-6,6))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-10,10)-15.0,0,0,-4,0,frandom(-6,6))
	NSSF B 1
	NSSF CD 1 Bright
	NSSF E 1 Bright Radius_Quake(6,5,0,1,0)
	NSSF F 1 Bright
	NSSF GH 1
	NSSD AAAAAA 1
	Goto SSGReloadCheck
  AltFire:
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",1,1)
	Goto Reload
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire2",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAA 0 A_FireCustomMissile("NemesisTracer",Random(6,-6),0,0,Random(6,-6))
	//TNT1 A 0 Bright A_FireBullets(2.2,1.3,9,0,"NemesisASGPuffExplodePlayer",0)
	//N1SF A 1 Bright A_FireBullets(2.2,1.3,9,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	N1SF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	N1SF B 1 Bright
	N1SF CDEF 1
	NSSD A 2
	Goto ReadyLoop
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",1,1)
	Goto Reload
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire2",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAA 0 A_FireCustomMissile("NemesisTracer",Random(6,-6),0,0,Random(6,-6))
	//TNT1 A 0 Bright A_FireBullets(2.2,1.3,9,0,"NemesisASGPuffExplodePlayer",0)
	//N1SF A 1 Bright A_FireBullets(2.2,1.3,9,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)+15.0,0,0,-4,0,frandom(-2.5,2.5))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)-15.0,0,0,-4,0,frandom(-2.5,2.5))
	N1SF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)+15.0,0,0,-4,0,frandom(-2.5,2.5))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)-15.0,0,0,-4,0,frandom(-2.5,2.5))
	N1SF B 1 Bright
	TNT1 A 0
	N1SF CDEF 1
	NSSD A 2
	Goto ReadyLoop  
  FireRight:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireRightSpread")
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire2",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAA 0 A_FireCustomMissile("NemesisTracer",Random(6,-6),0,0,Random(6,-6))
	//TNT1 A 0 Bright A_FireBullets(2.2,1.3,9,0,"NemesisASGPuffExplodePlayer",0)
	//N2SF A 1 Bright A_FireBullets(2.2,1.3,9,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	N2SF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	N2SF B 1 Bright
	N2SF CDEF 1
	NSSD A 2
	Goto ReadyLoop
  FireRightSpread:
	TNT1 A 0 A_PlaySound("NemesisSSG/Fire2",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisPellets",1)
	//TNT1 AAAA 0 A_FireCustomMissile("NemesisTracer",Random(6,-6),0,0,Random(6,-6))
	//TNT1 A 0 Bright A_FireBullets(2.2,1.3,9,0,"NemesisASGPuffExplodePlayer",0)
	//N2SF A 1 Bright A_FireBullets(2.2,1.3,9,random(32,40),"NemesisASGBulletPuffPlayer")
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)+15.0,0,0,-4,0,frandom(-2.5,2.5))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)-15.0,0,0,-4,0,frandom(-2.5,2.5))
	N2SF A 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4),0,0,-4,0,frandom(-2.5,2.5))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)+15.0,0,0,-4,0,frandom(-2.5,2.5))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-4,4)-15.0,0,0,-4,0,frandom(-2.5,2.5))
	N2SF B 1 Bright
	N2SF CDEF 1
	NSSD A 2
	Goto ReadyLoop
  Empty:
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",1,"Empty2")
	NSSD A 10 A_PlaySound("weapons/click",CHAN_6)
	Goto ReadyLoop
  Empty2:
	NSSD A 10 A_PlaySound("weapons/click",CHAN_6)
	Goto ReadyLoop
  Reload:
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",0,"ReadyLoop")	
	TNT1 A 0 A_JumpIfInventory("NemesisPellets",1,"ReloadRight")	
	TNT1 A 0 A_JumpIfInventory("NemesisShell",2,"ReloadBoth")
	TNT1 A 0 A_JumpIfInventory("NemesisShell",1,"ReloadRight")
	Goto Empty
  ReloadBoth:
	TNT1 A 0 A_JumpIfInventory("NemesisShell",2,1)
	Goto ReadyLoop
	NSSR EDCBA 1
	NSSR ABCDEF 1
	NSSR G 1 A_PlaySound("NemesisSSG/Open",CHAN_6)
	NSSR HIJ 1
	TNT1 AA 0 A_SpawnItemEx("NemesisShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	NSS2 ABCD 2
	NSS2 EFG 1
	NSS2 H 1 A_PlaySound("NemesisSSG/Load",CHAN_6)
	NSS2 IJKLMN 1
	TNT1 A 0 A_TakeInventory("NemesisShell",2)
	TNT1 A 0 A_GiveInventory("NemesisPellets",2)
	NSSR K 8
	NSSC AC 1
	NSSC D 1 A_PlaySound("NemesisSSG/Close",CHAN_6)
	NSSC FGIJLMOPR 1
	Goto ReadyLoop
  ReloadRight:
	TNT1 A 0 A_JumpIfInventory("NemesisShell",1,1)
	Goto ReadyLoop
	NSSR EDCBAABCDEFGHI 1
	N2SR B 2 A_PlaySound("NemesisSSG/Open",CHAN_6)	
	N2SR C 5
	N2SR DEF 2
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	N2SR GH 2
	N2SR I 1 A_PlaySound("NemesisSSG/Load",CHAN_6)
	TNT1 A 0 A_TakeInventory("NemesisShell",1)
	TNT1 A 0 A_GiveInventory("NemesisPellets",1)
	NSSC AC 1
	NSSC D 1 A_PlaySound("NemesisSSG/Close",CHAN_6)
	NSSC F 1
	NSSC GIJLMOPR 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	NSGN ABCDE 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",CHAN_6)
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	NSGN EDCBA 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	NSGN ABCDE 1
	TNT1 A 8
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",CHAN_6)
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	NSGN EDCBA 1
	Goto ReadyLoop
  }
}

Actor NemesisPellets : Ammo
{
  +IGNORESKILL
  +NOTIMEFREEZE
  Inventory.Amount 0
  Inventory.MaxAmount 2
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 2
  Inventory.Icon "NSSWA0"
}
