Actor DoubleBarrelShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFDoubleBarrelShotgunPickup"
  Inventory.PickupSound "weapons/pickupssg"
  Tag "$CFDoubleBarrelShotgun"
  States
  {
  Spawn:
	SGN2 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SGN2 A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",68,6,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("ExplosiveSSG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("DoubleBarrelShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",33)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("SSGShell",Random(1,2))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor DoubleBarrelShotgunSpawnerGiver : DoubleBarrelShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DoubleBarrelShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("ExplosiveSSG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("DoubleBarrelShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",33)
	Stop
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DoubleBarrelShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DoubleBarrelShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("SSGShell",Random(1,2))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor DoubleBarrelShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DoubleBarrelShotgun : DoomWeapon replaces SuperShotgun //82
{
  SpawnID 33
  Scale 0.85
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin ""
  Weapon.PreferredSkin "DoubleBarrelSG-Marine"
  Weapon.SelectionOrder 400
  Weapon.KickBack 100
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 3.0
  Weapon.AmmoType "SSGShell"
  Weapon.AmmoType2 "NewShell"
  Weapon.SelectionOrder 6500
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFDoubleBarrelShotgunPickup"
  Inventory.PickupSound "weapons/pickupssg"
  Tag "$CFDoubleBarrelShotgun"
  Obituary "$CFDoubleBarrelShotgunObit"
  States
  {
  Spawn:
	SGN2 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SGN2 A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickupssg")
	SHRS ABCDEF 1
	SHRS GH 2
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("SSGShell",2,"Ready2")
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,"Ready3")
	SHTE A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Ready2:
	SHT2 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Goto ReadyLoop	
  Ready3:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	SST2 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Goto ReadyLoop
  Deselect: 
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_JumpIfInventory("SSGShell",2,"Deselect2")
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,"Deselect3")
  DeselectLoop:
	SHTE A 1 A_Lower
	Loop
  Deselect2: 
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	SHT2 A 1 A_Lower
	Goto Deselect2+1
  Deselect3: 
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	SST2 A 1 A_Lower
	Goto Deselect3+1
  Select:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("SSGShell",2,"FireBoth")
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"Reload")
	Goto Empty
  FireBoth:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireBothSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/sshotf",CHAN_WEAPON)
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",Random(8,-8),0,0,Random(8,-8))
	SH2F A 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	SH2F B 2 Bright
	SH2E A 1
	SHT2 B 1
	SHT2 CDEF 1
	SHT2 EDCB 2
  SSGReloadCheck:
	TNT1 A 0 A_JumpIfInventory("NewShell",2,2)
	SH2E A 2
	Goto ReadyLoop
	TNT1 A 0
	Goto ReloadBoth+4
  FireBothSpread:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_PlaySound("weapons/sshotf",CHAN_WEAPON)
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)+15.0,0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)-15.0,0,0,frandom(-8,8))
	//TNT1 A 0 A_FireBullets(11.2+15.0,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.2+15.0,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	SH2F A 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	SH2F B 2 Bright
	SH2E A 1
	SHT2 B 1
	SHT2 CDEF 1
	SHT2 EDCB 2
  AltFire:
	TNT1 A 0 A_JumpIfInventory("SSGShell",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,1)
	Goto Reload
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlaySound("weapons/ssgsingleshot",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",1)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	S2SF C 2 Bright A_FireBullets(4.6,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	S2SF D 2 Bright
	SH2R EFGH 1
	SHTE A 2
	Goto ReadyLoop
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("SSGShell",2,"FireRight")
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,1)
	Goto Reload
	TNT1 A 0 A_PlaySound("weapons/ssgsingleshot",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",1)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-8,8))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-8,8))
	//TNT1 A 0 A_FireBullets(4.6+15.0,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(4.6+15.0,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	S2SF C 2 Bright A_FireBullets(4.6+15.0,2.8,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	S2SF D 2 Bright
	SH2R EFGH 1
	SHTE A 2
	Goto ReadyLoop
  FireRight:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireRightSpread")
	TNT1 A 0 A_PlaySound("weapons/ssgsingleshot",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",1)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	S2SF A 2 Bright A_FireBullets(4.6,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	S2SF B 2 Bright
	SH2R ABCD 1
	SST2 A 2
	Goto ReadyLoop
  FireRightSpread:
	TNT1 A 0 A_PlaySound("weapons/ssgsingleshot",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("SSGShell",1)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-8,8))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-8,8))
	S2SF A 2 Bright A_FireBullets(4.6,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(4.6+15.0,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(4.6+15.0,2.8,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	S2SF B 2 Bright
	SH2R ABCD 1
	SST2 A 2
	Goto ReadyLoop
  Empty:
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,"Empty2")
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	SHTE AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	Goto ReadyLoop
  Empty2:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	SST2 AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	Goto ReadyLoop
  Reload:
	TNT1 A 0 A_JumpIfInventory("SSGShell",0,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("SSGShell",1,"ReloadRight")
	TNT1 A 0 A_JumpIfInventory("NewShell",2,"ReloadBoth")
	Goto Empty		
  ReloadBoth:
	TNT1 A 0 A_JumpIfInventory("NewShell",2,1)
	Goto ReadyLoop
	SHT2 RQ 2
	SH2E B 2
	SHT2 GH 2
	SH2E F 1 A_PlaySound("weapons/sawedopen",CHAN_6)
	SHT2 I 1
	SH2E G 1
	TNT1 AA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-3,-6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	SH2E D 4
	SHT2 J 2 
	SH2E EH 2
	SHT2 K 3
	SHT2 L 3 A_PlaySound("weapons/shellslide",CHAN_6)
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	SHT2 M 2 A_GiveInventory("SSGShell",2)
	SHT2 N 2
	SHT2 OP 1 
	SH2E I 1 A_PlaySound("weapons/sawedclose",CHAN_6)
	SH2E C 1
	SH2E B 2
	SHT2 QR 2	
	Goto ReadyLoop	
  ReloadRight:
	TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto ReadyLoop
	SHT2 RQ 2
	SH2E B 2
	SH2E C 1
	SH2E I 1 A_PlaySound("weapons/sawedopen",CHAN_6)	
	SHT2 PO 1
	S2SR AB 1
	TNT1 A 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-3,-6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	S2SR C 4
	S2SR DEFG 2
	SHT2 L 2 A_PlaySound("weapons/shellslide",CHAN_6)
	TNT1 A 0 A_TakeInventory("NewShell",1,TIF_NOTAKEINFINITE)
	SHT2 M 2 A_GiveInventory("SSGShell",1)
	SHT2 N 2
	SHT2 OP 1 
	SH2E I 1 A_PlaySound("weapons/sawedclose",CHAN_6)
	SH2E C 1
	SH2E B 2
	SHT2 QR 2
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	S2GN FEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	S2GN ABCDEF 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	S2GN FEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	S2GN ABCDEF 1
	Goto ReadyLoop
  }
}

Actor SSGShell : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 2
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 2
  Inventory.Icon "SGN2A0"
  +IGNORESKILL
}
