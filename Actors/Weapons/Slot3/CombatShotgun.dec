Actor CombatShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFCombatShotgunPickup"
  Inventory.PickupSound "weapons/12gsgcock"
  Tag "$CFCombatShotgun"
  States
  {
  Spawn:
	SHOT A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SHOT A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",64,4,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CombatShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("AssaultShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("RapidShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CombatShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",32)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("ShotgunMagazine",Random(4,9))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor CombatShotgunSpawnerGiver : CombatShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CombatShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("AssaultShotgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("RapidShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CombatShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",32)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("CombatShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("CombatShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ShotgunMagazine",Random(4,9))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor CombatShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CombatShotgun : DoomWeapon replaces Shotgun //2001
{
  Scale 0.85
  Weapon.PreferredSkin "CombatSG-Marine"
  Weapon.KickBack 80
  Weapon.AmmoUse 1
  Weapon.AmmoType "ShotgunMagazine"
  Weapon.AmmoType2 "NewShell"
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 1.0
  Weapon.SelectionOrder 10 //7000
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Obituary "$CFCombatShotgunObit"
  Inventory.PickupMessage "$CFCombatShotgunPickup"
  Inventory.PickupSound "weapons/12gsgcock"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFCombatShotgun"
  States
  {
  Spawn:
	SHOT A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
	SHOT A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/12gsgcock")
	SG1R ABCDE 1
	SG1R F 2
	SG1R G 3
	SG1R FE 2
	SG1R H 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,"Ready2")
	Goto Ready3
  Ready2:
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,1)
	Goto Ready3
	SHTG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Ready3:
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,"Ready2")
	SHTD A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	SHTG A 1 A_Lower
	Goto Deselect+1 
  Select: 
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	SHTF A 2 Bright A_FireBullets(3.8,2.4,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	SHTF B 2 Bright
	SHTF CDEF 1
	SHTG BCDEFG 1
	SHTG G 1 A_PlaySound("weapons/12gsgcock",CHAN_6)
	SHTG HI 2
	SHTG J 2 A_SpawnItemEx("ShellCasing",30,-2,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	SHTG IHGF 2
	SHTG EDCB 1
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,3)
	SHTD A 2
	TNT1 A 0 A_ReFire
	Goto Ready3
	SHTG A 2
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)+15.0,0,0,frandom(-6,6))
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6)-15.0,0,0,frandom(-6,6))
	//TNT1 A 0 A_FireBullets(3.8+15.0,2.4,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(3.8+15.0,2.4,8,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	SHTF A 2 Bright A_FireBullets(3.8+15.0,2.4,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	SHTF B 2 Bright
	SHTF CDEF 1
	SHTG BCDEFG 1
	SHTG G 1 A_PlaySound("weapons/12gsgcock",CHAN_6)
	SHTG HI 2
	SHTG J 2 A_SpawnItemEx("ShellCasing",30,-2,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	SHTG IHGF 2
	SHTG EDCB 1
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,3)
	SHTD A 2
	TNT1 A 0 A_ReFire
	Goto Ready3
	SHTG A 2
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	SHTD AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
  Reload:
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",9,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto ReadyLoop
	SHTG BCD 1
	SHTG EFG 2
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",1,"ActualReload")
	SHTR ABC 1	
	SHTR D 1 A_PlaySound("Weapons/ShellLoad",CHAN_6)
	SHTR E 1
	TNT1 A 0 A_TakeInventory("NewShell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("ShotgunMagazine",1)
	SHTR FGHI 1
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	SHER A 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	SHER B 2
	SHTG G 2 A_PlaySound("weapons/12gsgcock",CHAN_6)
	SHTG HIJIH 2
	TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto Full	
	SHER BA 2
  ActualReload:
	TNT1 A 0 A_JumpIfInventory("ShotgunMagazine",9,"Full")
	SHTR ABC 1
	SHTR D 1 A_PlaySound("Weapons/ShellLoad",CHAN_6)
	SHTR E 1
	TNT1 A 0 A_TakeInventory("NewShell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("ShotgunMagazine",1)
	SHTR FGHI 1
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheckReloading")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheckReloading")
	SHTR A 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"ActualReload")
  Full:
	SHTG GFEDCB 1
	SHTG A 3
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeCheckReloading:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Reload
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	SGUN FEDCBA 1
	SGUW A 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	SGUW A 1
	SGUN ABCDEF 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineCheckReloading:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Reload
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	SGUN FEDCBA 1
	SGUW A 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	SGUW A 1
	SGUN ABCDEF 1
	Goto ReadyLoop
  }
}

Actor ShotgunMagazine : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 9
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 9
  Inventory.Icon "SHOTA0"
  +IGNORESKILL
}
