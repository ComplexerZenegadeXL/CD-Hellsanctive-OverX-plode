Actor NemesisASGBall : FastProjectile
{
  Projectile
  Height 8
  Radius 4
  Speed 200
  Scale 0.2
  RenderStyle Add
  Alpha 1.0
  Decal "DoomImpScorch"
  Damage (Random(25,40))
  +STRIFEDAMAGE
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  +THRUSPECIES
  DamageType "Legendary"
  DeathSound "weapons/demontechex"
  States
  {
  Spawn:
	NSHB A 1 Bright
	Loop  
  Death:
	TNT1 A 0 Bright
	TNT1 A 0 A_SpawnItemEx("NemesisKaboom7ASG")
	TNT1 A 1 Bright A_CustomMissile("NemesisASGShotExplosion",0,0,0,2)
	Stop
  }
}

