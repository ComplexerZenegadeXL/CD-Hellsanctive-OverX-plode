Actor NemesisShotgunDrum : Ammo
{
  +IGNORESKILL
  +NOTIMEFREEZE
  Inventory.Amount 0
  Inventory.MaxAmount 16
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 16
  Inventory.Icon "NSAPA0"
}

Actor NemesisShellPickup : LegendaryShellPickup
{
  Scale 0.3
  Inventory.PickupMessage "$CFNemesisShellPickup"
  Inventory.PickupSound "items/shell"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	NESS A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",18,4)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",18) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor NemesisShell : Ammo
{
