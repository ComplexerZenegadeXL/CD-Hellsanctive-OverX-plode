Actor NemesisShellCasing : BulletCasing
{
  Scale 0.24
  Seesound "weapons/casing2"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	NMUC ABCDEFGH 2
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,3)
	NMUC C 100
	NMUC C 5 A_FadeOut(0.1,1)
	Goto Death+3
	NMUC G 100
	NMUC G 5 A_FadeOut(0.1,1)
	Goto Death+5
  }
}
