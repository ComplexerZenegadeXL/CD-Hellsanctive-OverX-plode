Actor NemesisAssaultShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFNemesisAssaultShotgunPickup"
  Tag "$CFNemesisAssaultShotgun"
  States
  {
  Spawn:
    NSAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	NSAP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",6,14,17) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("NemesisAssaultShotgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("NemesisAssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",41)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NemesisShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("NemesisShell",8)
	Stop
  }
}

Actor NemesisAssaultShotgunSpawnerGiver : NemesisAssaultShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("NemesisAssaultShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("NemesisAssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",41)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("NemesisAssaultShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("NemesisAssaultShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NemesisShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("NemesisShell",8)
	Stop
  }
}

Actor NemesisAssaultShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor NemesisAssaultShotgun : LegendaryAssaultShotgun
{
  Decal " "
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 13.0
  Weapon.AmmoType "NemesisShotgunDrum"
  Weapon.AmmoType2 "NemesisShell"
  Weapon.SelectionOrder 400
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFNemesisAssaultShotgunPickup"
  Obituary "$CFNemesisAssaultShotgunObit"
  Tag "$CFNemesisAssaultShotgun"
  States
  {
  Spawn:
    NSAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	NSAP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("LShotgun/Cock")
	NMSG VWXYZ 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    NMSG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect: 
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlaySound("weapons/weapondown")
  DeselectLoop:
    NMSG A 1 A_Lower
    Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("NemesisAssaultShotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("NemesisShotgunDrum",1,1)
	Goto Empty
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("NemesisASG/Fire", 1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6),0,0,-4,0,frandom(-4,4))
	NMSG B 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6),0,0,-4,0,frandom(-4,4))
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisShotgunDrum",1)
    NMSG C 1 Bright
    NMSG DEFG 1
	NMSG HI 2
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("NemesisShotgunDrum",1,1)
	Goto Empty
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("NemesisASG/Fire", 1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6),0,0,-4,0,frandom(-4,4))
	TNT1 AAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6)+15.0,0,0,-4,0,frandom(-4,4))
	TNT1 AAAAAAA 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6)-15.0,0,0,-4,0,frandom(-4,4))
	NMSG B 1 Bright A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6),0,0,-4,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6)+15.0,0,0,-4,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("NemesisASGBallPlayer",frandom(-6,6)-15.0,0,0,-4,0,frandom(-4,4))
	//TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_TakeInventory("NemesisShotgunDrum",1)
    NMSG C 1 Bright
    NMSG DEFG 1
	NMSG HI 2
    Goto ReadyLoop
  Empty:
    NMSG A 10 A_PlaySound("weapons/click")
  Reload:
  	TNT1 A 0 A_JumpIfInventory("NemesisShotgunDrum",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("NemesisShell",1,1)
	Goto ReadyLoop
	NMSG JKLMN 1
	NMSG O 2
	NMSR A 2 A_PlaySound("lasgguy/asgout")
  	NMSR B 3
	NMSG U 40 A_FireCustomMissile("EnragedLegendaryEmptyDrumSpawner", 0, 0, 10, 1) 
	NMSG TSR 1
	NMSG Q 2
  ActualReload:
	TNT1 A 0 A_TakeInventory("NemesisShell",1)
	TNT1 A 0 A_GiveInventory("NemesisShotgunDrum",1)
	TNT1 A 0 A_JumpIfInventory("NemesisShotgunDrum",16,2)
	TNT1 A 0 A_JumpIfInventory("NemesisShell",1,"ActualReload")
	TNT1 A 0
	Goto Reload2
  Reload2:
	NMSG P 3
	NMSG O 6 A_PlaySound("lasgguy/asgin")
	NMSG NMLKJ 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	NMSG ZYXWV 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN KLM 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	NMSG VWXYZ 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	NMSG ZYXWV 1
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor NemesisASGBulletPuff : BulletPuff
{
  +NOTIMEFREEZE
  +PUFFONACTORS
  Damagetype "Legendary"
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 AAA 0 A_CustomMissile("NemesisKaboom7ASG",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1
	Stop
  }
}

Actor NemesisASGPuffExplode
{
  Projectile
  Speed 0
  +FORCERADIUSDMG
  +FOILINVUL
  +NOTIMEFREEZE
  +NOCLIP
  +PUFFONACTORS
  +NODAMAGETHRUST
  Damagetype "Legendary"
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 A 1 A_Explode(20,30)
	Stop
  }
}

