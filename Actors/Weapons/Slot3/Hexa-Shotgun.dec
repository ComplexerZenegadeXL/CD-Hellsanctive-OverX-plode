Actor Hexa-ShotgunGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFHexaShotgunPickup"
  Inventory.PickupSound "weapons/pickuphsg"
  Tag "$CFHexaShotgun"
  States
  {
  Spawn:
    HSGP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	HSGP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",53,8,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("Hexa-Shotgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("Hexa-Shotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",38)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("HexaShell",Random(3,6))
	TNT1 A 0 A_GiveInventory("NewShell",12)
	Stop
  }
}

Actor Hexa-ShotgunSpawnerGiver : Hexa-ShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("Hexa-Shotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("Hexa-Shotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",38)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("Hexa-ShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("Hexa-ShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("HexaShell",Random(3,6))
	TNT1 A 0 A_GiveInventory("NewShell",12)
	Stop
  }
}

Actor Hexa-ShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor Hexa-Shotgun : DoomWeapon
{
  Scale 0.9
  Weapon.PreferredSkin "Hexa-Shotgun-Marine"
  Weapon.KickBack 500
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 5.0
  Weapon.AmmoType "HexaShell"
  Weapon.AmmoType2 "NewShell"
  Weapon.SelectionOrder 6500
  //Weapon.MinSelectionAmmo1 2
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFHexaShotgunPickup"
  Inventory.PickupSound "weapons/pickuphsg"
  Obituary "$CFHexaShotgunObit"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.SisterWeapon "PoweredHexa-Shotgun"
  Tag "$CFHexaShotgun"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    HSGP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	HSGP A -1
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",9,0,1)
	TNT1 A -1
	Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("weapons/pickuphsg")
	HSRS ABCDEF 1
	HSRS GH 2
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HSGN A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    HSGN A 1 A_Lower
    Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("Hexa-Shotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("HexaShell",6,"HexaFire")
	TNT1 A 0 A_JumpIfInventory("NewShell",2,1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("HexaShell",4,"ReloadTwoShells")
	TNT1 A 0 A_JumpIfInventory("NewShell",4,1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("HexaShell",2,"ReloadFourShells")
	Goto Empty
  HexaFire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HexaFireSpread")
	TNT1 A 0 A_PlaySound("weapons/hsgfire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Recoil(4)
    TNT1 A 0 Radius_Quake(20,5,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",6)	
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-10,10))
    HS4F A 1 Bright A_FireBullets(11.8,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
    HS4F A 1 Bright A_FireBullets(13.8,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
    HS4F B 2 Bright
	HSGN CFG 1
	HSGN H 2
	HSER A 3
	HSER B 6
	HSGN GFEDC 2
  HexaReloadCheck:
  	TNT1 A 0 A_JumpIfInventory("NewShell",6,2)
	HSGN S 2
	Goto ReadyLoop
	TNT1 A 0
	Goto ReloadSixShells+3
  HexaFireSpread:
	TNT1 A 0 A_PlaySound("weapons/hsgfire",CHAN_WEAPON)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Recoil(4)
    TNT1 A 0 Radius_Quake(20,5,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",6)	
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-10,10))
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8+15.0),0,0,frandom(-10,10))
	TNT1 AAAAAAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8-15.0),0,0,frandom(-10,10))
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(11.8+15.0,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
    HS4F A 1 Bright A_FireBullets(11.8+15.0,7.3,72,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(13.8+15.0,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	//TNT1 A 0 A_FireBullets(13.8+15.0,7.3,24,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
    HS4F A 1 Bright A_FireBullets(13.8+15.0,7.3,72,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
    HS4F B 2 Bright
	HSGN CFG 1
	HSGN H 2
	HSER A 3
	HSER B 6
	HSGN GFEDC 2
	Goto HexaReloadCheck
  AltFire:
    TNT1 A 0 A_JumpIfInventory("HexaShell",6,"FireUpper")
    TNT1 A 0 A_JumpIfInventory("HexaShell",4,"FireMiddle")
	TNT1 A 0 A_JumpIfInventory("HexaShell",2,1)
	Goto Reload
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
    HSGF E 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF F 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop
  AltFireSpread:
    TNT1 A 0 A_JumpIfInventory("HexaShell",6,"FireUpper")
    TNT1 A 0 A_JumpIfInventory("HexaShell",4,"FireMiddle")
	TNT1 A 0 A_JumpIfInventory("HexaShell",2,1)
	Goto Reload
    TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)+15.0,0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8)-15.0,0,0,frandom(-8,8))
    HSGF E 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF F 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop
  FireUpper:
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireUpperSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
    HSGF A 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF B 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop
  FireUpperSpread:
    TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8+15.0),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8-15.0),0,0,frandom(-8,8))
    HSGF A 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF B 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop
  FireMiddle:
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireMiddleSpread")
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
    HSGF C 2 Bright A_FireBullets(11.2,7.1,16,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF D 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop	
  FireMiddleSpread:
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire",CHAN_WEAPON)	
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_TakeInventory("HexaShell",2)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8+15.0),0,0,frandom(-8,8))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-8,8-15.0),0,0,frandom(-8,8))
    HSGF C 2 Bright A_FireBullets(11.2+15.0,7.1,48,Random(11,16),"PlayerModdedBulletPuff",FBF_NORANDOM)
	HSGF D 2 Bright
	HSRC ABCDE 1
	HSGN A 1
    Goto ReadyLoop	
  Empty:
    HSGN A 10 A_PlaySound("weapons/click",CHAN_6)
	TNT1 A 0 A_JumpIfInventory("NewShell",6,"ReloadSixShells")
	Goto ReadyLoop
  Reload:
	TNT1 A 0 A_JumpIfInventory("HexaShell",0,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("HexaShell",4,"ReloadTwoShells")
	TNT1 A 0 A_JumpIfInventory("HexaShell",2,"ReloadFourShells")
	TNT1 A 0 A_JumpIfInventory("NewShell",6,"ReloadSixShells")
	Goto Empty	
  ReloadSixShells:
	HSGN SRQ 2
	HSGN PJ 1
	HSGN K 1
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	HSGN L 1
	HSGR A 12 A_PlaySound("weapons/qsgopen",CHAN_6)
	HSGR B 1
	HSGR CD 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR E 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)
	HSGR F 3
	HSGR G 2
	HSGR H 1
	HSGR I 8
	HSGR JK 1
	HSGR LM 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR N 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)
	HSGR O 3
	HSGR P 2
	HSGR Q 1
	HSGR R 8
	HSGR ST 1
	HSGR U 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR V 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	HSGR W 3
	HSGR X 2
	HSGR Y 1
	HSGN MNO 1
	HSGN P 1 A_PlaySound("weapons/qsgclose",CHAN_6)
	HSGN QRS 2
	HSGN A 2
    Goto Ready+9
  ReloadFourShells:
    TNT1 A 0 A_JumpIfInventory("NewShell",4,1)
	Goto Ready+9
	HSGN SRQ 2
	HSGN P 1
	HSEX A 1
	HSEX B 1
	TNT1 AAAA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	HSEX C 1
	HSGR I 12 A_PlaySound("weapons/qsgopen",CHAN_6)
	HSGR JK 1
	HSGR LM 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR N 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	HSGR O 3
	HSGR P 2
	HSGR QRS 1
	HSGR TU 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR V 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	HSGR W 3
	HSGR X 2
	HSGR Y 1
	HSGN MNO 1
	HSGN P 1 A_PlaySound("weapons/qsgclose",CHAN_6)
	HSGN QRS 2
	HSGN A 2
	Goto Ready+9
  ReloadTwoShells:
    TNT1 A 0 A_JumpIfInventory("NewShell",2,1)
	Goto Ready+9
	HSGN SRQ 2
	HSGN P 1
	HSEX AB 1
	TNT1 AA 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	HSEX C 1
	HSGR Q 12 A_PlaySound("weapons/qsgopen",CHAN_6)
	HSGR RS 1
	HSGR TU 2
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("HexaShell",2)
	HSGR V 3 A_PlaySound("weapons/qsgshellslide",CHAN_6)	
	HSGR W 3
	HSGR X 2
	HSGR Y 1
	HSGN MNO 1
	HSGN P 1 A_PlaySound("weapons/qsgclose",CHAN_6)
	HSGN QRS 2
	HSGN A 2
	Goto Ready+9
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+9
  GrenadeToss:
  	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	HSHT EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",CHAN_6)
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	HSHT ABCDE 1
	Goto Ready+9
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+9
  MineToss:
  	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	HSHT EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",CHAN_6)
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	HSHT ABCDE 1
	Goto Ready+9
  }
}

Actor HexaShell : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 6
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 6
  Inventory.Icon "HSGPA0"
  +IGNORESKILL
}
