Actor BlueSGTracer : CFTracer
{
  Speed 100
  Scale 0.075
  +NOTIMEFREEZE
  States
  {
  Spawn:
    BRAC A 10 Bright
	Stop
  }
}

Actor LegendaryEmptyDrumSpawner : CasingSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("LegendaryEmptyDrum", 2, 0, -12, 1, 0, 0, frandom(-110, -100), SXF_CLIENTSIDE)
    Stop
  }
}

Actor LegendaryASGBulletPuff : PlayerModdedBulletPuff
{
  DamageType "PlayerLegendary"
  Decal "LegBulletChip"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryDetectFloorPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegendaryDetectCeilingPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	PUFF A 2 Bright
	PUFF B 2 Bright A_Jump(32,"RicochetPuff","RicochetPuffAlt")
	PUFF CDEF 2 A_ChangeVelocity(0,0,frandom(0,2))
    Stop
  }
}
