Actor LegendaryAssaultShotgunGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFLegendaryAssaultShotgunPickup"
  Tag "$CFLegendaryAssaultShotgun"
  States
  {
  Spawn:
    LMAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	LMAP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",54,11,12) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("Hexa-Shotgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryAssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",39)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LegendaryShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("LegendaryShell",4)
	Stop
  }
}

Actor LegendaryAssaultShotgunSpawnerGiver : LegendaryAssaultShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryAssaultShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryAssaultShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",39)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryAssaultShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryAssaultShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LegendaryShotgunDrum",Random(8,16))
	TNT1 A 0 A_GiveInventory("LegendaryShell",4)
	Stop
  }
}

Actor LegendaryAssaultShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryAssaultShotgun : DoomWeapon
{
  Scale 0.85
  Weapon.PreferredSkin "LegendaryASG-Marine"
  Weapon.KickBack 160
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 10.0
  Weapon.AmmoType "LegendaryShotgunDrum"
  Weapon.AmmoType2 "LegendaryShell"
  Weapon.SelectionOrder 1300
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupSound "LShotgun/Cock"
  Inventory.PickupMessage "$CFLegendaryAssaultShotgunPickup"
  Obituary "$CFLegendaryAssaultShotgunObit"
  Decal "LegBulletChip"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFLegendaryAssaultShotgun"
  States
  {
  Spawn:
    LMAP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,1)
	LMAP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("LShotgun/Cock")
	LGSG VWXYZ 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    LGSG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect: 
    TNT1 A 0 A_PlaySound("weapons/weapondown")
    LGSG A 1 A_Lower
    Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryAssaultShotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait	
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun", 1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-5,5),0,0,frandom(-5,5))
    LGSG B 1 Bright A_FireBullets(6.2,3.4,7,Random(15,20),"LegendaryASGBulletPuff")
    LGSG C 1 Bright
    LGSG DEFG 1
	LGSG HI 2
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun", 1)
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing",30,5,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 AAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-5,5),0,0,frandom(-5,5))
	TNT1 AAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-5,5)+15.0,0,0,frandom(-5,5))
	TNT1 AAAAAA 0 A_FireCustomMissile("BlueSGTracer",frandom(-5,5)-15.0,0,0,frandom(-5,5))
	//TNT1 A 0 A_FireBullets(6.2+15.0,3.4,7,Random(15,20),"LegendaryASGBulletPuff",0)
	//TNT1 A 0 A_FireBullets(6.2+15.0,3.4,7,Random(15,20),"LegendaryASGBulletPuff",0)
    LGSG B 1 Bright A_FireBullets(6.2+15.0,3.4,21,Random(15,20),"LegendaryASGBulletPuff")
    LGSG C 1 Bright
    LGSG DEFG 1
	LGSG HI 2
    Goto ReadyLoop
  Empty:
    LGSG A 10 A_PlaySound("weapons/click")
  Reload:
  	TNT1 A 0 A_JumpIfInventory("LegendaryShotgunDrum",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("LegendaryShell",1,1)
	Goto ReadyLoop
	LGSG JKLMN 1
	LGSG O 2
	LGSR A 2 A_PlaySound("lasgguy/asgout")
  	LGSR B 3
	LGSG U 40 A_FireCustomMissile("LegendaryEmptyDrumSpawner", 0, 0, 10, 1) 
	LGSG TSR 1
	LGSG Q 2
  ActualReload:
	TNT1 A 0 A_TakeInventory("LegendaryShell",1)
	TNT1 A 0 A_GiveInventory("LegendaryShotgunDrum",1)
	TNT1 A 0 A_JumpIfInventory("LegendaryShotgunDrum",16,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryShell",1,"ActualReload")
	TNT1 A 0
	Goto Reload2
  Reload2:
	LGSG P 3
	LGSG O 6 A_PlaySound("lasgguy/asgin")
	LGSG NMLKJ 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LGSG ZYXWV 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN KLM 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	LGSG VWXYZ 1
	Goto ReadyLoop
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LGSG ZYXWV 1
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}
Actor LegendaryShotgunDrum : Ammo
{
  Inventory.Amount 16
  Inventory.MaxAmount 16
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 16
  Inventory.Icon "LMAPA0"
  +IGNORESKILL
  +NOTIMEFREEZE
}
Actor LegendaryEmptyDrum : BulletCasing
{
  Scale 0.2
  Seesound "weapons/emptydrum"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	LDRM ABCD 3 
	Loop
  Death:
	TNT1 A 0
    TNT1 A 0 A_Jump(128,3)
    LDRM A 100
    LDRM A 5 A_FadeOut(0.10)
    Goto Death+3
    LDRM C 100
	LDRM C 5 A_FadeOut(0.10)
	Goto Death+5
  }
}

Actor LegendaryShellPickup : BulletMagPickup
{
  Scale 0.3
  Inventory.PickupMessage "$CFLegendaryShellPickup"
  Inventory.PickupSound "items/shell"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	LESS A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",13,4)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",13) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 
	Stop
  Remove:
    TNT1 A 0
	Stop
  }
}

Actor LegendaryShell : Ammo //16801
{
  //$Category Ammunition/LCA
  //$Sprite LESSA0
  //$Title "Legendary Shells"
  Scale 0.3
  Inventory.PickupMessage "$CFLegendaryShellPickup"
  Inventory.PickupSound "items/shell"
  Inventory.Amount 4
  Inventory.MaxAmount 40
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 90
  Inventory.Icon "LHELA0"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	LESS A -1
    Stop
  }
}

