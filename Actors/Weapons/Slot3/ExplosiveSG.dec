Actor ExplosiveShotgunGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFExplosiveShotgunPickup"
  Inventory.PickupSound "weapons/ExplosiveSG/pump"
  Tag "$CFExplosiveShotgun"
  States
  {
  Spawn:
	EXSG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	EXSG A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",28,9,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryASG",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,1)
	TNT1 A 0 A_GiveInventory("ExplosiveShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",36)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("ExplosiveShotgunMagazine",Random(4,9))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor ExplosiveShotgunSpawnerGiver : ExplosiveShotgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("ExplosiveShotgun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,1)
	TNT1 A 0 A_GiveInventory("ExplosiveShotgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",36)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("ExplosiveShotgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("ExplosiveShotgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ExplosiveShotgunMagazine",Random(4,9))
	TNT1 A 0 A_GiveInventory("NewShell",8)
	Stop
  }
}

Actor ExplosiveShotgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor ExplosiveShotgun : DoomWeapon 17603
{
  //$Category Weapons/CF
  //$Sprite HLSPA0
  //$Title "ExplosiveShotgun"
  Weapon.SlotNumber 3
  Weapon.PreferredSkin "CombatSG-Marine"
  Weapon.SelectionOrder 3000
  Weapon.KickBack 160
  Weapon.AmmoUse 1
  Weapon.AmmoType "ExplosiveShotgunMagazine"
  Weapon.AmmoType2 "NewShell"
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 3
  Weapon.SlotPriority 6.0
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Obituary "$CFExplosiveShotgunObit"
  Inventory.PickupMessage "$CFExplosiveShotgunPickup"
  Inventory.PickupSound "weapons/ExplosiveSG/pump"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFExplosiveShotgun"
  States 
  {
  Spawn:
	EXSG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",3,0)
  SpawnLoop:
	EXSG A -1
	Stop
  Ready:
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/pump",1)
	HLSQ ABCDEFGH 1
  ReallyReady:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	HLSA A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	HLSA A 1 A_Lower
	Goto Deselect+1
  Select: 
	//TNT1 A 0 A_JumpIfInventory("DustLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("ExplosiveShotgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_TakeInventory("ExplosiveShotgunMagazine",1,TIF_NOTAKEINFINITE)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer3",frandom(-4,4),0,0,0,0,frandom(-3,3))
	TNT1 A 0 A_FireBullets(4.0,3.0,8,Random(10,16),"PlayerModdedBulletPuff")
	HLSF A 1 Bright
	HLSF B 1 Bright
	HLSF CDEGI 1 
	//HLSF F 1 
	//HLSF H 1 
	HLSC ABCDEFGHIJK 1
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/pump",1)
	HLSC LM 1
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",30,-1,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	HLSC N 2
	HLSC MLKJIHGFEDCBA 1
	HLSA A 4
	Goto ReallyReady
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,4,0,1,0)
	//TNT1 A 0 A_TakeInventory("ExplosiveShotgunMagazine",1,TIF_NOTAKEINFINITE)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer3",frandom(-4,4),0,0,0,0,frandom(-3,3))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer3",frandom(-4,4)+15.0,0,0,0,0,frandom(-3,3))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer3",frandom(-4,4)-15.0,0,0,0,0,frandom(-3,3))
	TNT1 A 0 A_FireBullets(4.0,3.0,8,Random(10,16),"PlayerModdedBulletPuff")
	TNT1 A 0 A_FireBullets(4.0+15.0,3.0,8,Random(10,16),"PlayerModdedBulletPuff")
	TNT1 A 0 A_FireBullets(4.0+15.0,3.0,8,Random(10,16),"PlayerModdedBulletPuff")
	HLSF A 1 Bright
	HLSF B 1 Bright
	HLSF CDEGI 1 
	//HLSF F 1 
	//HLSF H 1 
	HLSC ABCDEFGHIJK 1
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/pump",1)
	HLSC LM 1
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",30,-1,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	HLSC N 2
	HLSC MLKJIHGFEDCBA 1
	HLSA A 4
	Goto ReallyReady
  Empty:
	HLSA A 10 A_PlayWeaponSound("weapons/click")	
  Reload:
    TNT1 A 0 A_JumpIfInventory("ExplosiveShotgunMagazine",9,"ReallyReady")
    TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto ReallyReady
	HLSC ABCDEFGH 1
	TNT1 A 0 A_JumpIfInventory("ExplosiveShotgunMagazine",1,"ActualReload")
    HLSR ABCDE 1	
	HLSR F 1 A_PlaySound("Weapons/ShellLoad")
	TNT1 A 0 A_TakeInventory("NewShell",1)
	TNT1 A 0 A_GiveInventory("ExplosiveShotgunMagazine",1)
	HLSR GHIJ 1
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLSR A 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	TNT1 A 0 A_PlayWeaponSound("weapons/ExplosiveSG/pump")
	HLSC IJKLM 1
	HLSC N 2
	HLSC MLK 1
    TNT1 A 0 A_JumpIfInventory("NewShell",1,1)
	Goto Full	
  ActualReload:
    HLSR ABCDE 1	
	HLSR F 1 A_PlaySound("Weapons/ShellLoad")
	TNT1 A 0 A_TakeInventory("NewShell",1)
	TNT1 A 0 A_GiveInventory("ExplosiveShotgunMagazine",1)
	HLSR GHIJ 1
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLSR A 1 A_WeaponReady(WRF_NOBOB|WRF_NOSECONDARY)
	TNT1 A 0 A_JumpIfInventory("ExplosiveShotgunMagazine",9,"Full")
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"ActualReload")
  Full:
    HLSC HGFEDCBA 1
	HLSA A 4
	Goto ReallyReady
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReallyReady
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	HLSQ HGFEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	HLSQ ABCDEFGH 1
	Goto ReallyReady
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReallyReady
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	HLSQ HGFEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	HLSQ ABCDEFGH 1
	Goto ReallyReady
  }
}

Actor ExplosiveShotgunMagazine : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 9
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 9
  Inventory.Icon "EXSGA0"
  +IGNORESKILL
}
