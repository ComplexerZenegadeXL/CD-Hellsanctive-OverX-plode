Actor ExplosiveRailgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/pickuprg"
  Inventory.PickupMessage "$CFExplosiveRailgunPickup"
  Tag "$CFExplosiveRailgun"
  States
  {
  Spawn:
    ERGP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	ERGP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",33,25,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("ExplosiveRailgun",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,256)
	TNT1 A 0 A_GiveInventory("ExplosiveRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",71)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("EXPCellCharge",Random(30,60))
	TNT1 A 0 A_GiveInventory("NewCell",60)
	Stop
  }
}

Actor ExplosiveRailgunSpawnerGiver : ExplosiveRailgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRailgun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,256)
	TNT1 A 0 A_GiveInventory("ExplosiveRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",71)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("ExplosiveRailgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("ExplosiveRailgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("EXPCellCharge",Random(30,60))
	TNT1 A 0 A_GiveInventory("NewCell",60)
	Stop
  }
}

Actor ExplosiveRailgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor ExplosiveRailgun : Weapon
{
  Scale 0.8
  Weapon.PreferredSkin "Railgun-Marine"
  Weapon.KickBack 200
  Weapon.AmmoUse 15
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 7.0
  Weapon.AmmoType "EXPCellCharge"
  Weapon.AmmoType2 "NewCell"
  Inventory.PickupSound "weapons/pickuprg"
  Inventory.PickupMessage "$CFExplosiveRailgun"
  Weapon.UpSound "weapons/railselect"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 2000
  Obituary "$CFExplosiveRailgunObit"
  Tag "$CFExplosiveRailgun"
  Decal "Scorch"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT  
  +WEAPON.NOAUTOAIM
  States
  {
  Spawn:
    ERGP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	ERGP A -1
    Stop
  Ready:
	ERGD ABCDEF 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	EXRG A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
    Loop
  ReadyZoomed:
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Ready+7
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    XRGS A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
    Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  DeselectLoop:
	EXRG A 1 A_Lower
    Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("DustLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("ExplosiveRailgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait
  Fire:
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire",7)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",0,0)
    EXRG B 3 Bright A_RailAttack(Random(250,300),0,0,None,None,RGF_SILENT,0,"PlayerExplosiveRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",10,TIF_NOTAKEINFINITE)
	EXRG C 3 Bright A_Light2
	TNT1 A 0 A_Light0
	EXRG DEFGHIJK 3
	EXRG A 30
    Goto Ready+7
  FireSpread:
    TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
    TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
    TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire",7)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",0,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",-15,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",15,0)
    EXRG B 3 Bright A_RailAttack(Random(250,300),0,0,None,None,RGF_SILENT,0,"PlayerExplosiveRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_RailAttack(Random(250,300),0,0,None,None,RGF_SILENT|RGF_EXPLICITANGLE,0,"PlayerExplosiveRailPuff",15.0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_RailAttack(Random(250,300),0,0,None,None,RGF_SILENT|RGF_EXPLICITANGLE,0,"PlayerExplosiveRailPuff",-15.0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",10,TIF_NOTAKEINFINITE)
	EXRG C 3 Bright A_Light2
	TNT1 A 0 A_Light0
	EXRG DEFGHIJK 3
	EXRG A 30
    Goto Ready+7
  FireZoomed:
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireZoomedSpread")
	TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire",7)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",0,0)
	XRGS A 4 Bright A_RailAttack(Random(300,350),0,0,None,None,RGF_SILENT,0,"PlayerExplosiveRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),4)
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	EXRG A 56 A_Light0
	Goto Ready+7
	TNT1 A 0 A_Light0
	XRGS A 56
	Goto ReadyZoomed
  FireZoomedSpread:
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire",7)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",0,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",-15,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveRailgunImpact",15,0)
	XRGS A 4 Bright A_RailAttack(Random(300,350),0,0,None,None,RGF_SILENT,0,"PlayerExplosiveRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_RailAttack(Random(300,350),0,0,None,None,RGF_SILENT|RGF_EXPLICITANGLE,0,"PlayerExplosiveRailPuff",15.0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_RailAttack(Random(300,350),0,0,None,None,RGF_SILENT|RGF_EXPLICITANGLE,0,"PlayerExplosiveRailPuff",-15.0,0,0,0,40,0,"ExplosiveRailgunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("EXPCellCharge",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),4)
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	EXRG A 50 A_Light0
	Goto Ready+7
	TNT1 A 0 A_Light0
	XRGS A 60
	Goto ReadyZoomed
  Empty:
    EXRG A 15 A_PlaySound("weapons/click2")
  Reload:
  	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
    TNT1 A 0 A_JumpIfInventory("EXPCellCharge",60,2)
    TNT1 A 0 A_JumpIfInventory("NewCell",15,2)
	TNT1 A 0
	Goto ReadyLoop
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	ERGR AAABCDE 1
	ERGR F 4 A_PlayWeaponSound("weapons/cellreload")
	ERGR GHI 2
	ERGR JJKK 1
	ERGR L 1 A_FireCustomMissile("CellCasingSpawner", frandom(-15,-13), 0, 2, 1)
	ERGR MNOP 1
	ERGR Q 30
	ERGR RSTU 1
	ERGR VW 2
	TNT1 A 0 A_JumpIfInventory("NewCell",15,"ActualReload")	
	ERGR X 4 A_PlayWeaponSound("weapons/plasmacellin")
	EXRG A 10
	Goto ReadyLoop
  ActualReload:
    TNT1 A 0 A_TakeInventory("NewCell",15)
	TNT1 A 0 A_GiveInventory("EXPCellCharge",15)
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",60,"Full")
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"ActualReload")
	Goto Reload+35
  Full:
    TNT1 A 0
	Goto Reload+35
  Zoom:
	TNT1 A 0 A_JumpIfInventory("EXPCellCharge",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Ready+7
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"UnZoom")
    TNT1 A 0 A_GiveInventory("CFRailgunZoomed",1)
	EXRG A 9 A_ZoomFactor(5)
	Goto ReadyZoomed
  FiredUnZoom:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 60 A_ZoomFactor(1)
	Goto ReadyLoop
  FiredUnZoom2:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 50 A_ZoomFactor(1)
	Goto ReadyLoop
  FiredUnZoom3:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 40 A_ZoomFactor(1)
	Goto ReadyLoop
  FiredUnZoom4:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 30 A_ZoomFactor(1)
	Goto ReadyLoop
  FiredUnZoom5:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 20 A_ZoomFactor(1)
	Goto ReadyLoop	
  FiredUnZoom6:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG K 10 A_ZoomFactor(1)
	Goto ReadyLoop	
  UnZoom:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	EXRG A 3 A_ZoomFactor(1)
	EXRG A 6
	Goto ReadyLoop	
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,2)
	TNT1 A 0 A_ZoomFactor(1)
	Goto ReadyLoop
    TNT1 A 0
	Goto ReadyZoomed
  GrenadeToss:
  	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	ERGD CBA 2
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,2)
	TNT1 A 0 A_ZoomFactor(1)
	Goto ReadyLoop
    TNT1 A 0
	Goto ReadyZoomed
  MineToss:
  	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	ERGD CBA 2
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	Goto Ready
  }
}

Actor ExplosiveRailgunImpact : FastProjectile
{
  Speed 300
  Radius 2
  Height 2
  RenderStyle Add
  Alpha 0.85
  //+THRUACTORS
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 0 A_PlaySound("cyberrail/impact")
	//TNT1 A 0 A_SpawnItemEx("ExplosiveRailgunTrailExplodeSpawner",frandom(0,4),0,0,frandom(0,8),0,frandom(-8,8),frandom(0,360),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveRed", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom14", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_SpawnItem("RailgunImpactEffectRed")
	Stop
  }
}

Actor ExplosiveRailgunTrailExplodeSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("ExplosiveRailgunTrailExplode",frandom(0,4),0,0,frandom(0,4),0,frandom(-4,4),frandom(0,360))
	Stop
  }
}

Actor ExplosiveRailgunTrail : CardinalRailTrail
{
  -CLIENTSIDEONLY
  Damage (0)
  Scale 0.8
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("ExplosiveRailgunTrailExplode",frandom(0,4),0,0,frandom(0,4),0,frandom(-4,4),frandom(0,360))
	RGPR ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04)
	Stop
  }
}

Actor ExplosiveRailgunTrailExplode
{
  Renderstyle Add
  Alpha 0.75
  Projectile
  Damage (0)
  +FORCERADIUSDMG
  +DONTSPLASH
  +FORCEXYBILLBOARD
  //+NOCLIP
  +NODAMAGETHRUST
  Scale 0.65
  DamageType "PlayerDTRG"
  Species "Player"
  States
  {
  Spawn:
	TNT1 A 0
	FXPO AB 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(Random(40,50),128,0,0,40)
	FXPO CD 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(Random(40,50),128,0,0,40)
	FXPO EF 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(Random(40,50),128,0,0,40)
	FXPO GHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor EXPCellCharge : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 60
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 60
  Inventory.Icon "ERGPA0"
  +IGNORESKILL
}
