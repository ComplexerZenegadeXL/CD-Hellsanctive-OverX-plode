Actor EnragedLegendaryPlasmaticRifleGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFEnragedLegendaryPlasmaticRiflePickup"
  Inventory.PickupSound "weapons/legup"
  Tag "$CFEnragedLegendaryPlasmaticRifle"
  States
  {
  Spawn:
    ITEP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	ITEP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",18,29,16) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticRifle",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",70)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonMagazine",Random(25,50))
	TNT1 A 0 A_GiveInventory("ILDemonAmmo",50)
	Stop
  }
}

Actor EnragedLegendaryPlasmaticRifleSpawnerGiver : EnragedLegendaryPlasmaticRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",70)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonMagazine",Random(25,50))
	TNT1 A 0 A_GiveInventory("ILDemonAmmo",50)
	Stop
  }
}

Actor EnragedLegendaryPlasmaticRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor EnragedLegendaryPlasmaticRifle : Weapon
{
  Height 14
  Scale 0.95
  Weapon.PreferredSkin "EnragedLegendaryRifle-Marine"
  Weapon.SelectionOrder 7120
  Weapon.KickBack 60
  Weapon.AmmoUse 2
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 12.0
  Weapon.AmmoType "ILDemonMagazine"   
  Weapon.AmmoType2 "ILDemonAmmo"
  Weapon.SelectionOrder 500
  //Weapon.MinSelectionAmmo1 2
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupMessage "$CFEnragedLegendaryPlasmaticRiflePickup"
  Inventory.PickupSound "weapons/legup"
  Tag "$CFEnragedLegendaryPlasmaticRifle"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +NOTIMEFREEZE
  States
  {
  Spawn:
    ITEP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	ITEP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlaySound("weapons/legup")
	ITRS ABCDE 1
  ReadyLoop:
    TNT1 A 0 A_JumpIfInventory("LDemonMagazine",1,2)
	TNT1 A 0
	Goto NoBuzzing
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)	 
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_PlaySound("weapons/legrifidle")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ITEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  NoBuzzing:
    TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    ITEK A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Deselect:
	ITEK A 1 A_Lower
    Goto Deselect
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("EnragedLegendaryPlasmaticRifle",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    ITKF A 1 Bright A_FireCustomMissile("RPlayerLegendaryProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	ITKF B 1 Bright A_Light2
    ITKF C 2 A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    ITKF A 1 Bright A_FireCustomMissile("RPlayerLegendaryProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("RPlayerLegendaryProjectile",frandom(-1.0,1.0)+15.0,0,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("RPlayerLegendaryProjectile",frandom(-1.0,1.0)-15.0,0,0,0,0,frandom(-1.0,1.0))
	ITKF B 1 Bright A_Light2
    ITKF C 2 A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  Empty:
    ITEK A 10 A_PlaySound("weapons/click2")
	Goto Reload
  Reload:
  	TNT1 A 0 A_JumpIfInventory("ILDemonMagazine",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("ILDemonAmmo",1,1)
	Goto ReadyLoop
    ITKR AB 2
	ITKR C 3
	ITKR D 4 A_PlaySound("weapons/demontecheject")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	ITKR E 2 A_PlaySound("weapons/demontechsteam")
	ITKR F 2 Radius_Quake(2,2,0,1,0)
	ITKR GHI 2 Radius_Quake(2,2,0,1,0)
	ITKR J 3 A_FireCustomMissile("ILDemonTechEmptyMag", 0, 0, 0, 1)
	ITKR K 15 
	ITKR LMN 2
	TNT1 A 0 A_JumpIfInventory("ILDemonAmmo",1,"ActualReload")	 
    ITKR D 6 A_PlayWeaponSound("weapons/demontechload")
    ITKR D 4 A_PlayWeaponSound("weapons/demontechclick")
    ITKR D 6
	ITKR A 2
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("ILDemonAmmo",1)
	TNT1 A 0 A_GiveInventory("ILDemonMagazine",1)
	TNT1 A 0 A_JumpIfInventory("ILDemonMagazine",50,"Full")
	TNT1 A 0 A_JumpIfInventory("ILDemonAmmo",1,"ActualReload")
	Goto Reload+19
  Full:
    TNT1 A 0
	Goto Reload+19
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	ITRS EDCBA 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN K 1
	HGRN LMNO 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	ITRS EDCBA 1
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1 
  }
}

Actor ILDemonMagazine : Ammo 
{
  Inventory.Amount 0
  Inventory.MaxAmount 50
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 50
  Inventory.Icon "ITEPA0"
  +IGNORESKILL
}

Actor ILDemonAmmoPickup : LegendaryShellPickup
{
  Scale 0.65
  Inventory.PickupMessage "$CFILDemonAmmoPickup"
  Inventory.PickupSound "items/LDemonAmmo"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	IAMG A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",17,50)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",17) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor ILDemonAmmo : Ammo
{
  Scale 0.65
  Inventory.PickupMessage "$CFILDemonAmmoPickup"
  Inventory.PickupSound "items/LDemonAmmo"
  Inventory.Amount 50
  Inventory.MaxAmount 250
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 500
  Inventory.Icon "IAMGA0"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	IAMG A -1
    Stop
  }
}

Actor ILDemonAmmoBoxPickup : LegendaryShellPickup
{
  Scale 0.65
  Inventory.PickupMessage "$CFILDemonAmmoBoxPickup"
  Inventory.PickupSound "items/LDemonAmmopack"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	IAMO ABCDDCB 7
    Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",17,100)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",17) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor ILDemonAmmoBox : ILDemonAmmo
{
  Scale 0.65
  Inventory.Amount 100
  Inventory.PickupMessage "$CFILDemonAmmoBoxPickup"
  Inventory.PickupSound "items/LDemonAmmopack"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	IAMO ABCDDCB 7
	Loop
  }
}

Actor ILDemonTechEmptyMag : BulletCasing
{
  Scale 0.4
  SeeSound "weapons/emptydrum"
  States
  {
  Spawn:
	IDTM ABCD 3  
	Loop
  Death:
	TNT1 A 0
    TNT1 A 0 A_Jump(128,3)
    IDTM A 100
    IDTM A 5 A_FadeOut(0.10)
    Goto Death+3
    IDTM C 100
	IDTM C 5 A_FadeOut(0.10)
	Goto Death+5		  
  }
}
