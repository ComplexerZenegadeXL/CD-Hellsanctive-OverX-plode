Actor PlasmaRifleGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFPlasmaRiflePickup"
  Inventory.PickupSound "weapons/pickuphr"
  Tag "$CFPlasmaRifle"
  States
  {
  Spawn:
    PLAS A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	PLAS A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",73,22,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFPlasmaRifle",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("PlasmaRepeater",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFPlasmaRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",78)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("PlasmaCell",Random(25,50))
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor PlasmaRifleSpawnerGiver : PlasmaRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFPlasmaRifle",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("PlasmaRepeater",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFPlasmaRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",78)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("PlasmaRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("PlasmaRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("PlasmaCell",Random(25,50))
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor PlasmaRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CFPlasmaRifle : Weapon replaces PlasmaRifle
{
  Scale 0.85
  Weapon.PreferredSkin "PlasmaRifle-Marine"
  Weapon.SelectionOrder 4050
  Weapon.KickBack 100
  Weapon.AmmoType "PlasmaCell"
  Weapon.AmmoType2 "NewCell"  
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 1.0
  //Weapon.MinSelectionAmmo1 1
  Weapon.SelectionOrder 3000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Inventory.PickupMessage "$CFPlasmaRiflePickup"
  Inventory.PickupSound "weapons/pickuphr"
  Tag "$CFPlasmaRifle"
  States
  {
  Spawn:
    PLAS A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	PLAS A -1
    Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickuphr")
	PRAS ABCDEFG 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    PKPL A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	PKPL A 1 A_Lower
    Goto Deselect+1
  Select:
	TNT1 A 0 A_Raise
    Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlaySound("weapons/hrfire")
	PLSF B 2 A_FireCustomMissile("NewPlasmaBall",0,1,0,0)
	PKPL A 1 Bright
	TNT1 A 0 A_JumpIfNoAmmo("Recoil")
	TNT1 A 0 A_ReFire
  Recoil:
	PKPL DEF 1
	PKPL G 10
	PKPL FEDCBA 1
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlaySound("weapons/hrfire")
	PLSF B 2 A_FireCustomMissile("NewPlasmaBall",0,1,0,0)
	TNT1 A 0 A_FireCustomMissile("NewPlasmaBall",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("NewPlasmaBall",-15.0,0,0,0)
	PKPL A 1 Bright
	TNT1 A 0 A_JumpIfInventory("PlasmaCell",1,1)
	Goto Recoil
	TNT1 A 0 A_ReFire
	Goto Recoil
  Flash:
	TNT1 A 2 Bright A_Light1
	PLSF A 2 Bright A_Light2
	Goto LightDone	
  Empty:
    PKPL A 10 A_PlayWeaponSound("weapons/click3")
  Reload:
  	TNT1 A 0 A_JumpIfInventory("PlasmaCell",50,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("NewCell",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_PlayWeaponSound("weapons/plasmacellout")
	PLZR B 1 A_FireCustomMissile("PlasmaCellCasingSpawner", 0, 0, 0, 1) 
	PLZR CD 2
	PLZR E 10
	PLZR FGH 1
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"ActualReload")
	PLZR I 2
	PLZR J 8 A_PlayWeaponSound("weapons/plasmacellin")
	PLZR KL 2
	PLZR M 1
	PKPL A 2
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_GiveInventory("PlasmaCell",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCell",50,"Full")
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"ActualReload")
	Goto Reload+11
  Full:
    TNT1 A 0
    Goto Reload+11
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	PRAS GFEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	PRAS GFEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor PlasmaCell : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 50
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 50
  Inventory.Icon "PLASA0"
  +IGNORESKILL
}

Actor NewPlasmaBall replaces PlasmaBall
{
  Radius 7
  Height 7
  Speed 28
  Damage 5
  Species "Player"
  Projectile
  +RANDOMIZE
  +THRUSPECIES
  -NOBLOCKMAP
  Scale 0.22
  RenderStyle Add
  Alpha 0.75
  Obituary "$CFNewPlasmaBallObit"
  DeathSound "weapons/hrballexplode"
  States
  {
  Spawn:
    TNT1 A 0
    //TNT1 A 0 A_Jump(128,"PlasmaSFX")
    PLST ABCDEF 2 Bright
    Loop
  PlasmaSFX:
    PLST AA 1 Bright A_SpawnItemEx("PlasmaLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
	PLST BB 1 Bright A_SpawnItemEx("PlasmaLightning2",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
	PLST CC 1 Bright A_SpawnItemEx("PlasmaLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
	PLST DD 1 Bright A_SpawnItemEx("PlasmaLightning2",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
	PLST EE 1 Bright A_SpawnItemEx("PlasmaLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
	PLST FF 1 Bright A_SpawnItemEx("PlasmaLightning2",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
    Goto Spawn
  Death:
	TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 A 1 A_SpawnItemEx("PlasmaEx",0,0,0,0,0,0,0)   
    Stop
  }
}

Actor PlasmaEx
{
  RenderStyle Add
  Alpha 0.75
  +CLIENTSIDEONLY
  +NOGRAVITY
  States
  {
  Spawn:
	PLD2 ABCD 3 Bright A_FadeOut(0.1)
	Stop
  }
}
