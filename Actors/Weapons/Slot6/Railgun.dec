Actor RailgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/pickuprg"
  Inventory.PickupMessage "$CFRailgunPickup"
  Tag "$CFRailgun"
  States
  {
  Spawn:
	SRCG A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	SRCG A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",74,23,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFRailgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("DemonTechRailgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("ExplosiveRailgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",79)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("CellCharge",Random(25,50))
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor RailgunSpawnerGiver : RailgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFRailgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("DemonTechRailgun",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("ExplosiveRailgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",79)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("RailgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("RailgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("CellCharge",Random(25,50))
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor RailgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CFRailgun : Weapon //19349
{
  Scale 0.8
  Decal "RailScorch"
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "Railgun-Marine"
  Weapon.SelectionOrder 4000
  Weapon.KickBack 200
  Weapon.AmmoUse 10
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 5.0
  Weapon.AmmoType "CellCharge"
  Weapon.AmmoType2 "NewCell"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  Inventory.Icon "SRCGA0"
  Inventory.PickupSound "weapons/pickuprg"
  Inventory.PickupMessage "$CFRailgunPickup"
  Obituary "$CFRailgunObit"
  Tag "$CFRailgun"
  States
  {
  Spawn:
	SRCG A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	SRCG A -1
	Loop
  Ready:
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"ReadyPulse")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyPulse")
	TNT1 A 0 A_PlayWeaponSound("weapons/railselect")
	RAEU ABCDE 1
  ReadyEmpty:	
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	RAIR A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	//TNT1 A 0 A_JumpIfInventory("CellCharge",1,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  ReadyZoomed:
	RSCP A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Goto ReadyLoop+2	
  ReadyPulse:
	TNT1 A 0 A_PlayWeaponSound("weapons/railselect")
	RAIU ABCDE 1
	Goto ReadyLoop
  ReadyLoop:
	//TNT1 A 0 A_JumpIfInventory("CellCharge",1,1)
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto ReadyEmpty
	TNT1 A 0 A_PlayWeaponSound("weapons/railgunhum")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL B 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL B 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL B 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	TNT1 A 0 A_GiveInventory("Loop",1)
	TNT1 A 0 A_JumpIfInventory("Loop",4,1)
	Goto ReadyLoop+2
	TNT1 A 0 A_TakeInventory("Loop",99)
	RAIL C 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RAIL C 1 A_WeaponReady
	Goto ReadyLoop+1
  ReadyZoomed:
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,2)
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),2)
	TNT1 A 0 A_TakeInventory("Loop",99)
	Goto Ready+7
	TNT1 A 0 A_PlayWeaponSound("weapons/railgunhum")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	RSCP A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_GiveInventory("Loop",1)
	TNT1 A 0 A_JumpIfInventory("Loop",36,1)
	Goto ReadyZoomed+3
	TNT1 A 0 A_TakeInventory("Loop",99)
	Goto ReadyZoomed+2
  Select:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"Deselect2")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"Deselect2")
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  DeselectLoop:
	RAIR A 1 A_Lower
	Loop
  Deselect2:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  Deselect2Loop:
	RAIL A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	RAIF A 2 Bright A_RailAttack(250,0,0,"00 85 FF",None,0,0,"PlayerRailPuff",0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	RAIF B 2 Bright A_Light2
	TNT1 A 0 A_Light0
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"ChargedRecoil")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargedRecoil")
	RAER ABCD 2
	RAER EFG 1
	RAIR A 40
	Goto Ready+7
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",-15,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",15,0)
	RAIF A 2 Bright A_RailAttack(250,0,0,"00 85 FF",None,0,0,"PlayerRailPuff",0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_RailAttack(250,0,0,"00 85 FF",None,RGF_EXPLICITANGLE,0,"PlayerRailPuff",15.0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_RailAttack(250,0,0,"00 85 FF",None,RGF_EXPLICITANGLE,0,"PlayerRailPuff",-15.0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	RAIF B 2 Bright A_Light2
	TNT1 A 0 A_Light0
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"ChargedRecoil")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargedRecoil")
	RAER ABCD 2
	RAER EFG 1
	RAIR A 40
	Goto Ready+7
  ChargedRecoil:
	RAIF CDEF 2
	RAIF GHI 1
	RAIF J 40
	Goto ReadyLoop
  FireZoomed:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireZoomedSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	//TNT1 A 0 A_FireBullets(0.0,0.0,-1,350,"PlayerRailPuff",FBF_NORANDOM,16384)
	RSCP A 5 Bright A_RailAttack(350,0,0,"00 85 FF",None,0,0,"PlayerRailPuff",0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,4)
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),4)
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	RAIR A 50 A_Light0
	Goto Ready+7
	TNT1 A 0 A_Light0
	RSCP A 50 Bright
	Goto ReadyZoomed
  FireZoomedSpread:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",-15,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",15,0)
	//TNT1 A 0 A_FireBullets(0.0,0.0,-1,350,"PlayerRailPuff",FBF_NORANDOM,16384)
	RSCP A 5 Bright A_RailAttack(350,0,0,"00 85 FF",None,0,0,"PlayerRailPuff",0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_RailAttack(350,0,0,"00 85 FF",None,RGF_EXPLICITANGLE,0,"PlayerRailPuff",15.0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_RailAttack(350,0,0,"00 85 FF",None,RGF_EXPLICITANGLE,0,"PlayerRailPuff",-15.0,0,0,0,40,0,"CFRailGunTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("CellCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("CellCharge",5)
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,4)
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),4)
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	RAIR A 50 A_Light0
	Goto Ready+7
	TNT1 A 0 A_Light0
	RSCP A 50 Bright
	Goto ReadyZoomed
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click2",CHAN_6)
	RAIR AAAAAAAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	Goto Reload
  Reload:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_JumpIfInventory("CellCharge",50,"FakeReload")
	TNT1 A 0 A_JumpIfInventory("NewCell",10,2)
	TNT1 A 0 //A_WeaponReady(WRF_NOFIRE)
	Goto ReadyLoop
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	RAIR ABCDEFG 1
	RAIR H 4 A_PlaySound("weapons/cellreload",CHAN_6)
	RAIR IJKL 2
	RAIR M 1
	RAIR N 1 A_FireCustomMissile("CellCasingSpawner",frandom(-13,-15),0,2,1)
	RAIR OPQR 1
	RAIR ST 2
	RAIR U 20
	RAIR VWX 1
	RAIR YZ 2
	RARL A 2
	TNT1 A 0 A_JumpIfInventory("NewCell",10,"ActualReload")	
	RARL B 4
	RARL C 3
	RARL DE 2
	RAIR A 30
	RAIF J 10 A_PlaySound("weapons/plasmacellin",CHAN_6)
	Goto ReadyLoop+2
  FakeReload:
	TNT1 A 0 A_PlaySound("weapons/railgunhum",CHAN_WEAPON)
	RAIL CCC 1 A_WeaponReady(WRF_NOFIRE)
	RAIL AAA 1 A_WeaponReady(WRF_NOFIRE)
	RAIL BBBCCC 1 A_WeaponReady(WRF_NOFIRE)
	RAIL AAA 1 A_WeaponReady(WRF_NOFIRE)
	RAIL BBBCCC 1 A_WeaponReady(WRF_NOFIRE)
	RAIL AAA 1 A_WeaponReady(WRF_NOFIRE)
	RAIL BBBCCC 1 A_WeaponReady(WRF_NOFIRE)
	RAIL AAA 1 A_WeaponReady(WRF_NOFIRE)
	RAIL BBB 1 A_WeaponReady(WRF_NOFIRE)
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("NewCell",10)
	TNT1 A 0 A_GiveInventory("CellCharge",10)
	TNT1 A 0 A_JumpIfInventory("CellCharge",50,"Full")
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"ActualReload")
	Goto Reload+35
  Full:
	TNT1 A 0
	Goto Reload+35
  Zoom:
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,1)
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Ready+7
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"UnZoom")
	TNT1 A 0 A_GiveInventory("CFRailgunZoomed",1)
	RAIL A 3 A_ZoomFactor(5)
	RAIL BC 3
	Goto ReadyZoomed
  FiredUnZoom:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIF J 50 A_ZoomFactor(1)
	Goto ReadyLoop+2
  FiredUnZoom2:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIF J 40 A_ZoomFactor(1)
	Goto ReadyLoop+2
  FiredUnZoom3:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIF J 30 A_ZoomFactor(1)
	Goto ReadyLoop+2
  FiredUnZoom4:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIF J 20 A_ZoomFactor(1)
	Goto ReadyLoop+2
  FiredUnZoom5:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIF J 10 A_ZoomFactor(1)
	Goto ReadyLoop+2	
  UnZoom:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	RAIL A 3 A_ZoomFactor(1)
	RAIL BC 3
	Goto ReadyLoop+2	
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,2)
	TNT1 A 0 A_ZoomFactor(1)
	Goto ReadyLoop
	TNT1 A 0
	Goto ReadyZoomed
  GrenadeToss:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6)
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"GrenadeToss2")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"GrenadeToss2")
	RAEU EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+2
  GrenadeToss2:
	RAIU EDCBA 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto ReadyPulse+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,2)
	TNT1 A 0 A_ZoomFactor(1)
	Goto ReadyLoop
	TNT1 A 0
	Goto ReadyZoomed
  MineToss:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6)
	//TNT1 A 0 A_JumpIfInventory("CellCharge",10,"MineToss2")
	TNT1 A 0 A_JumpIfInventory("CellCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"MineToss2")
	RAEU EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0  A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+2
  MineToss2:
	RAIU EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0  A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto ReadyPulse+1
  }
}

