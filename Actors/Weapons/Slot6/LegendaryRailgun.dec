Actor LegendaryRailgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryRailgunPickup"
  Inventory.PickupSound "weapons/pickuprg"
  Tag "$CFLegendaryRailgun"
  States
  {
  Spawn:
	LERP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	LERP A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",34,26,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryRailgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",74)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LegRailgunAmmo",Random(25,50))
	TNT1 A 0 A_GiveInventory("LDemonAmmo",150)
	Stop
  }
}

Actor LegendaryRailgunSpawnerGiver : LegendaryRailgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryRailgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",74)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryRailgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryRailgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LegRailgunAmmo",Random(25,50))
	TNT1 A 0 A_GiveInventory("LDemonAmmo",8)
	Stop
  }
}

Actor LegendaryRailgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryRailgun : Weapon 18603
{
  //$Category Weapons/LCA/DJB
  //$Sprite LRWPA0
  //$Title "LegendaryRailgun"
  Scale 0.8
  Weapon.PreferredSkin "LegendaryRailgun-Marine"
  Weapon.Selectionorder 7
  Weapon.KickBack 2000
  Weapon.AmmoUse 10
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 8.0
  Weapon.AmmoType "LegRailgunAmmo"
  Weapon.AmmoType2 "LDemonAmmo"
  Inventory.PickupSound "weapons/pickuprg"
  Inventory.PickupMessage "$CFLegendaryRailgun"
  Obituary "$CFLegendaryRailgunObit"
  Decal "TrueRocketScorch"
  Tag "$CFLegendaryRailgun"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT  
  +WEAPON.NOAUTOAIM
  States
  {
  Spawn:
    LERP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	LERP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("weapons/railselect")
	LERS ABCDE 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LERF A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	//TNT1 A 0 A_ZoomFactor(1)
    Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	LERF A 1 A_Lower
    Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryRailgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    Wait
  ReadyZoomed:
	//TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10,1)
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    LERZ A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Goto ReadyZoomed+1
  Fire:
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters 
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_PlaySound("lrailat")
    TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 0, 0, 0, 5)
    LERF A 1 Bright A_RailAttack(Random(650,800), 0, 0, "00 00 ff", None, 0, 0, "PlayerRailPuffBlue", 0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("LegRailgunAmmo",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LegRailgunAmmo",5,TIF_NOTAKEINFINITE)
	LERF BCDEFGHIJKLMNOP 1 Bright A_Light2     
	TNT1 A 0 A_Light0
	LERF A 54
    Goto ReadyLoop
  FireZoomed:
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireZoomedSpread")
	TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_PlaySound("lrailat")
    TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 0, 0, 0, 5)
	LERZ A 4 Bright A_RailAttack(Random(800,950), 0, 0, "00 00 ff", None, 0, 0, "PlayerRailPuffBlue", 0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("LegRailgunAmmo",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LegRailgunAmmo",5,TIF_NOTAKEINFINITE)
	//TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10,"NoAmmo")
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"NoAmmo")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	//LERF BCDEFGHIJKLMNOP 1 Bright 
	LERF A 66 A_Light0
	Goto ReadyLoop
  NoAmmo:
	TNT1 A 0 A_Light0
	LERZ A 66 Bright //A_JumpIfInventory("RailgunAction",1,"UnZoom")
	Goto ReadyZoomed
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"FireZoomed")
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
    TNT1 A 0 A_AlertMonsters 
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_PlaySound("lrailat")
    TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 0, 0, 0, 5)
    LERF A 1 Bright A_RailAttack(Random(650,800), 0, 1, "00 00 ff", None, 0, 0, "PlayerRailPuffBlue", 0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_RailAttack(Random(650,800), 0, 0, "00 00 ff", None, RGF_EXPLICITANGLE, 0, "PlayerRailPuffBlue", 15.0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_RailAttack(Random(650,800), 0, 0, "00 00 ff", None, RGF_EXPLICITANGLE, 0, "PlayerRailPuffBlue", -15.0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 15.0, 0, 0, 5)
	TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", -15.0, 0, 0, 5)
	LERF BCDEFGHIJKLMNOP 1 Bright A_Light2     
	TNT1 A 0 A_Light0
	LERF A 54
    Goto ReadyLoop
  FireZoomedSpread:
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
    TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 A_FireCustomMissile("RailgunImpact",0,0)
	TNT1 A 0 A_PlaySound("lrailat")
    TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 0, 0, 0, 5)
	LERZ A 4 Bright A_RailAttack(Random(800,950), 0, 1, "00 00 ff", None, 0, 0, "PlayerRailPuffBlue", 0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_RailAttack(Random(800,950), 0, 0, "00 00 ff", None, RGF_EXPLICITANGLE, 0, "PlayerRailPuffBlue", 15.0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_RailAttack(Random(800,950), 0, 0, "00 00 ff", None, RGF_EXPLICITANGLE, 0, "PlayerRailPuffBlue", -15.0, 0, 8192, 35, 0.5, 0.5, "LegRailCoreTrail")
	TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", 15.0, 0, 0, 5)
	TNT1 A 0 A_FireCustomMissile("LegendaryRailgunPROJ", -15.0, 0, 0, 5)
	//TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10,"NoAmmo")
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"NoAmmo")
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)	
	//LERF BCDEFGHIJKLMNOP 1 Bright 
	LERF A 66 A_Light0
	Goto ReadyLoop
	TNT1 A 0 A_Light0
	LERZ A 66 Bright //A_JumpIfInventory("RailgunAction",1,"UnZoom")
	Goto ReadyZoomed
  Empty:
	LERF A 15 A_PlaySound("weapons/click2")
  Reload:
    TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",50,2)
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,2)
	TNT1 A 0
	Goto ReadyLoop
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
	LERR ABCD 2
	LERR E 4 A_PlayWeaponSound("weapons/demontecheject")
	LERR FGH 2
	LERR I 3
	LERR J 20 A_FireCustomMissile("LDemonTechEmptyMag", 0, 0, 0, 1)
	LERR I 1
	LERR HG 2
	LERR F 4
	LERR E 6 A_PlayWeaponSound("weapons/demontechload")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,"RealReload")	
	LERR D 4
	LERR C 3 
	LERR B 2
	LERR A 4
	Goto ReadyLoop
  RealReload:
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,1)
	Goto Full
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10)
	TNT1 A 0 A_GiveInventory("LegRailgunAmmo",10)
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",50,"Full")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,"RealReload")
	Goto Reload+5
  Full:
    LERR D 4
	LERR C 3 
	LERR B 2
	LERR A 4
	Goto ReadyLoop
  Zoom:
	//TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10,1)
	TNT1 A 0 A_JumpIfInventory("LegRailgunAmmo",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("CFRailgunZoomed",1,"UnZoom")
    TNT1 A 0 A_GiveInventory("CFRailgunZoomed",1)
	LERF A 3 A_ZoomFactor(5)
	LERF A 6
	Goto ReadyZoomed
  UnZoom:
	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	LERZ A 3 A_ZoomFactor(1)
	LERF A 6
	//TNT1 A 0 A_PrintBold("Unzoom")
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LERS EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_TakeInventory("CFRailgunZoomed",1)
	TNT1 A 0 A_ZoomFactor(1)
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LERS EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor LegRailgunAmmo : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 50
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 50
  Inventory.Icon "LERPA0"
}

Actor LegendaryRailgunPROJ : DarkCyberRail
{
  Radius 6
  Height 12
  Speed 250
  Damage (Random(65,85))
  Scale 1
  DamageType "PlayerLegendary"
  Species "Player"
  MissileHeight 8
  MissileType "LegRailTrail"
  SeeSound "monsters/darkcyberrail"
  DeathSound "cyberrail/impact"
  +RIPPER
  +THRUSPECIES
  +MTHRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 1 Bright
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("KaboomBlue2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 1 A_SpawnItem("RailGunImpactEffectBlue")
	Stop
  }
}


Actor LegRailParticleBlue : BFGTrailParticleGreen
{
  //-NOGRAVITY
  //+LOWGRAVITY
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	SPKB A 2 Bright A_FadeOut(frandom(0.025,0.05))
	TNT1 A 0 A_SetScale(ScaleX - frandom(0.001, 0.002), ScaleY - frandom(0.001, 0.002))
	Loop
  }
}

Actor LegRailParticleYellow : BFGTrailParticleGreen
{
  //-NOGRAVITY
  //+LOWGRAVITY
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	X054 A 2 Bright A_FadeOut(frandom(0.025,0.05))
	TNT1 A 0 A_SetScale(ScaleX - frandom(0.001, 0.002), ScaleY - frandom(0.001, 0.002))
	Loop
  }
}

Actor LegRailTrail : BFG9500Trail
{
  Radius 6
  Height 12
  Scale 0.1
  DamageType "PlayerLegendary"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegRailParticleBlue", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP3 ABC 2 Bright A_FadeOut(0.02)
    TNT1 A 0 A_SpawnItemEx("LegRailParticleYellow", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP4 ABC 2 Bright A_FadeOut(0.02)
	TNT1 A 0 A_SpawnItemEx("LegRailParticleBlue", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP3 ABC 2 Bright A_FadeOut(0.02)
    TNT1 A 0 A_SpawnItemEx("LegRailParticleYellow", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP4 ABC 2 Bright A_FadeOut(0.02)
	TNT1 A 0 A_SpawnItemEx("LegRailParticleBlue", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP3 ABC 2 Bright A_FadeOut(0.02)
    TNT1 A 0 A_SpawnItemEx("LegRailParticleYellow", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP4 ABC 2 Bright A_FadeOut(0.02)
	TNT1 A 0 A_SpawnItemEx("LegRailParticleBlue", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP3 ABC 2 Bright A_FadeOut(0.02)
    TNT1 A 0 A_SpawnItemEx("LegRailParticleYellow", frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(-0.5,0.5),frandom(0,360),SXF_CLIENTSIDE)
	RAP4 ABC 2 Bright A_FadeOut(0.02)
  BurnOut:
	RAP3 ABC 2 Bright A_FadeOut(0.02)
	TNT1 A 1
	RAP4 ABC 2 Bright A_FadeOut(0.04)
	TNT1 A 1
	Loop
}
}

