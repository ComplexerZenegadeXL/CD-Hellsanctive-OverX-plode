	X024 C 1 Bright A_FadeOut(0.01)
	X020 B 1 Bright A_FadeOut(0.01)
	X024 A 1 Bright A_FadeOut(0.01)
	X020 B 1 Bright A_FadeOut(0.01)
	X024 C 1 Bright A_FadeOut(0.01)
	X020 B 1 Bright A_FadeOut(0.01)
