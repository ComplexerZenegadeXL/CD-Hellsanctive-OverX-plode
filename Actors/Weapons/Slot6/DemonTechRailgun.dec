Actor DemonTechRailgunGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/pickupdtrg"
  Inventory.Pickupmessage "$CFDemonTechRailgunPickup"
  Tag "$CFDemonTechRailgun"
  States
  {
  Spawn:
	DRGI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DRGI A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",50,24,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DemonTechRailgun",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,256)
	TNT1 A 0 A_GiveInventory("DemonTechRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",68)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmoCharge",Random(30,60))
	TNT1 A 0 A_GiveInventory("DemonAmmo",60)
	Stop
  }
}

Actor DemonTechRailgunSpawnerGiver : DemonTechRailgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonTechRailgun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,256)
	TNT1 A 0 A_GiveInventory("DemonTechRailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",68)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DemonTechRailgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DemonTechRailgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmoCharge",Random(30,60))
	TNT1 A 0 A_GiveInventory("DemonAmmo",60)
	Stop
  }
}

Actor DemonTechRailgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DemonTechRailgun : Weapon
{
  //$Category Weapons/LCA
  //$Sprite DRGIA0
  //$Title "DemonTechRailgun"
  Scale 0.95
  Decal "GreenRocketScorch"
  +WEAPON.NOALERT  
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "DTechRailgun-Marine"
  Weapon.SelectionOrder 4000
  Weapon.KickBack 200
  Weapon.AmmoUse 10
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 6.0
  Weapon.AmmoType "DemonAmmoCharge"
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.SisterWeapon "PoweredDemonTechRailgun"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 2000
  DamageType "PlayerDTRG"
  AttackSound "weapons/dtrailf"
  Inventory.PickupSound "weapons/pickupdtrg"
  Inventory.PickupMessage "$CFDemonTechRailgunPickup"
  Obituary "$CFDemonTechRailgunObit"
  Tag "$CFDemonTechRailgun"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
	DRGI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DRGI A -1
	Loop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",7,0,1)
	TNT1 A -1
	Stop
  Ready:
	TNT1 A 0 A_PlaySound("weapons/dtrgselect")
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ChargeUp")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargeUp")
	Goto EmptyUp
  EmptyUp:
	TNT1 A 0 A_StopSound(6)
	DRGS FGHIJ 1
	Goto ReadyEmpty
  ChargeUp:
	DRGS ABCDE 1
	Goto ReadyCharge
  ReadyEmptyStart:
	TNT1 A 0 A_StopSound(6)
	DRGG D 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWRELOAD)
  ReadyEmpty:
	DRGG D 1 A_WeaponReady(WRF_ALLOWRELOAD)
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ReadyCharge")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyCharge")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  ReadyChargeStart:
	DRGG AABBCC 1 A_WeaponReady(WRF_NOFIRE|WRF_ALLOWRELOAD)
  ReadyCharge:
	TNT1 A 0 A_PlaySound("weapons/dtrailgunhum",6,1.0,1)
	DRGG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG B 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG B 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG B 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG C 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG C 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DRGG C 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ReadyCharge")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyCharge")
	Goto ReadyEmptyStart
  Select:
	//TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("DemonTechRailgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0
	TNT1 AAA 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"Deselect2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"Deselect2")
	DRGS JIHGF 1 A_Lower
	Wait
  Deselect2:
	DRGS EDCBA 1 A_Lower
	Wait
  Fire:
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_FireCustomMissile("DTRail",0,0,0,5)
	DRGF A 2 Bright A_RailAttack(450,0,0,"00 FF 85",None,0,0,"PlayerRailPuffGreen",0,0,8192,35,0.5,0.5,"DTRailCoreTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmoCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmoCharge",5,TIF_NOTAKEINFINITE)
	DRGF B 2 Bright A_Light2
	TNT1 A 0 A_Light0
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ChargedRecoil")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargedRecoil")
	Goto EmptyRecoil
  FireSpread:
	//TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),1)
	Goto Empty
	TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_FireCustomMissile("DTRail",0,0,0,5)
	TNT1 A 0 A_FireCustomMissile("DTRail",-15,0,0,5)
	TNT1 A 0 A_FireCustomMissile("DTRail",15,0,0,5)
	DRGF A 2 Bright A_RailAttack(450,0,0,"00 FF 85",None,0,0,"PlayerRailPuffGreen",0,0,8192,35,0.5,0.5,"DTRailCoreTrail")
	TNT1 A 0 A_RailAttack(450,0,0,"00 FF 85",None,RGF_EXPLICITANGLE ,0,"PlayerRailPuffGreen",15.0,0,8192,35,0.5,0.5,"DTRailCoreTrail")
	TNT1 A 0 A_RailAttack(450,0,0,"00 FF 85",None,RGF_EXPLICITANGLE ,0,"PlayerRailPuffGreen",-15.0,0,8192,35,0.5,0.5,"DTRailCoreTrail")
	TNT1 A 0 A_JumpIfInventory("GauntletsofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck",1) == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmoCharge",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmoCharge",5,TIF_NOTAKEINFINITE)
	DRGF B 2 Bright A_Light2
	TNT1 A 0 A_Light0
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ChargedRecoil")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargedRecoil")
	Goto EmptyRecoil
  EmptyRecoil:
	TNT1 A 0 A_StopSound(6)
	DRGF KLMN 2
	DRGF OPQ 1
	DRGG D 1
	DRGG DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOBOB)
	Goto ReadyEmptyStart
  ChargedRecoil:
	DRGF CDEF 2
	DRGF GHI 1
	DRGF J 1
	DRGF JJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJ 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOBOB)
	Goto ReadyChargeStart
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click2")
	DRGG DDDDDDDDDDDDDDD 1 A_WeaponReady(WRF_NOFIRE)
  Reload:
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",60,"ReadyChargeStart")
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ChargeReload")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ChargeReload")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",10,"EmptyReload")	
	Goto ReadyEmptyStart
  EmptyReload:
	DRGR WXYZ 2
	Goto ChargeReload2
  ChargeReload:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",1,1)
	Goto ReadyChargeStart
	DRGR ABCD 2
  ChargeReload2:
	DRGR EF 2
	DRGR G 4 A_PlaySound("weapons/demontecheject",6)
	TNT1 A 0 A_PlaySound("weapons/demontechsteam",1)
	DRGR HIJ 2
	DRGR K 3
	DRGR L 20 A_FireCustomMissile("DemonTechEmptyMagSpawner",frandom(-15,-13),0,2,1)
	DRGR MNO 1
	DRGR PQ 2
	DRGR R 4
	DRGR R 6 A_PlayWeaponSound("weapons/demontechload")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",10,"ActualReload")
  Low:
	DRGR S 4
	DRGR "Y" 3 A_PlayWeaponSound("weapons/demontechclick")
	DRGR "X" 2
	DRGR W 4
	Goto ReadyEmptyStart
  Full:
	DRGR S 4
	DRGR T 3 A_PlayWeaponSound("weapons/demontechclick")
	DRGR U 2
	DRGR V 4
	Goto ReadyChargeStart
  ActualReload:
	TNT1 A 0 A_TakeInventory("DemonAmmo",10)
	TNT1 A 0 A_GiveInventory("DemonAmmoCharge",10)
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",60,"Full")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",10,"ActualReload")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"Full")
	Goto Low
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ReadyChargeStart")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyChargeStart")
	Goto ReadyEmptyStart
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"GrenadeToss1")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"GrenadeToss1")
	DRGS JIHGF 1
	Goto GrenadeToss2
  GrenadeToss1:	
	DRGS EDCBA 1
  GrenadeToss2:
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"ReadyChargeStart")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"ReadyChargeStart")
	Goto ReadyEmptyStart
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	//TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10,"MineToss1")
	TNT1 A 0 A_JumpIfInventory("DemonAmmoCharge",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck",1),"MineToss1")
	DRGS JIHGF 1
	Goto MineToss2
  MineToss1:
	DRGS EDCBA 1
  MineToss2:
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 5 A_TakeInventory("MineAction",1)
	Goto Ready+1
  }
}

Actor DemonAmmoCharge : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 60
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 60
  Inventory.Icon "DRGIA0"
  +IGNORESKILL
}

Actor PlayerRailPuffGreen
{
  DamageType "DTRailgun"
  +NODAMAGETHRUST
  +THRUSPECIES
  +MTHRUSPECIES
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_SpawnItem("RailgunImpactEffectGreen")
	Stop
  }
}

Actor DTRail : DarkCyberRail
{
  Radius 6
  Height 12
  Speed 100
  Scale 0.25
  DamageType "PlayerDTRG"
  Damage (Random(15,20))
  SeeSound "weapons/dtrail"
  MissileType "DTRailTrail"
  MissileHeight 8
  Species "Player"
  //DeathSound "weapons/dtrailimpact"
  DeathSound "cyberrail/impact"
  +RIPPER
  +THRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  States
  {
  Spawn:
    TNT1 A 1 Bright
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("GreenKaboom2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 1 A_SpawnItem("RailGunImpactEffectGreen")
	Stop
  }
}

Actor DTRailTrail : BFG9500Trail
{
  Radius 6
  Height 12
  Scale 0.1
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 Bright A_SpawnItemEx("DemonTechRailGunTrailSpark", frandom(-4,4), frandom(-4,4), frandom(-4,4), 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	X401 ABC 2 Bright A_FadeOut(0.04)
	Loop
  }
}

Actor DTRailCore : DTRail
