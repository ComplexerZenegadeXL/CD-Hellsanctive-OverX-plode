Actor DemonTechRifleGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFDemonTechRiflePickup"
  Inventory.PickupSound "weapons/demontechload"
  Tag "$CFDemonTechRifle"
  States
  {
  Spawn:
    DTEP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DTEP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",75,27,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DemonTechRifle",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("DemonTechRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",69)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonMagazine",Random(30,60))
	TNT1 A 0 A_GiveInventory("DemonAmmo",30)
	Stop
  }
}

Actor DemonTechRifleSpawnerGiver : DemonTechRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonTechRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("DemonTechRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",69)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DemonTechRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DemonTechRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonMagazine",Random(30,60))
	TNT1 A 0 A_GiveInventory("DemonAmmo",30)
	Stop
  }
}

Actor DemonTechRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DemonTechRifle : Weapon
{
  Height 14
  Scale 0.95
  Weapon.PreferredSkin "DemonTechRifle-Marine"
  Weapon.SelectionOrder 7980
  Weapon.KickBack 60
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 10.0
  Weapon.AmmoType "DemonMagazine"   
  Weapon.AmmoType2 "DemonAmmo"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.SisterWeapon "PoweredDemonTechRifle"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 2000
  Inventory.PickupMessage "$CFDemonTechRifle"
  Inventory.PickupSound "weapons/demontechload"
  Obituary "$CFDemonTechRifleObit"
  Tag "$CFDemonTechRifle"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    DTEP A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DTEP A -1
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",6,0,1)
	TNT1 A -1
	Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("weapons/demontechload")
	DTRS ABCDE 1
  ReadyLoop:
    TNT1 A 0 A_JumpIfInventory("DemonMagazine",1,2)
	TNT1 A 0
	Goto NoBuzzing
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)	 
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_PlayWeaponSound("weapons/demontechidle")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	DTEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  NoBuzzing:
    TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    DTEK A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Deselect:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    DTEK A 1 A_Lower
    Goto Deselect+1
  Select:
	TNT1 A 0 A_Raise
	Wait
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("weapons/demontechfire")
    DTKF A 2 Bright A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	DTKF B 1 Bright A_Light2
    DTKF C 2 A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  FireSpread:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("weapons/demontechfire")
    DTKF A 2 Bright A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,1.0)+15.0,0,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,1.0)-15.0,0,0,0,0,frandom(-1.0,1.0))
	DTKF B 1 Bright A_Light2
    DTKF C 2 A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  Empty:
    DTEK A 10 A_PlaySound("weapons/click2",CHAN_6)	 
  Reload:
  	TNT1 A 0 A_JumpIfInventory("DemonMagazine",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("DemonAmmo",1,1)
	Goto ReadyLoop
    DTKR AB 2
	DTKR C 3
	DTKR D 4 A_PlaySound("weapons/demontecheject",CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/demontechsteam",CHAN_6)
	DTKR EFG 1 Radius_Quake(2,2,0,1,0)
	DTKR H 2 Radius_Quake(2,2,0,1,0)
	DTKR I 3 Radius_Quake(2,2,0,1,0)
	DTKR J 4 A_FireCustomMissile("DemonTechEmptyMagSpawner", 0, 0, 0, 1)
	DTKR K 15 
	DTKR LM 2
	DTKR N 2 A_PlaySound("weapons/demontechload",CHAN_6)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",1,"ActualReload")	 
	DTKR O 8
	DTKR O 2 A_PlaySound("weapons/demontechclick",CHAN_6)
    DTKR CB 3
	DTKR A 2
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("DemonAmmo",1)
	TNT1 A 0 A_GiveInventory("DemonMagazine",1)
	TNT1 A 0 A_JumpIfInventory("DemonMagazine",60,"Full")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",1,"ActualReload")
	Goto Reload+19
  Full:
    TNT1 A 0
	Goto Reload+19
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
  	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	DTRS EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
    TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	DTRS EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}
Actor DemonMagazine : Ammo 
{
  Inventory.Amount 0
  Inventory.MaxAmount 60
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 60
  Inventory.Icon "DTEPA0"
  +IGNORESKILL
}

Actor DemonTechProjectile
{
  Height 4
  Radius 4
  Speed 50
  Damage (Random(20,40))
  Scale 0.06
  Projectile
  +THRUSPECIES
  +FORCERADIUSDMG
  Species "Player"
  DeathSound "weapons/demontechex"
  Decal "DTRScorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
  Normal:
    TNT1 A 0 A_Jump(128,"NormalFX")
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  NormalFX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Normal
  Spawn2:
	TNT1 A 0 A_Jump(128,"Spawn2FX")
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Spawn2FX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn2
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_Explode(20,64)
    Stop
  }
}

Actor DemonTechEx
{
  RenderStyle Add
  Alpha 0.75
  Scale 0.5
  Projectile
  +NOCLIP
  States
  {
  Spawn:
	FRPG ABCDEFGH 2 Bright A_FadeOut(0.1)
	Stop
	}
}

Actor DemonTechTrail : CFRailgunTrail
{
  Scale 0.04
  Alpha 0.65
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
    DTRI AAAAAABBBBBBBB 1 Bright A_FadeOut(0.05)
    Stop
  }
}

Actor DemonTechTrail2 : DemonTechTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
    DTRI AAAAAACCCCCCCC 1 Bright A_FadeOut(0.05)
    Stop
  }
}
