Actor DemonTechBallistaGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFDemonTechBallistaPickup"
  Tag "$CFDemonTechBallista"
  States
  {
  Spawn:
	DTBI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DTBI A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",39,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DemonTechBallista",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("DemonTechBallista",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",67)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",Random(30,60))
	Stop
  }
}

Actor DemonTechBallistaSpawnerGiver : DemonTechBallistaGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonTechBallista",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("DemonTechBallista",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",67)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DemonTechBallistaGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DemonTechBallistaGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",Random(30,60))
	Stop
  }
}

Actor DemonTechBallistaGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DemonTechBallista : Weapon 18653
{
  //$Category Weapons/LCA/DJB
  //$Sprite DTBIA0
  //$Title "DemonTechBallista"
  Scale 0.95
  Weapon.SlotNumber 6
  Weapon.PreferredSkin "DTBallista-Marine"
  Weapon.SelectionOrder 7980
  Weapon.AmmoUse 1
  Weapon.KickBack 60
  Weapon.AmmoGive 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 3.0
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  Inventory.PickupMessage "$CFDemonTechBallistaPickup"
  Inventory.Icon "DTBIA0"
  Obituary "$CFDemonTechBallistaObit"
  Tag "$CFDemonTechBallista"
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States
  {
  Spawn:
	DTBI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	DTBI A -1
	Stop
  Select:   
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("DemonTechBallista",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,2)
	DTBG E 1 A_Raise
	Goto Select
	DTBG ABCD 1 A_Raise
	Goto Select+2
  Ready:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,2)
	DTBG E 1 A_WeaponReady
	Goto Ready
	TNT1 A 0 A_PlaySound("weapons/demontechidle")
	DTBG ABCDCB 4 A_WeaponReady
	Goto Ready+2
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,2)
	DTBG E 1 A_Lower
	Goto Deselect+3
	DTBG ABCD 1 A_Lower
	Goto Deselect+3
  Fire:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("weapons/BallistaFire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("weapons/demontechfire")
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-2,-1.5),1,0,8,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,-0.5),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-0.2,0.2),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(0.5,1.0),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(1.5,2.0),1,0,8,0,frandom(-0.5,0.5))
	DTBF A 2 Bright
	TNT1 A 0 A_Light0
	DTBF BCD 1
	DTBF EFGJK 2
	DTBG E 10
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,1)
	Goto Ready
	DTBG FG 2
	DTBG A 1 A_WeaponReady
	Goto Ready + 2
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,1)
	Goto Empty
	TNT1 A 0 A_PlaySound("weapons/BallistaFire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("weapons/demontechfire")
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-2,-1.5),1,0,8,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,-0.5),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-0.2,0.2),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(0.5,1.0),1,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(1.5,2.0),1,0,8,0,frandom(-0.5,0.5))
	
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-2,-1.5)+15.0,0,0,8,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,-0.5)+15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-0.2,0.2)+15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(0.5,1.0)+15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(1.5,2.0)+15.0,0,0,8,0,frandom(-0.5,0.5))
	
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-2,-1.5)-15.0,0,0,8,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-1.0,-0.5)-15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(-0.2,0.2)-15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(0.5,1.0)-15.0,0,0,8,0,frandom(-0.5,0.5)) 
	TNT1 A 0 A_FireCustomMissile("DemonTechProjectile",frandom(1.5,2.0)-15.0,0,0,8,0,frandom(-0.5,0.5))
	DTBF A 2 Bright
	TNT1 A 0 A_Light0
	DTBF BCD 1
	DTBF EFG 2
	DTBF JK 2
	DTBG E 10
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,1)
	Goto Ready
	DTBG FG 2
	DTBG A 1 A_WeaponReady
	Goto Ready
  Empty:
	TNT1 A 0 A_PlayWeaponSound("weapons/click")
	DTBG E 18  //EFGJK 2
	Goto Ready
  }
}

Actor DemonTechProjectile2 : DemontechProjectile
{
  Speed 35
  Damage (Random(10,30))
  Scale 0.20
  States
  {
  NormalFX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Normal
  Spawn2:
	TNT1 A 0 A_Jump(128,"Spawn2FX")
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Spawn2FX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn2  
  Death:
    TNT1 A 0 Bright A_SpawnItemEx("GreenParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 Bright A_SpawnItemEx("ZDemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 Bright A_Explode(15,64)
    Stop
  }
}
