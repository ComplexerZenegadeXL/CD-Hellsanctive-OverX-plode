Actor HellStaffGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "HellStaff/Pickup"
  Inventory.PickupMessage "$CFHellStaffPickup"
  Tag "$CFHellStaff"
  States
  {
  Spawn:
    HLS3 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	HLS3 A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",29,-1,7) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("HellStaff",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("HellStaff",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",73)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor HellStaffSpawnerGiver : HellStaffGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("HellStaff",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("HellStaff",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",73)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("HellStaffGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("HellStaffGiverCheck",1)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor HellStaffGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor HellStaff : Weapon 17600
{
  //$Category Weapons/CF
  //$Sprite HLS2F0
  //$Title "Hell Staff"
  Weapon.KickBack 0
  Weapon.YAdjust 0
  Weapon.AmmoType1 "CFMana"
  Weapon.AmmoType2 "CFMana"
  Weapon.AmmoUse1 1
  Weapon.AmmoUse2 4
  Weapon.AmmoGive 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 9.0
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo1 4
  Weapon.SelectionOrder 2000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.UpSound "HellStaff/Pickup"
  Inventory.PickupSound "HellStaff/Pickup"
  Inventory.PickupMessage "$CFHellStaffPickup"
  Tag "$CFHellStaff"
  Weapon.PreferredSkin "Fist-Marine"
  States
  {
  Spawn:
    HLS3 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	HLS3 A -1
    Stop
  Select: 
	//TNT1 A 0 A_JumpIfInventory("DustLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("HellStaff",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeslectLoop:
    HLS2 A 1 A_Lower
    Loop
  Ready:
	HLS2 GHIJK 2
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLS2 AAAAA 1 A_WeaponReady
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLS2 AAAAA 1 A_WeaponReady
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLS2 AAAAA 1 A_WeaponReady
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    HLS2 AAAAA 1 A_WeaponReady
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	HLS2 DDDCCCBBB 1 A_WeaponReady
    Loop
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	HLS2 D 1
    HLS2 E 2 Bright Offset(0, 48) A_FireCustomMissile("HellStaffBall1",0,1,0,-4)
    HLS2 D 2 Offset(0, 40)
    HLS2 D 2 Offset(0, 36) A_ReFire
    Goto Ready2
  FireSpread:
    HLS2 D 1
    HLS2 E 2 Bright Offset(0, 48) A_FireCustomMissile("HellStaffBall1",0,1,0,-4)
	TNT1 A 0 A_FireCustomMissile("HellStaffBall1",15.0,0,0,-4)
	TNT1 A 0 A_FireCustomMissile("HellStaffBall1",-15.0,0,0,-4)
    HLS2 D 2 Offset(0, 40)
    HLS2 D 2 Offset(0, 36) A_ReFire
    Goto Ready2
  AltFire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	HLS2 D 1
    HLS2 E 4 Bright Offset(0, 48) A_FireCustomMissile("HellStaffBall2",0,1,0,-4)
    HLS2 D 3 Offset(0, 40)
    HLS2 D 2 Offset(0, 36) A_ReFire
    Goto Ready2
  AltFireSpread:
    HLS2 D 1
    HLS2 E 4 Bright Offset(0, 48) A_FireCustomMissile("HellStaffBall2",0,1,0,-4)
	TNT1 A 0 A_FireCustomMissile("HellStaffBall2",15.0,0,0,-4)
	TNT1 A 0 A_FireCustomMissile("HellStaffBall2",-15.0,0,0,-4)
    HLS2 D 3 Offset(0, 40)
    HLS2 D 2 Offset(0, 36) A_ReFire
    Goto Ready2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready2
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	HLS2 LMN 2
	TNT1 A 3
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	HLS2 NML 2
	Goto Ready2
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready2
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	HLS2 LMN 2
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	HLS2 NML 2
	Goto Ready2
  }
}

Actor HellStaffBall1 : CacoHellStaffBall1
{
  Damage 8
  DamageType "Player"
  Species "Player"
  +THRUSPECIES
  States
  {
  Death:
	TNT1 A 0 A_Explode(20,48)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
    CLBA B 1 Bright A_FadeOut(0.2)
    Goto Death+2
  }
}

Actor HellStaffBall2 : CacoHellStaffBall2
{
  Damage 8
  DamageType "Player"
  Species "Player"
  +THRUSPECIES
  States
  {
  Death:
	TNT1 A 0 A_Explode(20,48)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
    CLBA B 1 Bright A_FadeOut(0.2)
    Goto Death+2
  XDeath:
	TNT1 A 0 A_Explode(20,48)
	TNT1 A 0 A_GiveToTarget("HellStaffLifeLeech",1)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
    CLBA B 1 Bright A_FadeOut(0.2)
    Goto XDeath+2
  }
}

Actor HellStaffLifeLeech : FakeHealthBonus
{
  +NOTIMEFREEZE
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.Amount 5
  Inventory.MaxAmount 200
}