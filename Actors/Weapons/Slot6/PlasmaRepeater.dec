Actor PlasmaRepeaterGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "PlasmaRepeater/Pickup"
  Inventory.PickupMessage "$CFPlasmaRepeaterPickup"
  Tag "$CFPlasmaRepeater"
  States
  {
  Spawn:
    REPP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	REPP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",31,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("PlasmaRepeater",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,512)
	TNT1 A 0 A_GiveInventory("PlasmaRepeater",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",77)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor PlasmaRepeaterSpawnerGiver : PlasmaRepeaterGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PlasmaRepeater",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,512)
	TNT1 A 0 A_GiveInventory("PlasmaRepeater",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",77)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("PlasmaRepeaterGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("PlasmaRepeaterGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor PlasmaRepeaterGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor PlasmaRepeater : Weapon 17602
{
  //$Category Weapons/CF
  //$Sprite REPPA0
  //$Title "Plasma Repeater"
  Weapon.UpSound "PlasmaRepeater/Draw"
  Weapon.AmmoType1 "NewCell"
  Weapon.AmmoType2 "NewCell"
  Weapon.AmmoUse1 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 4.0
  //Weapon.MinSelectionAmmo1 1
  Weapon.SelectionOrder 2000
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Inventory.PickupSound "PlasmaRepeater/Pickup"
  Inventory.PickupMessage "$CFPlasmaRepeaterPickup"
  Obituary "$CFPlasmaRepeaterObit"
  Tag "$CFPlasmaRepeater"
  Weapon.PreferredSkin "PlasmaRepeaterMarine"
  +WEAPON.EXPLOSIVE
  States
  {
  Spawn:
    REPP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	REPP A -1
    Stop
  Ready:
    TNT1 A 0 A_TakeInventory("RepeaterSpin", 3)
    TNT1 A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG A 1 A_WeaponReady
    Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    TNT1 A 0 A_TakeInventory("RepeaterSpin", 3)
    TNT1 A 0 A_GiveInventory("RepeaterFrameA", 1)
  DeslectLoop:
	TNT1 A 0 A_Lower
    REPG A 1 A_Lower
    Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("DustLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("PlasmaRepeater",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    REPG A 1 A_Raise
    Loop
  Fire:
    //===========Spinup
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
    REPG A 0 A_PlaySound("PlasmaRepeater/Spin",CHAN_WEAPON )
    REPG A 0 A_JumpIfInventory("RepeaterSpin", 1, 8)
    REPG A 0 A_JumpIfInventory("RepeaterB", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterC", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterD", 1, 4)
    REPG ABC 4
    REPG D 4 A_GiveInventory("RepeaterFrameA")
    REPG A 0 A_JumpIfInventory("RepeaterSpin", 2, 9)
    REPG A 0 A_GiveInventory("RepeaterSpin", 1)
    REPG A 0 A_JumpIfInventory("RepeaterB", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterC", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterD", 1, 4)
    REPG ABC 3
    REPG D 3 A_GiveInventory("RepeaterFrameA")
    REPG A 0 A_JumpIfInventory("RepeaterB", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterC", 1, 4)
    REPG A 0 A_JumpIfInventory("RepeaterD", 1, 4)
    REPG ABC 2
    REPG D 2 A_GiveInventory("RepeaterFrameA")
    //===========Fire
    REPG A 0 A_Refire
    //===========Spindown
    REPG A 0 A_PlaySound("PlasmaRepeater/Down",CHAN_WEAPON )
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DD 1 A_WeaponReady(11)
    REPG A 0 A_TakeInventory("RepeaterSpin", 1)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDD 1 A_WeaponReady(11)
    REPG A 0 A_TakeInventory("RepeaterSpin", 1)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDDD 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDDD 1 A_WeaponReady(11)
    Goto Ready
  Hold:
    //===========Fire
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HoldSpread")
	REPG E 0 A_Gunflash
    REPG E 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("OverseerPlasma/fire",CHAN_WEAPON )
    REPG E 1 Bright A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-5,5),1,0,-8)
    REPG F 1 Bright A_JumpIfNoAmmo("Ready")
    REPG G 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("OverseerPlasma/fire",CHAN_WEAPON )
    REPG G 1 Bright A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-5,5),1,0,-8)
    REPG H 1 Bright A_JumpIfNoAmmo("Ready")
    REPG A 0 A_Refire
	Goto Spindown
  HoldSpread:
    //===========Fire
    REPG E 0 A_Gunflash
    REPG E 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("OverseerPlasma/fire",CHAN_WEAPON )
    REPG E 1 Bright A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6),1,0,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6)+15.0,0,0,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6)-15,0,0,0,-8)
    REPG F 1 Bright
    REPG G 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("OverseerPlasma/fire",CHAN_WEAPON )
    REPG G 1 Bright A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6),1,0,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6)+15.0,0,0,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerRepeaterPlasma",frandom(-6,6)-15,0,0,0,-8)
    REPG H 1 Bright
    REPG A 0 A_Refire
  SpinDown:
	//===========Spindown
    REPG A 0 A_PlaySound("PlasmaRepeater/Down",CHAN_WEAPON )
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DD 1 A_WeaponReady(11)
    REPG A 0 A_TakeInventory("RepeaterSpin", 1)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDD 1 A_WeaponReady(11)
    REPG A 0 A_TakeInventory("RepeaterSpin", 1)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDDD 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameA", 1)
    REPG AAAA 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameB", 1)
    REPG BBBB 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameC", 1)
    REPG CCCC 1 A_WeaponReady(11)
    REPG A 0 A_GiveInventory("RepeaterFrameD", 1)
    REPG DDDD 1 A_WeaponReady(11)
    Goto Ready
  Flash:
    TNT1 A 2 A_Light2
    TNT1 A 2 A_Light1
    TNT1 A 0 A_Light0
    Stop
  }
}

Actor RepeaterSpin : Inventory { Inventory.MaxAmount 2 }
Actor RepeaterB : Inventory {}
Actor RepeaterC : Inventory {}
Actor RepeaterD : Inventory {}

Actor RepeaterFrameA : CustomInventory
{
  Inventory.MaxAmount 0
  +INVENTORY.AUTOACTIVATE
  States
  {
  Spawn:
    TNT1 A 1
    Stop
  Use:
    TNT1 A 0 A_TakeInventory("RepeaterB", 1)
    TNT1 A 0 A_TakeInventory("RepeaterC", 1)
    TNT1 A 0 A_TakeInventory("RepeaterD", 1)
    Stop
  }
}

Actor RepeaterFrameB : RepeaterFrameA
{
  States
  {
  Spawn:
    TNT1 A 1
    Stop
  Use:
    TNT1 A 0 A_GiveInventory("RepeaterB", 1)
    TNT1 A 0 A_TakeInventory("RepeaterC", 1)
    TNT1 A 0 A_TakeInventory("RepeaterD", 1)
    Stop
  }
}

Actor RepeaterFrameC : RepeaterFrameA
{
  States
  {
  Spawn:
    TNT1 A 1
    Stop
  Use:
    TNT1 A 0 A_TakeInventory("RepeaterB", 1)
    TNT1 A 0 A_GiveInventory("RepeaterC", 1)
    TNT1 A 0 A_TakeInventory("RepeaterD", 1)
    Stop
  }
}

Actor RepeaterFrameD : RepeaterFrameA
{
  States
  {
  Spawn:
    TNT1 A 1
    Stop
  Use:
    TNT1 A 0 A_TakeInventory("RepeaterB", 1)
    TNT1 A 0 A_TakeInventory("RepeaterC", 1)
    TNT1 A 0 A_GiveInventory("RepeaterD", 1)
    Stop
  }
}



Actor PlayerRepeaterPlasma : OverseerPlasma
{
  Damage (Random(24,48))  //8
  +THRUSPECIES
  Species "Player"
  DamageType "Player"
  SeeSound ""
  DeathSound "OverseerPlasma/explode"
  States
  {
  Death:
	TNT1 A 0 A_Explode(32,80)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	OVPL HIJ 3 Bright
	Stop
  }
}