Actor LegendaryPlasmaticRifleGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryPlasmaticPickup"
  Inventory.PickupSound "weapons/legup"
  Tag "$CFLegendaryPlasmatic"
  States
  {
  Spawn:
    BTEP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
    TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	BTEP A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",59,28,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticRifle",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",75)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonMagazine",Random(25,50))
	TNT1 A 0 A_GiveInventory("LDemonAmmo",30)
	Stop
  }
}

Actor LegendaryPlasmaticRifleSpawnerGiver : LegendaryPlasmaticRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",75)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonMagazine",Random(25,50))
	TNT1 A 0 A_GiveInventory("LDemonAmmo",30)
	Stop
  }
}

Actor LegendaryPlasmaticRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryPlasmaticRifle : Weapon
{
  Height 14
  Scale 0.95
  Weapon.PreferredSkin "LegendaryRifle-Marine"
  Weapon.KickBack 60
  Weapon.AmmoUse 2
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 11.0
  Weapon.SelectionOrder 900
  Weapon.AmmoType "LDemonMagazine"   
  Weapon.AmmoType2 "LDemonAmmo"
  //Weapon.MinSelectionAmmo1 2
  //Weapon.MinSelectionAmmo2 1
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Inventory.PickupMessage "$CFLegendaryPlasmaticRiflePickup"
  Inventory.PickupSound "weapons/legup"
  Obituary "$CFLegendaryPlasmaticRifleObit"
  Tag "$CFLegendaryPlasmaticRifle"
  States
  {
  Spawn:
    BTEP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,1)
	BTEP A -1
    Stop
  Ready:
    TNT1 A 0 A_PlaySound("weapons/legup")
	BTRS ABCDE 1
  ReadyLoop:
    TNT1 A 0 A_JumpIfInventory("LDemonMagazine",1,2)
	TNT1 A 0
	Goto NoBuzzing
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)	 
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK AAA 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_PlaySound("weapons/legrifidle")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK BB 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK CC 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK DD 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	BTEK EE 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  NoBuzzing:
    TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    BTEK A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Deselect:
    TNT1 A 0 A_PlaySound ("D_LEGND",5,5.0,1,ATTN_NONE)
    TNT1 A 0 ACS_NamedExecuteAlways("StopWeaponMusic",0)
  DeselectLoop:
	BTEK A 1 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryPlasmaticRifle",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_JumpIfInventory("WeaponMusic",1,2)
    TNT1 A 0 ACS_NamedExecuteAlways("StartLegRifleMusic",0,ACS_NamedExecuteWithResult("GetPlayerNumber"))
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    BTKF A 1 Bright A_FireCustomMissile("PlayerLegendaryProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	BTKF B 1 Bright A_Light2
    BTKF C 2 Bright A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("WeaponMusic",1,2)
    TNT1 A 0 ACS_NamedExecuteAlways("StartLegRifleMusic",0,ACS_NamedExecuteWithResult("GetPlayerNumber"))
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
    TNT1 A 0 A_Light1
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    BTKF A 1 Bright A_FireCustomMissile("PlayerLegendaryProjectile",frandom(-1.0,1.0),1,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("PlayerLegendaryProjectile",frandom(-1.0,1.0)+15.0,0,0,0,0,frandom(-1.0,1.0))
	TNT1 A 0 A_FireCustomMissile("PlayerLegendaryProjectile",frandom(-1.0,1.0)-15.0,0,0,0,0,frandom(-1.0,1.0))
	BTKF B 1 Bright A_Light2
    BTKF C 2 Bright A_Light0
    TNT1 A 0 A_ReFire
    Goto ReadyLoop
  Empty:
     BTEK A 10 A_PlaySound("weapons/click2")	 
  Reload:
    TNT1 A 0 A_JumpIfInventory("LDemonMagazine",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto ReadyLoop
    BTKR AB 2
	BTKR C 3
	BTKR D 4 A_PlaySound("weapons/demontecheject")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	BTKR E 2 A_PlaySound("weapons/demontechsteam")
	BTKR F 2 Radius_Quake(2,2,0,1,0)
	BTKR GHI 2 Radius_Quake(2,2,0,1,0)
	BTKR J 3 A_FireCustomMissile("LDemonTechEmptyMag", 0, 0, 0, 1)
	BTKR K 15 
	BTKR LMN 2
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,"ActualReload")	 
    BTKR O 6 A_PlayWeaponSound("weapons/demontechload")
    BTKR O 4 A_PlayWeaponSound("weapons/demontechclick")
    BTKR CB 3
	BTKR A 2
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("LDemonAmmo",1)
	TNT1 A 0 A_GiveInventory("LDemonMagazine",1)
	TNT1 A 0 A_JumpIfInventory("LDemonMagazine",50,"Full")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,"ActualReload")
	Goto Reload+19
  Full:
    TNT1 A 0
	Goto Reload+19
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
   TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	BTRS EDCBA 1
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN K 1
	HGRN LMNO 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
   TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	BTRS EDCBA 1
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1 
  }
}

Actor LDemonMagazine : Ammo 
{
  Inventory.Amount 0
  Inventory.MaxAmount 50
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 50
  Inventory.Icon "BTEPA0"
  +IGNORESKILL
}

Actor LDemonAmmoPickup : LegendaryShellPickup
{
  Scale 0.65
  Inventory.PickupMessage "$CFLDemonAmmoPickup"
  Inventory.PickupSound "items/legendaryammo"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	BAMG A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",16,50)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",16) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor LDemonAmmo : Ammo //16806
{
  //$Category Ammunition/LCA
  //$Sprite BAMGA0
  //$Title "Legendary Demon Ammo"
  Scale 0.65
  Inventory.PickupMessage "$CFLDemonAmmoPickup"
  Inventory.PickupSound "items/legendaryammo"
  Inventory.Amount 50
  Inventory.MaxAmount 250
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 500
  Inventory.Icon "BAMGA0"
  +NOTIMEFREEZE
 States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	BAMG A -1
    Stop
  }
}

Actor LDemonAmmoBoxPickup : LegendaryShellPickup
{
  Scale 0.65
  +NEVERRESPAWN
  +INVENTORY.NEVERRESPAWN
  +DROPPED
  Inventory.PickupMessage "$CFLDemonAmmoBoxPickup"
  Inventory.PickupSound "items/legendaryammopack"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	BAMO ABCDDCB 7
    Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",16,100)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",16) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor LDemonAmmoBox : LDemonAmmo //16807
{
  //$Category Ammunition/LCA
  //$Sprite BAMOA0
  //$Title "Legendary Box of Demon Ammo"
  Scale 0.65
  Inventory.Amount 100
  Inventory.PickupMessage "$CFLDemonAmmoBoxPickup"
  Inventory.PickupSound "items/legendaryammopack"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	BAMO ABCDDCB 7
    Loop
  }
}

Actor LDemonTechEmptyMag : BulletCasing
{
  Scale 0.4
  SeeSound "weapons/emptydrum"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	LDTM ABCD 3  
	Loop
  Death:
    TNT1 A 0 A_Jump(128,3)
    LDTM A 100
    LDTM A 5 A_FadeOut(0.10)
    Goto Death+2
    LDTM C 100
	LDTM C 5 A_FadeOut(0.10)
	Goto Death+4  
  }
}

Actor LegendaryRifleShot
{
  Height 3
  Radius 3
  Speed 60
  DamageType "PlayerLegendary" 
  Damage (Random(100,250))
  Scale 0.5
  RenderStyle Add
  Alpha 0.95
  Projectile
  +THRUSPECIES
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Species ""
  DeathSound "weapons/demontechex"
  Decal "DoomImpScorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
  Normal:
    BTPR ABCDEF 1 Bright A_SpawnItemEx("LDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Spawn2:
    BTPR ABCDEF 1 Bright A_SpawnItemEx("LDemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop	  
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegendaryADemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Explode(20,64)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  DeathSFX:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegendaryADemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
  Vanilla:
	TNT1 A 1
    Stop
  }
}

Actor WeaponMusic : Inventory {}