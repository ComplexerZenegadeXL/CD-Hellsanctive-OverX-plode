Actor CFFreeze : CustomInventory
{
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  -INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  States
  {
  Pickup:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckActorMonster") != 1,"Nop")
	TNT1 A 1 ACS_NamedExecuteAlways("CF_Freeze",0)
	Stop
  Nop:
	TNT1 A 1
	Stop
  }
}