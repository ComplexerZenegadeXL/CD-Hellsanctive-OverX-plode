Actor IceDebris
{
  Radius 3
  Scale 0.4
  +MISSILE
  +CLIENTSIDEONLY
  +DOOMBOUNCE
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +DROPOFF
  BounceCount 3
  BounceFactor 0.4
  WallBounceFactor 0.3
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	ICEC AB 2
	Loop
  Death:
	TNT1 A 0 A_Jump(128,3)
	ICEC C 50
  DeathLoop1:
	ICEC C 5 A_FadeOut(0.10)
	Loop
	ICEC D 50
  DeathLoop2:
	ICEC D 5 A_FadeOut(0.10)
	Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

