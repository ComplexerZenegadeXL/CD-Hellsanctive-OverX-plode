  Obituary "$CFFlameShotObit" //Obituary "$OB_MPFLAMETHROWER"
  DamageType "Ice"
  States
  {
  Spawn:
	TNT1 A 0 // A_PlaySound("weapons/flamehit")
	TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,frandom(-1,1)+velx,frandom(-1,1)+vely,frandom(-1,1)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,frandom(-2,2)+velx,frandom(-2,2)+vely,frandom(-2,2)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
