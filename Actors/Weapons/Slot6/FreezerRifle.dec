Actor FreezerRifleGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFFreezerRiflePickup"
  Inventory.PickupSound "freeze/pickup"
  Tag "$CFFreezerRifle"
  States
  {
  Spawn:
	RIPG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	RIPG A -1 
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",52,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("FreezerRifle",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("FreezerRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",72)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor FreezerRifleSpawnerGiver : FreezerRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("FreezerRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("FreezerRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",72)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("FreezerRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("FreezerRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor FreezerRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor FreezerRifle : DoomWeapon //16652
{
  //$Category Weapons/LCA
  //$Sprite RIPGA0
  //$Title "FreezerRifle"
  Scale 0.8
  SpawnID 30
  Weapon.PreferredSkin "Ionspray-Marine"
  Weapon.SelectionOrder 110
  Weapon.AmmoUse 1
  Weapon.AmmoUse2 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 6
  Weapon.SlotPriority 2.0
  Weapon.AmmoType "NewCell"
  Weapon.AmmoType2 "NewCell"
  Weapon.UpSound "freeze/up"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Inventory.PickupMessage "$CFFreezerRiflePickup"
  Inventory.PickupSound "freeze/pickup"
  Obituary "$CFFreezerRifleObit"
  Tag "$CFFreezerRifle"
  States
  {
  Spawn:
	RIPG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",6,0)
	RIPG A -1 
	Stop
  Ready:
    RIPE A 0 A_StopSound(CHAN_WEAPON)
    RIPR ABCD 4 A_WeaponReady
    Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	RIPR A 1 A_Lower
	Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("FreezerRifle",1)
	//Stop
  SelectLoop:
	RIPR A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlaySound("weapons/iceshot",1)
	//TNT1 A 0 A_FireCustomMissile("FreezeBlast2",0.0,0)
	RIPE A 2 A_FireCustomMissile("FreezeBlast",0.0)
	RIPE BC 2
	TNT1 D 0 A_PlaySound("weapons/chill",5,1.0)
	RIPE EFGHI 6 A_Refire
	Goto Ready
  FireSpread:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlaySound("weapons/iceshot",1)
	RIPE A 2 A_FireCustomMissile("FreezeBlast",0.0,0)
	TNT1 A 0 A_FireCustomMissile("FreezeBlast",15.0,0)
	TNT1 A 0 A_FireCustomMissile("FreezeBlast",-15.0,0)
	TNT1 A 0 A_FireCustomMissile("FreezeBlast2",0.0,0)
	TNT1 A 0 A_FireCustomMissile("FreezeBlast2",15.0,0)
	TNT1 A 0 A_FireCustomMissile("FreezeBlast2",-15.0,0)
	RIPE BC 2
	TNT1 A 0 A_PlaySound("weapons/chill",5,1.0)
	RIPE EFGHI 6 A_Refire
	Goto Ready
  AltFire: 
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	RIPE A 0 A_StopSound(CHAN_WEAPON)
    RIPE A 0 A_PlaySound ("freeze/altfire",6)
	RIPE A 2 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),1,0,0,0,frandom(-0.5,0.5))
    RIPE A 0 A_PlaySound("freeze/althold",CHAN_WEAPON,1.0,True)
	Goto AltHold
  AltHold:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltHoldSpread")
	RIPE C 1 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),1,0,0,0,frandom(-0.5,0.5))
	RIPE DE 1 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	RIPE A 0 A_Refire
    RIPE A 0 A_StopSound(CHAN_WEAPON)
	RIPE A 0 A_PlaySound("freeze/altstop",CHAN_WEAPON)
	RIPE EFGHI 5 A_WeaponReady
	Goto Ready
  AltFireSpread:
	TNT1 A 0 A_AlertMonsters
	RIPE A 0 A_StopSound(CHAN_WEAPON)
    RIPE A 0 A_PlaySound ("freeze/altfire",6)
	RIPE A 2 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),1,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)+15.0,0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)-15.0,0,0,0,0,frandom(-0.5,0.5))
    RIPE A 0 A_PlaySound("freeze/althold",CHAN_WEAPON,1.0,True)
	Goto AltHoldSpread
  AltHoldSpread:
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_AlertMonsters
	RIPE C 1 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),1,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)+15.0,1,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)-15.0,1,0,0,0,frandom(-0.5,0.5))
	RIPE D 1 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)+15.0,0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)-15.0,0,0,0,0,frandom(-0.5,0.5))
	RIPE E 1 Bright A_FireCustomMissile("FlameShotPlayer",frandom(-1,1),0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)+15.0,0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_FireCustomMissile("FlameShotPlayer",frandom(-1,1)-15.0,0,0,0,0,frandom(-0.5,0.5))
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	RIPE A 0 A_Refire
    RIPE A 0 A_StopSound(CHAN_WEAPON)
	RIPE A 0 A_PlaySound("freeze/altstop",CHAN_WEAPON)
	RIPE EFGHI 5 A_WeaponReady
	Goto Ready
  "Empty":
    RIPE A 0 A_StopSound(CHAN_WEAPON)
	RIPE EFGHI 5 A_WeaponReady
	Goto Ready
  Flash:
    RIPE A 3 Bright A_Light1
    Goto LightDone
    RIPE B 3 Bright A_Light1
    Goto LightDone
  Spawn:
    RIPG A -1
    Stop
  }
}

Actor FreezeBlast
{
  Projectile
  +RANDOMIZE
  +THRUSPECIES
  Species "Player"
  Radius 4
  Height 8
  Speed 55
  Damage (Random(30,50)) //12
  RenderStyle Add
  Alpha 0.75
  SeeSound "weapons/iceshot2"
  DeathSound "weapons/icehit2"
  DamageType "PlayerIce"
  States 
  {
  Spawn:
	TNT1 A 0 A_SpawnItemEx("ICBTrail",frandom(-2,2),frandom(-2,2),frandom(-2,2))
	ISHR A 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_SpawnItemEx("ICBTrail",frandom(-2,2),frandom(-2,2),frandom(-2,2))
	ISHR B 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2))
	Loop
  Death:
	TNT1 A 0 A_SetScale(1.5)
	TNT1 A 0 A_SetTranslucent(1.0,1)
	TNT1 AAA 0 A_CustomMissile("Kaboom6F", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6F", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SHEX ABCDE 4 Bright
	Stop
  }
}

Actor FreezeBlast2 : FreezeBlast 
{
  Damage 1
  DamageType "PlayerIce"
  States
  {
  Spawn:
    TNT1 A 1
	Loop
  Death:
	TNT1 A 1
	Stop
  }
}

