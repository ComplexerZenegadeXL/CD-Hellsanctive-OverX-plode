Actor FreezeBlastTrail
{
  Projectile
  Radius 13
  Height 8
  Speed 20
  Damage (0)
  +RANDOMIZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  RenderStyle Add
  Alpha 0.75
  SeeSound "weapons/iceshot"
  DeathSound "weapons/icehit"
  Obituary "$CFFreezeBlastTrailObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
  Fade:
	FRTR ABC 6 Bright A_FadeOut(0.2,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop		
  }
}

Actor RocketFire
{
  Height 2
  Radius 2
  Speed 3
  Scale 0.75
  RenderStyle Add
  Alpha 0.9
  -NOCLIP
  +RIPPER
  +NOGRAVITY
  +DONTSPLASH
  +NOTELEPORT
  +NOBLOCKMAP
  +CANNOTPUSH
  -BLOODSPLATTER
  -ACTIVATEPCROSS
  -ACTIVATEIMPACT
  +BLOODLESSIMPACT
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  //+NOINTERACTION
  States
  {
  Spawn:
	TNT1 A random(3,6)
	TNT1 AA 0 A_Jump(256,"Spawn1","Spawn2","Spawn3")
	Goto Spawn1
  Spawn1:
	64P1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
	Stop
  Spawn2:
	64P2 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
	Stop
  Spawn3:
	64P3 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright
	Stop
  }
}


