Actor Kaboom6F : Kaboom6
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BXPO AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor ICBTrail
{
  Radius 8
  Height 16
  Scale 0.30
  RenderStyle Add
  Alpha 0.67
  Projectile
  +CLIENTSIDEONLY
  +RANDOMIZE
  States
  {
  Spawn:
  	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    PLSS JKLMNOPQRSTUVWXYZ 2 Bright A_FadeOut
    Goto Death
  Death:
    TNT1 A 0 A_SpawnItemEx("IceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("IceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("IceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    PLSS JKLMNOPQRSTUVWXYZ 2 Bright A_FadeOut(0.05)
    Goto Death+3
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor IceSparkle
{
  RenderStyle Translucent
  Alpha 0.5
  Radius 0
  Height 0
  +NOGRAVITY
  +NOBLOCKMAP
  +NOLIFTDROP
  +NOTARGET
  +DONTSQUASH
  +NOTELEOTHER
  +NONSHOOTABLE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    ICE2 A 0
    ICE2 ABC 4 A_FadeOut(0.10)
    Goto Spawn+1
  }
}
