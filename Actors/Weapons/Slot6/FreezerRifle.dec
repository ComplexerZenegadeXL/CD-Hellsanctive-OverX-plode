	TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,frandom(-3,3)+velx,frandom(-3,3)+vely,frandom(-3,3)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,frandom(-3,3)+velx,frandom(-3,3)+vely,frandom(-3,3)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,frandom(-4,4)+velx,frandom(-4,4)+vely,frandom(-4,4)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	
	//TNT1 AAAA 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	//TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	//TNT1 A 0 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	//TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	//TNT1 A 0 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	//TNT1 A 1 A_SpawnItemEx("FlameStreamTrail",0,0,0,velx,vely,velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM,32)
	TNT1 A 18
	Stop
  Death:
	TNT1 A 1 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	Stop
  }
}

