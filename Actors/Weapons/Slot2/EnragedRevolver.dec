Actor EnragedLegendaryRevolverGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFEnragedRevolverPickup"
  Inventory.PickupSound "revspin"
  Tag "$CFEnragedRevolver"
  States
  {
  Spawn:
	ERVI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",2,0)
	ERVI A -1
	Stop
  Pickup:
	TNT1 A 0 A_Jumpif(ACS_NamedExecuteWithResult("DualRevolverCheck",1)==2,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor EnragedLegendaryRevolver : DoomWeapon
{
  //$Category Weapons/LCA/DJB
  //$Sprite ERVIA0
  //$Title "Enraged Legendary Revolver"
  Tag "$CFEnragedRevolver"
  Scale 0.8
  Weapon.PreferredSkin "LegendaryRevolver-Marine"
  Weapon.SelectionOrder 19
  Weapon.KickBack 160
  Inventory.PickupSound "revspin"
  Weapon.SelectionOrder 8000
  Weapon.SlotNumber 2
  Weapon.SlotPriority 5.0
  Weapon.AmmoGive1 0
  Weapon.AmmoGive2 0
  Weapon.AmmoUse 1
  Weapon.AmmoType "ILegendaryRevolverSpinner"
  Weapon.AmmoType2 "ELegendaryLMGBulletMag"
  Inventory.PickupMessage "$CFEnragedRevolverPickup"
  Obituary "$CFEnragedLegendaryRevolverObit" 
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States 
  { 
  Spawn: 
	ERVI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",2,0)
	ERVI A -1 
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",5,2,0)
	TNT1 A -1
	Stop
  Select:
	ERSU A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	ERVL E 1 A_Lower
	Goto Deselect+1
  Ready:
	ERSU AB 2
	ERSU C 2 A_PlaySound("REVCLOSE")
	ERSU D 2
	TNT1 A 0 A_PlayWeaponSound("revspin")
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	ERVL E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)	  	
	TNT1 A 0 A_FireCustomMissile("BlueSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"ELLMGPuff",FBF_NORANDOM)
	TNT1 A 0 A_TakeInventory("ILegendaryRevolverSpinner",1,TIF_NOTAKEINFINITE)
	ERVL F 2 Bright A_Light2 
	ERVL F 1 Bright A_Light1  
	TNT1 A 0 A_Light0 
	ERVL GH 2
	Goto Ready2
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)	  	
	TNT1 A 0 A_FireCustomMissile("BlueSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",-150,0,random(80,100))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",+150,0,random(80,100))
	ERVL F 2 Bright A_Light2 
	ERVL F 1 Bright A_Light1  
	TNT1 A 0 A_Light0 
	ERVL GH 2
	Goto Ready2
  Empty:
	ERVL E 1 A_PlayWeaponSound("weapons/click")
  Reload:
	TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner",6,2)
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,2)
	TNT1 A 0
	Goto Ready2
	ERVL E 6
	ERVL IJKL 2 
	ERVL M 2 A_PlaySound("REVOPEN")
	ERVL N 2 A_PlaySound("REVEJECT")
	ERVL NNNNNN 0 A_SpawnItemEx("ELegBulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	ERVL N 10 
	ERVL OPQR 2
	ERVL S 5
	ERVL T 5 A_PlaySound("REVINSR")
	ERVL UV 5
	ERVL W 5 A_PlaySound("REVCLOSE")
	ERVL X 5
	ERVL E 1 A_PlayWeaponSound("revspin")
  RealReload:
	TNT1 A 0 A_TakeInventory("ELegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("ILegendaryRevolverSpinner",1)
	TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner", 6,2)
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"RealReload")
	ERVL E 1
	Goto Ready2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready2
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	ERSU FGH 2
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN KLM 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	ERSU HGF 2
	Goto Ready2
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready2
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	ERSU FGH 2
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1) 
	ERSU HGF 2
	Goto Ready2 
  }
}

Actor ILegendaryRevolverSpinner : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 6
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 6
  Inventory.Icon "ERVIA0"
  +IGNORESKILL
}

Actor ELegBulletCasing: LegBulletCasing
{
 States
 {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(CallACS("CheckVanilla") == 1, "Toaster")
	ECAS ABCDEFGH 2
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,3)
	ECAS C 100
	ECAS C 5 A_FadeOut(0.10)
	Goto Death+3
	ECAS G 100
	ECAS G 5 A_FadeOut(0.10)
	Goto Death+5
  Toaster:
	TNT1 A 0
	Stop
  }
}
