Actor HandgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFHandgunPickup"
  Tag "$CFHandgun"
  States
  {
  Spawn:
	23PT A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	23PT A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("Handgun",1,3)
	TNT1 A 0 A_GiveInventory("Handgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",26)
	TNT1 A 0 A_GiveInventory("PistolMagazine",Random(7,15))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor Handgun : DoomWeapon replaces Pistol
{
  Scale 0.6
  +NOAUTOFIRE
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  +INVENTORY.UNDROPPABLE
  Weapon.PreferredSkin "Handgun-Marine"
  Weapon.SelectionOrder 8000
  Weapon.SlotNumber 2
  Weapon.SlotPriority 1.0
  Weapon.KickBack 60
  Inventory.PickupSound "weapons/pickuptp"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 1
  Weapon.AmmoType "PistolMagazine"
  Weapon.AmmoType2 "BulletMag"
  //Weapon.MinSelectionAmmo1 1
  Inventory.PickupMessage "$CFHandgunPickup"
  Tag "$CFHandgun"
  Obituary "$CFHandgunObit" 
  States
  {
  Spawn:
	23PT A -1
	Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickuptp")
	PIST ABCD 1
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",1,"Ready2")
	Goto Ready3
  Ready2:
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",1,1)
	Goto Ready3
	PKPI A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Ready3:
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",1,"Ready2")
	PKPE E 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	PKPI A 1 A_Lower
	TNT1 A 0 A_Lower
	Goto Deselect+1
  Select:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlayWeaponSound("weapons/tpfire")  //"weapons/tpfire"
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireBullets(1.2,1.2,-1,Random(12,25),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	PKPF A 2 Bright A_GunFlash
	TNT1 A 0 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	PKPI B 1
	TNT1 A 0 A_JumpIfNoAmmo("EmptyRecoil")
	PKPI C 2
	PKPI DE 2
	PKPI F 2 A_WeaponReady
	PKPI A 1
	Goto Ready2
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlayWeaponSound("weapons/tpfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireBullets(1.2,1.2,-1,Random(12,25),"PlayerModdedBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-12,12)-150,random(-12,12),random(12,25))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-12,12)+150,random(-12,12),random(12,25))
	PKPF A 2 Bright A_GunFlash
	TNT1 A 0 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	PKPI B 1
	TNT1 A 0 A_JumpIfNoAmmo("EmptyRecoil")
	PKPI C 2
	PKPI DE 2
	PKPI F 2 A_WeaponReady
	PKPI A 1
	Goto Ready2
  Flash:
	TNT1 A 1 Bright A_Light2
	TNT1 A 1 Bright A_Light1
	TNT1 A 0 A_Light0
	Stop
  EmptyRecoil:
	PKPE ABCD 2
	PKPE E 1
	Goto Ready3
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	PKPE EEEEEEEEEE 1 A_WeaponReady(WRF_NOFIRE)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload")
	Goto Ready3
  Reload:
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",0,"Ready2")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,2)
	TNT1 A 0
	Goto Ready3
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",1,"MaxReload")
	PKPR A 1 A_PlaySound("weapons/pistolclipout",CHAN_6)
	PKPR BC 1
	PKPR D 2
	PKPR E 2 A_FireCustomMissile("PistolEmptyMagSpawner",0,0,0,1)
	PKPR F 5
	PKPR GHI 2
	PKPR J 2 A_PlaySound("weapons/pistolclipin",CHAN_6)
	PKPR K 2
	PKPR L 2 A_PlaySound("weapons/pistolsnap",CHAN_6)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"NormalReload")
  NormalReload:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("PistolMagazine",1)
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",15,"Full")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"NormalReload")
	Goto Full
  MaxReload:
	PKR2 A 1 A_PlaySound("weapons/pistolclipout",CHAN_6)
	PKR2 BC 1
	PKR2 D 2
	PKR2 E 2 A_FireCustomMissile("PistolEmptyMagSpawner",0,0,0,1)
	PKR2 F 5
	PKR2 GHI 2
	PKR2 J 2 A_PlaySound("weapons/pistolclipin")
	PKR2 KL 2
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload2")
  Reload2:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("PistolMagazine",1)
	TNT1 A 0 A_JumpIfInventory("PistolMagazine",16,"Full")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload2")
  Full:
	PKPR MNOPQ 1
	Goto Ready2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+5
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	PIST DCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+5
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	PIST DCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor PistolMagazine : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 16
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 16
  Inventory.Icon "HPISA0"
  +IGNORESKILL
}