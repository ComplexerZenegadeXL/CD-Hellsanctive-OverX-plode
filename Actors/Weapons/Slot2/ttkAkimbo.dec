actor CFPackAPunch: Inventory {}

Actor ttkAkimbo : Weapon
{
  //$Category Weapons/LCA/DJB
  //$Sprite AKIMA0
  //$Title "Dual Revolvers"
  Tag "$CFttkAkimbo"
  Scale 0.50
  Weapon.PreferredSkin "LegendaryRevolver-Marine"
  Weapon.SelectionOrder 19
  Weapon.KickBack 160
  Inventory.PickupSound "revspin"
  Weapon.SelectionOrder 8000
  Weapon.SlotNumber 2
  Weapon.SlotPriority 5.1
  Weapon.AmmoGive1 0
  Weapon.AmmoGive2 0
  Weapon.AmmoUse 0
  Weapon.AmmoType "LegendaryRevolverSpinner"
  Weapon.AmmoType2 "ILegendaryRevolverSpinner"
  Inventory.PickupMessage "$CFttkAkimboPickup"
  Obituary "$CFttkAkimboObit" 
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +INVENTORY.UNDROPPABLE
  States
  {
  Spawn:
	AKIM A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
	AKIM A -1
	Loop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret")
	TNT1 A -1
	Stop
  Select:
	LRSU A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LRVL E 1 A_Lower
	Goto Deselect+1
  Ready:
	TNT1 A 0 A_GunFlash("RightReady")
	LRSU AB 2
	LRSU C 2 A_PlaySound("REVCLOSE")
	LRSU D 2
	TNT1 A 0 A_PlayWeaponSound("revspin")
  Ready2:
	LRVL E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
	TNT1 A 0 A_JumpIfInventory("RightRevolverNeedsReload",1,"Reload")
	Loop
  RightReady:
	ERSU AB 2
	ERSU C 2 A_PlaySound("REVCLOSE")
	ERSU D 2
	TNT1 A 0 A_PlayWeaponSound("revspin")
  RightReady2:
	ERVL E 1
	TNT1 A 0 A_JumpIf(CallACS("DualRevolver") == 2,"FireRight") //trust me you need it this way
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("LegendaryRevolverSpinner",1,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"Reload")
	Goto Empty
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)	  	
	TNT1 A 0 A_FireCustomMissile("BlueSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"LegendaryRevBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_TakeInventory("LegendaryRevolverSpinner",1,TIF_NOTAKEINFINITE)
	LRVL F 2 Bright A_Light2 
	LRVL F 1 Bright A_Light1  
	TNT1 A 0 A_Light0 
	LRVL GH 2
	Goto Ready2
  FireRight:
	TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner",1,3)
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,1)
	Goto RightEmpty
	TNT1 A 0 A_GiveInventory("RightRevolverNeedsReload",1)
	Goto RightReady2
	TNT1 A 0 A_GiveInventory("RightRevolverShooting",1)
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("RedSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"ELLMGPuff",FBF_NORANDOM)
	TNT1 A 0 A_TakeInventory("ILegendaryRevolverSpinner",1,TIF_NOTAKEINFINITE)
	ERVL F 2 Bright A_Light2 
	ERVL F 1 Bright A_Light1 
	TNT1 A 0 A_Light0
	ERVL GH 2
	TNT1 G 0 A_TakeInventory("RightRevolverShooting")
	ERVL E 1 A_JumpIf(CallACS("DualRevolver")!=2,"RightReady2") //needed otherwise it acts like A_Refire
	Wait
	TNT1 A 0 //needed to respect the wait
	Goto RightReady2
  Reload:
	TNT1 A 0 A_TakeInventory("RightRevolverNeedsReload")
	TNT1 A 0 A_JumpIfInventory("LegendaryRevolverSpinner",6,"LeftReloadFinish")
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"RightFireWait")
	Goto LeftReloadFinish
  RightFireWait:
	LRVL E 1 
	TNT1 A 0 A_JumpIfInventory("RightRevolverShooting",1,"RightFireWait")
	Goto LeftReload
  LeftReload:
	TNT1 A 0 A_GunFlash("RightLower")
	LRVL E 6
	LRVL IJKL 2 
	LRVL M 2 A_PlaySound("REVOPEN")
	LRVL N 2 A_PlaySound("REVEJECT")
	LRVL NNNNNN 0 A_SpawnItemEx("LegBulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	LRVL N 10 
	LRVL OPQR 2
	LRVL S 5
	LRVL T 5 A_PlaySound("REVINSR")
	LRVL UV 5
	LRVL W 5 A_PlaySound("REVCLOSE")
	LRVL X 5
	LRVL E 1 A_PlayWeaponSound("revspin")
  LeftRealReload:
	TNT1 A 0 A_TakeInventory("LegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("LegendaryRevolverSpinner",1)
	TNT1 A 0 A_JumpIfInventory("LegendaryRevolverSpinner", 6,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"LeftRealReload")
  LeftReloadFinish:
	LRVL E 1
  	TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner",6,"Ready2")
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,2)
	Goto Ready2
  RightFireWait2:
	LRVL E 1  
	TNT1 A 0 A_JumpIfInventory("RightRevolverShooting",1,"RightFireWait2")
	TNT1 A 0 //useless maybe
	TNT1 A 0 A_GunFlash("RightReload")
	LRSU FGH 2 //offsets
	TNT1 A 56 //waiting rightreload
	LRSU HGF 2 //reverse offsets
	Goto Ready2
  RightLower:
	ERSU FGH 2 //offsets
	TNT1 A 56 //59
	ERSU HGF 2 //reverse offsets here in case it needs no reload
	Goto RightReady2
  RightReload:
	ERVL E 6
	ERVL IJKL 2 
	ERVL M 2 A_PlaySound("REVOPEN")
	ERVL N 2 A_PlaySound("REVEJECT")
	ERVL NNNNNN 0 A_SpawnItemEx("ELegBulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	ERVL N 10 
	ERVL OPQR 2
	ERVL S 5
	ERVL T 5 A_PlaySound("REVINSR")
	ERVL UV 5
	ERVL W 5 A_PlaySound("REVCLOSE")
	ERVL X 5 
	TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner",1,"RealRightReload")
	ERVL E 1 A_PlayWeaponSound("revspin")
  RealRightReload:
    TNT1 A 0 A_TakeInventory("ELegendaryLMGBulletMag",1)
    TNT1 A 0 A_GiveInventory("ILegendaryRevolverSpinner",1)
    TNT1 A 0 A_JumpIfInventory("ILegendaryRevolverSpinner", 6,"RightReloadFinish")
    TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"RealRightReload")
  RightReloadFinish:
    ERVL E 1 A_JumpIf(CallACS("DualRevolver") !=2 ,"RightReady2") //needed otherwise it acts like A_Refire
    Wait
    TNT1 A 0 //needed to respect the wait
    Goto RightReady2
  Empty:
	LRVL E 1 A_PlayWeaponSound("weapons/click")
	Goto Ready2
  RightEmpty:
	ERVL E 0 A_PlayWeaponSound("weapons/click")
	ERVL E 1 A_JumpIf(CallACS("DualRevolver") !=2 ,"RightReady2") //needed otherwise it acts like A_Refire
	Wait
	TNT1 A 0 //needed to respect the wait
	Goto RightReady2
 }
}

Actor RightRevolverShooting : Inventory {}

Actor RightRevolverNeedsReload: Inventory {}