Actor Enforcer : DoomWeapon 30397
{
  Scale 0.25
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "Handgun-Marine"
  Weapon.AmmoUse1 1
  Weapon.AmmoUse2 0
  Weapon.AmmoGive1 18
  Weapon.AmmoGive2 0
  Weapon.AmmoType1 "EnforcerClip"
  Weapon.AmmoType2 "BulletMag"
  Weapon.SlotNumber 2
  Weapon.Kickback 75
  Weapon.UpSound "weapons/enforcerup"
  AttackSound "Exterminator/Fire"
  Inventory.PickupSound "misc/w_pkup"
  Inventory.PickupMessage "$CFEnforcerPickup"
  Obituary "$CFEnforcerObit"
  Tag "$CFEnforcer"
  States
  {
  Spawn:
	LIBG X -1
	Stop
  Ready:
	LIBG A 1 A_WeaponReady
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	LIBG A 1 A_Raise
	TNT1 A 0 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	LIBG A 1 A_Lower
	TNT1 A 0 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("DryFire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_FireBullets(2,3,1,random(8,12),"ModdedBulletPuff",FBF_USEAMMO)
	LIBF AB 1 Bright
	LIBG CEDCBA 1
	TNT1 A 0 A_ReFire
	Goto Ready
  Hold:
	TNT1 A 0 A_JumpIfNoAmmo("DryFire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_FireBullets(2,3,1,random(8,12),"ModdedBulletPuff",FBF_USEAMMO)
	LIBF AB 1 Bright
	LIBG CB 1
	TNT1 A 0 A_ReFire("Hold")
	Goto Ready
  Flash:
	TNT1 A 2 A_Light2
	TNT1 A 1 A_Light1
	TNT1 A 0 A_Light0
	Stop
  DryFire:
	LIBG A 12 A_PlaySound("weapons/enforcerdry")
	Goto Reload
  AltFire:
  Reload:
	LIBG A 1
	TNT1 A 0 A_JumpIfInventory("EnforcerClip",18,"Ready")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,1)
	Goto Ready
	TNT1 A 0 A_PlaySound("weapons/enforcerout")
	LIBM ABCDEF 1
	LIBG A 3
	Goto ReloadWorking
  ReloadWorking:
	TNT1 A 0 A_TakeInventory("BulletMag",1)
	TNT1 A 0 A_GiveInventory("EnforcerClip",1)
	TNT1 A 0 A_JumpIfInventory("EnforcerClip",18,2)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,2)
	TNT1 A 0
	Goto ReloadFinish
	TNT1 A 0
	Goto ReloadWorking
  ReloadFinish:
	LIBR ABCDE 2
	TNT1 A 0 A_PlaySound("weapons/enforcerin")
	LIBR FGHIJJ 2
	LIB2 ABCDEFGH 1
	LIBG A 3
	Goto Ready
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LIBD ABCDEF 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	LIBD FEDCBA 1
	Goto Ready
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LIBD ABCDEF 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	LIBD FEDCBA 1
	Goto Ready
  }
}

Actor EnforcerClip : Ammo
{
  +IGNORESKILL
  Inventory.Amount 0
  Inventory.MaxAmount 18
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 18
  Inventory.Icon "LIBGY0"
}