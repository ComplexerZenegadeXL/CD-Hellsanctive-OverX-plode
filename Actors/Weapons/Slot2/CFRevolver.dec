Actor 357RevolverGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CF357RevolverPickup"
  Tag "$CF357Revolver"
  States
  {
  Spawn:
	REVP A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	REVP A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory(".357Revolver",1,3)
	TNT1 A 0 A_GiveInventory(".357Revolver",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",24)
	TNT1 A 0 A_GiveInventory("RevolverSpinner",Random(3,6))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor .357Revolver : DoomWeapon
{
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoType "RevolverSpinner"
  Weapon.AmmoType2 "BulletMag"
  Weapon.AmmoGive2 0
  Weapon.Kickback 45
  Weapon.PreferredSkin "Handgun-Marine"
  Weapon.SlotNumber 2
  Weapon.SlotPriority 4.0
  Weapon.SelectionOrder 8000
  //Weapon.MinSelectionAmmo1 1
  Obituary "$CF357RevolverObit"
  Inventory.PickupMessage "$CF357RevolverPickup"
  Decal "BulletChip"
  Scale 0.5
  Tag "$CF357Revolver"
  +INVENTORY.UNDROPPABLE
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States
  {
  Spawn:
	REVP A -1
	Stop
  Select:
	REVG A 0 A_Raise
	REVG A 1 A_Raise
	Loop
  Deselect:
	REVG A 0 A_Lower
	REVG A 1 A_Lower
	Loop
  Ready:
	REVG A 0 A_JumpIfInventory("BulletMag",1,3)
	REVG A 0 A_JumpIfInventory("RevolverSpinner",1,3)
	REVG A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_DISABLESWITCH|WRF_NOSWITCH)
	Goto Ready3
  Ready2:
	TNT1 A 0 A_JumpIfInventory("RevolverSpinner",1,1)
	Goto Ready3
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	REVG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Ready3:
	TNT1 A 0 A_JumpIfInventory("RevolverSpinner",1,"Ready2")    
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	REVG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	REVG A 0 A_GunFlash
	REVG A 0 A_PlayWeaponSound("Weapons/Revolver")
	TNT1 A 0 A_FireBullets(1.2,1.2,-1,random(27,58),"RevolverPuff",FBF_NORANDOM|FBF_USEAMMO)
	REVG B 2 Bright A_FireCustomMissile("RevolverTracer",frandom(-0.1,0.1),0,0,0,0,0)
	REVG C 1 Offset(0,38) A_SetPitch (pitch - 0.2)
	REVG D 1 Offset(0,44) A_SetPitch (pitch - 0.2)
	REVG D 1 Offset(0,56) A_SetPitch (pitch - 0.2)
	REVG D 1 Offset(0,52) A_AlertMonsters
	REVG C 1 Offset(0,50)
	REVG C 1 Offset(0,47)
	REVG C 1 Offset(0,44)
	REVG A 1 Offset(0,40)
	REVG A 1 Offset(0,36)
	REVG A 1 Offset(0,34)
	REVG A 1 Offset(0,33)
	REVG A 1 Offset(0,32)
	TNT1 A 0 A_WeaponReady
	Goto Ready2
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	REVG A 0 A_GunFlash
	REVG A 0 A_PlayWeaponSound("Weapons/Revolver")
	TNT1 A 0 A_FireBullets(1.2,1.2,-1,random(27,58),"RevolverPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-12,12)-150,random(-12,12),random(27,58))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-12,12)+150,random(-12,12),random(27,58))
	REVG B 2 Bright A_FireCustomMissile("RevolverTracer",frandom(-0.1,0.1),0,0,0,0,0)
	REVG C 1 Offset(0,38) A_SetPitch (pitch - 0.3)
	REVG D 1 Offset(0,44) A_SetPitch (pitch - 0.3)
	REVG D 1 Offset(0,56) A_SetPitch (pitch - 0.3)
	REVG D 1 Offset(0,52) A_AlertMonsters
	REVG C 1 Offset(0,50)
	REVG C 1 Offset(0,47)
	REVG C 1 Offset(0,44)
	REVG A 1 Offset(0,40)
	REVG A 1 Offset(0,36)
	REVG A 1 Offset(0,34)
	REVG A 1 Offset(0,33)
	REVG A 1 Offset(0,32)
	TNT1 A 0 A_WeaponReady
	Goto Ready2
  Flash:
	TNT1 A 1 Bright A_Light2
	TNT1 A 1 Bright A_Light1
	TNT1 A 0 A_Light0
	Stop
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	REVG AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload")
	Goto Ready3
  Reload:
	REVG A 0 A_JumpIfInventory("RevolverSpinner",0,2)
	REVG A 0 A_JumpIfInventory("BulletMag",1,"ProperReload")
	REVG A 1
	Goto Ready
  ProperReload:
	REVG A 1 Offset(0,35) A_PlaysoundEx("weapons/revolverout",SoundSlot6)
	REVG C 1 Offset(0,38)
	REVG C 1 Offset(0,44)
	REVG C 1 Offset(0,52)
	REVG D 1 Offset(0,62)
	REVG D 1 Offset(0,72)
	REVG D 1 Offset(0,82)
	TNT1 A 8
  ReloadLoop:
	TNT1 A 0 A_TakeInventory("BulletMag",1)
	TNT1 A 0 A_GiveInventory("RevolverSpinner",1)
	TNT1 A 0 A_JumpIfInventory("RevolverSpinner",6,"ReloadFinish")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"ReloadLoop")
	Goto ReloadFinish
  ReloadFinish:
	TNT1 A 3
	RHND A 3 Offset(0,32)
	RHND B 3 A_PlaysoundEx("weapons/revolverload",SoundSlot6)
	RHND C 2
	RHND BAD 3
	TNT1 A 4
	REVG D 1 Offset(0,82) A_PlaysoundEx("weapons/revolverin",SoundSlot6)
	REVG D 1 Offset(0,72)
	REVG D 1 Offset(0,62)
	REVG C 1 Offset(0,52)
	REVG C 1 Offset(0,44)
	REVG C 1 Offset(0,38)
	REVG A 1 Offset(0,35)
	REVG A 1 Offset(0,32)
	Goto Ready
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+5
  GrenadeToss:
   TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	REVG DCA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+5
  MineToss:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	REVG DCA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor RevolverSpinner : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 6
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 6
  Inventory.Icon "REVPA0"
  +IGNORESKILL
}

Actor RevolverPuff : ModdedBulletPuff { +MTHRUSPECIES }

Actor EvaTracer : FastProjectile
{
  Alpha 0.90
  RenderStyle Add
  Radius 2
  Height 2
  Speed 75
  Projectile
  +BLOODSPLATTER
  Scale 0.4
  MissileType TracerTrail
  MissileHeight 8
  States
  {
  Spawn:
	PUFF A 1 Bright
	PUFF A 1 Bright A_JumpIfCloser(192,"Whiz") // checksightorrange
	Loop
  Whiz:
	PUFF A 1 Bright A_PlaySound("whiz",1.0,0,ATTN_NONE)
  SpawnNoWhiz:
	PUFF A 1 Bright
	Loop
  Death:
  Crash:
	PUFF B 1 Bright A_SetTranslucent(0.9,0)
	PUFF B 1 Bright A_PlaySound("ricochet")
	PUFF CD 2 Bright
	Stop
  XDeath:
	TNT1 A 3 A_PlaySound("hitflesh")
	Stop
  }
}
Actor PlayerTracer : EvaTracer { +MTHRUSPECIES Species "Player" }
Actor RevolverTracer : PlayerTracer { Speed 100 }
