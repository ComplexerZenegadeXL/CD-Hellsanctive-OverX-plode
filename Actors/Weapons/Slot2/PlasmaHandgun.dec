Actor PlasmaFireBall 
{
  Radius 12
  Height 12
  Speed 100
  Damage (random(90,120))
  Scale 0.6
  Projectile
  Renderstyle Add
  Species "Player"
  DamageType "PlasmaClass"
  +THRUSPECIES
  +DONTHURTSPECIES
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  Decal "DoomImpScorch"
  States 
  {
  Spawn:
	PLST AABB 1 Bright A_SpawnItemEx("PlasmaFireBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Loop
  Death:
	TNT1 A 0 A_Explode((random(7,10)*15),64)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItem("PlasmaEx")
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	PLST CDE 3 Bright
	Stop
  Vanilla:
	TNT1 A 0 A_SpawnItem("PlasmaEx")
	PLST CDE 3 Bright
	Stop
  }
}

