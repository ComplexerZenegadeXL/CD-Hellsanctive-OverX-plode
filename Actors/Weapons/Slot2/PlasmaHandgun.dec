Actor PlasmaFireBallInfinite : PlasmaFireBall { Damage (random(45,60)) }

Actor PlasmaFireBallTrail : BFG9500Trail 
{
  Scale 0.5
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	PLST AABBAABB 1 A_FadeOut(0.12)
	Stop
  }
}

