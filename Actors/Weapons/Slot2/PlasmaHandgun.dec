Actor PlasmaHandgunUpgrade : BaseWeaponUpgrade
{
  Scale 0.65
  Inventory.PickupMessage "$CFPlasmaHandgunUpgradePickup"
  Inventory.PickupSound "pistol/upgrade"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("UpgradeIconToken",1)
	TNT1 A 0 A_SpawnItemEx("WeaponUpgradeIcon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
  Cont:
	PHUP A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,"Nope")
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgun",1,"GiveUpgrade")
  Nope:
	TNT1 A 0
	Fail
  GiveUpgrade:
	TNT1 A 0 A_TakeInventory("UpgradeIconToken",1)
	TNT1 A 0 A_GiveInventory("PlasmaHandgunUpgraded",1)
	Stop
  }
}

