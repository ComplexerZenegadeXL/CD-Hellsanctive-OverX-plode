Actor PHGProjectileUpgrade : PHGProjectile 
{
  +NOTIMEFREEZE
  +HITTRACER
  States 
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_SpawnItem("PlasmaExUpgrade")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetTracer") == 1,2)
	TNT1 A 0 A_GiveInventory("ForceTimeFreeze",1,AAPTR_TRACER)
	TNT1 A 0
	Stop
  XDeath:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_SpawnItem("PlasmaExUpgrade")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetTracer") == 1,2)
	TNT1 A 0 A_GiveInventory("ForceTimeFreeze",1,AAPTR_TRACER)
	TNT1 A 0
	Stop
  }
}

