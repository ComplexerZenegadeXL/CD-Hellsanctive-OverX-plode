Actor PlasmaHandgunGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFPlasmaHandgunPickup"
  Tag "$CFPlasmaHandgun"
  States
  {
  Spawn:
	REVP A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	REVP A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgun",1,3)
	TNT1 A 0 A_GiveInventory("PlasmaHandgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",30)
	TNT1 A 0 A_GiveInventory("RevolverSpinner",Random(3,6))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor PlasmaHandgun : DoomWeapon
{
  Scale 0.85
  Weapon.PreferredSkin "Handgun-Marine"
  Weapon.SelectionOrder 8000
  Weapon.SlotNumber 2
  Weapon.SlotPriority 2.0
  Weapon.KickBack 60
  Inventory.PickupSound "weapons/pickuptp"
  Inventory.PickupMessage "$CFPlasmaHandgunPickup"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 4
  Weapon.AmmoType "PlasmaHGCell"
  Tag "$CFPlasmaHandgun"
  Obituary "$CFPlasmaHandgunObit" 
  +WEAPON.NOAUTOAIM
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +INVENTORY.UNDROPPABLE
  States 
  {
  Spawn:
	PLSQ A -1
	Stop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("PlasmaHandgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Ready:
	TNT1 A 0 A_PlayWeaponSound("PlasmaPistol/Draw")
	PLP8 ABCD 1
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunFiringMode",2,2)
	TNT1 A 0 A_TakeInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaHGCell",5,2)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	PLP0 A 3 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
	//TNT1 A 0 A_GiveInventory("PlasmaHGCell",2)
	Goto Ready+5
  Deselect:
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_TakeInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	TNT1 A 0 A_Lower
	PLP0 A 1 A_Lower
	Loop
  Zoom:
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunCooldown",1,2)
	TNT1 A 0 ACS_NamedExecuteWithResult("PlasmaHandgunWeaponMode")
	TNT1 A 0
	Goto Ready + 5
  Fire:
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunFiringMode",3,"FireReload")
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunFiringMode",2,"FireInfinite")
	TNT1 A 0 A_JumpIfInventory("PlasmaHGCell",4,1)
	Goto Ready+5
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,3)
	TNT1 A 0 A_FireCustomMissile("PHGProjectile",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileUpgrade",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
  FireReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1 A_TakeInventory("PlasmaPistolDontRegenToken",1)
	Goto Ready+5
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("PlasmaHGCell",4,1)
	Goto Ready+5
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,5)
	TNT1 A 0 A_FireCustomMissile("PHGProjectile",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectile",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectile",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,4)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileUpgrade",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileUpgrade",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileUpgrade",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
  FireSpreadReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1 A_TakeInventory("PlasmaPistolDontRegenToken",1)
	Goto Ready+5
  FireReload:
	TNT1 A 0 A_JumpIfInventory("PlasmaMagazine",1,1)
	Goto Reload
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireReloadSpread")
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,3)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReload",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReloadUpgrade",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
  FireReloadReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1
	Goto Ready+5
  FireReloadSpread:
	TNT1 A 0 A_JumpIfInventory("PlasmaMagazine",1,1)
	Goto Ready+5
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,5)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReload",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReload",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReload",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,4)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReloadUpgrade",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReloadUpgrade",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileReloadUpgrade",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
  FireReloadSpreadReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1
	Goto Ready+5
  FireInfinite:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireInfiniteSpread")
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,3)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfinite",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfiniteUpgrade",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
  FireInfiniteReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1
	Goto Ready+5
  FireInfiniteSpread:
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("weapons/PHGFire",1)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunUpgraded",1,5)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfinite",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfinite",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfinite",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_Jump(256,4)
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfiniteUpgrade",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfiniteUpgrade",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PHGProjectileInfiniteUpgrade",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
  FireInfiniteSpreadReady:
	TNT1 A 0 A_GunFlash
	PLP0 B 2 Bright
	TNT1 A 0 A_Light0
	PLP0 C 2 Bright
	PLP0 DEFG 2 A_WeaponReady
	PLP0 H 1
	Goto Ready+5
  AltFire:
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunFiringMode",3,"AltFireReload")
	TNT1 A 0 A_JumpIfInventory("PlasmaHandgunFiringMode",2,"AltFireInfinite")
	TNT1 A 0 A_JumpIfInventory("PlasmaHGCell",40,"AltHold")
	Goto Ready+5
  AltHold:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,6)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaHGCell",4)
	Goto Fire
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaHGCell",40)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBall",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
  FireReady2:
	TNT1 A 0 A_PlaySound("PlasmaPistol/Chargeshot",1)
	PLP9 JJKK 1 Bright
	PLP9 LMNOP 2
	PLP0 A 1 A_TakeInventory("PlasmaPistolDontRegenToken",1)
	Goto Ready+5
  AltFireSpread:
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,6)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaHGCell",4)
	Goto Fire
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaHGCell",40,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBall",frandom(-0.4,0.4),1,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBall",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBall",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	Goto FireReady2
  AltFireReload:
	TNT1 A 0 A_JumpIfInventory("PlasmaMagazine",5,"AltReloadHold")
	Goto Reload
  AltReloadHold:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireReloadSpread")
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,6)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire("AltReloadHold")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",1,TIF_NOTAKEINFINITE)
	Goto FireReload
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire("AltReloadHold")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallReload",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
  FireReloadReady2:
	TNT1 A 0 A_PlaySound("PlasmaPistol/Chargeshot",1)
	PLP9 JJKK 1 Bright
	PLP9 LMNOP 2
	PLP0 A 1
	Goto Ready+5
  AltFireReloadSpread:
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,6)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire("AltFireReloadSpread")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",1,TIF_NOTAKEINFINITE)
	Goto FireReload
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire("AltFireReloadSpread")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_TakeInventory("PlasmaMagazine",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallReload",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallReload",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallReload",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	Goto FireInfiniteReady2
  AltFireInfinite:
	TNT1 A 0
  AltInfiniteHold:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireInfiniteSpread")
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,5)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire("AltInfiniteHold")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	Goto FireInfinite
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire("AltInfiniteHold")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallInfinite",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
  FireInfiniteReady2:
	TNT1 A 0 A_PlaySound("PlasmaPistol/Chargeshot",1)
	PLP9 JJKK 1 Bright
	PLP9 LMNOP 2
	PLP0 A 1
	Goto Ready+5
  AltFireInfiniteSpread:
	TNT1 A 0 A_GiveInventory("PlasmaPistolDontRegenToken",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",1,7)
	TNT1 A 0 A_PlaySound("weapons/PHGCharge",7)
	PLP9 ABCDE 2
	TNT1 A 0 A_JumpIfInventory("PlasmaCharge",100,6)
	PLP9 F 1 A_GiveInventory("PlasmaCharge",3)
	TNT1 A 0 A_ReFire("AltFireInfiniteSpread")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	Goto Fire
	TNT1 A 0 A_PlaySound("weapons/PHGIdle",1,1.0,1)
	PLP9 FGHI 1 Bright
	TNT1 A 0 A_ReFire("AltFireInfiniteSpread")
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_TakeInventory("PlasmaCharge",100)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallInfinite",frandom(-0.4,0.4),0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallInfinite",frandom(-0.4,0.4)+15.0,0,0,8,0,frandom(-0.2,0.2))
	TNT1 A 0 A_FireCustomMissile("PlasmaFireBallInfinite",frandom(-0.4,0.4)-15.0,0,0,8,0,frandom(-0.2,0.2))
	Goto FireInfiniteReady2
  Reload:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("PlasmaHandgunReloadCheck") == 1,1)
	Goto Ready+5
  ReloadLoop:
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("PlasmaMagazine",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaMagazine",30,"Full")
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"ReloadLoop")
	Goto Full
  MaxReload:
   	PHGP A 1 A_PlayWeaponSound("weapons/PHGHRin")
	PHGP BC 1
	PHGP D 2
	PHGP E 2 A_FireCustomMissile("PistolEmptyMagSpawner", 0, 0, 0, 1)
  Reload2:
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("PlasmaMagazine",1)
	TNT1 A 0 A_JumpIfInventory("PlasmaMagazine",30,"Full")
	TNT1 A 0 A_JumpIfInventory("NewCell",1,"Reload2")	  
  Full:
	PHGP F 5
	PHGP GHI 2
	PHGP J 2 A_PlayWeaponSound("weapons/PHGHRin")
	PHGP KLMNOPQ 2
	Goto Ready+5
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+5
  GrenadeToss:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	PLP8 DCBA 1
	TNT1 A 0 A_Light0
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+5
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	PLP8 DCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

