Actor LegendaryRevolverGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryRevolverPickup"
  Inventory.PickupSound "revspin"
  Tag "$CFLegendaryRevolver"
  States
  {
  Spawn:
	LRVI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",2,0)
	LRVI A -1
	Stop
  Pickup:
	TNT1 A 0 A_Jumpif(ACS_NamedExecuteWithResult("DualRevolverCheck",0)==2,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor LegendaryRevolverSpawnerGiver : LegendaryRevolverGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_Jumpif(ACS_NamedExecuteWithResult("DualRevolverCheck",0)==2,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor LegendaryRevolverGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryRevolver : DoomWeapon 18601
{
  //$Category Weapons/LCA/DJB
  //$Sprite LRVIA0
  //$Title "LegendaryRevolver"
  Tag "$CFLegendaryRevolver"
  Scale 0.8
  Weapon.PreferredSkin "LegendaryRevolver-Marine"
  Weapon.SelectionOrder 19
  Weapon.KickBack 160
  Inventory.PickupSound "revspin"
  Weapon.SelectionOrder 8000
  Weapon.SlotNumber 2
  Weapon.SlotPriority 5.0
  Weapon.AmmoGive1 0
  Weapon.AmmoGive2 0
  Weapon.AmmoUse 1
  Weapon.AmmoType "LegendaryRevolverSpinner"
  Weapon.AmmoType2 "LegendaryLMGBulletMag"
  Inventory.PickupMessage "$CFLegendaryRevolverPickup"
  Obituary "$CFLegendaryRevolverObit" 
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States 
  { 
  Spawn: 
    LRVI A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",2,0)
	LRVI A -1 
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",4,2,0)
	TNT1 A -1
	Stop
  Select:
	LRSU A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LRVL E 1 A_Lower
	Goto Deselect+1
  Ready:
	LRSU AB 2
	LRSU C 2 A_PlaySound("REVCLOSE")
	LRSU D 2
	TNT1 A 0 A_PlayWeaponSound("revspin")
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LRVL E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOSECONDARY)
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)	  	
	TNT1 A 0 A_FireCustomMissile("BlueSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"LegendaryRevBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_TakeInventory("LegendaryRevolverSpinner",1,TIF_NOTAKEINFINITE)
	LRVL F 2 Bright A_Light2 
	LRVL F 1 Bright A_Light1  
	TNT1 A 0 A_Light0 
	LRVL GH 2
	Goto Ready2
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_PlaySound("revfire")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(1,2,0,1,0)	  	
	TNT1 A 0 A_FireCustomMissile("BlueSGTracer",0,0,0,0)
	TNT1 A 0 A_FireBullets(0, 0, -1,Random(80,100),"LegendaryRevBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",-150,0,random(80,100))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",+150,0,random(80,100))
	LRVL F 2 Bright A_Light2 
	LRVL F 1 Bright A_Light1  
	TNT1 A 0 A_Light0 
	LRVL GH 2
	Goto Ready2
  Empty:
	LRVL E 1 A_PlayWeaponSound("weapons/click")
  Reload:
	TNT1 A 0 A_JumpIfInventory("LegendaryRevolverSpinner",6,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,2)
	TNT1 A 0
	Goto Ready2
	LRVL E 6
	LRVL IJKL 2 
	LRVL M 2 A_PlaySound("REVOPEN")
	LRVL N 2 A_PlaySound("REVEJECT")
	LRVL NNNNNN 0 A_SpawnItemEx("LegBulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	LRVL N 10 
	LRVL OPQR 2
	LRVL S 5
	LRVL T 5 A_PlaySound("REVINSR")
	LRVL UV 5
	LRVL W 5 A_PlaySound("REVCLOSE")
	LRVL X 5
	LRVL E 1 A_PlayWeaponSound("revspin")
  RealReload:
	TNT1 A 0 A_TakeInventory("LegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("LegendaryRevolverSpinner",1)
	TNT1 A 0 A_JumpIfInventory("LegendaryRevolverSpinner", 6,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"RealReload")
	LRVL E 1
	Goto Ready2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready2
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LRSU FGH 2
	TNT1 A 6
	HGRN ABC 1
	HGRN D 3
	HGRN EFGHI 2
	TNT1 A 14 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGRN J 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN KLM 2
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	LRSU HGF 2
	Goto Ready2
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready2
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LRSU FGH 2
	TNT1 A 10
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1) 
	LRSU HGF 2
	Goto Ready2 
  }
}

Actor LegendaryRevolverSpinner : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 6
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 6
  Inventory.Icon "LRVIA0"
  +IGNORESKILL
}

Actor LegendaryRevBulletPuff : PlayerModdedBulletPuff
{
  DamageType "PlayerLegendary"
  Decal "LegBulletChip"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryDetectFloorPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegendaryDetectCeilingPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	PUFF A 2 Bright
	PUFF B 2 Bright A_Jump(32,"RicochetPuff","RicochetPuffAlt")
	PUFF CDEF 2 A_ChangeVelocity(0,0,frandom(0,2))
    Stop
  }
}

Actor LegBulletCasing
{
  Radius 3
  Scale 0.18
  +MISSILE
  +CLIENTSIDEONLY
  +NOTELEPORT	
  +DOOMBOUNCE
  +THRUACTORS
  +DROPOFF
  BounceFactor 0.5
  WallBounceFactor 0.25
  BounceCount 3
  Seesound "weapons/casing1"
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LCAS ABCDEFGH 2
	Loop
  Death:
    TNT1 A 0 A_Jump(128,3)
    LCAS C 100
    LCAS C 5 A_FadeOut(0.10)
    Goto Death+3
    LCAS G 100
	LCAS G 5 A_FadeOut(0.10)
	Goto Death+5
  Vanilla:
	TNT1 A 0
	Stop
  }
}
