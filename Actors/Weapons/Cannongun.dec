    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk6",0,0,0,frandom(-10,10),frandom(-10,10),frandom(4,6))
    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk4",0,0,0,frandom(-12,12),frandom(-10,10),frandom(3,5))
    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk3",0,0,0,frandom(-14,14),frandom(-10,10),frandom(2,4))
    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk2",0,0,0,frandom(-16,16),frandom(-10,10),frandom(1,3))
    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk1",0,0,0,frandom(-18,18),frandom(-10,10),frandom(1,2))
    Stop
  }
}
