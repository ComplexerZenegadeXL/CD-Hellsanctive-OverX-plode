Actor CannongunPickupFlare : CannongunExplosiveFlare
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAAAA 0 A_SpawnItemEx("CannongunPickupFlareExtra", frandom(-8,8), frandom(-8,8), frandom(-8,8),  frandom(-8,8), frandom(-8,8), frandom(-8,8), frandom(0,360), SXF_CLIENTSIDE)
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("CannongunPickupFlareFiery", frandom(-8,8), frandom(-8,8), frandom(0,8),  frandom(-8,8), frandom(-8,8), 0, frandom(0,360), SXF_CLIENTSIDE)
    "BurnOut":
	TNT1 A 0 A_JumpIf(scalex <= 0.01, 2)
	TNT1 A 0 A_SetScale(scalex - 0.07, scaley + 0.02)	
    X073 A 1 Bright A_FadeOut(0.08)
    Loop
  }
}
Actor CannongunRocketExplosionFlare : CannongunExplosiveFlare
{
  Scale 0.25
  Alpha 0.95
  States
  {
  Spawn:
    X079 A 1 NoDelay Bright
    TNT1 A 0 A_SetScale(ScaleX + 0.15, ScaleY + 0.15)
	X079 A 1 Bright A_FadeOut(0.20)
    TNT1 A 0 A_SetScale(ScaleX + 0.15, ScaleY + 0.15)
	X079 A 1 Bright A_FadeOut(0.20)
    TNT1 A 0 A_SetScale(ScaleX + 0.15, ScaleY + 0.15)
	X079 A 1 Bright A_FadeOut(0.20)
    Stop
  }
}

Actor CannongunRocketExplosionFlash : CannongunFlashFlare { Scale 1.5 Alpha 0.9 }
/*
Flags:
-----
+CLIENTSIDEONLY     = Spawns the actor on the clientside no matter how it is
                      spawned.
+FORCEXYBILLBOARD   = Forces the actor's sprite to "billboard" to the screen on
                      the X- and Y-axes when using the OpenGL renderer.
*/
// Base white flame
Actor CannongunRocketFlame : CannongunEffect
{
//Scale 0.5
//RenderStyle Translucent
  Alpha 0.75
  RenderStyle Add
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128, 13)
    X116 ABCDEFG 1 Bright
    X116 HIJKL 1 Bright A_FadeOut(0.15)
    Stop
    X116 MNOPQRS 1 Bright
    X116 TUVWX 1 Bright A_FadeOut(0.15)
    Stop
  }
}
