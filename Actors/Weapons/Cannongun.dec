Actor CannongunExplosionChunk : CannongunDebris
{
  Health 1
  Scale 0.5
  Height 20
  Radius 12
  Speed 0
  Projectile
  BounceType Doom
  BounceCount 2
  BounceFactor 0.25
  WallBounceFactor 0.5
  +BOUNCEAUTOOFFFLOORONLY
  +MOVEWITHSECTOR
  -NOGRAVITY
  States
  {
  Spawn:
    X300 AAAABBBB 1 Bright A_SpawnItemEx("CannongunExplosionChunkTrail", 0, 0, 0, frandom(-1,1), frandom(-1,1), frandom(-1,1), 0, SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0
    TNT1 A 0 //A_PlaySound("Rock/Bounce")
    X300 C 150
    X300 C 5 A_FadeOut(0.10)
    Goto Death+3
  }
}
