    //TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk9",0,0,0,3,3,frandom(4,8),frandom(0,360))
    //TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk8",0,0,0,-4,-4,frandom(4,8),frandom(0,360))
