    TNT1 AAA 1 A_SpawnItemEx("CannongunExplosionChunk",0,0,0,frandom(-10,10),frandom(-10,10),frandom(4,6))
    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk9",0,0,0,frandom(-10,10),frandom(-10,10),frandom(4,6))
