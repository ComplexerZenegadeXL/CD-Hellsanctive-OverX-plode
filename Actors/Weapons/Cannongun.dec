Actor CannongunGlitterParticle
{
  Radius 0
  Height 0
  RenderStyle Add
  +NOGRAVITY
  +NOBLOCKMAP
  +NOINTERACTION
  +DONTSPLASH
  +FORCEXYBILLBOARD
  +NONETID
  +CLIENTSIDEONLY
  XScale 0.04
  YScale 0.02
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(ScaleX <= 0.01, 3)
	TNT1 A 0 A_JumpIf(ScaleY >= 0.12, 2)
	TNT1 A 0 A_SetScale(ScaleX - 0.002, ScaleY + 0.002)
    X017 A 2 Bright A_FadeOut(0.06)
    Loop
  }
}
