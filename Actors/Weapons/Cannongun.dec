Actor CannongunRocketTrailParticle : CannongunCommonParticle
{
  Scale 0.12
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ScaleX <= 0.05, "BurnOut")
	TNT1 A 0 A_SetScale(ScaleX - 0.015, ScaleY - 0.015)
    X023 A 1 Bright A_FadeOut(0.05)
    X023 B 1 Bright A_FadeOut(0.05)
    X023 C 1 Bright A_FadeOut(0.05)
    Loop
  "BurnOut":
    X023 ABC 1 Bright A_FadeOut(0.025)
	Loop
  }
}
