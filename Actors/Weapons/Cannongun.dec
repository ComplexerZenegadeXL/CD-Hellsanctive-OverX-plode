    TNT1 A 1 A_SpawnItemEx("CannongunExplosionChunk3",0,0,0,8,8,frandom(2,4),frandom(0,360))
    TNT1 AA 1 A_SpawnItemEx("CannongunExplosionChunk2",0,0,0,-9,9,frandom(1,3),frandom(0,360))
    TNT1 AAA 0 A_SpawnItemEx("CannongunExplosionChunk1",0,0,0,10,-10,frandom(1,2),frandom(0,360))
