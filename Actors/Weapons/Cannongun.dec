Actor Cannongun : Weapon
{
  Weapon.SelectionOrder 100
  Weapon.AmmoUse 0
  Weapon.AmmoGive 0
  Weapon.AmmoType ""
  //Weapon.SlotPriority 2
  Weapon.Kickback 100
  Inventory.PickupSound ""
  Inventory.PickupMessage ""
  Obituary "%o exploded by %k's Cannon gun."
  Tag "$CFCannongun"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.EXPLOSIVE
  +BFG
  -WEAPON.NOAUTOFIRE
  +WEAPON.CHEATNOTWEAPON
  States
  {
  Deselect:
    W21G A 1 A_Lower
    TNT1 AA 0 A_Lower
    Loop
  Select:
	TNT1 A 0 A_Raise
    Wait	
  Ready:
    //TNT1 A 0 A_PlayWeaponSound("Weapons/CannonUp")
	W21U ABCDEF 1
	W21U GH 2
    W21G A 1 A_WeaponReady
    Goto Ready+8
  Fire:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("Cannongun/Fire", CHAN_WEAPON)
	TNT1 A 0 A_FireCustomMissile("CannongunRocket", 0, 0) 
    TNT1 A 0 A_Quake(1, 12, 0, 8, none)
	TNT1 A 0 A_Recoil(1)
    TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_SetBlend("Yellow", 0.2, 2)
	W21F A 4 BRIGHT
	TNT1 A 0 A_SetBlend("Orange", 0.1, 10)
	W21F BCD 4
	W21F E 6 A_ReFire
    Goto Ready+8
  Spawn:
    TNT1 A 0 NoDelay
	TNT1 A 1
    Stop
  }
}
Actor HasCannongun : Inventory {}
Actor CannongunRocket : FastProjectile
{
  Decal "BigScorch"
  DamageType "Player"
  Speed 80
  Damage 100
  Radius 11
  Height 8
  Projectile
  +RANDOMIZE
  +DEHEXPLOSION
  +THRUSPECIES
  +MTHRUSPECIES
  +NODAMAGETHRUST
  +EXPLODEONDEATH
  SeeSound "weapons/rocklf"
  DeathSound "weapons/rocklx"
  Obituary "$OB_MPROCKET"
  SeeSound ""
  DeathSound "Cannongun/Explosion"
  MissileType "CannongunRocketProjectileTrail"
  MissileHeight 7
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("CannongunRocketFireFlash", -20)
  Running:
    X703 AB 4 Bright
	Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionFlare", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionFlash", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionChunksSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionFlameSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	MISL B 6 Bright A_Explode(256, 192)
    TNT1 A 0 A_Quake(4, 12, 0, 192, none)
    TNT1 A 0 A_SpawnItemEx("CannongunRocketExplosionSmokeSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	MISL C 4 Bright
	MISL D 2 Bright
    Stop
  }
}
/*
Properties:
----------
Height = Defines the height of this actor.
         Default is 16.
         Note: using very small values can provoke glitches in collision
		 detection.
Radius = Defines the radius of this actor.
         Default is 20.
         Notes:
         Using very small values can provoke glitches in collision detection.
         The total diameter is double this value, so an actor with a radius
		 of 64 is actually 128 units in length and width, making it
		 impossible for them to navigate through a corridor that's 128 units
		 wide, for example.

Flags:
-----
+NOINTERACTION      = The actor is purely decorative. It will not interact with
                      any other actor and will ignore all game physics
					  (including solid walls and floors!), moving only
					  according to its own momentum. (i.e. The actor will not
					  be affected by gravity, but its movement can still be
					  directly changed using ThrustThing.) All AI routines
					  will ignore this actor's existence, speeding up
					  processing time.
+NOGRAVITY          = Actor is not subject to gravity.
                      * Automatically given by the Projectile combo.
+NOBLOCKMAP         = This object is excluded from passive collision detection.
                      Nothing else can run into a NOBLOCKMAP object but the
					  object itself can run into others.
				      * Automatically given by the Projectile combo
+NOTELEPORT         = Actor cannot teleport.
+NOCLIP             = Actor is totally excluded from collision detection and
                      can walk through walls etc.
+DONTSPLASH         = Actor does not create any terrain splashes.
+CLIENTSIDEONLY     = Spawns the actor on the clientside no matter how it is
                      spawned.
+NONETID            = Actors with this flag are not assigned a network id when
                      spawned. Only use it if you know what you are doing!
+DONTIDENTIFYTARGET = Players using a class with this flag enabled won't be
                      identified when looked at.
*/
Actor CannongunEffect
{
  Radius 0
  Height 0
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +NOCLIP
  +NONETID
}
Actor CannongunRocketCommonSmoke : CannongunEffect
{
  Scale 0.65
  Alpha 0.95
  RenderStyle Add
  +THRUGHOST
  +DONTSPLASH
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(256, 0, 8, 15, 22, 29, 36)
    // Right smoke
    X200 ALMNOPQ 6
    Stop
    X200 F 6
    X200 LMNOPQ 4 A_FadeOut(0.05)
    Stop
    X200 K 6
    X200 LMNOPQ 8 A_FadeOut(0.05)
    Stop
    // Left smoke
    X201 ALMNOPQ 6
    Stop
    X201 F 6
    X201 LMNOPQ 4 A_FadeOut(0.05)
    Stop
    X201 K 6
    X201 LMNOPQ 8 A_FadeOut(0.05)
    Stop
  }
}
Actor CannongunRocketTrailSmoke : CannongunRocketCommonSmoke
{
  Alpha 0.35
  Scale 0.15
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 2
	Goto Super::Spawn
  }
}

