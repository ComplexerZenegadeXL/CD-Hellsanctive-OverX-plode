Actor DesiccationRodGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "BFlan/Draw"
  Inventory.PickupMessage "$CFDesiccationRodPickup"
  +FLOATBOB
  Tag "$CFDesiccationRod"
  States
  {
  Spawn:
	SROP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	SROP A 20 Bright
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,36,0,0,0,0,SXF_CLIENTSIDE)
	SROP BCD 4 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",26,-1,7) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DesiccationRod",1,3)
	TNT1 A 0 A_GiveInventory("DesiccationRod",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",19)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor DesiccationRodSpawnerGiver : DesiccationRodGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DesiccationRod",1,3)
	TNT1 A 0 A_GiveInventory("DesiccationRod",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",19)
	TNT1 A 0 A_JumpIfInventory("DesiccationRodGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DesiccationRodGiverCheck",1)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor DesiccationRodGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DesiccationRod : DoomWeapon
{
  Scale 0.8
  Weapon.AmmoType1 "CFMana"
  Weapon.AmmoType2 "CFMana"
  Weapon.AmmoUse1 20
  Weapon.AmmoGive 0
  Weapon.SlotNumber 1
  Weapon.SlotPriority 3.0
  Weapon.UpSound "BFlan/Draw"
  Inventory.PickupSound "BFlan/Draw"
  Inventory.PickupMessage "$CFDesiccationRodPickup"
  Weapon.PreferredSkin "Fist-Marine"
  Obituary "$CFDesiccationRodObit"
  Tag "$CFDesiccationRod"
  +FLOATBOB
  +WEAPON.NOALERT
  States
  {
  Spawn:
	SROP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	SROP A 20 Bright
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,36,0,0,0,0,SXF_CLIENTSIDE)
	SROP BCD 4 Bright
	Loop
  Ready:
	SRO0 ABCDE 1 Bright
	TNT1 A 3
	SRO0 FGHIJKL 1 Bright
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	SROD A 1 Bright A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_Lower
	SROD A 1 Bright A_Lower
	Goto Deselect+1
  Select: 
	//TNT1 A 0 A_JumpIfInventory("DustLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("DesiccationRod",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	SROD BCD 1 Bright
	TNT1 A 2
  Fire2:
	TNT1 A 0 A_PlaySound("BFlan/Swing")
	SROD EF 2 Bright
	TNT1 A 0 A_CustomPunch(random(12,20)*25,1,CPF_USEAMMO|CPF_PULLIN,"RodWallHit",128)
	SROD GHIJ 2 Bright
	TNT1 A 5
	TNT1 A 0 A_JumpIfNoAmmo("Done")
	TNT1 A 0 A_Refire("Fire3")
	Goto Done
  Fire3:
	TNT1 A 0 A_PlaySound("BFlan/Swing")
	SROD KL 2 Bright
	TNT1 A 0 A_CustomPunch(random(7,12)*25,1,CPF_USEAMMO|CPF_PULLIN,"RodWallHit",128)
	SROD MNOP 2 Bright
	TNT1 A 5
	TNT1 A 0 A_JumpIfNoAmmo("Done")
	TNT1 A 0 A_Refire("Fire2")
	Goto Done
  Done:
	SROD DCB 2 Bright
	Goto Ready2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready2
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	SROD BCD 2 Bright
	TNT1 A 3
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	SROD DCB 2 Bright
	Goto Ready2
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready2
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	SROD BCD 2 Bright
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	SROD DCB 2 Bright
	Goto Ready2
  }
}

Actor RodWallHit : PlayerModdedBulletPuff
{
  +NOGRAVITY
  +PUFFGETSOWNER
  +PUFFONACTORS
  +EXTREMEDEATH
  DamageType "Melee"
  AttackSound "Rod/Hit"
  SeeSound "BFlan/Slash"
  RenderStyle Add
  Alpha 0.8
  Scale 0.8
  States
  {
  Spawn:
  Melee:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,"Alt")
	FX57 ABCDEFGHIJ 1 Bright A_FadeOut(0.08)
	Stop
  Alt:
	FX58 ABCDEFGHIJ 1 Bright A_FadeOut(0.08)
	Stop	
  XDeath:
	TNT1 F 0 
	FAXE F 3 A_GiveToTarget("DesiccationHealth")
	FAXE GHIJK 3
	Stop
  }
}

Actor DesiccationHealth : NewMaxHealthBonus
{
  Inventory.PickupMessage ""
  Inventory.PickupSound ""
  States
  {
  Spawn:
    TNT1 A 0
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,20)
	Stop
  }
}