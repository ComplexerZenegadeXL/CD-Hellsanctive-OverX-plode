	TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_AUTO)
	SAWS EFGHABCDEFGHABCDEFGHABCDEFGHABCD 2 Bright A_SeekerMissile(90,90)
	TNT1 A 0 A_CountDown
	Loop 
  }*/
}
 
Actor LegendaryChainHold : Inventory { }
Actor LegendaryChainAltHold : Inventory { }