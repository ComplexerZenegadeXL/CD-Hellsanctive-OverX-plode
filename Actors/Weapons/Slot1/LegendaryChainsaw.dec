Actor ChainsawGiver : CustomInventory replaces Chainsaw
{
  Scale 0.65
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFChainsaw"
  Inventory.PickupSound "weapons/pickupsaw"
  Tag "$CFChainsaw"
  States
  {
  Spawn:
	CSAW A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
  SpawnLoop:
	CSAW A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFChainsaw",1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_GiveInventory("CFChainsaw",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",18)
	Stop
  }
}

Actor LegendaryChainsawGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryChainsawPickup"
  Inventory.PickupSound "weapons/pickupsaw"
  Tag "$CFLegendaryChainsaw"
  States
  {
  Spawn:
    LBAT A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
  SpawnLoop:
	LBAT ABCDCB 5 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",38,-1,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("CFChainsaw",1)
	TNT1 A 0 A_GiveInventory("LegChainsawUpgrade",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",21)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonAmmo",Random(50,100))
	Stop
  }
}

Actor LegendaryChainsawSpawnerGiver : LegendaryChainsawGiver
{
 States
 {
  Spawn:
    CLSW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",0,1,5,1)
	CLSW A -1 Bright
    Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("CFChainsaw",1)
	TNT1 A 0 A_GiveInventory("LegChainsawUpgrade",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",21)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryChainsawGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryChainsawGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",Random(50,100))
	Stop
 }
}

Actor LegendaryChainsawGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegChainsawUpgrade : Inventory 
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
}

Actor CFChainsaw : Chainsaw replaces Chainsaw
{
  Scale 0.65
  Inventory.PickupMessage "$CFChainsaw"
  Weapon.PreferredSkin "Chainsaw-Marine"
  Weapon.SlotNumber 1
  Weapon.SlotPriority 2.0
  Weapon.AmmoGive 0
  Weapon.AmmoType "LDemonAmmo"
  Weapon.AmmoType2 "LDemonAmmo"
  Weapon.ReadySound ""
  Inventory.PickupSound "weapons/pickupsaw"
  Tag "$CFChainsaw"
  var int user_thingtid;
  var int user_playertid;
  //+INVENTORY.UNDROPPABLE
  States
  {
  Spawn:
	CSAW A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",0,1,1)
	CSAW A -1
	Stop	
  Held:
    TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",15,0,1)
	TNT1 A -1
	Stop
  Deselect:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegDeselect")
	TNT1 A 0 A_StopSound(1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	SAWH A 1 A_Lower
	Goto Deselect+4
  Select:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegSelect")
	SAWH A 1 A_Raise
	TNT1 A 0 A_Raise
	Loop
  Ready:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegReady")
	TNT1 A 0 A_PlaySound("weapons/SawIdle",1,1.0,0)
	SAWH ABCD 2 A_WeaponReady(WRF_NOSECONDARY)
	Loop		
  Fire:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegFire")
	SAWL AB 1
  Hold:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegHold")
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	SAWN A 2 A_Saw("weapons/sawfull","weapons/sawhit",Random(10,20),"SawScreech",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	SAWN B 2 A_Saw("weapons/sawfull","weapons/sawhit",Random(10,20),"SawScreech",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 A_Refire("Hold")
	SAWL BA 1
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfInventory("LegChainsawUpgrade", 1, "LegAltFire")
	Goto Ready
  LegReady:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("LegendaryChainHold",1)
	TNT1 A 0 A_TakeInventory("LegendaryChainAltHold",1)
	TNT1 A 0 A_PlaySound("weapons/legChainSawIdle",1,1.0,1)
	LSWH ABCDEFG 1
	LSWH H 1 A_WeaponReady
  LegReadyLoop:
	LSWH ABCDEFGH 1 A_WeaponReady
	Loop
  LegSelect:
	LSWH A 0 A_PlayWeaponSound("weapons/weapondown")
	LSWH A 0 A_Raise
	LSWH A 1 A_Raise
	Goto LegSelect+1
  LegDeselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_TakeInventory("RailgunAction",1)
	TNT1 A 0 A_TakeInventory("LegendaryChainHold",1)
	TNT1 A 0 A_TakeInventory("LegendaryChainAltHold",1)
  LegDeselectLoop:
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_StopSound(1)
	LSWH A 1 A_Lower
	Goto LegDeselectLoop+1
  LegFire:
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto LegLessFire
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	LSWL AB 1 Bright
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN A 2 Bright A_Saw("weapons","weapons/sawhit",Random(35,50),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN B 2 A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM,8)
	TNT1 A 0 A_Refire("LegHold")
	Goto LegHoldEnd
  LegHold:
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto LegLessHold
	TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"LegHoldLoop")
  LegHoldLoop:
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN C 2 Bright A_Saw("weapons","weapons/sawhit",Random(35,50),"PlayerLegSawScreech",SF_NORANDOM,88)
	TNT1 A 0 A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto LegLessHoldLoop
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN D 2 Bright A_Saw("weapons","weapons/sawhit",Random(35,50),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto LegLessHoldLoop
	TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"LegHoldRefire")
	 TNT1 A 0 A_GiveInventory("LegendaryChainHold",1)
  LegHoldRefire:
	TNT1 A 0 A_Refire("LegHoldLoop")
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN E 2 Bright A_Saw("weapons","weapons/sawhit",Random(35,50),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_Saw("weapons/","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
	Goto LegLessHoldLoop
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSWN F 2 Bright A_Saw("weapons","weapons/sawhit",Random(35,50),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,88)
	TNT1 A 0 A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM,88)
  LegHoldEnd:
	TNT1 A 0 A_StopSound(7)
	LSWH ABCDEFGH 1
	Goto LegReady
  LegLessFire:
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	LSWL AB 1 Bright
	TNT1 A 0 //A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSZN B 2 Bright A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 A_Refire("LegLessHold")
	Goto LegHoldEnd
  LegLessHold:
	TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"LegLessHoldloop")
  LegLessHoldLoop:
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSZN C 2 Bright A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSZN D 2 Bright A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"LegLessHoldRefire")
	TNT1 A 0 A_GiveInventory("LegendaryChainHold",1)
  LegLessHoldRefire:
	TNT1 A 0 A_Refire("LegLessHoldLoop")
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSZN E 2 Bright A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM)
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	LSZN F 2 Bright A_Saw("weapons","weapons/sawhit",Random(15,25),"LegSawScreech2",SF_NOUSEAMMO|SF_NORANDOM)
	Goto LegHoldEnd
  LegAltFire: //weapons/nailfire
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",2,1)
	Goto LegReady
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"LegAltFireSpread")
	TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"LegAltFireLoop")
  LegAltFireLoop:
	LSWN ABCDE 1 Bright
	TNT1 A 0 A_PlaySound("weapons/nailfire")
	LSWN F 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,0,-15,-20)
	LSWN A 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,0,15,-20)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",2,TIF_NOTAKEINFINITE)
	LSWN BCDEF 1 Bright
	TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"LegAltFireRefire")
	TNT1 A 0 A_GiveInventory("LegendaryChainAltHold",1)
  LegAltFireRefire:
	TNT1 A 0 A_Refire("LegAltFire")
	TNT1 A 0 A_StopSound(7)
	LSWH ABCDEFGH 1
	Goto LegReady
  LegAltFireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("LegReady")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,1)
	Goto LegReady
	TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"LegAltFireSpreadLoop")
  LegAltFireSpreadLoop:
	LSWN ABCDE 1 Bright
	TNT1 A 0 A_PlaySound("weapons/nailfire")
	LSWN F 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,0,-15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",15.0,0,-15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",-15.0,0,-15,-20)
	LSWN A 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,0,15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",15.0,0,15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",-15.0,0,15,-20)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",2,TIF_NOTAKEINFINITE)
	LSWN BCDEF 1 Bright
	TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"LegAltFireSpreadRefire")
	TNT1 A 0 A_GiveInventory("LegendaryChainAltHold",1)
  LegAltFireSpreadRefire:
	TNT1 A 0 A_Refire("LegAltFire")
	LSWH ABCDEFGH 1
	Goto LegReady
  }
}


Actor LegSawScreech : PlayerModdedBulletPuff
{
  Scale 0.4
  RenderStyle Add
  Alpha 0.8
  DamageType "Legendary"
  AttackSound "Weapons/SawScreech"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("SawParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Jump(128,"Alt")
    FX97 ABCDEFGHIJ 1 Bright A_FadeOut(0.08,1)
    Stop
  Alt:
    FX98 ABCDEFGHIJ 1 Bright A_FadeOut(0.08,1)
    Stop   
  }
}

Actor LegSawScreech2 : LegSawScreech { DamageType "Extreme" }

Actor PlayerLegSawScreech : LegSawScreech 
{
  AttackSound ""
  DamageType "PlayerLegendary" 
  +PUFFGETSOWNER
  +PUFFONACTORS
  +HITTRACER
  States
  {
  Spawn:
	TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("LegChainsawStuff",1)
	TNT1 A 1
	Stop
  /*Crash:
	TNT1 A 1
	Stop*/
  XDeath:
	TNT1 A 0 ACS_NamedExecuteWithResult("LegChainsawStuff",2)
	TNT1 A 1
	Stop
  }
}

Actor PlayerLegPChainRipper : LegChainRipper
{
  Radius 4
  Height 6
  Speed 70
  Damage (Random(60,80))
  BounceCount 4
  DamageType "PlayerLegendary"
  SeeSound ""
  +MTHRUSPECIES
//  +USEBOUNCESTATE
