Actor FlameSwordGiver : CustomInventory
{
  Scale 0.75
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFFlameSwordPickup"
  Tag "$CFFlameSword"
  States
  {
  Spawn:
	FSWS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	FSWS AABBCC 2 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",47,-1,7) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("FlameSword",1,3)
	TNT1 A 0 A_GiveInventory("FlameSword",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",20)
	TNT1 A 0 A_GiveInventory("CFMana",50)
	Stop
  }
}

Actor FlameSwordSpawnerGiver : FlameSwordGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("FlameSword",1,3)
	TNT1 A 0 A_GiveInventory("FlameSword",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",20)
	TNT1 A 0 A_JumpIfInventory("FlameSwordGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("FlameSwordGiverCheck",1)
	TNT1 A 0 A_GiveInventory("CFMana",50)
	Stop
  }
}

Actor FlameSwordGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor FlameSword : DoomWeapon
{
  Scale 0.75
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.SelectionOrder 200
  Weapon.AmmoUse1 0
  Weapon.AmmoUse2 3
  Weapon.AmmoGive1 0
  Weapon.AmmoType1 "CFMana"
  Weapon.AmmoType2 "CFMana"
  //Weapon.MinSelectionAmmo1 3
  //Weapon.MinSelectionAmmo2 3
  Weapon.SlotNumber 1
  Weapon.SlotPriority 4.0
  Inventory.PickupMessage "$CFFlameSwordPickup"
  Obituary "$CFFlameSwordObit"
  Tag "$CFFlameSword"
  States
  {
  Spawn:
	FSWS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,0)
  SpawnLoop:
	FSWS AABBCC 2 Bright
	Loop
  Ready:
	TNT1 A 0 A_JumpIfInventory("CFMana",1,"Ready2")
	TNT1 A 0 A_StopSound(CHAN_6)
	FSPU A 2 Bright A_WeaponReady
	Loop
  Ready2:
	TNT1 A 0 A_JumpIfInventory("CFMana",1,1)
	Goto Ready
	TNT1 A 0 A_PlaySound("FSWLOOP",CHAN_6,0.3,true)
	FSWD AABBCC 2 Bright A_WeaponReady
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright A_WeaponReady
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright A_WeaponReady
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright A_WeaponReady
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	Loop
  Deselect:
	TNT1 A 0 A_Lower
	TNT1 A 0 A_StopSound(CHAN_6)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	FSPU A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("RMLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("FlameSword",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	FSPU A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_JumpIfInventory("CFMana",10,1)
	Goto HeldReady
	FSWD Z 1 Bright
  FireLoop:
    TNT1 A 0 A_JumpIfInventory("CFMana",10,1)
	Goto HeldReady
    TNT1 A 0 A_PlaySound("Firesword/swing",CHAN_WEAPON)
	FSWD DFH 1 Bright
    TNT1 A 0 A_FireBullets(0,0,-1,random(120,160),"FireSwordBulletPuff",FBF_NORANDOM,128)
	FSWD LMOQS 1 Bright
	TNT1 A 10
	TNT1 A 0 A_Refire("FireLoop")
	FSWD TUVW 1 Bright
	Goto Ready
  FireSpread:
	TNT1 A 0 A_JumpIfInventory("CFMana",15,1)
	Goto HeldReady
  FireSpreadLoop:
    TNT1 A 0 A_JumpIfInventory("CFMana",15,1)
	Goto HeldReady
    TNT1 A 0 A_PlaySound("Firesword/swing",CHAN_WEAPON)
	FSWD DFH 1 Bright
    TNT1 A 0 A_FireBullets(0,0,-1,random(110,150),"FireSwordBulletPuffSpread",FBF_NORANDOM,128)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireSwordBullet",-150,0,random(110,150))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireSwordBullet",150,0,random(110,150))
	FSWD LMOQS 1 Bright
	TNT1 A 10
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,2)
	TNT1 A 0 A_Refire("FireLoop")
	TNT1 A 0 A_Refire("FireSpreadLoop")
	FSWD TUVW 1 Bright
	Goto Ready
  HeldReady:
	TNT1 A 0 A_JumpIfInventory("CFMana",1,"HeldReady2")
	TNT1 A 0 A_StopSound(CHAN_6)
	FSPU A 2 Bright
	TNT1 A 0 A_Refire("HeldReady")
	Goto Ready
  HeldReady2:
	TNT1 A 0 A_PlaySound("FSWLOOP",CHAN_6,0.3,true)
	FSWD AABBCC 2 Bright
	TNT1 A 0 A_JumpIfNoAmmo("HeldReady")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright
	TNT1 A 0 A_JumpIfNoAmmo("HeldReady")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright
	TNT1 A 0 A_JumpIfNoAmmo("HeldReady")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	FSWD AABBCC 2 Bright
	TNT1 A 0 A_JumpIfNoAmmo("HeldReady")
	TNT1 A 0 A_GiveInventory("FlameSwordHealing",1)
	TNT1 A 0 A_Refire("HeldReady2")
	Goto Ready
  Altfire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_JumpIfInventory("CFMana",15,2)
	Goto Ready
	FSWD Z 2 Bright
  AltFireLoop:
    TNT1 A 0 A_JumpIfInventory("CFMana",15,1)
	Goto Ready
	TNT1 A 0 A_PlaySound("Firesword/fireswing",CHAN_WEAPON)
	TNT1 A 0 A_PlaySound("FSWRD1",2)
	FSWD D 2 Bright
	FSWD F 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,24,12,0)
	FSWD H 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,12,6,0)
	FSWD J 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,0,0,0)
	FSWD L 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,-12,-6,0)
	FSWD M 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,-24,-12,0)
	FSWD N 1 Bright
	FSWD OP 2 Bright
	FSWD QRS 1 Bright
	TNT1 A 20
	TNT1 A 0 A_Refire("AltfireLoop")
	FSWD TUVW 1
	Goto Ready
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("CFMana",15,1)
	Goto Ready
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,24,12,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",15,0,24,12,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",-15,0,24,12,0)
	FSWD H 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,12,6,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",15,0,12,6,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",-15,0,12,6,0)
	FSWD J 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,0,0,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",15,0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",-15,0,0,0,0)
	FSWD L 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,-12,-6,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",15,0,-12,-6,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",-15,0,-12,-6,0)
	FSWD M 1 Bright
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",0,1,-24,-12,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",15,0,-24,-12,0)
	TNT1 A 0 A_FireCustomMissile("FlameSwordProjectile",-15,0,-24,-12,0)
	FSWD N 1 Bright
	FSWD OP 2 Bright
	FSWD QRS 1 Bright
	TNT1 A 20
	TNT1 A 0 A_Refire("AltfireLoop")
	FSWD TUVW 1
	Goto Ready
  }
}

Actor FireSwordBulletPuff : BulletPuff
{
  +NOGRAVITY
  +PUFFGETSOWNER
  +PUFFONACTORS
  +EXTREMEDEATH
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +MTHRUSPECIES
  +THRUSPECIES
  +FRIENDLY
  +NODAMAGETHRUST
  Species "Player"
  DamageType "Player"
  AttackSound ""
  RenderStyle Add
  Alpha 0.8
  Scale 0.8
  VSpeed 0
  States
  {
  Spawn:
  Melee:
    TNT1 A 0 A_Explode(170,220)
    TNT1 A 0 A_PlaySound("saber/wallhit",1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 A 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    MISL BCD 6 Bright
	Stop	
  XDeath:
    TNT1 A 0 A_Explode(170,220)
    TNT1 A 0 A_PlaySound("Weapons/RockLX",1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 A 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_TakeInventory("CFMana",10,TIF_NOTAKEINFINITE,AAPTR_TARGET)
	//TNT1 A 0 A_GiveInventory("FlameSwordArmor",1,AAPTR_TARGET)
    MISL BCD 6 Bright
	Stop
  }
}

Actor FireSwordBulletPuffSpread : FireSwordBulletPuff
{
  States
  {
  Spawn:
  Melee:
    TNT1 A 0 A_Explode(100,150)
    TNT1 A 0 A_PlaySound("saber/wallhit",1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 A 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    MISL BCD 6 Bright
	Stop	
  XDeath:
    TNT1 A 0 A_Explode(100,150)
    TNT1 A 0 A_PlaySound("Weapons/RockLX",1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 A 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_TakeInventory("CFMana",5,TIF_NOTAKEINFINITE,AAPTR_TARGET)
	//TNT1 A 0 A_GiveInventory("FlameSwordArmor",1,AAPTR_TARGET)
    MISL BCD 6 Bright
	Stop
  }
}

Actor FlameSwordHealing : CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  -INVENTORY.INVBAR
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0
	TNT1 A 0 A_JumpIfHealthLower(200,1)
	Fail
	TNT1 A 0 Healthing(2,200)
	TNT1 A 0 A_TakeInventory("CFMana",1,TIF_NOTAKEINFINITE)
	Stop
  }
}

Actor DKSword
{   
  Radius 8
  Height 8
  Speed 1
  Projectile
  RenderStyle Normal
  -NOGRAVITY
  +LOWGRAVITY
  States
  {
  Spawn:
    SWRD KLMNOPQ 3 Bright
    Goto Death 
  Death:
    SWRD RS 4 Bright
    SWRD T 4 Bright
    SWRD U 4
    SWRD T 4 Bright
    SWRD U 8
    SWRD T 4 Bright
    SWRD U 16
    SWRD T 4 Bright
	SWRD U 8
	TNT1 A 1 Bright A_SpawnItemEx("FlameSwordGiver",0,0,0,0,0,0,0)
	Stop
  }
}

Actor FlameSwordProjectile
{
  Projectile
  Height 12
  Radius 3
  Speed 30
  Decal "Scorch"
  RenderStyle Add
  Damage (Random(55,75))
  Species "Player"
  +THRUSPECIES
  DamageType "PlayerFireSword"
  Seesound "monster/dkndrt"
  DeathSound "weapons/firex2"
  Obituary "%o was burned to a crisp by %k."
  States
  {
  Spawn:
	DKAT ABC 3 Bright
	Loop
  XDeath:
	TNT1 A 0 A_GiveToTarget("CFMana",2)
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION, frandom(0,360))
	DKAT D 4 Bright A_SetTranslucent(0.85,1)
	DKAT E 3 Bright A_SpawnitemEx("FlameSwordProjectileEffect")
	DKAT F 4 Bright A_Explode(60,64,0,1)
	DKAT G 3 Bright
	DKAT H 4 Bright
	DKAT I 3 Bright
	DKAT J 4 Bright
	DKAT KLM 3 Bright
	Stop
  }
}

Actor FlameSwordProjectileSpread : FlameSwordProjectile
{
  States
  {
  XDeath:
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DKAT D 4 Bright A_SetTranslucent(0.85,1)
	DKAT E 3 Bright A_SpawnitemEx("FlameSwordProjectileEffect")
	DKAT F 4 Bright A_Explode(60,64,0,1)
	DKAT G 3 Bright
	DKAT H 4 Bright
	DKAT I 3 Bright
	DKAT J 4 Bright
	DKAT KLM 3 Bright
	Stop
  }
}

Actor FlameSwordProjectileEffect
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  RenderStyle Translucent
  Alpha 0.6
  States
  {
  Spawn:
	TNT1 A 0
	DKAT NOPQRSTUVW 3 Bright
	Stop
  }
}

