Actor SubliminationSwordGiver : CustomInventory
{
  Scale 0.7
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "SubSword/Pickup"
  Inventory.PickupMessage "$CFSubliminationSwordPickup"
  +FLOATBOB
  Tag "$CFSubliminationSword"
  States
  {
  Spawn:
	WVBL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
  SpawnLoop:
	WVBL A 10
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",0,-1,7) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("FlameSword",1,3)
	TNT1 A 0 A_GiveInventory("SubliminationSword",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",23)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor SubliminationSwordSpawnerGiver : SubliminationSwordGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("FlameSword",1,3)
	TNT1 A 0 A_GiveInventory("SubliminationSword",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",23)
	TNT1 A 0 A_JumpIfInventory("SubliminationSwordGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("SubliminationSwordGiverCheck",1)
	TNT1 A 0 A_GiveInventory("CFMana",20)
	Stop
  }
}

Actor SubliminationSwordGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor SubliminationSword : DoomWeapon
{
  Scale 0.7
  Weapon.AmmoType1 "CFMana"
  Weapon.AmmoType2 "CFMana"
  Weapon.AmmoUse1 0
  Weapon.AmmoGive 0
  Weapon.SlotNumber 1
  Weapon.SlotPriority 5.0
  Weapon.UpSound "SubSword/Pickup"
  Inventory.PickupSound "SubSword/Pickup"
  Inventory.PickupMessage "$CFSubliminationSwordPickup"
  Weapon.PreferredSkin "Fist-Marine"
  Obituary "$CFSubliminationSwordObit"
  Tag "$CFSubliminationSword"
  +FLOATBOB
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  States
  {
  Spawn:
	WVBL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
  SpawnLoop:
	WVBL A 1
	Loop
  Ready:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	SBSW A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_Lower
	SBSW A 1 A_Lower
	Goto Deselect+1
  Select: 
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("SubliminationSword",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	SBSW A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("SubSwordModeToken1",1,"Fire2")
	TNT1 A 0 A_JumpIfInventory("SubSwordModeToken2",1,"Fire3")
	SBSW BC 2
  Refire:
	TNT1 A 0 A_PlaySound("Mainyu/Sword",1)
	TNT1 A 0 A_Quake(4,10,0,10,0)
	SBSW DEFGHI 1
	TNT1 A 0 A_CustomPunch((random(250,400)*random(1,2)),1,0,"SubSwordWallHit",128)
	SBSW JKLMN 1
	TNT1 A 5
	TNT1 A 0 A_Refire("Refire")
	Goto Done
  Fire2:
	TNT1 A 0 A_JumpIfInventory("CFMana",30,"Fire2Continue")
	Goto Ready
  Fire2Continue:
	SBSW BC 2
  Refire2:
	TNT1 A 0 A_PlaySound("Mainyu/Sword",1)
	TNT1 A 0 A_Quake(4,20,0,10,0)
	SBS2 AABBCCDDEEFF 1
	TNT1 A 0 A_TakeInventory("CFMana",30,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("PlayerMainyuSwordProjectile",0,0,0,0)
	TNT1 A 0 A_AlertMonsters
	SBS2 GGHHIIJJKK 1
	TNT1 A 5
	TNT1 A 0 A_JumpIfInventory("CFMana",30,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Refire("Refire2")
	TNT1 A 0
	Goto Done
  Fire3:
	TNT1 A 0 A_JumpIfInventory("CFMana",50,"Fire3Continue")
	Goto Ready
  Fire3Continue:
	SBSW BC 2
  Refire3:
	TNT1 A 0 A_PlaySound("Mainyu/Sword",1)
	TNT1 A 0 A_Quake(4,20,0,10,0)
	TNT1 A 0 A_TakeInventory("CFMana",50,TIF_NOTAKEINFINITE)
	SBS3 AABBCCDD 1
	TNT1 A 0 A_AlertMonsters
	SBS3 E 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",-7,0,0,0)
	SBS3 E 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",-5,0,0,0)
	SBS3 F 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",-3,0,0,0)
	SBS3 F 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",-1,0,0,0)
	SBS3 G 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",1,0,0,0)
	SBS3 G 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",3,0,0,0)
	SBS3 H 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",5,0,0,0)
	SBS3 H 1 A_FireCustomMissile("PlayerMainyuRedDarkMatter",7,0,0,0)
	SBS3 IIJJKK 1
	TNT1 A 5
	TNT1 A 0 A_JumpIfInventory("CFMana",50,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Refire("Refire3")
	TNT1 A 0
	Goto Done
  AltFire:	
	TNT1 A 0 A_JumpIfInventory("SubSwordModeToken1",1,"AltFire2")
	TNT1 A 0 A_JumpIfInventory("SubSwordModeToken2",1,"AltFire3")
	TNT1 A 0 A_GiveInventory("SubSwordModeToken1")
	SBSW A 1 A_Print("$SSwordMessage1",1.5)
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  AltFire2:	
	TNT1 A 0 A_TakeInventory("SubSwordModeToken1")
	TNT1 A 0 A_GiveInventory("SubSwordModeToken2")
	SBSW A 1 A_Print("$SSwordMessage2",1.5)
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  AltFire3:	
	TNT1 A 0 A_TakeInventory("SubSwordModeToken1")
	TNT1 A 0 A_TakeInventory("SubSwordModeToken2")
	SBSW A 1 A_Print("$SSwordMessage3",1.5)
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  Done:
	SBSW OPQR 2
	Goto Ready	
  NoAutoAltFirePls:
	SBSW A 1
	SBSW A 1 A_Refire("NoAutoAltFirePls")
	Goto Ready
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready
  GrenadeToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	SBSW ABC 2
	TNT1 A 3
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	SBSW CBA 2
	Goto Ready
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	SBSW ABC 2
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	SBSW CBA 2
	Goto Ready
  }
}

Actor SubSwordModeToken1 : Inventory { }
Actor SubSwordModeToken2 : Inventory { }

Actor SubSwordWallHit : PlayerModdedBulletPuff
{
  +NOGRAVITY
  +PUFFGETSOWNER
  +PUFFONACTORS
  +EXTREMEDEATH
  +FOILINVUL
  DamageType "Melee"
  AttackSound "SubSword/WallHit"
  SeeSound "Mainyu/Meleehit"
  RenderStyle Add
  Alpha 0.8
  Scale 0.8
  States
  {
  Spawn:
  Melee:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,"Alt")
	EX97 ABCDEFGHIJ 1 Bright A_FadeOut(0.08)
	Stop
  Alt:
	EX98 ABCDEFGHIJ 1 Bright A_FadeOut(0.08)
	Stop	
  XDeath:
	TNT1 F 0 
	FAXE F 3 A_GiveToTarget("SubliminationHealth",random(10,20))
	TNT1 A 0 A_GiveToTarget("SubliminationArmor",1)
	FAXE GHIJK 3
	Stop
  }
}

Actor SubliminationHealth : Health { Inventory.MaxAmount 1200 }

Actor SubliminationArmor : FakeArmorBonus  { Armor.SaveAmount 10 }
