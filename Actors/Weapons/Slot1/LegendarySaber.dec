Actor LegendarySaberGiver : CustomInventory
{
  Scale 0.7
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "Saber/Pickup"
  Inventory.PickupMessage "$CFLegendarySaberPickup"
  Obituary "$CFLegendarySaberObit"
  Tag "$CFLegendarySaber"
  States
  {
  Spawn:
	HEVB A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
	HEVB A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",1,15,7,1) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendarySaber",1,3)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",22)
	TNT1 A 0 A_GiveInventory("LegendarySaber",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",40)
	TNT1 A 0 A_GiveInventory("CFMana",50)
	Stop
  }
}

Actor LegendarySaberSpawnerGiver : LegendarySaberGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendarySaber",1,3)
	TNT1 A 0 A_GiveInventory("LegendarySaber",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",22)
	TNT1 A 0 A_JumpIfInventory("LegendarySaberGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendarySaberGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",40)
	TNT1 A 0 A_GiveInventory("CFMana",50)
	Stop
  }
}

Actor LegendarySaberGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendarySaber : DoomWeapon
{
  Scale 0.7
  Weapon.AmmoType1 "LDemonAmmo"
  Weapon.AmmoType2 "CFMana"
  Weapon.AmmoUse1 0
  Weapon.AmmoUse2 0
  Weapon.AmmoGive1 0
  Weapon.AmmoGive2 0
  Weapon.SelectionOrder 1400
  //Weapon.MinSelectionAmmo1 15
  //Weapon.MinSelectionAmmo1 20
  Weapon.SlotNumber 1
  Weapon.SlotPriority 7.0
  Inventory.PickupSound "Saber/Pickup"
  Inventory.PickupMessage "$CFLegendarySaberPickup"
  Weapon.PreferredSkin "Fist-Marine"
  Obituary "%o was amazed that %k actually got this obituary to appear."
  Tag "$CFLegendarySaber"
  +WEAPON.AMMO_OPTIONAL
  States
  {
  Spawn:
	HEVB A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
	HEVB A -1
	Stop
  Ready:
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20,"Ready2")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LGSB A 1 A_WeaponReady(WRF_ALLOWZOOM)
	Loop
  Ready2:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LSB2 AAAA 1 A_WeaponReady(WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LSB2 BBBB 1 A_WeaponReady(WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LSB2 CCCC 1 A_WeaponReady(WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LSB2 DDDD 1 A_WeaponReady(WRF_ALLOWZOOM)
	Loop
  Deselect:
	TNT1 A 0 A_PlaySound("weapons/weapondown",1)
	TNT1 A 0 A_Lower
	LGSB A 1 A_Lower
	Goto Deselect+1
  Select: 
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendarySaber",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	LGSB A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15,"Fire2")
	Goto FireNoAmmo
  Fire2:
	LSB2 EF 2
  Refire2:
	TNT1 A 0 A_PlaySound("Saber/Swing",1)
	TNT1 A 0 A_Quake(3,10,0,10,0)
	LGSB DE 1
	LSB2 GHIJ 1
	TNT1 A 0 A_CustomPunch(random(400,500),1,0,"SaberBulletPuff2",110)
	LSB2 KLMNOP 1
	TNT1 A 4
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15,2)
	TNT1 A 0 A_Jump(256,"Done2")
	TNT1 A 0 A_Refire("Refire2")
	Goto Done2
  FireNoAmmo:
	LGSB BC 2
  RefireNoAmmo:
	TNT1 A 0 A_PlaySound("Saber/Swing",1)
	TNT1 A 0 A_Quake(3,10,0,10,0)
	LGSB DEFGHIJ 1
	TNT1 A 0 A_CustomPunch(random(100,150),1,0,"SaberBulletPuff",110)
	LGSB KLM 1
	//LGSB JKLM 1
	TNT1 A 6
	TNT1 A 0 A_Refire("RefireNoAmmo")
	Goto Done
  AltFire:
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20,"AltFireContinue")
	Goto Ready
  AltFireContinue:
	LSB2 EF 2
  AltFireRefire:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireRefireSpread")
	TNT1 A 0 A_PlaySound("Saber/Swing",1)
	TNT1 A 0 A_PlaySound("Saber/AltSwing",7)
	TNT1 A 0 A_Quake(4,20,0,10,0)
	LGSB DE 2
	LSB2 GHIJ 2
	TNT1 A 0 A_TakeInventory("LDemonAmmo",20,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("PlayerCrusaderRazorWind",0,0,0,0)
	LSB2 KLMNOP 2
	TNT1 A 5
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Refire("AltFireRefire")
	TNT1 A 0
	Goto Done2
  AltFireRefireSpread:
	TNT1 A 0 A_PlaySound("Saber/Swing",1)
	TNT1 A 0 A_PlaySound("Saber/AltSwing",7)
	TNT1 A 0 A_Quake(4,20,0,10,0)
	LGSB DE 2
	LSB2 GHIJ 2
	TNT1 A 0 A_TakeInventory("LDemonAmmo",20,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("PlayerCrusaderRazorWind",0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerCrusaderRazorWind",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerCrusaderRazorWind",-15.0,0,0,0)
	LSB2 KLMNOP 2
	TNT1 A 5
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Refire("AltFireRefire")
	TNT1 A 0
	Goto Done2
  Done:
	LGSB NOPQ 2 Bright
	Goto Ready	
  Done2:
	LSB2 RSTU 2 Bright
	Goto Ready	
  Zoom:
	TNT1 A 0 A_JumpIfInventory("CFMana",150,"ResistanceBuff")
	Goto Ready
  ResistanceBuff:
	TNT1 A 0 A_JumpIfInventory("SaberBuffResistanceCheck",1,"FakeBuff")
	LSB2 EF 2
	TNT1 A 0 A_PlaySound("Saber/Buff",1)
	TNT1 A 0 A_Quake(4,20,0,10,0)
	LGSB DE 2
	LSB2 GHIJ 2
	TNT1 A 0 A_TakeInventory("CFMana",150)
	TNT1 A 0 A_SpawnItemEx("SaberPlayerResistanceBuffGiver",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	LSB2 KLMNOP 2
	TNT1 A 5
	Goto Done2
  FakeBuff:
	LSB2 EF 2
	LGSB DE 2
	LSB2 GHIJKLMNOP 2
	TNT1 A 5
	Goto Done2
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+6
  GrenadeToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LGSB ABC 2
	TNT1 A 3
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	LGSB CBA 2
	Goto Ready+6
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LGSB ABC 2
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	LGSB CBA 2
	Goto Ready
  }
}

Actor SaberPlayerResistanceBuffGiver
{
  +NOGRAVITY
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_RadiusGive("SaberPlayerResistanceBuff",800,RGF_PLAYERS)
	TNT1 A 1
	Stop
  }
}

Actor SaberPlayerResistanceBuff : CrusaderBuff
{
  States
  {
  Pickup:
	TNT1 A 1
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") > 0,"Nope")
	TNT1 A 0 A_JumpIfInventory("SaberBuffResistanceCheck",1,"Nope")
	TNT1 A 0 A_SetBlend("Blue",0.8,20)
	TNT1 A 0 A_Print("$LSaberMessage1",3)
	TNT1 A 0 A_PlaySound("Saber/Resistance",0,1.0,0,ATTN_STATIC)
	TNT1 A 0 A_GiveInventory("SaberBuffResistanceCheck")
	TNT1 A 0 A_GiveInventory("SaberResistanceGiver")
	TNT1 A 0 ACS_NamedExecuteAlways("SaberResistanceBuff")
	Stop
  Nope:
	TNT1 A 0
	Stop
	}
}

Actor PlayerCrusaderRazorWind : CrusaderRazorWind { DamageType "PlayerLegendary" }

Actor SaberBuffResistanceCheck : Inventory {}
Actor SaberResistance : PowerProtection { DamageFactor "Normal", 0.5 }
Actor SaberResistanceGiver : PowerupGiver
{
  Inventory.PickupMessage " "
  Inventory.MaxAmount 1
  Powerup.Type "SaberResistance"
  Powerup.Duration -30
  Powerup.Color Blue, 0.2
  +NOTIMEFREEZE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
}

Actor SaberBulletPuff : PlayerModdedBulletPuff
{
  +NOGRAVITY
  +PUFFGETSOWNER
  +PUFFONACTORS
  +EXTREMEDEATH
  +NOTIMEFREEZE
  DamageType "PlayerLegendary"
  AttackSound "Saber/WallHit"
  SeeSound "Saber/Hit"
  RenderStyle Add
  Alpha 0.8
  Scale 0.8
  VSpeed 0
  States
  {
  Spawn:
  Melee:
	LSAK ABCDEFG 2 Bright A_FadeOut(0.1)
	Stop	
  XDeath:
	FAXE FGHIJK 3
	Stop
  }
}

Actor SaberBulletPuff2 : SaberBulletPuff
{
  VSpeed 0
  ProjectileKickBack 50
  Damagetype "PlayerLegendary"
  States
  {
  Spawn:
  Melee:
	LSAR ABCDEFG 2 Bright A_FadeOut(0.1)
	Stop	
  XDeath:
	TNT1 A 0 A_SetScale(0.65)
	TNT1 A 0 A_PlaySound("Saber/Explode",7)
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_TakeInventory("LDemonAmmo",15,TIF_NOTAKEINFINITE,AAPTR_TARGET)
	LSX0 ABCDEFG 3
	Stop
  }
}