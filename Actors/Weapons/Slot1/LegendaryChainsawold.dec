Actor LegendaryChainsawGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "Legendary Chainsaw"
  Inventory.PickupSound "weapons/pickupsaw"
  Tag "Legendary Chainsaw"
  States
  {
  Spawn:
    CLSW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
	CLSW A -1 Bright
    Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryChainsaw",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryChainsaw",1)
	TNT1 A 0 A_JumpIfInventory("LegendaryChainsawGiverCheck",1,"HoldAndDestroy")
	TNT1 A 0 A_GiveInventory("LegendaryChainsawGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",Random(50,100))
	Stop
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryChainsawGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryChainsawGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",Random(50,100))
	TNT1 A 0 A_SpawnItemEx("LegendaryChainsaw")
	Stop
  }
}

Actor LegendaryChainsawSpawnerGiver : LegendaryChainsawGiver
{
  States
  {
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryChainsawGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryChainsawGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",Random(50,100))
	Stop
  }
}

Actor LegendaryChainsawGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryChainsaw : Weapon 18600
{
  //$Category Weapons/LCA/DJB
  //$Sprite CLSWA0
  //$Title "Legendary Chainsaw"
  Weapon.Selectionorder 10
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "Chainsaw-Marine"
  Weapon.SlotNumber 1
  Weapon.SlotPriority 6.0
  Weapon.SlotNumber 1
  Weapon.AmmoGive 0
  Weapon.AmmoUse 1
  Weapon.AmmoUse2 5
  Weapon.AmmoType "LDemonAmmo"
  Weapon.AmmoType2 "LDemonAmmo"
  Inventory.PickupSound "weapons/pickupsaw"
  Inventory.PickupMessage "Legendary Chainsaw"
  Obituary "%o was sawed into many small pieces by %k with Legendary Chainsaw"
  Tag "Legendary Chainsaw"
  States
  {
  Spawn:
    CLSW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",1,1)
	CLSW A -1 Bright
    Stop
  Ready:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("LegendaryChainHold",1)
	TNT1 A 0 A_TakeInventory("LegendaryChainAltHold",1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,"Ready1")
	Goto Empty
  Ready1:
	TNT1 A 0 A_PlaySound("weapons/legChainSawIdle",7,1.0,1)
	LSWH ABCDEFG 1
	LSWH H 1 A_WeaponReady
  ReadyLoop:
	LSWH ABCDEFGH 1 A_WeaponReady
	Loop
  Empty:
	TNT1 A 0 A_StopSound(7)
  EmptyLoop:
	LSWH A 1 A_WeaponReady(WRF_NOFIRE)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,"Ready1")
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryChainsaw",1)
	//Stop
  SelectLoop:
	LSWH A 0 A_PlayWeaponSound("weapons/weapondown")
    LSWH A 0 A_Raise
	LSWH A 1 A_Raise
	Goto SelectLoop+1
  Deselect:
    TNT1 A 0
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
    TNT1 A 0 A_TakeInventory("MineAction",1)
    TNT1 A 0 A_TakeInventory("RailgunAction",1)
    TNT1 A 0 A_TakeInventory("LegendaryChainHold",1)
    TNT1 A 0 A_TakeInventory("LegendaryChainAltHold",1)
  DeselectLoop:
    TNT1 A 0 A_StopSound(7)
    LSWH A 1 A_Lower
	Goto DeSelectLoop+1
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto Ready
	LSWL AB 1 Bright
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
    TNT1 A 0
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    LSWN B 2 Bright A_Saw("weapons","weapons/sawhit",Random(50,70),"PlayerLegSawScreech",SF_NOUSEAMMOMISS|SF_NORANDOM,80)//|SF_STEALARMOR,65,2.8125,0,1)
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto HoldEnd
    TNT1 A 0 A_Refire
    Goto HoldEnd
  Hold:
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto Ready
    TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"Holdloop")
    TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",7,1.0,1)
  HoldLoop:
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    LSWN C 2 Bright A_Saw("weapons","weapons/sawhit",Random(50,70),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,80)//|SF_STEALARMOR,65,2.8125,0,1)
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto HoldEnd
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    LSWN D 2 Bright A_Saw("weapons","weapons/sawhit",Random(50,70),"PlayerLegSawScreech",SF_NOUSEAMMOMISS|SF_NORANDOM,80)//|SF_STEALARMOR,65,2.8125,0,1)
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto HoldEnd
    TNT1 A 0 A_JumpIfInventory("LegendaryChainHold",1,"HoldRefire")
    TNT1 A 0
    TNT1 A 0 A_GiveInventory("LegendaryChainHold",1)
  HoldRefire:
    TNT1 A 0 A_Refire
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    LSWN E 2 Bright A_Saw("weapons","weapons/sawhit",Random(50,70),"PlayerLegSawScreech",SF_NOUSEAMMO|SF_NORANDOM,80)//|SF_STEALARMOR,65,2.8125,0,1)
    TNT1 A 0
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",1,1)
    Goto HoldEnd
    TNT1 A 0 Radius_Quake(1,2,0,1,0)
    LSWN F 2 Bright A_Saw("weapons","weapons/sawhit",Random(50,70),"PlayerLegSawScreech",SF_NOUSEAMMOMISS|SF_NORANDOM,80)//|SF_STEALARMOR,65,2.8125,0,1)
  HoldEnd:
    LSWH ABCDEFGH 1
	//LSWL BA 4
	Goto Ready
  AltFire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,1)
    Goto Ready
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
    TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"AltFireLoop")
  AltFireLoop:
    LSWN ABCDE 1 Bright
    LSWN F 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,1,-15,-20)
    LSWN A 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,1,15,-20)
    LSWN BCDEF 1 Bright
    TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"AltFireRefire")
    TNT1 A 0 A_GiveInventory("LegendaryChainAltHold",1)
  AltFireRefire:
    TNT1 A 0 A_Refire
    LSWH ABCDEFGH 1
	//LSWL BA 4
	Goto Ready
  AltFireSpread:
    TNT1 A 0
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
    TNT1 A 0 A_JumpIfInventory("LDemonAmmo",10,1)
    Goto Ready
    TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"AltFireSpreadLoop")
  AltFireSpreadLoop:
    LSWN ABCDE 1 Bright
    LSWN F 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,1,-15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",15.0,0,-15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",-15.0,0,-15,-20)
    LSWN A 1 Bright A_FireCustomMissile("PlayerLegPChainRipper",0,1,15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",15.0,0,15,-20)
	TNT1 A 0 A_FireCustomMissile("PlayerLegPChainRipper",-15.0,0,15,-20)
    LSWN BCDEF 1 Bright
    TNT1 A 0 A_JumpIfInventory("LegendaryChainAltHold",1,"AltFireSpreadRefire")
    TNT1 A 0 A_GiveInventory("LegendaryChainAltHold",1)
  AltFireSpreadRefire:
    TNT1 A 0 A_Refire
    LSWH ABCDEFGH 1
	//LSWL BA 4
	Goto Ready
  }
}

Actor LegSawScreech : PlayerModdedBulletPuff
{
  Scale 0.4
  RenderStyle Add
  Alpha 0.8
  DamageType "PlayerLegendary"
  AttackSound "Weapons/SawScreech"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("SawParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Jump(128,"Alt")
    FX97 ABCDEFGHIJ 1 Bright A_FadeOut(0.08,1)
    Stop
  Alt:
    FX98 ABCDEFGHIJ 1 Bright A_FadeOut(0.08,1)
    Stop   
  }
}

Actor PlayerLegSawScreech : LegSawScreech { DamageType "PlayerLegendary" }

Actor PlayerLegPChainRipper : LegChainRipper
{
  Radius 4
  Height 6
  Speed 70
  Damage (Random(60,80))
  BounceCount 4
  DamageType "PlayerLegendary"
  +MTHRUSPECIES
}
 
Actor LegendaryChainHold : Ammo {}
Actor LegendaryChainAltHold : Ammo {}