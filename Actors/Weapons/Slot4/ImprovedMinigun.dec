Actor ImprovedMinigunGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "ImprovedMinigun/Up"
  Inventory.PickupMessage "$CFImprovedMinigunPickup"
  Tag "$CFImprovedMinigun"
  States
  {
  Spawn:
	IMMH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
  SpawnLoop:
	IMMH A 10
	IMMH A 10 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",9,-1,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("ImprovedMinigun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("ImprovedMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",51)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("BulletMag",30)
	Stop
  }
}

Actor ImprovedMinigunSpawnerGiver : ImprovedMinigunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("ImprovedMinigun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("ImprovedMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",51)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("ImprovedMinigunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("ImprovedMinigunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("BulletMag",30)
	Stop
  }
}

Actor ImprovedMinigunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor ImprovedMinigun : DoomWeapon 30320
{
  //+WEAPON.NOAUTOAIM
  Weapon.PreferredSkin "Minigun-Marine"
  Weapon.KickBack 50
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 7.0
  Weapon.AmmoType "BulletMag"
  Weapon.AmmoType2 "BulletMag"
  Weapon.SelectionOrder 1500
  +WEAPON.NOALERT
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Inventory.PickupSound "ImprovedMinigun/Up"
  Inventory.PickupMessage "$CFImprovedMinigunPickup"
  Obituary "$CFImprovedMinigunObit"
  Tag "$CFImprovedMinigun"
  States
  {
  Spawn:
	IMMH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
  SpawnLoop:
	IMMH A 10
	IMMH A 10 Bright
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("ImprovedMinigun/Up")
	IMMG GHIJA 1
  ReadyLoop:
	IMMG A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	IMMG A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("ImprovedMinigun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Loop
  Fire:
	//TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"Firing")
	//TNT1 A 0 A_JumpIfInventory("ExpMinigunActive",1,"Firing")
	TNT1 A 0 A_JumpIfNoAmmo("ReadyLoop")
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstart",7)
	IMMG BCD 2
	IMMG ABCDABCD 1
  Hold:
	TNT1 A 0 A_JumpIfNoAmmo("ReadyLoop")
	TNT1 A 0 A_PlaySound("weapons/expmgunspin",7)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FiringSpread")
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	IMMG E 1 Bright A_FireBullets(4.3,2.6,-1,random(60,70),"PlayerExosBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Recoil(2)
	IMMG BCD 1 A_Light0
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 A_Light2
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	IMMG F 1 Bright A_FireBullets(4.3,2.6,-1,random(60,70),"PlayerExosBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Recoil(2)
	IMMG BCD 1 A_Light0
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	TNT1 A 0 A_ReFire("Hold")
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop")
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstop",7)
	IMMG ABCDABCD 1
	IMMG ABCD 2
	IMMG ABCD 3
	Goto ReadyLoop
  FiringSpread:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/expmgunspin",7)
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 //A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireFastBullet",random(-43,43)-150,random(-26,26),random(60,70))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireFastBullet",random(-43,43)+150,random(-26,26),random(60,70))
	IMMG E 1 Bright A_FireBullets(4.3,2.6,-1,random(60,70),"PlayerExosBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Recoil(2)
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	IMMG ABCD 1 //A_Light0
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 //A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireFastBullet",random(-43,43)-150,random(-26,26),random(60,70))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireFastBullet",random(-43,43)+150,random(-26,26),random(60,70))
	IMMG F 1 Bright A_FireBullets(4.3,2.6,-1,random(60,70),"PlayerExosBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Recoil(2)
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	IMMG ABCD 1 //A_Light0
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop")
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstop",7)
	IMMG ABCDABCD 1
	IMMG ABCD 2
	IMMG ABCD 3
	Goto ReadyLoop
  AltFire:
	Goto ReadyLoop
  EmptySpinDown:
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop")
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstop",7)
	IMMG ABCDABCD 1
	IMMG ABCD 2
	IMMG ABCD 3
	Goto ReadyLoop
  }
}

Actor ImpMinigunActive : Inventory {}
Actor ImpMinigunActive2 : Inventory {}

Actor PlayerExosBulletPuff : ModdedBulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +EXTREMEDEATH
  Species "Player"
  DamageType "Normal"
}