Actor MP40Giver : CustomInventory
{
  Scale 0.65
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "MP40/MagIn"
  Inventory.PickupMessage "$CFMP40Pickup"
  Tag "$CFMP40"
  States
  {
  Spawn:
	MP4P A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MP4P A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",71,17,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("MP-40",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,8)
	TNT1 A 0 A_GiveInventory("MP-40",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",53)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("MP40Mag",Random(16,33))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor MP40SpawnerGiver : MP40Giver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("MP-40",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,8)
	TNT1 A 0 A_GiveInventory("MP-40",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",53)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("MP40GiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("MP40GiverCheck",1)
	TNT1 A 0 A_GiveInventory("MP40Mag",Random(16,33))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor MP40GiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor MP-40 : Weapon //19357
{
  Scale 0.65
  Decal "BulletChip"
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "MP40-Marine"
  Weapon.KickBack 50
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 2.0
  Weapon.AmmoType "MP40Mag"
  Weapon.AmmoType2 "BulletMag"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  AttackSound "MP40/Fire"
  Inventory.PickupSound "MP40/MagIn"
  Inventory.PickupMessage "$CFMP40Pickup"
  Obituary "$CFMP40Obit"
  Tag "$CFMP40"
  States
  {
  Spawn:
	MP4P A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MP4P A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("MP40/MagIn")
	MPRS ABCDE 1
  ReadyLoop:
	MP40 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	MP40 A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_Light1
	TNT1 A 0 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	MP40 B 2 Bright A_FireBullets(3.6,2.3,1,Random(8,10),"PlayerModdedBulletPuff")
	MP40 C 1 A_Light0
	MP40 D 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_Light1
	TNT1 A 0 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	MP40 B 2 Bright A_FireBullets(3.6,2.3,1,Random(8,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-36,36)-150,random(-23,23),random(8,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-36,36)+150,random(-23,23),random(8,30))
	MP40 C 1 A_Light0
	MP40 D 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	MP40 AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	Goto Reload
  Reload:
	TNT1 A 0 A_JumpIfInventory("MP40Mag",0,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload2")
	TNT1 A 0
	Goto ReadyLoop
  Reload2:
	TNT1 A 0 A_JumpIfInventory("MP40Mag",1,"MaxReload")
	MP4R NM 1
	MP4R LAB 1
	MP4R C 1 A_PlaySound("MP40/MagOut",CHAN_6)
	MP4R DE 1
	MP4R F 15 A_FireCustomMissile("MP40EmptyMagSpawner",0,0,0,1)
	MP4R EDC 2
	MP4R B 3 A_PlaySound("MP40/MagIn",CHAN_6)
	MP4R A 3
	MP4R G 2
	MP4R H 3 A_PlaySound("MP40/Cock",CHAN_6)
	MP4R I 3	
	MP4R JKL 2
	MP4R MN 1
	MP40 A 2
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"ActualReload")	 
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("MP40Mag",1)
	TNT1 A 0 A_JumpIfInventory("MP40Mag",32,2)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"ActualReload")
	TNT1 A 0 
	Goto ReadyLoop
  MaxReload:
	MP4R NM 1
	MP4R LAB 1
	MP4R C 1 A_PlaySound("MP40/MagOut",CHAN_6)
	MP4R DE 1
	MP4R F 15 A_FireCustomMissile("MP40EmptyMagSpawner",0,0,0,1)
	MP4R ED 2
	MP4R C 2 A_PlaySound("MP40/MagIn",CHAN_6)
	MP4R BA 2
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"MaxReload2")
	Goto MaxReload2
  MaxReload2:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("MP40Mag",1)
	TNT1 A 0 A_JumpIfInventory("MP40Mag",33,2)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"MaxReload2")
	Goto Full
  Full:
	MP4R L 2
	MP4R MN 1
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	MPRS EDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	MPRS EDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1	 
  }
}

Actor MP40Mag : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 33
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 33
  Inventory.Icon "MP4HA0"
  +IGNORESKILL
}