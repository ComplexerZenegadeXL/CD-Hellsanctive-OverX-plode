Actor MinigunGiver : CustomInventory
{
  Scale 0.75
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/minigunpickup"
  Inventory.PickupMessage "$CFMinigunPickup"
  Tag "$CFMinigun"
  States
  {
  Spawn:
	MNGN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MNGN A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",77,-1,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFMinigun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("ExplosiveMinigun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",46)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor MinigunSpawnerGiver : MinigunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFMinigun",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("ExplosiveMinigun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",46)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("MinigunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("MinigunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor MinigunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CFMinigun : DoomWeapon //19347
{
  Scale 0.75
  Weapon.PreferredSkin "Minigun-Marine"
  Weapon.KickBack 50
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 3.0
  Weapon.AmmoType "BulletMag"
  Weapon.AmmoType2 "BulletMag"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3001
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Inventory.PickupSound "weapons/minigunpickup"
  Inventory.PickupMessage "$CFMinigunPickup"
  Obituary "$CFMinigunObit"
  Tag "$CFMinigun"
  States
  {
  Spawn:
	MNGN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MNGN A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/minigunpickup")
	MGRS ABCDE 1
  ReadyLoop:
	CHAG A 1 A_WeaponReady
	Loop
 Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	CHAG A 1 A_Lower
	Loop
  Select:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("ReadyLoop")
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("weapons/mgunspin",CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	CHAF A 1 Bright A_FireBullets(4.3,2.6,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	CHAF BC 1 A_Light0
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	CHAF D 1 Bright A_FireBullets(4.3,2.6,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")	
	CHAF EF 1 A_Light0
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,-4),0,0,frandom(4,4))
	CHAF G 1 Bright A_FireBullets(4.8,2.4,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")	
	CHAF H 1 A_Light0
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop",CHAN_6)
	CHAG ABCDABCDABCDABCD 1
	CHAG ABCD 2
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_PlaySound("weapons/mgunspin",CHAN_6)
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
	CHAF A 1 Bright A_FireBullets(4.3,2.6,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)-150,random(-26,26),random(7,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)+150,random(-26,26),random(7,30))
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
	CHAF BC 1 A_Light0
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light2
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
	CHAF D 1 Bright A_FireBullets(4.3,2.6,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)-150,random(-26,26),random(7,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)+150,random(-26,26),random(7,30))
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")	
	CHAF EF 1 A_Light0
	TNT1 A 0 A_PlaySound("weapons/minigunfire",CHAN_WEAPON)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("CFTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
	CHAF G 1 Bright A_FireBullets(4.8,2.4,-1,Random(7,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)-150,random(-26,26),random(7,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-43,43)+150,random(-26,26),random(7,30))
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")	
	CHAF H 1 A_Light0
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop",CHAN_6)
	CHAG ABCDABCDABCDABCD 1
	CHAG ABCD 2
	Goto ReadyLoop
  EmptySpinDown:
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop",CHAN_6)
	CHAG ABCDABCDABCDABCD 1
	CHAG ABCD 2
	Goto ReadyLoop
  }
}
