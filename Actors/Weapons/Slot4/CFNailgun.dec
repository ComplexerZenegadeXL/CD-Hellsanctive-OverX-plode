Actor BaseExplosionDamage // this is necessary, calling A_Explode in actor can cause unwanted effects.
{
  Speed 0
  Height 4
  Radius 4
  Damage (0)
  +MISSILE
  +NOBLOCKMAP
  +NOGRAVITY
  -TELESTOMP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1
	Stop
  }
}

Actor NailExplosion
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(256, "Spawn1", "Spawn2", "Spawn3", "Spawn4", "Spawn5", "Spawn6", "Spawn7", "Spawn8", "Spawn9", "Spawn10")
	Goto Spawn1
  Spawn1:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX1") 
    Stop
  Spawn2:
    TNT1 A 0 A_SpawnItemEx("ExplosionFX2")
	Stop
  Spawn3:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX3")
	Stop
  Spawn4:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX4")
	Stop
  Spawn5:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX5")
	Stop
  Spawn6:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX6")
	Stop
  Spawn7:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX7")
	Stop
  Spawn8:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX8")
	Stop
  Spawn9:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX9")
	Stop
  Spawn10:
	TNT1 A 0 A_SpawnItemEx("ExplosionFX10")
	Stop
  }
}

Actor ExplosiveNailProjectile : BaseExplosionDamage
{
  Species "Player"
  DamageType "EXPNail"
  Radius 3
  Height 4
  Damage (Random(15,25))
  Speed 50
  Scale 0.5
  +MISSILE
  +MISSILEMORE
  +MISSILEEVENMORE
  +THRUSPECIES
  Projectile
  States 
  {
  Spawn:
	NAIL B 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("PlayerModdedBulletPuff",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NailExplosion")
	TNT1 A 0 A_Explode (Random(25,50),64)
	NWAL AAAAAAAAAAAAAAAAAAAA 1 A_FadeOut(0.05)
	Stop
  }
}
