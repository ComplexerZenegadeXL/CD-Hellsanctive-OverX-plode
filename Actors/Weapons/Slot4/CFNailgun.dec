Actor NailgunGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFNailgunPickup"
  Inventory.PickupSound "weapons/pickup"
  Tag "$CFNailgun"
  States
  {
  Spawn:
	NAIG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	NAIG A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",36,-1,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("Nailgun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("Nailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",47)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("BulletMag",Random(25,50))
	Stop
  }
}

Actor NailgunSpawnerGiver : NailgunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("Nailgun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("Nailgun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",47)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("NailgunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("NailgunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("BulletMag",Random(25,50))
	Stop
  }
}

Actor NailgunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor Nailgun : DoomWeapon 18651
{
  //$Category Weapons/LCA/DJB
  //$Sprite NAIGA0
  //$Title "Nailgun"
  Weapon.PreferredSkin "Nailgun-Marine"
  Weapon.SelectionOrder 315
  Weapon.AmmoType "BulletMag"
  Weapon.AmmoType2 "BulletMag"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 1
  Weapon.AmmoUse2 2
  Weapon.SlotNumber 4
  Weapon.SlotPriority 4.0
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Inventory.PickupSound "weapons/pickup"
  Inventory.PickupMessage "$CFNailgunPickup"
  Obituary "$CFNailgunObit"
  Tag "$CFNailgun"
  States
  {
  Spawn:
	NAIG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	NAIG A -1
	Stop
  Ready:
	NGUN A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	NGUN A 1 A_Lower
	Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("Nailgun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	NGUN A 1 A_Raise
	TNT1 A 0 A_Raise		
	Goto SelectLoop+1
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))  
	NGUN B 1 Bright Offset(0,34)
	NGUN C 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	NGUN D 1 Bright Offset(0,34)
	NGUN E 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	NGUN A 1 A_Refire
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	NGUN B 1 Bright Offset(0,34)
	NGUN C 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	NGUN D 1 Bright Offset(0,34)
	NGUN E 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	NGUN A 1 A_Refire
	Goto Ready
  FireSpread:
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1)+15.0,0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1)-15.0,0,0,0,0,frandom(-1,1))
	NGUN B 1 Bright Offset(0,34)
	NGUN C 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1)+15.0,0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("NailProjectile", frandom(-1,1)-15.0,0,0,0,0,frandom(-1,1))
	NGUN D 1 Bright Offset(0,34)
	NGUN E 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	NGUN A 1 A_Refire
	Goto Ready
  AltFireSpread:
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1)+15.0,0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1)-15.0,0,0,0,0,frandom(-1,1))
	NGUN B 1 Bright Offset(0,34)
	NGUN C 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	TNT1 A 0 A_PlayWeaponSound("weapons/nailfire")
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1),1,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1)+15.0,0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_FireCustomMissile("ExplosiveNailProjectile", frandom(-1,1)-15.0,0,0,0,0,frandom(-1,1))
	NGUN D 1 Bright Offset(0,34)
	NGUN E 1 Bright Offset(0,37)
	NGUN A 1 Offset(0,35)
	NGUN A 1 Offset(0,33)
	NGUN A 1
	NGUN A 1 A_Refire
	Goto Ready
  Flash:
	TNT1 A 1 A_Light1
	TNT1 A 1 A_Light2
	TNT1 A 1 A_Light1
	TNT1 A 1 A_Light0
	Stop
  }
}

Actor NailProjectile
{
  Projectile
  Radius 3
  Height 4
  Speed 40
  Damage (Random(5,10))
  Scale 0.5
  +RIPPER
  +DONTBLAST
  +MTHRUSPECIES
  +BLOODSPLATTER
  +DONTREFLECT
  +NODAMAGETHRUST
  SeeSound ""
  DeathSound ""
  Decal "BulletChip"
  States
  {
  Spawn:
    NAIL A 1
    TNT1 A 0
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("PlayerModdedBulletPuff",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NWAL AAAAAAAAAAAAAAAAAAAA 1 A_FadeOut(0.05)
    Stop
  }
}

Actor ExplosionFX1
{
  Speed 3
  Damage 0
  Renderstyle Add
  Alpha 0.75
  Projectile
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOGRAVITY
  +MISSILE
  +FORCEXYBILLBOARD
  +NOINTERACTION
  +DONTBLAST
  Species "Player"
  DamageType "EXPNail"
  Scale 0.15
  States
  {
  Spawn:
	TNT1 A 0 A_PlaySound("weapons/rocklx")
	TNT1 A 1 
	EXP0 ABCDEFGH 1 Bright A_FadeOut(0.05)
	Stop
  }
}

