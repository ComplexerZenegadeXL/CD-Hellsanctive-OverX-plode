Actor AssaultRifleGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "items/assaultrifle"
  Inventory.PickupMessage "$CFAssaultRiflePickup"
  Tag "$CFAssaultRifle"
  States
  {
  Spawn:
	MGUN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MGUN A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",70,16,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("AssaultRifle",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("MP-40",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("AssaultRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",45)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("ARMagazine",Random(20,41))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor AssaultRifleSpawnerGiver : AssaultRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("AssaultRifle",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("MP-40",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifle",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("AssaultRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",45)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("AssaultRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("AssaultRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ARMagazine",Random(20,41))
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor AssaultRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor AssaultRifle : DoomWeapon replaces Chaingun //2002
{
  SpawnID 28
  Scale 0.95
  Decal "BulletChip"
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  -INVENTORY.UNDROPPABLE
  Weapon.PreferredSkin "AssaultRifle-Marine"
  Weapon.KickBack 50
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 1.0
  Weapon.AmmoType "ARMagazine"
  Weapon.AmmoType2 "BulletMag"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  Inventory.PickupSound "items/assaultrifle"
  Inventory.PickupMessage "$CFAssaultRiflePickup"
  Obituary "$CFAssaultRifleObit"
  Tag "$CFAssaultRifle"
  States
  {
  Spawn:
	MGUN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
	MGUN A -1
	Loop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("items/assaultrifle")
	CGNR ABCDEF 1
	Goto ReadyLoop
  ReadyLoop:
	CHGG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	CHGG A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlayWeaponSound("weapons/assaultrifle")
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Light1
	CHGF A 2 Bright A_FireBullets(4.0,2.4,1,Random(5,7),"PlayerModdedBulletPuff")
	TNT1 A 0 A_Light0
	CHGF BC 1
	TNT1 A 0 A_JumpIfInventory("ARMagazine",1,"Fire2")
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_PlayWeaponSound("weapons/assaultrifle")
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Light1
	CHGF A 2 Bright A_FireBullets(4.0,2.4,1,Random(5,7),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-40,40)-150,random(-24,24),random(5,7))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-40,40)+150,random(-24,24),random(5,7))
	TNT1 A 0 A_Light0
	CHGF BC 1
	TNT1 A 0 A_JumpIfInventory("ARMagazine",1,"Fire2Spread")
	Goto ReadyLoop
  Fire2:
	TNT1 A 0 A_PlayWeaponSound("weapons/assaultrifle")
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Light2
	CHGF A 2 Bright A_FireBullets(4.0,2.4,1,Random(5,7),"PlayerModdedBulletPuff")
	TNT1 A 0 A_Light0
	CHGF BC 1
	TNT1 A 0 A_ReFire("Fire")
	Goto ReadyLoop
  Fire2Spread:
	TNT1 A 0 A_PlayWeaponSound("weapons/assaultrifle")
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(1,2,0,1,0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Light2
	CHGF A 2 Bright A_FireBullets(4.0,2.4,1,Random(5,7),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-40,40)-150,random(-24,24),random(5,21))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-40,40)+150,random(-24,24),random(5,21))
	TNT1 A 0 A_Light0
	CHGF BC 1
	TNT1 A 0 A_ReFire("Fire")
	Goto ReadyLoop
  Flash:
	TNT1 A 3 Bright A_Light1
	Goto LightDone
  Empty:
	TNT1 A 0 A_PlaySound("weapons/click",CHAN_6)
	CHGG AAAAAAAAAA 1 A_WeaponReady(WRF_NOFIRE)
	Goto Reload
  Reload:
	TNT1 A 0 A_JumpIfInventory("ARMagazine",0,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"Reload2")
	CHGG A 1 A_WeaponReady(WRF_NOFIRE)
	Goto ReadyLoop
  Reload2:
	TNT1 A 0 A_JumpIfInventory("ARMagazine",1,"MaxReload")
	CHGR A 1 A_PlaySound("weapons/arreload",CHAN_6)
	CHGR BCD 1
	CHGR E 1 A_FireCustomMissile("AREmptyMagSpawner",0,0,0,1)
	CHGR F 1
	CHGR G 8
	CHGR HIJK 1
	CHGR L 8	
	CHGR MN 2
	CHGR OP 1
	CGCK A 1
	CGCK B 3
	CGCK C 4 A_PlaySound("weapons/arclick",CHAN_6)
	CGCK D 3
	CGCK EF 2
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"ActualReload")
	Goto ReadyLoop
  ActualReload:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("ARMagazine",1)
	TNT1 A 0 A_JumpIfInventory("ARMagazine",40,2)
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"ActualReload")
	TNT1 A 0
	Goto ReadyLoop
  MaxReload:
	CHGR A 1 A_PlaySound("weapons/arreload",CHAN_6)
	CHGR BCD 1
	CHGR E 1 A_FireCustomMissile("AREmptyMagSpawner",0,0,0,1)
	CHGR F 1
	CHGR G 8
	CHGR HIJK 1
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"MaxReload2")
	Goto MaxReload2
  MaxReload2:
	TNT1 A 0 A_TakeInventory("BulletMag",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GiveInventory("ARMagazine",1)
	TNT1 A 0 A_JumpIfInventory("ARMagazine",41,"Full")
	TNT1 A 0 A_JumpIfInventory("BulletMag",1,"MaxReload2")
	Goto Full
  Full:
	CHGR L 8
	CHGR MN 2
	CHGR OPQRS 1
	CHGG A 2
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
 GrenadeToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	CGNR FEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlaySound("weapons/hgrenadepin",CHAN_6)
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0,false)
	HGRN J 1
	HGRN KLM 2
	HGRN "NO" 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_6) 
	CGNR FEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0,false)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	Goto Ready+1
  }
}

Actor ARMagazine : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 41
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 41
  Inventory.Icon "MGUNA0"
  +IGNORESKILL
}