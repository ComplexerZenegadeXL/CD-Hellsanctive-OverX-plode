Actor LegendaryLightMachineGunGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/LMGReload3"
  Inventory.PickupMessage "$CFLegendaryLightMachineGunPickup"
  Tag "$CFLegendaryLightMachineGun"
  States
  {
  Spawn:
	LMGL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
	LMGL A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",57,18,11) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryLightMachineGun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryLightMachineGun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",52)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LLMGMagazine",76)
	TNT1 A 0 A_GiveInventory("LegendaryLMGBulletMag",20)
	Stop
  }
}

Actor LegendaryLightMachineGunSpawnerGiver : LegendaryLightMachineGunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryLightMachineGun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryLightMachineGun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",52)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryLightMachineGunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryLightMachineGunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LLMGMagazine",76)
	TNT1 A 0 A_GiveInventory("LegendaryLMGBulletMag",20)
	Stop
  }
}

Actor LegendaryLightMachineGunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryLightMachineGun : Weapon
{
  Weapon.PreferredSkin "LegLMG-Marine"
  Weapon.AmmoType "LLMGMagazine"
  Weapon.AmmoType2 "LegendaryLMGBulletMag"
  Weapon.KickBack 200
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 8.0
  Weapon.AmmoUse 1
  Weapon.SelectionOrder 1100
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Scale 0.95
  Inventory.PickupSound "weapons/LMGReload3"
  Obituary "$CFLegendaryLightMachineGunObit"
  Inventory.PickupMessage "$CFLegendaryLightMachineGunPickup"
  Decal "LegBulletChip"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFLegendaryLightMachineGun"
  States
  {
  Spawn:
	LMGL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
	LMGL A -1
	Stop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	LMGG A 1 A_Lower
	Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryLightMachineGun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/LMGReload3")
	LMGG BCDEFA 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	LMGG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Goto ReadyLoop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	LMGF A 3 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"LegendaryASGBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Light0
	LMGF BC 1
	LMGG A 1
	TNT1 A 0 A_JumpIfInventory("LLMGMagazine",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light2
	LMGF D 3 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"LegendaryASGBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Light0
	LMGF BC 1
	LMGG A 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	LMGF A 3 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"LegendaryASGBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",random(-80,80)-150,random(-48,48),random(100,125))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",random(-80,80)+150,random(-48,48),random(100,125))
	TNT1 A 0 A_Light0
	LMGF BC 1
	LMGG A 1
	TNT1 A 0 A_JumpIfInventory("LLMGMagazine",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light2
	LMGF D 3 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"LegendaryASGBulletPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",random(-80,80)-150,random(-48,48),random(100,125))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireLegendaryBullet",random(-80,80)+150,random(-48,48),random(100,125))
	TNT1 A 0 A_Light0
	LMGF BC 1
	LMGG A 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  Flash:
	TNT1 A 0
	Goto LightDone
  Empty:
      LMGG A 10 A_PlayWeaponSound("weapons/click")
  Reload:
    TNT1 A 0 A_JumpIfInventory("LLMGMagazine",0,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("LLMGMagazine",1,"MaxReload")
	LMGR A 1 A_PlayWeaponSound("weapons/LMGReload2")
 	LMGR BCD 1
	LMGR E 1 A_FireCustomMissile("LegendaryEmptyDrumSpawner", 0, 0, 0, 1)
	LMGR F 1
	LMGR GG 25
	LMGR HIJK 1 A_PlayWeaponSound("weapons/LMGReload1")
	LMGR L 8	
	LMGR MN 2
	LMGR OPQRSTU 1
	LMGR V 2
	LMGR W 3 A_PlayWeaponSound("weapons/LMGReload3")
	LMGR X 4
	LMGR Y 3
	LMGR Z 2
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"ActualReload")
  ActualReload:
	TNT1 A 0 A_TakeInventory("LegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("LLMGMagazine",1)
	TNT1 A 0 A_JumpIfInventory("LLMGMagazine",75,2)
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"ActualReload")
	TNT1 A 0
	Goto ReadyLoop
  MaxReload:
	LMGR A 1 A_PlayWeaponSound("weapons/LMGReload2")
 	LMGR BCD 1
	LMGR E 1 A_FireCustomMissile("LegendaryEmptyDrumSpawner", 0, 0, 0, 1)
	LMGR F 1
	LMGR GG 25
	LMGR HIJK 1 A_PlayWeaponSound("weapons/LMGReload1")
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"Reload2")
  Reload2:
	TNT1 A 0 A_TakeInventory("LegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("LLMGMagazine",1)
	TNT1 A 0 A_JumpIfInventory("LLMGMagazine",76,"Full")
	TNT1 A 0 A_JumpIfInventory("LegendaryLMGBulletMag",1,"Reload2")
  Full:
	LMGR L 8	
	LMGR MN 2
	LMGR OPQRS 1
	LMGG A 2
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LMGG AFEDCB 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	LMGG AFEDCB 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	Goto Ready+1
  }
}

Actor LegRifleCasing : BulletCasing 
{
  Scale 0.18
  Seesound "weapons/casing1"
  +NOTIMEFREEZE
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  SpawnLoop:
	CAS9 GHABCDEF 2
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,3)
	CAS9 A 100
	CAS9 A 5 A_FadeOut(0.10)
	Goto Death+3
	CAS9 E 100
	CAS9 E 5 A_FadeOut(0.10)
	Goto Death+5
  }
}

Actor LLMGMagazine : Ammo 
{
  Inventory.Amount 0
  Inventory.MaxAmount 76
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 76
  Inventory.Icon "LMGLA0"
  +IGNORESKILL
}

Actor LegendaryLMGBulletMagPickup : LegendaryShellPickup
{
  Scale 0.5
  Inventory.PickupMessage "$CFLegendaryLMGBulletMagPickup"
  Inventory.PickupSound "items/clipbox"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	LBLP A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",12,10)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",12) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

