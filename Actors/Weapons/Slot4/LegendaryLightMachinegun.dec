  Inventory.Amount 10
  Inventory.MaxAmount 150
  Ammo.BackpackAmount 0
  //Ammo.BackpackMaxAmount 300
  Inventory.Icon "LBLPA0"
  +NOTIMEFREEZE
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	LBLP A -1
	Stop
  }
}

