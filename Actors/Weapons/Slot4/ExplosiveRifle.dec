Actor ExplosiveRifleGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "items/assaultrifle"
  Inventory.PickupMessage "$CFExplosiveRiflePickup"
  Tag "$CFExplosiveRifle"
  States
  {
  Spawn:
	PGND A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
  SpawnLoop:
	PGND A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",8,-1,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifle",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,24)
	TNT1 A 0 A_GiveInventory("ExplosiveRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",50)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("BulletMag",40)
	Stop
  }
}

Actor ExplosiveRifleSpawnerGiver : ExplosiveRifleGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifle",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,24)
	TNT1 A 0 A_GiveInventory("ExplosiveRifle",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",50)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("ExplosiveRifleGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("ExplosiveRifleGiverCheck",1)
	TNT1 A 0 A_GiveInventory("BulletMag",40)
	Stop
  }
}

Actor ExplosiveRifleGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor ExplosiveRifle : Weapon
{
  Scale 0.9
  +WEAPON.AMMO_OPTIONAL
  Weapon.PreferredSkin "AssaultRifle-Marine"
  Weapon.SelectionOrder 7988
  Weapon.KickBack 50
  Weapon.AmmoType "BulletMag"
  Weapon.AmmoType2 "BulletMag"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 3
  Weapon.SlotNumber 4
  Weapon.SlotPriority 6.0
  //Weapon.MinSelectionAmmo1 3
  Weapon.SelectionOrder 2000
  Inventory.PickupSound "items/assaultrifle"
  Inventory.PickupMessage "$CFExplosiveRiflePickup"
  Obituary "$CFExplosiveRifleObit"
  Tag "$CFExplosiveRifle"
  States
  {
  Spawn:
	PGND A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
  SpawnLoop:
	PGND A -1
	Stop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("ExplosiveRifle",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Deselect:
	TNT1 A 0 A_ZoomFactor(1.0)
	TNT1 A 0 A_TakeInventory("ExplosiveRifleZoomed",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	TNT1 A 0 A_Lower
	EBGN A 1 A_Lower
	Loop
  UnZoom:
	EBGN Z 3
	TNT1 A 0 A_SetBlend("Black",1.0,43,"Black")
	EBGN A 8 A_ZoomFactor(1.0)
	TNT1 A 0 A_TakeInventory("ExplosiveRifleZoomed",1)
	Goto DeSelect
  UnZoom2:
	EBGN Z 3
	TNT1 A 0 A_SetBlend("Black",1.0,43,"Black")
	EBGN A 8 A_ZoomFactor(1.0)
	TNT1 A 0 A_TakeInventory("ExplosiveRifleZoomed",1)
	Goto MineCheck
  UnZoom3:
	EBGN Z 3
	TNT1 A 0 A_SetBlend("Black",1.0,43,"Black")
	EBGN A 8 A_ZoomFactor(1.0)
	TNT1 A 0 A_TakeInventory("ExplosiveRifleZoomed",1)
	Goto GrenadeCheck
  UnZoom4:
	EBGN Z 3
	TNT1 A 0 A_SetBlend("Black",1.0,43,"Black")
	EBGN A 8 A_ZoomFactor(1.0)
	TNT1 A 0 A_TakeInventory("ExplosiveRifleZoomed",1)
	Goto ReadyLoop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("items/assaultrifle")
	EBGD ABCDEF 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EBGN A 1 A_WeaponReady(WRF_ALLOWZOOM)
	Loop
  Empty:
	EBGN A 10 A_PlayWeaponSound("weapons/click")
	Goto ReadyLoop
  Fire:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifleZoomed",1,"FireSnipe")
	EBGN A 2
  Hold:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HoldSpread")
	EBGN B 2 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-1,1),1,0,6,0,frandom(-2,2))
	TNT1 A 0 A_Recoil(1)
	EBGN C 2 Bright A_Light2
	EBGN DEEE 2 A_Light0
	EBGN FFGGH 1
	TNT1 A 0 A_Refire
	Goto ReadyLoop
  HoldSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	EBGN B 2 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",15.0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",-15.0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-1,1),1,0,6,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-1,1)+15.0,0,0,6,0,frandom(-2,2))
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-1,1)-15.0,0,0,6,0,frandom(-2,2))
	TNT1 A 0 A_Recoil(1)
	EBGN C 2 Bright A_Light2
	EBGN DEEE 2 A_Light0
	EBGN FFGGH 1
	TNT1 A 0 A_Refire
	Goto ReadyLoop
  Zoom:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifleZoomed",1,"UnZoom4")
	TNT1 A 0 A_GiveInventory("ExplosiveRifleZoomed",1)
	EBGN A 2
	TNT1 A 0 A_SetBlend("Black",1.0,43,"Black")
	EBGN A 3
	EBGN Z 8 A_ZoomFactor(3.0)
  ZoomLoop:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"UnZoom3")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"UnZoom2")
	EBGN Z 1 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWZOOM)
	Loop
  FireSnipe:
    TNT1 A 0 A_JumpIfInventory("BulletMag",3,1)
	Goto UnZoom4
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSnipeSpread")
	EBGN Z 2
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",0,1,0,6,0,0)
	TNT1 A 0 A_Recoil(1)
	EBGN Z 3 Bright A_Light2
	TNT1 A 0 A_Light0
    EBGN ZZZ 1 A_SetPitch(pitch-1,SPF_INTERPOLATE)
	EBGN Z 12
	GoTo ZoomLoop
  FireSnipeSpread:
    TNT1 A 0 A_JumpIfInventory("BulletMag",3,1)
	Goto UnZoom4
	EBGN Z 2
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",15.0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",-15.0,0,0,6)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",0,1,0,6,0,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",15.0,0,0,6,0,0)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",-15.0,0,0,6,0,0)
	TNT1 A 0 A_Recoil(1)
	EBGN Z 3 Bright A_Light2
	TNT1 A 0 A_Light0
    EBGN ZZZ 1 A_SetPitch(pitch-1,SPF_INTERPOLATE)
	EBGN Z 12
	GoTo ZoomLoop
  AltFire:
	EBGN A 2
  AltHold:
    TNT1 A 0 A_JumpIfInventory("BulletMag",12,1)
	GoTo ReadyLoop
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltHoldSpread")
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	TNT1 A 0 A_Refire
  AFNext:
	EBGN E 7
	EBGN FGH 3
	GoTo ReadyLoop
  AltHoldSpread:
    TNT1 A 0 A_JumpIfInventory("BulletMag",12,1)
	GoTo ReadyLoop
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5)+15.0,0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5)-15.0,0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5)+15.0,0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5)-15.0,0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	EBGN B 1 Bright A_Light1
	TNT1 A 0 Radius_Quake(4,2,0,1,0)
	TNT1 A 0 A_PlaySound("PulseNail/fire",0,1.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("BulletMag",3)
	TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(-5,5),0,0,6,0,frandom(-5,5))
	TNT1 A 0 A_Recoil(1)
	EBGN C 1 Bright A_Light2
	EBGN DED 1 A_Light0
	TNT1 A 0 A_Refire
	Goto AFNext
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready+7
  GrenadeToss:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifleZoomed",1,"UnZoom3")
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EBGD FEDCBA 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1,TIF_NOTAKEINFINITE)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready+7
  MineToss:
	TNT1 A 0 A_JumpIfInventory("ExplosiveRifleZoomed",1,"UnZoom2")
  	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EBGD FEDCBA 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1	
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0
	TNT1 A 5
	Goto Ready+1
  }
}

Actor ExplosiveRifleZoomed : Inventory {}

Actor ExplosiveBullet : ZPulseNail
{
  Species "Player"
  DamageType "None"
  Damage (random(25,30))
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 1
	TNT1 A 0 A_PlaySound("PulseNail/hit",CHAN_AUTO,1.0,0)
	TNT1 A 0 A_Explode(Random(35,75),95,0,0,78)
	TNT1 AAA 0 A_SpawnItemEX("Kaboom9",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_SpawnItemEX("SmokeFX4",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,1,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetTranslucent(0.85,1)
	MISL BBBBCC 1 Bright
	MISL CDE 3 Bright
	Stop
  }
}