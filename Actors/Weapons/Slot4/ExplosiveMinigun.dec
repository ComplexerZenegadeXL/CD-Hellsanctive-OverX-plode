Actor ExplosiveMinigunGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/explosiveminigunpickup"
  Inventory.PickupMessage "$CFExplosiveMinigunPickup"
  Tag "$CFExplosiveMinigun"
  States
  {
  Spawn:
    CHNH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
  SpawnLoop:
	CHNH A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",51,-1,0) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("ExplosiveMinigun",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,32)
	TNT1 A 0 A_GiveInventory("ExplosiveMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",49)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor ExplosiveMinigunSpawnerGiver : ExplosiveMinigunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("ExplosiveMinigun",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,32)
	TNT1 A 0 A_GiveInventory("ExplosiveMinigun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",49)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("ExplosiveMinigunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("ExplosiveMinigunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("BulletMag",20)
	Stop
  }
}

Actor ExplosiveMinigunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor ExplosiveMinigun : DoomWeapon //16654
{
  //$Category Weapons/LCA
  //$Sprite CFNGX0
  //$Title "ExplosiveMinigun"
  Weapon.Selectionorder 690
  Weapon.KickBack 50
  Weapon.PreferredSkin "ExplosiveMinigun-Marine"
  Weapon.AmmoType "BulletMag"
  Weapon.AmmoType2 "BulletMag"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 1
  Weapon.SlotNumber 4
  Weapon.SlotPriority 5.0
  Weapon.UpSound "weapons/explosiveminigunpickup"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 2000
  +WEAPON.NOAUTOAIM
  Inventory.PickupSound "weapons/explosiveminigunpickup"
  Inventory.PickupMessage "$CFExplosiveMinigunPickup"
  Obituary "$CFExplosiveMinigunObit"
  Tag "$CFExplosiveMinigun"
  AttackSound "sentient/fire"
  States 
  {
  Spawn:
    CHNH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,0)
  SpawnLoop:
	CHNH A -1
    Stop
  Ready:
    CFNG A 1 A_WeaponReady
    Loop
  ReadySpin:
    TNT1 A 0 A_PlaySound("weapons/expmgunspin", 5)
    CFNG ABCDABCDABCD 1 A_WeaponReady
    Loop
  Deselect:
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    TNT1 A 0 A_TakeInventory("ExpMinigunActive2",1)
    TNT1 A 0 A_TakeInventory("ExpMinigunActive",1)
    TNT1 A 0 A_PlaySound("weapons/weapondown", 5)
  Deselecting:
    CFNG A 1 A_Lower
    TNT1 A 0 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("ExplosiveMinigun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_TakeInventory("ExpMinigunActive2",1)
    TNT1 A 0 A_TakeInventory("ExpMinigunActive",1)
  Selecting:
    CFNG A 1 A_Raise
    TNT1 A 0 A_Raise
    Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"Firing")
    TNT1 A 0 A_JumpIfInventory("ExpMinigunActive",1,"Firing")
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstart", 5)
    CFNG ABC 2
    CFNG DABCDABC 1
  Firing:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FiringSpread")
	TNT1 A 0 A_GiveInventory("ExpMinigunActive",1)
    TNT1 A 0 A_PlaySound("weapons/expmgunspin", 5)
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
    CHNF A 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    CHNF BC 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
    CHNF D 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
    CHNF E 1 Bright
  Hold:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HoldSpread")
	TNT1 A 0 A_GiveInventory("ExpMinigunActive",1)
    TNT1 A 0 A_PlaySound("weapons/expmgunspin", 5)
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
    CHNF F 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
    CHNF G 1 Bright
    CHNF HI 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
    CHNF J 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    CHNF KL 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,3),frandom(-5,-3),frandom(3,5),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
    CHNF M 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    TNT1 A 0 A_ReFire
    TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"ReadySpin")
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstop", 5)
    TNT1 A 0 A_TakeInventory("ExpMinigunActive",1)
    CFNG ABCDABCD 1
    CFNG ABCD 2
    CFNG ABCD 3
    Goto Ready
  FiringSpread:
    TNT1 A 0 A_GiveInventory("ExpMinigunActive",1)
    TNT1 A 0 A_PlaySound("weapons/expmgunspin", 5)
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-3,-6),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
    CHNF A 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)-150,random(-24,24),random(6,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)+150,random(-24,24),random(6,30))
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    CHNF BC 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
    CHNF D 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)-150,random(-24,24),random(6,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)+150,random(-24,24),random(6,30))
    CHNF E 1 Bright
  HoldSpread:
	TNT1 A 0 A_GiveInventory("ExpMinigunActive",1)
    TNT1 A 0 A_PlaySound("weapons/expmgunspin", 5)
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
    CHNF F 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)-150,random(-24,24),random(6,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)+150,random(-24,24),random(6,30))
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")
    CHNF G 1 Bright
    CHNF HI 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
    CHNF J 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)-150,random(-24,24),random(6,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)+150,random(-24,24),random(6,30))
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    CHNF KL 1 Bright
    TNT1 A 0 Radius_Quake(2,2,0,1,0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",25,-8,25,frandom(2,3),frandom(-5,-3),frandom(3,5),0)
    TNT1 A 0 A_PlaySound("sentient/fire", CHAN_WEAPON)   
    TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4),0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)+15.0,0,0,frandom(-4,4))
	TNT1 A 0 A_FireCustomMissile("PlayerExplosiveTracer",frandom(-4,4)-15.0,0,0,frandom(-4,4))
    CHNF M 1 Bright A_FireBullets(4.8,2.4,1,Random(6,10),"PlayerModdedBulletPuff")
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)-150,random(-24,24),random(6,30))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireBullet",random(-48,48)+150,random(-24,24),random(6,30))
    TNT1 A 0 A_JumpIfNoAmmo("EmptySpinDown")   
    TNT1 A 0 A_ReFire
    TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"ReadySpin")
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstop", 5)
    TNT1 A 0 A_TakeInventory("ExpMinigunActive",1)
    CFNG ABCDABCD 1
    CFNG ABCD 2
    CFNG ABCD 3
    Goto Ready
  AltFire:
    TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"EmptySpinDown")
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstart", 5)
    CFNG ABC 2
    CFNG DABCDABCD 1
    TNT1 A 0 A_GiveInventory("ExpMinigunActive2",1)
    Goto ReadySpin
  EmptySpinDown:
    TNT1 A 0 A_TakeInventory("ExpMinigunActive",1)
    TNT1 A 0 A_TakeInventory("ExpMinigunActive2",1)
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstop", 5)
    CFNG ABCDABCD 1
    CFNG ABCD 2
    CFNG ABCD 3
    Goto Ready
  }
}

Actor ExpMinigunActive : Ammo {}
Actor ExpMinigunActive2 : Ammo {}

Actor PlayerExplosiveTracer : SentientExplosiveTracer
{
  Scale 0.7
  Species "Player"
  Damage (0)
  DamageType "None"
  +DONTREFLECT
  +THRUSPECIES
  +MTHRUSPECIES
  States
  {
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("SentientExplosiveEffect",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    MISL B 4 Bright A_Explode(Random(15,30),72,0)
    MISL CD 3 Bright
    Stop
  }
}