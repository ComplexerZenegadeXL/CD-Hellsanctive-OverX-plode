	EMGF C 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_ReFire
	Goto Ready.Laser
  Empty:
    EMGG A 10 A_PlayWeaponSound("weapons/click")
  Reload:
  	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",0,2)
    TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,3)
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Ready.Laser")
	Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",1,"MaxReload")
	EMGW A 1 A_PlayWeaponSound("weapons/LMGReload2")
 	EMGW BCD 1
	EMGW E 1 A_FireCustomMissile("EnragedLegendaryEmptyDrumSpawner", 0, 0, 0, 1)
	EMGW F 1
	EMGW G 50
	EMGW HIJK 1 A_PlayWeaponSound("weapons/LMGReload1")
	EMGW L 8	
	EMGW MN 2
	EMGW OPQRSTU 1
	EMGW V 2
	EMGW W 3 A_PlayWeaponSound("weapons/LMGReload3")
	EMGW X 4
	EMGW Y 3
	EMGW Z 2
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"ActualReload")
  ActualReload:
	TNT1 A 0 A_TakeInventory("ELegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("ELLMGMagazine",1)
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",76,2)
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"ActualReload")
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Ready.Laser")
	Goto ReadyLoop
  MaxReload:
	EMGW A 1 A_PlayWeaponSound("weapons/LMGReload2")
 	EMGW BCD 1
	EMGW E 1 A_FireCustomMissile("EnragedLegendaryEmptyDrumSpawner", 0, 0, 0, 1)
	EMGW F 1
	EMGW G 25
	EMGW H 1 A_PlayWeaponSound("weapons/LMGReload1")
	EMGW IJKL 1
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"Reload2")
  Reload2:
	TNT1 A 0 A_TakeInventory("ELegendaryLMGBulletMag",1)
	TNT1 A 0 A_GiveInventory("ELLMGMagazine",1)
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",76,"Full")
	TNT1 A 0 A_JumpIfInventory("ELegendaryLMGBulletMag",1,"Reload2")
  Full:
	EMGW L 8	
	EMGW MN 2
	EMGW OPQRS 1
	EMGG A 4
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Ready.Laser")
	Goto ReadyLoop
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto ReadyLoop
  GrenadeToss:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EMGG GFEDCB 1
	TNT1 A 4
	HGRN ABC 1
	HGRN D 2
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1,TIF_NOTAKEINFINITE)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0
	Goto Ready+1
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto ReadyLoop
  MineToss:
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown") 
	EMGG GFEDCB 1
	TNT1 A 8
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	MINE ABCDEF 1		
	TNT1 A 0 A_TakeInventory("MineAmmo",1,TIF_NOTAKEINFINITE)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
	TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 5
	Goto Ready+1
  }
}

