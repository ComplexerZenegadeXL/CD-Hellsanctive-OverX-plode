	DRTR A 2 //A_FadeOut(1.0)
	Stop
  }
}

Actor EnragedLaserSight3 : FastProjectile
{
  Speed 0 //75
  Radius 8
  Height 16
  Damage 0
  RenderStyle Add
  Scale 0.5
  Alpha 0.7
  Projectile
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +DONTSPLASH
