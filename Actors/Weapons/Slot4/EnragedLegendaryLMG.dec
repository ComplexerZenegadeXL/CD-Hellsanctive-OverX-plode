	Loop
  Death:
    TNT1 A 1 A_SpawnItemEx("EnragedLaserSight2",0,0,0,0,0,0,angle,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    Stop
  }
}

Actor ELegendaryLMGBulletMagPickup : LegendaryLMGBulletMagPickup
{
  Scale 0.5
  Inventory.PickupMessage "$CFELegendaryLMGBulletMagPickup"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	IBLP A -1
    Stop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",15,10)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",15) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

