Actor EnragedLegendaryLightMachineGunGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/LMGReload3"
  Inventory.PickupMessage "$CFEnragedLegendaryLightMachineGunPickup"
  Tag "$CFEnragedLegendaryLightMachineGun"
  States
  {
  Spawn:
	EMGL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
  SpawnLoop:
	EMGL A 30
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(0,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE,64)
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",10,19,14) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryLightMachineGun",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryLightMachineGun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",48)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("ELLMGMagazine",76)
	TNT1 A 0 A_GiveInventory("ELegendaryLMGBulletMag",20)
	Stop
  }
}

Actor EnragedLegendaryLightMachineGunSpawnerGiver : EnragedLegendaryLightMachineGunGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryLightMachineGun",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("EnragedLegendaryLightMachineGun",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",48)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("EnragedLegendaryLightMachineGunGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryLightMachineGunGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ELLMGMagazine",76)
	TNT1 A 0 A_GiveInventory("ELegendaryLMGBulletMag",20)
	Stop
  }
}

Actor EnragedLegendaryLightMachineGunGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor EnragedLegendaryLightMachineGun : DoomWeapon 
{
  Weapon.PreferredSkin "EnragedLegendaryLMG-Marine"
  Weapon.AmmoType1 "ELLMGMagazine"
  Weapon.AmmoType2 "ELegendaryLMGBulletMag"
  Weapon.KickBack 220
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 4
  Weapon.SlotPriority 9.0
  Weapon.AmmoUse1 1
  Weapon.AmmoUse2 0
  Weapon.SelectionOrder 700
  Scale 0.95
  Inventory.PickupSound "weapons/LMGReload3"
  Inventory.PickupMessage "$CFEnragedLegendaryLightMachineGunPickup"
  Tag "$CFEnragedLegendaryLightMachineGun"
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  +NOTIMEFREEZE
  //+WEAPON.AMMO_CHECKBOTH
  States
  {
  Spawn:
	EMGL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",4,1)
  SpawnLoop:
	EMGL A 30
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(0,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE,64)
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	EMGG A 1 A_Lower
	Goto Deselect+1
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("EnragedLegendaryLightMachineGun",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Zoom:
	TNT1 A 0 A_JumpIfInventory("ZoomCooldown",1,"ReadyLoop")
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Off")
	TNT1 A 0 A_GiveInventory("ZoomCooldown",1)
	EMGG A 1 A_Print("$EnragedLMGMessage1",1)
	Goto Ready.Laser
  Off:
	TNT1 A 0 A_JumpIfInventory("ZoomCooldown",1,"Ready.Laser")
	TNT1 A 0 A_TakeInventory("ELegLMGSight",1)
	TNT1 A 0 A_GiveInventory("ZoomCooldown",1)
	EMGG A 1 A_Print("$EnragedLMGMessage2",1)
	Goto ReadyLoop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/LMGReload3")
	EMGG BCDEFA 1
  ReadyLoop:
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Ready.Laser")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EMGG A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Loop
  Ready.Laser:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"Ready.LaserSpread")
	TNT1 A 0 A_GiveInventory("ELegLMGSight",1)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EMGG A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_CENTERZ,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	EMGG A 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Loop
	TNT1 A 0 A_GiveInventory("ELegLMGSight",1)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EMGG A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_CENTERZ,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	EMGG A 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Loop
  Ready.LaserSpread:
	TNT1 A 0 A_GiveInventory("ELegLMGSight",1)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	EMGG A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_CENTERZ,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight",3.0)
	//EMGG A 0 A_FireCustomMissile("EnragedLaserSight2",-15.0,0,0,-4,0,0)
	EMGG A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_CENTERZ|RGF_EXPLICITANGLE,0,"RailTargetPuff",+13.0,0,0,0,0,0,"EnragedLaserSight",0.0)
	EMGG A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_CENTERZ|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight",0.0)
	EMGG A 1 A_WeaponReady(WRF_NOBOB|WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Fire.Laser")
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	EMGF A 2 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Light0
	EMGF BC 1 
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light2
	EMGF D 2 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Light0
	EMGF BC 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_JumpIfInventory("ELegLMGSight",1,"Fire.Laser")
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	EMGF A 2 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-80,80)-150,random(-48,48),random(100,125))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-80,80)+150,random(-48,48),random(100,125))
	TNT1 A 0 A_Light0
	EMGF BC 1 
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light2
	EMGF D 2 Bright A_FireBullets(8.0,4.8,1,Random(100,125),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-80,80)-150,random(-48,48),random(100,125))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-80,80)+150,random(-48,48),random(100,125))
	TNT1 A 0 A_Light0
	EMGF BC 1
	TNT1 A 0 A_ReFire
	Goto ReadyLoop
  Fire.Laser:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"Fire.LaserSpread")
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	TNT1 A 0 A_FireBullets(3.0,2.0,1,Random(120,145),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	EMGF A 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	EMGF BBBCCC 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_Light0
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",1,1)
	TNT1 A 0 A_ReFire
	Goto Ready.Laser
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light2
	EMGF D 2 Bright A_FireBullets(3.0,2.0,1,Random(120,145),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 A_Light0
	EMGF BBBCCC 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_ReFire
	Goto Ready.Laser
  Fire.LaserSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")	
	TNT1 A 0 A_PlaySound("weapons/LMGFire",5)
	TNT1 A 0 A_AlertMonsters	
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing",30,3,25,frandom(2,4),frandom(3,6),frandom(3,6),0)
	TNT1 A 0 A_Light1
	TNT1 A 0 Bright A_FireBullets(3.0,2.0,1,Random(120,145),"ELLMGPuff",FBF_NORANDOM|FBF_USEAMMO)
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-30,20)-150,random(-20,20),random(120,145))
	TNT1 A 0 ACS_NamedExecuteWithResult("FireEnragedBullet",random(-30,20)+150,random(-20,20),random(120,145))
	EMGF A 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF B 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF B 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF B 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF C 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF C 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	EMGF C 1 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,"RailTargetPuff",0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_RailAttack(-1,0,False,NONE,NONE,RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE,0,"RailTargetPuff",-13.0,0,0,0,0,0,"EnragedLaserSight")
	TNT1 A 0 A_JumpIfInventory("ELLMGMagazine",1,1)
