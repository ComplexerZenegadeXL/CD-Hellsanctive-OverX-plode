Actor HeavyChaingun : Weapon 30398
{
  Scale 0.8
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.SelectionOrder 700
  Weapon.PreferredSkin "Rapid-Shotgun-Marine"
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoType "NewShell"
  AttackSound "weapons/12gaugefire"
  Inventory.PickupMessage "You got the Rapid Shotgun"
  Obituary "$CFHeavyChaingunObit"
  Tag "Rapid Shotgun"
  States
  {
  Spawn:
	HCNG A -1
	Stop
  Ready:
	HCGG A 1 A_WeaponReady
	Loop
  Select:
	HCGG A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_StopSound(6)
  DeselectLoop:
	HCGG A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6,1.0,0)
	TNT1 A 0 A_JumpIfNoAmmo("AltEmpty")
  ReFire:
	TNT1 A 0
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_Jump(128,"SmallFire1")
  LargeFire1:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF A 2 Bright
	HCGF B 2 Bright
	TNT1 A 0 A_Jump(128,"SmallFire2")
  LargeFire2:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF C 2 Bright
	HCGF D 2 Bright
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	TNT1 A 0 A_Refire
	Goto Spindown
  SmallFire1:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",Random(6,-6),0,0,Random(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,Random(2,6),0,Random(1,3),Random(-80,-90),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF E 2 Bright
	HCGF B 2 Bright
	TNT1 A 0 A_Jump(128,"LargeFire2")
  SmallFire2:
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF F 2 Bright
	HCGF D 2 Bright
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	TNT1 A 0 A_Refire("ReFire")
	Goto Spindown
  AltFire:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6,1.0,0)
	TNT1 A 0 A_JumpIfInventory("NewShell",4,"Four")
	TNT1 A 0 A_JumpIfInventory("NewShell",3,"Three")
	TNT1 A 0 A_JumpIfInventory("NewShell",2,"Two")
	TNT1 A 0 A_JumpIfInventory("NewShell",1,"One")
	Goto AltEmpty
  One:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_TakeInventory("NewShell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(11.8,7.3,4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF E 1 Bright
	HCGG A 1 Bright
	HCGG A 2 Bright
	Goto Spindown
  Two:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_TakeInventory("NewShell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",5,1.0,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AA 0 A_SpawnItemEx("ShellCasing",12,-6,36,Random(2,6),0,Random(1,3),Random(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(11.8,7.3,4*2,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3*2,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF A 2 Bright
	HCGG A 2 Bright
	Goto AltSpindown
  Three:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_TakeInventory("NewShell",3,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_PlaySound("weapons/sshotf",5,0.5,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(3,3,0,1,0)
	TNT1 AAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAA 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(11.8,7.3,4*3,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3*3,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF A 2 Bright
	HCGF E 2 Bright
	Goto AltSpindown
  Four:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_TakeInventory("NewShell",4,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_PlaySound("weapons/sshotf",5,1.0,0)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(10,5,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("SGTracer",frandom(-6,6),0,0,frandom(-6,6))
	TNT1 AAAA 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(11.8,7.3,4*4,Random(1,5)*random(3,6),"ModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8,7.3,3*4,random(1,5)*random(6,9),"ModdedBulletPuff",FBF_NORANDOM)
	HCGF A 2 Bright
	HCGF A 1 Bright
	HCGF E 1 Bright
	Goto AltSpindown
  AltEmpty:
	TNT1 A 0
	HCGG AABBCCDD 1
	TNT1 A 0 A_PlaySound("weapons/click",7,1.0,0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6,1.0,0)
	HCGG AB 2
	HCGG CD 3
	Goto Ready
  Empty:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("weapons/click",7,1.0,0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6,1.0,0)
	HCGG AB 2
	HCGG CD 3
	Goto Ready
  Spindown:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6,1.0,0)
	HCGG AB 2 A_Refire
	HCGG CD 3 A_Refire
	Goto Ready
  AltSpindown:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6,1.0,0)
	HCGG AB 2
	HCGG CD 3
	TNT1 A 0 A_Refire("AltFire")
	Goto Ready
  Flash:
	TNT1 A 1 A_Light1
	TNT1 A 1 A_Light2
	TNT1 A 1 A_Light1
	Goto LightDone
  }
}