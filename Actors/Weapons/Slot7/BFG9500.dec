Actor BFG9500Giver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/bfgpickup"
  Inventory.PickupMessage "$CFBFG9500Pickup"
  Tag "$CFBFG9500"
  States
  {
  Spawn:
	BF95 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	BF95 A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",76,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BFG9500",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BFG9500",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",94)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",60)
	Stop
  }
}

Actor BFG9500SpawnerGiver : BFG9500Giver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BFG9500",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BFG9500",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",94)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BFG9500GiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BFG9500GiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",60)
	Stop
  }
}

Actor BFG9500GiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor BFG9500 : BFG9000 replaces BFG9000
{
  Height 20
  Scale 0.85
  -WEAPON.NOAUTOFIRE
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.SelectionOrder 2800
  Weapon.PreferredSkin "BFG9500-Marine"
  Weapon.AmmoUse 40
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 1.0
  Weapon.AmmoType "NewCell"
  Weapon.AmmoType2 "NewCell"
  //Weapon.MinSelectionAmmo1 40
  Weapon.SelectionOrder 6000
  Inventory.PickupSound "weapons/bfgpickup"
  Inventory.PickupMessage "$CFBFG9500Pickup"
  Weapon.SisterWeapon "PoweredBFG9500"
  Obituary "$CFBFG9500Obit"
  Tag "$CFBFG9500"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
	BF95 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	BF95 A -1
	Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",11,0,1)
	TNT1 A -1
	Stop
  Ready:
	BFGY A 1 A_WeaponReady
	Loop
  Select:
	TNT1 A 0 A_PlayWeaponSound("weapons/bfgpickup")
  SelectLoop:
	BFGY A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	BFGY A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("NewCell",40 - 20 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("BFGUpgrade",1,"UpFire")
	TNT1 A 0 A_Light1
	BFGY A 2 Bright A_PlaySound("weapons/bfgf",CHAN_WEAPON)
	9FGC ABCDE 2 Bright Radius_Quake(2,2,0,1,0)
	9FGC FGHI 1 Bright Radius_Quake(3,2,0,1,0)
	9FGC FGHIF 1 Bright Radius_Quake(4,2,0,1,0)
	9FGC GH 1 Bright Radius_Quake(6,2,0,1,0)
	TNT1 A 0 A_Light2
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	DBFF A 4 Bright A_FireCustomMissile("BFG9500Ball",0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",20,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",20)
	DBFF B 3 Bright
	TNT1 A 0 A_Light0
	9FGX ABCD 1
	9FGX EFG 2
	TNT1 A 0 A_JumpIfInventory("NewCell",40 - 20 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	BFGY A 20 //A_ReFire
	Goto Ready
  UpFire:
	TNT1 A 0 A_Light1
	BFGY A 2 Bright A_PlaySound("weapons/bfgf",CHAN_WEAPON)
	9FGC ABCDE 2 Bright Radius_Quake(2,2,0,1,0)
	9FGC FGHI 1 Bright Radius_Quake(3,2,0,1,0)
	9FGC FGHIF 1 Bright Radius_Quake(4,2,0,1,0)
	9FGC GH 1 Bright Radius_Quake(6,2,0,1,0)
	TNT1 A 0 A_Light2
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	DBFF A 4 Bright A_FireCustomMissile("UpBFG9500Ball",0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",20,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",20)
	DBFF B 3 Bright
	TNT1 A 0 A_Light0
	9FGX ABCD 1
	9FGX EFG 2
	TNT1 A 0 A_JumpIfInventory("NewCell",40 - 20 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	BFGY A 20
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfInventory("BFGUpgrade",1,2)
	BFGY A 1 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
	TNT1 A 0 A_JumpIfInventory("NewCell",600 - 300 *ACS_NamedExecuteWithResult("ConservationCheck"),2)
	BFGY A 1 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Light1
	BFGY A 2 Bright A_PlaySound("weapons/bfgf",CHAN_WEAPON)
	9FGC ABCDE 2 Bright Radius_Quake(2,2,0,1,0)
	9FGC FGHI 1 Bright Radius_Quake(3,2,0,1,0)
	9FGC FGHIF 1 Bright Radius_Quake(4,2,0,1,0)
	9FGC GH 1 Bright Radius_Quake(6,2,0,1,0)
	TNT1 A 0 A_Light2
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(12,4,0,1,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",300,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",300)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",0,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-4,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",4,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-8,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",8,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-16,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",16,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-32,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",32,0)
	
	/*TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-0.71,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",0.71,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-2,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",2,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-4,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",4,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",-6,0)
	TNT1 A 0 A_FireCustomMissile("UpBFG9500Ball",6,0)*/
	DBFF A 4 Bright
	DBFF B 3 Bright
	TNT1 A 0 A_Light0
	9FGX ABCD 1
	9FGX EFG 2
	BFGY A 20 A_ReFire
	Goto Ready
  Flash:
	TNT1 A 0
	Stop
  }
}

Actor BFG9500Ball : BFGBall replaces BFGBall
{
  +THRUSPECIES
  Species "Player"
  Damage (Random(400,800))
  DamageType "BFG9500Ball"
  Obituary "$CFBFG9500BallObit"
  DeathSound "BFG9K/Explode"
  States
  {
  Spawn:
    BFS3 AAABBB 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwave2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE,0)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom11", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE3 AB 8 Bright A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BFE3 C 8 Bright A_BFGSpray("CustomSpray")
    BFE3 DEF 8 Bright
    Stop    
  }
}

Actor CustomSpray
{
  +NOBLOCKMAP
  +NOGRAVITY
  +ACTIVATEPCROSS
  +ACTIVATEIMPACT
  +NOTELEPORT
  +DROPOFF
  +EXTREMEDEATH
  +MTHRUSPECIES
  RenderStyle Add
  Radius 1
  Height 1
  Damage 0
  Speed 0
  DamageType "BFGSplash"
  States
  {
  Spawn:
   TNT1 A 0
   BFE2 A 6 Bright A_SpawnItemEx("GreenParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
   BFE2 BCD 6 Bright 
   Stop
 }
}

Actor BFG9500Trail
{
  RenderStyle Add
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  States
  {
  Vanilla:
	TNT1 A 0
	Stop
  }
}

Actor UpBFG9500Ball : BFG9500Ball
{
  +FORCERADIUSDMG
  DamageType "UpBFG9500Ball"
  States
  {
  Spawn:
	BFS3 AAABBB 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Death:
	TNT1 A 0 A_Explode(Random(400,800),128,0,0)
	TNT1 A 0 A_SpawnItemEx("BFGShockwave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom11",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE3 AB 8 Bright A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BFE3 C 8 Bright A_BFGSpray("UpCustomSpray")
	BFE3 DEF 8 Bright
	Stop    
  }
}

Actor PCustomSpray
{
  Height 1
  Radius 1
  Speed 0
  Renderstyle Add
  Damage 0
  +DROPOFF
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +EXTREMEDEATH
  +ACTIVATEPCROSS
  +ACTIVATEIMPACT
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "BFGSplash"
  States
  {
  Spawn:
	TNT1 A 0
	BFE2 A 6 Bright A_SpawnItemEx("GreenParticleSpawnerDT",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BFE2 BCD 6 Bright 
	Stop
  }
}

Actor UpCustomSpray : PCustomSpray { DamageType "UpBFGSplash" }

Actor BFGUpgrade : CustomInventory
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  Inventory.PickupSound "upgrade/pickup"
  Inventory.PickupMessage "$CFBFGUpgradePickup"
  Tag "$CFBFGUpgrade"
  States
  {
  Spawn:
	RBUP ABCDCB 3
	Loop
  Pickup:
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",95)
	Stop
  Use:
	TNT1 A 0
	Fail
  }
}
