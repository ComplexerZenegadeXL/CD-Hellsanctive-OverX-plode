Actor FreezerBFGGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFFreezerBFGPickup"
  Inventory.PickupSound "devastator/up"
  Tag "$CFFreezerBFG"
  States
  {
  Spawn:
	FZDZ A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	FZDZ A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",37,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("FreezerBFG",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("FreezerBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",83)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",Random(150,300))
	Stop
  }
}

Actor FreezerBFGSpawnerGiver : FreezerBFGGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("FreezerBFG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("FreezerBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",83)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("FreezerBFGGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("FreezerBFGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",Random(150,300))
	Stop
  }
}

Actor FreezerBFGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor FreezerBFG : Weapon 18654
{
  //$Category Weapons/LCA/DJB
  //$Sprite FZDZA0
  //$Title "Freezer BFG"
  Weapon.SelectionOrder 2800
  +NOAUTOFIRE
  //+WEAPON.BFG
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.PreferredSkin "FreezeBFG-Marine"
  Weapon.AmmoUse 200
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 9.0
  Weapon.AmmoType "NewCell"
  Weapon.AmmoType2 "NewCell"
  Weapon.Upsound "devastator/up"
  DamageType "PlayerIce"
  Inventory.PickupSound "devastator/up"
  Inventory.PickupMessage "$CFFreezerBFGPickup"
  Obituary "$CFFreezerBFGObit"
  Tag "$CFFreezerBFG"
  States
  {
  Spawn:
	FZDZ A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	FZDZ A -1 Bright
	Stop
  Ready:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("BigFreezeGunHold",1)
	FZDF A 1 Bright A_PlaySound("devastator/idle",CHAN_BODY,1.0,1)
  ReadyLoop:
	FZDF A 1 Bright A_WeaponReady
	//TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	//TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("FreezerBFG",1)
	//Stop
  SelectLoop:
	FZDF A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_TakeInventory("RailgunAction",1)
	TNT1 A 0 A_TakeInventory("BigFreezeGunHold",1)
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_StopSound(CHAN_VOICE)
  DeselectLoop:
	FZDF A 1 A_Lower
	Loop
  Fire:
	//TNT1 A 0 A_JumpIfNoAmmo("Ready")
	//TNT1 A 0 A_JumpIfInventory("NewCell",200,1)
	//TNT1 A 0 A_JumpIfInventory("NewCell",200 - 100 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	//TNT1 A 0 A_RailWait
	//"####" "#" 1 A_JumpIf(ACS_NamedExecuteWithResult("AmmoCheck") == 1,1)
	"####" "#" 0 A_JumpIfInventory("NewCell",200 - 100 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	FZDF B 1 Bright A_AlertMonsters
	FZDF B 4 Bright A_PlaySound("devastator/charge",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_StopSound(CHAN_BODY)
	FZDF CDEFGHIJ 5 Bright
	FZDH KODHBJCILMEGAPFN 3 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 A_Refire
	Goto Ball
  Hold:
	//TNT1 A 0 A_JumpIfNoAmmo("Ready")
	//TNT1 A 0 A_JumpIfInventory("NewCell",200 - 100 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	//TNT1 A 0 A_RailWait
	//"####" "#" 1 A_JumpIf(ACS_NamedExecuteWithResult("AmmoCheck") == 1,1)
	"####" "#" 0 A_JumpIfInventory("NewCell",200 - 100 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_JumpIfInventory("BigFreezeGunHold",1,"HoldLoop")
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
  HoldLoop:
	TNT1 A 0 A_PlaySound("weapons/devfch",CHAN_VOICE,1.0,0)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDF K 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH G 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH F 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH N 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH B 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH I 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH H 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH D 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH M 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH L 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH E 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH K 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH J 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH A 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH O 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Bright Radius_Quake(7,7,0,1,0)
	FZDH P 1 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 Radius_Quake(7,7,0,1,0)
	FZDH C 2 Bright A_FireBullets(4,4,2,6,"IceMeleePuff",FBF_NORANDOM,64)
	TNT1 A 0 A_JumpIfInventory("BigFreezeGunHold",1,"HoldRefire")
	TNT1 A 0 A_GiveInventory("BigFreezeGunHold",1)
  HoldRefire:
	TNT1 A 0 A_Refire
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
  Ball:
	FZDF L 4 Bright A_GunFlash
	TNT1 A 0 A_Recoil(30)
	FZDF L 1 Bright A_Playsound("freezebfg/fire",CHAN_WEAPON,1.0,0)
	FZDF M 4 Bright A_FireCustomMissile ("PlayerFreezerBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",100,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",100)
	FZDF NOPQ 4 Bright
	FZDF A 7 Bright
	Goto Ready
  EmptySpinDown:
	TNT1 A 0 A_PlaySound("weapons/mgunspinstop")
	IMMG A 35
	Goto Ready+1
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready
  GrenadeToss:
	TNT1 A 0 A_GiveInventory("Hand Grenade")
	TNT1 A 0 A_SelectWeapon("Hand Grenade")
	Goto Deselect
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
	TNT1 A 0 A_GiveInventory("Land Mine")
	TNT1 A 0 A_SelectWeapon("Land Mine")
	Goto Deselect
  }
}

Actor IceMeleePuff
{
  Height 3
  Radius 3
  RenderStyle Add
  Alpha 0.3
  Scale 0.5
  +ALWAYSPUFF
  +PUFFONACTORS
  +NOGRAVITY
  +THRUSPECIES
  +MTHRUSPECIES
  DamageType "PlayerIce"
  DeathSound "weapons/buzz"
  States
  {
  Spawn:
	PLSS NOPQRSTUVWXYZ 2 Bright
	Stop
  Crash:
	TNT1 A 1
	Stop
  }
}

Actor PlayerFreezerBall
{
  Projectile
  Height 16
  Radius 16
  Speed 15
  Alpha 0.95
  Scale 0.7
  RenderStyle Translucent
  Alpha 0.85
  Damage (Random(600,1000))
  +RIPPER
  +BLOODLESSIMPACT
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +NODAMAGETHRUST
  +SKYEXPLODE
  +THRUSPECIES
  +SHOOTABLE
  +INVULNERABLE
  +DONTHURTSPECIES
  Species "Player"
  DamageType "PlayerIce"
  var int user_loop;
  States
 {
 Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("devastator/fly",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_CustomMissile("PlayerFreezeBFGBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("PlayerFreezeLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	ICBL A 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("FreezeBFGLightning",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ICBL A 1 Bright A_CustomMissile("PlayerFreezeBFGTracerAttack",frandom(-8,8),frandom(-10,10),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("FreezeBFGTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TNT1 A 0 A_SpawnItemEx("PlayerFreezeBFGFlame",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-6,6),0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_CustomMissile("PlayerFreezeBFGBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("PlayerFreezeLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	ICBL B 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("FreezeBFGLightning2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ICBL B 1 Bright A_CustomMissile("PlayerFreezeBFGTracerAttack",frandom(-8,8),frandom(-10,10),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("PlayerFreezeBFGFlame",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-6,6),0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_Explode(80,300,false,false)
	TNT1 A 0 A_CustomMissile("PlayerFreezeBFGBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("PlayerFreezeLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	ICBL C 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("FreezeBFGLightning",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ICBL C 1 Bright A_CustomMissile("PlayerFreezeBFGTracerAttack",frandom(-8,8),frandom(-10,10),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("FreezeBFGTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TNT1 A 0 A_SpawnItemEx("PlayerFreezeBFGFlame",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-6,6),0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_CustomMissile("PlayerFreezeBFGBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("PlayerFreezeLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	ICBL D 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("FreezeBFGLightning2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ICBL D 1 Bright A_CustomMissile("PlayerFreezeBFGTracerAttack",frandom(-8,8),frandom(-10,10),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("PlayerFreezeBFGFlame",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-6,6),0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_Explode(80,300,false,false)
	TNT1 AAA 0 A_SpawnItemEx("PlayerFreezeBFGSpike",frandom(-50,50),frandom(-100,100),0,0,0,0,0,SXF_NOCHECKPOSITION,96)
	Loop
  Death:
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PlayerIceSpike",frandom(-256,256),frandom(-256,256),0,0,0,0,0,34,0)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("PlayerFreezeBFGTracer",0,0,user_loop * 10,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("FreezeBFGLightningSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(25,64,0,0)
	ICBL A 6 Bright A_SpawnItemEx("FreezeBFGShockWave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
