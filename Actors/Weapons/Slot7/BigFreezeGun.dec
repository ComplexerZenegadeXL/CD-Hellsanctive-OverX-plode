	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PlayerFreezeBFGFlame",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TNT1 AAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("BlueKaboom3",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20))
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PlayerFreezeBFGFlame2",frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(-6,6),frandom(-6,6),frandom(-3,3))
	Stop    
  }
}

