Actor BFG10KGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFBFG10KPickup"
  Inventory.PickupSound "weapons/pickup15k"
  Tag "$CFBFG10K"
  States
  {
  Spawn:
    BFG2 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	BFG2 A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",78,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFBFG10K",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("CFBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",80)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor BFG10KSpawnerGiver : BFG10KGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFBFG10K",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",80)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BFG10KGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BFG10KGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",40)
	Stop
  }
}

Actor BFG10KGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CFBFG10K : Weapon
{
  Scale 0.85
  Height 20
  Weapon.PreferredSkin "BFG10K-Marine"
  Weapon.AmmoType "NewCell"
  Weapon.AmmoType2 "NewCell"
  Weapon.AmmoUse 5
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 3.0
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  //+WEAPON.NOAUTOFIRE
  Weapon.SisterWeapon "PoweredBFG10k"
  //Weapon.MinSelectionAmmo1 5
  Weapon.SelectionOrder 6000
  Inventory.PickupMessage "$CFBFG10KPickup"
  Inventory.PickupSound "weapons/pickup15k"
  Obituary "$CFBFG10KObit"
  Tag "$CFBFG10K"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    BFG2 A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	BFG2 A -1
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",12,0,1)
	TNT1 A -1
	Stop
  Ready:
    TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"ReadyBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
    TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    BG2G AAABBBCCCDDD 1 A_WeaponReady
    Loop
  Ready2:
    TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"ReadyBFG15K")
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
    BGE2 A 1 A_WeaponReady
	Loop
  ReadyBFG15K:
	TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    15KC A 5 A_WeaponReady
	Loop
  Deselect:
  	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"DeselectBFG15K")
    //TNT1 A 0 A_JumpIfNoAmmo("Deselect2")
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Deselect2
  DeselectLoop:
	BG2G A 1 A_Lower
    Loop	
  Deselect2:
	BGE2 A 1 A_Lower
    Loop	
  DeselectBFG15K:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	15KC A 1 A_Lower
    Goto DeselectBFG15K+1	
  Select:
    TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"SelectBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Select2")
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Select2
    TNT1 A 0 A_Playsound("weapons/pickup15k")
  SelectLoop:
    BG2G A 1 A_Raise
    Loop
  Select2:
    TNT1 A 0 A_PlayWeaponSound("weapons/pickup15k")
    BGE2 A 1 A_Raise
    Goto Select2+1	
  SelectBFG15K:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickup15k")
    15KC A 1 A_Raise
    Goto SelectBFG15K +1
  Fire:
    TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"FireBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	BG2G E 25 A_PlayWeaponSound("weapons/charge15k")
    BG2G F 4
    BG2G GHIJ 1
    Goto Hold
  Hold:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"FireBFG15K")
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("FireCheck") == 1,1)
	//Goto Ready
	TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	BG2E A 1 Bright A_GunFlash
    BG2G K 1 Bright
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	BG2E B 1 Bright A_FireCustomMissile("10KProjectile",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",3)
    BG2G LMNO 1
    TNT1 A 0 A_JumpIfInventory("NewCell",5 - 2 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
	BG2G O 35 A_PlaySound("weapons/bfg15kcooldown",CHAN_6)
    Goto Ready
	TNT1 A 0 A_ReFire("Hold")
    Goto Ready
  Flash:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
	TNT1 A 2 A_Light1
    Goto LightDone
  FireBFG15K:
    TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto ReadyBFG15K
	15KC A 30 A_PlayWeaponSound("weapons/charge15k")
    Goto HoldBFG15K
  HoldBFG15K: 
	//TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("FireCheck") == 1,1)
	//Goto ReadyBFG15K
	TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto ReadyBFG15K
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlayerBFG15KBall",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",5)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TNT1 A 0 A_GunFlash("FlashBFG15K")
	15KF AB 2 Bright
	15KF CD 1 Bright
	15KF EF 2 Bright
	15KF GH 1 Bright
	15KF IJ 2
	TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
	15KC A 35 A_PlaySound("weapons/bfg10kcooldown",CHAN_6)
    Goto ReadyBFG15K
	TNT1 A 0 A_ReFire("HoldBFG15K")
    Goto ReadyBFG15K
  FlashBFG15K:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
	TNT1 A 2 A_Light1
    TNT1 A 0 A_Light0
	Stop
  }
}

Actor 10KProjectile : FastProjectile
{
  Height 10
  Radius 10
  Speed 100
  Scale 0.15
  RenderStyle Add
  Alpha 0.85
  Projectile
  //DamageType "BFG10K"
  +NOEXTREMEDEATH
  +THRUSPECIES
  Species "Player"
  DeathSound "weapons/bfg95explode"
  Obituary "$CF10KProjectileObit"
  States
  {
  Spawn:
    TRA2 A 5 Bright
    Loop
  Death:
  XDeath:  
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("Player10KEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor Player10KEx
{
  Radius 11
  Height 8
  Damage (0) //124 to 129
  DamageType "BFG10K"
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT 
  +FORCERADIUSDMG
  Renderstyle Add
  Alpha 0.75
  Scale 0.85
  Obituary "$CFPlayer10KExObit"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE1 A 4 Bright A_Explode(70,128,0,1)
	TNT1 A 0 A_Explode(70,128,1,0)
    BFE1 BCDEF 4 Bright
    Stop
  }
}

Actor BFG15KUpgrade : Inventory
{
  Inventory.PickupMessage "$CFBFG15KPickup"
  States
  {
  Spawn:
	15KW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	15KW A -1
    Stop
  }
}

//=============
// BFG15K Ball
//=============

Actor BFG15KBall : BFG9500Ball
{
  Height 15
  Radius 15
  Speed 35
  Damage (Random(100,150))
  DamageType "BFG10K"
  Scale 0.5
  +FORCERADIUSDMG
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
    BFS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    BFE1 A 4 Bright A_Explode(50,162,0)
    BFE1 BCDEF 4 Bright
    Stop
  }
}

Actor PlayerBFG15KBall : BFG15KBall
{
  Decal "BFG10K"
  Speed 75
  Damage (Random(150,175))
  Scale 0.4
  SeeSound ""
  Obituary "$CFPlayerBFG15KBallObit"
  +MTHRUSPECIES
  +NODAMAGETHRUST
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    BFE1 A 4 Bright A_Explode(Random(75,150),128,0)
    BFE1 BCDEF 4 Bright
    Stop
  }
}