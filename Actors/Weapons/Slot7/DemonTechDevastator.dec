Actor PCommanderDevastatorBall2
{
  Radius 9 //16
  Height 12 //16
  Speed 20
  FastSpeed 30
  Species "Player"
  DamageType "PlayerDevBall"
  Damage (Random(20,60))
  Projectile
  RenderStyle Add
  Alpha 0.90
  Decal "DoomImpScorch"
  SeeSound "weapons/devbal"
  DeathSound "weapons/devex2" 
  BounceType "Hexen"
  BounceCount 10
  BounceFactor 0.95
  WallBounceFactor 0.95
  +NOTIMEFREEZE
  +FORCERADIUSDMG
  +ALLOWBOUNCEONACTORS
  +BOUNCEONACTORS
  +CANBOUNCEWATER
  +USEBOUNCESTATE
  +BOUNCEAUTOOFF
  +BOUNCEONCEILINGS
  +THRUSPECIES
  +MTHRUSPECIES
  States
  {
  Spawn:
    PBA2 AB 4 Bright
    Loop
  Bounce:
    "####" "#" 4 A_Explode(10,256,0)
  Goto Spawn
  Death:
    PBA2 C 1 Bright
    PBA2 C 3 Bright A_Explode(70,64,0,0,64,5,15,"FakePuff")
    PBA2 DE 4 Bright
    Stop
  }
}

Actor PCerComDevastatorProjectileAttack : SentientDTBFGTracerAttack
{
  Species "Player"
  DamageType "PlayerDevBall"
  Obituary "$CFPCerComDevastatorProjectileAttackObit"
  +NOTIMEFREEZE
  +FRIENDLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 AAAAA 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 1 A_CustomRailgun(8*random(1,8),0,None,"80 00 FF",RGF_SILENT|RGF_FULLBRIGHT,0,2,"PCommDevRailgunSlugPuff")
	Goto Death
  }
}

Actor PCommDevRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "PlayerDevBall"
}

Actor LiteShot
{
  Radius 8
  Height 12
  Speed 32
  Damage 15
  Projectile
  RenderStyle Add
  Alpha 0.85
  DamageType "PlayerDevBall"
  +THRUGHOST
  SeeSound "weapons/devlit"
  DeathSound "weapons/devzap" 
  States
  {
  Spawn:
    DLIT AAABBBCCC 1 Bright A_SpawnItemEx("LiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    DLIT DEFGHIJKLMNO 1 Bright
    Stop
  }
}

Actor PLiteShot : LiteShot { Species "Player" }

Actor PCommanderLiteShot : PLiteShot
{
  +NOTIMEFREEZE
  +FRIENDLY
  States
  {
  Spawn:
    PLIT AAABBBCCC 1 Bright A_SpawnItem ("PurpleLiteTrail",0,0,0)
    Loop
  Death:
    PLIT DEFGHIJKLMNO 1 Bright
    Stop
  }
}


Actor FakePuff : PlayerModdedBulletPuff
{
  States
  {
    Spawn:
	Death:
	TNT1 A 0
	Stop
  }
}

Actor PCommDevastatorBolt
{
  Speed 35
  Radius 6
  Height 6
  Alpha 0.8
  Projectile
  ReactionTime 170
  RenderStyle Add
  DeathSound "bolt/explode"
  Damage 30
  -STRIFEDAMAGE
  +FRIENDLY
  +SEEKERMISSILE
  +MTHRUSPECIES
  +NOTIMEFREEZE
  +DONTREFLECT
  +BRIGHT
  Species "Player"
  DamageType "PlayerDevBall"
  States
  {
  Spawn:
  	PVS1 A 0 A_SeekerMissile(5,5,SMF_LOOK)
    PVS1 A 1 A_SpawnItem("PurpleBoltTrail")
    Loop
  Death:
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("PurpleKaboomDevastator1",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
  Vanilla:
    PVS1 LMN 2
    Stop
  }
}

