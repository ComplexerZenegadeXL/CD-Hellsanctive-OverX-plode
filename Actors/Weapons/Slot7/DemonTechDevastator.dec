Actor LiteTrail
{
  Radius 1
  Height 1
  Projectile
  RenderStyle Add
  Alpha 0.67
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    DLIT ABC 3 Bright
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

