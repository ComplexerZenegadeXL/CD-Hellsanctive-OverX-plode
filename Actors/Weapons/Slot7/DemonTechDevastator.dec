Actor DemonTechDevastatorGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "devastator/up"
  Inventory.PickupMessage "$CFDemonTechDevastatorPickup"
  Tag "$CFDemonTechDevastator"
  States
  {
  Spawn:
    WDEV A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	WDEV A -1
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",49,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DemonTechDevastator",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteWithResult("Give Weapon") //A_GiveInventory("DemonTechDevastator",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",85)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	Stop
  }
}

Actor DemonTechDevastatorSpawnerGiver : DemonTechDevastatorGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonTechDevastator",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteWithResult("Give Weapon") //A_GiveInventory("DemonTechDevastator",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",85)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DemonTechDevastatorGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DemonTechDevastatorGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	Stop
  }
}

Actor DemonTechDevastatorGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DemonTechDevastator : Weapon //16656
{	
  //$Category Weapons/LCA
  //$Sprite WDEVA0
  //$Title "Demon Tech Devastator"
  Weapon.PreferredSkin "Devastator-Marine"
  Weapon.AmmoUse 150
  Weapon.AmmoUse2 50
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 8.0
  Weapon.AmmoUse2 100
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.UpSound "devastator/up"
  //Weapon.MinSelectionAmmo1 150
  //Weapon.MinSelectionAmmo2 100
  Weapon.SelectionOrder 7000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  DamageType "PlayerDevBall"
  Inventory.PickupSound "devastator/up"
  Inventory.PickupMessage "$CFDemonTechDevastatorPickup"
  Obituary "$CFDemonTechDevastatorObit"
  Tag "$CFDemonTechDevastator"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    WDEV A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	WDEV A -1
    Loop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",3,0,0)
	TNT1 A -1
	Stop
  Ready:
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderReady")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade", 1, "CommanderReady")
    DEVG A 0 A_PlaySound("devastator/idle",6,1.0,1)
    DEVG A 2 A_WeaponReady
    Loop
  CommanderReady:
	TNT1 A 0 A_PlaySound("devastator/idle",6,1.0,1)
  ReadyLoop:
	CDEV B 2 A_WeaponReady
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",8,0,28,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION|SXF_TRANSFERPITCH,160)
	Loop
  Deselect:
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderDeselect")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade", 1, "CommanderDeselect")
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_WEAPON)
  DeselectLoop:
	DEVG A 1 A_Lower
    Loop
  CommanderDeselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_WEAPON)
  DeselectLoop:
	CDEV B 1 A_Lower
	Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("DemonTechDevastator",1)
	//Stop
  SelectLoop:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderSelect")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade", 1, "CommanderSelect")
  SelectLoop2:
	DEVG A 1 A_Raise
    Goto SelectLoop2
  CommanderSelect:
	CDEV B 1 A_Raise
	Loop
  Fire:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderFire")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade",1,"CommanderFire")
    DEVG A 0 A_StopSound(6)
    DEVG B 10 A_PlayWeaponSound("devastator/charge")
    DEVG CDEF 10 Bright
    DEVG G 3 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG HIGHI 4 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG G 3 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG HIGHI 4 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG A 0 A_Refire
    DEVG J 4 Bright A_GunFlash
    TNT1 A 0 A_Recoil(20)
    DEVG J 1 Bright A_PlaySound("devastator/fire")
    DEVG K 10 Bright A_FireCustomMissile("PlayerDevastatorBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75)
    DEVG L 7 Bright
    Goto Ready
  AltFire:
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderAltFire")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade", 1, "CommanderAltFire")
	TNT1 A 0 A_RailWait
    DEVG A 1
    Goto Ready
  Hold:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckForUpgrade") == 1,"CommanderHold")
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade", 1, "CommanderHold")
    DEVG A 0 A_StopSound(6)
    DEVG G 1 Bright A_PlayWeaponSound("weapons/devfch")
    DEVG G 3 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG HIGHI 4 Bright A_FireBullets(4,4,2,6,"DevPuff",0,64)
    DEVG I 0 A_Refire
    DEVG J 4 Bright A_GunFlash
    DEVG J 1 Bright A_PlaySound("devastator/fire")
    DEVG K 10 Bright A_FireCustomMissile("PlayerDevastatorBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75)
    DEVG L 7 Bright
    Goto Ready
  CommanderFire:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_StopSound(6)
	CDEV A 10 Bright A_PlaySound("devastator/charge",CHAN_WEAPON)
	CDEV CDEF 10 Bright
	CDEV G 3 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	CDEV HIGHI 4 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	CDEV G 3 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	CDEV HIGHI 4 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	TNT1 A 0 A_Refire
	CDEV J 4 Bright A_GunFlash
	TNT1 A 0 A_Recoil(20)
	CDEV J 1 Bright A_PlaySound("devastator/fire")
	CDEV K 10 Bright A_FireCustomMissile("PCommanderDevastatorBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75)
	CDEV L 7 Bright
	Goto CommanderReady
  CommanderHold:
	TNT1 A 0 A_StopSound(6)
	//TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto CommanderReady
	CDEV G 1 Bright A_PlayWeaponSound("weapons/devfch")
	CDEV G 3 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	CDEV HIGHI 4 Bright A_FireBullets(4,4,2,6,"CommanderDevPuff",0,64)
	TNT1 A 0 A_Refire("CommanderHold")
	CDEV J 4 Bright A_GunFlash
	CDEV J 1 Bright A_Playsound("devastator/fire")
	CDEV K 10 Bright A_FireCustomMissile("PCommanderDevastatorBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75)
	CDEV L 7 Bright
	Goto CommanderReady
  CommanderAltFire:
	//TNT1 A 0 A_JumpIfInventory("DemonAmmo",50,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto CommanderReady
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("Cardinal/9k",CHAN_WEAPON)
	CDEV A 2 Bright Radius_Quake(1,2,0,1,0)
	CDEV CD 2 Bright Radius_Quake(2,2,0,1,0)
	CDEV EFG 2 Bright Radius_Quake(4,2,0,1,0)
	CDEV HIG 1 Bright Radius_Quake(6,3,0,1,0)
	TNT1 A 0 Radius_Quake(8,3,0,1,0)
	CDEV HIGHIGHIGHIGHIL 1 Bright
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(10,4,0,1,0)
	CDEV J 2 Bright
	TNT1 A 0 A_Recoil(10)
	TNT1 A 0 Radius_Quake(12,6,0,1,0)
	CDEV K 10 Bright A_FireCustomMissile("PlayerPurpleDTBFG10KBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",25,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",25)
	TNT1 A 0 Radius_Quake(3,10,0,1,0)
	CDEV L 7 Bright
	CDEV B 20
	//TNT1 A 0 A_JumpIfInventory("DemonAmmo",50,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto CommanderReady
	CDEV B 60 A_PlaySound("weapons/dtech10kcharge",CHAN_WEAPON)
	CDEV B 10 A_PlaySound("weapons/plasmacellin",CHAN_WEAPON)
	Goto CommanderReady
  Flash:
    TNT1 A 5 A_Light1
    TNT1 A 10 A_Light2
    TNT1 A 7 A_Light1
    TNT1 A 5 A_Light0
    Stop
  }
}

Actor DevPuff
{
  Height 8
  Radius 4
  RenderStyle None
  Decal None
  +NODECAL
  +NOGRAVITY
  +NOBLOCKMAP 
  +PAINLESS
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  +NOTRIGGER
  +DONTREFLECT
  +DONTSPLASH
  +FOILINVUL
  +ALWAYSPUFF
  +PUFFGETSOWNER
  +THRUSPECIES
  +MTHRUSPECIES
  +HITTRACER
  +MISSILE
  +NOTONAUTOMAP
  +SERVERSIDEONLY
  +NONETID
  SeeSound "None"
  ActiveSound "None"
  AttackSound "None"
  //Height 3
  //DeathSound "weapons/buzz"
  States
  {
  Spawn:
    DLIT JKLJKLJKL 3 Bright
    Stop
  Crash:
    TNT1 A 1
    Stop
   }
}
Actor CommanderDevPuff : DevPuff
{
  States
  {
  Spawn:
    PLIT JKLJKLJKL 3 Bright
    Stop
  }
}

Actor DevastatorBall
{
  Radius 16
  Height 16
  Damage (Random(4000,8000))
  Speed 15
  Alpha 0.95
  Scale 0.7
  RenderStyle Translucent
  Alpha 0.85
  Projectile
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +SKYEXPLODE
  +MTHRUSPECIES
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("PlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("PLiteShot",0,0,frandom(0,360))
    CRS9 A 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 A 1 Bright A_CustomMissile("PlayerDevastatorProjectileAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
	TNT1 A 0 A_CustomMissile("DevastatorTrail",0,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("PlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("PLiteShot",0,0,frandom(0,360))
    CRS9 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 B 1 Bright A_CustomMissile("PlayerDevastatorProjectileAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
	TNT1 A 0 A_Explode(64,256,0)
	TNT1 A 0 A_CustomMissile("PlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("PLiteShot",0,0,frandom(0,360))
    CRS9 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 C 1 Bright A_CustomMissile("PlayerDevastatorProjectileAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
	TNT1 A 0 A_CustomMissile("DevastatorTrail",0,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("PlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("PLiteShot",0,0,frandom(0,360))
    CRS9 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 D 1 Bright A_CustomMissile("PlayerDevastatorProjectileAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
	TNT1 A 0 A_Explode(64,256,0)
    Goto Spawn
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("DTBFG10KTracerHuman",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRedSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	TNT1 A 0 A_Explode(80,256)
	CRS9 A 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CRS9 B 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CRS9 C 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CRS9 D 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto DeathLoop2
	TNT1 A 0 A_Explode(128,1024,1)
	TNT1 A 0 A_Explode(460,640,1)
	TNT1 A 0 A_Explode(618,256,1)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTBFGEx",0,0,-10,0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	CRE9 D 0 Bright A_CustomMissile("PlayerDevastatorBall2",0,0,user_loop * 18,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	CRE9 AAAAAABBBBBBCCCCCCDDDDDD 1 A_CustomMissile("KaboomDevastator22",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    CRE9 EF 6 Bright
    Stop    
  }
}

Actor PCommanderDevastatorBall : DevastatorBall
{
  Speed 45
  FastSpeed 55
  Radius 25
  Height 25
  Species "Player"
  DamageType "PlayerDevBall"
  //+FRIENDLY
  +NOTIMEFREEZE
  +SEEKERMISSILE
  Obituary "$CFPCommanderDevastatorBallObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("PCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("PCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" A 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" C 1 Bright A_CustomMissile("PCerComDevastatorProjectileAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PurpleDevastatorTrail",0,0,0,CMF_AIMDIRECTION)
	TNT1 AAAA 0 A_CustomMissile("PCommanderDevastatorBall2",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_CustomMissile("PCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("PCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" D 1 Bright A_CustomMissile("PCerComDevastatorProjectileAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 AAAA 0 A_CustomMissile("PCommanderDevastatorBall2",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
