    TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurpleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	CPS1 ABCD 6 Bright A_SpawnItemEx("PurpleDTech10KShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,256,1,0)
	TNT1 A 0 A_Explode(240,128,1,0)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode",6)
	TNT1 A 0 A_SpawnItemEx("PurpleDTech10KShockwave2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 20 A_SpawnItem("PurpleDTBFGEx",0,-10)
	Stop
  }
}

Actor PCerComDTBFGProjectileAttack : PCerComDevastatorProjectileAttack
{
  DamageType "PlayerDevBall"
  States
  {
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 1 A_CustomRailgun(random(2,8),0,None,"80 00 FF",RGF_SILENT|RGF_FULLBRIGHT,0,2,"PPurpleDTBFGRailgunSlugPuff")
	Goto Death
  }
}

Actor PPurpleDTBFGRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "PlayerDevBall"
}

Actor PDTBFG10KTracerPurple : DTBFG10KTracer
{
  +NOTIMEFREEZE
  -STRIFEDAMAGE
  States
  {
  XDeath:
	TNT1 A 1 A_SpawnItem("PurpleSpray")
	Stop
  }
}

Actor CommanderDevUpgrade : CustomInventory
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  Inventory.PickupSound "upgrade/pickup"
  Inventory.PickupMessage "$CFCommanderDevUpgradePickup"
  Tag "$CFCommanderDevUpgrade"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"Remove")
  SpawnLoop:
	CVUP ABCD 3
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CommanderDevUpgrade",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",86)
	Stop
  Use:
	TNT1 A 0
	Fail
  Remove:
	TNT1 A 0
	Stop
  }
}

Actor PlayerDevastatorBall : DevastatorBall
{
  +NODAMAGETHRUST
  Species "Player"
  DamageType "PlayerDevBall"
}

Actor PlayerDevastatorProjectileAttack
{
  Health 1
  Height 3
  Radius 3
  Speed 15
  RenderStyle None
  Obituary "$CFPlayerDevastatorProjectileAttackObit"
  //Species "Player"
  +MISSILE
  +DROPOFF
  +DONTBLAST
  +NOTELEPORT
  +NOBLOCKMAP
  +THRUACTORS
  +FORCERADIUSDMG
  +MTHRUSPECIES
  +NOTONAUTOMAP
  +SERVERSIDEONLY
  +NONETID
  DamageType "DTBFGBall"
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
  SpawnLoop:
	TNT1 A 0 A_CustomRailgun(0,0,NONE,NONE,RGF_SILENT|RGF_EXPLICITANGLE|RGF_CENTERZ,0,0,"DevPuff",0,0,1250,0,0,0,"None",0)
	TNT1 A 0 A_SetAngle(angle+18)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 19,2)
	TNT1 A 0 A_Jump(256,"SpawnLoop")
	TNT1 A 5
	Stop
  }
}

