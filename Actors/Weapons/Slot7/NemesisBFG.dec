Actor NemesisBFGGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "NemesisBFG/Pickup"
  Inventory.PickupMessage "$CFNemesisBFGPickup"
  Tag "$CFNemesisBFG"
  States
  {
  Spawn:
	NMBH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	NMBH A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",23,-1,18) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("NemesisBFG",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("NemesisBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",91)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NLDemonAmmo",150)
	Stop
  }
}

Actor NemesisBFGSpawnerGiver : NemesisBFGGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("NemesisBFG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("NemesisBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",91)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("NemesisBFGGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("NemesisBFGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NLDemonAmmo",150)
	Stop
  }
}

Actor NemesisBFGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor NemesisBFG : Weapon
{
  +NOAUTOFIRE
  +WEAPON.BFG
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.PreferredSkin "LegendaryBFG-Marine"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 12.0
  Weapon.AmmoType "NLDemonAmmo"
  Weapon.AmmoType2 "NLDemonAmmo"
  Weapon.AmmoUse 150
  Weapon.AmmoUse2 50
  Weapon.KickBack 90
  Weapon.UpSound "NemesisBFG/Pickup"
  //Weapon.MinSelectionAmmo1 150
  //Weapon.MinSelectionAmmo2 50
  Weapon.SelectionOrder 7000
  Inventory.PickupSound "NemesisBFG/Pickup"
  Inventory.PickupMessage "$CFNemesisBFGPickup"
  Obituary "$CFNemesisBFGObit"
  Tag "$CFNemesisBFG"
  States
  {
  Spawn:
	NMBH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	NMBH A -1
	Stop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("NemesisBFG",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_Raise
	NMB8 Q 1 A_Raise
	Goto SelectLoop + 1
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_ZoomFactor(1)
  DeselectLoop:
	TNT1 A 0 A_Lower
	NMB8 Q 1 A_Lower
	Loop
  Ready:
	TNT1 A 0 A_ZoomFactor(1)
	TNT1 A 0 A_PlaySound("NemesisBFG/Loop",5,1.0,1)
	NMB0 AAAABBBBCCCCDDDDCCCCBBBB 1 A_WeaponReady
	Loop
  Fire:
	//TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",150,1)
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_PlaySound("truelegbfg/trigger",6)
	NMB9 A 1 A_AlertMonsters
	TNT1 A 0 A_PlaySound("NemesisBFG/Charge",1)
	NMB9 AABBCCDD 1
	TNT1 A 0 A_GiveInventory("CFGuruCharge",25)
  Gurucharger:
	TNT1 A 0 A_TakeInventory("CFGuruCharge",1)
	//TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner")
	NMB9 ABCD 1 Bright A_Quake(4,2,0,2,"none")
	TNT1 A 0 A_JumpIfInventory("CFGuruCharge",1,"Gurucharger")
	NMB8 AABBCCDD 1 Bright A_Quake(4,2,0,2,"none")
	TNT1 A 0 A_PlaySound("NemesisBFG/Fire",1)
	TNT1 A 0 A_FireCustomMissile("PlayerNemesisGuruBall",0,0,12)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",75)
	TNT1 A 0 A_Recoil(45)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_SetBlend("White",0.5,60)
	TNT1 A 0 A_SetBlend("White",0.25,60)
	NMB8 E 1 Bright A_ZoomFactor(0.9)
	NMB8 E 1 Bright A_ZoomFactor(0.91)
	NMB8 F 1 Bright A_ZoomFactor(0.92)
	NMB8 F 1 Bright A_ZoomFactor(0.93)
	NMB8 G 1 Bright A_ZoomFactor(0.94)
	NMB8 G 1 Bright A_ZoomFactor(0.95)
	NMB8 H 1 Bright A_ZoomFactor(0.96)
	NMB8 H 1 Bright A_ZoomFactor(0.97)
	NMB8 I 1 Bright A_ZoomFactor(0.98)
	NMB8 I 1 Bright A_ZoomFactor(0.99)
	NMB8 KK 1 A_ZoomFactor(1)
	NMB8 LLMMNNOOPPQQ 1
	Goto Ready
  Altfire:
	//TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",50,1)
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",50 - 25 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("star/fire",1)
	TNT1 A 0 A_FireCustomMissile("PlayerMiniNemesisBFGBall",0,0,12,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",25,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",25)
	TNT1 A 0 A_Recoil(25)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_SetBlend("White",0.25,35)
	TNT1 A 0 A_SetBlend("White",0.125,35)
	NMB8 EFGHIJ 1 Bright
	NMB8 LLMMNNOOPPQQ 1
	Goto Ready
  Flash:
	TNT1 A 7 Bright A_Light2
	TNT1 A 4 Bright A_Light1
	TNT1 A 0 Bright A_Light0
	Stop
  }
}

