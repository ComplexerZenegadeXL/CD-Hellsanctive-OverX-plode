Actor NemesisPlayerDevastatorBolt : NemesisCyberDevastatorBolt
{
  Species "Player"
  DamageType "PlayerNemesisBFG"
  +THRUSPECIES
}

Actor PlayerNemesisGuruSphereSmokeProjectile : CyberNemesisGuruSphereSmokeProjectile { /*Species "Player"*/ Damagetype "PlayerNemesisBFG" }

Actor NemesisPlayerBFGTracerAttack : DTBFGTracerAttack
{
  DamageType "PlayerNemesisBFG"
  Obituary "$CFNemesisPlayerBFGTracerAttackObit"
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(20,0,NONE,"White",RGF_SILENT|RGF_FULLBRIGHT,0,2,"PlayerRailTargetPuff",0,0,1250,0,3.0,0,"NemesisBFGRailParticle")
	Goto Death
  }
}

Actor PlayerNemesisDeathBall : NemesisDeathBall
{
  DamageType "PlayerNemesisBFG"
  Damage 0
  +FOILINVUL
  States
  {
  Spawn:
	TNT1 A 0
	Goto Death
  Death:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_Explode(4056,1000,0,1,500)
	TNT1 A 0 A_BFGSpray("PlayerNemesisGuruSpray",20,20)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("NemesisBFGExplodeFX",0,0,10)
	TNT1 A 0 A_SpawnItemEx("NemesisGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("PlayerNemesisGuruSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_SETMASTER,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("NemesisGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("NemesisGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

