    TNT1 A 0 A_SpawnItemEx("NemesisGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_CustomMissile("NemesisPlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CLBB D 1 Bright A_SpawnItemEx("NemesisPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 //A_Explode(600,128,0,1) //600
	TNT1 A 0 A_SpawnItemEx("PlayerNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("NemesisGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_CustomMissile("NemesisPlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CLBB D 1 Bright A_SpawnItemEx("NemesisPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 //A_Explode(600,128,0,1) //600
	TNT1 A 0 A_SpawnItemEx("PlayerNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("NemesisGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_CustomMissile("NemesisPlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CLBB D 1 Bright A_SpawnItemEx("NemesisPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
