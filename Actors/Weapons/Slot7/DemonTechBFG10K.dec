Actor DemonTechBFG10KGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/dtech10kpickup"
  Inventory.PickupMessage "$CFDemonTechBFG10KPickup"
  Tag "$CFDemonTechBFG10K"
  States
  {
  Spawn:
    BFUG A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	BFUG A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",79,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("DemonTechBFG10K",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("DemonTechBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",84)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",100)
	Stop
  }
}

Actor DemonTechBFG10KSpawnerGiver : DemonTechBFG10KGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonTechBFG10K",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("DemonTechBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",84)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("DemonTechBFG10KGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("DemonTechBFG10KGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",100)
	Stop
  }
}

Actor DemonTechBFG10KGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor DemonTechBFG10K : Weapon
{
  Height 20
  Weapon.SelectionOrder 2780
  Weapon.AmmoUse 100
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 7.0
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  //Weapon.MinSelectionAmmo1 100
  Weapon.SelectionOrder 7000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Scale 0.85
  Weapon.PreferredSkin "DemonTechBFG10K-Marine"
  Inventory.PickupSound "weapons/dtech10kpickup"
  Inventory.PickupMessage "$CFDemonTechBFG10K"
  Obituary "$CFDemonTechBFG10KObit"
  Tag "$CFDemonTechBFG10K"
  Weapon.SisterWeapon "PoweredDemonTechBFG10k"
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    BFUG A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	BFUG A -1
    Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",14,0,1)
	TNT1 A -1
	Stop
  Select:   
	//TNT1 A 0 A_JumpIfNoAmmo("Select2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Select2
    TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kpickup")
    DBFI A 1 A_Raise
    Goto Select+2
  Select2:   
    TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kpickup")
    DBFE A 1 A_Raise
    Goto Select2+1	
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	//TNT1 A 0 A_JumpIfNoAmmo("Deselect2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Deselect2
  DeselectLoop:
	DBFI A 1 A_Lower
    Loop
  Deselect2:
	DBFE A 1 A_Lower
    Loop
  Ready:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kidle")
    DBFI AAAABBBBCCCCBBBB 1 A_WeaponReady
    Loop
  Ready2:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",100,"Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	//Goto Ready
	DBFE A 1 A_WeaponReady
	Loop
  Fire:
	//TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Light1
    TNT1 A 0 A_PlayWeaponSound("Cardinal/9k")
	DBFG C 2 Bright Radius_Quake(1,2,0,1,0)
    DBFG DE 2 Bright Radius_Quake(2,2,0,1,0)
    DBFG FGH 2 Bright Radius_Quake(4,2,0,1,0)
	DBFG IJK 1 Bright Radius_Quake(6,3,0,1,0)
	DBFG L 15 Bright Radius_Quake(8,3,0,1,0)
	TNT1 A 0 A_Light2
    TNT1 A 0 A_GunFlash	
	DBFG M 2 Bright Radius_Quake(10,4,0,1,0)
	TNT1 A 0 A_Recoil(10)	
	TNT1 A 0 Radius_Quake(12,6,0,1,0)
	DBFG N 2 Bright A_FireCustomMissile("DTBFG10KBall",0,0,0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",50)
	DBFG OP 1 Bright
	TNT1 A 0 A_Light0
	DBFG QRST 2 Bright
	TNT1 A 0 Radius_Quake(3,10,0,1,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam")
	DBFE AAAAAAAAAAAA 1 A_FireCustomMissile("DTech10KSteam",-58+frandom(-4,4),0,0,0)
	DBFE A 20
	//TNT1 A 0 A_JumpIfInventory("DemonAmmo",100,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	DBFE A 60 A_PlayWeaponSound("weapons/dtech10kcharge")
	DBFE A 10 A_PlayWeaponSound("weapons/plasmacellin")
	Goto Ready
  }
}

Actor DTBFG10KBall
{
  Radius 20
  Height 30
  Damage (Random(300,500))
  Speed 18
  Alpha 0.95
  Scale 0.55
  RenderStyle Translucent
  Alpha 0.85
  Projectile
  DamageType "PDTBFG"
  +FORCERADIUSDMG
  +THRUSPECIES
  Species "Player"
  Obituary "$CFDTBFG10KBallObit"
  DeathSound ""
  Decal "BFG9500Lightning"
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    CGS1 ABCD 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("DTBFGTracerAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
    Loop
  DTBFGSFX:
    //TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CGS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CGS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CGS1 C 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CGS1 D 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("DTBFGTracerAttack",4,0,angle,CMF_TRACKOWNER|CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,pitch)
    Goto Spawn
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("DTBFG10KTracer",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreenSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	CGS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwave3", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(400,256)
	TNT1 A 0 A_Explode(400,128)
	TNT1 A 0 A_Explode(600,64)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave4", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 Bright A_SpawnItemEx("PlayerDTBFGEx",0,0,-10,0,0,0,0)
    Stop    
  }
}

Actor PlayerDTBFGEx
{
  RenderStyle Add
  Alpha 0.85
  +CLIENTSIDEONLY
  +NOGRAVITY
  States
  {
  Spawn:
	CGE1 AAAAAABBBBBBCCCCCCDDDDDD 1 Bright A_CustomMissile("Kaboom15", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	CGE1 EF 6 Bright
	Stop
  }
}

Actor DTBFGTracerAttack
{
  Projectile
  Height 3
  Radius 3
  Speed 20
  FastSpeed 25
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +NOTIMEFREEZE
  +FRIENDLY
  DamageType "PDTBFG"
  Obituary "$CFDTBFGTracerAttackObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAA 2 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(64,128),0,NONE,"Green",RGF_SILENT|RGF_NOPIERCING,1,2,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor PlayerRailTargetPuff
{
  Height 1
  Radius 1
  Decal None
  Damage (0)
  +NODECAL
  +PAINLESS
  +DONTSPLASH
  +DONTREFLECT
  +NOINTERACTION
  +BLOODLESSIMPACT
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  }
}

Actor MonsterDBFGRailTargetPuff : PlayerRailTargetPuff { DamageType "DBFG2" }

Actor MonsterLegendaryRailTargetPuff : PlayerRailTargetPuff { DamageType "Legendary" }

Actor CyberRailTargetPuff : PlayerRailTargetPuff { DamageType "Cyber10K" }

Actor MastermindRailTargetPuff : PlayerRailTargetPuff { DamageType "DemolisherEx" }

Actor ZombieRailTargetPuff : PlayerRailTargetPuff { DamageType "SoapOpera" }