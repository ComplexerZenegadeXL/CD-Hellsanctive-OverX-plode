Actor T3DBFGBallParticleFloater : T3BaseEffect
{
  Height 0
  Radius 0
  Mass 0
  Scale 0.06
  RenderStyle Add
  BounceFactor 0.6
  Gravity 0.2
  Damage (0)
  +MISSILE
  -NOGRAVITY
  +THRUACTORS
  +DONTSPLASH
  +DOOMBOUNCE
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	SSKB ABC 2 Bright A_FadeOut(0.015,1)
	Loop
  }
}

Actor T3DBFGShockAttack : DTBFGTracerAttack
{
  DamageType "DBFG2"
  Obituary "$CFT3DBFGShockAttackObit"
  -FRIENDLY
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(8,16),0,NONE,"White",RGF_SILENT|RGF_NOPIERCING,1,2,"MonsterDBFGRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor PlayerT3DBFGShockAttack : T3DBFGShockAttack
{
  Species "Player"
  DamageType "PlayerDBFG2"
  Obituary "$CFPlayerT3DBFGShockAttackObit"
  +FRIENDLY
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(16,32),0,NONE,"White",RGF_SILENT|RGF_NOPIERCING,1,2,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

