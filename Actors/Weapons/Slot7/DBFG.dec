Actor D-BFGGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "misc/w_pkup2"
  Inventory.PickupMessage "$CFDBFGPickup"
  Tag "$CFDBFG"
  States
  {
  Spawn:
	BFG3 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	BFG3 A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",22,-1,8) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("D-BFG",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("D-BFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",92)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DCell",20)
	Stop
  }
}

Actor D-BFGSpawnerGiver : D-BFGGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("D-BFG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("D-BFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",92)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("D-BFGGiverCheck",1,"Nul")
	TNT1 A 0 A_GiveInventory("D-BFGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DCell",20)
	Stop
  }
}

Actor D-BFGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor D-BFG : Weapon
{
  Scale 0.85
  +WEAPON.BFG
  +WEAPON.NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOALERT
  Height 20
  Radius 20
  Weapon.PreferredSkin "DBFG-Marine"
  Decal "DBFGLightning"
  Weapon.SlotNumber 7
  Weapon.SlotPriority 1
  Weapon.Kickback 100
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 6.0
  Weapon.AmmoType"DCell"
  Weapon.AmmoUse2 15
  Weapon.AmmoType2 "DCell"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 15
  Weapon.SelectionOrder 7000
  AttackSound ""
  Weapon.UpSound "Weapons/dbfgup"
  Inventory.PickupSound "misc/w_pkup2"
  Inventory.PickupMessage "$CFDBFGPickup"
  Obituary "$CFDBFGObit"
  Tag "$CFDBFG"
  States
  {
  Spawn:
	BFG3 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	BFG3 A -1
	Stop
  Ready:
	TNT1 A 0 A_PlaySound("Weapons/dbfgready", CHAN_AUTO, 0.5)
	BG3G AAABBBCCCDDD 1 A_WeaponReady
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("D-BFG",1)
	//Stop
  SelectLoop:
	BG3G I 1 A_Raise
	BG3G I 0 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	BG3G I 1 A_Lower
	BG3G I 0 A_Lower
	Loop
  Fire:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DCellCheck") == 0,"Ready") //This uses ACS to confuse noobs who don't understand ACS
	TNT1 A 0 A_JumpIfInventory("DCell",1,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2", CHAN_WEAPON) // 196 tics.
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"NoSpeedForYou")
	BG3G JKL 4 Bright
	BG3G JKL 3 Bright
	BG3G JKLMNM 2 Bright
	Goto Hold
  Hold:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DCellCheck") == 0,"Ready")
	TNT1 A 0 A_JumpIfInventory("DCell",1,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	BG3G JKL 1 Bright A_GunFlash
	BG3G E 1 Bright A_GunFlash
	TNT1 A 0 A_SetBlend("Blue", 0.02, 3)
	BG3G F 1 Bright A_FireCustomMissile("PlayerT3DBFG10kShot",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_TakeInventory("DCell",1)
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2", CHAN_BODY)
	BG3G G 2 Bright A_Recoil(3)
	BG3G H 2 Bright A_ReFire
	BG3G I 30 A_PlaySound("Weapons/dbfgcooldown2", CHAN_WEAPON)
	Goto Ready
  NoSpeedForYou:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DCellCheck") == 0,"Ready")
	TNT1 A 0 A_JumpIfInventory("DCell",1,1)
	Goto Ready
	BG3G JKL 8 Bright 
	BG3G JKL 6 Bright
	BG3G JKLMNM 4 Bright 
	Goto NoSpeedForYou2
  NoSpeedForYou2:
	BG3G JKL 2 Bright A_GunFlash 
	BG3G E 2 Bright A_GunFlash 
	TNT1 A 0 A_SetBlend("Blue", 0.02, 3)
	BG3G F 2 Bright A_FireCustomMissile("PlayerT3DBFG10kShot",frandom(-1,1),0,0,0,0,frandom(-1,1))  //2
	TNT1 A 0 A_TakeInventory("DCell",1)
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2", CHAN_BODY)
	BG3G G 4 Bright A_Recoil(3) 
	BG3G H 4 Bright A_ReFire 
	BG3G I 60 A_PlaySound("Weapons/dbfgcooldown2", CHAN_WEAPON)
	Goto Ready
  AltFire:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DCellCheck") < 15,"Ready")
	TNT1 A 0 A_JumpIfInventory("DCell",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge", CHAN_WEAPON) // 196 tics.
	//BG3G JKLJKL 4 Bright
	//BG3G M 3 Bright
	//BG3G JKLJKLJKL 4 Bright
	//BG3G M 3 Bright
	BG3G JKLJKL 3 Bright
	BG3G MNMJKLJKLJKLJKLMNMJKLJKLJKLMNMJKLJKLMNMJKL 2 Bright
	TNT1 A 0 A_CheckReload
	Goto AltHold
  AltHold:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DCellCheck") < 15,"Ready")
	TNT1 A 0 A_JumpIfInventory("DCell",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	BG3G MNMJKLMNM 2 Bright
	BG3G JKLMNMJKLMNME 1 Bright
	TNT1 A 0 A_SetBlend("Blue", 0.02, 3)
	//BG3G F 1 Bright A_FireBullets(0,0,1,0,"T3DBFGShot")
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	BG3G F 2 A_FireCustomMissile("PlayerT3DBFGBall", 0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DCell",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DCell",10)
	BG3G G 2 Bright A_Recoil(20)
	BG3G H 2 Bright A_ReFire
	BG3G I 50 A_PlaySound("Weapons/dbfgcooldown")
	TNT1 A 0 A_CheckReload
	Goto Ready
  GrenadeCheck:
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,"GrenadeToss")
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	Goto Ready
  GrenadeToss:
	TNT1 A 0 A_GiveInventory("Hand Grenade")
	TNT1 A 0 A_SelectWeapon("Hand Grenade")
	Goto Deselect
  MineCheck:
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,"MineToss")
	TNT1 A 0 A_TakeInventory("MineAction",1)
	Goto Ready
  MineToss:
	TNT1 A 0 A_GiveInventory("Land Mine")
	TNT1 A 0 A_SelectWeapon("Land Mine")
	Goto Deselect
  WeaponSwitch:
	TNT1 A 0 A_CheckReload
	Goto Ready
  }
}

Actor DCellPickup : GasPickup
{
  Inventory.PickupMessage "$CFDCellPickup"
  Inventory.PickupSound "items/cell"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	BG3C AB 3
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",9,10)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",9) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 
	Stop
  Remove:
    TNT1 A 0
	Stop
  }
}

