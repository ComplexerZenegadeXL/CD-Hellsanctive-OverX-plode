Actor T3DBFGTracer : FastProjectile
{
  Height 4
  Radius 16
  Speed 60
  Decal None
  Damage 50
  +THRUSPECIES
  //+NOTIMEFREEZE
  Species "Cybers"
  States
  {
  Spawn:
	TNT1 A 15
	Stop
  Death:
	TNT1 A 1
	Stop
  XDeath:
	TNT1 A 0
	TNT1 A 1 A_SpawnItem("LightBlueSpray")
	Stop
  }
}

Actor T3DBFG10KBall
{
  Projectile
  Radius 20
  Height 30
  Scale 0.55
  RenderStyle Translucent
  Obituary "$CFT3DBFG10KBallObit"
  DeathSound ""
  Decal "BFG9500Lightning"
  Speed 20
  Alpha 0.85
  Damage 150
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  //+NOTIMEFREEZE
  Species "Cybers"
  DamageType "DBFG2"
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
  SpawnLoop:
	TNT1 A 0 A_Jump(128,"SFX")
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 A 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 B 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 C 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 D 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	Loop
  SFX:
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 A 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 B 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 C 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 D 1 Bright A_SpawnItemEx("T3DBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	Goto SpawnLoop
  Death:
	TNT1 A 0 		
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("T3DBFGTracer",0,0,user_loop * 10,CMF_TRACKOWNER|CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
