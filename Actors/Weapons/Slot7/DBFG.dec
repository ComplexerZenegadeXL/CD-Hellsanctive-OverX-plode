	SSKB A 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB C 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB A 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB B 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	SSKB C 1 Bright A_FadeOut(0.08+frandom(-0.0075,0.0075),1)
	TNT1 A 1 A_SpawnItemEx("T3DBFGBallParticleTrail",0,0,0,0)
	Loop
  }
}

