Actor T3DBFG10kDeathParticleSpawner
{
+MISSILE
+NOCLIP
+NOBLOCKMAP
+NOGRAVITY
+NOTELEPORT
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAA 1 A_SpawnItemEx("T3DBFG10kDeathParticle", 0, 0, 0, frandom(2, 4.5), 0, frandom(-4.0, 4.0), frandom(0, 360), SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_SpawnItemEx("T3DBFG10kDeathParticle", 0, 0, 0, frandom(2, 4.5), 0,frandom(-4.0, 4.0), frandom(0, 360), SXF_CLIENTSIDE)
	TNT1 AAAAA 1 A_SpawnItemEx("T3DBFG10kDeathParticle", 0, 0, 0, frandom(2, 4.5), 0, frandom(-4.0, 4.0), frandom(0, 360), SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_SpawnItemEx("T3DBFG10kDeathParticle", 0, 0, 0, frandom(2, 4.5), 0, frandom(-4.0, 4.0), frandom(0, 360), SXF_CLIENTSIDE)
	TNT1 A 1
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

