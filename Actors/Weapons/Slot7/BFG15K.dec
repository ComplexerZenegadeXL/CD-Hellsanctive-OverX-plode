Actor BFG15KGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFBFG15KPickup"
  Inventory.PickupSound "weapons/pickup15k"
  Tag "$CFBFG15K"
  States
  {
  Spawn:
	15KW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	15KW A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",40,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BFG15KUpgrade",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",81)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",Random(75,150))
	Stop
  }
}

Actor BFG15KSpawnerGiver : BFG15KGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BFG15KUpgrade",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",81)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BFG15KGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BFG15KGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",Random(75,150))
	Stop
  }
}

Actor BFG15KGiverCheck : Inventory { Inventory.InterHubAmount 0 }