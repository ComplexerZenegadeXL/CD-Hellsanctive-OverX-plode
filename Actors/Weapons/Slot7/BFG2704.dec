Actor BFG2704Giver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/bfgpickup"
  Inventory.PickupMessage "$CFBFG2704Pickup"
  Tag "$CFBFG2704"
  States
  {
  Spawn:
	WBF2 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	WBF2 A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",20,-1,2) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BFG2704",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BFG2704",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",82)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NewCell",80)
	Stop
  }
}

Actor BFG2704SpawnerGiver : BFG2704Giver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BFG2704",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BFG2704",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",82)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BFG2704GiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BFG2704GiverCheck",1)
	TNT1 A 0 A_GiveInventory("NewCell",80)
	Stop
  }
}

Actor BFG2704GiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor BFG2704 : Weapon 30381
{
  //$Category Weapons/CF
  //$Title "BFG2704"
  //$Sprite WBF2A0
  Height 20
  +WEAPON.BFG
  +WEAPON.NOAUTOAIM
  +WEAPON.NOAUTOFIRE
  +WEAPON.NOALERT
  Weapon.SelectionOrder 2800
  Weapon.PreferredSkin "BFG9500-Marine"
  Weapon.AmmoUse 2
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 2.0
  Weapon.AmmoType "NewCell"
  Weapon.AmmoType2 "NewCell"
  //Weapon.MinSelectionAmmo1 40
  //Weapon.MinSelectionAmmo2 100
  Weapon.SelectionOrder 6000
  Inventory.PickupSound "weapons/bfgpickup"
  Inventory.PickupMessage "$CFBFG2704Pickup"
  Weapon.UpSound "weapons/bfgpickup"
  Tag "$CFBFG2704"
  States
  {
  Spawn:
	WBF2 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	WBF2 A -1
	Stop
  Ready:
	BF27 A 1 A_WeaponReady
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("BFG2704",1)
	//Stop
  SelectLoop:
	BF27 A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	//TNT1 A 0 A_Light0
  DeselectLoop:
	BF27 A 1 A_Lower
	Loop
  Fire:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"NoSpeedForYou")
	BF27 A 15 A_PlayWeaponSound("BFG2704/Charge")
	BF27 B 15 A_AlertMonsters
	BF27 C 4 Bright A_GunFlash
  FireLoop:	
	TNT1 A 0 A_GiveInventory("Loop",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 D 1 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 D 1 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 E 1 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	BF27 E 1 Bright
	TNT1 A 0 A_JumpIfInventory("Loop",10,1)
	Goto FireLoop
	TNT1 A 0 A_TakeInventory("Loop",99)
	BF27 E 1 Bright
	BF27 C 2 Bright
	BF27 B 10 A_ReFire
	Goto Ready
  NoSpeedForYou:
	BF27 A 30 A_PlayWeaponSound("BFG2704/Charge")
	BF27 B 30 A_AlertMonsters
	BF27 C 8 Bright A_GunFlash
  FireLoop2:	
	TNT1 A 0 A_GiveInventory("Loop",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 D 2 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 D 2 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NewCellCheck") < 2,"RemoveLoop")
	BF27 E 2 Bright
	TNT1 A 0 A_FireCustomMissile("2704Ball",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_FireCustomMissile("2704Ball2",frandom(-8,8),0,frandom(-5,5),frandom(-5,5),0,frandom(-5,5))
	TNT1 A 0 A_TakeInventory("NewCell",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",1)
	BF27 E 2 Bright
	TNT1 A 0 A_JumpIfInventory("Loop",10,1)
	Goto FireLoop2
	TNT1 A 0 A_TakeInventory("Loop",99)
	BF27 E 2 Bright
	BF27 C 4 Bright
	BF27 B 20 A_ReFire
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"NoSpeedForYou2")
	TNT1 A 0 A_JumpIfInventory("NewCell",100,2)
	BF27 A 1 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
	BF27 A 15 A_PlayWeaponSound("weapons/bfgf")
	BF27 B 15 A_AlertMonsters
	BF27 C 4 Bright A_GunFlash
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",50)
	TNT1 A 0 A_FireCustomMissile("2704Ball3",0,0,0,6)
	BF27 DE 1 Bright
	BF27 C 2 Bright
	BF27 B 10
	TNT1 A 0 A_ReFire
	Goto Ready
  NoSpeedForYou2:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("NewCell",100,2)
	BF27 A 2 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
	BF27 A 30 A_PlayWeaponSound("weapons/bfgf")
	BF27 B 30 A_AlertMonsters
	BF27 C 8 Bright A_GunFlash
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",50)
	TNT1 A 0 A_FireCustomMissile("2704Ball3",0,0,0,6)
	BF27 DEC 2 Bright
	BF27 B 20
	TNT1 A 0 A_ReFire
	Goto Ready
  Flash:
	TNT1 A 40 A_Light2
	TNT1 A 3 A_Light1
	Goto LightDone
  RemoveLoop:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("Loop",99)
	TNT1 A 0 A_CheckReload
	Goto Ready
  }
}

Actor 2704Ball
{
  Projectile
  Height 8
  Radius 8
  Speed 26
  Decal "GreenPlasmaScorch"
  Scale 1.0
  RenderStyle Add
  Alpha 0.75
  BounceType "Doom" //"Hexen"
  BounceCount 15
  BounceFactor 1.0
  WallBouncefactor 1.0
  ReactionTime 44
  Damage (3*random(2,8))
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +FRIENDLY
  +RANDOMIZE
  +SEEKERMISSILE
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +CANBOUNCEWATER
  Species "Player"
  Damagetype "DiscoBFG"
  Seesound "BetaBall/Fire"
  DeathSound "weapons/hrballexplode"
  Tag "BFG 2704"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_TARGET, AAPTR_TARGET, AAPTR_NULL)
	Goto SpawnLoop
  SpawnLoop:
	BBGB AAABBB 2 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,150,0,360,"Attack")
	TNT1 A 0 A_CountDown
	Loop
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_MASTER, AAPTR_NULL)
	TNT1 A 0 A_CustomRailgun(4*random(1,4),0,None,"Green",RGF_SILENT|RGF_FULLBRIGHT,0,2)
	BBGB A 1 Bright
	Goto Seek
  Seek:
	TNT1 A 0
	TNT1 A 0 A_ScaleVelocity(1.5)
	BBGB AAAAAABBBBBB 1 Bright A_SeekerMissile(25,35,SMF_LOOK|SMF_PRECISE,256,3)
	Goto Fly
  Fly:
	BBGB AB 6 Bright
	TNT1 A 0 A_CountDown
	Loop
  Death:
	BBGB C 6 Bright
	BBGB DE 4 Bright
	Stop
  }
}
	
Actor 2704Ball2 : 2704Ball
{
  Projectile
  Decal "RedPlasmaScorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_TARGET, AAPTR_TARGET, AAPTR_NULL)
	Goto SpawnLoop
  SpawnLoop:
	BBG2 AAABBB 2 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,150,0,360,"Attack")
	TNT1 A 0 A_CountDown
	Loop
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_MASTER, AAPTR_NULL)
	TNT1 A 0 A_CustomRailgun(4*random(1,4),0,None,"Red",RGF_SILENT|RGF_FULLBRIGHT,0,2)
	BBG2 A 1 Bright
	Goto Seek
  Seek:
	TNT1 A 0
	TNT1 A 0 A_ScaleVelocity(1.5)
	BBG2 AAAAAABBBBBB 1 Bright A_SeekerMissile(25,35,SMF_LOOK|SMF_PRECISE,256,3)
	Goto Fly
  Fly:
	BBG2 AB 6 Bright
	TNT1 A 0 A_CountDown
	Loop
  Death:
	TNT1 A 0
	BBG2 CDEFGHI 3 Bright
	Stop
  }
}

Actor 2704Ball3 : 2704Ball
{
  Projectile
  Height 8
  Radius 13
  Speed 25
  Bouncetype None
  Decal "BFG9500Lightning"
  Damage (Random(300,600))
  DeathSound "BFG9K/Explode"
  var int user_loop;
  var int user_loop2;
  States
  {
  Spawn:
	TNT1 A 0
	BFS3 AAABBB 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("BFG2704Ex",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("PlayerDTBFGEx",0,0,-10,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(176,176,0,0)
  DeathLoop:
	TNT1 A 6
	TNT1 A 0 A_SetUserVar("user_loop2",0)
  DeathLoop2:
	TNT1 A 0 A_CustomMissile("2704Ball",0,0,(user_loop2 * 36) + user_loop,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_CustomMissile("2704Ball2",0,0,(user_loop2 * 36) + user_loop+1,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop2", user_loop2 + 1)
	TNT1 A 0 A_JumpIf(user_loop2 == 10,2)
	TNT1 A 0 A_Jump(256,"DeathLoop2")
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 2)
	TNT1 A 0 A_JumpIf(user_loop > 4,1)
	Goto DeathLoop
	TNT1 A 6
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	TNT1 A 0 A_CustomMissile("2704Ball",0,0,(user_loop * 36) + random(-10,10),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_CustomMissile("2704Ball2",0,0,(user_loop * 36) + random(-10,10),CMF_AIMDIRECTION|CMF_TRACKOWNER,random(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop == 10,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	TNT1 AA 6
	Stop
  }
}

Actor BFG2704Ex
{
  RenderStyle Add
  Alpha 0.75
  +NOGRAVITY
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom11",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE3 AB 8 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BFE3 CDEF 8
	Stop
  }
}