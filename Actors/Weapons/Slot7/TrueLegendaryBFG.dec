//TRUE LEGENDARY UPGRADE

Actor PlayerLaserBeam : LegCyberLaserBeam
{
  Species "Player"
  DamageType "LegendaryGuruPlayer"
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  States
  {
  Death:
	TNT1 A 0 A_SetUserVar("user_boomc", 0)
	TNT1 A 0 A_SpawnItemEx("PowBolt_BoomFlash",0,0,0, 0,0,0)
	TNT1 A 0 A_SpawnItemEx("PowBolt_BoomFlashB",0,0,0, 0,0,0)
	TNT1 A 0 A_SpawnItemEx("PowBolt_Boom",0,0,0, 0,0,0)
	TNT1 A 0 A_SpawnItemEx("PowBolt_Boom2",0,frandom(60,70),50, 0,0,0)
	TNT1 A 0 A_SpawnItemEx("PowBolt_Boom3",0,frandom(-70,-60),-50, 0,0,0)
	TNT1 A 0 A_SpawnItemEx("PBolt_BoomWave",0,0,0, 0,0,0)
	TNT1 A 0 A_Quake(5, 20, 0, 864, " ")
	TNT1 A 0 A_Explode (850, 128)
  Boom:
	TNT1 A 0 A_JumpIf(user_boomc>=5,"Boom2")
	TNT1 A 0 A_Explode (128, 32)
	TNT1 A 1 A_SetUserVar("user_boomc", user_boomc+1)
	loop
  Boom2:
	TNT1 A 0 A_SetUserVar("user_boomc", 0)
	TNT1 A 0 A_SpawnItemEx("PBolt_BoomWave",0,0,0, 0,0,0)
  Boom2s:
	TNT1 A 0 A_JumpIf(user_boomc>=20,"Boomend")
	TNT1 A 0 A_Explode (128, 32)
	TNT1 A 2 A_SetUserVar("user_boomc", user_boomc+1)
	loop
  Boomend:
	TNT1 A 0
	stop
  }
}

Actor PlayerTrueLaserBeam : TrueLegendaryLaserBeam
{
  Species "Player"
  Damagetype "LegendaryGuruPlayer"
  MissileType "TrueLegendaryLaserBeamTrailSpawner2"
  Scale 2.0
  Damage (Random(400,700)) //125
  +NODAMAGETHRUST
  +FOILINVUL
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  -RIPPER
  States
  {
  Death:
	TNT1 A 0 Radius_Quake(6, 6, 0, 12, 0)
	TNT1 A 0 A_Explode(512, 64, 0)
    T3FS ABCDEFGHIJKLMNOP 2 Bright A_FadeOut(0.06)
    Stop
  }
}

Actor TrueLegendaryLaserBeamTrail2 : TrueLegendaryLaserBeamTrail { Scale 3.0 }

Actor TrueLegendaryLaserBeamTrailSpawner2 : TrueLegendaryLaserBeamTrailSpawner
{
  DamageType "LegendaryGuruPlayer"
  +FOILINVUL
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  States
  {
    Spawn:
      TNT1 A 0
	  TNT1 A 0 A_Explode(256, 64, 0)
      TNT1 A 2 A_SpawnItemEx("TrueLegendaryLaserBeamTrail2", frandom(-3, 3), 0, frandom(-3, 3), 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
      Stop
  }
}

Actor Nothing
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  +DONTSPLASH
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TNT1 A 1
	Stop
  }
}

Actor PlayerTrueGuruBall : CardinalSpecialGuruBall
{
  Species "Player"
  DamageType "LegendaryGuruPlayer"
  Damage (Random(80,170))
  +NODAMAGETHRUST
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +NOTIMEFREEZE
  States
  {
  Spawn:
	BBAL D 0
	"####" "#" 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	"####" "#" 0 A_Explode(80,96,0,1)
	"####" "#" 0 A_Jump(128,"LEGBFGSFX")
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerTrueDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL A 1 Bright
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerTrueDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL B 1 Bright
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerTrueDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL C 1 Bright
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerTrueDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL D 1 Bright
	Loop
  LEGBFGSFX:
    "####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerLegDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL A 1 Bright A_SpawnItemEx("TrueLegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    "####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerLegDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL B 1 Bright A_SpawnItemEx("TrueLegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    "####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerLegDevastatorBolt",6,0,random(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL C 1 Bright A_SpawnItemEx("TrueLegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    "####" "#" 1 A_SpawnItemEx("BlueGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_SpawnItemEx("BlueGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	"####" "#" 1 A_CustomMissile("PlayerLegDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	BBAL D 1 Bright A_SpawnItemEx("TrueLegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Goto Spawn
  Death:
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_Explode(Random(6000,7000),512,0,1)
	TNT1 A 0 A_BFGSpray("BlueGuruSprayPlayer",25,30)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("BlueGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("PlayerTrueLegBFGSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),0,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("BlueGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("BlueGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PlayerLegDevastatorBolt : LegCardDevastatorBolt { Species "Player" DamageType "LegendaryGuruPlayer" }

Actor TrueLegPlayerBFGTracerAttack : DTBFGTracerAttack
{
  DamageType "LegendaryGuruPlayer"
  Obituary "$CFTrueLegPlayerBFGTracerAttackObit"
  +NOTIMEFREEZE
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(16,32),0,NONE,"Blue",RGF_SILENT|RGF_NOPIERCING,1,12,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

