Actor TrueLegendaryBFGUpgrade : CustomInventory //doesn't actually do anything, upgrade code is in the weapon itself
{
  +INVENTORY.UNDROPPABLE
  +INVENTORY.PERSISTENTPOWER
  +INVENTORY.HUBPOWER
  Inventory.PickupSound "upgrade/pickup"
  Inventory.PickupMessage "\c[l5]True Legendary energy surges through your Legendary BFG...Party time!"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	TUPG ABCDCB 2 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",93)
	Stop
  Use:
	TNT1 A 0
	Fail
  }
}