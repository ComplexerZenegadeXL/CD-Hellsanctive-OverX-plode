Actor PlayerTrueDevastatorBolt : LegCardDevastatorBolt
{
  Species "Player"
  DamageType "LegendaryGuruPlayer"
  Damage (Random(50,150))
  +NODAMAGETHRUST
  +SCREENSEEKER
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  States
  {
  Spawn:
  	LBS1 A 0 A_SeekerMissile(25,25,SMF_LOOK)
    LBS1 A 1 A_SpawnItem("BlueLegBoltTrail")
    Loop
  }
}

