Actor HSBFGUpgrade : CustomInventory
{
  Radius 15
  -COUNTITEM
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  Inventory.PickupSound "upgrade/pickup"
  Inventory.PickupMessage "$CFHSBFGUpgradePickup"
  Tag "$CFHSBFGUpgrade"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	CEST ABCDEFGHIJJJKLMNOPQR 4
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",88)
	Stop
  Use:
	TNT1 A 0
	Fail
  }
}