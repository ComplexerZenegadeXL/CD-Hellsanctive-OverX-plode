Actor HellstormBFGGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFHellstormBFGPickup"
  Inventory.PickupSound "weapons/pickup15k"
  Tag "$CFHellstormBFG"
  States
  {
  Spawn:
    HFG2 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	HFG2 A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",21,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("HellstormBFG",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteWithResult("Give Weapon",1) //A_GiveInventory("HellstormBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",87)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",100)
	Stop
  }
}

Actor HellstormBFGSpawnerGiver : HellstormBFGGiver
{
  States
  {
  Pickup:
	
  All:
	TNT1 A 0 ACS_NamedExecuteWithResult("Give Weapon",1) //A_GiveInventory("HellstormBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",87)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("HellstormBFGGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("HellstormBFGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",100)
	Stop
  }
}

Actor HellstormBFGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor HellstormBFG : Weapon
{
  Scale 0.85
  Height 20
  Weapon.PreferredSkin "BFG10K-Marine"
  Weapon.SelectionOrder 2880
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoUse 20
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 5.0
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.AmmoUse2 40
  //Weapon.MinSelectionAmmo1 20
  //Weapon.MinSelectionAmmo2 40
  Weapon.SelectionOrder 7000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Inventory.PickupMessage "$CFHellstormBFGPickup"
  Inventory.PickupSound "weapons/pickup15k"
  Obituary "$CFHellstormBFGObit"
  Tag "$CFHellstormBFG"
  +WEAPON.NOAUTOFIRE
  +WEAPON.BFG
  +WEAPON.NOAUTOAIM
  var int user_thingtid;
  var int user_playertid;
  States
  {
  Spawn:
    HFG2 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	HFG2 A -1
    Stop
  Held:
    TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",16,0,1)
	TNT1 A -1
	Stop
  Ready:
    TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpgradeReady")
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
    TNT1 A 0 A_PlayWeaponSound("weapons/Hbfg10kidle")
    HG2G AAABBBCCCDDD 1 A_WeaponReady(WRF_NOSECONDARY)
    Loop
  Ready2:
    TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpgradeReady2")
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",20,"Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
    HG2G A 1 A_WeaponReady(WRF_NOSECONDARY)
    Loop
  Deselect:
    TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpgradeDeselect")
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
    TNT1 A 0 A_TakeInventory("MineAction",1)
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	HG2G A 1 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("HellstormBFG",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpgradeSelect")
    TNT1 A 0 A_Playsound("weapons/pickup15k")
    HG2G A 1 A_Raise
    Goto SelectLoop + 2
  UpgradeSelect:
    TNT1 A 0 A_Playsound("weapons/pickup15k")
    TG2G A 1 A_Raise
    Goto UpgradeSelect+1
  UpgradeDeselect:
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
    TNT1 A 0 A_TakeInventory("MineAction",1)
    TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    TG2G A 1 A_Lower
    Goto UpgradeDeselect+3
  UpgradeReady:
    //TNT1 A 0 A_JumpIfNoAmmo("UpgradeReady2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto UpgradeReady2
    TNT1 A 0 A_PlayWeaponSound("weapons/Hbfg10kidle")
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",40,13)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),"UpgradeReadySecondary")
	TG2G AAABBBCCCDDD 1 A_WeaponReady(WRF_NOSECONDARY)
	Loop
  UpgradeReadySecondary:
	TG2G AAABBBCCCDDD 1 A_WeaponReady
    Loop
  UpgradeReady2:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",20,"UpgradeReady")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",25 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),"UpgradeReady")
    TG2G A 1 A_WeaponReady
    Loop
  Fire:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpFire")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_AlertMonsters
    HG2G E 25 A_PlayWeaponSound("weapons/Hcharge10k")
    HG2G F 4
    HG2G GHIJ 1
    Goto Hold
  Hold:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("HSBFGUpgrade",1,"UpHold")
	HG2G J 1 A_GunFlash
    HG2G K 1 
    TNT1 A 0 A_PlaySound("weapons/Hbfg10kfire",6)
    TNT1 A 0 Radius_Quake(12,3,0,1,0)
    HG2G K 1 A_FireCustomMissile ("HSBFG10kShot",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",10)
    HG2G LMNA 1
    TNT1 A 0 A_Refire("Hold")
    HG2G A 35 A_PlaySound("weapons/Hbfg10kcooldown") 
    Goto Ready
  UpFire:
    TNT1 A 0 A_JumpIfInventory("DemonAmmo",25 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TG2G E 25 A_PlayWeaponSound("weapons/Hcharge10k")
    TG2G F 4
    TG2G GHIJ 1
    Goto UpHold
  UpHold:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",25 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_AlertMonsters
	TG2G J 1 A_GunFlash
    TG2G K 1 
    TNT1 A 0 A_PlaySound("weapons/Hbfg10kfire",6)
    TNT1 A 0 Radius_Quake(12,3,0,1,0)
    TG2G K 1 A_FireCustomMissile ("HSBFG10kShotUp",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
    TNT1 A 0 A_TakeInventory("DemonAmmo",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",15)
    TG2G LMNA 1
    TNT1 A 0 A_Refire("UpHold")
    TG2G A 35 A_PlaySound("weapons/Hbfg10kcooldown") 
    Goto UpgradeReady
  AltFire:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",40,2)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",40 - 20 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
    TG2G A 1 A_WeaponReady(WRF_NOFIRE)
    Goto UpgradeReady
	TNT1 A 0 A_AlertMonsters
    TG2G E 25 A_PlayWeaponSound("weapons/Hcharge10k")
    TG2G F 4
    TG2G GHIJ 1
    Goto AltHold
  AltHold:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",40,2)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",40 - 20 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
    TG2G A 1 A_WeaponReady(WRF_NOFIRE)
    Goto UpgradeReady
	TNT1 A 0 A_AlertMonsters
	TG2G J 1 A_GunFlash
    TG2G K 1 
    TNT1 A 0 A_PlaySound("weapons/Hbfg10kfire",6)
    TNT1 A 0 Radius_Quake(12,3,0,1,0)
    TG2G K 1 A_FireCustomMissile ("HSBFG10kShotB",frandom(-9,9),0,0,0,0,frandom(-7,7))
    TNT1 A 0 A_FireCustomMissile ("HSBFG10kShotC",frandom(-19,19),0,0,0,0,frandom(-5,5))
    TNT1 A 0 A_FireCustomMissile ("HSBFG10kShotC",frandom(-11,11),0,0,0,0,frandom(-2,2))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
    TNT1 A 0 A_TakeInventory("DemonAmmo",20,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",20)
    TG2G LMNA 1
    TNT1 A 0 A_Refire("AltHold")
    TG2G A 35 A_PlaySound("weapons/Hbfg10kcooldown") 
    Goto UpgradeReady
  Flash:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
    TNT1 A 2 A_Light1
    Goto LightDone 
  }
}

Actor HSBFG10kShot
{
  Radius 16
  Height 16
  Damage 50
  Speed 35
  Scale 0.65
  RenderStyle Translucent
  Alpha 0.95
  Projectile
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +SKYEXPLODE
  +THRUSPECIES
  +STRIFEDAMAGE
  +BRIGHT
  Renderstyle Add
  Alpha 0.75
  Species "Player"
  SeeSound "Weapons/HS10KFIRE"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
    HFP3 AABB 1 A_SpawnItemEx("HSBFG10KGhost")
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("PlayerDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))        
    Loop
  Death:
    TNT1 AA 0 A_SpawnItemEx("HS10KExPlayer")
    HPE3 A 4 A_Explode(30, 42, 1)
    HPE3 BCDEF 4
    Stop
  }
}

