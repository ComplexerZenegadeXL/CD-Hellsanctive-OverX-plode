Actor LegendaryBFG10KGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "Leg10k/Draw"
  Inventory.PickupMessage "$CFLegendaryBFG10KPickup"
  Tag "$CFLegendaryBFG10K"
  States
  {
  Spawn:
	LB10 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	LB10 A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",56,-1,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryBFG10K",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",90)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonAmmo",100)
	Stop
  }
}

Actor LegendaryBFG10KSpawnerGiver : LegendaryBFG10KGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryBFG10K",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryBFG10K",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",90)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryBFG10KGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryBFG10KGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",100)
	Stop
  }
}

Actor LegendaryBFG10KGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryBFG10K : Weapon
{
  +WEAPON.BFG
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOALERT
  Scale 0.85
  Weapon.PreferredSkin "LegendaryBFG-Marine"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 10.0
  Weapon.AmmoType1 "LDemonAmmo"
  Weapon.AmmoType2 "LDemonAmmo"
  Weapon.AmmoUse1 3
  Weapon.AmmoUse2 15
  Weapon.KickBack 90
  Weapon.SlotNumber 7
  Weapon.UpSound "Leg10k/Draw"
  //Weapon.MinSelectionAmmo1 3
  //Weapon.MinSelectionAmmo2 15
  Weapon.SelectionOrder 7000
  Inventory.PickupSound "Leg10k/Draw"
  Inventory.PickupMessage "$CFLegendaryBFG10KPickup"
  Tag "$CFLegendaryBFG10K"
  States
  {
  Spawn:
	LB10 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	LB10 A -1
	Stop
  Select:
	//TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryBFG10K",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	LG10 A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_StopSound(6)
  DeselectLoop:
	TNT1 A 0 A_Lower
	LG10 A 1 A_Lower
	Loop
  Ready:
	TNT1 A 0 A_PlaySound("Weapons/GuruIdle",5,1.0,1)
	LG10 A 1 A_WeaponReady
	Loop
  Leg10kDone:
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",5) 
	LG12 ABCDEFGHIJKL 3
	Goto Ready
  Fire:
    //TNT1 A 0 A_JumpIfInventory("LDemonAmmo",3,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",3 - 1 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/charge15k",1,5)
	TNT1 A 0 Radius_Quake(3,30,0,1,0)
	LG10 BCDEF 6 Bright
  FireLoop:
	//TNT1 A 0 A_JumpIfInventory("LDemonAmmo",3,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",3 - 1 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Leg10kDone
	LG10 GH 1 Bright
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",1)
	TNT1 A 0 A_FireCustomMissile("LegPlayer10KProjectile",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",2)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	LG10 IJ 1 Bright
	//TNT1 A 0 A_JumpIfNoAmmo("Leg10kDone")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",3 - 1 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Leg10KDone
	TNT1 A 0 A_Refire("FireLoop")
	Goto Leg10kDone
  AltFire:
	//TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("EnragedDTech/Charge",1,5)
	TNT1 A 0 Radius_Quake(3,30,0,1,0)
	LG10 BCDEF 8 Bright
  AltFireLoop:
	//TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Leg10kDone
	LG10 KL 2 Bright
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire",1)
	TNT1 A 0 A_FireCustomMissile("PlayerBlueLeg10kBall",0,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10)
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	LG10 MN 3 Bright
	//TNT1 A 0 A_JumpIfNoAmmo("Leg10kDone")
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",15 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Leg10KDone
	TNT1 A 0 A_Refire("AltFireLoop")
	Goto Leg10kDone
  Flash:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
	TNT1 A 2 A_Light1
    Goto LightDone
  }
}

Actor LegPlayer10KProjectile : 10KProjectile
{
  +NOTIMEFREEZE
  Decal BFG9500LightningGold
  States
  {
  Spawn:
	LRAC A 1 Bright
	Loop
  Death:
  XDeath:  
	TNT1 A 0
	TNT1 A 1 A_SpawnItem("LegPlayer10KEx")
	Stop
  }
}

Actor LegPlayer10KEx : Player10KEx
{
  //Damage 150
  +NOTIMEFREEZE
  DamageType "PlayerLegendary"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveGold", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("LegendaryGoldParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("KaboomGold2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, random(0,360))
	LFE3 A 4 Bright A_Explode(Random(350,400),150,0)
	LFE3 BCDEF 4 Bright
    Stop
  }
}

Actor PlayerBlueLeg10kBall
{
  Speed 25
  FastSpeed 25
  Scale 0.4
  Height 15
  Radius 10
  Damage 60
  Decal "BFG9500LightningBlue"
  Projectile
  SeeSound "imp/attack"
  Renderstyle Add
  DamageType "PlayerLegendary"
  +FORCERADIUSDMG
  +FRIENDLY
  +THRUSPECIES
  +RANDOMIZE
  +NOTIMEFREEZE
  Species "Player"
  Obituary "$CFPlayerBlueLeg10kBallObit"
  DeathSound ""
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("LesserCardinal/BFGIdle","Voice",1)
    LG1B A 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("PlayerLegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    LG1B B 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("PlayerLegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    LG1B C 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("PlayerLegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    LG1B D 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("PlayerLegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Loop  
  Death:
    TNT1 A 0
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_Explode(60,250)
	LG1B A 6 Bright A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(60,250)
	LG1B B 6 Bright A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(60,250)
	LG1B C 6 Bright A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(60,250)
	LG1B D 6 Bright A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(300,300)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/bfg95explode")
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("KaboomBlue2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetScale(1.0)
    QRE3 ABCDEF 4 Bright
    Stop
  }
}

Actor PlayerLegBallAttack
{
  Projectile
  Height 3
  Radius 3
  Speed 25
  FastSpeed 25
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +NOTIMEFREEZE
  +FRIENDLY
  DamageType "PlayerLegendary"
  Obituary "$CFPlayerLegBallAttackObit"
  States
  {
  Spawn:
	TNT1 A 0
	//TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 AAAAA 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	//TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_MASTER, AAPTR_NULL)
	TNT1 A 1 A_CustomRailgun(random(5,8)*4,0,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,1,12,"PLegendaryImpPuff",0,0,1500,0,10,0,"Leg10kRailParticle")
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor PLegendaryImpPuff : ModdedBulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  +DONTHARMSPECIES
  Species "Player"
  DamageType "PlayerLegendary"
}

Actor Leg10kRailParticle : BFG9500Trail
{
  Scale 0.05
  Alpha 0.95
  +NOTIMEFREEZE
  States
  {
  Spawn:
	SPKB A 2 Bright
	Stop
  }
}