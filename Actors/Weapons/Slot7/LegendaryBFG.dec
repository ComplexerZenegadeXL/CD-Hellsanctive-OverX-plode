	YBAL A 1 Bright A_SpawnItemEx("LegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrail",-3,0,0,0,0,0,0,0,0)
	TNT1 A 0 A_CustomMissile("LegHumanDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("LegHumanLiteShot",0,0,frandom(0,360))
	YBAL A 1 Bright A_SpawnItemEx("LegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrail",-3,0,0,0,0,0,0,0,0)
	TNT1 A 0 A_CustomMissile("LegHumanDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("LegHumanLiteShot",0,0,frandom(0,360))
	YBAL A 1 Bright A_SpawnItemEx("LegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrail",-3,0,0,0,0,0,0,0,0)
	TNT1 A 0 A_CustomMissile("LegHumanDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("LegHumanLiteShot",0,0,frandom(0,360))
	YBAL A 1 Bright A_SpawnItemEx("LegPlayerBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_Explode(600,64,0,1)
	Loop
  Death:
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_Explode(6000,486,0,1)
	TNT1 A 0 A_BFGSpray("CFGuruSpray",15,20)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("PlayerGuruSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),0,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("CFGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("CFGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	Stop
  }
}

//TRAIL

Actor CFGuruTrail : CFGuruEffectInheritance
{
  Alpha 0.65
  Renderstyle Add
  +CLIENTSIDEONLY
  Scale 0.25
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	YBAL A 1 Bright A_FadeOut(0.1)
	Loop
  }
}

Actor CFGuruTrailSpark : CFGuruEffectInheritance
{
  Scale 0.5
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    YELE ABCDEF 1 Bright A_FadeOut(0.1)
	Stop
  }
}

//IMPACT

Actor CFGuruStruckGlowY : CFGuruEffectInheritance
{
  Alpha 0.5
  +CLIENTSIDEONLY
  Scale 0.2
   States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	YBUM A 0 A_SetScale(ScaleX +0.025, ScaleY +0.1)
	YBUM A 1 Bright A_FadeOut(0.01)
	Loop
  }
}

Actor CFGuruStruckGlowX : CFGuruEffectInheritance
{
  Alpha 0.5
  +CLIENTSIDEONLY
  Scale 0.2
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	YBUM A 0 A_SetScale(ScaleX +0.1, ScaleY +0.025)
	YBUM A 1 Bright A_FadeOut(0.01)
	Loop
  }
}

//SPRAY

Actor CFGuruSpray : CFGuruSpawnerInheritance
{
  DamageType "LegendaryGuruPlayer"
  States
  {
  Spawn:
	TNT1 A 0
