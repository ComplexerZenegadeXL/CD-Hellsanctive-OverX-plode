Actor LegendaryBFGGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "Weapons/GuruUp"
  Inventory.PickupMessage "$CFLegendaryBFGPickup"
  Tag "$CFLegendaryBFG"
  States
  {
  Spawn:
	GRMH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	GRMH A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",55,-1,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryBFG",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",89)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonAmmo",100)
	Stop
  }
}

Actor LegendaryBFGSpawnerGiver : LegendaryBFGGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryBFG",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryBFG",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",89)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryBFGGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryBFGGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",100)
	Stop
  }
}

Actor LegendaryBFGGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryBFG : Weapon
{
  //$Category Weapons/LCA
  //$Sprite GRMHA
  //$Title "LegendaryBFG"
  Weapon.PreferredSkin "LegendaryBFG-Marine"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 7
  Weapon.SlotPriority 11.0
  Weapon.AmmoType "LDemonAmmo"
  Weapon.AmmoUse 100
  Weapon.AmmoUse2 20
  Weapon.AmmoType2 "LDemonAmmo"
  Weapon.KickBack 90
  Weapon.UpSound "Weapons/GuruUp"
  //Weapon.MinSelectionAmmo1 100
  //Weapon.MinSelectionAmmo2 20
  Weapon.SelectionOrder 7000
  Inventory.PickupSound "Weapons/GuruUp"
  Inventory.PickupMessage "$CFLegendaryBFGPickup"
  Obituary "$CFLegendaryBFGObit"
  Tag "$CFLegendaryBFG"
  +NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.NOALERT
  States
  {
  Spawn:
	GRMH A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,1)
	GRMH A -1
	Stop
  Held:
	TNT1 A 0 ACS_NamedExecuteWithResult("ttkSecret",1,0,0)
	TNT1 A -1
	Stop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryBFG",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade", 1, "TrueSelect")
    TNT1 A 0 A_PlayWeaponSound("Weapons/GuruUp")
  SelectLoop2:
  	GRMU A 0 A_Raise
  	GRMU A 1 A_Raise
  	Loop
  TrueSelect:
    TNT1 A 0 A_PlayWeaponSound("truelegbfg/equip")
  	TBFU A 0 A_Raise
  	TBFU A 1 A_Raise
  	Goto Trueselect+1
  Deselect:
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade", 1, "TrueDeselect")
  	GRMU A 0 A_StopSound(5)
    GRMU A 0 A_StopSound(6)
	GRMU A 0 A_ZoomFactor(1)
  DeselectLoop:
  	GRMU A 0 A_Lower
  	GRMU A 1 A_Lower
  	Loop
  TrueDeselect:
    TBFU A 0 A_StopSound(5)
    TBFU A 0 A_StopSound(6)
	TBFU A 0 A_ZoomFactor(1)
  TrueDeselectLoop:
  	TBFU A 0 A_Lower
  	TBFU A 1 A_Lower
  	Loop
  Ready:
    TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade", 1, "TrueReady")
  	GRMG A 0 A_PlaySound("Weapons/GuruIdle",5,1.0,1)
  	GRMG ABCDEFGHIJIHGFEDCB 1 A_WeaponReady
  	Loop
  TrueReady:
    TBFG A 0 A_PlaySound("truelegbfg/idle",5,1.0,1)
  	TBFG ABCDEFGHIJIHGFEDCB 1 A_WeaponReady
	Loop
  Fire:
    //TNT1 A 0 A_JumpIfInventory("LDemonAmmo",100,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",100 - 50 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade", 1, "TrueFire")
  	GRMG A 0 A_PlaySound("Weapons/GuruTrigger",1)
  	GRMG ABCDEFGHIJ 1
  	GRMG A 0 A_PlaySound("Weapons/GuruCharge",6)
  	GRMG IHGFED 1
	GRMG A 0 A_GiveInventory("CFGuruCharge",5)
  Gurucharger:
	GRMG A 0 A_TakeInventory("CFGuruCharge",1)
	GRMC ABCDEFGHIJKLMNOPQRST 1 Bright A_Quake (4, 2, 0, 2,"none")
    GRMG A 0 A_JumpIfInventory("CFGuruCharge",1,"Gurucharger")
	GRMC ABC 1 Bright A_Quake (4, 2, 0, 2,"none")
    GRMG A 0 A_StopSound(5)
    GRMG A 0 A_PlaySound("Weapons/GuruFire",5)
  	GRMG A 0 A_PlaySound("Weapons/GuruAddFire",6)
  	GRMG A 0 A_FireCustomMissile("PlayerGuruBall",0,0,12,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",50)
  	GRMG A 0 A_Recoil(65)
	GRMG A 0 A_GunFlash
	GRMG A 0 A_SetBlend("Yellow",0.5,60)
	GRMG A 0 A_SetBlend("White",0.25,60)
	GRMF A 0 A_ZoomFactor(0.975)
	GRMF A 4 Bright //Offset(2,34)
	GRMF A 0 A_ZoomFactor(0.95)
	GRMF B 4 Bright //Offset(4,36)
	GRMF C 4 Bright A_ZoomFactor(0.955)
	GRMF D 4 Bright A_ZoomFactor(0.96)
	GRMF E 5 Bright A_ZoomFactor(0.965)
	GRMF F 5 Bright A_ZoomFactor(0.97)
	GRMF G 5 Bright A_ZoomFactor(0.975)
	GRMF H 6 Bright A_ZoomFactor(0.98)
	GRMF I 6 Bright A_ZoomFactor(0.99)
	GRMF J 6 Bright A_ZoomFactor(1)
	Goto Ready
  Altfire:
    //TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20,1)
	TNT1 A 0 A_JumpIfInventory("LDemonAmmo",20 - 10 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryBFGUpgrade", 1, "TrueAltFire")
  	GRMG A 0 A_PlaySound("Weapons/GuruAddFire",6)
  	GRMG A 0 A_FireCustomMissile("PlayerLaserBeam",0,0,12,0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10)
  	GRMG A 0 A_Recoil(25)
	GRMG A 0 A_GunFlash
	GRMG A 0 A_SetBlend("Yellow",0.25,35)
	GRMG A 0 A_SetBlend("White",0.125,35)
	GRMF A 0 A_ZoomFactor(0.975)
	GRMF A 4 Bright //Offset(2,34)
	GRMF A 0 A_ZoomFactor(0.95)
	GRMF B 4 Bright //Offset(4,36)
	GRMF C 4 Bright A_ZoomFactor(0.955)
	GRMF D 4 Bright A_ZoomFactor(0.96)
	GRMF E 5 Bright A_ZoomFactor(0.965)
	GRMF F 5 Bright A_ZoomFactor(0.97)
	GRMF G 5 Bright A_ZoomFactor(0.975)
	GRMF H 6 Bright A_ZoomFactor(0.98)
	GRMF I 6 Bright A_ZoomFactor(0.99)
	GRMF J 6 Bright A_ZoomFactor(1)
	Goto Ready
  TrueFire:
    TBFG A 0 A_PlaySound("truelegbfg/trigger",1)
  	TBFG ABCDEFGHIJ 1
  	TBFG A 0 A_PlaySound("truelegbfg/charge",6)
  	TBFG IHGFED 1
	TBFG A 0 A_GiveInventory("CFGuruCharge",5)
  TrueGurucharger:
	TBFG A 0 A_TakeInventory("CFGuruCharge",1)
	TBFC ABCDEFGHIJKLMNOPQRST 1 Bright A_Quake (4, 2, 0, 2,"none")
    TBFG A 0 A_JumpIfInventory("CFGuruCharge",1,"TrueGurucharger")
	TBFC ABC 1 Bright A_Quake (4, 2, 0, 2,"none")
    TBFG A 0 A_StopSound(5)
    TBFG A 0 A_PlaySound("truelegbfg/fire",6)
  	TBFG A 0 A_PlaySound("truelegbfg/fire2",7)
  	TBFG A 0 A_FireCustomMissile("PlayerTrueGuruBall", 0, 0, 12, 0)
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",50)
  	TBFG A 0 A_Recoil(45)
	TBFG A 0 A_GunFlash
	TBFG A 0 A_SetBlend("Blue",0.45,75)
	TBFG A 0 A_SetBlend("White",0.225,75)
	TBFF A 0 A_ZoomFactor(0.95)
	TBFF A 4 Bright //Offset(2,34)
	TBFF A 0 A_ZoomFactor(0.9)
	TBFF B 4 Bright //Offset(4,36)
	TBFF C 4 Bright
	TBFF D 4 Bright A_ZoomFactor(0.915)
	TBFF E 5 Bright A_ZoomFactor(0.93)
	TBFF F 5 Bright A_ZoomFactor(0.945)
	TBFF G 5 Bright A_ZoomFactor(0.96)
	TBFF H 6 Bright A_ZoomFactor(0.975)
	TBFF I 6 Bright A_ZoomFactor(0.99)
	TBFF J 6 Bright A_ZoomFactor(1)
	Goto TrueReady
  TrueAltfire:
    TBFG A 50 Bright A_PlaySound("truelegbfg/load", 6)
  TrueAltfireHold:
    TBFG A 0 A_GiveInventory("CFGuruCharge", 7)
  TrueAltfireCharge:
  	TBFG A 0 A_FireCustomMissile("PlayerTrueLaserBeam", 0, 0)
  	TBFG A 0 A_Recoil(0.333)
	TBFG A 0 A_GunFlash
	TBFG A 0 A_SetBlend("Blue",0.15,20)
	TBFG A 0 A_SetBlend("White",0.1,20)
	TBFF A 0 A_ZoomFactor(0.95)
	TBFF A 1 Bright //Offset(2,34)
	TBFF A 0 A_ZoomFactor(0.9)
	TBFF B 1 Bright //Offset(4,36)
	TBFF A 0 A_TakeInventory("CFGuruCharge", 1)
	TBFF A 0 A_JumpIfInventory("CFGuruCharge", 1, "TrueAltfireCharge")
	TNT1 A 0 A_JumpIfInventory("TalismanofConservationEquipped",1,2)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("LDemonAmmo",10)
	TBFF A 0 A_Refire("TrueAltFireHold")
	TBFF C 4 Bright
	TBFF D 4 Bright A_ZoomFactor(0.915)
	TBFF E 5 Bright A_ZoomFactor(0.93)
	TBFF F 5 Bright A_ZoomFactor(0.945)
	TBFF G 5 Bright A_ZoomFactor(0.96)
	TBFF H 6 Bright A_ZoomFactor(0.975)
	TBFF I 6 Bright A_ZoomFactor(0.99)
	TBFF J 6 Bright A_ZoomFactor(1)
	Goto TrueReady
  Flash:
    TNT1 A 7 A_Light2
    TNT1 A 4 A_Light1
    TNT1 A 0 A_Light0
    Stop
  }
}


