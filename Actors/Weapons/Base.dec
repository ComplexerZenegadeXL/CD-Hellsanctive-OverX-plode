Actor BlueKaboom7 : Kaboom7
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BXPO AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}


Actor LegendaryProjectile : LegendaryRifleShot
{
  Damage (Random(50,100))
  +THRUSPECIES
  DamageType "Legendary"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegendaryADemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 1 A_Explode(30,64,0)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  DeathSFX:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegendaryADemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PlayerLegendaryProjectile : LegendaryProjectile
{
  Damage (Random(10,40))
  Species "Player"
  DamageType "PlayerLegendary"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegendaryADemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 1 A_Explode(30,64)
	TNT1 A 1 A_Explode(Random(120,145),64,0)
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 0, "Vanilla")
	Stop
  }
}

Actor ADemonTechEx
{
  RenderStyle Add
  Alpha 0.75
  Scale 0.45
  Projectile
  +NOCLIP
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    BRPG ABCDEFGH 2 Bright A_FadeOut(0.1)
    Stop
  Vanilla:
    BRPG ABCDEFGH 2 Bright
    Stop
  }
}

Actor LegendaryADemonTechEx : ADemonTechEx { +NOTIMEFREEZE }

Actor LDemonTechTrail : BFG9500Trail
{
  Scale 0.1
  Alpha 0.75
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
    BTRI AAAAAABBBBBBBB 1 Bright A_FadeOut(0.05)
	BTRI BBBBB 1 Bright A_FadeOut(0.025)
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LDemonTechTrail2 : DemonTechTrail
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
    BTRI AAAAAACCCCCCCC 1 Bright A_FadeOut(0.05)
    BTRI CCCCC 1 Bright A_FadeOut(0.025)
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}
