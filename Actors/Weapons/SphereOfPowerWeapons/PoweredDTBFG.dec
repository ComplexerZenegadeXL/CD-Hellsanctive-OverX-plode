Actor PoweredDemonTechBFG10k : DemonTechBFG10K
{
  Weapon.SisterWeapon "DemonTechBFG10K"
  Tag "Powered Demon Tech BFG10K"
  +WEAPON.POWERED_UP
  //+INVENTORY.UNDROPPABLE
  Weapon.AmmoUse 150
  States
  {
  Select:
	TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kpickup")
	//TNT1 A 0 A_JumpIfNoAmmo("Select2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Select2
  SelectLoop:
    SBFI A 1 A_Raise
    Loop
  Select2:   
    SBFE A 1 A_Raise
    Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	//TNT1 A 0 A_JumpIfNoAmmo("Deselect2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Deselect2
  DeselectLoop:
	SBFI A 1 A_Lower
    Loop
  Deselect2:
	SBFE A 1 A_Lower
    Loop
  Ready:
    //TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kidle")
    SBFI AAAABBBBCCCCBBBB 1 A_WeaponReady
    Loop
  Ready2:
    //TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,"Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	SBFE A 1 A_WeaponReady
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Select2
	TNT1 A 0 A_Light1
    TNT1 A 0 A_PlayWeaponSound("Cardinal/9k")
	SBFG C 2 Bright Radius_Quake(1,2,0,1,0)
    SBFG DE 2 Bright Radius_Quake(2,2,0,1,0)
    SBFG FGH 2 Bright Radius_Quake(4,2,0,1,0)
	SBFG IJK 1 Bright Radius_Quake(6,3,0,1,0)
	SBFG L 15 Bright Radius_Quake(8,3,0,1,0)
	TNT1 A 0 A_Light2
    TNT1 A 0 A_GunFlash	
	SBFG M 2 Bright Radius_Quake(10,4,0,1,0)
	TNT1 A 0 A_Recoil(10)	
	TNT1 A 0 Radius_Quake(12,6,0,1,0)
	SBFG N 2 Bright A_FireCustomMissile("PoweredDTBFG10KBall",0,0,0,0)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("DemonAmmo",75)
	SBFG OP 1 Bright
	TNT1 A 0 A_Light0
	SBFG QRST 2 Bright
	TNT1 A 0 Radius_Quake(3,10,0,1,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam")
	SBFE AAAAAAAAAAAA 1 A_FireCustomMissile("DTech10KSteam",-58+frandom(-4,4),0,0,0)
	SBFE A 20
	//TNT1 A 0 A_JumpIfInventory("DemonAmmo",150,1)
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",150 - 75 * ACS_NamedExecuteWithResult("ConservationCheck"),"Ready")
	SBFE A 60 A_PlayWeaponSound("weapons/dtech10kcharge")
	SBFE A 10 A_PlayWeaponSound("weapons/plasmacellin")
	Goto Ready
  }
}

Actor PoweredDTBFG10KBall : DTBFG10KBall
{
  Speed 10
  Damage (Random(500,1000))
  Decal "Scorch"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    CRS1 ABCD 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("PoweredDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Loop
  DTBFGSFX:
    //TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 A 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 B 1 Bright  A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("PoweredDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Goto Spawn
  Death:
    TNT1 A 0
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 Bright A_CustomMissile("PoweredDTBFG10KTracer",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRedSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	CRS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(500,256)
	TNT1 A 0 A_Explode(500,128)
	TNT1 A 0 A_Explode(1000,64)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 Bright A_SpawnItem("RedDTBFGEx",0,-10)
    Stop    
  }
}

Actor PoweredDTBFGTracerAttack : DTBFGTracerAttack
{
  Obituary "$CFPoweredDTBFGTracerAttackObit"
  States
  {
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(96,192),0,NONE,"Red",RGF_SILENT|RGF_NOPIERCING,1,12,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor PoweredDTBFG10KTracer : DTBFG10KTracer
{
  DamageType "PDTBFGTracer"
  Damage (Random(200,300))
  States
  {
  Spawn:
    TNT1 A 15
	Stop
  Death:
    TNT1 A 1
    Stop
  XDeath:
	TNT1 A 0
    TNT1 A 1 A_SpawnItem("CustomSpray2")
    Stop
  }
}