Actor PoweredBFG10k : CFBFG10K
{
  Weapon.AmmoUse 8
  Weapon.SisterWeapon "CFBFG10K"
  Tag "Powered BFG10K"
  +WEAPON.POWERED_UP
  +INVENTORY.UNDROPPABLE
  States
  {
  Ready:
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"ReadyBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Ready2")
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready2
	TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
	EG2G AAABBBCCCDDD 1 A_WeaponReady
	Loop
  Ready2:
	TNT1 A 0 A_JumpIfInventory("NewCell",8,"Ready")
	EGE2 A 1 A_WeaponReady
	Loop
  ReadyBFG15K:
    TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    15K2 ABCD 5 A_WeaponReady
	Loop
  Select:
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"SelectBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Select2")
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Select2
	TNT1 A 0 A_PlaySound("weapons/pickup15k")
  SelectLoop:
	EG2G A 1 A_Raise
	Loop
  Select2:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickup15k")
  Select2Loop:
	EGE2 A 1 A_Raise
	Loop
  SelectBFG15K:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickup15k")
    15K2 ABCD 1 A_Raise
    Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"DeselectBFG15K")
	//TNT1 A 0 A_JumpIfNoAmmo("Deselect2")
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Deselect2
  DeselectLoop:
	EG2G A 1 A_Lower
	Loop
  Deselect2:
	EGE2 A 1 A_Lower
	Loop
  DeselectBFG15K:
	15K2 ABCD 1 A_Lower
    Goto Deselect+1	
  Fire:
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"FireBFG15K")
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	EG2G E 25 A_PlayWeaponSound("weapons/charge15k")
	EG2G F 4
	EG2G GHIJ 1
	Goto Hold
  Hold:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("FireCheck") == 1,1)
	//Goto Ready
	TNT1 A 0 A_JumpIfInventory("BFG15KUpgrade",1,"HoldBFG15K")
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	EG2E A 1 Bright A_GunFlash
	EG2G K 1 Bright
	//TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	EG2E B 1 Bright A_FireCustomMissile("EmpoweredBFG15KBall",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",4,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",4)
	EG2G LMNO 1
	TNT1 A 0 A_JumpIfInventory("NewCell",8 - 4 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
	EG2G O 35 A_PlaySound("weapons/bfg15kcooldown",CHAN_6)
	Goto Ready
	TNT1 A 0 A_ReFire("Hold")
	Goto Ready
  FireBFG15K:
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("FireCheck") == 1,1)
	//Goto Ready2
	TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	15K2 A 30 A_PlayWeaponSound("weapons/charge15k")
	Goto HoldBFG15K
  HoldBFG15K: 
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("FireCheck") == 1,1)
	//Goto Ready
	TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),1)
	Goto Ready
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PoweredPlayerBFG15KBall",frandom(-1,1),0,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",5)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TNT1 A 0 A_GunFlash("FlashBFG15K")
	152F ABCDEFGHI 1 Bright
	TNT1 A 0 A_JumpIfInventory("NewCell",10 - 5 * ACS_NamedExecuteWithResult("ConservationCheck"),2)
	15K2 A 8 A_PlaySound("weapons/bfg10kcooldown",CHAN_6)
    Goto Ready
	TNT1 A 0 A_ReFire("Hold")
	Goto Ready
  FlashBFG15K:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
	TNT1 A 2 A_Light1
    TNT1 A 0 A_Light0
	Stop
  }
}

Actor EmpoweredBFG15KBall : BFG15KBall
{
  Speed 50
  Damage (Random(125,150))
  +SEEKERMISSILE
  States
  {
  Spawn:
    EPS1 AB 2 Bright A_SpawnItemEx("PoweredBFGTrailParticle",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),Random(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(3,3,SMF_LOOK)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("PoweredBFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AA 0 A_CustomMissile("KaboomBlue",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))      
    EPE1 A 4 Bright A_Explode(75,150,0)
    EPE1 BCDEF 4 Bright
    Stop
  }
}

Actor PoweredPlayerBFG15KBall : PlayerBFG15KBall
{
  Speed 80
  Damage (Random(125,200))
  States
  {
  Spawn:
    EPS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("PoweredBFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AA 0 A_CustomMissile("KaboomBlue",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))        
    EPE1 A 4 Bright A_Explode(Random(125,175),196,0)
    EPE1 BCDEF 4 Bright
    Stop
  }
}