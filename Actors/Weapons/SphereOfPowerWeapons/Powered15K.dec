Actor PoweredBFG15K : BFG15K
{
  //$Category Weapons/LCA/DJB
  //$Sprite 15KWA0
  //$Title "BFG15K"
  Weapon.AmmoUse 10
  Weapon.AmmoGive 0
  Weapon.SisterWeapon "BFG15K"
  +WEAPON.POWERED_UP
  +INVENTORY.UNDROPPABLE
  Tag "Powered BFG15K"
  States
  {
  Spawn:
	15KW A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",7,0)
	15KW A -1
    Stop
  Ready:
    TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    15K2 ABCD 5 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	15K2 ABCD 1 A_Lower
    Goto Deselect+1		
  Select:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickup15k")
    15K2 ABCD 1 A_Raise
    Loop
  Fire:
    TNT1 A 0 A_PlayWeaponSound("weapons/charge15k")
	152F ABCD 6 
   Goto Hold
  Hold: 
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PoweredPlayerBFG15KBall",frandom(-1,1),1,0,0,0,frandom(-1,1))
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ConservationCheck") == 1,2)
	TNT1 A 0 A_TakeInventory("NewCell",5,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NewCell",5)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TNT1 A 0 A_GunFlash
	152F ACEGI 1 Bright
	TNT1 A 0 A_ReFire
	TNT1 A 0 A_PlaySound("weapons/bfg10kcooldown",CHAN_6)
	152F ABCD 2 
    Goto Ready
  Flash:
    TNT1 A 2 A_Light1
    TNT1 A 2 A_Light2
	TNT1 A 2 A_Light1
    TNT1 A 0 A_Light0
	Stop
  }
}