Actor PoweredRapidShotgun : RapidShotgun
{ 
  Scale 0.6
  Weapon.AmmoGive 0
  +WEAPON.POWERED_UP
  +INVENTORY.UNDROPPABLE
  Weapon.SisterWeapon "RapidShotgun"
  AttackSound "weapons/ExplosiveSG/fire"
  Tag "Powered Rapid Shotgun"
  States 
  { 
  Spawn: 
    RSHV A -1
    Stop     
  Flash: 
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light2 
    TNT1 A 0 A_Light0
    Goto LightDone 
  Ready:  
	TNT1 A 0 A_PlayWeaponSound("weapons/minigunpickup")
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"GrenadeCheck")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MineCheck")
    RSHU A 1 A_WeaponReady 
	Goto Ready+1
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)    
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	RSHU A 1 A_Lower
	Loop
  Select:
	RSHU A 1 A_Raise
	Wait 
  Fire:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastSpin")
    TNT1 A 0 A_JumpIfInventory("RapidShotgunSpin",1,"Hold") 
    TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6)
    RSHU ABCDABCD 4
    TNT1 A 0 A_Refire
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)
    Goto SpinStop    
  FastSpin:
    TNT1 A 0 A_JumpIfInventory("RapidShotgunSpin",1,"Hold") 
    TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6)
    RSHU ABCDABCD 8
    TNT1 A 0 A_Refire
    Goto SpinStop  
  Hold:
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"HoldSpread")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1) 
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHold")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT AB 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT CD 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")  
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT EF 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM) 
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_Refire
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    RSHU ABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 4 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 4    
    RSHU CD 6
    Goto Ready+1
  HoldSpread:
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1) 
    TNT1 A 0 A_AlertMonsters  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHold")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)+15.0,0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)-15.0,0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
    RSHT AB 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)+15.0,0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)-15.0,0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
    RSHT CD 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")  
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)+15.0,0,0,0,0,frandom(-6,6))
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10)-15.0,0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(15+15.0,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_FireBullets(11.8+15.0,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
    RSHT EF 4 Bright A_FireBullets(11.8,7.3,3,Random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM) 
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_Refire
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    RSHU ABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 4 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 4    
    RSHU CD 36
    Goto Ready+1
  JustSpin:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastJustSpin")
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1)  
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
    RSHU DABCDABCDAB 4 A_JumpIfInventory("NewShell",1,"Hold")
    TNT1 A 0 A_Refire("JustSpin")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    RSHU CDABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 4 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 4   
    RSHU CD 6 
    Goto Ready+1
  FastJustSpin: 
    TNT1 A 0 A_GiveInventory("RapidShotgunSpin",1)   
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",6,1.0,1)
    RSHU DABCDABCDAB 8 A_JumpIfInventory("NewShell",1,"FastHold")
    TNT1 A 0 A_Refire("JustSpin")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6) 
    RSHU CDABCDABCDA 8 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 8 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 8   
    RSHU CD 12
    Goto Ready+1
  SpinStop:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    RSHU A 0 A_GiveInventory("RapidShotgunSpin",1)
    RSHU B 0 A_PlaySound("HeavyChaingun/Down",6) 
    RSHU ABCDABCDABCDA 4 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 4 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 4   
    RSHU CD 6
    Goto Ready+1
  FastHoldSpinStop:
    RSHU A 0 A_GiveInventory("RapidShotgunSpin",1) 
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)  
    RSHU ABCDABCDABCDA 8 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 8 A_WeaponReady(WRF_NOSECONDARY) 
    TNT1 A 0 A_TakeInventory("RapidShotgunSpin",2)
    RSHU AB 8
    RSHU CD 12
    Goto Ready+1
  FastHold: 
    TNT1 A 0 A_JumpIfNoAmmo("FastJustSpin")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FastHoldSpread")
	TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,Random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT AB 8 Bright A_FireBullets(11.8,7.3,3,random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-80,-90),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT CD 8 Bright A_FireBullets(11.8,7.3,3,random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM)
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")  
    TNT1 A 0 A_GunFlash    
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 AAAAAAAA 0 A_FireCustomMissile("PlayerExplosiveTracer4",frandom(-10,10),0,0,0,0,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FireBullets(15,12.2,5,random(8,12),"PlayerModdedBulletPuff",FBF_USEAMMO|FBF_NORANDOM)
    RSHT EF 8 Bright A_FireBullets(11.8,7.3,3,random(8,12),"PlayerModdedBulletPuff",FBF_NORANDOM) 
	TNT1 A 0 A_JumpIfNoAmmo("JustSpin")
    TNT1 A 0 A_Refire("Hold")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FastHoldSpinStop")
    TNT1 A 0 A_PlaySound("HeavyChaingun/Down",6)  
    RSHU CDABCDABCDA 2 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU BCD 4 A_WeaponReady(WRF_NOSECONDARY)  
    RSHU AB 4    
    RSHU CD 6 
    Goto Ready+1
