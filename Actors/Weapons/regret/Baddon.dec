Actor 1337Minigun : Weapon
{
  Weapon.Selectionorder 600
  //+WEAPON.NOAUTOAIM
  -INVENTORY.UNDROPPABLE
  +WEAPON.CHEATNOTWEAPON
  Weapon.PreferredSkin "Minigun-Marine"
  Weapon.KickBack 40
  Weapon.AmmoUse 1
  Weapon.AmmoGive 100
  Weapon.AmmoType "BulletMag"
  Inventory.PickupSound "ImprovedMinigun/Up"
  Inventory.PickupMessage "$CF1337MinigunPickup"
  Obituary "%o was shredded by %k's 1337 Minigun."
  Tag "$CF1337Minigun"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckBaddon") == 0,3)
  SpawnLoop:
	BADD Z 10
	BADD Z 10 Bright
	Loop
	TNT1 A 0
	Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("ImprovedMinigun/Up")
	BADD GHIJA 1
  ReadyLoop:
	BADD A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	IMMG A 1 A_Lower //yep this too
	Loop
  Select:
	TNT1 A 0 A_Raise
	Loop
  Fire:
	//TNT1 A 0 A_JumpIfInventory("ExpMinigunActive2",1,"Firing")
	//TNT1 A 0 A_JumpIfInventory("ExpMinigunActive",1,"Firing")
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstart",7)
	BADD BCD 2
	BADD ABCDABCD 1
  Firing:  //Yes all these Brights on empty states is intentional
	TNT1 A 0 Bright A_PlaySound("weapons/expmgunspin",7)
	TNT1 A 0 Bright A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 Bright A_Light1
	TNT1 A 0 Bright Radius_Quake(4,2,0,1,0)
	TNT1 A 0 Bright A_SpawnItemEx("RifleCasing",25,-8,25,Random(2,4),Random(-3,-6),Random(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 Bright A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-4,4),0,0,frandom(-4,4))
	IMMG E 1 Bright A_FireBullets(4.3,2.6,-1,175,"PlayerExosBulletPuff",FBF_NORANDOM)  //this is on pourpose
	TNT1 A 0 Bright A_Recoil(1)
	TNT1 A 0 Bright A_JumpIfNoAmmo("EmptySpinDown")
	BADD ABC 1 A_Light0
	TNT1 A 0 Bright A_PlaySound("hitler/fire",CHAN_WEAPON)
	TNT1 A 0 Bright A_Light1
	TNT1 A 0 Bright Radius_Quake(4,2,0,1,0)
	TNT1 A 0 Bright A_SpawnItemEx("RifleCasing",25,-8,25,Random(2,4),Random(-3,-6),Random(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	//TNT1 A 0 A_FireCustomMissile("ExplosiveBullet",frandom(4,-4),0,0,0,0,frandom(-2,2))
	TNT1 A 0 Bright A_FireCustomMissile("PlayerExplosiveTracer2",frandom(-4,4),0,0,frandom(-4,4))
	IMMG F 1 Bright A_FireBullets(4.3,2.6,-1,175,"PlayerExosBulletPuff",FBF_NORANDOM|FBF_USEAMMO)  //so is this
	TNT1 A 0 Bright A_Recoil(1)
	TNT1 A 0 Bright A_JumpIfNoAmmo("EmptySpinDown")
	BADD ABC 1 A_Light0
	TNT1 A 0 Bright A_ReFire("Firing")
	TNT1 A 0 Bright A_PlaySound("weapons/mgunspinstop")
	TNT1 A 0 Bright A_PlaySound("weapons/expmgunspinstop",7)
	BADD ABCD 1
	BADD ABCD 1
	BADD ABCD 1
	BADD ABCD 2
	Goto ReadyLoop
  EmptySpinDown:
	TNT1 A 0 Bright A_PlaySound("weapons/mgunspinstop")
	TNT1 A 0 Bright A_PlaySound("weapons/expmgunspinstop",7)
	BADD ABCDABCD 1
	IMMG ABCD 1 //and this
	BADD ABCD 2
	Goto ReadyLoop
  }
}