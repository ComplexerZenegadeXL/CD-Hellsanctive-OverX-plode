//==============
// Hand Grenade
//==============

Actor "Hand Grenade" : Weapon 19352
{
  Scale 0.3
  Weapon.PreferredSkin "Fist-Marine"
  Weapon.SelectionOrder 65536
  Weapon.KickBack 100
  Inventory.PickupSound "weapons/hgrenadepickup"
  Weapon.AmmoGive 1
  Weapon.AmmoUse 1
  Weapon.AmmoType "HandGrenadeAmmo"
  Inventory.Pickupmessage "Hand Grenade"
  Obituary "%o was fragged by %k's hand grenade."
  AttackSound ""
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  +WEAPON.NOAUTOFIRE
  +WEAPON.NO_AUTO_SWITCH
  +INVENTORY.UNDROPPABLE
  States 
  { 
  Spawn:
	GRNP A -1
	Stop
  Ready:
	HGRN ABC 1
    Goto Ready2
  Ready2:
    HGRN D 1 A_WeaponReady 
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    HGRN D 1 A_Lower
    TNT1 A 0 A_Lower	  
    Goto Deselect+1	  
  Select:
	TNT1 A 0 A_Raise
    Wait
  Fire: 
	HGRN EFG 1
	HGRN HI 2
	TNT1 A 15 A_PlayWeaponSound("weapons/hgrenadepin")
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("HandGrenadeAmmo",1)
	HGNE A 1 A_FireCustomMissile("ThrownGrenade",0,0,0,0)
	HGRN J 1
	HGRN KLM 2
	HGRN NO 1
	TNT1 A 6
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Hand Grenade",1)
	TNT1 A 0
	TNT1 A 6
	HGRN ABC 1
	Goto Ready2
  }
}

Actor ThrownGrenade
{  
  Radius 2
  Height 2
  Speed 30
  Damage (Random(8,16))
  Scale 0.4
  SeeSound "weapons/hgrenadebounce"
  +MTHRUSPECIES
  +MISSILE
  +DONTFALL
  +CANBOUNCEWATER
  +DOOMBOUNCE
  +NOTELEPORT
  WallBounceFactor 0.16
  BounceFactor 0.36
  Gravity 0.6
  Mass 400
  Decal "Scorch"
  DamageType "Explosion"
  Obituary "%o was fragged by %k's hand grenade."
  States
  {
  Spawn:
	TNT1 A 0
    HGN1 A 3 A_StopSound
    HGN1 BCDEFGHABCDEFGHABCDEFGH 3
    Goto Death      
  Death:
    TNT1 A 0 A_Explode(186,192)
	TNT1 A 0 A_Explode(64,64)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/hgrenadeex")
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

//======
// Mine
//======

Actor "Land Mine" : Weapon 19784
{
  Scale 0.85
  Weapon.PreferredSkin "Fist-Marine"
  Weapon.SelectionOrder 65536
  Inventory.PickupSound "weapons/minepickup"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 1
  Weapon.AmmoType "MineAmmo"
  Inventory.PickupMessage "Land Mine"
  Obituary "%o stepped on %k's land mine."
  AttackSound ""
  +WEAPON.NOALERT
  +WEAPON.NOAUTOAIM
  +WEAPON.NOAUTOFIRE
  +WEAPON.NO_AUTO_SWITCH
  +INVENTORY.UNDROPPABLE
  States 
  { 
  Spawn:
	LMIN A -1
	Stop
  Ready:
	MINE ACE 1
    Goto Ready2
  Ready2:
    HLMI A 1 A_WeaponReady 
	Loop
  Deselect:
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
    HLMI A 1 A_Lower
    TNT1 A 0 A_Lower	  
    Goto Deselect+1	  
  Select:
	TNT1 A 0 A_Raise
    Wait
  Fire: 
	MINE EDCB 1
	TNT1 A 8
	MINE ABCDEF 1
	TNT1 A 0 A_PlayWeaponSound("weapons/hgrenadethrow")
	TNT1 A 0 A_TakeInventory("MineAmmo",1)	  
	MINE G 1 A_FireCustomMissile("ThrownMine",0,0,0,0)
	MINE HI 1
	MINE JK 2
	TNT1 A 0 A_JumpIfInventory("MineAmmo",1,2)
    TNT1 A 0 A_TakeInventory("Land Mine",1)
	TNT1 A 0
	TNT1 A 6
	MINE BCDE 1	  
	Goto Ready2
  }
}

Actor ThrownMine
{
  Height 9 //10
  Radius 14
  Mass 2147483647 //0x7FFFFFFF
  Speed 15
  Scale 0.85
  BounceCount 3
  BounceFactor 0.18
  WallBounceFactor 0.22
  Reactiontime 14
  Damage 1
  +MISSILE
  +DROPOFF
  +NOBLOCKMAP
  +NOTELEPORT
  //+HEXENBOUNCE
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +ALLOWBOUNCEONACTORS
  +MBFBOUNCER
  +BOUNCEONACTORS
  +CANBOUNCEWATER
  +MOVEWITHSECTOR
  +BLOODLESSIMPACT
  //+THRUSPECIES
  DamageType "Mine"
  //BounceSound "weapons/minebounce"
  //DeathSound "weapons/minebounce"
  SeeSound "weapons/minebounce"
  Species "Player"
  States
  {
  /*Spawn:
	TNT1 A 0
	TNT1 A 0 A_StopSound
    Goto Thrown*/
  Spawn:
	LMIN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_CheckFloor("Death")
	LMIN BBBBBBBBBB 1 Bright A_CheckFloor("Death")
	TNT1 A 0 A_CountDown
	Loop
  Thrown:
	LMIN A 30
	LMIN B 10 Bright
	Loop
  /*Death:
	LMIN A 1
	LMIN A 1 A_SpawnItemEx("LiveMine",0,0,0,0,0,0,0)
	Stop*/
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Scream
	TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
	LMIN A 1 A_CustomMissile("LiveMine",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 5 A_AlertMonsters(128)
	Stop
  }
}

Actor LiveMine
{
  Scale 0.85
  Radius 10
  Height 8
  Damage 1
  Health 1
  Mass 0x7FFFFFFD
  Species "Player"
  DamageType "Explosion"
  +MISSILE
  +THRUSPECIES
  +FORCERADIUSDMG
  +MOVEWITHSECTOR
  +NOBLOOD
  +SHOOTABLE
  +THRUACTORS
  +FRIENDLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
  SpawnLoop:
	LMIN A 30
	LMIN B 10 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND|LOF_NOJUMP,0,128,0,360,"Death")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTarget") == 1,"Death")
	TNT1 A 0 A_ClearTarget
	Loop
  Death:
	TNT1 A 0 A_Die
  Explode:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	LMIN B 15 Bright A_PlaySound("weapons/minebeep")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Explode(186,384)
	TNT1 A 0 A_Explode(64,128)
	TNT1 A 0 A_PlaySound("weapons/mineexplode")
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}