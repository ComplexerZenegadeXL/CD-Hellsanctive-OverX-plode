Actor CFUnmakerPuff
{
 Renderstyle "Normal"
 Scale 1.0
 +NOBLOCKMAP
 +NOGRAVITY
 +FORCEXYBILLBOARD
 +NOINTERACTION
 +PUFFGETSOWNER
 +PUFFONACTORS
 +HITTRACER
 +ALWAYSPUFF
 +THRUSPECIES
 +MTHRUSPECIES
 Species "Player"
 DamageType "ToBeDefined"
 var int user_loop;
 States
 {
  Spawn:
	TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("CFUnmakerLaserPrint")
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerPuff")
	LPUF AB 3 Bright
  SpawnLoop1:
	TNT1 A 0 A_JumpIf(user_loop <= 0,"SpawnLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop - 1)
	LPUF AB 3 Bright
	Loop
  SpawnLoop2:
 	LPUF AB 3 Bright A_FadeOut(0.10)
 	Loop
 }
}


Actor CFUnmakerLaserSpark
{ 
 RenderStyle Add
 Scale 0.015
 Alpha 1.0 
 +NOINTERACTION
 +NOBLOCKMAP
 +NOGRAVITY
 +THRUSPECIES
 +MTHRUSPECIES
  States
  {
   Spawn:
	YAE5 A 2 Bright
   Spawn2:
	//YAE5 A 1 A_SetScale(ScaleX-0.00075)
	YAE5 A 3 A_ChangeVelocity (frandom(-0.03, 0.03), frandom(-0.03, 0.03), frandom(-0.03, 0.03), 0)
	YAE5 A 1 A_FadeOut(0.15)
	Loop
  }
}
