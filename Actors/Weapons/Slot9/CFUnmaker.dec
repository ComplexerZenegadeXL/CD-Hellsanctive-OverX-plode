Actor CFUnmakerGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "NemesisGet"
  Tag "$CFUnmaker"
  States
  {
  Spawn:
	UMNK A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
  SpawnLoop:
	UMNK A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",63,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFUnmaker",1,"Null")
	TNT1 A 0 A_GiveInventory("CFUnmaker",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",100)
  JustAmmo:
    TNT1 A 0 A_GiveInventory("DemonAmmo",40)
    Stop
  }
}

Actor CFUnmakerSpawnerGiver : CFUnmakerGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFUnmaker",1,"Null")
  All:
	TNT1 A 0 A_GiveInventory("CFUnmaker",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",100)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("CFUnmakerGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("CFUnmakerGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor CFUnmakerGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor "CFUnmaker" : Weapon
{
  Radius 20
  Height 20
  Weapon.AmmoGive 0
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.SlotNumber 9
  Weapon.SlotPriority 1.1
  Inventory.PickupSound "NemesisGet"
  Weapon.PreferredSkin "Unmaker-Marine"
  Weapon.Kickback 120
  Weapon.ReadySound "UnmakerReadyX"
  Weapon.UpSound "NemesisUp"
  Inventory.PickupMessage "$CFUnmakerObit"
  Tag "Unmaker"
  Obituary "$CFUnmakerPickup"
  +WEAPON.NOAUTOAIM
  +DONTGIB
  States
  {
  Spawn:
	UMNK A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
  SpawnLoop:
	UMNK A -1
	Loop
  Ready:
	UNMA ZYXWVU 1
  ReadyLoop:	
	UNMA ABCDEF 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_Lower
	UNMA A 1 A_Lower
	Goto Deselect+2
  Select:
	UNMA A 1 A_Raise
	TNT1 A 0 A_Raise
	Goto Select+1
  Fire:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",1) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldFast")
	TNT1 A 0 A_JumpIfInventory("D64Artifact2",1,"HoldSpread")
	UNMA ABCDEF 1
  Hold:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",1) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldFast")
	TNT1 A 0 A_JumpIfInventory("D64Artifact2",1,"HoldSpread")
	UNMA GGHH 1 
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",0,1)
	UNMA HHHHGG 1 // evil stuff going on here, I 6 wouldn't work the same
	TNT1 A 0 A_Refire
	Goto Afterfire
  HoldFast:
	TNT1 A 0 A_JumpIfInventory("D64Artifact2",1,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",1) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",0,1)
	UNMA HHG 1
	TNT1 A 0 A_Refire("HoldFast")
	Goto Afterfire
  HoldSpread:
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",1,3)
	UNMA HHHHGG 1
	TNT1 A 0 A_Refire("HoldSpread2")
	Goto Afterfire
  HoldSpread2:
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",2,3)
	UNMA HHHHGG 1
	TNT1 A 0 A_Refire("HoldSpread3")
	Goto Afterfire
  HoldSpread3:
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",3,3)
	UNMA HHHHGG 1
	TNT1 A 0 A_Refire("HoldSpread4")
	Goto Afterfire
  HoldSpread4:
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",4,3)
	UNMA HHHHGG 1
	TNT1 A 0 A_Refire("HoldSpread")
	Goto Afterfire
  HoldBoth:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",1,3)
	UNMA HHG 1
	TNT1 A 0 A_Refire("HoldBoth2")
	Goto Afterfire
  HoldBoth2:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",2,3)
	UNMA HHG 1
	TNT1 A 0 A_Refire("HoldBoth3")
	Goto Afterfire
  HoldBoth3:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",3,3)
	UNMA HHG 1
	TNT1 A 0 A_Refire("HoldBoth4")
	Goto Afterfire
  HoldBoth4:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck",3) == 2,2)
	TNT1 A 0 A_Jump(256,"EndFire")
	UNMA GGHH 1
	TNT1 A 0 A_PlaySound("UnmakerShot",1,1,0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFUnmakerLaser",4,3)
	UNMA HHG 1
	TNT1 A 0 A_Refire("HoldBoth")
	Goto Afterfire
  Afterfire:
	UNMA GG 1 
  EndFire:
	TNT1 A 0 A_StopSound(7)
	UNMP ABCDEFGHIJKLMNONMLKJIHGFDCBA 1
	Goto ReadyLoop
  }
}


