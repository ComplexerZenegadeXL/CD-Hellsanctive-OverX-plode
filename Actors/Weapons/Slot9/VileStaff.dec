Actor VileStaffGiver : CustomInventory
{
  Inventory.Amount 1
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "VileGet" 
  Inventory.PickupMessage "$CFVileStaffPickup"
  Tag "$CFVileStaff"
  States
  {
  Spawn:
	REVJ A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",9,0)
	REVJ A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",23,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_GiveInventory("VileStaff",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	Stop
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	Stop
  }
}

Actor VileStaffSpawnerGiver : VileStaffGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("VileStaff",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("VileStaff",1)
	TNT1 A 0 A_JumpIfInventory("VileStaffGiverCheck",1,3)
	TNT1 A 0 A_GiveInventory("VileStaffGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	TNT1 A 0
	Stop
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("VileStaffGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("VileStaffGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",150)
	Stop
  }
}

Actor VileStaffGiverCheck : Inventory { Inventory.Amount 1 Inventory.MaxAmount 1 Inventory.InterHubAmount 0 }

Actor VileStaff : Weapon 30324
{
  +WEAPON.NOALERT
  -WEAPON.NOAUTOAIM
  Weapon.SelectionOrder 9000
  Weapon.PreferredSkin "Fist-Marine"
  Weapon.AmmoUse 0
  Weapon.AmmoUse2 0
  Weapon.AmmoGive 0
  Weapon.SlotNumber 9
  Weapon.SlotPriority 1.0
  Weapon.AmmoType "DemonAmmo"
  Weapon.AmmoType2 "DemonAmmo"
  Weapon.UpSound "VileGet"
  //Weapon.MinSelectionAmmo1 10
  Weapon.SelectionOrder 7000
  Inventory.PickupSound "VileGet" 
  Inventory.PickupMessage "$CFVileStaffPickup"
  Tag "$CFVileStaff"
  States
  {
  Spawn:
	REVJ A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",9,0)
	REVJ A -1 Bright
	Stop
  Ready:
	REVI A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
	TNT1 A 0 A_JumpIfInventory("HandGrenadeAction",1,"MonsterSummon")
	TNT1 A 0 A_JumpIfInventory("MineAction",1,"MinionCalling")
	Goto Ready
  Select:
	REVI A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	REVI A 1 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	REVI A 1 A_Lower
	Loop
  MinionCalling:  //Call minions Landmine animation to be done better
	REVI A 1 A_TakeInventory("MineAction",1)
	REVI BCD 1
	REVI E 1 A_PlaySound("VileStaff1")
	REVI E 2 ACS_NamedExecuteAlways("CF_MinionCall",0)
	REVI D 1 //A_TakeInventory("DemonAmmo",10) unsure if to make it completely free
	REVI CB 1
	REVI A 5
	Goto Ready
  Fire: //Deal damage
	//TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",10,1)
	Goto Ready
	REVI ABCD 1
	REVI E 1 A_Playsound("VileStaff1")
	REVI E 2 A_FireCustomMissile("VileStaffFlameAttack",0,0,0,12)
	REVI D 1 A_TakeInventory("DemonAmmo",10)
	REVI CB 1
	REVI A 38
	//TNT1 A 0 A_Refire
	Goto Ready
  AltFire: //Dominate monster
	//TNT1 A 0
	//TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",5,1)
	Goto Ready
	REVI ABCD 1
	REVI E 1 A_Playsound("VileStaff1")
	REVI E 2 A_FireCustomMissile("VileFakeFriendly",0,0,0,12)
	REVI D 1 A_TakeInventory("DemonAmmo",5)
	REVI CB 1
	REVI A 38
	Goto Ready
  Reload: //Resurrect monster
	//TNT1 A 0
	//TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_JumpIfInventory("DemonAmmo",45,1)
	Goto Ready
	REVI ABCD 1
	REVI E 1 A_PlaySound("VileStaff1")
	REVI E 2 A_FireCustomMissile("VileFakeFriendlyResurrection",0,0,0,0)
	REVI F 3 A_TakeInventory("DemonAmmo",45)
	REVI G 4
	REVI F 3
	REVI E 2
	REVI DCB 1
	REVI A 38
	Goto Ready
  Zoom: //Seal monster
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("VileStaffAmmo",100,50) == 2,1)
	Goto Ready
	REVI A 1 Offset(10,32)
	REVI A 1 Offset(30,32)
	REVI A 1 Offset(50,32)
	REVI A 1 Offset(70,32)
	REVI A 1 Offset(95,32)
	REVI A 1 Offset(120,32)
	REVI A 1 Offset(150,32)
	REVI A 1 Offset(180,32)
	TNT1 A 1  
	NECR A 2 Offset(1,52)
	NECR A 2 Offset(4,47)
	NECR A 2 Offset(7,42)
	NECR A 2 Offset(9,37)
	NECR A 2 Offset(10,32)
	NECR ABC 7
	NECR D 2
  Zoom2:
	NECR E 0 A_JumpIfInventory("SealCoolDown",1,2)
	NECR E 0 ACS_NamedExecuteWithResult("VileAttack") //ACS_NamedExecuteAlways("ttkVileMagic",0)
	NECR E 35
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CFButtonCheck",128) == 2,"Zoom2")
	TNT1 A 0
	Goto Zoom3
  Zoom3:
	NECR DCBA 4
	NECR A 2 Offset(0,32)
	NECR A 2 Offset(0,37)
	NECR A 2 Offset(0,42)
	NECR A 2 Offset(0,47)
	NECR A 2 Offset(0,52)
	TNT1 A 1
	REVI A 1 Offset(180,32)
	REVI A 1 Offset(150,32)
	REVI A 1 Offset(120,32)
	REVI A 1 Offset(95,32)
	REVI A 1 Offset(70,32)
	REVI A 1 Offset(50,32)
	REVI A 1 Offset(30,32)
	REVI A 1 Offset(10,32)
	Goto Ready
  MonsterSummon: //Summon monster Hand Grenade
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("VileStaffAmmo",50,100) == 2,1)
	Goto Ready
	REVI A 1 Offset(10,32)
	REVI A 1 Offset(30,32)
	REVI A 1 Offset(50,32)
	REVI A 1 Offset(70,32)
	REVI A 1 Offset(95,32)
	REVI A 1 Offset(120,32)
	REVI A 1 Offset(150,32)
	REVI A 1 Offset(180,32)
	TNT1 A 1  
	NECR A 2 Offset(1,52)
	NECR A 2 Offset(4,47)
	NECR A 2 Offset(7,42)
	NECR A 2 Offset(9,37)
	NECR A 2 Offset(10,32)
	NECR ABC 7
	NECR D 2
  MonsterSummon2:
	NECR E 1 ACS_NamedExecuteWithResult("ttkStaffSummon")
  MonsterSummon3:
	NECR E 1 A_JumpIfInventory("VileStaffEsc",1,"MonsterSummonEnd")
	NECR E 1 A_JumpIf(ACS_NamedExecuteWithResult("CFButtonCheck",4,8,8192) == 2,"MonsterSummonEnd")
	Loop
  MonsterSummonEnd:
	TNT1 A 0 A_TakeInventory("StaffSummoning",1)
	NECR E 4 A_TakeInventory("VileStaffEsc",1)
	NECR EDCBA 4
	NECR A 2 Offset(0,32)
	NECR A 2 Offset(0,37)
	NECR A 2 Offset(0,42)
	NECR A 2 Offset(0,47)
	NECR A 2 Offset(0,52)
	TNT1 A 1
	REVI A 1 Offset(180,32)
	REVI A 1 Offset(150,32)
	REVI A 1 Offset(120,32)
	REVI A 1 Offset(95,32)
	REVI A 1 Offset(70,32)
	REVI A 1 Offset(50,32)
	REVI A 1 Offset(30,32)
	REVI A 1 Offset(10,32)
	Goto Ready
  }
}

Actor SealCoolDown : PowerDamage
{
  DamageFactor "NotARealDamageType", 1.0
  Powerup.Duration -5
}

Actor VileStaffEsc: Inventory {}

Actor StaffSummoning: Inventory {}

Actor VileStaffPuff
{
  Height 5
  Radius 5
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +PUFFGETSOWNER
  +MTHRUSPECIES
  +PAINLESS
  +BLOODLESSIMPACT
  +THRUACTORS
  +THRUGHOST
  +NODAMAGETHRUST
  +NOTRIGGER
  +DONTREFLECT
  +DONTSPLASH
  States
  {
  Crash:
	TNT1 A 1 ACS_NamedExecuteWithResult("ttkStaffSummon2")
	Stop
  Spawn:
	TNT1 A 1
	Stop
  }
}

Actor VileStaffTargetPuff
{
  Height 4
  Radius 4
  RenderStyle None
  Decal None
  +NOTIMEFREEZE
  +NODECAL
  +NOGRAVITY
  +NOBLOCKMAP 
  +PAINLESS
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  +NOTRIGGER
  +DONTREFLECT
  +DONTSPLASH
  +FOILINVUL
  +HITTRACER
  +PUFFONACTORS
  +PUFFGETSOWNER
  +NOTONAUTOMAP
  +SERVERSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 5 NoDelay ACS_NamedExecuteWithResult("ttkVileMagic")
	Stop
  }
}

Actor ttkSummonerPHolder
{
 Height 56
 Radius 20
 +NOINTERACTION
 +NOBLOCKMAP
 States
 {
  Spawn:
	TNT1 A -1
	Stop
 }
}

Actor ttkSummoner
{
 Height 5
 Radius 5
 Renderstyle Translucent
 Alpha 0.75
 +NOINTERACTION
 +NOBLOCKMAP
 States
 {
  Spawn:
	TTKS A 1
  SpawnLoop:
	TTKS A 20 A_SetTranslucent(0.85)
	TTKS A 10 A_SetTranslucent(0.50)
	Loop
 }
}

Actor VileFakeFriendly : FastProjectile
{
  Projectile
  Height 8
  Radius 8
  Speed 16
  Renderstyle Add
  MaxTargetRange 16
  ReactionTime 32
  BounceType "Hexen"
  BounceFactor 0.1
  WallBounceFactor 0.1
  +NOTIMEFREEZE
  +SEEKERMISSILE
  +NOEXPLODEFLOOR
  +PAINLESS
  +HITTRACER
  ActiveSound "necghost/active"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	DWRT AAAABBBB 1 Bright A_SeekerMissile(25,35,SMF_LOOK|SMF_PRECISE)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("CF_VileStaff",0,1,ACS_NamedExecuteWithResult("CF_GetPlayerNumber"))
	DWRT ABABABABABAB 4 Bright A_FadeOut(0.1,1)
	Stop
  }
}

