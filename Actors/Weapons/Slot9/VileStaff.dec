	SEMR C 6 Bright A_RadiusGive("VileStaffResurrect63",128,RGF_MONSTERS|RGF_CORPSES,1)
	TNT1 A 0 A_SpawnItemEx("VileFakeFriendlyResurrectionTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_CountDown
	Loop
  Death:
	SEMR ABCABCABC 6 A_FadeOut(0.3,1)
	Stop
  }
}

