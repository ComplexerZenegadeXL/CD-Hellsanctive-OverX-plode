Actor VileStaffFlameAttack
{
  Projectile
  Height 8
  Radius 8
  Speed 36
  Renderstyle Add
  MaxTargetRange 16
  ReactionTime 32
  BounceType "Hexen"
  BounceFactor 0.1
  WallBounceFactor 0.1
  +DOHARMSPECIES
  +SEEKERMISSILE
  +NOEXPLODEFLOOR
  +PAINLESS
  +HITTRACER
  ActiveSound "necghost/active"
  States
  {
  Spawn:
	DWRT AAAABBBB 1 Bright A_SeekerMissile(25,35,SMF_LOOK|SMF_PRECISE)
	TNT1 A 0 A_CountDown
	Loop
  Death:
	DWRT ABABABABABAB 4 Bright A_FadeOut(0.1,1)
	Stop
  Crash:
  XDeath:
	//TNT1 A 0
	"####" "#" 1 A_CheckFlag(FRIENDLY,"FriendlyDeath",AAPTR_TRACER)
	TNT1 A 1 A_SpawnItemEx("VileStaffIncinerate",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_GiveInventory("VileStaffBurn",1,AAPTR_TRACER)
	DWRT ABABABABABAB 4 Bright A_FadeOut(0.1,1)
	Stop
  FriendlyDeath:
	"####" "#" 0 A_TakeInventory("DemonAmmo",5) //ACS_NamedExecuteWithResult("ttkAmmoStaff")
	"####" "#" 1 Bright ACS_NamedExecuteAlways("CF_VileStaff",0,2)
	"####" "#" 1 Bright A_FadeOut(0.1,1)
	Wait
  }
}

