Actor UnmakerGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "NemesisGet"
  Inventory.PickupMessage "What the !@#%* is this!"
  Tag "Unmaker"
  Obituary "%o got unmade by %k."
  States
  {
  Spawn:
	UMNK Z 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
  SpawnLoop:
	UMNK Z -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("Unmaker",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("Unmaker",1)
	TNT1 A 0 A_JumpIfInventory("UnmakerGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("UnmakerGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("UnmakerGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("UnmakerGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	TNT1 A 0 A_SpawnItemEx("Unmaker")
	Stop
  }
}

Actor UnmakerSpawnerGiver : UnmakerGiver
{
  States
  {
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("UnmakerGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("UnmakerGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor UnmakerGiverCheck : Inventory { Inventory.InterHubAmount 0 }


Actor "Unmaker" : Weapon
{
  Radius 20
  Height 20
  Weapon.AmmoGive 0
  Weapon.AmmoType "DemonAmmo"
  Weapon.SlotNumber 9
  Weapon.SlotPriority 1.1
  Inventory.PickupSound "NemesisGet"
  Weapon.PreferredSkin "Unmaker-Marine"
  Weapon.Kickback 120
  Weapon.ReadySound "UnmakerReadyX"
  Weapon.UpSound "NemesisUp"
  Inventory.PickupMessage "What the !@#%* is this!"
  Tag "Unmaker"
  Obituary "%o got unmade by %k."
  +WEAPON.NOAUTOAIM
  +DONTGIB
  States
  {
  Spawn:
	UMNK Z 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
  SpawnLoop:
	UMNK Z -1
	Loop
  Ready:
	UNMA ZYXWVU 1
  ReadyLoop:	
	UNMA ABCDEF 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	TNT1 A 0 A_Lower
	UNMA A 1 A_Lower
	Goto Deselect+2
  Select:
	TNT1 A 1 A_Raise
	TNT1 A 0 A_Raise
	Goto Select+1
  Fire:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",3) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 2,"HoldFast")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 3,"HoldSpread")
	UNMA ABCDEF 1
  Hold:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",3) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 2,"HoldFast")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 3,"HoldSpread")
	UNMA G 1 //never mess with A_Refire ffs
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0,3)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	// A_RailAttack(0, 0, 0, "none", "None", RGF_SILENT|RGF_NOPIERCING, 0, "UnmakerPuff", 0, 0, 0, 0, 25.0, 0, "None", 7)
	UNMA IIIIII 1 // evil stuff going on here, I 6 wouldn't work as well
	TNT1 A 0 A_Refire
	Goto Afterfire
  HoldFast:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",3) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",4)==2,"EndFire")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0,3)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	//A_RailAttack(0, 0, 0, "none", "none", RGF_SILENT|RGF_NOPIERCING, 0, "UnmakerPuff", 0, 0, 0, 0, 25.0, 0, "None", 7)
	UNMA III 1
	//TNT1 A 0 ACS_NamedExecuteAlways("UnmakerDamage",0,Health - 3)
	TNT1 A 0 A_Refire("HoldFast")
	Goto Afterfire
  HoldSpread:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",4) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	UNMA G 1
	
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0, 6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 3.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -3.0,0)
	UNMA IIIIII 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 3)
	TNT1 A 0 A_Refire("HoldSpread2")
	Goto Afterfire
  HoldSpread2:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",4) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0, 6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 6.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -6.0,0)
	UNMA IIIIII 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 3)
	TNT1 A 0 A_Refire("HoldSpread3")
	Goto Afterfire
  HoldSpread3:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",4) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0, 6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 9.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -9.0,0)
	UNMA IIIIII 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 3)
	TNT1 A 0 A_Refire("HoldSpread4")
	Goto Afterfire
  HoldSpread4:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",4) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheck") == 5,"HoldBoth")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0, 6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 12.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -12.0,0)
	UNMA IIIIII 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 3)
	TNT1 A 0 A_Refire("HoldSpread")
	Goto Afterfire
  HoldBoth:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",7) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_Playsound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0,6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 3.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -3.0,0)
	UNMA III 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 6)
	TNT1 A 0 A_Refire("HoldBoth2")
	Goto Afterfire
  HoldBoth2:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",7) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_Playsound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0,6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 6.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -6.0,0)
	UNMA III 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 6)
	TNT1 A 0 A_Refire("HoldBoth3")
	Goto Afterfire
  HoldBoth3:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",7) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_Playsound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0,6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 9.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -9.0,0)
	UNMA III 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 6)
	TNT1 A 0 A_Refire("HoldBoth4")
	Goto Afterfire
  HoldBoth4:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerHealthCheck",7) == 2,"EndFire")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("UnmakerCheckAmmo",6) == 2,"EndFire")
	UNMA G 1
	//Goto EndFire
	UNMA HI 1 
	TNT1 A 0 A_PlaySound("UnmakerShot", 1, 1, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("UnmakerAmmo",0, 6)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser",0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", 12.0,0)
	TNT1 A 0 A_FireCustomMissile("UnmakerLaser", -12.0,0)
	UNMA III 1
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerDamage",Health - 6)
	TNT1 A 0 A_Refire("HoldBoth")
	Goto Afterfire
  Afterfire:
	UNMA HG 1 
  EndFire:
	TNT1 A 0 A_StopSound(7)
	UNMP ABCDEFGHIJKLMNONMLKJIHGFDCBA 1
	Goto ReadyLoop
  }
}


Actor UnmakerLaser : FastProjectile
{
  Game Doom
  Radius 2
  Height 4
  Speed 300
  Damage (0)
  DamageType "D64Unmaker"
  ProjectileKickBack 16
  RenderStyle Add
  Alpha 1.0
  SeeSound "NULL"
  DeathSound "NULL"
  Obituary "%o was unmade by %k."
   //PROJECTILE
  +HITTRACER
  +NOINTERACTION
  +NOBLOCKMAP
  +RANDOMIZE
  States
  {
  Spawn:
 	TNT1 A 1
 	TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (1*velx)/-35.0,  -(1*vely)/-35.0,  2+(1*velz)/-35.0,  0,0,0, 0, SXF_ABSOLUTEANGLE)
 	//TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (8*velx)/-35.0,  -(8*vely)/-35.0,  2+(8*velz)/-35.0,  0,0,0, 0, SXF_ABSOLUTEANGLE)
 	TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (11*velx)/-35.0, -(11*vely)/-35.0, 2+(11*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	//TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (18*velx)/-35.0, -(18*vely)/-35.0, 2+(18*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (21*velx)/-35.0, -(21*vely)/-35.0, 2+(21*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	//TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (28*velx)/-35.0, -(28*vely)/-35.0, 2+(28*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (31*velx)/-35.0, -(31*vely)/-35.0, 2+(31*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	//TNT1 A 0 A_SpawnItemEx("UnmakerLaserSpark", (37.5*velx)/-35.0, -(37.5*vely)/-35.0, 2+(37.5*velz)/-35.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
 	Loop
  Death:
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerPuff")
  DeathLoop:
 	LPUF AB 3 Bright A_FadeOut(0.10)
 	Loop
  }
}

Actor UnmakerPuff : BulletPuff
{
  Alpha 1
  Scale 1
  //+NOBLOCKMAP
 +FORCEDECAL
 +NOGRAVITY
 +NOEXTREMEDEATH
 +FORCEXYBILLBOARD
 +NOBLOOD
 +PUFFGETSOWNER
 +PUFFONACTORS
 +HITTRACER
 +EXTREMEDEATH
 +ALWAYSPUFF
  //-NOEXTREMEDEATH
  Decal "UnmakerBeamScorch"
  DamageType "ToBeDefined"
  States
  {
  Spawn:
	TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("UnmakerPuff",1)
	UNPF A 1
	Stop
  Crash:
	TNT1 A 0 A_Jump(128,"Decal2")
	UNPF AB 3
	Stop
  Decal2:
	UNPF CDE 2
	Stop
  XDeath:
	TNT1 A 0 ACS_NamedExecuteWithResult("UnmakerPuff",2)
	UNPF A 1
	Stop
  }
}
  
Actor UnmakerLaserSpark
{ 
  RenderStyle Add
  Scale 0.015
  Alpha 1.0 
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  States
  {
  Spawn:
	TNT1 A 0 
	YAE5 A 2 Bright
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1,"Spawn3")
  Spawn2:
	//YAE5 A 1 A_SetScale(ScaleX-0.00075)
	YAE5 A 3 A_ChangeVelocity (frandom(-0.03, 0.03), frandom(-0.03, 0.03), frandom(-0.03, 0.03), 0)
	YAE5 A 1 A_FadeOut(0.1)
	Loop
  }
}

Actor UnmakerLaserTrail : FastProjectile
{ 
  Game Doom
  Radius 2
  Height 4
  Scale 0.6
  Alpha 1
  Speed 0
  Damage 0
  RenderStyle Normal
  SeeSound "NULL"
  DeathSound "NULL"
  Projectile
  +RANDOMIZE
  +NOBLOCKMAP
  +NOINTERACTION
  States
  {
  Spawn:
	UNML A 25 Bright
	Stop
  Death:
	LPUF ABC 2 Bright
	Stop
  }
}