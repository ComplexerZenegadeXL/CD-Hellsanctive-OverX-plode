Actor NemesisGiver : CustomInventory
{
  Scale 0.9
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "NemesisGet"
  Inventory.PickupMessage "$CFNemesisPickup"
  Tag "$CFNemesis"
  States
  {
  Spawn:
	LSRG A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
  SpawnLoop:
	LSRG A -1
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",63,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("Nemesis",1,"Null")
	TNT1 A 0 A_GiveInventory("Nemesis",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",101)
	Stop
  }
}

Actor Nemesis : DoomWeapon
{
  Weapon.Selectionorder 2200
  Weapon.PreferredSkin "Nemesis-Marine"
  Inventory.PickupSound "NemesisGet"
  Obituary "$CFNemesisObit"
  Weapon.AmmoType "NemesisClip"
  Weapon.Kickback 120
  Weapon.SlotNumber 9
  Weapon.SlotPriority 2.0
  Weapon.UpSound "NemesisUp"
  Weapon.SelectionOrder 7000
  AttackSound ""
  Inventory.PickupSound "NemesisGet"
  Inventory.PickupMessage "$CFNemesisPickup"
  +NOAUTOFIRE
  +WEAPON.BFG
  +WEAPON.NOAUTOAIM
  -WEAPON.DONTBOB
  +AMMO_OPTIONAL
  Tag "$CFNemesis"
  States
  {
  Spawn:
	LSRG A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",9,1)
	LSRG A -1 Bright
	Stop
  Ready:
	TNT1 A 0 A_PlaySound("NemesisReady",CHAN_BODY,0.5,1)
	NEME A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlaySound("weapons/weapondown",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_StopSound(7)
  DeselectLoop:
	NEME A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("Nemesis",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_StopSound(CHAN_BODY)
  Select2:
	NEME A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfHealthLower(11,"Ready")
	TNT1 A 0 A_PlaySound("Nemesis/Laser",7)
	NEME BCD 1
	TNT1 A 0 A_PlaySound("Nemesis/LaserLoop",6,1.0,1)
  FireLoop:
	TNT1 A 0 A_JumpIfHealthLower(11,"FireDone")
	TNT1 A 0 A_Quake(2,4,0,6,0)
	TNT1 A 0 A_GunFlash
	//TNT1 A 0 A_JumpIfHealthLower(11,3)
	TNT1 A 0 A_GiveInventory("ScriptToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetCurrentHealth",0,Health - 2)
	NEME EFGH 3 Bright A_RailAttack(random(30,60),0,0,0,0,RGF_SILENT,2,"PlayerNemesisRailPuff",0,0,0,0,8,0,"NemesisRailEffect",-2)
	//NEME EFGH 1 Bright A_RailAttack(random(30,60),0,0,0,0,RGF_SILENT,2,"PlayerNemesisRailPuff",0,0,0,0,8,0,"NemesisRailEffect",-2)
	//NEME EFGH 1 Bright A_FireCustomMissile("NemesisBeam",0,0,0,-4)
	TNT1 A 0 A_ReFire("FireLoop")
	Goto FireDone
  FireDone:
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_StopSound(6)
	NEME DCB 3
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfInventory("NemesisClip",300,1)
	Goto Ready
	NEME BBBCCCIIIJJJ 1
	//TNT1 A 0 A_JumpIf(Health < 10,3)
	//TNT1 A 0 A_GiveInventory("ScriptToken",1)
	//TNT1 A 0 ACS_NamedExecuteAlways("CF_SetCurrentHealth",0,10)
	TNT1 A 0 A_SetBlend("Pink",1.0,10)
	TNT1 A 0 A_PlaySound("Nemesis/FireBall",1)
	TNT1 A 0 A_FireCustomMissile("NemesisAltBall")
	TNT1 A 0 A_TakeInventory("NemesisClip",300)
	TNT1 A 0 A_GunFlash
	NEME K 1 Bright A_Recoil(15)
	NEME KKLLMMNN 1 Bright
	NEME OOPPQQRRSSTT 1
	Goto Ready
  Flash:
	TNT1 A 5 A_Light1
	TNT1 A 10 A_Light2
	TNT1 A 7 A_Light1
	TNT1 A 5 A_Light0
	Stop
  }
}

Actor NemesisClip : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 300
}

Actor NemesisRailEffect
{
  Scale 0.06 //0.08
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  +BRIGHT
  Alpha 0.85
  Renderstyle Add
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_Jump(256,1,2,3)
	NBEA ABC 0 A_Jump(256,"Spawn2")
  Spawn2:
	"----" A 1 Bright A_FadeOut
	Wait	 
  }
}

Actor PlayerNemesisRailPuff : PlayerModdedBulletPuff
{
  +ALWAYSPUFF
  +PUFFONACTORS
  +PUFFGETSOWNER
  +NOTIMEFREEZE
  +BLOODLESSIMPACT
  +THRUSPECIES
  +MTHRUSPECIES
  +HITMASTER
  Species "Player"
  DamageType "NemesisBeam"
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_CustomMissile("Kaboom10", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    Stop
  Death:
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_GetSpecies") == 1,2)
	TNT1 A 0 A_GiveToTarget("NemesisClip",1)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_CustomMissile("Kaboom10", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    Stop
  }
}

Actor NemesisAltBall
{
  Radius 20
  Height 30
  Damage (Random(400,1000))
  Speed 18
  Alpha 0.95
  Scale 2.0
  Renderstyle Add
  Alpha 0.85
  Projectile
  +FORCERADIUSDMG
  +THRUSPECIES
  +NOTIMEFREEZE
  +FOILINVUL
  +RIPPER
  +NOBOSSRIP
  +NODAMAGETHRUST
  +DONTREFLECT
  +SKYEXPLODE
  Species "Player"
  DamageType "NemesisBall"
  DeathSound ""
  //Decal BFG9500Lightning
  States
  {
  Spawn:
    TNT1 A 0 NoDelay A_AlertMonsters
    TNT1 A 0 A_PlaySound("Nemesis/BallLoop",7,1.0,1,0.5)
	TNT1 AAA 0 A_CustomMissile("NemesisAltBallBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("NemesisAltBallSmoke",frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,1),frandom(0,1),frandom(0,1))
    TNT1 AA 0 A_SpawnItemEx("NemesisFlyParticle",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,2),frandom(0,2),frandom(0,2),frandom(0,360))
	TNT1 A 0 A_RadiusGive("NemesisAltBallEffectRemover",3000,RGF_MONSTERS)
	TNT1 A 0 A_Explode(100,2000,0)
    UNB2 A 1 Bright A_SpawnItemEx("NemesisAltBallRailgunAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 AAA 0 A_CustomMissile("NemesisAltBallBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("NemesisAltBallSmoke",frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,1),frandom(0,1),frandom(0,1))
    TNT1 AA 0 A_SpawnItemEx("NemesisFlyParticle",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,2),frandom(0,2),frandom(0,2),frandom(0,360))
	TNT1 A 0 A_RadiusGive("NemesisAltBallEffectRemover",3000,RGF_MONSTERS)
	TNT1 A 0 A_Explode(100,2000,0)
    UNB2 B 1 Bright A_SpawnItemEx("NemesisAltBallRailgunAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 AAA 0 A_CustomMissile("NemesisAltBallBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("NemesisAltBallSmoke",frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,1),frandom(0,1),frandom(0,1))
    TNT1 AA 0 A_SpawnItemEx("NemesisFlyParticle",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,2),frandom(0,2),frandom(0,2),frandom(0,360))
	TNT1 A 0 A_RadiusGive("NemesisAltBallEffectRemover",3000,RGF_MONSTERS)
	TNT1 A 0 A_Explode(100,2000,0)
    UNB2 C 1 Bright A_SpawnItemEx("NemesisAltBallRailgunAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 AAA 0 A_CustomMissile("NemesisAltBallBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("NemesisAltBallSmoke",frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,1),frandom(0,1),frandom(0,1))
    TNT1 AA 0 A_SpawnItemEx("NemesisFlyParticle",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,2),frandom(0,2),frandom(0,2),frandom(0,360))
	TNT1 A 0 A_RadiusGive("NemesisAltBallEffectRemover",3000,RGF_MONSTERS)
	TNT1 A 0 A_Explode(100,2000,0)
    UNB2 D 1 Bright A_SpawnItemEx("NemesisAltBallRailgunAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Loop
  Death:
    TNT1 A 0 A_StopSound(7)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	UNB2 ABCDABCD 6 Bright A_SpawnItemEx("NemesisAltBallShockwave")
	TNT1 A 0 A_PlaySound("Nemesis/BallExplode",1,1.0,0,0.2)
	TNT1 A 0 A_SpawnItemEx("NemesisHugeExplosion",-40)
	TNT1 A 0 A_SpawnItemEx("NemesisAltBallEx")
	TNT1 A 0 A_Quake(9,100,0,2000,0)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_Explode(Random(750,850),4096,0,0,2048) //powers of 2 please.
    Stop    
  }
}

Actor NemesisAltBallRailgunAttack
{
  Projectile
  Projectile
  Height 3
  Radius 3
  Speed 20
  FastSpeed 25
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +FRIENDLY
  +NOCLIP
  +NOTIMEFREEZE
  States 
  {
  Spawn:
    TNT1 A 0
	TNT1 AAAAAAA 2 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Stop
  Attack:
    TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(40,100),0,0,0,RGF_SILENT,1,2,"PlayerNemesisRailPuff",0,0,0,0,8,0,"NemesisRailEffect")
  Death:
	TNT1 A 1
	Stop
  }
}



Actor NemesisAltBallEffectRemover : CrusaderBuff
{
  States
  {
  Pickup:
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",1)
	TNT1 A 0 A_ChangeFlag("INVULNERABLE",0)
	TNT1 A 0 A_ChangeFlag("REFLECTIVE",0)
	TNT1 A 0 A_ChangeFlag("CANTSEEK",0)
	Stop
  }
}

Actor NemesisAltBallBolt
{
  Speed 35
  Radius 6
  Height 6
  Damage (Random(300,700))
  Alpha 0.8
  Projectile
  +SEEKERMISSILE
  +MTHRUSPECIES
  +DONTREFLECT
  +NOTIMEFREEZE
  +BRIGHT
  ReactionTime 170
  RenderStyle Add
  DamageType "NemesisBall"
  DeathSound "bolt/explode"
  States
  {
  Spawn:
  	DVS1 A 0 A_Seekermissile(5,5,SMF_LOOK)
    UNBL AAABBB 1 A_SpawnItem("NemesisAltBallBoltTrail")
    Loop
  Death:

    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_CustomMissile("Kaboom10", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
  Vanilla:
    DVS1 LMN 2
    Stop
  }
}

Actor NemesisAltBallBoltTrail
{
  +NOINTERACTION
