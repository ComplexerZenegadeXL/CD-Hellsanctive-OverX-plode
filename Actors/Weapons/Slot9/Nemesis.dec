Actor FastNemesisPlasmaSprayProjectileAttack
{
  Height 5
  Radius 5
  +ISMONSTER
  -COUNTKILL
  +DROPOFF
  +NOGRAVITY
  +DONTSPLASH
  +NOTELEPORT
  +THRUACTORS
  +NONSHOOTABLE
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +FRIENDLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAA 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_GiveToTarget("NemesisAttack",1)
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor NemesisPlasmaSpread// : FastProjectile
{
  Projectile
  Speed 33
  Height 6
  Radius 3
  Scale 0.2
  Renderstyle Add
  Decal "DoomImpScorch"
  Damage (666)
  +RIPPER
  +SPECTRAL
  +DONTREFLECT
  +NOTIMEFREEZE
  +FOILINVUL
  +DONTHARMSPECIES
  +THRUSPECIES
  Species "Player"
  DamageType "PlayerNemesisPlasma"
  ActiveSound ""
  DeathSound ""
  var int user_chance;
  var int user_lcount;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("NemesisPlasmaFly",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_SetUserVar("user_chance",0)
	TNT1 A 0 A_SetUserVar("user_lcount",0)
	NMPR A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NMPR B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NMPR A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NMPR B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NMPR A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NMPR B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto Spawnloop
  Spawnloop:
	NMPR A 1 Bright A_Weave(user_lcount,user_lcount,2.0+(user_lcount*0.1),1.0+(user_lcount*0.1))
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaSeek",0,0,0,velx*0.5,vely*0.5,(velz+frandom(-3,3))*0.5,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaSpray",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_JumpIf(user_lcount < 5,3)
	TNT1 A 0 A_Jump(96,2)
	TNT1 A 0 A_CustomMissile("FastNemesisPlasmaSpray",0,0,frandom(0,360),CMF_AIMDIRECTION | CMF_TRACKOWNER,frandom(-45,45))
	NMPR B 1 Bright A_Weave(user_lcount,user_lcount,2.0+(user_lcount*0.1),1.0+(user_lcount*0.1))
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaSeek",0,0,0,velx*0.5,vely*0.5,(velz+frandom(-3,3))*0.5,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaSpray",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_JumpIf(user_lcount < 5,3)
	TNT1 A 0 A_Jump(96,2)
	TNT1 A 0 A_CustomMissile("FastNemesisPlasmaSpray",0,0,frandom(0,360),CMF_AIMDIRECTION | CMF_TRACKOWNER,frandom(-45,45))
	TNT1 A 0 A_JumpIf(user_lcount > 100,2)
	TNT1 A 0 A_SetUserVar("user_lcount",user_lcount+1)
	TNT1 A 0 A_JumpIf(user_chance > 96,"SpawnLoop")
	TNT1 A 0 A_SetUserVar("user_chance",user_chance+15)
	Loop
  Death:
	TNT1 AAA 0 A_StopSound(CHAN_VOICE)
  Fade:
	NMPR AB 1 Bright A_FadeOut(0.3,1)
	Loop
  Crash:
  XDeath:
	TNT1 A 0
	TNT1 AAA 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_PlaySound("NemesisPlasmaImpact",CHAN_BODY,1.0)
	NMPR CDEEFFGGHHH 1 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor NemesisPlasmaTrailFX-A
{
  Renderstyle Add
  +NOTIMEFREEZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  Scale 0.2
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("NemesisSparkEffect",frandom(-3,3),frandom(-3,3),frandom(-3,3))
	Goto Fade
  Fade:
	NMPR A 1 Bright A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor NemesisPlasmaTrailFX-B : NemesisPlasmaTrailFX-A
{
  States
  {
  Fade:
	NMPR B 1 Bright A_FadeOut(0.1,1)
	Loop
  }
}

Actor NemesisSparkEffect
{
  Scale 0.03
  Alpha 1
  Renderstyle Add
  +NOTIMEFREEZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	NSPK A 1 A_ChangeVelocity(frandom(-0.4,0.4),frandom(-0.4,0.4),frandom(-0.4,0.4),0)
	TNT1 A 0 A_FadeOut(0.01)
	Loop
  }
}

