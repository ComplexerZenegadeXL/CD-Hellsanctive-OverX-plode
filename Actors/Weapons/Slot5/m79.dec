Actor M79GasGrenadeLauncherGiver : CustomInventory
{
  Scale 0.85
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFM79GasGrenadeLauncherPickup"
  Inventory.PickupSound "Weapons/GrenadePickup"
  Tag "$CFM79GasGrenadeLauncher"
  States
  {
  Spawn:
	M79W A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	M79W A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",41,31,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("M79GasGrenadeLauncher",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("M79GasGrenadeLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",62)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("Missile",Random(3,6))
	TNT1 A 0 A_GiveInventory("M79G",1)
	Stop
  }
}

Actor M79GasGrenadeLauncherSpawnerGiver : M79GasGrenadeLauncherGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("M79GasGrenadeLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("M79GasGrenadeLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",62)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("M79GasGrenadeLauncherGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("M79GasGrenadeLauncherGiverCheck",1)
	TNT1 A 0 A_GiveInventory("Missile",Random(3,6))
	TNT1 A 0 A_GiveInventory("M79G",1)
	Stop
  }
}

Actor M79GasGrenadeLauncherGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor M79GasGrenadeLauncher : Weapon 18652
{
  //$Category Weapons/LCA/DJB
  //$Sprite M79WA0
  //$Title "M79GasGrenadeLauncher"
  Weapon.SlotNumber 5
  Weapon.SlotPriority 3.0
  Weapon.PreferredSkin "GenadeLauncher-Marine"
  Weapon.AmmoType "M79G"
  Weapon.AmmoType2 "Missile"
  Weapon.AmmoGive2 0
  Weapon.AmmoUse 1
  Inventory.PickupMessage "$CFM79GasGrenadeLauncherPickup"
  Inventory.PickupSound "Weapons/GrenadePickup"
  Weapon.SelectionOrder 5050
  Weapon.Kickback 100
  Tag "$CFM79GasGrenadeLauncher"
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  -INVENTORY.UNDROPPABLE
  States 
  {
  Spawn:
	M79W A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",4) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	M79W A -1
	Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickupssg")
	M79S FEDCBA 1
	M79I A 1 A_WeaponReady
	Goto Ready+7
  Deselect: 
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
	M79I A 1 A_Lower
	Goto Deselect+1 
  Select:
	//TNT1 A 0 A_JumpIfInventory("DJBLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("M79GasGrenadeLauncher",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
	Wait
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_PlaySound("weapons/M79GrenadeFire")
	M79F ABCDEF 1 Bright	
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_TakeInventory("M79G",1)
	TNT1 A 0 A_FireCustomMissile("M79Grenade",0,True,0,0,0,6.328125)
	Goto Reload
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	TNT1 A 0 A_Light1
	TNT1 A 0 A_PlaySound("weapons/M79GrenadeFire")
	M79F ABCDEF 1 Bright	
	TNT1 A 0 Radius_Quake(6,3,0,1,0)
	TNT1 A 0 A_TakeInventory("M79G",1)
	TNT1 A 0 A_FireCustomMissile("M79Grenade",0,True,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("M79Grenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("M79Grenade",-15.0,0,0,0,0,6.328125)
	Goto Reload
  Empty:
	TNT1 A 0 A_JumpIfInventory("Missile",1,"Reload")
	TNT1 A 0 A_PlayWeaponSound("weapons/click4")
	M79I A 18
	//M79F CDEF 2
	Goto Ready+7
  Reload:
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto Ready+7
	M79R ABCDE 2
	M79R F 1 A_PlayWeaponSound("weapons/M79GrenadeOpen")
	M79R GHIJKLM 2
	M79R N 3 A_PlayWeaponSound("weapons/M79GrenadeLoad")
	TNT1 A 0 A_TakeInventory("Missile",1, TIF_NOTAKEINFINITE)
	M79R O 2 A_GiveInventory("M79G",1)
	M79R PQRS 2
	M79R T 1 A_PlayWeaponSound("weapons/M79GrenadeClose")
	M79R UV 2	
	Goto Ready+7
  }
}
Actor M79Grenade : Grenade 
{
  Species "Player"
  +DONTSPLASH
  +DOOMBOUNCE
  +CANBOUNCEWATER
  +THRUGHOST
  +THRUSPECIES
  +MTHRUSPECIES
  +NODAMAGETHRUST // Quickfix for nopush.
  Radius 3
  Height 3
  //WallBounceFactor 1
  Damage (Random(60,100))
  DamageType "Poison"
  SeeSound "Weapons/GrenadeBounce"
  BounceSound "Weapons/GrenadeBounce"
  DeathSound "weapons/rocklx"
  States 
  {
  Spawn:
	GASM A 1 A_CustomMissile("GasSmoke",frandom(-1,1),frandom(-1,1))     		
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("M79Poison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4))
	TNT1 A 0 A_Explode(300,128)
	GMEX ABCDE 3
	Stop
  }
}

Actor GasSmoke : GHellionSmoke { Scale 0.05 }

Actor M79Poison : BarbatosPoison { DamageType "Poison" }

Actor M79G : Ammo 
{
  Ammo.BackpackAmount 1
  Ammo.BackpackMaxAmount 1
  Inventory.Icon "M79WA0"
  +IGNORESKILL
}