Actor EnragedLegendaryPlasmaticCannonGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFEnragedLegendaryPlasmaticCannonPickup"
  Inventory.PickupSound "legendarycannon/up"
  Tag "$CFEnragedLegendaryPlasmaticCannon"
  States
  {
  Spawn:
    EEGX A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	EEGX A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",16,-1,16) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",58)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("ILDemonAmmo",50)
	Stop
  }
}

Actor EnragedLegendaryPlasmaticCannonSpawnerGiver : EnragedLegendaryPlasmaticCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",58)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("EnragedLegendaryPlasmaticCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("EnragedLegendaryPlasmaticCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("ILDemonAmmo",50)
	Stop
  }
}

Actor EnragedLegendaryPlasmaticCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor EnragedLegendaryPlasmaticCannon : DoomWeapon
{
  Weapon.KickBack 100
  Weapon.AmmoType "ILDemonAmmo"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 12.0
  Weapon.AmmoUse 8
  Weapon.AmmoType2 "ILDemonAmmo"
  Weapon.AmmoUse2 100
  Weapon.UpSound "legendarycannon/up"
  Weapon.PreferredSkin "EnragedLegendaryCannon-Marine"
  Weapon.SelectionOrder 600
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  //Weapon.MinSelectionAmmo1 8
  //Weapon.MinSelectionAmmo2 100
  Decal "DoomImpScorch"
  Inventory.PickupMessage "$CFEnragedLegendaryPlasmaticCannonPickup"
  Inventory.PickupSound "legendarycannon/up"
  Tag "$CFEnragedLegendaryPlasmaticCannon"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    EEGX A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	EEGX A -1
    Stop
  Ready:
    ECAN A 1 A_WeaponReady
    Loop
  Deselect:
	TNT1 A 0 A_PlaySound("weapons/weapondown")
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	TNT1 A 0 A_Lower
    ECAN A 1 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("EnragedLegendaryPlasmaticCannon",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    ECAN A 1 A_Raise
    Loop
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_GunFlash
	ECAN B 2 Bright
	TNT1 A 0 A_PlaySound("LegCannon/Fire",1)
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
    ECAN C 2 Bright A_FireCustomMissile("EnragedLegendaryCannonBallCF",0,1,0,0)
    ECAN DE 2 Bright
	ECAN FFFGGGHHHAAA 1
	ECAN A 3 A_Refire
    Goto Ready
  FireSpread:
    TNT1 A 0 A_GunFlash
	ECAN B 2 Bright
	TNT1 A 0 A_PlaySound("LegCannon/Fire",1)
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
    ECAN C 2 Bright A_FireCustomMissile("EnragedLegendaryCannonBallCF",0,1,0,0)
	TNT1 A 0 A_FireCustomMissile("EnragedLegendaryCannonBallCF",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("EnragedLegendaryCannonBallCF",-15.0,0,0,0)
    ECAN DE 2 Bright
	ECAN FFFGGGHHHAAA 1
	ECAN A 3 A_Refire
    Goto Ready
  AltFire:
	ECAN A 35 Bright A_PlaySound("legendarycannon/charge",7)
	ECAN BBB 1 Bright
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)	
	TNT1 A 0 A_PlaySound("LegCannon/Fire2",6)
	TNT1 A 0 A_PlaySound("star/fire",1)
	TNT1 A 0 A_FireCustomMissile("EnragedCannonBomb2",0,1,0,0)
    ECAN CCCDDDEEE 1 Bright
	TNT1 A 0 A_PlaySound ("legendarycannon/steam",7)
    ECAN FFFFFFGGGGGGHHHHHHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,6)
	ECAN A 3 A_Refire
    Goto Ready	
  Flash:
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light2
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light0
    Stop
  }
}

Actor EnragedLegendaryCannonBallCF : LegendaryCannonBall
{
  Speed 65
  Damage 85
  Decal BFG9500LightningRed
  States
  {
  Spawn:
	RRBA A 1 Bright A_SpawnItemEx("ELegRevBall3Trail")
    Loop
  Death:
	TNT1 A 0 A_SetScale(1.0)
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EnragedBFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 A 0 A_Explode(280,350,0,0,280)
    EFE1 ABCDEF 5 Bright
    Stop
  }
}

Actor EnragedCannonBomb2 : EnragedLegendaryCannonBallCF
{
  Radius 6
  Height 22
  Speed 45
  Damage 90
  Scale 1.2
  Alpha 1.0
  DeathSound ""
  RenderStyle Add
  var int user_deathloop;
  States
  {
  Spawn:
    EFS3 AAAABBBB 1 Bright A_SpawnItemEx("EnragedCannonBombTrail")
    Loop
  Death:
	TNT1 A 0 A_JumpIf(user_deathloop >= 6,"DeathContinue")
	TNT1 A 0 A_SetUserVar(user_deathloop,user_deathloop+1)
    TNT1 A 0 A_Explode(128,128,0)
	TNT1 A 0 A_SpawnItemEx("EnragedBFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    EFS3 AAAAABBBBB 1 Bright A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  DeathContinue:
    TNT1 A 0 A_SpawnItemEx("EnragedDTBFGEx")
	TNT1 A 0 A_PlaySound("star/explode",1,1.0,0,0.2)
    TNT1 A 0 A_Explode(700,500,0,0,300)
    TNT1 AAAAAAAA 0 A_SpawnItemEx("ELegendaryCannonProjBomb",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(170,190),SXF_NOCHECKPOSITION)	
    TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ELegendaryCannonProjBomb",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(-14,14),SXF_NOCHECKPOSITION)
	TNT1 A 1
    Stop
  }
}

Actor EnragedCannonBombTrail
{
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  +NOINTERACTION
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("ELegRevBall3Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Stop
  }
}

Actor ELegendaryCannonProj
{
  Radius 8
  Height 10
  Speed 70
  Damage (Random(200,500))
  Scale 0.17
  Projectile 
  +SEEKERMISSILE 
  +RANDOMIZE
  +EXTREMEDEATH
  +DOOMBOUNCE
  +THRUSPECIES
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  +BRIGHT
  BounceCount 4
  DeathSound "lrball3/exp"
  Species "Player"
  DamageType "PlayerLegendary"
  RenderStyle Add
  States
  {
  Spawn:
    RRBA A 0
    RRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 AA 1 A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	RRBA A 0 A_SeekerMissile(1,8,SMF_LOOK)
	RRB3 BB 1 A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	RRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 CC 1 A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	RRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 DD 1 A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EKaboomLNMute", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 I 8 A_Explode(64,80,0)
    Stop
  }
}

Actor EnragedCannonBomb
{
  Radius 6
  Height 22
  Speed 45
  Damage 50
  Scale 0.052
  Projectile  
  +RANDOMIZE
  +EXTREMEDEATH
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  SeeSound ""
  DeathSound "lrball3/exp"
  Species "Player"
  Damagetype "PlayerLegendary"
  RenderStyle Add
  ReactionTime 14
  States
  {
  Spawn:
	RRBA A 0 A_CountDown
    RRBA AA 2 bright A_SpawnItemEx("ELegRevBall3Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_Explode(128,128,0)
    TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
    TNT1 A 0 A_SpawnItemEx("EKaboomLN",0,0,0,0,0,0,0,128,0)
	TNT1 A 0 A_PlaySound("lrball3/exp")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("ELegendaryCannonProjBomb",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(170,190),SXF_NOCHECKPOSITION)	
    TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ELegendaryCannonProjBomb",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(-14,14),SXF_NOCHECKPOSITION)
	MMSD A 8 bright A_Explode(38, 140, 0)
    Stop
  }
}

Actor ELegendaryCannonProjBomb : ELegendaryCannonProj { Damage 50 DeathSound ""}