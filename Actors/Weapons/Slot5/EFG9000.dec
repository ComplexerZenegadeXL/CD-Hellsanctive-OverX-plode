	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_SeekerMissile(30,45,SMF_LOOK)
	MIS8 A 2 Bright A_PlaySoundEx("rpg/fly","SoundSlot7",1)	
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")	
	Loop
