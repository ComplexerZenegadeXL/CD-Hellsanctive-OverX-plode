	TNT1 AAAAAA 0 A_CustomMissile("CFKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SetTranslucent(0.75,1)
	MISL B 4 Bright A_Explode(128,128)
	MISL CD 4 Bright
	Stop
  }
}

Actor EFGFusionNuke : FastProjectile
{
  Height 8
  Radius 13
  Speed 75
  Damage 250
  +DONTREFLECT
  +MTHRUSPECIES
  +FORCERADIUSDMG
  Damagetype "Explosion"
  Obituary "$CFEFGFusionNukeObit"
  States
  {
  Spawn:
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2)) 
	NKS1 A 2 Bright A_CustomMissile("NuclearMissileTrail",0,0,0)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Tic",1,"End")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_SpawnItemEx("EFGFusionNukeFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_CustomMissile("EFGFusionNukeExplode",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TNT1 AAAAAAAA 3 A_SpawnItemEx("WelderFlare",0,0,0,frandom(2,4),frandom(2,4),2,frandom(0,360),SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	Stop
  End:
	TNT1 A 1
	Stop
  }
}

Actor EFGFusionNukeExplode
{
  Projectile
  Height 8
  Radius 13
  Speed 0
  +DONTREFLECT
  +MTHRUSPECIES
  +FORCERADIUSDMG
  +NOINTERACTION
  Damagetype "Explosion"
  Obituary "$CFEFGFusionNukeExplodeObit"
