Actor EFGClientSideEffect
{
  +DROPOFF
  +NOGRAVITY
  +NOBLOCKMAP
  +THRUACTORS
  +DONTSPLASH
  +NOTELEPORT
  +NONSHOOTABLE
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 5
	Stop	
  Vanilla:
	TNT1 A 1
	Stop
  }
}

