Actor EFG9000Giver : CustomInventory
{
  Scale 0.5
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/pickupml"
  Inventory.PickupMessage "$CFEFG9000Pickup"
  Tag "$CFEFG9000"
  States
  {
  Spawn:
	EFGF A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	EFGF A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",15,-1,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("EFG9000",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("EFG9000",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",57)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("Missile",20)
	Stop
  }
}

Actor EFG9000SpawnerGiver : EFG9000Giver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("EFG9000",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("EFG9000",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",57)	
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("EFG9000GiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("EFG9000GiverCheck",1)
	TNT1 A 0 A_GiveInventory("Missile",20)
	Stop
  }
}


Actor EFG9000GiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor EFG9000 : Weapon 30424
{
  Scale 0.5
  +WEAPON.NOAUTOFIRE
  +WEAPON.EXPLOSIVE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.AmmoUse 0
  Weapon.AmmoUse2 0
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 10.0
  Weapon.AmmoType "Missile"
  Weapon.AmmoType2 "Missile"
  Weapon.PreferredSkin "EFG9K-Marine"
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 40
  Weapon.SelectionOrder 2000
  Inventory.PickupSound "weapons/pickupml"
  Inventory.PickupMessage "$CFEFG9000Pickup"
  Tag "$CFEFG9000"
  States
  {
  Spawn:
	EFGF A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	EFGF A -1
	Stop
  Ready:
	EFGG A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	EFGG A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("EFG9000",1)
	//Stop
  SelectLoop:
	EFGG A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Missile",2,"Fire2")
	Goto DryFire
  Fire2:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"Fire2Spread")
	TNT1 A 0 A_AlertMonsters
	EFGG A 17 A_PlayWeaponSound("efg/charge1")
	EFGG A 17 A_PlayWeaponSound("efg/charge2")
	EFGG A 17 A_PlayWeaponSound("efg/charge3")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	TNT1 A 0 A_Refire("Hold1")
	Goto Pause
  Hold1:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Missile",4,"Hold2")
	Goto Pause
  Hold2:
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"Hold2Spread")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	//EFGG AA 1 Bright A_GunFlash
	EFGG A 1 Bright A_Refire("Hold1")
	Goto Pause
  Fire2Spread:
	TNT1 A 0 A_AlertMonsters
	EFGG A 17 A_PlayWeaponSound("efg/charge1")
	EFGG A 17 A_PlayWeaponSound("efg/charge2")
	EFGG A 17 A_PlayWeaponSound("efg/charge3")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	TNT1 A 0 A_Refire("Hold1Spread")
	Goto Pause
  Hold1Spread:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Missile",4,"Hold2Spread")
	Goto Pause
  Hold2Spread:
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlayWeaponSound("mrl/fire")
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1),0,7,-8)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1)+15.0,0,7.0,-8)
	TNT1 A 0 A_FireCustomMissile("EFGSeekRocket",frandom(-1,1)-15.0,0,7.0,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(1)
	EFGG BC 1 Bright
	//TNT1 A 0 A_JumpIfInventory("Missile",1,"Pause")
	//EFGG AA 1 Bright A_GunFlash
	EFGG A 1 Bright A_Refire("Hold1")
	Goto Pause
  Pause:
	TNT1 A 0
	EFGG A 20 A_PlayWeaponSound("weapon/warn")
	EFGG A 50
	TNT1 A 0 A_PlaySound("weapon/cool")
	EFGG AAAAAAAAAAAA 1 A_FireCustomMissile("SmokeFX4",frandom(-1,1),0,7,-8) 
	EFGG A 5
	Goto Ready
  AltFire:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Missile",40,"AltFire2")
	Goto DryAltFire
  AltFire2:
	EFGG A 1 Bright A_AlertMonsters
	EFGG A 1 Bright A_PlayWeaponSound("weapons/nuclearmissilecharge")
	EFGG DEDEADEDEADEDEADEDEADEDEA 3 Bright
	EFGG AA 1 Bright A_GunFlash
	TNT1 A 0 A_PlaySoundEx("Cardihilator/NukeFire",1,0,2)
	TNT1 A 0 A_TakeInventory("Missile",40,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("EFGFusionNuke",0,0,7,-8)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_Recoil(2)
	EFGG BBCC 1 Bright
	EFGG A 20 A_PlayWeaponSound("weapon/warn")
	EFGG A 50
	TNT1 A 0 A_PlaySound("weapon/cool")
	EFGG AAAAAAAAAAAA 1 A_FireCustomMissile("SmokeFX4",frandom(-1,1),0,7,-8) 
	EFGG A 5 A_ReFire("AltFire")
	Goto Ready
  DryFire:
	TNT1 A 0
	TNT1 A 0 A_Print("$EFG9000Message1")
	EFGG A 10 A_PlaySound("weapon/off")
	Goto Ready		
  DryAltFire:
	TNT1 A 0
	TNT1 A 0 A_Print("$EFG9000Message2")
	EFGG A 10 A_PlaySound("weapon/off")
	Goto Ready
  }
}

Actor EFGRocket : FastProjectile
{
  Projectile
  Height 8
  Radius 11
  Speed 86
  Damage (Random(75,125))
  +RANDOMIZE
  +SKYEXPLODE
  +MTHRUSPECIES
  DamageType "Explosion"
  DeathSound "weapons/rocklx"
  Obituary "$CFEFGRocketObit"
  States
  {
  Spawn:
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2)) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2)) 
	TNT1 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
	MIS7 A 1 Bright A_PlaySoundEx("rpg/fly","SoundSlot7",1)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_StopSoundEx("SoundSlot7")
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("CFKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SetTranslucent(0.75,1)
	MISL B 4 Bright A_Explode(64,128)
	MISL CD 4 Bright
	Stop
  }
}

