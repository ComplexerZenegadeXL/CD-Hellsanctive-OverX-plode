Actor EFGNukeSmokering : EFGClientSideEffect
{
  Height 10
  Radius 8
  +NOINTERACTION
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
  SpawnLoop:
	TNT1 A 0 A_SpawnItemEx("EFGNukeSmoke",0,0,0,4,0,0,user_loop * 20,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"SpawnLoop")
	TNT1 A 0
	Stop
  }
}