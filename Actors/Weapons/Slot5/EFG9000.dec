  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Explode(1024,256,XF_HURTSOURCE,1,256)
	TNT1 A 1 ThrustThingZ(0,8,0,1)
	TNT1 A 1 A_Explode(512,512,XF_HURTSOURCE,1,256)
	TNT1 A 1 A_Explode(256,1024,0,0,256)
	TNT1 A 1 A_Explode(128,2048,0,0,256)
	Stop
  }
}

