Actor RuffianCannonGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "cannon/pickup"
  Inventory.PickupMessage "$CFRuffianCannonPickup"
  Tag "$CFRuffianCannon"
  States
  {
  Spawn:
	RFMS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	RFMS A -1 
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",11,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("RuffianCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("RuffianCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",66)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor RuffianCannonSpawnerGiver : RuffianCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuffianCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("RuffianCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",66)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("RuffianCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("RuffianCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor RuffianCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor RuffianCannon : BehemothCannon
{
  Weapon.AmmoUse2 10
  Weapon.MinSelectionAmmo1 10
  Weapon.SelectionOrder 2000
  Weapon.SlotPriority 6.0
  Inventory.PickupMessage "$CFRuffianCannonPickup"
  Obituary "$CFRuffianCannonObit"
  Tag "$CFRuffianCannon"
  States
  {
  Spawn:
	RFMS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	RFMS A -1 
	Stop
  Ready:
	RFMR A 1 A_WeaponReady
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("RuffianCannon",1)
	//Stop
  SelectLoop:
	RFMR A 1 A_Raise
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	RFMR A 1 A_Lower
	Loop
  Fire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	RFMR D 3 Bright
	RFMR E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	RFMR F 3 Bright A_FireCustomMissile("PlayerRuffianComet")
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",-2)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",2)
	RFMR G 3 Bright
	RFMR CBA 5 Bright
	Goto Ready
  FireSpread:	
	RFMR D 3 Bright
	RFMR E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	RFMR F 3 Bright A_FireCustomMissile("PlayerRuffianComet")
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",-2)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",2)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",-2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",-15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",-2-15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerRuffianComet",2-15.0,0)
	RFMR G 3 Bright
	RFMR CBA 5 Bright
	Goto Ready
  AltFire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	RFMR D 3
	RFMR E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",-1)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",1)
	RFMR FG 3
	RFMR CBA 5
	Goto Ready
  AltFireSpread:	
	RFMR D 3
	RFMR E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",-1)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",1)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",-1+15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",1+15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",-1-15.0,0)
	TNT1 A 0 A_FireCustomMissile("PlayerPaladinComet",1-15.0,0)
	RFMR FG 3
	RFMR CBA 5
	Goto Ready
  }
}	

Actor PlayerRuffianComet : RuffianComet
{
  Decal "Scorch"
  Damage (Random(150,200))
  +THRUSPECIES
  +NODAMAGETHRUST
  Species "Player"
  DamageType "HellComet"
  States
  {
  Travel:
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM AA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM AB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM BB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM BC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM CC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM DD 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM DA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM AA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9,SMF_LOOK)
	HPCM BB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0 A_Explode(Random(64,96),64,0,0)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM D 3 Bright A_SpawnItemEx("BlueCometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM E 3 Bright A_SpawnItemEx("BlueCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PlayerPaladinComet : PaladinComet
{
  Decal "Scorch"
  Damage (Random(200,300))
  +THRUSPECIES
  +NODAMAGETHRUST
  Species "Player"
  DamageType "HellComet"
  States
  {
  XDeath:
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(Random(128,192),64)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BCMT DE 3 Bright
	TNT1 A 1 A_SpawnItemEx("SPCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}