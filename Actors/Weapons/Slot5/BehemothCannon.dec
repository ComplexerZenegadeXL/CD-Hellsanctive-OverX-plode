Actor BehemothCannonGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFBehemothCannonPickup"
  Inventory.PickupSound "cannon/pickup"
  Tag "$CFBehemothCannon"
  States
  {
  Spawn:
	FHMS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	FHMS A -1 
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",48,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BehemothCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BehemothCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",55)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor BehemothCannonSpawnerGiver : BehemothCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BehemothCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BehemothCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",55)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BehemothCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BehemothCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor BehemothCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor BehemothCannon : DoomWeapon //16653
{
  //$Category Weapons/LCA
  //$Sprite FHMRH0
  //$Title "Behemoth Cannon"
  Weapon.Kickback 300
  Weapon.PreferredSkin "BehemothCannon-Marine"  
  Scale 0.95
  Weapon.AmmoType "DemonAmmo"  
  Weapon.AmmoType2 "DemonAmmo"   
  Weapon.AmmoUse 5
  Weapon.AmmoUse2 5
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 4.0
  //Weapon.MinSelectionAmmo1 5
  //Weapon.MinSelectionAmmo2 5
  Weapon.SelectionOrder 3000
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Inventory.PickupMessage "$CFBehemothCannonPickup"
  Inventory.PickupSound "cannon/pickup"
  Obituary "$CFBehemothCannonObit"
  Tag "$CFBehemothCannon"
  Weapon.UpSound "cannon/up"
  States
  {
  Spawn:
	FHMS A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
  SpawnLoop:
	FHMS A -1 
	Stop
  Ready:
	FHMR A 1 A_WeaponReady
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("BehemothCannon",1)
	//Stop
  SelectLoop:
	FHMR A 1 A_Raise
	Loop
  Deselect:	
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	FHMR A 1 A_Lower
	Loop
  Fire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	FHMR D 3 Bright
	FHMR E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	FHMR F 1 Bright A_FireCustomMissile("BehemothCometPlayer")
	FHMR F 0 A_FireCustomMissile("BehemothCometPlayer", -2)
	FHMR F 0 A_FireCustomMissile("BehemothCometPlayer", 2)
	FHMR G 3 Bright
	FHMR CBA 5 Bright
	Goto Ready
  FireSpread:	
	FHMR D 3 Bright
	FHMR E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	FHMR F 1 Bright A_FireCustomMissile("BehemothCometPlayer")
	FHMR F 0 A_FireCustomMissile("BehemothCometPlayer", -2)
	FHMR F 0 A_FireCustomMissile("BehemothCometPlayer", 2)
	TNT1 A 0 A_FireCustomMissile("BehemothCometPlayer", -2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothCometPlayer", 2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothCometPlayer", -2-15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothCometPlayer", 2-15.0,0)
	FHMR G 3 Bright
	FHMR CBA 5 Bright
	Goto Ready
  AltFire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	FHMR D 3
	FHMR E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	FHMR F 0 A_FireCustomMissile("BehemothSeekingCometPlayer",-2)
	FHMR F 0 A_FireCustomMissile("BehemothSeekingCometPlayer",2)
	FHMR FG 3
	FHMR CBA 5
	Goto Ready		
  AltFireSpread:	
	FHMR D 3
	FHMR E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	FHMR F 0 A_FireCustomMissile("BehemothSeekingCometPlayer",-2)
	FHMR F 0 A_FireCustomMissile("BehemothSeekingCometPlayer",2)
	TNT1 A 0 A_FireCustomMissile("BehemothSeekingCometPlayer",-2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothSeekingCometPlayer",2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothSeekingCometPlayer",-2-15.0,0)
	TNT1 A 0 A_FireCustomMissile("BehemothSeekingCometPlayer",2-15.0,0)
	FHMR FG 3
	FHMR CBA 5
	Goto Ready
  }
}	

Actor BehemothCometPlayer : Comet
{
  Species "Player"
  Radius 8
  Decal "Scorch"
  Height 8
  DamageType "HellComet"
  Damage (Random(100,215)) //35
  Scale 0.7
  +THRUSPECIES
  +NODAMAGETHRUST
  States
  {
  Spawn:
	COMT AAAAABBBBB 1 Bright A_SpawnItemEx("BehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    Loop
  Death:	
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}	

Actor BehemothSeekingCometPlayer : Comet
{
  Scale 0.55
  DamageType "HellComet"
  Damage (Random(100,215)) //35
  RenderStyle Add
  Alpha 0.85
  Species "Player"
  Decal "Scorch"
  +THRUSPECIES
  +SEEKERMISSILE
  +SCREENSEEKER
  +NODAMAGETHRUST
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
	BHTB AAAAA 1 Bright A_SpawnItemEx("BehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
	BHTB BBBBB 1 Bright A_SpawnItemEx("BehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}