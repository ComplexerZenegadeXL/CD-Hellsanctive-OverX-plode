Actor HomingRocketLauncherGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "weapons/pickupml"
  Inventory.PickupMessage "$CFHomingRocketLauncherPickup"
  Tag "$CFHomingRocketLauncher"
  States
  {
  Spawn:
	WHRL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	WHRL A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",12,-1,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("HomingRocketLauncher",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,64)
	TNT1 A 0 A_GiveInventory("HomingRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",60)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("Missile",8)
	Stop
  }
}

Actor HomingRocketLauncherSpawnerGiver : HomingRocketLauncherGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("HomingRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,64)
	TNT1 A 0 A_GiveInventory("HomingRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",60)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("HomingRocketLauncherGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("HomingRocketLauncherGiverCheck",1)
	TNT1 A 0 A_GiveInventory("Missile",8)
	Stop
  }
}

Actor HomingRocketLauncherGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor HomingRocketLauncher : DoomWeapon
{
  //$Category Weapons/CF
  //$Sprite WHRLA0
  //$Title "Homing Rocket Launcher"
  +WEAPON.EXPLOSIVE
  +WEAPON.NOAUTOFIRE
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Weapon.SelectionOrder 10
  Weapon.PreferredSkin "HRL-Marine"
  Weapon.AmmoType "Missile"
  Weapon.AmmoType2 "Missile"
  Weapon.AmmoGive 0
  Weapon.AmmoUse 2
  Weapon.SlotNumber 5
  Weapon.SlotPriority 7.0
  //Weapon.MinSelectionAmmo1 2
  Weapon.SelectionOrder 3000
  Inventory.PickupSound "weapons/pickupml"
  Inventory.PickupMessage "$CFHomingRocketLauncherPickup"
  Obituary "$CFHomingRocketLauncherObit"
  Tag "$CFHomingRocketLauncher"
  States
  {
  Spawn:
	WHRL A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	WHRL A -1
	Stop
  Ready:
	HRLG A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	//HRLG A 0 A_Lower
  DeselectLoop:
	HRLG A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("HomingRocketLauncher",1)
	//Stop
  SelectLoop:
	//HRLG A 0 A_Raise
	HRLG A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	HRLG A 4
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",0,0,-6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",0,1,6,-8)
	HRLG DEFGHCB 2 Bright
	HRLG A 7
	HRLG A 3 A_Refire
	Goto Ready
  FireSpread:
	HRLG A 4
	TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",0,0,-6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",0,1,6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",15.0,0,-6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",15.0,0,6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",-15.0,0,-6,-8)
	TNT1 A 0 A_FireCustomMissile("PlayerHomRocket",-15.0,0,6,-8)
	HRLG DEFGHCB 2 Bright
	HRLG A 7
	HRLG A 3 A_Refire
	Goto Ready
  Flash:
	TNT1 A 5 A_Light1
	TNT1 A 6 A_Light2
	TNT1 A 5 A_Light1
	TNT1 A 0 A_Light0
	Stop
  }
}

