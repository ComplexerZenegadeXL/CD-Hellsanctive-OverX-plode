Actor LegendaryPlasmaticCannonGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryPlasmaticCannonPickup"
  Inventory.PickupSound "legendarycannon/up"
  Tag "$CFLegendaryPlasmaticCannon"
  States
  {
  Spawn:
    LEGX A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	LEGX A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",58,-1,15) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",61)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("LDemonAmmo",50)
	Stop
  }
}

Actor LegendaryPlasmaticCannonSpawnerGiver : LegendaryPlasmaticCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",61)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("LegendaryPlasmaticCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("LegendaryPlasmaticCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("LDemonAmmo",50)
	Stop
  }
}

Actor LegendaryPlasmaticCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor LegendaryPlasmaticCannon : DoomWeapon
{
  Weapon.KickBack 100
  Weapon.AmmoType "LDemonAmmo"
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 11.0
  Weapon.AmmoUse 8
  Weapon.AmmoType2 "LDemonAmmo"
  Weapon.AmmoUse2 10
  Weapon.UpSound "legendarycannon/up"
  Weapon.PreferredSkin "LegendaryCannon-Marine"
  Weapon.SelectionOrder 1000
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  //Weapon.MinSelectionAmmo1 8
  //Weapon.MinSelectionAmmo2 10
  Decal "DoomImpScorch"
  Inventory.PickupMessage "$CFLegendaryPlasmaticCannonPickup"
  Inventory.PickupSound "legendarycannon/up"
  Obituary "$CFLegendaryPlasmaticCannonObit"
  Tag "$CFLegendaryPlasmaticCannon"
  States
  {
  Spawn:
    LEGX A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	LEGX A -1
    Stop
  Ready:
    LCAN A 1 A_WeaponReady
    Loop
  Deselect:
	TNT1 A 0 A_PlaySound("weapons/weapondown")
    TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
  DeselectLoop:
	TNT1 A 0 A_Lower
    LCAN A 1 A_Lower
    Loop
  Select:
    //TNT1 A 0 A_JumpIfInventory("LCALoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("LegendaryPlasmaticCannon",1)
	//Stop
  SelectLoop:
	TNT1 A 0 A_Raise
    LCAN A 1 A_Raise
    Loop
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_GunFlash
	LCAN B 2 Bright
	TNT1 A 0 A_PlaySound("LegCannon/Fire",1)
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
    LCAN C 2 Bright A_FireCustomMissile("LegendaryCannonBall",0,1,0,0)
    LCAN DE 2 Bright
	LCAN FFFGGGHHHAAA 1
	LCAN A 3 A_Refire
    Goto Ready
  FireSpread:
    TNT1 A 0 A_GunFlash
	LCAN B 2 Bright
	TNT1 A 0 A_PlaySound("LegCannon/Fire",1)
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
    LCAN C 2 Bright A_FireCustomMissile("LegendaryCannonBall",0,1,0,0)
	TNT1 A 0 A_FireCustomMissile("LegendaryCannonBall",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("LegendaryCannonBall",-15.0,0,0,0)
    LCAN DE 2 Bright
	LCAN FFFGGGHHHAAA 1
	LCAN A 3 A_Refire
    Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	LCAN A 18 Bright A_PlaySound("legendarycannon/charge",7)
	LCAN BBB 1 Bright
    TNT1 A 0 A_GunFlash
	TNT1 A 0 Radius_Quake(2,2,0,1,0)	
	TNT1 A 0 A_PlaySound("LegCannon/Fire2",1)
	TNT1 AA 0 A_FireCustomMissile("LegendaryCannonProj",frandom(-5,5),1,0,0,0,frandom(-3,3))
	TNT1 AA 0 A_FireCustomMissile("LegendaryCannonProj",frandom(-5,5),0,0,0,0,frandom(-3,3))
    LCAN CCCDDDEEE 1 Bright
	TNT1 A 0 A_JumpIfNoAmmo(2)
	TNT1 A 0 A_Refire("Altfire2")
	TNT1 A 0 A_PlaySound ("legendarycannon/steam",7)
    LCAN FFFFFFGGGGGGHHHHHHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,0)
    Goto Ready	
  Altfire2:
	LCAN FFFGGGHHHAAA 1
	Goto Altfire+3
  Flash:
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light2
    TNT1 A 1 A_Light1
    TNT1 A 1 A_Light0
    Stop
  }
}
Actor LegendaryCannonSmoke
{
  Scale 0.1
  Alpha 0.5
  Renderstyle Add
  +CLIENTSIDEONLY //come on LCA
  +NOCLIP 
  +NOGRAVITY
  +NOTIMEFREEZE
  Radius 1 
  Height 1 
  Speed 2
  RenderStyle Translucent
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ThrustThingZ (0, random(3, 6), 0, 0)
    LCSM ABCD 1
	TNT1 A 0
	TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
	LCSM A 1 A_FadeOut(0.01)
	Wait
	LCSM B 1 A_FadeOut(0.01)
	Wait
	LCSM C 1 A_FadeOut(0.01)
	Wait
	LCSM D 1 A_FadeOut(0.01)
	Wait
	Stop
  Death:
	LCSM R 1
    Stop
  }
}

Actor LegendaryCannonProj
{
  Radius 8
  Height 10
  Speed 70
  Damage (random(200,400)) //70
  Scale 0.17
  Projectile 
  +SEEKERMISSILE
  +RANDOMIZE
  +EXTREMEDEATH
  +DOOMBOUNCE
  +THRUSPECIES
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  BounceCount 4
  DeathSound "lrball3/exp"
  Species "Player"
  DamageType "PlayerLegendary"
  RenderStyle Add
  States
  {
  Spawn:
    LRBA A 0
    LRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 AA 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LRBA A 0 A_SeekerMissile(1,8,SMF_LOOK)
	LRB3 BB 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 CC 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LRBA A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 DD 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 I 8 A_Explode(64,80,0)
    TNT1 J 6
    TNT1 K 4
    Stop
  }
}

Actor LegendaryCannonProjBlueStar
{
  Radius 12
  Height 12
  Speed 45
  Damage 250
  Scale 3.2
  Projectile
  RenderStyle Add
  +SEEKERMISSILE
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +DONTREFLECT
  +FOILINVUL
  +NOTIMEFREEZE
  +BRIGHT
  Alpha 0.8
  DamageType "PlayerLegendary"
  DeathSound "star/explode"
  Obituary "$CFLegendaryCannonProjBlueStarObit"
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(15,5)
    LRB1 ABCD 2 Bright A_CustomMissile("BluestarFX",0,0,0,0)
	TNT1 A 0 A_SeekerMissile(15,5)
    Loop
  Death:
	TNT1 A 0 A_Explode(192,384,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("BlueDTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItem("BlueDTBFGEx",0,-10)
	LRB1 E 3 Bright
    LRB1 FGHIJKLMNO 3 Bright
    Stop
  }
}

Actor LegendaryCannonBall
{
  Radius 8
  Height 10
  Speed 50
  Damage (Random(200,400)) //70
  Scale 0.1
  Projectile 
  +EXTREMEDEATH
  +THRUSPECIES
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Decal "BFG9500LightningBlue"
  DeathSound "lrball3/exp"
  Species "Player"
  DamageType "PlayerLegendary"
  RenderStyle Add
  States
  {
  Spawn:
	LRBA A 1 Bright A_SpawnItemEx("LegRevBall3Trail")
    Loop
  Death:
	TNT1 A 0 A_SetScale(1.0)
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LNCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Explode(220,300,0,0,250)
    QRE3 ABCDEF 5 Bright
    Stop
  }
}