Actor BarbatosCannonGiver : CustomInventory
{
  Scale 0.95
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFBarbatosCannonPickup"
  Inventory.PickupSound "cannon/pickup"
  Tag "$CFBarbatosCannon"
  States
  {
  Spawn:
	BRBD A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	BRBD A -1 
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",42,-1,4) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("BarbatosCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("BarbatosCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",54)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor BarbatosCannonSpawnerGiver : BarbatosCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("BarbatosCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("BarbatosCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",54)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("BarbatosCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("BarbatosCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("DemonAmmo",40)
	Stop
  }
}

Actor BarbatosCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor BarbatosCannon : DoomWeapon
{
  Scale 0.95 
  Weapon.Kickback 300
  Weapon.AmmoUse 5
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 5.0
  Weapon.PreferredSkin "BehemothCannon-Marine"  
  Weapon.AmmoType "DemonAmmo"   
  Weapon.AmmoUse2 5
  Weapon.AmmoType2 "DemonAmmo" 
  //Weapon.MinSelectionAmmo1 5
  //Weapon.MinSelectionAmmo2 5
  Weapon.SelectionOrder 3000
  +WEAPON.NOALERT
  +WEAPON.AMMO_OPTIONAL
  Inventory.PickupMessage "$CFBarbatosCannonPickup"
  Inventory.PickupSound "cannon/pickup"
  Obituary "$CFBarbatosCannonObit"
  Tag "$CFBarbatosCannon"
  Weapon.UpSound "cannon/up"
  States
  {
  Spawn:
	BRBD A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	BRBD A -1 
	Stop
  Ready:
	BRBC A 1 A_WeaponReady
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("RMLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("BarbatosCannon",1)
	//Stop
  SelectLoop:
	BRBC A 1 A_Raise
	Loop
  Deselect:	
	BRBC A 1 A_Lower
	Loop
  Fire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	BRBC D 3 Bright
	BRBC E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	BRBC F 3 Bright A_FireCustomMissile("BarbatosCometPlayer")
	BRBC F 0 A_FireCustomMissile("BarbatosCometPlayer", -2)
	BRBC F 0 A_FireCustomMissile("BarbatosCometPlayer", 2)
	BRBC G 3 Bright
	BRBC CBA 5 Bright
	Goto Ready
  FireSpread:	
	BRBC D 3 Bright
	BRBC E 3 Bright A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	BRBC F 3 Bright A_FireCustomMissile("BarbatosCometPlayer")
	BRBC F 0 A_FireCustomMissile("BarbatosCometPlayer", -2)
	BRBC F 0 A_FireCustomMissile("BarbatosCometPlayer", 2)
	TNT1 A 0 A_FireCustomMissile("BarbatosCometPlayer", -2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosCometPlayer", 2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosCometPlayer", -2-15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosCometPlayer", 2-15.0,0)
	BRBC G 3 Bright
	BRBC CBA 5 Bright
	Goto Ready
  AltFire:	
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	BRBC D 3
	BRBC E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	BRBC F 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",-2)
	BRBC F 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",2)
	BRBC FG 3
	BRBC CBA 5
	Goto Ready
  AltFireSpread:	
	BRBC D 3
	BRBC E 3 A_PlaySound("cannon/fire", CHAN_WEAPON, 1.0, 0)
	BRBC F 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",-2)
	BRBC F 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",2)
	TNT1 A 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",-2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",2+15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",-2-15.0,0)
	TNT1 A 0 A_FireCustomMissile("BarbatosSeekingCometPlayer",2-15.0,0)
	BRBC FG 3
	BRBC CBA 5
	Goto Ready
  }
}	

Actor BarbatosCometPlayer : Comet
{
  Damage (random(150,300)) //50
  DamageType "Poison"
  +STRIFEDAMAGE
  +THRUSPECIES
  Species "Player"
  DeathSound "barbcomet/explosion"
  States
  {
  Spawn:
    BRTB AAABBB 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRTB C 3 Bright A_Explode(70,100)
    BRTB D 3 Bright A_SetTranslucent(0.75,1)
    TNT1 AAAAA 0 A_SpawnItemEx("BarbatosPoisonPlayer",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4))
    BRTB EFG 3 Bright
    Stop
  }
}

Actor BarbatosSeekingCometPlayer : BarbatosCometPlayer
{
  Damage (random(110,250)) //40
  +SEEKERMISSILE
  +SCREENSEEKER
  States
  {
  Spawn:
    TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
    BRTB AAAAA 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
    BRTB BBBBB 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    Loop
  }
}

Actor BarbatosPoisonPlayer : PoisonEleBreath
{ 
  Scale 0.7
  Speed 10
  Species "Player"
  Damage (2)
  DamageType "Poison"
  States 
  { 
  Spawn: 
    TRPS ABCDEFGDFEGDF 3 A_Explode(2,68)
  Death: 
	TRPS CCBBAA 1 A_FadeOut(0.15)
    Stop 
  }
}

Actor PoisonAura : BarbatosPoisonPlayer
{
  Speed 14
  DamageType "PlayerPoison"
  Alpha 0.75
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  //+THRUSPECIES
  +RIPPER
  States 
  { 
  Spawn: 
    TRPS A 0
	TRPS A 0 A_ChangeVelocity(frandom(0,6),frandom(0,6),0,CVF_RELATIVE)
	TRPS ABCDEFGDFEGDF 3 A_Explode(Random(3,5),96,0)
  Death: 
	TRPS CCBBAA 1 A_FadeOut(0.15)
    Stop 
  }
}