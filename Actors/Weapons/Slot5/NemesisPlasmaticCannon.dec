Actor NemesisPlasmaticCannonGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "NemesisCannon/up"
  Inventory.PickupMessage "$CFNemesisPlasmaticCannonPickup"
  Tag "$CFNemesisPlasmaticCannon"
  States
  {
  Spawn:
	NEMD A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	NEMD A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",17,-1,18) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("NemesisPlasmaticCannon",1,"JustAmmo")
	TNT1 A 0 A_GiveInventory("NemesisPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",63)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("NLDemonAmmo",50)
	Stop
  }
}

Actor NemesisPlasmaticCannonSpawnerGiver : NemesisPlasmaticCannonGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("NemesisPlasmaticCannon",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("NemesisPlasmaticCannon",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",63)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("NemesisPlasmaticCannonGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("NemesisPlasmaticCannonGiverCheck",1)
	TNT1 A 0 A_GiveInventory("NLDemonAmmo",50)
	Stop
  }
}

Actor NemesisPlasmaticCannonGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor NemesisPlasmaticCannon : LegendaryPlasmaticCannon
{
  Weapon.AmmoType "NLDemonAmmo"
  Weapon.AmmoUse 5
  Weapon.AmmoType2 "NLDemonAmmo"
  Weapon.AmmoUse2 1
  Weapon.SlotPriority 13.0
  Weapon.UpSound "NemesisCannon/up"
  Weapon.PreferredSkin "LegendaryCannon-Marine"
  Weapon.SelectionOrder 200
  //Weapon.MinSelectionAmmo1 5
  Inventory.PickupSound "NemesisCannon/up"
  Inventory.PickupMessage "$CFNemesisPlasmaticCannonPickup"
  Obituary "$CFNemesisPlasmaticCannonObit"
  Tag "$CFNemesisPlasmaticCannon"
  States
  {
  Spawn:
	NEMD A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",12) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,1)
	NEMD A -1
	Stop
  Ready:
	NCAN A 1 A_WeaponReady
	Loop
  Deselect:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	NCAN A 0 A_Lower
	NCAN A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("NemesisPlasmaticCannon",1)
	//Stop
  SelectLoop:
	NCAN A 0 A_Raise
	NCAN A 1 A_Raise
	Loop
  Fire:
	TNT1 A 0 A_JumpIfInventory("NemesisCannonMode2",1,"Fire3")
	TNT1 A 0 A_JumpIfInventory("NemesisCannonMode1",1,"Fire2")
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",5,"FireContinue")
	Goto Ready
  FireContinue:
	TNT1 A 0 A_JumpIfNoAmmo("Ready")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireContinueSpread")
	TNT1 A 0 A_GunFlash
	NCAN B 2 Bright
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",3)
	NCAN C 2 Bright A_FireCustomMissile("NemesisCannonBall",0,1,0,0)
	NCAN DE 2 Bright
	NCAN FFFGGGHHHAAA 1
	NCAN A 3 A_Refire
	Goto Ready
  FireContinueSpread:
	TNT1 A 0 A_GunFlash
	NCAN B 2 Bright
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",2,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",3)
	NCAN C 2 Bright A_FireCustomMissile("NemesisCannonBall",0,1,0,0)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonBall",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonBall",-15.0,0,0,0)
	NCAN DE 2 Bright
	NCAN FFFGGGHHHAAA 1
	NCAN A 3 A_Refire
	Goto Ready
  Fire2:
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",1,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"Fire2Spread")
	TNT1 A 0 A_GunFlash
	NCAN B 2 Bright
	TNT1 A 0 A_PlaySound("NemesisCannon/Laser")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	NCAN C 2 Bright A_FireCustomMissile("NemesisCannonLaserPlayer",0,0,0,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",1)
	NCAN DE 2 Bright
	NCAN FFGGHH 1
	NCAN A 3 A_Refire
	Goto Ready
  Fire2Spread:
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",1,1)
	Goto Ready
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_GunFlash
	NCAN B 2 Bright
	TNT1 A 0 A_PlaySound("NemesisCannon/Laser")
	TNT1 A 0 Radius_Quake(2,2,0,1,0)
	NCAN C 2 Bright A_FireCustomMissile("NemesisCannonLaserPlayer",0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonLaserPlayer",15.0,0,0,0)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonLaserPlayer",-15.0,0,0,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",1)
	NCAN DE 2 Bright
	NCAN FFGGHH 1
	NCAN A 3 A_Refire
	Goto Ready
  Fire3:
	TNT1 A 0 A_JumpIfInventory("NLDemonAmmo",100,"Fire3Continue")
	Goto Ready
  Fire3Continue:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"NoSpeedForYou3")
	NCAN A 95 Bright A_PlaySound("devastator/charge",1)
	TNT1 A 0 A_GunFlash
	NCAN BBB 1 Bright
	TNT1 A 0 Radius_Quake(2,2,0,1,0)	
	TNT1 A 0 A_PlaySound("NemesisCannon/BigLaser",1)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonIonBeamPlayer",0,0,0,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",50)
    NCAN CCCDDDEEE 1 Bright
	TNT1 A 0 A_PlaySound ("legendarycannon/steam",7)
	TNT1 A 0 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,6)
    NCAN FFFFFFGGGGGGHHHHHHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,6)
	NCAN A 3 A_Refire("Fire3")
	Goto Ready	
  NoSpeedForYou3:
	NCAN A 190 Bright A_PlaySound("devastator/charge",1)
	TNT1 A 0 A_GunFlash
	NCAN BBB 1 Bright
	TNT1 A 0 Radius_Quake(2,2,0,1,0)	
	TNT1 A 0 A_PlaySound("NemesisCannon/BigLaser",1)
	TNT1 A 0 A_FireCustomMissile("NemesisCannonIonBeamPlayer",0,1,0,0)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",50,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_TakeInventory("NLDemonAmmo",50)
    NCAN CCCDDDEEE 1 Bright
	TNT1 A 0 A_PlaySound ("legendarycannon/steam",7)
	TNT1 A 0 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,6)
    NCAN FFFFFFGGGGGGHHHHHHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_FireCustomMissile("LegendaryCannonSmoke",0,0,1,6)
	NCAN A 6 A_Refire("Fire3")
	Goto Ready
  Altfire:
	TNT1 A 0 A_JumpIfInventory("NemesisCannonMode2",1,"Altfire3")
	TNT1 A 0 A_JumpIfInventory("NemesisCannonMode1",1,"Altfire2")
	NCAN A 1
	TNT1 A 0 A_Playsound("NemesisCannon/Mode2")
	TNT1 A 0 A_GiveInventory("NemesisCannonMode1")
	TNT1 A 0 A_Print("$NemesisPlasmaCannonMessage1")
	NCAN A 2 Offset(0,34)
	NCAN A 2 Offset(0,37)
	NCAN A 2 Offset(0,34)
	NCAN A 1
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  Altfire2:
	NCAN A 1
	TNT1 A 0 A_Playsound("NemesisCannon/Mode3")
	TNT1 A 0 A_TakeInventory("NemesisCannonMode1")
	TNT1 A 0 A_GiveInventory("NemesisCannonMode2")
	TNT1 A 0 A_Print("$NemesisPlasmaCannonMessage2")
	NCAN A 2 Offset(0,34)
	NCAN A 2 Offset(0,37)
	NCAN A 2 Offset(0,34)
	NCAN A 1
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  Altfire3:
	NCAN A 1
	TNT1 A 0 A_Playsound("NemesisCannon/Mode1")
	TNT1 A 0 A_TakeInventory("NemesisCannonMode2")
	TNT1 A 0 A_Print("$NemesisPlasmaCannonMessage3")
	NCAN A 2 Offset(0,34)
	NCAN A 2 Offset(0,37)
	NCAN A 2 Offset(0,34)
	NCAN A 1
	TNT1 A 0 A_Refire("NoAutoAltFirePls")
	Goto Ready
  NoAutoAltFirePls:
	NCAN A 1
	NCAN A 1 A_Refire("NoAutoAltFirePls")
	Goto Ready
  Flash:
	TNT1 A 1 A_Light1
	TNT1 A 1 A_Light2
	TNT1 A 1 A_Light1
	TNT1 A 1 A_Light0
	Stop
  }
}

Actor NemesisCannonMode1 : Inventory {}
Actor NemesisCannonMode2 : Inventory {}

Actor NemesisCannonProj : LegendaryCannonProj
{
  Speed 70
  BounceCount 4
  Damage (Random(250,550))
  BounceFactor 1.0
  WallBounceFactor 1.0
  Species " "
  DamageType "Legendary"
  DeathSound "lrball3/exp"
  States
  {
  Spawn:
	TNT1 A 0 //A_CountDown
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	NRB3 AA 1 Bright A_SpawnItemEx("NemesisCannonProjTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	NRB3 BB 1 Bright A_SpawnItemEx("NemesisCannonProjTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	NRB3 CC 1 Bright A_SpawnItemEx("NemesisCannonProjTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	NRB3 DD 1 Bright A_SpawnItemEx("NemesisCannonProjTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_PlaySound("weapons/rocklx",2)
  XDeath:
	TNT1 AA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("NemesisCannonShotExplosion",0,0,0,2)
	TNT1 I 8 Bright A_Explode(128,128,0)
	TNT1 J 6 Bright
	TNT1 K 4 Bright
	Stop
  }
}

Actor NemesisCannonProjTrail : LegRevBall3Trail2
{
  States
  {
  Spawn:
	TNT1 A 0 
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 0 A_Jump(256,"Flash1","Flash2","Flash3","Flash4")
  Flash1:
	NRB3 A 1 Bright A_FadeOut(0.125,1)
	Wait
  Flash2:
	NRB3 B 1 Bright A_FadeOut(0.125,1)
	Wait
  Flash3:
	NRB3 C 1 Bright A_FadeOut(0.125,1)
	Wait
  Flash4:
	NRB3 D 1 Bright A_FadeOut(0.125,1)
	Wait
  }
}

Actor NemesisCannonShotExplosion
{
  Projectile
  Speed 0
  Damage 10
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  +NODAMAGETHRUST
  Damagetype "Legendary"
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 A 1 A_Explode(100,200,0,0)
	Stop
  }
}

Actor NemesisCannonProjPlayer : NemesisCannonProj
{
  Species "Player"
  Damage 5
  +STRIFEDAMAGE
  States
  {
  Death:
  XDeath:
    TNT1 A 0 A_PlaySound("weapons/rocklx",2)
	TNT1 A 0
	TNT1 AA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("NemesisCannonShotExplosionPlayer",0,0,0,2)
	TNT1 I 8 Bright A_Explode(Random(100,110),128,0)
	TNT1 J 6 Bright
	TNT1 K 4 Bright
	Stop
  }
}

Actor NemesisCannonShotExplosionPlayer : NemesisCannonShotExplosion
{
  Damagetype "PlayerNemesisPlasma"
  Species "Player"
  +FOILINVUL
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 A 1 A_Explode(280,200,0,0)
	Stop
  }
}

Actor NemesisCannonIonBeam : FastProjectile
{
  Radius 6
  Speed 100
  Height 6
  Damage 5
  Scale 0.3
  RenderStyle Add
  Projectile
  +RIPPER
  +STRIFEDAMAGE
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  +THRUSPECIES
  +NOBOSSRIP
  Damagetype "Legendary"
  DeathSound "star/explode"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("NemesisIonBeamTrail")
	TNT1 A 0 A_SpawnItemEx("NemesisCannonIonBeamParticle",0,0,0,frandom(-1,1),frandom(-1,1),frandom(-1,1))
	CLBA D 1 A_Explode(100,92,0,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(500,256,0,1)
	TNT1 A 0 A_CustomMissile("NemesisCannonShotExplosion")
	TNT1 A 0 A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 AAAA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisCannonProj",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(170,190),SXF_NOCHECKPOSITION)	
	TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("NemesisCannonProj",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(0,360),SXF_NOCHECKPOSITION)
    TNT1 A 50 Bright
    Stop
  }
}

