	CLBA D 3 A_Explode(50,92,0,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(Random(750,1000),256,0,1)
	TNT1 A 0 A_CustomMissile("NemesisCannonShotExplosionPlayer")
	TNT1 A 0 A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 AAAA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("NemesisCannonProjPlayer",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(0,360),SXF_NOCHECKPOSITION)	
	TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("NemesisCannonProjPlayer",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(0,360),SXF_NOCHECKPOSITION)
    TNT1 A 50 Bright
    Stop
  }
}

Actor NemesisIonBeamTrail
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  Renderstyle Add
