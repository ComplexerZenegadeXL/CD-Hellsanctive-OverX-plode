Actor RocketLauncherGiver : CustomInventory
{
  Scale 0.8
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFRocketLauncherPickup"
  Inventory.PickupSound "weapons/pickupml"
  Tag "$CFRocketLauncher"
  States
  {
  Spawn:
    LAUN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	LAUN A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",67,20,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFRocketLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("HomingRocketLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",56)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("RocketDrum",Random(3,7))
	TNT1 A 0 A_GiveInventory("Missile",2)
	Stop
  }
}

Actor RocketLauncherSpawnerGiver : RocketLauncherGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("CFRocketLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("HomingRocketLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("CFRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",56)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("RocketLauncherGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("RocketLauncherGiverCheck",1)
	TNT1 A 0 A_GiveInventory("RocketDrum",Random(3,7))
	TNT1 A 0 A_GiveInventory("Missile",2)
	Stop
  }
}

Actor RocketLauncherGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor CFRocketLauncher : Weapon replaces RocketLauncher
{
  Radius 20 
  Height 16
  Scale 0.8
  Weapon.PreferredSkin "RocketLauncher-Marine"
  Inventory.PickupMessage "$CFRocketLauncherPickup"
  Inventory.PickupSound "weapons/pickupml"
  Weapon.Kickback 100
  Weapon.AmmoType "RocketDrum"
  Weapon.AmmoType2 "Missile"
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 1.0
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFRocketLauncher"
  States
  {
  Spawn:
    LAUN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	LAUN A -1
    Stop
  Ready:
	TNT1 A 0 A_PlayWeaponSound("weapons/pickupml")
	MISU ABCDE 1
  ReadyLoop:
    MISG A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Deselect:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	MISG A 1 A_Lower
    Loop
  Select:
	TNT1 A 0 A_Raise
    Wait
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
    TNT1 A 0 A_Light1 
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
    MISF AB 1 Bright
	MISF C 1 Bright A_Light2
    MISF D 1 Bright A_FireCustomMissile("NewRocket")
	MISF E 2 A_Light0
	MISF FGHI 1
	MISF J 3 A_PlaySound("rocket/drumspin")
	MISF K 3
	MISG A 4
	TNT1 A 0 A_ReFire
    Goto ReadyLoop
  FireSpread:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
    TNT1 A 0 A_Light1 
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
    MISF AB 1 Bright
	MISF C 1 Bright A_Light2
    MISF D 1 Bright A_FireCustomMissile("NewRocket")
	TNT1 A 0 A_FireCustomMissile("NewRocket",15.0,0)
	TNT1 A 0 A_FireCustomMissile("NewRocket",-15.0,0)
	MISF E 2 A_Light0
	MISF FGHI 1
	MISF J 3 A_PlaySound("rocket/drumspin")
	MISF K 3
	MISG A 4
	TNT1 A 0 A_ReFire
    Goto ReadyLoop  
  Empty:
    MISG A 4 A_PlayWeaponSound("weapons/click4")
	MISF JK 3
  Reload:
  	TNT1 A 0 A_JumpIfInventory("RocketDrum",7,"ReadyLoop")
    TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("RocketDrum",1,"MaxReload")
	MISR A 2 A_PlaySound("weapons/rocketdrumin")
	MISR B 2
	MISR C 2 A_FireCustomMissile("RocketEmptyDrumSpawner", 0, 0, 0, 1)
	MISR DE 2
	MISR F 8
	MISR GH 2
	MISR I 3
	MISR J 5
	MISR KL 2
	MISR M 1
	MISF J 5 A_PlaySound("rocket/drumspin")
	MISF K 3
	MISG A 2
	TNT1 A 0 A_JumpIfInventory("Missile",1,"ActualReload")
  ActualReload:
	TNT1 A 0 A_TakeInventory("Missile",1)
	TNT1 A 0 A_GiveInventory("RocketDrum",1)
	TNT1 A 0 A_JumpIfInventory("RocketDrum",6,2)
	TNT1 A 0 A_JumpIfInventory("Missile",1,"ActualReload")
	TNT1 A 0
	Goto ReadyLoop
  MaxReload:
	MISR A 2 A_PlayWeaponSound("weapons/rocketdrumin")
	MISR B 2
	MISR C 2 A_FireCustomMissile("RocketEmptyDrumSpawner", 0, 0, 0, 1)
	MISR DE 2
	MISR F 8
	MISR GH 2
	MISR I 3
	TNT1 A 0 A_JumpIfInventory("RocketDrum",1,"Reload2")	
  Reload2:
	TNT1 A 0 A_TakeInventory("Missile",1)
	TNT1 A 0 A_GiveInventory("RocketDrum",1)
	TNT1 A 0 A_JumpIfInventory("RocketDrum",7,"Full")
	TNT1 A 0 A_JumpIfInventory("Missile",1,"Reload2")	
  Full:
	MISR J 5
	MISR KL 2
	MISR M 1
	MISG A 2
	Goto ReadyLoop
  }
}

Actor RocketDrum : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 7
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 7
  Inventory.Icon "HRLKA0"
  +IGNORESKILL
}

Actor NewRocket : Rocket
{
  Speed 26
  Damage (Random(64,128)) //24
  Species "Player"
  Obituary "$CFNewRocketObit"
  SeeSound "rocket/fire"
  DamageType "Explosion"
  +THRUSPECIES
  -ROCKETTRAIL
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2)) 
    MIS2 A 1 Bright
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(128,128)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor RocketEx
{
  RenderStyle Add
  Alpha 0.85
  +CLIENTSIDEONLY
  +NOGRAVITY
  States
  {
  Spawn:
	MISL B 6 Bright
	MISL CD 5 Bright
	Stop
  }
}

Actor MissileTrail
{
  RenderStyle Translucent
  Alpha 0.5
  Scale 0.2
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 2
    PDBA ABCDEFGHIJKL 1 A_FadeOut(0.05)
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}