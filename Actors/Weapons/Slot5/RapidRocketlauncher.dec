Actor RapidRocketLauncherGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFRapidRocketLauncherPickup"
  Tag "$CFRapidRocketLauncher"
  States
  {
  Spawn:
	RRLP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	RRLP A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",14,-1,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,192)
	TNT1 A 0 A_GiveInventory("RapidRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",65)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("Missile",5)
	Stop
  }
}

Actor RapidRocketLauncherSpawnerGiver : RapidRocketLauncherGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 ACS_NamedExecuteAlways("WeaponChecker",0,192)
	TNT1 A 0 A_GiveInventory("RapidRocketLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",65)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("RapidRocketLauncherGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("RapidRocketLauncherGiverCheck",1)
	TNT1 A 0 A_GiveInventory("Missile",5)
	Stop
  }
}

Actor RapidRocketLauncherGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor RapidRocketLauncher : Weapon
{
  //$Category Weapons/CF
  //$Sprite RRLPA0
  //$Title "Rapid Rocketlauncher"
  +WEAPON.NOAUTOAIM
  +WEAPON.EXPLOSIVE
  +WEAPON.NOAUTOFIRE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Weapon.PreferredSkin "Rapid-Shotgun-Marine"
  Weapon.SelectionOrder 700
  Weapon.SlotNumber 5
  Weapon.AmmoUse 1
  Weapon.AmmoGive 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 9.0
  Weapon.AmmoType "Missile"
  Weapon.AmmoType2 "Missile"
  //Weapon.MinSelectionAmmo1 1
  Weapon.SelectionOrder 2000
  Inventory.PickupMessage "$CFRapidRocketLauncherPickup"
  Obituary "$CFRapidRocketLauncherObit"
  Tag "$CFRapidRocketLauncher"
  States
  {
  Spawn:
	RRLP A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	RRLP A -1
	Stop
  Deselect:
	RRGG A 1 A_Lower
	Loop
  Select:
	//TNT1 A 0 A_JumpIfInventory("CFLoaded",1,"SelectLoop")
	//TNT1 A 0 A_TakeInventory("RapidRocketLauncher",1)
	//Stop
  SelectLoop:
	RRGG A 1 A_Raise
	Loop
  Ready:
	RRGG A 1 A_WeaponReady
	Loop
  Fire:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"FireLessSpeed")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",6,1.0,0)
	RRGG A 0 A_GunFlash//A_Light1
	RRFG A 8 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",7,1.0,0)
	RRGG B 0 A_GunFlash//A_Light1
	RRFG B 8 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	RRGG AB 10 A_Refire
	RRGG AB 12 A_Refire
	Goto Ready
  FireLessSpeed:
	TNT1 A 0 A_JumpIfNoAmmo("EmptyLessSpeed")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpreadLessSpeed")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",6,1.0,0)
	RRGG A 0 A_GunFlash//A_Light1
	RRFG A 12 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",7,1.0,0)
	RRGG B 0 A_GunFlash//A_Light1
	RRFG B 12 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	RRGG AB 15 A_Refire("FireLessSpeed")
	RRGG AB 18 A_Refire("FireLessSpeed")
	Goto Ready
  FireSpread:
	TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",6,1.0,0)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_FireCustomMissile("RapidRocket",15.0,0,0,-3)
	TNT1 A 0 A_FireCustomMissile("RapidRocket",-15.0,0,0,-3)
	RRFG A 8 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",7,1.0,0)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_FireCustomMissile("RapidRocket",15.0,0,0,-3)
	TNT1 A 0 A_FireCustomMissile("RapidRocket",-15.0,0,0,-3)
	RRFG B 8 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	RRGG AB 10 A_Refire("Fire")
	RRGG AB 12 A_Refire("Fire")
	Goto Ready
  FireSpreadLessSpeed:
	TNT1 A 0 A_JumpIfNoAmmo("EmptyLessSpeed")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",6,1.0,0)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_FireCustomMissile("RapidRocket",15.0,0,0,-3)
	TNT1 A 0 A_FireCustomMissile("RapidRocket",-15.0,0,0,-3)
	RRFG A 12 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5,0.7)
	TNT1 A 0 A_PlaySound("MiniRocketFire",7,1.0,0)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_FireCustomMissile("RapidRocket",15.0,0,0,-3)
	TNT1 A 0 A_FireCustomMissile("RapidRocket",-15.0,0,0,-3)
	RRFG B 12 Bright A_FireCustomMissile("RapidRocket",0,TRUE,0,-3)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	RRGG AB 15 A_Refire("Fire")
	RRGG AB 18 A_Refire("Fire")
	Goto Ready
  AltFire:
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto Empty
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpread")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"AltFireLessSpeed")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	RRFG A 8 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd2
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	RRFG B 8 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd1
	TNT1 A 0 A_Refire("AltFire")
	RRGG AB 10 A_Refire("AltFire")
	RRGG AB 12 A_Refire("AltFire")
	Goto Ready
  AltFireLessSpeed:
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto EmptyLessSpeed
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"AltFireSpreadLessSpeed")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	RRFG A 12 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd2LessSpeed
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	RRFG B 12 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd1LessSpeed
	TNT1 A 0 A_Refire("AltFireLessSpeed")
	RRGG AB 15 A_Refire("AltFireLessSpeed")
	RRGG AB 18 A_Refire("AltFireLessSpeed")
	Goto Ready
  AltFireSpread:
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto Empty
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckFiringSpeed") == 1,"AltFireSpreadLessSpeed")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",-15.0,0,0,0,0,6.328125)
	RRFG A 8 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd2
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",-15.0,0,0,0,0,6.328125)
	RRFG B 8 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd1
	TNT1 A 0 A_Refire("AltFire")
	RRGG AB 10 A_Refire("AltFire")
	RRGG AB 12 A_Refire("AltFire")
	Goto Ready
  AltFireSpreadLessSpeed:
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto EmptyLessSpeed
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG A 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",-15.0,0,0,0,0,6.328125)
	RRFG A 12 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd2LessSpeed
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire",5)
	RRGG B 0 A_GunFlash//A_Light1
	TNT1 A 0 A_TakeInventory("Missile",1,TIF_NOTAKEINFINITE)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RapidGrenade",-15.0,0,0,0,0,6.328125)
	RRFG B 12 Bright A_FireCustomMissile("RapidGrenade",0,0,0,0,0,6.328125)
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_JumpIfInventory("Missile",1,1)
	Goto AltFireEnd1LessSpeed
	TNT1 A 0 A_Refire("AltFire")
	RRGG AB 15 A_Refire("AltFire")
	RRGG AB 18 A_Refire("AltFire")
	Goto Ready
  AltFireEnd1:
	RRGG AB 10 A_WeaponReady(WRF_NOFIRE)
	RRGG AB 12 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  AltFireEnd1LessSpeed:
	RRGG AB 15 A_WeaponReady(WRF_NOFIRE)
	RRGG AB 18 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  AltFireEnd2:
	RRGG BA 10 A_WeaponReady(WRF_NOFIRE)
	RRGG BA 12 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  AltFireEnd2LessSpeed:
	RRGG BA 15 A_WeaponReady(WRF_NOFIRE)
	RRGG BA 18 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  Empty:
	TNT1 A 0 A_PlayWeaponSound("weapons/click4")
	RRGG AB 10 A_WeaponReady(WRF_NOFIRE)
	RRGG AB 12 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  EmptyLessSpeed:
	TNT1 A 0 A_PlayWeaponSound("weapons/click4")
	RRGG AB 15 A_WeaponReady(WRF_NOFIRE)
	RRGG AB 18 A_WeaponReady(WRF_NOFIRE)
	Goto Ready
  Flash:
	TNT1 A 2 Bright A_Light1
	Goto LightDone
	TNT1 B 2 Bright A_Light1
	Goto LightDone
  }
}

Actor RapidRocket : NewRocket
{
  Damage (Random(50,100))
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(Random(64,128),128)
    TNT1 A 1 A_SpawnItemEx("RocketEx")
    Stop
  }
}

Actor RapidGrenade : RifleGrenade
{
  Damage (Random(50,100))
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(Random(64,128),128)
    TNT1 A 1 A_SpawnItemEx("RocketEx")
    Stop	
  }
}