Actor GrenadeLauncherGiver : CustomInventory
{
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFGrenadeLauncherPickup"
  Inventory.PickupSound "Weapons/GrenadePickup"
  Tag "$CFGrenadeLauncher"
  States
  {
  Spawn:
    GRLN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	GRLN A -1
    Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("WeaponCheck",72,21,3) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("GrenadeLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("GrenadeLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",59)
  JustAmmo:
	TNT1 A 0 A_GiveInventory("GrenadeDrum",Random(3,7))
	TNT1 A 0 A_GiveInventory("Missile",2)
	Stop
  }
}

Actor GrenadeLauncherSpawnerGiver : GrenadeLauncherGiver
{
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIfInventory("GrenadeLauncher",1,"JustAmmo")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",5) == 0,"All")
	TNT1 A 0 A_JumpIfInventory("RapidRocketLauncher",1,"JustAmmo")
  All:
	TNT1 A 0 A_GiveInventory("GrenadeLauncher",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",59)
  JustAmmo:
    TNT1 A 0 A_JumpIfInventory("GrenadeLauncherGiverCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("GrenadeLauncherGiverCheck",1)
	TNT1 A 0 A_GiveInventory("GrenadeDrum",Random(3,7))
	TNT1 A 0 A_GiveInventory("Missile",2)
	Stop
  }
}

Actor GrenadeLauncherGiverCheck : Inventory { Inventory.InterHubAmount 0 }

Actor GrenadeLauncher : Weapon 19348
{
  Weapon.PreferredSkin "GrenadeLauncher-Marine"
  Weapon.AmmoType "GrenadeDrum"
  Weapon.AmmoType2 "Missile"
  Weapon.AmmoGive 0
  Weapon.AmmoGive2 0
  Weapon.SlotNumber 5
  Weapon.SlotPriority 2.0
  Weapon.AmmoUse 1
  Inventory.PickupMessage "$CFGrenadeLauncherPickup"
  Inventory.PickupSound "Weapons/GrenadePickup"
  Weapon.SelectionOrder 5150
  Weapon.Kickback 100
  //Weapon.MinSelectionAmmo1 1
  //Weapon.MinSelectionAmmo2 1
  Weapon.SelectionOrder 3000
  +WEAPON.NOAUTOAIM
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.NOALERT
  Tag "$CFGrenadeLauncher"
  States
  {
  Spawn:
    GRLN A 0 NoDelay ACS_NamedExecuteWithResult("WeaponListCheck",5,0)
	GRLN A -1
    Stop
  Deselect:
  	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	TNT1 A 0 A_PlayWeaponSound("weapons/weapondown")
  DeselectLoop:
	GREN A 1 A_Lower
    Loop
  Select:
	TNT1 A 0 A_Raise
    Wait
  Ready:
    TNT1 A 0 A_PlayWeaponSound("Weapons/GrenadePickup")
	GRUP ABCDE 1
  ReadyLoop:
    GREN A 1 A_WeaponReady(WRF_ALLOWRELOAD)
    Goto ReadyLoop
  Fire:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_JumpIfInventory("PowerSpreadRune",1,"FireSpread")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
    TNT1 A 0 A_Light1 
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    GREF BC 1 Bright
	GREF D 1 Bright A_Light2
    GREF E 1 Bright A_FireCustomMissile("RifleGrenade",0,TRUE,0,0,0,6.328125)
	TNT1 A 0 A_Light0
	GREF FGH 3
	GRER PQR 2
	GREN A 1
	TNT1 A 0 A_ReFire
    Goto ReadyLoop
  FireSpread:
    TNT1 A 0 A_JumpIfNoAmmo("Empty")
	TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_GunFlash
    TNT1 A 0 A_Light1 
	TNT1 A 0 Radius_Quake(4,3,0,1,0)
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    GREF BC 1 Bright
	GREF D 1 Bright A_Light2
    GREF E 1 Bright A_FireCustomMissile("RifleGrenade",0,TRUE,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RifleGrenade",15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_FireCustomMissile("RifleGrenade",-15.0,0,0,0,0,6.328125)
	TNT1 A 0 A_Light0
	GREF FGH 3
	GRER PQR 2
	GREN A 1
	TNT1 A 0 A_ReFire
    Goto ReadyLoop
  Empty:
    GREN A 4 A_PlayWeaponSound("weapons/click4")
	GRER PQR 2
  Reload:
  	TNT1 A 0 A_JumpIfInventory("GrenadeDrum",7,2)
    TNT1 A 0 A_JumpIfInventory("Missile",1,2)
    TNT1 A 0
    Goto ReadyLoop
	TNT1 A 0 A_JumpIfInventory("GrenadeDrum",1,"MaxReload")
	GRER A 2 A_PlayWeaponSound("Weapons/GrenadeReload")
	GRER B 2
	GRER C 2 A_FireCustomMissile("RocketEmptyDrumSpawner", 0, 0, 0, 1)
	GRER DE 2
	GREE A 8 
	GRER FG 1
	GRER HJK 2
	GRER L 5
	GRER MN 3
	GRER O 3 A_PlaySound("Weapons/GrenadeCycle")	
	GRER PQR 2
	GREN A 5	
	TNT1 A 0 A_JumpIfInventory("Missile",1,"ActualReload")
  ActualReload:
	TNT1 A 0 A_TakeInventory("Missile",1)
	TNT1 A 0 A_GiveInventory("GrenadeDrum",1)
	TNT1 A 0 A_JumpIfInventory("GrenadeDrum",6,2)
	TNT1 A 0 A_JumpIfInventory("Missile",1,"ActualReload")
	TNT1 A 0
	Goto ReadyLoop
  MaxReload:
	GRER A 2 A_PlayWeaponSound("Weapons/GrenadeReload")
	GRER B 2
	GRER C 2 A_FireCustomMissile("RocketEmptyDrumSpawner", 0, 0, 0, 1)
	GRER DE 2
	GREE A 8
	GRER FG 1
	GRER HJK 2
	GRER L 5
	GRER MNO 3
	TNT1 A 0 A_JumpIfInventory("GrenadeDrum",1,"Reload2")	
  Reload2:
	TNT1 A 0 A_TakeInventory("Missile",1)
	TNT1 A 0 A_GiveInventory("GrenadeDrum",1)
	TNT1 A 0 A_JumpIfInventory("GrenadeDrum",7,"Full")
	TNT1 A 0 A_JumpIfInventory("Missile",1,"Reload2")	
  Full:
	GREN A 5
	Goto ReadyLoop
  }
}

Actor GrenadeDrum : Ammo
{
  Inventory.Amount 0
  Inventory.MaxAmount 7
  Ammo.BackpackAmount 0
  Ammo.BackpackMaxAmount 7
  Inventory.Icon "HDGLA0"
  +IGNORESKILL
}

Actor RifleGrenade
{
  Radius 6
  Height 6
  Speed 30
  Damage (Random(64,128)) //24
  Species "Player"
  Scale 0.75
  Projectile
  +DONTSPLASH
  +THRUSPECIES
  +DOOMBOUNCE
  +CANBOUNCEWATER
  -NOGRAVITY
  -GRENADETRAIL
  -ROCKETTRAIL
  Gravity 0.4
  WallBounceFactor 0.25
  BounceFactor 0.36
  Obituary "$CFRifleGrenadeObit"
  SeeSound "Weapons/GrenadeBounce"
  DeathSound "Weapons/RockLX"
  DamageType "Explosion"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_StopSound
  SpawnLoop:
    GRND A 1 A_CustomMissile("GrenadeTrail",frandom(-1,1),frandom(-1,1))     		
    Loop
  Death:
  	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(128,128)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop	
  }
}

Actor GrenTrail : MissileTrail { Scale 0.075 }
Actor GrenadeTrail : MissileTrail { Scale 0.075 }