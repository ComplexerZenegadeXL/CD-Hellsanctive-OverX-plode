//=========
// Barrels
//=========

Actor ModdedExplosiveBarrel : ExplosiveBarrel
{
  +PUSHABLE
  //+ISMONSTER
  Tag "$CFExplosiveBarrel"
  States
  {
  Death:
    BEXP A 5 Bright
    BEXP B 5 Bright A_Scream
    BEXP C 4 Bright
	TNT1 A 0 A_SetTranslucent(0.75,1)
    BEXP D 3 Bright A_Explode
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile ("Kaboom3", frandom(10,30), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,180))
	TNT1 AAA 0 A_CustomMissile ("SmokeFX2", frandom(10,30), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,180))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    BEXP E 3 Bright A_Fall
	BEXP FG 3 Bright
	TNT1 A 0 A_SetTranslucent(1.0,0)
	BEXP H 500
	BEXP H 5 A_FadeOut(0.10)
	Wait
  }
}

Actor ModdedBurningBarrel : BurningBarrel replaces BurningBarrel
{
  Scale 0.5
  States
  {
  Spawn:
    BURB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("LightingEffects",0,4,30)
  SpawnLoop:
	BURB ABCDEFGHIJKLM 2 Bright
    Loop
  }
}

//=========
// Corpses
//=========

Actor PlasmaGunnerCorpse replaces DeadZombieMan
{
  States
  {
  Spawn:
	ZMAY L -1
	Stop
  }
}

Actor ShotgunZombieCorpse replaces DeadShotgunGuy
{
  States
  {
  Spawn:
	ZSP1 L -1
	Stop
  }
}

Actor ImpCorpse replaces DeadDoomImp
{
  States
  {
  Spawn:
	SIMP M -1
	Stop
  }
}

Actor BullFiendCorpse replaces DeadDemon
{
  States
  {
  Spawn:
	SAR2 N -1
	Stop
  }
}

Actor CacodemonCorpse replaces DeadCacodemon
{
  States
  {
  Spawn:
	CALI S -1
	Stop
  }
}
