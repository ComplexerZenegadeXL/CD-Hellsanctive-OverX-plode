{
  Scale 0.5
  +FORCEYBILLBOARD
  States
  {
  Spawn:
	CAND A 0
	TNT1 A 0 ACS_NamedExecuteAlways("LightingEffects",0,3,15)
  SpawnLoop:
	CAND ABCDEFGHIJKLM 2 Bright
	Loop
  }
}

