//=======
// Lamps
//=======

Actor FancyColumn : Column replaces Column
{
  +FORCEYBILLBOARD
  States
  {
  Spawn:
	COLU A 0
	TNT1 A 0 ACS_NamedExecuteAlways("LightingEffects",0,0,40)
  SpawnLoop:
	COLU A 2 Bright
	Loop
  }
}

Actor FancyTechLamp1 : TechLamp replaces TechLamp
{
  +FORCEYBILLBOARD
  States
  {
  Spawn:
	TLMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("LightingEffects",0,1,68)
  SpawnLoop:
	TLMP ABCD 2 Bright
	Loop
  }
}

Actor FancyTechLamp2 : TechLamp2 replaces TechLamp2
{
  +FORCEYBILLBOARD
  States
  {
  Spawn:
	TLP2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("LightingEffects",0,2,56)
  SpawnLoop:
	TLP2 ABCD 2 Bright
	Loop
  }
}

