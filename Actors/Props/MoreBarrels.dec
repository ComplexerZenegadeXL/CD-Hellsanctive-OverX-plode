}

Actor BarrelBlackHoleFlame : PBlackHoleFlame { Species "Cybers" DamageType "T3rm" }

Actor BarrelBlackHoleShockwave : PBlackHoleShockwave
{
  Species "Cybers"
  DamageType "T3rm"
  States
  {
  Spawn:
	TNT1 A 0
