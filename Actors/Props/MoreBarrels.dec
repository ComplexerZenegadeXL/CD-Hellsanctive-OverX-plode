Actor OilBarrel : ModdedExplosiveBarrel
{
  Obituary "%o was set ablaze by a combustible barrel of oil."
  Tag "$CFOilBarrel"
  States
  {
  Spawn:
    OILD A 6
    Loop
  Death:
    OILD A 5 Bright
    OILD B 5 Bright A_Scream
    OILD C 4 Bright
	TNT1 A 0 A_SetTranslucent(0.75,1)
    OILD D 3 Bright A_Explode
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile ("Kaboom3", frandom(10,30), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,180))
	TNT1 AAA 0 A_CustomMissile ("SmokeFX2", frandom(10,30), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,180))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,frandom(20,40),frandom(-4,4),Random(-4,4),frandom(4,8),0,128)
	TNT1 AAA 0 A_SpawnItemEx("MolochFlamethrowerShot",0,0,frandom(10,32),frandom(0,2),frandom(0,2),2,frandom(0,360),SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
    OILD E 3 Bright A_Fall
	OILD FG 3 Bright
	TNT1 A 0 A_SetTranslucent(1.0,0)
	OILD H 500
	OILD H 5 A_FadeOut(0.10)
	Goto Death+24
  }
}

Actor TechBarrel : ModdedExplosiveBarrel
{
  DeathSound "BFG9K/Explode"
  Obituary "%o was vaporized by a tech barrel."
  Tag "$CFTechBarrel"
  States
  {
  Spawn:
    BART A 6
    Loop
  Death:
    TNT1 A 0 A_Scream
    TNT1 A 0 A_Explode(150, 256)
    TNT1 A 1 A_SpawnItemEx("TechBarrelExplosion",0,0,32)
    Stop
  }
}

Actor TechBarrelExplosion
{
  Radius 1
  Height 1
  Projectile
  RenderStyle Add
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +FORCERADIUSDMG
  +BRIGHT
  Alpha 0.8
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom11", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE3 AB 8 Bright A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BFE3 CDEF 8 Bright
    Stop 
  }
}

Actor DemonTechBarrel : ModdedExplosiveBarrel
{
  DeathSound "weapons/dtech10kexplode"
  Obituary "%o was vaporized by a tech barrel."
  Tag "$CFDemonTechBarrel"
  States
  {
  Spawn:
    BART B 6
    Loop
  Death:
    TNT1 A 0 A_Scream
	TNT1 A 0 A_Explode(260,300)
    TNT1 A 4 A_SpawnItemEx("DemonTechBarrelExplosion",0,0,32)
	TNT1 A 1 A_Explode(260,300)
    Stop
  }
}

Actor DemonTechBarrelExplosion
{
  Radius 1
  Height 1
  Projectile
  RenderStyle Add
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +FORCERADIUSDMG
  +BRIGHT
  Alpha 0.8
  States
  {
  Spawn:
  Death:
    TNT1 AAAAAA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, frandom(15,35), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX", frandom(15,35), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAA 0 A_CustomMissile("Kaboom11",frandom(15,35),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItem("PlayerDTBFGEx",0,-10)
	TNT1 A 0 Radius_Quake(20,8,0,12,0)
    BFE3 AB 4 Bright
	BFE3 CDEF 5 Bright
    Stop 
  }
}

Actor DevastatorBarrel : ModdedExplosiveBarrel
{
  DeathSound " "
  Obituary "%o was vaporized by a tech barrel."
  Tag "$CFDevastatorBarrel"
  States
  {
  Spawn:
    BART C 6
    Loop
  Death:
    TNT1 A 0 A_Scream
	TNT1 A 0 A_Explode(128,1024,0)
	TNT1 A 0 A_Explode(460,640,XF_NOTMISSILE)
	TNT1 A 0 A_Explode(618,256,XF_NOTMISSILE)
    TNT1 A 1 A_SpawnItemEx("DevastatorTechBarrelExplosion",0,0,32)
    Stop
  }
}

Actor DevastatorTechBarrelExplosion
{
  Radius 1
  Height 1
  Projectile
  RenderStyle Add
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +FORCERADIUSDMG
  +BRIGHT
  Alpha 0.8
  var int user_loop;
  States
  {
  Spawn:
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode",6)
	TNT1 A 0 A_SpawnItemEx("DevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0,0)
	TNT1 A 0 A_SpawnItem("RedDTBFGEx",0,-10)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("FusionDevastatorBall2",0,0,18 * user_loop,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	CRE9 AAAAAABBBBBBCCCCCCDDDDDD 1 Bright A_CustomMissile("KaboomDevastator22",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	CRE9 EF 6 Bright
	TNT1 A 35
    Stop 
  }
}

Actor NemesisBarrel : ModdedExplosiveBarrel
{
  Scale 1.2
  +FORCERADIUSDMG
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "PlayerNemesisPlasma", 0.0
  DamageFactor "PlayerNemesisBFG", 0.0
  Tag "$CFNemesisBarrel"
  States
  {
  Spawn:
	LB0R AABB 4 Bright A_SpawnItem("NemesisHellionSmokeSpawner",0,0,0,0)
	Loop
  Death:
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_PlaySound("Black/Blast",6,1.0,0)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleSpawn",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	TNT1 A 1 A_SpawnItemEx("PBlackHoleSpawnDark",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor BarrelBlackHoleSpawn : PBlackHoleSpawn
{
  Species "Cybers"
  DamageType "T3rm"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PBlackHoleSound",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Quake(7,24,0,4096,"none")
	TNT1 A 0 A_SpawnItemEx("PBlackStruck",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VOIP ABCDEFGHIJKL 2 //A_SetScale(ScaleX +0.8, ScaleY +0.8) //19.2 in total
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleDamager",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS/SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleSucker",0,0,1,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	//Effects
	TNT1 A 0 A_SpawnItemEx("PBlackHoleNormal",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackHoleDark",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackHoleRingSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackFadeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackBlackFadeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackLightningSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VOIP A 1
	Stop
  }
}

Actor BarrelBlackHoleDamager : PBlackHoleDamager
{ 
  Species "Cybers"
  DamageType "T3rm"
  States
  {
  Death:
 	TNT1 A 1 A_SpawnItemEx("BarrelBlackDeathSequence",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	Stop
  }
}

Actor BarrelBlackHoleSucker : PBlackHoleSucker {  Species "Cybers" DamageType "T3rm" }

Actor BarrelBlackDeathSequence : PBlackDeathSequence
{
  Species "Cybers"
  DamageType "T3rm"
  States 
  { 
  Death:
	TNT1 A 0 A_Quake(7,70,0,12258,"none")
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleChunkSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleChunkSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BarrelBlackHoleExplode",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	//Effects
	TNT1 A 0 A_SpawnItemEx("PBlackHoleGiantRingSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	VORX ABCDEFGHIJKL 1
	TNT1 A 0 A_SpawnItemEx("PBlackHoleAfterShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("PBlackHoleExploFlare",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 60 A_SpawnItemEx("PBlackHoleAfterExplode",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  } 
}

Actor BarrelBlackHoleChunkSpawner : PBlackHoleChunkSpawner
{
  Species "Cybers"
  DamageType "T3rm"
  States
  {
  Spawn:
	TNT1 A 1 A_Jump(96,1)
	Loop
	TNT1 A 1 A_SpawnItemEx("BarrelBlackHoleChunk",frandom(-256,256),frandom(-256,256),frandom(0,128),frandom(3.0,10.0),0,frandom(15.0,20.0),frandom(0.0,360.0),SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	Stop
  }
}

Actor BarrelBlackHoleChunk : PBlackHoleChunk { Species "Cybers" DamageType "T3rm" }

