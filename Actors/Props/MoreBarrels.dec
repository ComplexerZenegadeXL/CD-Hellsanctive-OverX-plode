	TNT1 A 1
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BarrelBlackHoleFlame",frandom(-32,32),frandom(-32,32),frandom(-32,32),frandom(8.0,9.0),frandom(8.0,9.0),frandom(-0.1,0.1),frandom(0.0,360.0),SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	TNT1 A 1
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BarrelBlackHoleFlame",frandom(-32,32),frandom(-32,32),frandom(-32,32),frandom(8.0,9.0),frandom(8.0,9.0),frandom(-0.1,0.1),frandom(0.0,360.0),SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	TNT1 A 1
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BarrelBlackHoleFlame",frandom(-32,32),frandom(-32,32),frandom(-32,32),frandom(8.0,9.0),frandom(8.0,9.0),frandom(-0.1,0.1),frandom(0.0,360.0),SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	TNT1 A 1
