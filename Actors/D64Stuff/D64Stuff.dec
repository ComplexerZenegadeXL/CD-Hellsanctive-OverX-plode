Actor D64Artifact1 : CustomInventory
{
  Inventory.PickupMessage ""
  RenderStyle Translucent
  +DONTGIB
  +INVENTORY.UNDROPPABLE
  +INVENTORY.PERSISTENTPOWER
  +INVENTORY.HUBPOWER
  -INVENTORY.INVBAR
  States
  {
  Spawn:
	TNT1 A 0
	ART1 ABCDE 5
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("D64Artifact1",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("D64Arti",0,1)
	Stop
  Use:
	TNT1 A 1
	Fail
  }
}

Actor D64Artifact2 : D64Artifact1
{
  States
  {
  Spawn:
	TNT1 A 0
	ART2 ABCDE 5
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("D64Artifact2",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("D64Arti",0,2)
	Stop
  }
}

Actor D64Artifact3 :  D64Artifact1
{
  States
  {
  Spawn:
	TNT1 A 0
	ART3 ABCDE 5
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("D64Artifact3",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("D64Arti",0,3)
	Stop
  }
}

Actor ttkD64Barrel : ExplosiveBarrel 
{
  Health 20
  Radius 20
  Height 50
  Scale 0.7
  DeathHeight 50
  +SOLID
  Monster
  -COUNTKILL
  Tag "$CFD64Barrel"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("IsCFPlayer",1)
  SpawnLoop:
	64R1 AB 6
	Loop
  Death:
	TNT1 A 0 ACS_NamedExecuteAlways("D64ArtiSpawner",0,1)
 	64XP ABC 5
	64XP D 5 A_Scream
	64XP E 0 A_NoBlocking
	64XP E 0 A_ChangeFlag("SOLID", FALSE)
	64XP E 0 A_PlaySound("D64/Barrel", 0)
	64XP E 0 A_SpawnItemEx("ttkD64BarrelExplosion", 0, 0, 25, 0, 0, 0, 0, 0)
	64XP E 5 
	64XP E 7 A_SetTranslucent(0.0)
	64XP E 9
	64XP FGHI 6
	Stop
  }
}

Actor ttkD64BarrelExplosion
{
  Scale 0.7
  RenderStyle Translucent
  Alpha 0.60
  Damage 0
  +NOINTERACTION
  +NOBLOCKMAP
  +RANDOMIZE
  -SOLID
  States
  {
  Spawn:
	MISL B 0
	MISL B 8 Bright
	MISL C 6 Bright A_FadeOut(0.12)
	MISL DEF 3 Bright A_FadeOut(0.12)
	Stop
  }
}

Actor ttkD64BTorch
{
  Radius 15
  Height 73
  Monster
  Scale 0.8
  Health 20
  RenderStyle Translucent
  Alpha 1.0
  +SOLID
  +NOBLOOD
  -COUNTKILL
  Tag "$ttkD64BTorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("IsCFPlayer",1)
  SpawnLoop:
	64BT ABCDE 4
	Loop
  Death:
	TNT1 A 0 ACS_NamedExecuteAlways("D64ArtiSpawner",0,2)
	TNT1 A 0 A_Playsound("skeleton/attack")
	64BT FGHIJKLMNO 5
	Stop
  }
}

