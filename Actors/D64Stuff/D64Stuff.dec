Actor GreenTorchSpawner replaces GreenTorch
{
  States
  {
  Spawn:
	TNT1 A 0
	TTRG A 4
	"####" "#" 0 ACS_NamedExecuteWithResult("CFTorchSpawner",1)
  SpawnLoop:
    "####" "#" 1
	Wait
  }
}

