Actor HSBFG10KGhost
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +BRIGHT
  Renderstyle Translucent
  Alpha 0.75
  Scale 0.65
  States
  {
  Spawn:
    HFP3 A 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    HFP3 A 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    HFP3 A 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    HFP3 B 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    HFP3 B 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    HFP3 B 1 A_SetScale(ScaleX-0.06)
    TNT1 A 0 A_FadeOut(0.08)
    Loop
  }
}

