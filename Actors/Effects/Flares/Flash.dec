// Base white flare
Actor LCABaseFlashFlare : LCABaseFlare
{
  Scale 0.5
  RenderStyle Add
  States
  {
  Spawn:
    X055 AAAAAAAAAA 1 Bright A_FadeOut(0.1)
    Stop
  }
}

Actor LCABaseFlashFlare4 : LCABaseFlashFlare { Scale 0.4 }
Actor LCABaseFlashFlare3 : LCABaseFlashFlare { Scale 0.3 }
