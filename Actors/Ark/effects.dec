Actor BlueCyberRail : FastProjectile
{
  Radius 6
  Height 6
  Speed 300
  Damage (Random(60,80))
  Scale 1.26
  DeathSound "CyberRail/Hit"
  MissileType "BlueCyberRailTrail"
  Species "Cybers"
  +RIPPER
  +THRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 1	
	Stop
  }
}

Actor BlueCyberRailTrail
{
  Scale 1
  RenderStyle Add
  +NOCLIP
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +THRUACTORS
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	BCRL ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04,1)
	Stop
  }
}
Actor LaserBeam : FastProjectile
{
  Radius 1
  Height 1
  Scale 1.0
  Speed 200
  Renderstyle Add
  Decal DoomImpScorch
  Damage 15
  +RIPPER
  -CANNOTPUSH
  -NODAMAGETHRUST
  +THRUSPECIES
  +NOEXTREMEDEATH
  SeeSound ""
  States
  {
  Spawn:
	TNT1 A 0
	//TNT1 A 0 A_PlaySound("Laser/Beam", CHAN_AUTO|CHAN_NOPAUSE)
	TRC5 A 1 Bright
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 Radius_Quake(6,6,0,12,0)
	TNT1 A 0 A_Explode(32,64,0,False,32)
	TNT1 A 0 A_SpawnItemEx("T3BlueLaserFlare")
	T3FS ABCDEFGHIJKLMNOP 2 Bright A_FadeOut(0.06,1)
	Stop
  }
}

Actor T3BlueLaserFlare : T3BaseEffect
{
  Scale 0.5
  Renderstyle Add
  Alpha 1.0
  States
  {
  Spawn:
	TNT1 A 0
	B3FL A 2 Bright
  Continuous:
	B3FL A 1 Bright A_FadeOut(0.05,1)
	Loop
  }
}
