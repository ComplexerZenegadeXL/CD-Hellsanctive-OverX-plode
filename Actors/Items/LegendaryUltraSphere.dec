Actor LegendaryUltraSphere : CustomInventory //16703
{
  //$Category Powerups/LCA
  //$Sprite LLDSA0
  //$Title "Legendary UltraSphere"
  Inventory.PickupSound "legmegasphere/pickup"
  Inventory.PickupMessage "$CFLegendaryUltraSpherePickup"
  //+FLOATBOB
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  -INVENTORY.ALWAYSPICKUP
  -FLOAT
  +NOTIMEFREEZE
  ActiveSound "legendarymegasphere/idle"
  Tag "$CFLegendaryUltraSphere"
  States
  {
  Spawn:
    LLDS A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,13,20)
	TNT1 A 0 A_LoopActiveSound
  SpawnLoop:
	LLDS ABCDCB 10 Bright
	Loop
  Pickup:
    TNT1 A 0 A_GiveInventory("LegendarySphereHealth", 1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,2)
    TNT1 A 0 A_GiveInventory("LegendaryArmor", 1)
	TNT1 AA 0 A_GiveInventory("LegendaryCombatpack", 1)
	TNT1 A 1 A_StopSound
	Stop
  }
}