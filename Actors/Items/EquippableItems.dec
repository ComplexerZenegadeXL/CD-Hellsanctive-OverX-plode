Actor PhaseGreaves : CustomInventory
{
  //$Category Powerups/CF
  //$Title "PhaseGreaves"
  Scale 0.25
  +NOTIMEFREEZE
  Inventory.PickupMessage "$CFPhaseGreavesPickup"
  States
  {
  Spawn:
	BOO3 B 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
  SpawnLoop:
	BOO3 B 24 Bright A_SpawnItemEx("ItemSpark",0,0,16,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0
	Stop
  }
}

