//Rings
Actor RingOfRegeneration : CustomInventory 30414
{
  //$Category Powerups/CF
  //$Sprite RRG2A0
  //$Title "Ring Of Regeneration"
  Scale 0.5
  //+FLOATBOB
  +NOTIMEFREEZE
  Inventory.PickupMessage "$CFRingOfRegenerationPickup"
  Tag "$CFRingOfRegeneration"
  States
  {
  Spawn:
	RRG2 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,40)
  SpawnLoop:
	RRG2 BBBBCDDDDC 3 Bright
	TNT1 A 0 A_SpawnItemEx("ItemSpark",0,0,16,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0
	Stop
  }
}

Actor RingOfRegenerationQuiet : RingOfRegeneration
{
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  States
  {
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("RingOfRegenerationEquipped",1,"Null")
	TNT1 A 0 A_GiveInventory("RingOfRegenerationEquipped",1)
	TNT1 A 1 ACS_NamedExecuteAlways("CF_RingsOfRegeneration",0)
	Stop
  }
}

Actor RingOfRegenerationCheck : Inventory
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
}

Actor RingOfRegeneration2Check : RingOfRegenerationCheck {}

