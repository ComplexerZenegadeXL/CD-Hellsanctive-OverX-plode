Actor NemesisJewel : CustomInventory
{
  //$Category Powerups/CF
  //$Title "NemesisJewel"
  Scale 0.25
  +NOTIMEFREEZE
  Inventory.PickupMessage "$CFNemesisJewelPickup"
  States
  {
  Spawn:
	ARR6 B 0
