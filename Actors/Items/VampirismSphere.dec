Actor VampirismSphere : CustomInventory 17750
{
  //$Category Powerups/CF
  //$Sprite VAMPA0
  //$Title "Vampirism Sphere"
  +COUNTITEM
  //+FLOATBOB
  -FLOAT
  +INVENTORY.AUTOACTIVATE
  //+INVENTORY.ALWAYSPICKUP
  +INVENTORY.BIGPOWERUP
  Inventory.MaxAmount 0
  Inventory.PickupMessage "$CFVampirismSpherePickup"
  Inventory.PickupSound "Powerup/Terror"
  States
  {
  Spawn:
    VAMP A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,17,18)
  SpawnLoop:
    VAMP ABCD 6 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("NemesisCheck") == 1,"Null")
	TNT1 A 0 A_GiveInventory("VampireDrain",1)
	Stop
  }
}

Actor VampireDrain : PowerDamage //PowerDrain
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  Powerup.Duration -30
  DamageFactor "Normal", 1.0
  Powerup.Color "Red" 0.25
}

Actor FakeVampireDrain : PowerDamage
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  DamageType "notarealdamagetype"
  Powerup.Duration -30
  Powerup.Color "Red" 0.25
}

Actor VampireToken : Inventory {}