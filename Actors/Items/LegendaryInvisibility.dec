Actor LegendaryInvisibilitySphere : CustomInventory
{
  Inventory.PickupMessage "$CFLegendaryInvisibilitySpherePickup"
  Inventory.PickupSound "legendarycrystal/take"
  Inventory.UseSound "Powerup/Terror"
  Inventory.Icon "LINVH0"
  Tag "$CFLegendaryInvisibilitySphere"
  Renderstyle Add
  +INVBAR
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  States
  {
  Spawn:
	LINV A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,13,20)
  SpawnLoop:
	LINV ABCDEFG 3 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PowerLegendaryInvisibility",1,"Null")
	TNT1 A 0 A_GiveInventory("PowerLegendarySpooker",1)	
	TNT1 A 0 A_GiveInventory("PowerLegendaryInvisibility",1)	
	TNT1 A 1 ACS_NamedExecuteAlways("LegendaryInvisibility",0)
    Stop
  }
}

Actor LegendaryInvisibilitySphereQuiet : LegendaryInvisibilitySphere
{
  -INVBAR
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.QUIET
  States
  {
  Pickup:
    TNT1 A 0
	TNT1 A 0 A_GiveInventory("PowerLegendarySpooker",1)	
	TNT1 A 0 A_GiveInventory("PowerLegendaryInvisibility",1)	
	TNT1 A 1 ACS_NamedExecuteAlways("LegendaryInvisibility",0)
    Stop  
	}
}

Actor PowerLegendarySpooker : PowerFrightener { Powerup.Duration -30 }

Actor PowerLegendaryInvisibility : PowerupGiver
{
  +GHOST
  +CANTSEEK
  +SHADOW
  -INVENTORY.INVBAR
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Type "Invisibility"
  Powerup.Duration -30
  Powerup.Mode Fuzzy
  //Powerup.Strength 100
}