Actor HellfireUltraSphere : CustomInventory 
{
  Inventory.PickupSound "HFCyb/Laugh"
  Inventory.PickupMessage "$CFHellfireUltraSpherePickup"
  //+FLOATBOB
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  -INVENTORY.ALWAYSPICKUP
  -FLOAT
  ActiveSound "HFUl/Active"
  States
  {
  Spawn:
	HFUL A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 A_LoopActiveSound
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,43)
  SpawnLoop:
	HFUL ABCD 10 Bright
	Loop
  Pickup:
    TNT1 A 0 A_GiveInventory("HellfireSphereHealth", 1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,2)
	TNT1 A 0 A_GiveInventory("HellfireArmor", 1)
    TNT1 AA 0 A_GiveInventory("FullCombatPack", 1)
	TNT1 A 1 A_StopSound
	Stop
  }
}

Actor HellfireSphereHealth : Health
{
  Inventory.Amount 666
  Inventory.MaxAmount 666
}

Actor HellfireArmor : ArmorBase
{
  Inventory.Icon "HFARA0"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 2 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
  SpawnLoop:
	HFAR ABCDEF 5 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",40,666) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",40,666)
    Stop
  }
}

Actor HellFireArmorGiver : BasicArmorPickup
{
  Inventory.Icon "HFARA0"
  Armor.SavePercent 25
  Armor.SaveAmount 666
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "Nemesis", 0.35
  DamageFactor "Legendary", 0.3
  DamageFactor "LegendaryGuru", 0.3
  DamageFactor "BFGSplash", 0.3
  DamageFactor "BFGSpray", 0.3
  DamageFactor "Fire", 0.2
  DamageFactor "SatanGuard", 0.35
  //DamageFactor "T3rm", 0.25
}