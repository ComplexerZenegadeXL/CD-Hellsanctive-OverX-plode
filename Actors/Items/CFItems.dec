Actor ArkCombatpack: CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  Height 36
  Inventory.PickupSound "items/pack"
  Inventory.PickupMessage "$CFArkCombatpackPickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	CBPK A -1
    Stop
  Pickup:
	TNT1 A 0 ACS_NamedExecuteAlways("BackpackAmmo",0,1)
	TNT1 A 0 A_GiveInventory("HandGrenadeAmmo",1)
	TNT1 A 0 A_GiveInventory("MineAmmo",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,2)
    TNT1 A 0 A_GiveInventory("BeaconArmorBonus", 1)
    TNT1 A 0 HealThing(10,200)
    Stop
  }
}
