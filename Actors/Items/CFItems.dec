Actor CFMedikitPack : CustomInventory
{
  +INVENTORY.UNDROPPABLE
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  Inventory.Icon "CFMEDI00"
  Tag "$CFMedikitPack"
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(!ACS_NamedExecuteWithResult("GetCVar",8) & 2,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 ACS_NamedExecuteAlways("UseHealthPool",0)
	Fail
  }
}

