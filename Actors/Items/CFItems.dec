Actor BeaconArmorBonus : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  Inventory.Icon "ARSDA0"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
  SpawnLoop:
	ARSD A 6
	ARSD B 12
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorBonus",10,4,250) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmorBonus",10,4,250)
    Stop
  }
}

