Actor ItemSpawner : CustomInventory
{
  -INVENTORY.INVBAR
  var int user_item;
  States
  {
  Spawn:
	DDOL A -1
	//Goto SpawnLoop
	Stop
  SpawnLoop:
	DDOL A 1
	Loop
  Pickup:
	TNT1 A 0
	TNT1 A 0
	Stop
  Death:
    TNT1 A 0
	Stop
  Remove:
	TNT1 A 0 A_FadeOut(1)
	Stop
  }
}

Actor HealingItem : CustomInventory
{
  Scale 0.5
  var int user_playertid;
  var int user_amount;
  States
  {
  Spawn:
    BULP A -1
    Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
    TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("SetTarget")
	TNT1 A 0 A_RearrangePointers(AAPTR_TARGET, AAPTR_MASTER, AAPTR_DEFAULT)
  HeldLoop:
	TNT1 A 0 A_JumpIfInventory("HealingToken",0,"Remove")
	TNT1 A 0 A_GiveInventory("NewArmorBonus",1)
	TNT1 A 0 A_GiveInventory("HealingToken",1)
	TNT1 A 35
    Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_GetCurrentHealth",1) >=250,"Null")
    TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 
    Fail
  Remove:
    TNT1 A 0 A_TakeInventory("HealingItem",1)
	TNT1 A 0 A_TakeInventory("HealingToken",30)
	Stop
  }
}

Actor HealingToken : Inventory { Inventory.MaxAmount 30 }

Actor Marker_Boss0 : MapMarker
{
  Radius 1
  Height 1
  Speed 0
  Damage 0
  Health 2000000000
  -SHOOTABLE
