Actor CFZombieStrafing : GenericItem
{
  States
  {
  Pickup:
	TNT1 A 1 
	TNT1 A 1 A_Jump(188,2)
	TNT1 A 1 A_GiveInventory("CFZombieJumping",1)
	TNT1 A 1 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 1 A_Jump(256,2)
	TNT1 A 1 A_Jump(235,5)
	TNT1 A 1 A_JumpIfInventory("CFZombieStrafeSens",1,3)
	TNT1 A 1 A_GiveInventory("CFZombieStrafeSens",1)
	TNT1 A 1 A_Jump(256,2)
	TNT1 A 1 A_TakeInventory("CFZombieStrafeSens",1)
	TNT1 A 1 A_JumpIfInventory("CFZombieStrafeSens",1,3)
	TNT1 A 1 ThrustThing(angle*256/360+38.7,3,0,0)
	TNT1 A 1 A_Jump(256,2)
	TNT1 A 1 ThrustThing(angle*256/360+38.7,-3,0,0)
	TNT1 A 1 A_FaceTarget
	TNT1 A 1 A_Jump(24,2)
	TNT1 A 1 A_JumpIfCloser(300,2)
	TNT1 A 1 A_Recoil(-1)
	Stop
	TNT1 A 1 A_Recoil(1)
	Stop
  }
}

Actor CFZombieJumping : CFZombieStrafing
{
  +NOTIMEFREEZE
  States
  {
  Pickup:
	TNT1 A 1 
	TNT1 A 1 A_CheckFloor(1)
	Stop
	TNT1 A 1 A_Jump(242,2)
	TNT1 A 1 ThrustThingZ(0,25,0,1)
	Stop
	TNT1 A 1
	Stop
  }
}

