Actor SpringMine : CustomInventory
{
  //+INVENTORY.INVBAR
  +INVENTORY.KEEPDEPLETED
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  Inventory.MaxAmount 8
  Inventory.InterHubAmount 8
  Inventory.Icon "SPMIA0"
  Inventory.PickupSound "SMINGET"
  Inventory.PickupMessage "$CFSpringMinePickup"
  Tag "$CFSpringMine"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	SPMN ABC 2
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SpringMineCheck") == 0,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
    TNT1 A 1 A_JumpIf(ACS_NamedExecuteWithResult("InfiniteInventoryCheck") == 2,"Cheater")
	TNT1 A 1 A_JumpIfInventory("PowerInfiniteAmmo",1,2)
	TNT1 A 0 A_ThrowGrenade("SpringMineSet",1,9,3,0) //A_FireCustomMissile("SpringMineSet",0,0,0,0,false,8)
	Stop
	TNT1 A 0 A_JumpIfInventory("SpringMineCooldown",1,3)
	TNT1 A 0 A_GiveInventory("SpringMineCooldown",1)
	TNT1 A 0 A_ThrowGrenade("SpringMineSet",1,9,3,0) //A_FireCustomMissile("SpringMineSet",0,0,0,0,false,8)
	TNT1 A 1
	Fail
  Cheater:
	TNT1 A 0 A_JumpIfInventory("CheaterSpringMineCooldown",1,3)
	TNT1 A 0 A_GiveInventory("CheaterSpringMineCooldown",1)
	TNT1 A 0 A_ThrowGrenade("SpringMineSet",1,9,3,0)  //A_FireCustomMissile("SpringMineSet",0,0,0,0,false,8)
	TNT1 A 1
	Fail
  }
}

