Actor PentagramofPower : CustomInventory
{
  //-FLOATBOB
  +INVBAR
  +FANCYPICKUPSOUND
  +INVENTORY.UNDROPPABLE
  Inventory.Icon "PNTCI0"
  Inventory.PickupSound "misc/p_pkup"
  Inventory.PickupMessage "$CFPentagramofPowerPickup"
  Scale 0.65
  Tag "$CFPentagramofPower"
  States
  {
  Spawn:
    TNT1 A 0
    Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PentagramCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PentagramOn",1,"RealUse")
	TNT1 A 0 A_JumpIfInventory("PentagramPower",10,"RealUse")
	Fail
  RealUse:
	TNT1 A 0 ACS_NamedExecuteAlways("PentagramUse",0)
	Fail
  }
}

