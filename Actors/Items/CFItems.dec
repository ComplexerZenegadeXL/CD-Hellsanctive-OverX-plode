Actor LiteBeaconSupplyPickup : CustomInventory
{
  Height 10
  Radius 10
  +INVENTORY.INVBAR
  Inventory.Icon "BELTF0"
  Inventory.PickupSound "misc/i_pkup"
  Inventory.PickupMessage "$CFLiteBeaconSupplyPickup"
  Tag "$CFLiteBeaconSupply"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:	
	BELT ABCDE 10
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 1 A_SpawnItemEx("LiteBeaconSupply",0,0,8,0,0,0,0,SXF_NOCHECKPOSITION,0)
	Stop
  }
}
