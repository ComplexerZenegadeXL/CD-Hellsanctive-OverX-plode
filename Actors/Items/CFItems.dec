Actor AnkhOfResurrection : CustomInventory
{
  Inventory.Icon "ARTIALI1"
  Inventory.PickupMessage "$CFAnkhOfResurrectionPickup"
  //+FLOATBOB
  +INVENTORY.PICKUPFLASH
  +INVENTORY.INVBAR
  Tag "$CFAnkhOfResurrection"
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("Get Port",1) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	AKOL A 1
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Get Port",1) == 1 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("AnkhOfResurrection",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",15)
    Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_GiveInventory("ScriptToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("AnkhUse",0)
	Fail
  Remove:
    TNT1 A 0 A_TakeInventory("AnkhOfResurrection",1)
	Stop
  }
}

