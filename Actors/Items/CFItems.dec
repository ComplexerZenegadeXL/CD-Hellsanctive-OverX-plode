}
Actor SpringMineSet
{
  Radius 12 //10
  Height 9 //5
  Speed 7
  +MOVEWITHSECTOR
  +MISSILE
  +DROPOFF
  +NOBLOCKMAP
  +NOTELEPORT
  +THRUACTORS
  +BOUNCEONWALLS
  +BOUNCEONFLOORS
  +BOUNCEONCEILINGS
  +ALLOWBOUNCEONACTORS
  +BOUNCEAUTOOFF
  +MBFBOUNCER
  +BOUNCEONACTORS
  +CANBOUNCEWATER
  //BounceType "Grenade"
  BounceCount 3
  Reactiontime 525
  BounceSound "MINBNC"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	SPMN A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
    TNT1 A 1 A_JumpIf(ACS_NamedExecuteWithResult("InfiniteInventoryCheck") == 2,"Cheater")
	TNT1 A 1 A_CustomMissile("SpringMineActive",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Stop
  Cheater:
	TNT1 A 1 A_CustomMissile("CheaterSpringMineActive",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Stop
  } 
}

Actor SpringMineActive
{
  Projectile
  Radius 12 //10
  Height 9 //5
  Mass 1000000
  Speed 0
  //Gravity 1.0
  WallBounceFactor 0.16
  BounceFactor 0.36
  BounceType "Grenade"
  +DROPOFF
  +FLOORCLIP
  +NOTELEPORT
  +FRIENDLY
  +NODAMAGE
  +BRIGHT
  +FORCEPAIN
  -NOGRAVITY
  +MOVEWITHSECTOR
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  +THRUACTORS
  +CANBOUNCEWATER
  +FORCEYBILLBOARD
  Species "Player"
  DamageType "Explosion"
  Obituary "%o came too close to spring mine."
  Tag "Spring Mine Planted"
  var int user_counter;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 A 0 A_PlaySound("SMNSET1")
	SPMN A 20
	TNT1 A 0 A_PlaySound("SMNSET2")
	SPMN AD 1
	//TNT1 A 0 ACS_NamedExecuteAlways("SpringMineSee",0)
  SpawnLoop:
	SPMN ADADAD 1
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND|LOF_NOJUMP,0,128,0,360,"Attack")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTarget") == 1,"Attack")
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_JumpIf(user_counter >= 1080,"Vanish")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	Loop
  Attack:
	SPMN ABC 2
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 ThrustThingZ(0,45,0,0)
	SPMN A 23 A_PlaySound("MINLNCH")
	TNT1 A 0 A_PlaySound("SPRNMNXP")
	TNT1 A 0 A_Explode(Random(250,300),288,0,192)
	TNT1 A 0 A_Explode(100,96,0)
	//TNT1 A 0 A_SpawnItemEx("SMineExplosion",0,0,5,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,0)
	TNT1 A 10 A_SpawnItemEx("WhiteProjExplodeLarge",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  Vanish:
	SPMN ADADADADADAD 1 A_FadeOut(0.1,1)
	Stop
  }
}
Actor CheaterSpringMineActive : SpringMineActive
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 A 0 A_PlaySound("SMNSET1")
	SPMN A 20
	TNT1 A 0 A_PlaySound("SMNSET2")
	SPMN AD 1
  SpawnLoop:
	SPMN ADADAD 1
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND|LOF_NOJUMP,0,100,0,360,"Attack")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTarget") == 1,"Attack")
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_JumpIf(user_counter >= 540,"Vanish")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	Loop
  Attack:
	SPMN ABC 2
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 ThrustThingZ(0,45,0,0)
	TNT1 A 0 A_PlaySound("MINLNCH")
	SPMN A 23
	TNT1 A 0 A_PlaySound("SPRNMNXP")
	TNT1 A 0 A_Explode(125,128,0,1,100)
	//TNT1 A 0 A_SpawnItemEx("SMineExplosion",0,0,5,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,0)
	TNT1 A 10 A_SpawnItemEx("WhiteProjExplodeLarge",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}
