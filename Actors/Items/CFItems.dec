Actor PowerStimpack : CustomInventory 30354
{
  Renderstyle Add
  +INVENTORY.INVBAR
  +INVENTORY.HUBPOWER
  +INVENTORY.BIGPOWERUP
  +INVENTORY.PERSISTENTPOWER
  +INVENTORY.FANCYPICKUPSOUND
  //+INVENTORY.ISHEALTH
  Inventory.MaxAmount 2
  Inventory.InterHubAmount 2
  Inventory.PickupSound "misc/p_pkup"
  Inventory.UseSound "items/powerstim"
  Inventory.PickupMessage "$CFPowerStimpackPickup"
  Inventory.Icon "ARTISTIM"
  Tag "$CFPowerStimpack"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	STMP ABCD 1 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PowerStimpackCooldown",1,"Failure")
	TNT1 A 0 A_JumpIfHealthLower(26,"Failure")
	TNT1 A 0 A_JumpIf(Health - 25 < 1,2)
	TNT1 A 0 A_GiveInventory("ScriptToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetCurrentHealth",0,Health - 25)
	TNT1 A 0 A_GiveInventory("PowerStimpackCooldown")
	TNT1 A 0 A_GiveInventory("PowerHighJumpee")
	TNT1 A 0 ACS_NamedExecuteWithResult("FiringSpeedFix",2)
	TNT1 A 0 A_GiveInventory("PowerMoveSpeedee")
	TNT1 A 0 A_GiveInventory("PowerStrength")
	TNT1 A 1 ACS_NamedExecuteAlways("CF_PowerStimpack",0)
	Stop
  Failure:
	TNT1 A 1 A_Print("Not enough health!")
	Fail
  }
}

