Actor HealingInProgress : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -4
}

Actor TerminatorItem : CustomInventory replaces Terminator
{
  Mass 1
  Gravity 1.0
  -FLOAT
  //+FLOATBOB
  -NOGRAVITY
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  +INVENTORY.BIGPOWERUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  Inventory.PickupSound "misc/p_pkup"
  Inventory.PickupMessage "$CFTerminatorItemPickup"
  Tag "$CFTerminatorItem"
  States
  {
  Spawn:
    ARNO A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,17,18)
  SpawnLoop:
    ARNO ABCD 2 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_JumpIfInventory("Terminator2Token",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TerminatorToken",1,"Upgrade")
	TNT1 A 0 HealThing(666,666)
	TNT1 A 0 ACS_NamedExecuteWithResult("TerminatorCheck",1)
	TNT1 A 0 A_GiveInventory("HellfireArmor",1)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,2)	
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 A_GiveInventory("TerminatorToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",16)
	Stop
  Upgrade:
	TNT1 A 0 HealThing(666,666)
	TNT1 A 0 ACS_NamedExecuteWithResult("TerminatorCheck",2)
	TNT1 A 0 A_GiveInventory("HellfireArmor",1)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,2)	
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 A_GiveInventory("Terminator2Token",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",17)
	Stop
  }
}

Actor FakeTerminatorSphere : TerminatorItem
{
  States
  {
    Pickup:
	TNT1 A 0 ACS_NamedExecuteAlways("GiveTerminatorSphere",0)
	Stop
  }
}

