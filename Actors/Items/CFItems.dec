Actor ShadowSlaveOrb : CustomInventory 30408
{
  Scale 0.7
  Renderstyle Add
  Alpha 1.0
  +FLOAT
  //+FLOATBOB
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  +INVENTORY.INVBAR
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
