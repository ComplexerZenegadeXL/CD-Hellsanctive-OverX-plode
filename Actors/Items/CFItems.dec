	LNEA BCDEFGHIJKLMNOPQRSTU 1 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ItemChecks") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_GiveInventory("LightNemesisArmorCooldown")
	TNT1 A 0 A_GiveInventory("LightNemesisArmorItem")
	TNT1 A 0 A_GiveInventory("LightNemesisArmorProtect")
	TNT1 A 0 ACS_NamedExecuteAlways("PowerTargetReplacer")
	Stop
  }
}

