Actor ElusiveSphere : CustomInventory 30412
{
  //+FLOATBOB
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  +INVENTORY.INVBAR
  Inventory.MaxAmount 3
  Inventory.InterHubAmount 3
  Inventory.UseSound "pickups/invulnerable"
  Inventory.PickupAnnouncerEntry "invisibility"
  Inventory.PickupMessage "$CFElusiveSpherePickup"
  Inventory.Icon "VISNI0"
  Tag "$CFElusiveSphere"
  States
  {
  Spawn:
	VISN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,10,6,101)
  SpawnLoop:
    VISN ABCD 6 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_GiveInventory("PowerInvisibility", 1)
	TNT1 A 0 A_GiveInventory("ElusiveSphereToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ElusiveSphere",0)
	TNT1 A 0 A_StopSound
	TNT1 A 0 A_CustomMissile("FakeMarineSpawner",20,0,-90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("FakeMarineSpawner2",20,0,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("FakeMarineSpawner3",20,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("FakeMarineSpawner4",20,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Stop
  }
}

