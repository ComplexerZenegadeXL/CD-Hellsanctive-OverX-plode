Actor LegendaryDemonRune : CustomInventory //16708
{
  //$Category Powerups/LCA
  //$Sprite LDRNA0
  //$Title "Legendary Demon Rune"
  Inventory.PickupMessage "$CFLegendaryDemonRunePickup"
  Inventory.PickupSound "legendarypowersphere/pickup"
  Inventory.Icon "LDRNM0"
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  ActiveSound "legdemonrune/idle"
  Tag "$CFLegendaryDemonRune"
  States
  {
  Spawn:
	LDRN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,24,21,23)
  SpawnLoop:
	LDRN ABCDEFGJHIJKL 5 Bright
	Loop	
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("LegendaryDemonRune",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",14)
	TNT1 A 0 A_StopSound
	Stop
  Use:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetClass") == 1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("GetPlayerInfo",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("SetupPlayerLegendaryRev")
	TNT1 A 0 A_GiveInventory("LegDemonRuneGiver")
	TNT1 A 0 A_PlaySound("legendaryrevenant/see", CHAN_AUTO, 1.0, False, ATTN_NONE)
	Stop   	
  }
}

Actor LegDemonRuneParticleSpawner : LegendaryRedParticleSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 1 Bright A_SpawnItemEx("ArmorParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
	Stop
  }
}

Actor LegDemonRuneGiver : PowerupGiver
{
  Powerup.Duration -80  //-79
  +INVENTORY.AUTOACTIVATE
  +NOTIMEFREEZE
  Powerup.Type "LegendaryPlayer"
}

Actor PowerLegendaryPlayer : PowerMorph
{
  +NOTIMEFREEZE
  PowerMorph.PlayerClass "Demon_LegendaryRevenant"
  PowerMorph.MorphFlash "None"
  PowerMorph.UnMorphFlash "None"
  PowerMorph.MorphStyle (MRF_FULLHEALTH|MRF_ADDSTAMINA|MRF_NEWTIDBEHAVIOUR|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_UNDOBYDEATH|MRF_UNDOBYDEATHSAVES)
}

Actor LegMissileType2 : Inventory {}
Actor LegMissileType3 : Inventory {}
Actor LegMissileType4 : Inventory {}
Actor LegMissileType5 : Inventory {}
Actor LegMissileType6 : Inventory {}
Actor LegMissileType7 : Inventory {}

Actor Demon_LegendaryRevenant : PlayerPawn
{
  Speed 1
  Mass 300
  Radius 20
  Height 56
  Health 1350
  Scale 1.1
  Player.MaxHealth 1350
  Player.ForwardMove 1.3
  Player.SideMove 1.3
  Player.JumpZ 10
  BloodColor "Blue"
  Player.SoundClass "LegRevenant"
  Player.DisplayName "Legendary Revenant"
  Player.AttackZOffset 0
  Player.DamageScreenColor "Blue", 0.1
  Player.MorphWeapon "LegendaryRevenantWeapons"
  DamageFactor "LegendaryPlayer", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor 0.5
  DamageFactor "Legendary1", 0.0
  DamageFactor "Legendary", 0.6
  DamageFactor "LegendaryGuru", 0.6
  DamageFactor "CadaverRocket", 0.0
  SeeSound "legendaryrevenant/see"
  PainSound "legendaryrevenant/pain"
  DeathSound "legendaryrevenant/death"
  ActiveSound "legendaryrevenant/idle"
  MeleeSound "skeleton/melee"
  Species "Player"
  +THRUSPECIES
  +DONTHARMSPECIES
  +NORADIUSDMG
  +NOSKIN
  +DONTRIP
  +NOPAIN
  +BOSS
  +BOSSDEATH
  +NOTIMEFREEZE
  -PICKUP
  var int user_pnum;
  var int user_armor;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SetUserVar("user_pnum",ACS_NamedExecuteWithResult("GetPlayerNumber"))
	TNT1 A 0 ACS_NamedExecuteAlways("CFCheck",0,user_pnum)
	LREV A 10 Bright
	Loop
  See:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("CFCheck",0,user_pnum)
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	LREV ABCDEF 6 Bright
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	Goto Spawn
  Missile:
	LREV J 1 Bright
	LREV J 0 A_JumpIfInventory("LegRevWeapType",7,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile7
	LREV J 0 A_JumpIfInventory("LegRevWeapType",6,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile6
	LREV J 0 A_JumpIfInventory("LegRevWeapType",5,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile5
	LRDY A 0 A_JumpIfInventory("LegRevWeapType",4,2)
	LRDY A 0 A_Jump(256,2)
	LRDY A 0
	Goto Missile4
	LREV J 0 A_JumpIfInventory("LegRevWeapType",3,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile3
	LREV J 0 A_JumpIfInventory("LegRevWeapType",2,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile1
	LREV J 0 A_JumpIfInventory("LegRevWeapType",1,2)
	LREV J 0 A_Jump(256,2)
	LREV J 0
	Goto Missile2
	LREV J 1 Bright A_Jump(256,"Missile1")
	Goto Spawn
  Missile1:
	LREV J 1 Bright
	LREV JKK 10 Bright
	Goto Spawn	
  Missile2:
	LREV J 35 Bright
	LREV K 84 Bright
	Goto Spawn
  Missile3:	
	LREV GHI 4 Bright
	Goto See	
  Missile4:
	LREV J 35 Bright
	LREV K 10 Bright
	Goto Spawn	
  Missile5:
	LREV J 80 Bright
	LREV K 10 Bright
	Goto Spawn	
  Missile6:
	LREV GH 5 Bright
	LREV I 3 Bright
	Goto Spawn	
  Missile7:
	LREV G 0
	LREV G 0 A_Jump(127,4)
	LREV GHI 2 Bright
	Goto See
	LREV RST 2 Bright
	Goto See
  Death: 
	LREV LM 7
	LREV N 7 A_Scream
	LREV O 7 A_NoBlocking
	LREV P 7
	LREV Q -1
	Stop
  }
}

