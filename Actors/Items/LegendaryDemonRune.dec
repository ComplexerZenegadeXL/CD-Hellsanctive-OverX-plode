Actor MorphedPlayerFriendMark0
{
  +FRIENDLY
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +NOCLIP
  +DORMANT
  +NOTRIGGER
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  RenderStyle "Translucent"
  Alpha 0.6
  Radius 0
  Height 0
  Speed 0
  States
  {
  Spawn:
	LDRN I 2 Bright
	Stop
  Death:
	TNT1 A 0
	Stop
  }
}

Actor MorphedWeapon : Weapon
{
  +INVENTORY.UNDROPPABLE
  +WEAPON.AMMO_OPTIONAL
  +WEAPON.ALT_AMMO_OPTIONAL
  +WEAPON.CHEATNOTWEAPON
  +WEAPON.DONTBOB
  +WEAPON.NOAUTOFIRE
  Decal "BulletChip"
  States
  {	
  Spawn:
	TNT1 A 1
	Stop
  Ready:
	TNT1 A 1 A_WeaponReady
	Goto Ready
  Select:
	TNT1 AAA 0 A_Raise
	TNT1 A 1 A_Raise
	Loop
  Deselect:
	TNT1 AAA 0 A_Lower
	TNT1 A 1 A_Lower
	Loop
  Fire:	
	TNT1 A 2
	Goto Ready
  Hold:
	TNT1 A 1
	Goto Ready
  AltFire:
	TNT1 A 1
	Goto Ready
  Flash:
	TNT1 A 1 A_Light2
	TNT1 A 2 A_Light1
	TNT1 A 1 A_Light0
	Stop
  }
}

Actor LegRevWeapType : Inventory { Inventory.MaxAmount 7 }

