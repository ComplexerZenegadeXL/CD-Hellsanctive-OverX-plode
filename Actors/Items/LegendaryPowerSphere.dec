Actor LegendaryPowerSphere : CustomInventory //16707
{
  //$Category Powerups/LCA
  //$Sprite GARDA0
  //$Title "Legendary Power Sphere"
  Inventory.PickupMessage "$CFLegendaryPowerSpherePickup"
  Inventory.PickupSound "legpowersphere/take"
  Inventory.UseSound "legpowersphere/use"
  Inventory.Icon "GARDZ0"
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Tag "$CFLegendaryPowerSphere"
  States
  {
  Spawn:
    GARD A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,3)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,20)
  SpawnLoop:
	GARD ABCDABCDABCDABCD 6 Bright
	GARD ABCDABCD 4 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("LegendaryPowerSphereCoolDown",1,"Null")
	TNT1 A 1 A_GiveInventory("LegendaryPowerSpeed",1)
	TNT1 A 1 A_GiveInventory("LegendaryPowerFrightener",1)
	TNT1 A 1 ACS_NamedExecuteWithResult("FiringSpeedFix",3)
	TNT1 A 0 A_GiveInventory("LegendaryPowerDrain",1)
	TNT1 A 1 A_GiveInventory("LegendaryPowerSphereCoolDown",1)
	TNT1 A 0 ACS_NamedExecuteAlways("PowerTargetReplacer")	
	Stop  
  }
}

Actor LegendaryPowerSphereCoolDown : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -45
}

Actor PowerLegPowerEffect : CustomInventory
{
  States
  {
  Pickup:
    TNT1 A 0
	TNT1 A 0 A_CustomMissile("LegendaryYellowSparkleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    Stop
  }
}

Actor LegendaryPowerSpeed : PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Color "Yellow" 0.15
  Powerup.Duration -45
  Powerup.Type "LegendarySpeed"
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
    ROWL A 1 Bright
    Loop
  }
}

Actor PowerLegendarySpeed : PowerSpeed { Speed 1.25 }

Actor LegendaryPowerFrightener : PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Duration -45
  Powerup.Type "Frightener"
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
}

Actor LegDoubleFiringSpeed : PowerDoubleFiringSpeed
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  Powerup.Duration 0x7FFFFFFF
}

Actor LegendaryPowerDoubleFiringSpeed : PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Duration -45
  Powerup.Type "LegDoubleFiringSpeed" //PowerDoubleFiringSpeed
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.ADDITIVETIME
  States
  {
  Spawn:
    ROWL A 1 Bright
    Loop
  }
}

Actor RealLegendaryPowerDoubleFiringSpeed : PowerDoubleFiringSpeed
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.ADDITIVETIME
  Powerup.Duration -45
}

Actor LegendaryPowerDrain : PowerDamage //PowerDrain
{
  Powerup.Duration -45
  DamageFactor "Normal", 1.0
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
}

Actor LegendaryYellowSparkleSpawner : BlueSparkleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 2 A_SpawnItemEx("LegendaryYellowStar", frandom(-15, 15), frandom(-15, 15), frandom(28, 44), 0, 0, 0, 0, SXF_CLIENTSIDE)
    Stop
  }
}

Actor LegendaryYellowStar : YellowStar { +NOTIMEFREEZE }
