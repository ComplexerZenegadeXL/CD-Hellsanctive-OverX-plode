Actor LegendarySphere : CustomInventory //16700
{
  //$Category Powerups/LCA
  //$Sprite LSPHA0
  //$Title "Legendary Sphere"
  +INVENTORY.BIGPOWERUP
  //+FLOATBOB
  -INVENTORY.ALWAYSPICKUP
  -FLOAT
  +COUNTITEM
  +NOTIMEFREEZE
  Inventory.PickupMessage "$CFLegendarySpherePickup"
  Inventory.PickUpSound "legendarysphere/pickup"
  Tag "Legendary Sphere"
  Tag "$CFLegendarySphere"
  States
  {
  Spawn:
	LSPH A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,4)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,20)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("legendarysphere/idle",6,5.0)
	LSPH ABCDEFGHIJKLMNO 8 Bright
	Loop
  Pickup:
	TNT1 A 0 A_GiveInventory("LegendarySphereHealth", 1)
	Stop
  }
}

//HEALTH////////////////////////////////////////////////////////////////////////

Actor LegendarySphereHealth : Health
{
  +NOTIMEFREEZE
  Inventory.Amount 500
  Inventory.MaxAmount 500
}

Actor LegendarySphereFlame
{
  +NOCLIP
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  RenderStyle Add
  Scale 0.3
  States
  {
  Spawn:
	LMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor LegendarySphereFlameSpawner 
{
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("LegendarySphereFlame",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 0
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}
