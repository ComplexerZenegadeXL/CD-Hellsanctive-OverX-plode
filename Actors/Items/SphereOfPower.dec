Actor SphereOfPower : CustomInventory
{
  +INVENTORY.INVBAR
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  //+FLOATBOB
  Inventory.MaxAmount 4
  Inventory.InterHubAmount 4
  Inventory.Icon "MINSZ0"
  Inventory.UseSound "regeneration/use"
  Inventory.PickupSound "misc/p_pkup"
  Inventory.PickupMessage "$CFSphereOfPowerPickup"
  Tag "$CFSphereOfPower"
  States
  {
  Spawn:
	MINS A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,11,7)
  SpawnLoop:
	MINS ABCDCB 4 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PowerWeaponLevel2Complex", 1, "Null")
	TNT1 A 0 A_JumpIfInventory("PowerOrbEquipped",1,"MorePower")
	TNT1 A 0 A_GiveInventory("SphereofPowerGiver")
	Stop
  MorePower:
    TNT1 A 0 A_GiveInventory("SphereofPowerGiver2")
	Stop
  }
}

Actor SphereofPowerGiver : PowerUpGiver
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -45
  Powerup.Type "WeaponLevel2Complex"
}

Actor SphereofPowerGiver2 : SphereofPowerGiver { Powerup.Duration -60 }

Actor PowerWeaponLevel2Complex : PowerWeaponLevel2 { }