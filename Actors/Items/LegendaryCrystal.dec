Actor LegendaryPowerShard : CustomInventory //16706
{
  //$Category Powerups/LCA
  //$Sprite PPOSA0
  //$Title "Legendary Power Shard"
  Inventory.PickupMessage "$CFLegendaryPowerShardPickup"
  Inventory.PickupSound "legendarycrystal/take"
  Inventory.UseSound "legendary/defense"
  Inventory.Icon "PPOSZ0"
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Scale 0.75
  Tag "$CFLegendaryPowerShard"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,23)
  SpawnLoop:
	PPOS ABCDEFABCDEFABCDEF 4 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ItemChecks") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 1 A_GiveInventory("LegendaryCrystalCooldown",1)
	TNT1 A 1 A_GiveInventory("LegendaryCrystalProtect",1)
	TNT1 A 0 ACS_NamedExecuteAlways("PowerTargetReplacer",0)
    Stop
  }
}

Actor LegendaryCrystalCooldown : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -30
}

Actor PowerLegCrystalHeal : CustomInventory
{
  States
  {
  Pickup:
    TNT1 A 0
	TNT1 AA 0 A_CustomMissile("LegendaryBlueSparkleSpawner",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryBluePowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 
    Stop
  }
}

Actor LegCrystalArmorGiver : ArmorBonus
{
  Armor.SavePercent 25
  Armor.SaveAmount 1
  Armor.MaxSaveAmount 450
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.35
  DamageFactor "PDTBFGTracer", 0.35
  DamageFactor "Legendary", 0.35
  DamageFactor "LegendaryGuru", 0.35
  DamageFactor "BFGSplash", 0.35
  DamageFactor "BFGSpray", 0.35
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "SatanGuard", 0.35
  Inventory.Icon "ARM2B0"
}

Actor LegendaryCrystalProtectEffect : PowerProtection { DamageFactor "Normal",0.6 }

Actor LegendaryCrystalProtect: PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Type "LegendaryCrystalProtectEffect"
  Powerup.Color "Blue" 0.15
  Powerup.Duration -30
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
    ROWL A 1 Bright
    Loop
  }
}