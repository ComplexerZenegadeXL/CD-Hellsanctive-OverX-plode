
Actor PhaseArmor : ArmorBase
{
  Inventory.PickupSound "pickups/redarmor"
  Inventory.PickupMessage "$CFPhaseArmorPickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,44)
  SpawnLoop:
	PSAR ABCD 6 Bright 
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",24,400) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",24,400)
    Stop
  } 
}

Actor PhaseArmorGiver : RedArmorGiver
{
  Inventory.Icon "PSARA0"
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.35
  DamageFactor "PDTBFGTracer", 0.35
  Armor.SavePercent 25
  Armor.SaveAmount 400
}