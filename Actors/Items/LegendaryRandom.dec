Actor LegendaryRandomSphere : CustomInventory
{
  Inventory.PickupMessage "$CFLegendaryRandomSpherePickup"
  Inventory.PickupSound "legendarycrystal/take"
  Inventory.Icon "LRANZ0"
  RenderStyle Add
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Tag "$CFLegendaryRandomSphere"
  States
  {
  Spawn:
	LRAN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,13,20)
  SpawnLoop:
	LRAN A 5 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 1 ACS_NamedExecuteAlways("LegendaryRandomSphere",0)
	Stop  
  }
}