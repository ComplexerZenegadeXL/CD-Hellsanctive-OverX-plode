Actor CFManaPickup : GasPickup
{
  Radius 8
  Height 8
  //+FLOATBOB
  Scale 0.85
  Inventory.PickupMessage "$CFManaPickup"
  Inventory.PickupSound "Mana/Pickup"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	SpawnLoop:
	MAN2 ABCDEFGHIJKLMNOP 4 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",8,30)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",8) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor CFMana : Ammo 17800
{
  //$Category Ammunition/CF
  //$Sprite MANGA0
  //$Title "Mana"
  Inventory.Amount 30
  Inventory.MaxAmount 300
  Ammo.BackpackAmount 20
  //Ammo.BackpackMaxAmount 600
  Radius 8
  Height 8
  //+FLOATBOB
  Scale 0.85
  Inventory.Icon "MANGA0"
  Inventory.PickupMessage "$CFManaPickup"
  Inventory.PickupSound "Mana/Pickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
  SpawnLoop:
	MAN2 ABCDEFGHIJKLMNOP 4 Bright
	Loop
  }
}

