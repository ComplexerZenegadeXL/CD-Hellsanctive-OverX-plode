Actor CFDoomSphere : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  //+FLOATBOB
  -FLOAT
  +INVENTORY.BIGPOWERUP
  Inventory.PickupMessage "$CFDoomSpherePickup"
  Inventory.PickupSound "powerup/quad"
  States
  {
  Spawn:
    DMS0 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,17,18)
  SpawnLoop:
     DMS0 ABCDCB 4 Bright
	 Loop
  Pickup:
    TNT1 A 0 A_JumpIfInventory("FakeDoomSphere",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("GetStatus",3)
	TNT1 A 0 A_GiveInventory("FakeDoomSphere",1)
	Stop
  }
}

Actor FakeDoomSphere : PowerDamage
{
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -30
  Powerup.Color RedMap
}