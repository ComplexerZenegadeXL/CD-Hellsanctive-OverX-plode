Actor LegendaryArmor : ArmorBase //16701
{
  //$Category Powerups/LCA
  //$Sprite LEGAA0
  //$Title "Legendary Armor"
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  Scale 1.2
  Inventory.PickupMessage "$CFLegendaryArmorPickup"
  Inventory.Icon "LEGAA0"
  Inventory.PickupSound "legendaryarmor/pickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,21,22)
  SpawnLoop:
	LEGA AB 10 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",32,500) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",32,500)
    Stop
  }
}
Actor LegendaryArmorGiver : BasicArmorPickup  //No pointless DamageFactors on Armors that absorb 100% damage.
{
  -INVENTORY.ALWAYSPICKUP
  +NOTIMEFREEZE
  Inventory.Icon "LEGAA0"
  Armor.SavePercent 25
  Armor.SaveAmount 500
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.35
  DamageFactor "PDTBFGTracer", 0.35
  DamageFactor "Nemesis", 0.35
  DamageFactor "Legendary", 0.35
  DamageFactor "LegendaryGuru", 0.35
  DamageFactor "BFGSplash", 0.35
  DamageFactor "BFGSpray", 0.35
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "SatanGuard", 0.35
}

Actor ArmorParticleBlueSpawner
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("ArmorParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20))
	Stop
  Vanilla:
	TNT1 A 0
    Stop
  }
}

Actor ArmorParticleBlue : BFGTrailParticleGreen
{
  Scale 0.06
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LSKB A 2 Bright A_FadeOut(0.015)
	Loop
  }
}
