Actor LegendaryRune : CustomInventory
{
  +DONTGIB
  //+FLOATBOB
  +COUNTITEM
  +NOTIMEFREEZE
  ActiveSound "Pickups/Legruneidle"
  Inventory.PickupMessage "$CFLegendaryRunePickup"
  States
  {
  Spawn:
	LGRN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",9) == 2 || ACS_NamedExecuteWithResult("CheckMods",1) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,13,45)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("Pickups/Legruneidle",7,1.0,1)
	LGRN AAA 10 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuneArmorResetCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRune2Token",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRuneToken",1,"Enhance")
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneToken",1,"Null")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerDrainCheck")
	TNT1 A 0 A_GiveInventory("LegendaryRuneDrain",1)
	TNT1 A 0 A_GiveInventory("LegendaryRuneToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",0)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance:
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneUpgradeToken",1,"Null")
	TNT1 A 0 A_JumpIfInventory("VitalityRuneUpgradeToken",1,"Enhance2")
	TNT1 A 0 A_JumpIfInventory("AgilityRuneUpgradeToken",1,"Enhance3")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("LegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",0)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance2:
	TNT1 A 0 A_JumpIfInventory("AgilityRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("LegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance3:
	TNT1 A 0 A_JumpIfInventory("VitalityRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("LegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Done:
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("LegendaryRuneUpgradeToken",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",2)
	TNT1 A 1 A_StopSound(7)
	Stop
  Remove:
	TNT1 A 0
	Stop
  }
}

Actor LegendaryRuneDrain : PowerDamage //PowerDrain
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  DamageFactor "Normal", 1.0
  Powerup.Duration 0x7FFFFFFF
}

Actor NoDrain : PowerDamage
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  DamageFactor "Normal", 1.0
  Powerup.Duration 7
}

Actor GenericLegRuneToken : Inventory { +INVENTORY.HUBPOWER +INVENTORY.PERSISTENTPOWER }

Actor LegendaryRuneToken : Inventory {}
Actor LegendaryRuneUpgradeToken : GenericLegRuneToken { }

Actor LegendaryRuneFlame : LegendarySphereFlame
{
  Scale 0.1
  States
  {
  Spawn:
	LMKE ABCDEFGHIJKL 2 Bright A_FadeOut
  Stop
  }
}

Actor LegendaryRuneFlameSpawner : LegendarySphereFlameSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("LegendaryRuneFlame",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 0
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor LegendaryRuneItem : Inventory {}