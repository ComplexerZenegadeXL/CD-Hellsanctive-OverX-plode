Actor AgilityRune : LegendaryRune
{
  Inventory.PickupMessage "$CFAgilityRunePickup"
  States
  {
  Spawn:
	ARUN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",9) == 2 || ACS_NamedExecuteWithResult("CheckMods",1) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,48,49)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("Pickups/Legruneidle",7,1.0,1)
	ARUN AA 10 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuneArmorResetCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRune2Token",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRuneToken",1,"Enhance")
    TNT1 A 0 A_JumpIfInventory("AgilityRuneToken",1,"Null")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,5)
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
    TNT1 A 0 A_GiveInventory("AgilityRuneSpeed",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("FiringSpeedCheck")
	TNT1 A 0 A_GiveInventory("AgilityRuneRage",1)
	TNT1 A 0 A_GiveInventory("AgilityRuneToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",2)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance:
	TNT1 A 0 A_JumpIfInventory("AgilityRuneUpgradeToken",1,"Null")
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneUpgradeToken",1,"Enhance2")
	TNT1 A 0 A_JumpIfInventory("VitalityRuneUpgradeToken",1,"Enhance3")
	TNT1 A 0 A_GiveInventory("AgilityRuneUpgradeToken",1)
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",0)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance2:
	TNT1 A 0 A_JumpIfInventory("VitalityRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_GiveInventory("AgilityRuneUpgradeToken",1)
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance3:
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_GiveInventory("AgilityRuneUpgradeToken",1)
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Done:
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("AgilityRuneUpgradeToken",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",2)
	TNT1 A 1 A_StopSound(7)
	Stop
  }
}

Actor AgilityRuneRage : PowerDoubleFiringSpeed
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  Powerup.Duration 0x7FFFFFFF
}

Actor AgilityRuneSpeed : PowerSpeed 
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  Powerup.Duration 0x7FFFFFFF
  Speed 1.25
}

Actor AgilityRuneToken : LegendaryRuneToken { }
Actor AgilityRuneUpgradeToken : GenericLegRuneToken { }

Actor AGPlayerSmokeSpawner : LegendaryRedParticleSpawner 
{
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LMKE A 0 A_JumpIfInventory("AgilityRuneToken",1,"Smoking",AAPTR_TARGET)
	Stop
  Smoking:
	FRR1 A 0
	FRR1 AA 0 Bright A_SpawnItemEx("AgilityPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor AgilityPlayerSmoke : VitalityPlayerSmoke 
{
  RenderStyle Add
  States 
  {
  Spawn:
	FRR1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }	
}
Actor AgilityPlayerSmokeNoLight : AgilityPlayerSmoke { }

Actor AgilityRuneFlameSpawner : LegendarySphereFlameSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("AgilityPlayerSmokeNoLight",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 0
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor RedPowerLineRune : RedPowerLine { +NOTIMEFREEZE Scale 0.8 }

Actor AgilityRuneLineSpawner : BluePowerLineSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAA 1 A_SpawnItemEx("RedPowerLineRune",frandom(-15,15),frandom(-15,15),frandom(28,44),0,0,frandom(1,4)) 
    Stop  
  }
}