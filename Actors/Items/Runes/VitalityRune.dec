Actor VitalityRune : LegendaryRune
{
  Inventory.PickupMessage "$CFVitalityRunePickup"
  States
  {
  Spawn:
	VRUN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",9) == 2 || ACS_NamedExecuteWithResult("CheckMods",1) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,46,47)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("Pickups/Legruneidle",7,1.0,1)
	VRUN AAA 10 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuneArmorResetCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRune2Token",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRuneToken",1,"Enhance")
    TNT1 A 0 A_JumpIfInventory("VitalityRuneToken",1,"Null")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,5)
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 A_GiveInventory("VitalityRuneProtection",1)
	TNT1 A 0 A_GiveInventory("VitalityRuneIronFeet",1)
	TNT1 A 0 ACS_NamedExecuteAlways("RuneRegeneration",0,1)
	TNT1 A 0 A_GiveInventory("VitalityRuneToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance:
	TNT1 A 0 A_JumpIfInventory("VitalityRuneUpgradeToken",1,"Null")
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneUpgradeToken",1,"Enhance2")
	TNT1 A 0 A_JumpIfInventory("AgilityRuneUpgradeToken",1,"Enhance3")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("VitalityRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",0)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance2:
	TNT1 A 0 A_JumpIfInventory("AgilityRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("VitalityRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Enhance3:
	TNT1 A 0 A_JumpIfInventory("LegendaryRuneUpgradeToken",1,"Done")
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("VitalityRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Done:
	TNT1 A 0 A_PlaySound("LegendaryRune/Pickup",6)
	TNT1 A 0 A_GiveInventory("VitalityRuneUpgradeToken",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryRuneUpgradeToken",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",2)
	TNT1 A 1 A_StopSound(7)
	Stop
  }
}

Actor VitalityRuneProtection : PowerProtection
{
  +INVENTORY.PERSISTENTPOWER
  +INVENTORY.HUBPOWER
  +NOTIMEFREEZE
  Powerup.Duration 2147483647
  DamageFactor "Normal", 0.8
  DamageFactor "PlayerPhase", 0.0
  DamageFactor "PlayerPyro", 0.1
  DamageFactor "Explosion", 0.7
  DamageFactor "Mine", 0.25
  DamageFactor "Slime", 0.0
  DamageFactor "PDTBFG", 0.7
}

Actor VitalityRuneIronFeet : PowerIronFeet
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
  +NOTIMEFREEZE
  Powerup.Duration 2147483647
  Powerup.Color "FF FF FF", 0.00 //for some reason I have to define this
  DamageFactor "Slime", 0.0
}

Actor VitalityRuneArmor : BasicArmorBonus 
{
  Armor.SaveAmount 2
  Armor.MaxSaveAmount 150
  Armor.SavePercent 25
  DamageFactor "Normal", 0.58
  Inventory.Icon "ARM2B0"
}

Actor VitalityRuneToken : LegendaryRuneToken { }
Actor VitalityRuneUpgradeToken : GenericLegRuneToken { }

Actor VPlayerSmokeSpawner : LegendaryRedParticleSpawner 
{
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LMKE A 0 A_JumpIfInventory("VitalityRuneToken",1,"Smoking",AAPTR_TARGET)
	Stop
  Smoking:
	FIG1 A 0
	FIG1 AA 0 A_SpawnItemEx("VitalityPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor VitalityPlayerSmoke : LPlayerSmoke
{
  RenderStyle Add
  States 
  {
  Spawn:
	FIG1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }	
}
Actor VitalityPlayerSmokeNoLight : VitalityPlayerSmoke { }

Actor VitalityRuneFlameSpawner : LegendarySphereFlameSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("VitalityPlayerSmokeNoLight",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 0
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor VitalityRuneFX
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  //+FLOATBOB
  +BRIGHT
  Renderstyle Add
  Scale 1.2
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_Jump(128,"Shield")
	VRFX A 1 A_FadeOut(0.03)
	Wait
  Shield:
	VRFX B 1 A_FadeOut(0.03)
	Wait
	}
}

Actor VitalityRuneFXSpawner : WhiteSparkleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 2 A_SpawnItemEx("VitalityRuneFX",frandom(-15,15),frandom(-15,15),frandom(28,44))
	Stop
	}
}