Actor TrueLegendaryRuneToken : GenericLegRuneToken { }
Actor TrueLegendaryRune2Token : GenericLegRuneToken { }

Actor HaveTrueLegendaryRune : GenericLegRuneToken { }
Actor HaveTrueLegendaryRune2 : GenericLegRuneToken { }

Actor TrueLegendaryRuneUpgradeToken : GenericLegRuneToken { }

Actor LPlayerSmokeSpawner : LegendaryRedParticleSpawner
{
  States 
  {
  Spawn:
	TNT1 A 0
	LMKE A 0 A_JumpIfInventory("LegendaryRuneToken",1,"Smoking",AAPTR_TARGET)
	LMKE A 0 A_JumpIfInventory("TrueLegendaryRuneToken",1,"Smoking2",AAPTR_TARGET)
	LMKE A 0 A_JumpIfInventory("TrueLegendaryRune2Token",1,"Smoking3",AAPTR_TARGET)
	Stop
  Smoking:
	LMKE A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LMKE AA 0 A_SpawnItemEx("LPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	Stop
  Smoking2:
	LBG1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LBG1 AA 0 A_SpawnItemEx("TrueLPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	Stop
  Smoking3:
	LBG1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LBG1 A 0 A_SpawnItemEx("VitalityPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	LBG1 A 0 A_SpawnItemEx("AgilityPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	LBG1 A 0 A_SpawnItemEx("LPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	LBG1 A 0 A_SpawnItemEx("TrueLPlayerSmoke",frandom(-12,12),frandom(-12,12),frandom(-16,16),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor TrueLPlayerSmoke : LPlayerSmoke
{
  States 
  {
  Spawn:
	LBG1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor TrueLegendaryRuneFragment : CustomInventory
{
  Inventory.PickupMessage "$CFTrueLegendaryRuneFragmentPickup"
  Inventory.PickupSound "legendarycrystal/take"
  Inventory.Icon "TLRFA0"
  Inventory.MaxAmount 10
  Inventory.InterHubAmount 10
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Tag "$CFTrueLegendaryRuneFragment"
  States
  {
  Spawn:
	TLRF B 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,50)
  SpawnLoop:
	TLRF BCDE 6 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("RuneUpgradeCheck") == 1,"Null")
    Stop
  }
}