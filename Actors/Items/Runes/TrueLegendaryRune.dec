Actor TrueLegendaryRune : CustomInventory
{
  //+FLOATBOB
  +COUNTITEM
  +NOTIMEFREEZE
  +DONTGIB
  ActiveSound "Pickups/Legruneidle"
  Inventory.PickupMessage "$CFTrueLegendaryRunePickup"
  States
  {
  Spawn:
	TGRN A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",9) >= 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,50)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("TrueLegRune/Idle",7,1.0,1)
	TGRN A 3 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuneArmorResetCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRuneUpgradeToken",1,"Upgrade")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("TLRCheck") !=3,"Null")
	TNT1 A 0 A_PlaySound("TrueLegRune/Pickup",6)
	
	TNT1 A 0 A_TakeInventory("LegendaryRuneToken",1)
	TNT1 A 0 A_TakeInventory("AgilityRuneToken",1)
	TNT1 A 0 A_TakeInventory("VitalityRuneToken",1) //removes the regen too
	TNT1 A 0 A_TakeInventory("VitalityRuneProtection",1)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,10)
	//TNT1 A 0 A_TakeInventory("VitalityRuneIronFeet",1)
	
	//TNT1 A 0 A_TakeInventory("AgilityRuneRage",1)
	//TNT1 A 0 A_TakeInventory("AgilityRuneSpeed",1)
	
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerDrainCheck")
	TNT1 A 0 A_GiveInventory("LegendaryRuneDrain",1)
	TNT1 A 0 A_GiveInventory("VitalityRuneIronFeet",1)
	TNT1 A 0 A_GiveInventory("PowerTrueLegProtection",1)
	TNT1 A 0 ACS_NamedExecuteAlways("RuneRegeneration",0,2)
	TNT1 A 0 ACS_NamedExecuteWithResult("FiringSpeedCheck")
	TNT1 A 0 A_GiveInventory("AgilityRuneRage",1)
	TNT1 A 0 A_GiveInventory("AgilityRuneSpeed",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryRuneToken",1)
	TNT1 A 0 A_GiveInventory("HaveTrueLegendaryRune",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",3)
	TNT1 A 1 A_StopSound(7)
	Stop
  Upgrade:
	TNT1 A 0 A_PlaySound("TrueLegRune/Pickup",6)
	TNT1 A 0 ACS_NamedExecuteWithResult("Rune Messages",3)
	TNT1 A 0 A_TakeInventory("LegendaryRuneToken",1)
	TNT1 A 0 A_TakeInventory("AgilityRuneToken",1)
	TNT1 A 0 A_TakeInventory("VitalityRuneToken",1) //removes the regen too
	TNT1 A 0 A_TakeInventory("TrueLegendaryRuneToken",1)
	TNT1 A 0 A_TakeInventory("TrueLegendaryRuneUpgradeToken",1)
	
	//TNT1 A 0 A_TakeInventory("LegendaryRuneDrain",1)
	
	TNT1 A 0 A_TakeInventory("VitalityRuneProtection",1)
	//TNT1 A 0 A_TakeInventory("VitalityRuneIronFeet",1)
	
	TNT1 A 0 A_TakeInventory("AgilityRuneSpeed",1)
	
	TNT1 A 0 A_TakeInventory("PowerTrueLegProtection",1)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,11)
	
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerDrainCheck")
	TNT1 A 0 A_GiveInventory("LegendaryRuneDrain",1)
	TNT1 A 0 A_GiveInventory("VitalityRuneIronFeet",1)
	TNT1 A 0 A_GiveInventory("PowerTrueLegProtection2",1)
	TNT1 A 0 ACS_NamedExecuteAlways("RuneRegeneration",0,3)
	TNT1 A 0 ACS_NamedExecuteWithResult("FiringSpeedCheck")
	TNT1 A 0 A_GiveInventory("AgilityRuneRage",1)
	TNT1 A 0 A_GiveInventory("TrueLegSpeed",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryBFGUpgrade",1)
	
	TNT1 A 0 A_GiveInventory("TrueLegendaryRune2Token",1)
	TNT1 A 0 A_GiveInventory("HaveTrueLegendaryRune2",1)
	TNT1 A 1 A_StopSound(7)
	Stop
  Remove:
	TNT1 A 0
	Stop
  }
}

Actor TrueLegendaryRune2 : TrueLegendaryRune
{
  Inventory.PickupMessage "$CFTrueLegendaryRune2Pickup"
  States
  {
  Spawn:
	TGRN B 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",9) >= 1 || ACS_NamedExecuteWithResult("CheckMods",4) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,50)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("TrueLegRune/Idle",7,1.0,1)
	TGRN B 3 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("RuneArmorResetCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("TrueLegendaryRune2Token",1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("TLR2Check") != 4,"Null")
	TNT1 A 0 A_PlaySound("TrueLegRune/Pickup",6)
	TNT1 A 0 A_TakeInventory("LegendaryRuneToken",1)
	TNT1 A 0 A_TakeInventory("AgilityRuneToken",1)
	TNT1 A 0 A_TakeInventory("VitalityRuneToken",1) //removes the regen too
	TNT1 A 0 A_TakeInventory("TrueLegendaryRuneToken",1)
	TNT1 A 0 A_TakeInventory("TrueLegendaryRuneUpgradeToken",1)
	
	//TNT1 A 0 A_TakeInventory("LegendaryRuneDrain",1)  Not this
	
	TNT1 A 0 A_TakeInventory("VitalityRuneProtection",1)
	//TNT1 A 0 A_TakeInventory("VitalityRuneIronFeet",1) Not this
	
	//TNT1 A 0 A_TakeInventory("AgilityRuneRage",1)  Not this
	TNT1 A 0 A_TakeInventory("AgilityRuneSpeed",1)
	
	TNT1 A 0 A_TakeInventory("PowerTrueLegProtection",1)
	TNT1 A 0 A_JumpIfInventory("IsROPlayer",1,11)
	
	TNT1 A 0 ACS_NamedExecuteAlways("CheckRunes")
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerDrainCheck")
	TNT1 A 0 A_GiveInventory("LegendaryRuneDrain",1)
	TNT1 A 0 A_GiveInventory("VitalityRuneIronFeet",1)
	TNT1 A 0 A_GiveInventory("PowerTrueLegProtection2",1)
	TNT1 A 0 ACS_NamedExecuteAlways("RuneRegeneration",0,3)
	TNT1 A 0 ACS_NamedExecuteWithResult("FiringSpeedCheck")
	TNT1 A 0 A_GiveInventory("AgilityRuneRage",1)
	TNT1 A 0 A_GiveInventory("TrueLegSpeed",1)
	TNT1 A 0 A_GiveInventory("TrueLegendaryBFGUpgrade",1)
	
	TNT1 A 0 A_GiveInventory("TrueLegendaryRune2Token",1)
	TNT1 A 0 A_GiveInventory("HaveTrueLegendaryRune2",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",4)
	TNT1 A 1 A_StopSound(7)
	Stop
  }
}

Actor TrueLegendaryRuneFlame : LegendaryRuneFlame
{
  States
  {
  Spawn:
	LBG1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor TrueLegendaryRuneFlameSpawner : LegendaryRuneFlameSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAA 0 A_SpawnItemEx("TrueLegendaryRuneFlame",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
	TNT1 A 0
	Stop
  }
}

