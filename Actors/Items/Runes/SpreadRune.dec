   Powerup.Duration -30
}*/

Actor PowerSpreadRune : PowerDamage
{
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  +INVENTORY.ADDITIVETIME
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -1
}

Actor CFSpreadRuneToken : Inventory { Inventory.InterHubAmount 0 }

Actor SpreadRuneUpgrade : BaseWeaponUpgrade
{
  Scale 0.65
  Inventory.PickupMessage "$CFSpreadRuneUpgradePickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 A_GiveInventory("UpgradeIconToken",1)
	TNT1 A 0 A_SpawnItemEx("WeaponUpgradeIcon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
  Cont:
	SPRR EFGH 6
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("SpreadRuneUpgraded",1,"Null")
	TNT1 A 0 A_JumpIfInventory("CFSpreadRune",1,"GiveUpgrade")
	Fail
  GiveUpgrade:
	TNT1 A 0 A_TakeInventory("UpgradeIconToken",1)
	TNT1 A 0 A_GiveInventory("SpreadRuneUpgraded",1)
	TNT1 A 0 A_GiveInventory("SpreadRunePower",15)
	Stop
  }
}

Actor SpreadRuneUpgraded : Inventory {}

Actor SpreadRunePower : Inventory { Inventory.MaxAmount 45 }

Actor SpreadRuneToken : Inventory {}

Actor SpreadRuneOn : Inventory {}