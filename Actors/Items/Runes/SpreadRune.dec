Actor SpreadRuneGiver : CustomInventory
{
  Game Doom
  Game Heretic
  Game Hexen
  -COUNTITEM
  +NOGRAVITY
  //+FLOATBOB
  Inventory.Amount 1
  Inventory.MaxAmount 0
  Inventory.PickupAnnouncerEntry "spread"
  Inventory.PickupMessage "$CFSpreadRunePickup"
  +FLOORCLIP
  Tag "$CFSpreadRune"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	SPRR ABCD 6
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("SpreadRuneCheck") == 0 || ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  }
}

Actor CFSpreadRune : CustomInventory
{
  Game Doom
  Game Heretic
  Game Hexen
  -COUNTITEM
  +NOGRAVITY
  //+FLOATBOB
  -INVENTORY.AUTOACTIVATE
  +INVENTORY.INVBAR
  +INVENTORY.UNDROPPABLE
  Inventory.Icon "INSRA0"
  Inventory.PickupMessage "$CFSpreadRunePickup"
  Inventory.PickupAnnouncerEntry "spread"
  Tag "$CFSpreadRune"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
  SpawnLoop:
	SPRR ABCDCB 6
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("CFSpreadRune",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",5)
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("SpreadRuneCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("SpreadRuneOn",1,"RealUse")
	TNT1 A 0 A_JumpIfInventory("SpreadRunePower",7,"RealUse")
	Fail
  RealUse:
	TNT1 A 0 ACS_NamedExecuteAlways("SpreadRuneUse",0)
	Fail
  }
}

Actor SpreadRuneCooldown : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -2
}

