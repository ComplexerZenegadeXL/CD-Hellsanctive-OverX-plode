Actor LegendaryAmmoSphere : CustomInventory //16704
{
  //$Category Powerups/LCA
  //$Sprite AMSPA0
  //$Title "Legendary Ammo Sphere"
  Inventory.PickupMessage "$CFLegendaryAmmoSpherePickup"
  Inventory.PickupSound "legammo/pickup"
  Inventory.UseSound "legammo/use"
  Inventory.Icon "INVLA0"
  //+FLOATBOB
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  Tag "$CFLegendaryAmmoSphere"
  States
  {
  Spawn:
	AMSP A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,20)
  SpawnLoop:
	AMSP ABCD 10 Bright
	Loop	
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("LegInfiniteAmmo",1,"Null")
	TNT1 A 0 A_GiveInventory("ModdedBackpack",1)
	TNT1 A 0 A_GiveInventory("SpringMine",1)
	TNT1 A 1 A_GiveInventory("LegInfiniteAmmo",1)
	Stop
  }
}

Actor LegInfiniteAmmo : PowerupGiver
{
  Inventory.MaxAmount 0
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -45
  Powerup.Color "Yellow" 0.2
  Powerup.Type "PowerInfiniteAmmo"
}