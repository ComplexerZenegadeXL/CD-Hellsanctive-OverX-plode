{
  DamageType "PlayerPyro"
  States
  {
  Death:
    CBEX A 3 Bright
    CBEX B 0 A_CustomMissile("PFuelExplosion01",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
