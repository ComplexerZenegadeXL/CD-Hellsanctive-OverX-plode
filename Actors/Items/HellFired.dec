    Goto Ready	
  Fire6:
    LVRD D 0 A_GiveInventory("HFMissileType7")
	LVRD D 0 A_GunFlash	
    TNT1 A 0 A_Changeflag(reflective,1)
    TNT1 A 0 A_PlaySound("weapons/charge15k")
	HCBW ABC 9 Bright 
	TNT1 A 0 A_GiveInventory("Loop",1)
	HCBW ABC 3 Bright 
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	HCBW D 3 Bright A_FireCustomMissile("PCardinal10K",frandom(-4,4),0,-26,58)	
	TNT1 A 0 A_JumpIfInventory("Loop",10,1)
	Goto Fire6+7
	TNT1 A 0 A_TakeInventory("Loop",99)
  Fire6Loop1:
	TNT1 A 0 A_GiveInventory("Loop",1)
	HCBW ABC 2 Bright 
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	HCBW D 2 Bright A_FireCustomMissile("PCardinal10K",frandom(-4,4),0,-26,58)	
