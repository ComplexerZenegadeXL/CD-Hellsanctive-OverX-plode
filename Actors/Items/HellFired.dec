Actor PlayerHealth : Inventory { Inventory.MaxAmount 1200 }
Actor PlayerArmor : Inventory { Inventory.MaxAmount 1200 }
Actor PlayerMorphed : Inventory {}

Actor FakeArmorBonus : ComplexArmorBonus  //Do not put this in spawners
{
  Armor.SaveAmount 1
  Armor.SavePercent 25
  Armor.MaxSaveAmount 1200
  Inventory.PickupMessage ""
  Inventory.PickupSound ""
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  }
}

Actor MorphIronFeet : PowerIronFeet
{
  +INVENTORY.HUBPOWER
  +NOTIMEFREEZE
  Powerup.Duration 0x7FFFFFFF
  Powerup.Color "FF 40 00", 0.01
  DamageFactor "Slime", 0.0
}
Actor ScrollOfHellfire : CustomInventory
{
  Inventory.PickupMessage "$CFHellfireScrollPickup"
  Inventory.PickupSound "legendarypowersphere/pickup"
  Inventory.Icon "HFSCA0"
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Tag "$CFHellfireScroll"
  States
  {
  Spawn:
	HFSC A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,42)
  SpawnLoop:
	HFSC BCD 5 Bright
	Loop	
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("ScrollOfHellfire",1,"Null")
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",105)
	TNT1 A 1 A_StopSound
	Stop
  Use:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetClass") == 1,"Null")
    TNT1 A 0 ACS_NamedExecuteWithResult("GetPlayerInfo",0)
    TNT1 A 0 ACS_NamedExecuteWithResult("HFCyber") 
    TNT1 A 0 A_GiveInventory("ScrollOfHellfireGiver")
    TNT1 A 0 A_PlaySound("HFCyber/see", CHAN_AUTO, 1.0, False, ATTN_NONE)
    Stop	
  }
}

Actor HellFireScrollFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire")
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAA 3 A_SpawnItemEx("GhostFire",frandom(6,12),frandom(-6,6),frandom(62,72),0,0,frandom(1,2),0,SXF_CLIENTSIDE,0)
    Stop
  }
}

Actor ScrollOfHellfireGiver : PowerupGiver
{
  Powerup.Duration -200 //-200
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +NOTIMEFREEZE
  Powerup.Type "PowerHFCyberPlayer"
}

Actor PowerHFCyberPlayer : PowerMorph
{
  +NOTIMEFREEZE
  PowerMorph.PlayerClass "Demon_HellFireCyberdemon"
  PowerMorph.MorphFlash "Nothing"
  PowerMorph.UnMorphFlash "Nothing"
  PowerMorph.MorphStyle (MRF_FULLHEALTH|MRF_ADDSTAMINA|MRF_NEWTIDBEHAVIOUR|MRF_WHENINVULNERABLE|MRF_LOSEACTUALWEAPON|MRF_UNDOBYDEATH|MRF_UNDOBYDEATHSAVES)
}

