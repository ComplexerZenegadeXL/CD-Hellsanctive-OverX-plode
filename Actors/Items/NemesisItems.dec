Actor NemesisArmorSoul
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  Renderstyle Subtract
  Alpha 0.5
  Scale 0.7
  var int user_delay;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SetScale(-1.0,1.0)
	TNT1 A 0 A_SetUserVar(user_delay,random(2,3))
	NRMF ABCDEFG 1 Bright A_SetTics(user_delay)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

Actor NemesisSphere : CustomInventory
{
  Scale 1.0
  Alpha 0.8
  Renderstyle Translucent
  Inventory.PickupMessage "$CFNemesisSpherePickup"
  Inventory.PickupSound "VileGet"
  Tag "Nemesis Sphere"
  +COUNTITEM
  //+FLOATBOB
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	NSP9 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,8,28)
  SpawnLoop:
	NSP9 A 16 Bright
	Loop
  Pickup:
	TNT1 A 0 A_PlaySound("NemesisSphere/Pickup",0)
	TNT1 A 1 A_GiveInventory("NemesisSphereHealth")
	Stop
  }
}

Actor NemesisUltraSphere : CustomInventory
{
  Scale 1.0
  Alpha 0.8
  Renderstyle Translucent
  Inventory.PickupMessage "$CFNemesisUltraSpherePickup"
  Inventory.PickupSound "VileGet"
  Tag "Nemesis Super Sphere"
  +COUNTITEM
  //+FLOATBOB
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	NSP0 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,28,8,13)
  SpawnLoop:
	NSP0 ABCB 8 Bright
	Loop
  Pickup:
	TNT1 A 0 A_PlaySound("NemesisUltra/Pickup",0)
	TNT1 A 0 A_GiveInventory("NemesisArmor",1)
	TNT1 A 1 A_GiveInventory("NemesisSphereHealth",1)
	Stop
  }
}

Actor NemesisOmegaSphere : NemesisUltraSphere
{
  Inventory.PickupMessage "$CFNemesisOmegaSpherePickup"
  States
  {
  Spawn:
	NSP8 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,29,30)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,8,13)
  SpawnLoop:
	TNT1 A 0 A_PlaySound("NemesisOmega/Loop",7,1.0,1)
	NSP8 ABCDEF 3 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("NemesisOmegaSphereToken",1,"Null")
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_PlaySound("NemesisOmega/Pickup",0)
	TNT1 A 0 A_GiveInventory("NemesisOmegaSphereToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_RingsOfRegeneration",0)
	TNT1 A 0 A_GiveInventory("NemesisArmorRegenerationQuiet",1)
	TNT1 A 0 A_GiveInventory("NemesisArmor",1)
	TNT1 A 1 A_GiveInventory("NemesisSphereHealth",1)
	Stop
  }
}

