Actor NemesisArmor : ArmorBase 30311
{
  Scale 0.9
  +NOTIMEFREEZE
  Mass 0x7FFFFFFF
  Inventory.PickupSound "NemesisArmor/Pickup"
  Inventory.PickupMessage "$CFNemesisArmorPickup"
  Tag "Nemesis Armor"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,26,27)
  SpawnLoop:
	UNNA AB 9 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1 || ACS_NamedExecuteWithResult("ArmorCheck",52,1200) == 0,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",52,1200)
    Stop
  }
}

Actor NemesisArmorGiver : BasicArmorPickup
{
  Armor.SavePercent 25
  Armor.SaveAmount 1200
  Inventory.Icon "UNNAA0"
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "Nemesis", 0.25
  DamageFactor "Legendary", 0.25
  DamageFactor "LegendaryGuru", 0.25
  DamageFactor "BFGSplash", 0.25
  DamageFactor "BFGSpray", 0.25
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "NemesisBall", 0.25
  DamageFactor "SatanGuard", 0.35
  +NOTIMEFREEZE
}

Actor NemesisArmorGiverQuiet : NemesisArmorGiver { -COUNTITEM +INVENTORY.QUIET }

Actor NemesisArmorQuiet : NemesisArmor
{
  -COUNTITEM
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
}

Actor NemesisArmorRegeneration : CustomInventory 30413
{
  Scale 1.2
  +COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.BIGPOWERUP
  -INVENTORY.INVBAR
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER  
  Mass 0x7FFFFFFF
  Inventory.Icon "UNNAB0"
  Inventory.PickupSound "NemesisGet"
  Inventory.PickupMessage "$CFNemesisArmorRegenerationPickup"
  Tag "Nemesis Armor"
  States
  {
  Spawn:
	UNNA B 10 Bright
	Loop
  Pickup:
	TNT1 A 1
	TNT1 A 0 A_JumpIfInventory("NemesisArmorRegenerationCheck",1,"Nop")
	TNT1 A 0 A_GiveInventory("NemesisArmorRegenerationCheck",1)
	TNT1 A 0 A_GiveInventory("NemesisArmorQuiet",1)
	TNT1 A 1 ACS_NamedExecuteAlways("CF_NemesisArmorRegeneration",0)
	Stop
  Nop:
	TNT1 A 1
	Fail
  }
}

Actor NemesisArmorRegenerationQuiet : NemesisArmorRegeneration { -COUNTITEM +INVENTORY.QUIET }

Actor NemesisArmorRegenerationCheck : Inventory
{
  +INVENTORY.HUBPOWER
  +INVENTORY.PERSISTENTPOWER
}

Actor NemesisArmorSmokeSpawner
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 2 A_SpawnItemEx("NemesisArmorSmoke",frandom(-2,2),frandom(0,15),frandom(1,8),frandom(0,1),frandom(-1,0),frandom(0,0.2),frandom(0,360),SXF_CLIENTSIDE)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}


Actor NemesisArmorSmoke : NemesisHellionSmoke
{
  Scale 0.2
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FIW1 ABCDEFGHIJKL 3 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor NemesisArmorSoulSpawner
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 2 A_SpawnItemEx("NemesisArmorSoul",frandom(-15,15),frandom(-15,15),frandom(3,10),frandom(-0.2,0.2),frandom(-0.2,0.2),frandom(0.5,2),frandom(0,360),SXF_CLIENTSIDE)
