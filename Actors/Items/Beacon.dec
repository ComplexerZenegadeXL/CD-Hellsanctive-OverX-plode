	TNT1 A 0 A_FaceTarget
	PION F 1 Bright A_CustomMissile("FlameShotPlayer",32,0,frandom(-4,4),0)
	TNT1 A 0 A_FaceTarget
	PION F 1 Bright A_CustomMissile("FlameShotPlayer",32,0,frandom(-4,4),0)
	TNT1 A 0 A_FaceTarget
	PION F 1 Bright A_CustomMissile("FlameShotPlayer",32,0,frandom(-4,4),0)
	TNT1 A 0 A_FaceTarget
	PION F 1 Bright A_CustomMissile("FlameShotPlayer",32,0,frandom(-4,4),0)
	TNT1 A 0 A_FaceTarget
	PION F 1 Bright A_CustomMissile("FlameShotPlayer",32,0,frandom(-4,4),0)
	PION EE 12 A_StopSound(6)
	Goto See
  Pain:
    PION G 4
    PION G 4 A_Pain
    Goto Idle
  Death:
	PION H 8
	PION I 8 A_PlayerScream
	PION J 8 A_NoBlocking
	PION K 8
	PION L 8 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PION M 8
	PION N -1
    Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PION P 3 A_XScream
	PION Q 3 A_NoBlocking
	PION RSTUV 3
	PION W -1
    Stop
  Raise:
    Stop
  }
}

Actor FriendlyMarineHexa : FriendlyMarineShotgun
{
  AttackSound " "
  Translation "112:127=176:191"
  States
  {
  Spawn:
    PHST A 0 NoDelay ACS_NamedExecuteAlways("CF_CheckForPlayerCallingHelp",0)
  SpawnLoop:
	PHST ABCD 5 A_Wander
	TNT1 A 0 A_Look
    Loop
  See:
    PHST ABCD 4 A_MarineChase
    Loop
  Pause:
	PHST E 20
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfInventory("Hexa-ZombieToken",3,"Reload")
	TNT1 A 0 A_JumpIfCloser(325,"Hexa")
  Normal:
    PHST E 15 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/qsgdoublefire")
	TNT1 A 0 A_GiveInventory("Hexa-ZombieToken",1)
	TNT1 AAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),0)
    PHST F 5 Bright A_CustomBulletAttack(13.8,9.6,10,Random(1,4)*3,"FriendlyMarineBulletPuff") 
    PHST E 15 A_FaceTarget
	TNT1 A 0 A_JumpIfInventory("Hexa-ZombieToken",3,"Reload")
	Goto See
  Hexa:
	TNT1 A 0 A_JumpIfInventory("Hexa-ZombieToken",1,"Normal")
    PHST E 15 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hsgfire")
	TNT1 A 0 A_GiveInventory("Hexa-ZombieToken",3)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),0)
    PHST F 5 Bright A_CustomBulletAttack(15.4,10.6,37,Random(1,4)*3,"FriendlyMarineBulletPuff")
    PHST E 25 A_FaceTarget	
  Reload:
	TNT1 A 0 A_TakeInventory("Hexa-ZombieToken",3)
	TNT1 A 0 A_PlaySound("weapons/qsgopen")	
    PHST E 15 A_FaceTarget
    PHST EEEEEE 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
    PHST E 12 A_PlaySound("weapons/qsgshellslide")	
    PHST E 8
    PHST E 12 A_PlaySound("weapons/qsgshellslide")	
    PHST E 8
	PHST E 12 A_PlaySound("weapons/qsgshellslide")	
    PHST E 8
    PHST E 10 A_PlaySound("weapons/qsgclose")	
    Goto See
  Pain:
    PHST G 4
    PHST G 4 A_Pain
    Goto Idle
  Death:
	PHST H 8
	PHST I 8 A_PlayerScream
	PHST J 8 A_NoBlocking
	PHST K 8
	PHST L 8 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PHST M 8
	PHST N -1
    Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PHST P 3 A_XScream
	PHST Q 3 A_NoBlocking
	PHST RSTUV 3
	PHST W -1
    Stop
  Raise:
    Stop
  }
}


