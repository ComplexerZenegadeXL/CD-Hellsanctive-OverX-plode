Actor Beacon : CustomInventory 17755
{
  //$Category Powerups/CF
  //$Sprite BEACA0
  //$Title "Beacon"
  +INVBAR
  Inventory.MaxAmount 3
  Inventory.Icon "BEACZ0"
  Inventory.PickupSound "Beacon/Pickup"
  Inventory.PickupMessage "$CFBeaconPickup"
  Tag "$CFBeacon"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
  SpawnLoop:
	BEAC A -1
    Stop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_SpawnItemEx("ActiveBeacon",56,0,8,0,0,0,0,SXF_SETMASTER)
    Stop
  }
}

Actor ActiveBeacon
{
  Monster
  Health 1000
  Radius 6
  Height 28
  Mass 9999
  +FLOORCLIP
  +FRIENDLY
  +NOTELEPORT
  -COUNTKILL
  -SHOOTABLE
  -SOLID
  States
  {
  Spawn:
    BEAC A 105
    BEAC A 0 A_CustomMissile("TeleportFog",0,0,0,0,0)
    BEAC A 0 ACS_NamedExecuteAlways("BeaconSpawner",0)
    BEAC A 105
    BEAC A 0 A_CustomMissile("TeleportFog",0,0,0,0,0)
    BEAC A 0 ACS_NamedExecuteAlways("BeaconSpawner",0)
    BEAC A 105
    BEAC A 0 A_CustomMissile("TeleportFog",0,0,0,0,0)
    BEAC A 0 ACS_NamedExecuteAlways("BeaconSpawner",0)
    BEAC A 105
    Goto Death
  Death:
    TNT1 A 1 A_CustomMissile("TeleportFog",0,0,0,0,0)
    Stop
  }
}

