Actor TrueLegendaryUltraSphere : LegendaryUltraSphere
{
  Inventory.PickupSound "truelegmegasphere/pickup"
  Inventory.PickupMessage "$CFTrueLegendaryUltraSpherePickup"
  ActiveSound "truelegendarymegasphere/idle"
  States
  {
  Spawn:
	TLUS A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,19)
  SpawnLoop:
	TNT1 A 0 A_LoopActiveSound
	TLUS ABCDEFGHIJK 4 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
  Success:
	TNT1 A 0 A_GiveInventory("TrueLegendarySphereHealth", 1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,2)
	TNT1 A 0 A_GiveInventory("TrueLegendaryArmor", 1)
	TNT1 AA 0 A_GiveInventory("LegendaryCombatpack", 1)
	TNT1 A 1 A_StopSound
	Stop
  }
}

Actor TrueLegendaryArmor : LegendaryArmor
{
  Inventory.PickupMessage "$CFTrueLegendaryArmorPickup"
  Inventory.Icon "ATLGA0"
  Inventory.PickupSound ""
  States
  {
  Spawn:
	ATLG A 20 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",48,1000) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",48,1000)
    Stop
  }
}

Actor TrueLegendaryArmorGiver : LegendaryArmorGiver
{
  Armor.SavePercent 25
  Armor.SaveAmount 1000
  Inventory.Icon "ATLGA0"
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.28
  DamageFactor "PDTBFGTracer", 0.28
  DamageFactor "Nemesis", 0.28
  DamageFactor "Legendary", 0.28
  DamageFactor "LegendaryGuru", 0.28
  DamageFactor "BFGSplash", 0.28
  DamageFactor "BFGSpray", 0.28
  DamageFactor "SatanGuard", 0.35
  DamageFactor "PlayerLegendary", 0.1
}

Actor TrueLegendarySphereHealth : Health
{
  +NOTIMEFREEZE
  Inventory.Amount 1000
  Inventory.MaxAmount 1000
}

Actor TrueLegendarySphereFlame : LegendarySphereFlame
{
  States
  {
  Spawn:
	LBG1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor TrueLegendarySphereFlameSpawner : LegendarySphereFlameSpawner 
{
  States
{
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAA 0 A_SpawnItemEx("TrueLegendarySphereFlame",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
	TNT1 A 0
	Stop
  }
}