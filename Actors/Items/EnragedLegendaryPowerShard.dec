Actor EnragedLegendaryPowerShard : CustomInventory  
{
  +DONTGIB
  //$Category Powerups/ILCA
  //$Sprite EPOSA0
  //$Title "Enraged Legendary Power Shard"
  Inventory.PickupMessage "$CFEnragedLegendaryPowerShardPickup"
  Inventory.PickupSound "legendarycrystal/take"
  Inventory.UseSound "legendary/defense"
  Inventory.Icon "EPOSZ0"
  +INVBAR
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  +FLOAT
  //+FLOATBOB
  Scale 0.75
  Tag "$CFEnragedLegendaryPowerShard"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,38)
  SpawnLoop:
	EPOS ABCDEF 4 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ItemChecks") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 1 A_GiveInventory("ELegendaryCrystalCooldown",1)
	TNT1 A 1 A_GiveInventory("ELegendaryCrystalProtect",1)
	TNT1 A 0 ACS_NamedExecuteAlways("PowerTargetReplacer")
    Stop
  }
}

/*Actor ELegendaryCrystalHealing : PowerupGiver
{
  Powerup.Type ELegCrystalHeal
  +AUTOACTIVATE
  +ALWAYSPICKUP
}*/

Actor ELegendaryCrystalCooldown : PowerDamage { DamageFactor "notarealdamagetype", 1.0 Powerup.duration -30 }

Actor PowerELegCrystalHeal : CustomInventory
{
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
    TNT1 A 0
	TNT1 AA 0 A_CustomMissile("RedSparkleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("RedPowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 
    Stop
  }
}

Actor ELegCrystalArmorGiver : ArmorBonus
{
  Armor.SavePercent 25
  Armor.SaveAmount 1
  Armor.MaxSaveAmount 600
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "Legendary", 0.3
  DamageFactor "LegendaryGuru", 0.3
  DamageFactor "BFGSplash", 0.3
  DamageFactor "BFGSpray", 0.3
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "SatanGuard", 0.3
  Inventory.Icon "ARM3B0"
}

Actor ELegendaryCrystalProtectEffect : PowerProtection { DamageFactor "Normal",0.6 }

Actor ELegendaryCrystalProtect: PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Type "ELegendaryCrystalProtectEffect"
  Powerup.Color "Red" 0.15
  Powerup.Duration -30
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
    ROWL A 1 Bright
    Loop
  }
}

