//=================
// Weapon Upgrades
//=================

Actor UpgradeIconToken : Inventory {}

Actor WeaponUpgradeIcon
{
  Scale 0.8
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOINTERACTION
  //+FLOATBOB
  -FLOAT
  States
  {
  Spawn:
	UPGR AAAAAA 1 A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	UPGR BBBBBB 1 Bright A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_JumpIfInventory("UpgradeIconToken",1,"Spawn",AAPTR_TARGET)
	UPGR AAAAAA 1 A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	UPGR BBBBBB 1 Bright A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_JumpIfInventory("UpgradeIconToken",1,"Spawn",AAPTR_TARGET)
	UPGR AAAAAA 1 A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	UPGR BBBBBB 1 Bright A_Warp(AAPTR_TARGET,0,0,16,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_JumpIfInventory("UpgradeIconToken",1,"Spawn",AAPTR_TARGET)
	Goto PickupCheck
  PickupCheck:
	TNT1 A 0 A_JumpIfInventory("UpgradeIconToken",1,"Spawn",AAPTR_TARGET)
	Goto Null
  }
}

Actor BaseWeaponUpgrade : CustomInventory { }

Actor HandgunUpgrade : BaseWeaponUpgrade
{
  Scale 0.65
  Inventory.PickupMessage "$CFHandgunUpgradePickup"
  Inventory.PickupSound "pistol/upgrade"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("UpgradeIconToken",1)
	TNT1 A 0 A_SpawnItemEx("WeaponUpgradeIcon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
  Cont:
	PSUP A -1 Bright
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("HandgunUpgraded",1,"Nope")
	TNT1 A 0 A_JumpIfInventory("Handgun",1,"GiveUpgrade")
  Nope:
	TNT1 A 0
	Fail
  GiveUpgrade:
	TNT1 A 0 A_TakeInventory("UpgradeIconToken",1)
	TNT1 A 0 A_GiveInventory("HandgunUpgraded",1)
	Stop
  }
}

