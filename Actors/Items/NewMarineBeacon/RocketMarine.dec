Actor FriendMarineRocket : BaseMarine
{
  AttackSound " "
  Translation "112:127=48:79"
  Tag "$CFMarineRocket"
  States
  {
  Spawn:
	PLA5 A 0 NoDelay ACS_NamedExecuteAlways("CF_CheckForPlayerCallingHelp",0)
	"####" A 0 A_GiveInventory("TargetIsACFMarine")
	"####" A 0 A_GiveInventory("PhaseArmorGiver")
	"####" A 0 A_GiveInventory("CFArmorToken",400)
  SpawnLoop:
	PLA5 A 1 A_Look
	Loop
  Missile:
    "####" A 0
    "####" A 0 A_ChangeFlag("NODROPOFF", 1)
	"####" A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "FollowPlayer")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_ChangeFlag("SHOOTABLE", 1)
	"####" A 0 A_ChangeFlag("SOLID", 0)
	"####" A 0 A_JumpIfCloser(200, "Retreat")
	"####" A 0 A_FaceTarget
	"####" A 1 A_Chase ("","")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	Goto Strafe
  Strafe:
	"####" A 0 A_Jump(128, "Attack")
	"####" A 0 ThrustThing(Angle*256/360+64,12,0,0)
	"####" AABBCCDD 2 A_Chase
	"####" A 0 A_Stop
	Goto Attack
  Attack:
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" E 14 A_FaceTarget
	"####" F 6 Bright A_CustomMissile("CFMarineRocket", 30, 0, 0)
	"####" E 20 A_PlaySound("rocket/drumspin")
	"####" A 0 A_Jump(100,"See")
	"####" A 0 A_MonsterRefire(30,"See")
	Goto Attack+2
  Retreat:
	"####" A 0
	"####" A 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" B 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" C 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" D 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	Goto Attack
  }
}
Actor CFMarineRocket : NewRocket { +MTHRUSPECIES DamageType "Players" }