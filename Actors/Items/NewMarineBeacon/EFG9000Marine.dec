Actor FriendMarineEFG9000 : BaseMarine
{
  AttackSound " "
  Translation "112:127=192:205"
  Tag "$CFMarineEFG9000"
  States
  {
  Spawn:
	PRDM A 0 NoDelay ACS_NamedExecuteAlways("CF_CheckForPlayerCallingHelp",0)
	"####" A 0 A_GiveInventory("TargetIsACFMarine")
	"####" A 0 A_GiveInventory("PhaseArmorGiver")
	"####" A 0 A_GiveInventory("CFArmorToken",400)
  SpawnLoop:
	PRDM A 1 A_Look
	Loop
  Missile:
    "####" A 0
    "####" A 0 A_ChangeFlag("NODROPOFF", 1)
	"####" A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "FollowPlayer")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_ChangeFlag("SHOOTABLE", 1)
	"####" A 0 A_ChangeFlag("SOLID", 0)
	"####" A 0 A_JumpIfCloser(200, "Retreat")
	"####" A 0 A_FaceTarget
	"####" A 1 A_Chase ("","")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	Goto Strafe
  Strafe:
	"####" A 0 A_Jump(128, "Attack")
	"####" A 0 ThrustThing(Angle*256/360+64,12,0,0)
	"####" AABBCCDD 2 A_Chase
	"####" A 0 A_Stop
	Goto Attack
  Attack:
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_PlaySound("efg/charge1")
	"####" E 17 A_FaceTarget
	"####" A 0 A_PlaySound("efg/charge2")
	"####" E 17 A_FaceTarget
	"####" A 0 A_PlaySound("efg/charge3")
	"####" E 17 A_FaceTarget
	"####" A 0 A_PlaySound("mrl/fire",1)
	"####" F 2 Bright A_CustomMissile("MarineEFGRocket", 30, 0, frandom(-1, 1))
	"####" E 2 A_FaceTarget
	"####" A 0 A_PlaySound("mrl/fire",1)
	"####" F 2 Bright A_CustomMissile("MarineEFGRocket", 30, 0, frandom(-1, 1))
	"####" E 2 A_FaceTarget
	"####" A 0 A_PlaySound("mrl/fire",1)
	"####" F 2 Bright A_CustomMissile("MarineEFGSeekRocket", 30, 0, frandom(-1, 1))
	"####" E 2 A_FaceTarget
	"####" A 0 A_PlaySound("mrl/fire",1)
	"####" F 2 Bright A_CustomMissile("MarineEFGSeekRocket", 30, 0, frandom(-1, 1))
	"####" E 2 A_FaceTarget
	"####" A 0 A_Jump(4,"Pause")
	"####" A 0 A_MonsterRefire(128,"See")
	Goto Attack+6
  Pause:
	"####" E 70 A_PlaySound("weapon/warn")
	"####" E 15 A_PlaySound("weapon/cool")
	Goto See
  Retreat:
	"####" A 0
	"####" A 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" B 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" C 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" D 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	Goto Attack
  }
}
Actor MarineEFGRocket : EFGRocket { +MTHRUSPECIES DamageType "Player" }
Actor MarineEFGSeekRocket : EFGSeekRocket { +MTHRUSPECIES DamageType "Player" }