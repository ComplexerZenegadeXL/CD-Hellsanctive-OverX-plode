Actor FriendMarineBFG10k : BaseMarine
{
  AttackSound " "
  Translation "112:127=192:205"
  Tag "$CFMarineBFG10k"
  States
  {
  Spawn:
	PB10 A 0 NoDelay ACS_NamedExecuteAlways("CF_CheckForPlayerCallingHelp",0)
	"####" A 0 A_GiveInventory("TargetIsACFMarine")
	"####" A 0 A_GiveInventory("PhaseArmorGiver")
	"####" A 0 A_GiveInventory("CFArmorToken",400)
  SpawnLoop:
	PB10 A 1 A_Look
	Loop
  Missile:
    "####" A 0
    "####" A 0 A_ChangeFlag("NODROPOFF", 1)
	"####" A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "FollowPlayer")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_ChangeFlag("SHOOTABLE", 1)
	"####" A 0 A_ChangeFlag("SOLID", 0)
	"####" A 0 A_JumpIfCloser(200, "Retreat")
	"####" A 0 A_FaceTarget
	"####" A 1 A_Chase ("","")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	Goto Strafe
  Strafe:
	"####" A 0 A_Jump(128, "Attack")
	"####" A 0 ThrustThing(Angle*256/360+64,12,0,0)
	"####" AABBCCDD 2 A_Chase
	"####" A 0 A_Stop
	Goto Attack
  Attack:
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_PlayWeaponSound("weapons/charge15k")
	"####" E 25 A_FaceTarget
	"####" A 0 A_PlaySound("weapons/bfg15kfire")
	"####" F 3 Bright A_CustomMissile("Marine10KProjectile", 30, 0, frandom(-4, 4))
	"####" E 4 A_FaceTarget
	"####" A 0 A_Jump(10,"Pause")
	"####" A 0 A_MonsterRefire(200,"See")
	Goto Attack+3
  Retreat:
	"####" A 0
	"####" A 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" B 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" C 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" D 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	Goto Attack
  }
}

Actor Marine10KProjectile : 10KProjectile
{
  Height 10
  Radius 10
  Species "Player"
  DamageType "Player"
  States
  {
  Death:
  XDeath:  
    TNT1 A 0
    TNT1 A 1 A_SpawnItem("Marine10KEx")
    Stop
  }
}

Actor Marine10KEx : Player10KEx
{
  Species "Player"
  DamageType "Player"
}