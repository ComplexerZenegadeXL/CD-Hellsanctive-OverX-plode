Actor FriendMarineFreezer : BaseMarine
{
  AttackSound " "
  Translation "112:127=176:191"
  Tag "$CFMarineFreezer"
  States
  {
  Spawn:
	PION A 0 NoDelay ACS_NamedExecuteAlways("CF_CheckForPlayerCallingHelp",0)
	"####" A 0 A_GiveInventory("TargetIsACFMarine")
	"####" A 0 A_GiveInventory("PhaseArmorGiver")
	"####" A 0 A_GiveInventory("CFArmorToken",400)
  SpawnLoop:
	PION A 1 A_Look
	Loop
  Missile:
    "####" A 0
    "####" A 0 A_ChangeFlag("NODROPOFF", 1)
	"####" A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "FollowPlayer")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_ChangeFlag("SHOOTABLE", 1)
	"####" A 0 A_ChangeFlag("SOLID", 0)
	"####" A 0 A_JumpIfCloser(200, "Retreat")
	"####" A 0 A_FaceTarget
	"####" A 1 A_Chase ("","")
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	Goto Strafe
  Strafe:
	"####" A 0 A_Jump(128, "Attack")
	"####" A 0 ThrustThing(Angle*256/360+64,12,0,0)
	"####" AABBCCDD 2 A_Chase
	"####" A 0 A_Stop
	Goto Attack
  Attack:
	"####" A 0 A_JumpIfInTargetInventory("IsCFPlayer", 1, "CheckRangeToWait")
	"####" A 0 A_JumpIfCloser(325,"IceFlame")
  Normal:
	"####" E 15 A_FaceTarget
	"####" A 0 A_PlaySound("weapons/iceshot",5)
	"####" F 2 Bright A_CustomMissile("FreezeBlast", 30, 4, 0)
	"####" E 4 A_FaceTarget
	"####" A 0 A_Jump(20,"Pause")
	"####" A 0 A_MonsterRefire(200,"See")
	Goto Normal+1
  IceFlame:
	"####" A 0 A_PlaySound ("freeze/altfire", 6)
	"####" EE 10 A_FaceTarget
	"####" A 0 A_PlaySound("freeze/althold", 6)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)		 
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" A 0 A_FaceTarget
	"####" F 1 Bright A_CustomMissile("FlameShotMarine",32,0,frandom(-4,4),0)
	"####" EE 12 A_StopSound(6)
	Goto See
  Retreat:
	"####" A 0
	"####" A 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" B 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" A 0 
	"####" C 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	"####" D 2 A_Recoil(4)
	"####" A 0 A_FaceTarget
	Goto Attack
  }
}

Actor FlameShotMarine : FlameShotPlayer { +MTHRUSPECIES DamageType "Player" }