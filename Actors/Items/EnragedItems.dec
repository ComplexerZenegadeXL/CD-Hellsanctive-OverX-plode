Actor EnragedLegendaryArmor : ArmorBase
{
  Scale 1.2
  +NOTIMEFREEZE
  Inventory.PickupMessage "$CFEnragedLegendaryArmorPickup"
  Inventory.PickupSound "enragedlegarmor/pickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,34,35)
  SpawnLoop:
	ELGA A 20 Bright
	ELGA B 9 Bright
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",44,750) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",44,750)
    Stop
  }
}

Actor EnragedLegendaryArmorGiver : BasicArmorPickup
{
  Armor.SavePercent 25
  Armor.SaveAmount 750
  Inventory.Icon "ELGAA0"
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "Nemesis", 0.3
  DamageFactor "Legendary", 0.3
  DamageFactor "Legendary1", 0.3
  DamageFactor "LegendaryGuru", 0.3
  DamageFactor "BFGSplash", 0.3
  DamageFactor "BFGSpray", 0.3
  DamageFactor "SatanGuard", 0.35
  DamageFactor "PlayerLegendary", 0.1
}

Actor EnragedLegendaryUltraSphere : LegendaryUltraSphere
{
  +DONTGIB
  Inventory.PickupSound "enragedlegmegasphere/pickup"
  Inventory.PickupMessage "$CFEnragedLegendaryUltraSpherePickup"
  States
  {
  Spawn:
	ELDS A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 A_PlaySound("enragedlegmegasphere/idle1",CHAN_ITEM,1.0,True)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,36)
  SpawnLoop:
	ELDS ABCDCB 4 Bright
	Loop
  Pickup:
	TNT1 A 0 A_GiveInventory("EnragedLegendarySphereHealth",1)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags",1) == 0, 2)
	TNT1 A 0 A_GiveInventory("EnragedLegendaryArmor",1)
	TNT1 AA 0 A_GiveInventory("LegendaryCombatpack",1)
	Stop
  }
}

Actor EnragedArmorSmokeSpawner: RHellionSmokeSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor EnragedLegendarySphereHealth : Health { +NOTIMEFREEZE Inventory.Amount 750 Inventory.MaxAmount 750 }

Actor EnragedLegendarySphere : LegendarySphere
{
  +DONTGIB
  Inventory.PickupSound "enragedlegsphere/pickup"
  Inventory.PickupMessage "$CFEnragedLegendarySpherePickup"
  States
  {
  Spawn:
	ISPH A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 A_PlaySound("enragedlegsphere/idle",CHAN_ITEM,5.0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,37)
  SpawnLoop:
	ISPH ABCDCB 10 Bright
	Loop
  Pickup:
	TNT1 A 0
	TNT1 A 1 A_GiveInventory("EnragedLegendarySphereHealth",1)
	Stop
  }
}
Actor MadArmorSparkSpawner : RandomSpawner { DropItem "LegArmorSpark" 256 1 DropItem "MadArmorSpark" 256 1 }

Actor LegArmorSparkSpawner
{
  +CLIENTSIDEONLY
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAA 2 A_SpawnItemEx("LegArmorSpark",frandom(-12,12),frandom(-12,12),frandom(2,16),frandom(-0.4,0.4),frandom(-0.4,0.4),frandom(0,2),0,0,64)
    Stop
  Vanilla:
	TNT1 A 0
    Stop
  }       
}

Actor LegArmorSpark
{
  +NOINTERACTION
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  Renderstyle Add
  var int user_delay;
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Null")
	TNT1 A 0 A_SetScale(frandom(0.3,0.6))
	TNT1 A 0 A_SetUserVar(user_delay,random(2,4))
	SPK9 ABCDEF 1 A_SetTics(user_delay)
	Stop
  }
}
Actor MadArmorSpark : LegArmorSpark
{
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Null")
	TNT1 A 0 A_SetScale(frandom(0.3,0.6))
	TNT1 A 0 A_SetUserVar(user_delay,random(2,4))
	SPK8 ABCDEF 1 A_SetTics(user_delay)
	Stop
  }
}