Actor CannongunSphere : CustomInventory 30321
{
  //$Category Powerups
  //$Title "CannonGun Sphere"
  //$Sprite P21XA0
  Inventory.PickupSound ""
  Inventory.PickupMessage "$CFCannongunSpherePickup"
  Inventory.Icon "P21XE0"
  +INVENTORY.INVBAR
  -FLOAT
  //+FLOATBOB
  +INVENTORY.BIGPOWERUP
  -INVENTORY.ALWAYSPICKUP
  Tag "$CFCannongunSphere"
  //var int user_timer;
  States
  {
  Spawn:
	P21X A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,32,33)
  SpawnLoop:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("Cannongun/Idle", CHAN_6|CHAN_NOPAUSE, 1.0)
    P21X ABCDCBABCDCBABCDCBABCDCB 3 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("CannongunSphere", 1,"Null")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_SpawnItemEx("CannongunPickupFlare", 0, 0, 12, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("Cannongun/Pickup", CHAN_AUTO|CHAN_NOPAUSE)
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("HasCannongun", 1,"Null")
	TNT1 A 0 A_GiveInventory("HasCannongun", 1)
	TNT1 A 0 A_PlaySound("Cannongun/Pickup", CHAN_AUTO|CHAN_NOPAUSE)
	TNT1 A 0 ACS_NamedExecuteWithResult("CannongunPower",0)
	TNT1 A 0 A_SpawnItemEx("CannongunPlayerAuraWarp",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	Stop
  Death:
	TNT1 A 1 A_SpawnItemEx("CannongunSphereDeathVapor", 0, 0, 24, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Stop
  }
}