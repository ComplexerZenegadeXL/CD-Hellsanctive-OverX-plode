Actor PhaseSphere : CustomInventory 13376
{
  Inventory.PickupMessage "$CFPhaseSpherePickup"
  Inventory.PickupSound "phaseimp/teleport"
  Inventory.UseSound "phaseimp/teleport"
  Inventory.Icon "PSPHE0"
  //+FLOATBOB
  +INVBAR
  +INVENTORY.BIGPOWERUP
  Tag "$CFPhaseSphere"
  States
  {
  Spawn:
	PSPH A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"HoldAndDestroy")
  SpawnLoop:
	PSPH ABCD 10 Bright 
	Loop	
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",2) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PhaseSphereCooldown",1,"Null")
	TNT1 A 0 A_GiveInventory("PhaseSphereCooldown",1)
	TNT1 A 0 A_GiveInventory("RMPowerGhost")
	TNT1 A 0 A_GiveInventory("PowerRMShadow")
	TNT1 A 0 A_GiveInventory("RMPowerRedDamage")
	TNT1 A 0 A_GiveInventory("RMPowerMS")
	TNT1 A 0 ACS_NamedExecuteAlways("CF_PhaseSphere",0)
    Stop
  }
}

Actor PhaseSphereCooldown : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -30
}

Actor UnsetSolid : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	//TNT1 A 0 A_CheckFlag(SOLID,"Unset")
	//Fail
  //Unset:
	TNT1 A 0 A_GiveInventory("SOLIDFlagUnset",1)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	Stop
	}
}

Actor SetSolid : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	//TNT1 A 0 A_JumpIfInventory("SOLIDFlagUnset",1,"Set")
	//Fail
  //Set:
	TNT1 A 0 A_TakeInventory("SOLIDFlagUnset",1)
	TNT1 A 0 A_ChangeFlag(SOLID,1)
	Stop
  }
}

Actor SOLIDFlagUnset : Inventory { Inventory.InterHubAmount 0 +INVENTORY.UNDROPPABLE }

Actor RMPowerMS : PowerSpeed
{
  Powerup.Duration -30
  Speed 1.25
  +POWERSPEED.NOTRAIL
 }

Actor RMPowerRedDamage : PowerProtection
{
  DamageFactor "Normal", 0.8
  +INVENTORY.HUBPOWER
  Powerup.Duration -30
}

