Actor PowerRMShadow : PowerupGiver
{
  +SHADOW
  +INVENTORY.HUBPOWER
  -INVENTORY.INVBAR
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Type "Invisibility"
  Powerup.Duration -30
  Powerup.Strength 0
  Powerup.Mode "Opaque" //Opaque
}
Actor RMPowerGhost : PowerGhost
{
  -SHADOW
  +INVENTORY.HUBPOWER
  Powerup.Strength 75
  Powerup.Duration -30
}