Actor LegendaryLifeEssence : CustomInventory
{
  Scale 0.5
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFLegendaryLifeEssencePickup"
  Inventory.PickupSound "pickups/lifeessence"
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  +NOTIMEFREEZE
  States
  {
  Spawn:
    LLFE A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,2)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,39)
  SpawnLoop:
    LLFE ABCD 3 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool",500) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,10,500)
	Stop
  }
}

