Actor LegendaryArmorBonus : ComplexArmorBonus
{
  Armor.SaveAmount 1
  Armor.MaxSaveAmount 500
  DamageFactor "Normal", 0.4
  DamageFactor "PDTBFG", 0.35
  DamageFactor "PDTBFGTracer", 0.35
  DamageFactor "Nemesis", 0.35
  DamageFactor "Legendary", 0.35
  DamageFactor "LegendaryGuru", 0.35
  DamageFactor "BFGSplash", 0.35
  DamageFactor "BFGSpray", 0.35
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "SatanGuard", 0.35
  Inventory.Icon "LEGAA0"
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  }
}

Actor LegendaryArmorBonusMax : CustomInventory 
{
  Scale 0.5
  Inventory.Pickupmessage "$CFLegendaryArmorBonusMaxPickup"
  Inventory.PickupSound "pickups/armorbonusmax"
  //+FLOATBOB
  +NOTIMEFREEZE
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	TNT1 A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,2)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,39)
  SpawnLoop:
	LLFS ABCDEFGHIJKJIHGFEDCB 4 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckArmorPool",500) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveArmorPool",0,25,24,500)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorBonus",25,24,500) == 0, "Null")
	//TNT1 A 0 A_RailWait
	//TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmorBonus",25,24,500)
    Stop
  }
}

Actor LegendaryBossArmorBonusMax : LegendaryArmorBonusMax 
{
  Scale 0.7
  Inventory.PickupMessage "$CFLegendaryBossArmorBonusMaxPickup"
  Inventory.PickupSound "pickups/largearmorbonusmax"
  States
  {
  Spawn:
    TNT1 A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,2)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",1) == 1 || ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,39)
  SpawnLoop:
	LDAS ABCB 5 Bright
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckArmorPool",500) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveArmorPool",0,50,24,500)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorBonus",50,24,500) == 0, "Null")
	//TNT1 A 0 A_RailWait
	//TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmorBonus",50,24,500)
    Stop
  }
}

Actor JumpTest : LegendaryBossArmorBonusMax
{
  States
  {
  Spawn:
    LDAS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,39)
  SpawnLoop:
	LDAS ABCB 5 Bright A_SpawnItemEx("LegendaryBonusSparkleSpawner")
	Loop
  }
}

Actor LegendaryBonusStar : YellowStar { +NOTIMEFREEZE }

Actor LegendaryBonusSparkleSpawner : WhiteSparkleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 2 A_SpawnItemEx("LegendaryBonusStar", frandom(-10, 10), frandom(-10, 10), frandom(14, 24), 0, 0, 0, 0, SXF_CLIENTSIDE) 
    Stop
  }
}
