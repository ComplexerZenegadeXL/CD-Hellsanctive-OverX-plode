Actor SalvationSphere : CustomInventory 17751
{
  //$Category Powerups/CF
  //$Sprite SLVSA0
  //$Title "Salvation sphere"
  Inventory.PickupSound "Powerup/Salvation"
  Inventory.PickupMessage "$CFSalvationSpherePickup"
  Inventory.Icon "SLVSZ0"
  Inventory.MaxAmount 0
  RenderStyle Add
  Tag "$CFSalvationSphere"
  +INVENTORY.BIGPOWERUP
  +INVENTORY.UNDROPPABLE
  //+FLOATBOB
  -FLOAT
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1 || ACS_NamedExecuteWithResult("Get Port",2) == 1,"HoldAndDestroy")
	SLVS A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,7)
  SpawnLoop:
    SLVS ABCDCB 6 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1 || ACS_NamedExecuteWithResult("Get Port",2) == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_JumpIfInventory("SalvationSphereToken",1,"RechargeCheck")
	TNT1 A 0 A_JumpIfInventory("LegendarySalvationSphereToken",1,"RechargeCheck")
	TNT1 A 0 A_GiveInventory("SalvationSphereToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("NewSalvationSphere",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",12)
	Stop
  RechargeCheck:
    TNT1 A 0 A_JumpIfInventory("SalvationCooldown",1,"Recharge")
	Fail
  Recharge:
	TNT1 A 0 A_TakeInventory("SalvationCoolDown",120)
	Stop
  }
}

Actor SalvationSphereToken : Inventory {}

Actor SalvationCoolDown : Inventory { Inventory.MaxAmount 500 }

