Actor SalvationCoolDownGiver : PowerUpGiver
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -240
  Powerup.Type "SalvationCoolDown"
}*/

Actor BuddhaToken : Inventory {}

Actor SalvationInvul : PowerupGiver
{
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -5
  Powerup.Type "Invulnerable"
}

Actor NoCrush : PowerProtection { DamageFactor "Crush", 0.0 Powerup.Duration -15 }

Actor Salvate : ArtiTeleport
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
}