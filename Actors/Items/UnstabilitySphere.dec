Actor UnstabilitySphere : CustomInventory 17754
{
  //$Category Powerups/CF
  //$Sprite UNSTA0
  //$Title "Unstability Sphere"
  //+FLOATBOB
  +COUNTITEM
  +INVENTORY.BIGPOWERUP
  -FLOAT
  Inventory.PickupSound "Powerup/Unstable"
  Inventory.PickupMessage "$CFUnstabilitySpherePickup"
  States
  {
  Spawn:
	UNST A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",3) == 1,"HoldAndDestroy")
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,17,18)
  SpawnLoop:
	UNST ABCDCB 2 Bright
	Loop
  Pickup:
    TNT1 A 0 A_JumpIfInventory("UnstableCoolDown",1,"Null")
	//TNT1 A 0 A_JumpIfInventory("RespawnProtection",1,"NoUse")
	TNT1 A 0 ACS_NamedExecuteWithResult("GetStatus",5)
    TNT1 A 0 A_GiveInventory("UnstableSpeedGiver", 1)
	TNT1 A 0 A_GiveInventory("UnstableCoolDown", 1)
	TNT1 A 0 ACS_NamedExecuteWithResult("InvulnerableFix",5)
	Stop
  }
}

Actor USInvulnerability : PowerupGiver
{
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration -30
  Powerup.Type "Invulnerable"
  Powerup.Mode Reflective
  Powerup.Color GoldMap	 
}

Actor UnstableSpeedGiver : PowerupGiver
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 0
  Powerup.Duration -30
  Powerup.Type Speed
}

Actor UnstableCoolDown : PowerDamage
{
  +INVENTORY.AUTOACTIVATE
  -INVENTORY.INVBAR
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -30
} 