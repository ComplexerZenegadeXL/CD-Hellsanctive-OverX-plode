Actor NemesisRune : CustomInventory 29060
{
  +INVENTORY.ALWAYSPICKUP
  +NOTIMEFREEZE
  //+FLOATBOB
  Inventory.PickupMessage ""
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MapCheck") == 1,"HoldAndDestroy")
	TNT1 A 0 A_PlaySound("NemesisRune/Loop",1,1.0,1)
  SpawnLoop:	
    TNT1 A 0 A_SpawnItemEx("WhiteSparkleSpawner")
	NMRN AAA 10 Bright A_SpawnItemEx("NemesisRuneFlameSpawner",0,0,-20)
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("MapCheck") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_PlaySound("NemesisRune/Pickup",1,1.0,0,ATTN_NONE)
	TNT1 A 0 A_GiveInventory("NemesisRuneToken",1)
	TNT1 A 1 ACS_NamedExecuteAlways("NemesisMapExit",0)
	Stop
  }
}

Actor NemesisRuneFlameSpawner : LegendaryRuneFlameSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAA 0 A_SpawnItemEx("NemesisRuneFlame",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
	TNT1 A 0
	Stop
  }
}

Actor NemesisRuneFlame : LegendaryRuneFlame
{
  States
  {
  Spawn:
	2HDT ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor NemesisRuneToken : Inventory  {}

Actor StoneColdStunner : GenericItem
{
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PowerPWSCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("UnlimitedPower",1,"MorePower")
	TNT1 A 0 A_RadiusGive("OpenACanofWhoopAss",768,RGF_MONSTERS,1)
	TNT1 A 0 ACS_NamedExecuteWithResult("NemesisCooldown")
	//TNT1 A 0 A_GiveInventory("PowerPWSCooldown",1)
	Stop
  MorePower:
	TNT1 A 0 A_RadiusGive("SteveWeiser",1024,RGF_MONSTERS,1)
	TNT1 A 0 ACS_NamedExecuteWithResult("NemesisCooldown")
	//TNT1 A 0 A_GiveInventory("PowerPWSCooldown",1)
	Stop
  }
}

Actor PWSCooldownGiver : PowerupGiver
{
  +NOTIMEFREEZE
  PowerUp.Type "PWSCooldown"
}

Actor PowerPWSCooldown : PowerDamage
{
  +NOTIMEFREEZE
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -300
}

Actor PWSCoolDown : Inventory { Inventory.MaxAmount 300 }

Actor OpenACanofWhoopAss : GenericItem
{
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerWordStun")
	Stop
  }
}

Actor SteveWeiser : OpenACanofWhoopAss
{
  States
  {
  Pickup:
	TNT1 A 0 ACS_NamedExecuteWithResult("PowerWordStun",1)
	Stop
  }
}

Actor DeathNote : GenericItem
{
  Inventory.PickupSound ""
  Gravity 0.25
  -INVENTORY.QUIET
  -INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
	DNOT A -1
	Stop
  Spawn2:
	TNT1 A -1
	Stop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("PWKToken",1,"Null")
	TNT1 A 0 A_JumpIfInventory("NemesisRuneToken",1,"RealPickup")
	Fail
  RealPickup:
	TNT1 A 0 A_GiveInventory("PWKToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("PlayDeathNoteSound",0)
	Stop
  }
}

Actor DeathNoteFlat
{
  Radius 0
  Height 0
  Scale 1.0
  RenderStyle Translucent
  Alpha 1.0
  +NOTELEPORT
  +NOBLOCKMAP
  +MOVEWITHSECTOR
  +DONTGIB
  +THRUACTORS
  +FLOORCLIP
  +FLOORHUGGER
  States
  {
  Spawn:
	TNT1 A 0
    DNOT A -1
    Stop
  }
}

