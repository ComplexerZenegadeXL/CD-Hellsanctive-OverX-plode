Actor GenericItem: CustomInventory
{
  -COUNTITEM
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
}

Actor TonynsGhost : GenericItem
{
  Radius 20
  Height 16
  Inventory.PickupMessage ""
  +INVENTORY.NEVERRESPAWN
  States
  {
  Pickup:
	TNT1 A 0
	Stop
  }
}

