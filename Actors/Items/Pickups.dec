Actor ResistanceGiver : PowerupGiver
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Inventory.MaxAmount 0
  Powerup.Type "HalfDamage"
  Powerup.Duration -20
}

Actor PowerHalfDamage : PowerProtection { DamageFactor "Normal", 0.75 }

