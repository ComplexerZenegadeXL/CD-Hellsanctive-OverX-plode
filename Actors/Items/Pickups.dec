Actor KeyBase : CustomInventory
{
  Scale 0.75
  Inventory.PickupMessage ""
  Inventory.PickupSound "misc/k_pkup"
  +NOTDMATCH
  +DONTGIB
  -INVENTORY.ALWAYSPICKUP
  var int user_specials[6];
  States
  {
  InInventory:
	TNT1 A 0
	Fail
  }
}

Actor RedCard2 : KeyBase replaces RedCard
{
  SpawnID 86
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpecialSetting",0,special,args[0],args[1])
	TNT1 A 0 ACS_NamedExecuteAlways("SpecialSetting2",0,args[2],args[3],args[4])
	TNT1 A 0 ACS_NamedExecuteAlways("WhyDoKeysHaveSpecials?",0)
  SpawnLoop:
	RKEY A 10
	RKEY B 10 Bright
	Loop
  Pickup:
	TNT1 A 0 ACS_NamedExecuteAlways("TangoKeys",0)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar") == 1, "SharedKeys")
	TNT1 A 0 A_JumpIfInventory("RedCard",1,"InInventory")
	TNT1 A 0 ACS_NamedExecuteAlways("Keys",0)
	Fail
  SharedKeys:
	TNT1 A 0 ACS_NamedExecuteAlways("SharedKeys",0,0)	
	Stop
  }
}

