Actor ArmorCharge : CustomInventory 32403
{
  Scale 0.7
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupSound "pickups/iarmorbonus"
  Inventory.UseSound "armorcharge/use"
  Inventory.PickupMessage "$CFArmorChargePickup"
  Inventory.Icon "IARMA0"
  -INVENTORY.INVBAR
  +FLOORCLIP
  Tag "$CFArmorCharge"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
  SpawnLoop:
	ACRG AB 6
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckArmorPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveArmorPool",0,5,2)
	Stop
  } 
}

