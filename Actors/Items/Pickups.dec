Actor FakeHealthBonus : HealthBonus
{
  Scale 0.6
  Inventory.MaxAmount 100
  Inventory.PickupMessage "$CFNewHealthBonusPickup"
  Inventory.PickupSound "pickups/healthbonus"
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
    TNT1 A 0
    Stop
  }
}

Actor RegenHealthBonus : FakeHealthBonus
{
  +NOTIMEFREEZE
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 250
}

Actor NewHealthBonus : CustomInventory
{
  Scale 0.6
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFNewHealthBonusPickup"
  Inventory.PickupSound "pickups/healthbonus"
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
    SMBS A 0 NoDelay ACS_NamedExecuteAlways("SectorSniffing",0,2)
  SpawnLoop:
    SMBS ABCDCB 5
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,2)
	Stop
  }
}

