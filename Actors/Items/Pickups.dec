Actor BulletMagPickup : CustomInventory
{
  Scale 0.5
  Inventory.PickupSound "items/clip"
  Inventory.PickupMessage "$CFBulletMagPickup"
  var int user_playertid;
  var int user_thingtid;
  var int user_amount;
  States
  {
  Spawn:
	TNT1 A 0 NoDelay ACS_NamedExecuteAlways("ModAmmoDrop",0,0)
  SpawnLoop:
	BULP A -1
	Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("AmmoGiver",1,10)
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Ammo Check",1) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
	TNT1 A 0 
	Stop
  }
}

