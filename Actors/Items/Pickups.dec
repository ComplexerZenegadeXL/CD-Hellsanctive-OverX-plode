Actor AmmoPack : CustomInventory 32690
{
  Scale 0.8
  Inventory.MaxAmount 10
  Inventory.InterHubAmount 10
  Inventory.PickupSound "pickups/iammosatchel"
  Inventory.UseSound "Null"
  Inventory.PickupMessage "$CFAmmoPackPickup"
  Tag "$CFAmmoPack"
  +FLOORCLIP
  States
  {
  Spawn:
    ASAT A -1
    Stop
  Pickup:
	TNT1 A 0 ACS_NamedExecuteAlways("AmmoPackCheck",0)
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AmmoFull", 0) == 2, "Null")
	TNT1 A 0 A_PlaySound("ammosatchel/use")
	TNT1 A 0 ACS_NamedExecuteAlways("UseAmmoPack")
	Stop
  }
}

Actor AmmoPackInv : CustomInventory
{
  Inventory.PickupSound ""
  Inventory.UseSound "Null"
  Inventory.PickupMessage ""
  Inventory.Icon "INASA0"
  Tag "$CFAmmoPack"
  +INVENTORY.INVBAR
  States
  {
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("AmmoFull", 0) == 2, "Null")
	TNT1 A 0 A_PlaySound("ammosatchel/use")
	TNT1 A 0 ACS_NamedExecuteAlways("UseAmmoPack",0,1)
	Fail
  }
}

Actor AmpGoggles : CustomInventory replaces Infrared
{
  SpawnID 138
  Scale 0.75
  +COUNTITEM
  +FLOORCLIP
  +INVENTORY.UNDROPPABLE
  Inventory.UseSound "goggles/use"
  Inventory.PickupSound "pickups/goggles"
  Inventory.PickupMessage "$CFLightAmplificationGogglesPickup"
  Inventory.Icon "INVIA0"
  Tag "$CFLightAmplificationGoggles"
  States
  {
  Spawn:
	TNT1 A 0
 SpawnLoop:
	PVIS A 14 Bright
	PVIS B 6
	Loop
  Pickup:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpToken",1,"Null")
	TNT1 A 0 A_GiveInventory("AmpPower",120)
	TNT1 A 0 A_GiveInventory("AmpToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("AmpGogglesCheck")
	TNT1 A 0 ACS_NamedExecuteAlways("AmpCharger",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",6)
    Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpGogglesCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpOn",1,"RealUse")
	TNT1 A 0 A_JumpIfInventory("AmpPower",10,"RealUse")
	Fail
  RealUse:
	TNT1 A 0 ACS_NamedExecuteAlways("AmpUse",0)
	Fail
  }
}

Actor AmpGogglesInv : CustomInventory
{
  Scale 0.75
  //+INVENTORY.UNDROPPABLE
  Inventory.UseSound "goggles/use"
  Inventory.PickupSound ""
  Inventory.PickupMessage ""
  Inventory.Icon "INVIA0"
  +INVENTORY.INVBAR
  Tag "$CFLightAmplificationGoggles"
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Use:
	TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpGogglesCooldown",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpOn",1,"RealUse")
	TNT1 A 0 A_JumpIfInventory("AmpPower",10,"RealUse")
	Fail
  RealUse:
	TNT1 A 0 ACS_NamedExecuteAlways("AmpUse",0)
	Fail
  }
}

Actor AmpGogglesCooldown : PowerDamage
{
  DamageFactor "notarealdamagetype", 1.0
  Powerup.Duration -2
}

Actor AmpGiver : PowerLightAmp
{
  -INVENTORY.INVBAR
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.ADDITIVETIME
  Powerup.Duration -1
}

Actor AmpGogglesUpgrade : BaseWeaponUpgrade
{
  Scale 0.65
  Inventory.PickupMessage "$CFLightAmplificationGogglesUpgradePickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("UpgradeIconToken",1)
	TNT1 A 0 A_SpawnItemEx("WeaponUpgradeIcon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
  Cont:
	PVIS C 14 Bright
	PVIS D 6
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("AmpGogglesUpgraded",1,"Null")
	TNT1 A 0 A_JumpIfInventory("AmpGoggles",1,"GiveUpgrade")
	Fail
  GiveUpgrade:
	TNT1 A 0 A_TakeInventory("UpgradeIconToken",1)
	TNT1 A 0 A_GiveInventory("AmpGogglesUpgraded",1)
	TNT1 A 0 A_GiveInventory("AmpPower",60)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",7)
	Stop
  }
}

Actor AmpGogglesUpgraded : Inventory {}

Actor AmpPower : Inventory { Inventory.MaxAmount 180 }

Actor AmpToken : Inventory {}

Actor AmpOn : Inventory {}

Actor HellionRegen : CustomInventory //32408
{
  Scale 0.5
  Inventory.PickupSound "regeneration/pickup"
  Inventory.UseSound "regeneration/use"
  Inventory.PickupMessage "$CFHellionRegenPickup"
  Inventory.Icon "HRGNZ0"
  +INVENTORY.INVBAR
  +FLOORCLIP
  Tag "$CFHellionRegen"
  States
  {
  Spawn:
    HRGN A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,1)
  SpawnLoop:
	HRGN ABCD 3 Bright
    Loop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 0 A_JumpIfInventory("PowerHellionRegen",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("HellionRegen",0)
	TNT1 A 0 A_GiveInventory("HellionRegenGiver",1)
	Stop
  } 
}

