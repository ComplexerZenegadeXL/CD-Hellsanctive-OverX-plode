Actor ModdedBlurSphere : BlurSphere
{
  RenderStyle Translucent
  Inventory.PickupMessage "$CFModdedBlurSpherePickup"
  Inventory.PickupSound "powerups/blurp"
  +FLOATBOB
  -FLOAT
  +INVENTORY.BIGPOWERUP
  +COUNTITEM
  +VISIBILITYPULSE
  +INVENTORY.BIGPOWERUP
  -INVENTORY.ALWAYSPICKUP
  States
  {
  Spawn:
	PINS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,10,6,101)
  SpawnLoop:
    PINS ABCD 6 Bright
    Loop
  }
}

Actor FakeBlurSphere : PowerupGiver
{
  -INVENTORY.INVBAR
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Type "Invisibility"
  Powerup.Duration -60
  Powerup.Mode Fuzzy
}

Actor ModdedSoulSphere : CustomInventory
{
  Inventory.PickupMessage "$CFModdedSoulSpherePickup"
  Inventory.PickupSound "powerups/soulsphere"
  //+FLOATBOB
  -FLOAT
  -INVENTORY.ALWAYSPICKUP
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	SOUL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,6,7)
  SpawnLoop:
    SOUL ABCDCB 6 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,100)
	Stop
  }
}

Actor ModdedMegaSphere : CustomInventory
{
  Inventory.PickupMessage "$CFModdedMegaSpherePickup"
  Inventory.PickupSound "powerups/megasphere"
  //+FLOATBOB
  +COUNTITEM
  -FLOAT
  -INVENTORY.ALWAYSPICKUP
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffectsOnItem",0,8,9)
  SpawnLoop:
    MEGA ABCD 6 Bright
    Loop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool") == 1 && ACS_NamedExecuteWithResult("CheckArmorPool") == 1,"Null")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,2)
	TNT1 A 0 ACS_NamedExecuteAlways("GiveArmorPool",0,200,10000)
    TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,200)
    Stop
  }
}

