Actor DemonicChaliceUpgrade : BaseWeaponUpgrade
{
  Scale 0.65
  Inventory.PickupMessage "$CFDemonicChaliceUpgradePickup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("UpgradeIconToken",1)
	TNT1 A 0 A_SpawnItemEx("WeaponUpgradeIcon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
  Cont:
	IMOT DEFE 3
	Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("DemonicChaliceUpgraded",1,"Null")
	TNT1 A 0 A_TakeInventory("UpgradeIconToken",1)
	TNT1 A 0 A_GiveInventory("DemonicChaliceUpgraded",1)
	TNT1 A 0 A_GiveInventory("DemonicChaliceGiver",1)
	TNT1 A 0 A_GiveInventory("ChalicePower",10)
	TNT1 A 0 ACS_NamedExecuteWithResult("ScreenMsg",11)
	Stop
  }
}

