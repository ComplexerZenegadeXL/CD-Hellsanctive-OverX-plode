  Inventory.PickupSound "powerups/map"
  States
  {
  Spawn:
    PMAP ABCDCB 6 Bright
    Loop
  Pickup:
	TNT1 A 0 A_JumpIfInventory("GotMap",1,"Null")
	TNT1 A 1 A_GiveInventory("Allmap")
	TNT1 A 0 A_GiveInventory("GotMap")
	Stop
  }
}

