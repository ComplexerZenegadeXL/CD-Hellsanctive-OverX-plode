Actor ArmorBase : CustomInventory
{
  Radius 20
  Height 16
  +INVENTORY.NEVERRESPAWN
  -INVENTORY.ALWAYSPICKUP
  //+INVENTORY.TRANSFER
  var int user_thingtid;
  var int user_playertid;
  var int user_amount;
  States
  {
  Use:
	TNT1 A 0 
	Stop
  }
}

Actor StartingArmor : ArmorBase
{
  Inventory.PickupMessage "$CFStartingArmorPickup"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
  SpawnLoop:
	SARM A 6
    Loop
  Held:
    TNT1 A 0 Thing_ChangeTID(0,ACS_NamedExecuteWithResult("CF_GetTID"))
	TNT1 A 0 ACS_NamedExecuteWithResult("SetSpecial")
	TNT1 A 1
	TNT1 A 0 ACS_NamedExecuteWithResult("GetArmorAmount")
	Stop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorCheck",4,50) == 0, "Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmor",4,50)
    Stop
  }
}

