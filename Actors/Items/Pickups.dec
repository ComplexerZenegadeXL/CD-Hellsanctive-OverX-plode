Actor ComplexArmorBonus : ArmorBonus
{
  Armor.SaveAmount 1
  Armor.SavePercent 25
  Armor.MaxSaveAmount 250
  DamageFactor "Normal", 0.8
  Inventory.Icon "ARSDB0"
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	ARSD A 6
	ARSD B 12
	Loop
  }
}

Actor NewArmorBonus : CustomInventory
{
  Inventory.PickupMessage "$CFNewArmorBonusPickup"
  Inventory.PickupSound "pickups/armorbonus"
  -INVENTORY.ALWAYSPICKUP
  -COUNTITEM
  +INVENTORY.BIGPOWERUP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorFlags") == 1,"HoldAndDestroy")
	Goto SpawnLoop
  SpawnLoop:
	ARSD A 6
	ARSD B 12
	Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckArmorPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveArmorPool",0,2,4)
	//TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ArmorBonus",2,4,250) == 0, "Null")
	//TNT1 A 0 A_RailWait
    //TNT1 A 0 ACS_NamedExecuteWithResult("GiveArmorBonus",2,4,250)
	Stop
  } 
}

