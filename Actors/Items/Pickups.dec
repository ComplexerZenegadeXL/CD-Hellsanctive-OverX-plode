Actor HealthFlask : CustomInventory 32400
{
  Scale 0.75
  Inventory.MaxAmount 0
  Inventory.InterHubAmount 0
  Inventory.PickupMessage "$CFHealthFlaskPickup"
  Inventory.PickupSound "pickups/flask"
  Inventory.UseSound "flask/use"
  Inventory.Icon "INVMA0"
  +FLOORCLIP
  Tag "$CFHealthFlask"
  States
  {
  Spawn:
    TNT1 A 0
	PMED ABCDCB 4
    Loop
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckHealthPool") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 ACS_NamedExecuteAlways("GiveHealthPool",0,5)
	Stop
  }
}

