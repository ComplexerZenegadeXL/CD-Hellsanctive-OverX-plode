Actor Flare : CustomInventory
{
  Radius 4
  Height 18
  +INVENTORY.INVBAR
  Inventory.MaxAmount 20
  Inventory.InterHubAmount 20
  Inventory.Icon "SPOFE0"
  Inventory.PickupMessage "$CFFlarePickup"
  Tag "$CFFlare"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"HoldandDestroy")
	SPOF D -1
    Stop
  Pickup:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckMods",5) == 1,"Null")
	TNT1 A 0 A_RailWait
	Stop
  Use:
    TNT1 A 0 A_JumpIfInventory("PlayerMorphed",1,"Null")
	TNT1 A 1 A_SpawnItemEx ("ActiveFlare", 56, 0, 28, 0, 0, 0, 0, 1)
    Stop
  }
}

Actor ActiveFlare
{
  Radius 22
  Height 11
  States
  {
  Spawn:
    SPOF A 0
    SPOF A 0 A_PlaySound("Flare/Light")
    SPOF A 0 A_PlaySound("Flare/Loop",7,1.0,1)
  SpawnLoop:
    SPOF AB 1 Bright 
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,-10,0,0,0,0,0,SXF_CLIENTSIDE,196)
    Loop
  }
}

Actor FlareBox : CustomInventory
{
  Radius 28
  Height 16
  Inventory.PickupMessage "$CFFlareBoxPickup"
  States
  {
  Spawn:
	SPOF C -1
    Stop
  Pickup:
    TNT1 A 1 A_GiveInventory("Flare", 5)
    Stop
  }
}
