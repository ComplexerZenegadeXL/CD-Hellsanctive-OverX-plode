Actor ELegBarrelKaboom : BarrelKaboom
{
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 AAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ELegSpawnedExplosionSmall",frandom(-8,8),frandom(-8,8),frandom(0,12),frandom(-8,8),frandom(-8,8),frandom(0,3))
	Stop
  }
}

Actor ELegSmallExplosionFlames : SmallExplosionFlames
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  Scale 0.6
  Speed 3
  States
  {
  Spawn:
    EXPO A 4 Bright 
    EXPO BCDFGHII 1 Bright
    Stop
  }
}

Actor ELegSpawnedExplosionSmall : SpawnedExplosionSmall
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 4
	FXPO AA 0 A_CustomMissile ("LegendarySmokeFX2", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
