Actor EnragedLegendaryAssaultCaptain : LegendaryAssaultCaptain
{
  Health 1300
  Speed 20
  +BRIGHT
  SeeSound "Elasgguy/sight"
  PainSound "Elasgguy/pain"
  DeathSound "Elasgguy/death"
  ActiveSound "Elasgguy/active"
  Obituary "$CFEnragedLegendaryAssaultCaptainObit"
  Tag "$CFEnrSguy"
  BloodColor "Red"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryASGGiver" 256
  DropItem "EnragedLegendaryShellPickup" 256 4
  DropItem "EnragedLegendaryShellBoxPickup" 128
  DropItem "LegendaryAmmoSphere" 93
  DropItem "EnragedLegendaryArmor" 85
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 240 2
  DropItem "Backpack" 200
  DropItem "ProxLauncherGiver" 128
  DropItem "ProxMines" 196
  DropItem "Armorplate" 210
  DropItem "Portablemedkit" 215
  DropItem "StimKit" 220
  DropItem "HealthFlask" 225
  DropItem "LegendaryPowerShard" 110
  DropItem "EnragedLegendaryPowerShard" 15
  DropItem "LegendaryRandomSphere" 16
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  var int user_ammo;
  States
  {
  Spawn:
	IASG A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:			
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
    IASG AZ 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IASG AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,403)
	TNT1 A 0 A_SetUserVar("user_music",1)
    IASG AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG CCDD 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(64,"Mine","Rush","DodgeLeft","DodgeRight","Chase")
	Loop
  Chase:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IASG AA 1 A_FastChase
	TNT1 A 0 A_Jump(1,"Heal")
	IASG A 0 A_JumpIfCloser(130,"Dodge")
	IASG AA 1 A_Chase
	IASG A 0 A_JumpIfCloser(130,"Dodge")
	IASG BB 1 A_Chase
	IASG A 0 A_JumpIfCloser(130,"Dodge")
	IASG BB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG A 0 A_JumpIfCloser(150,"Dodge")
	IASG CC 1 A_Chase
	TNT1 A 0 A_Jump(10,"Heal")
	IASG A 0 A_JumpIfCloser(150,"Dodge")
	IASG CC 1 A_FastChase
	IASG A 0 A_JumpIfCloser(130,"Dodge")
	IASG DD 1 A_FastChase
	IASG A 0 A_JumpIfCloser(130,"Dodge")
	IASG DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(95,"Mine")
	IASG A 0 A_Jump(128,"Dodge")
	Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostA")
	IASG A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostA")
	IASG A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostB")
	IASG B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostB")
	IASG B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostC")
	IASG C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostC")
	IASG C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostD")
	IASG D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("ELegASGZombieGhostD")
	IASG D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(85,"See")
	Loop
  GrenadeAttack:
    TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	IASG CE 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	IASG CE 4 A_FaceTarget
	IASG E 1 A_CustomMissile("ELACGrenade",32,0,90,2,4)
	IASG CE 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	IASG CE 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	IASG CE 4 A_FaceTarget
	IASG E 1 A_CustomMissile("ELACGrenade",32,0,-90,2,4)
	Goto Rail
  Heal:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	IASG A 5 
	TNT1 A 0 HealThing(5)
	TNT1 A 0 A_PlaySound("pickups/flask",0,1.0,0)
	GoTo See
  Heal2:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	IASG A 5 
	TNT1 A 0 HealThing(15)
	TNT1 A 0 A_PlaySound("pickups/pstimpack",0,1.0,0)
	GoTo See
  Heal3:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	IASG A 5 
	TNT1 A 0 HealThing(25)
	TNT1 A 0 A_PlaySound("pickups/pmedkit",0,1.0,0)
	GoTo See
  SeeNoDodge:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IASG AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IASG CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Goto Chase
  Dodge:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IASG A 1 A_FaceTarget
	IASG E 0 ThrustThingZ(0,20,0,0)
	IASG A 0 A_Jump(256, "DodgeRight", "DodgeLeft")
  DodgeLeft:
	IASG E 0 ThrustThing(angle*256/360+192,15,0,0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	Goto SeeNoDodge
  DodgeRight:
	IASG E 0 ThrustThing(angle*256/360+64,15,0,0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	Goto SeeNoDodge
  Missile:
	TNT1 A 0 A_JumpIfCloser(600,1)
	Goto Rail
    TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	IASG E 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    TNT1 A 0 A_JumpIf(user_ammo >= 16,"Reload")
    IASG E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_ammo,user_ammo+1)
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",5)
	TNT1 A 0 A_SpawnItemEx("RedShellCasing",-8,7,30,4,0,frandom(3.0,4.0),frandom(-90, -80),SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",frandom(28,34),0,Random(-6,6))
	IASG F 2 A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	IASG E 4 A_FaceTarget
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_Jump(12,"Rail")
    TNT1 A 0 A_Jump(6,"Heal")
    TNT1 A 0 A_Jump(5,"Heal2")
    TNT1 A 0 A_Jump(4,"Heal3")
    Goto Missile+4
  Rail:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_ammo >= 13,"Reload")
	IASG E 0 A_PlaySound("LShotgun/Cock")
	IASG EEEE 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",5)
	TNT1 A 0 A_SetUserVar(user_ammo,user_ammo+4)
	IASG F 4 A_CustomMissile("ELegCaptainRail",32)
	TNT1 A 0 A_JumpIf(user_ammo >= 16,"Reload")
	Goto See
  Strafing:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IASG AA 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IASG BB 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IASG CC 3 A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IASG DD 3 A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Mine:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	IASG C 11 
	TNT1 AA 0 A_CustomMissile("ELACThrownMine",32,0,frandom(-25,25),2,15)
	IASG CCCCEEEEC 3
	Goto See
  Reload:
    TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("lasgguy/asgout")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0,frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    IASG E 48 A_SetUserVar(user_ammo,0)
    IASG E 8 A_PlaySound("lasgguy/asgin") 
	IASG E 20 A_PlaySound("LShotgun/Cock")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  Pain:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	IASG G 3 A_Jump(20,"Protection")
    IASG G 3 A_Pain
	TNT1 A 0 A_Jump(192,"Missile")
	TNT1 A 0 A_Jump(40,"Dodge")
    Goto See
  PainMissile:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	IASG G 3
    IASG G 3 A_Pain
    Goto Missile	
  Protection:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	IASG E 2 ACS_NamedExecuteAlways("EnragedLegendaryProtection")
	Goto See
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    IASG H 5
    IASG I 5 A_Scream
    IASG J 5 A_Fall
	IASG J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IASG K 5
    IASG L -1
    Stop
  LegendarySoul:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IASG H 5
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IASG I 5 A_Scream
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IASG J 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,27)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	IASG J 5 A_SpawnItem("BodyCrash")
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IASG K 5
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	IASG L 140
	IASG L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	IASG LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_SpawnItem("ELegSoulEventSmokeSpawner",1)
	TNT1 A 0 A_SpawnItemEx("EnragedLegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	IASG L -1
    Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
    IASG O 5 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IASG P 5 A_XScream
    IASG Q 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,27)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
    IASG RSTUV 5
    IASG W -1
    Stop
  }
}

Actor ELegASGZombieGhostA : LegASGZombieGhostA
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    IASG A 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor ELegASGZombieGhostB : ELegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    IASG B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor ELegASGZombieGhostC : ELegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    IASG C 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor ELegASGZombieGhostD : ELegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    IASG D 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor ELACGrenade : LACGrenade
{
  Obituary "$CFELACGrenadeObit"
  States
  {
  Spawn:
	TNT1 A 0
	HGN1 A 3 A_StopSound
	HGN1 BCDEFGHABCDEFGHABCDEFGH 3
	Goto Death      
  Death: 
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	TNT1 A 0 A_PlaySound("weapons/hgrenadeex")
	TNT1 A 0 A_SpawnItemEx ("ELegBarrelKaboom")
	TNT1 A 0 A_Explode(Random(175,200),350)
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	MISL B 4 Bright
	MISL CD 4 Bright A_SetTranslucent(0.75,1)
	Stop
  }
}

Actor ELACThrownMine : LACThrownMine
{
  Obituary "$CFELACThrownMineObit"
  States
  {
  Spawn:
	//TNT1 A 0
	//TNT1 A 0 A_StopSound
    //Goto Thrown
	ILIN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_CheckFloor("Death")
	ILIN BBBBBBBBBB 1 Bright A_CheckFloor("Death")
	TNT1 A 0 A_CountDown
	Loop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Scream
	TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
	ILIN A 1 A_CustomMissile("ELACLiveMine",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)  //A_SpawnItem("ELACLiveMine")
	Stop
  }
}

Actor ELACLiveMine : LACLiveMine
{
  Obituary "$CFELACLiveMineObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	ILIN AAAB 10
	//LLIN AB 1
  SpawnLoop:
	ILIN AAA 10 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Attack")
	ILIN B 10 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Attack")
	TNT1 A 0 A_JumpIf(user_counter >= 18,"Attack")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	Loop
  Attack:
  Death:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	ILIN B 15 Bright A_PlaySound("weapons/minebeep")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Explode(Random(225,250),230,0)
	TNT1 A 0 A_PlaySound("weapons/mineexplode")
	TNT1 A 0 A_SpawnItemEx ("ELegBarrelKaboom")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
    TNT1 AAAA 0 A_CustomMissile("EKaboomLN2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(20,160))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(20,160))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    Stop
  }
}

