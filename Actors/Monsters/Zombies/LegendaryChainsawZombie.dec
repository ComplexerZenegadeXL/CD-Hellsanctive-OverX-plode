Actor LegendaryChainsawZombie 18500
{
  //$Category Monsters/LCA/DJB
  //$Sprite LCSZA1
  //$Title "Legendary Chainsaw Zombie"
  Monster
  Health 2000
  Height 56
  Radius 20
  Speed 30
  Mass 150
  PainChance 1
  Species "Zombie"
  BloodColor "Blue"
  PainChance "Legendary", 0
  PainChance "Legendary1", 0
  var int user_music;
  +BOSS
  +NOFEAR
  +BOSSDEATH
  +NOICEDEATH
  +NOTIMEFREEZE
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +DONTHARMSPECIES
  +NOTELEFRAG
  Species "Fiends"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PDTBFG", 0.2
  DamageFactor "PDTBFGTracer", 0.2
  DamageFactor "PlayerDevBall", 0.12
  DamageFactor "PlayerDevBall2", 0.12
  DamageFactor "PlayerDevTracer", 0.12
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "LegendaryPlayer", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.6
  DamageFactor 0.7
  //No Infighting
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LACGrenade", 0.0
  DamageFactor "LSSGGrenade", 0.0
  //DropItem "LegendaryChainsawGiver", 250
  DropItem "LDemonAmmoPickup", 250
  DropItem "LDemonAmmoBoxPickup", 125
  DropItem "LegendaryArmor" 90
  DropItem "LegendaryAmmoSphere" 93
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 240
  DropItem "Backpack" 200
  DropItem "Armorplate" 210
  DropItem "Portablemedkit" 215
  DropItem "StimKit" 220
  DropItem "HealthFlask" 225
  DropItem "LegendaryPowerShard" 35
  DropItem "LegendaryPowerSphere" 35
  SeeSound "LegChainsawZomb/sight" 
  ActiveSound "lcmdo/active"
  AttackSound "weapons/sawsound"
  PainSound "LegChainsawZomb/Pain"
  DeathSound "LegChainsawZomb/Death"
  Tag "$CFLegChainZom"
  Obituary "$CFLegendaryChainsawZombieObit"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LCSZ A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	LCSZ A 10 Bright A_Look
	Loop
  Idle:
	TNT1 A 0 A_PlaySound("weapons/legChainSawIdle",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ A 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ A 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ A 3 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ B 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ B 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ B 3 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ C 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ C 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ C 3 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ D 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ D 3 Bright A_Wander
	TNT1 A 0 A_Look
	LCSZ D 3 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,27)
	TNT1 A 0 A_SetUserVar("user_music",1)
	LCSZ AAABBBCCCDDD 2 Bright A_FastChase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,27)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_PlaySound("weapons/legChainSawIdle",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ AAA 2 Bright A_FastChase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ BBB 2 Bright A_FastChase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ CCC 2 Bright A_FastChase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ DDD 2 Bright A_FastChase
	Loop
  Missile:
	TNT1 A 0 A_Jump(80,"LegRipper")
	TNT1 A 0 A_Jump(160,"LegCharge")
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",CHAN_WEAPON,1.0,1)
	LCSZ A 1 Bright
	LCSZ AAAAA 4 Bright A_FaceTarget
	LCSZ A 1 Bright A_Jump(256,"Missile2")
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,"Missile2")
	Goto ChargeStop
  Missile2:
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("ChainSawJumping",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ EF 2 Bright A_CustomMissile("LegChainSawAttack",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_Recoil(-10)
	LCSZ EFEF 1 Bright A_JumpIfCloser(90,"Melee")
	Goto See
  LegRipper:		
	LCSZ EEEFFF 3 Bright A_FaceTarget
	LCSZ EFE 3 Bright A_CustomMissile("LegChainRipper",32,0,frandom(-2,2))
	TNT1 A 0 A_FaceTarget
	LCSZ EFE 3 Bright A_CustomMissile("LegChainRipper",32,0,frandom(-2,2))
	TNT1 A 0 A_FaceTarget
	LCSZ EFE 3 Bright A_CustomMissile("LegChainRipper",32,0,frandom(-2,2))
	LCSZ F 2 Bright A_FaceTarget
	Goto See
  LegCharge:
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",CHAN_WEAPON,1.0,1)
	LCSZ AAAAA 4 Bright A_FaceTarget
  ChargeAttack:
	TNT1 A 0 A_SetUserVar("user_effect_type",17)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_Recoil(-100)
	LCSZ AA 2 Bright A_FaceTarget
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LCHSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("ChainSawJumping",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LCSZ EF 2 Bright A_CustomMissile("LegChainSawAttack",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("LCHSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LCSZ EFEF 1 Bright A_JumpIfCloser(90,"Melee2")
	Goto Melee2
  ChargeStop:
	LCSZ E 1 Bright A_Stop
	Goto See		
  Melee:
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-5)
	TNT1 A 0 A_TakeInventory("ChainSawJumping",1)
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_CustomMissile("LegChainSawAttack",18,0,0,CMF_AIMDIRECTION)
	LCSZ EF 2 Bright A_CustomMissile("LegChainSawAttack",18,0,0,CMF_AIMDIRECTION)
	LCSZ EFEF 1 Bright A_JumpIfCloser(90,"See")
	Goto See
  Melee2:
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 Bright A_SpawnItemEx("LCHSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-5)
	TNT1 A 0 A_TakeInventory("ChainSawJumping",1)
	TNT1 A 0 A_SpawnItem("LFiendFlameSpawner",0,0,0,0)
	TNT1 A 0 A_PlaySound("weapons/legChainSawAttack",CHAN_WEAPON,1.0,1)
	LCSZ EF 2 Bright A_CustomMissile("LegChainSawAttack",18,0,0,CMF_AIMDIRECTION)
	LCSZ EFEF 1 Bright A_JumpIfCloser(90,"Melee2")
	Goto See
  Pain:
	LCSZ G 3 Bright
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	LCSZ G 3 Bright A_Pain
	Goto See
  Death:
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	LCSZ H 5 A_Scream
	LCSZ I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LCSZ J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LCSZ KL 5
	LCSZ M -1
	Stop
  LegendarySoul:
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ K 5 
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ L 5 
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LCSZ M 140
	TNT1 A 0 A_PlaySound("brain/spit",CHAN_VOICE,1.0,0,ATTN_NONE)
	LCSZ MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION,0)
	LCSZ M 525
	LCSZ M 5 A_FadeOut(0.1,1)
	Wait
  XDeath:
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	LCSZ N 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LCSZ O 5 A_XScream
	LCSZ P 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LCSZ QRSTUV 5
	LCSZ W -1
	Stop	
  }
}

Actor ChainSawJumping : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 1 
	TNT1 A 1 A_CheckFloor(1)
	Stop
	TNT1 A 1 A_Jump(160,2)
	TNT1 A 1 ThrustThingZ(0,25,0,1)
	Stop
	TNT1 A 1
	Stop
  }
}

Actor LegChainSawAttack
{
  Projectile
  Height 16
  Radius 16
  Speed 30
  Damage (Random(15,20))
  +EXTREMEDEATH
  +DONTHARMSPECIES
  +NOTIMEFREEZE
  DamageType "Legendary"
  SeeSound ""  
  DeathSound ""
  States
  {
  Spawn:
	TNT1 A 2
	Stop
  XDeath:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("NewBlood",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Stop
  }
}

Actor LCHSGhost
{
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.75
  +NOTIMEFREEZE
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	LCSZ A 2 A_FadeOut(0.09,1)
	Wait
  }
}

Actor LegChainRipper
{
  Projectile
  Height 6
  Radius 4
  Speed 70
  Scale 0.75
  BounceCount 5
  Damage (Random(20,40))
  Reactiontime 4
  +RIPPER
  +HEXENBOUNCE
  +NOTIMEFREEZE
  +USEBOUNCESTATE //this + a Bounce state
  +DONTHARMSPECIES
  Damagetype "Legendary"
  // SeeSound "weapons/nailfire" and this out
  //"weapons/sawrotating" doesn't even exist 
  States
  {
  Spawn:
    TNT1 A 0 
    SAWS EFGHABCDEFGHABCDEFGHABCDEFGHABCD 2 Bright A_SeekerMissile(90,90)
    TNT1 A 0 A_CountDown
    Loop
  Bounce:
    TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_WEAPON)
    SAWS EFGHABCDEFGHABCDEFGHABCDEFGHABCD 2 Bright A_SeekerMissile(90,90)
    TNT1 A 0 A_CountDown
    Loop
  Death:
  XDeath:
    SAWE A 1 A_Gravity
    SAWE A 7 A_CustomMissile("LegendaryBlueParticleSpawner",0,0,180,2)
    SAWE BCDEFG 8
    Stop
  }
}