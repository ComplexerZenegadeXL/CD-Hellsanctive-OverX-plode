Actor NemesisGrenadeLowGrav : NemesisGrenade { +LOWGRAVITY }

Actor NemesisGrenadeImpact : NemesisGrenadeLowGrav
{
  +LOWGRAVITY
  States
  {
  Spawn:
	HGN1 ABCDEFGH 3 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3))
	Loop
  Crash:
  Death:
  XDeath:
	HGN1 H 1 Bright A_ChangeFlag(EXTREMEDEATH,1)
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_Explode(Random(100,125),200,0,0)
	TNT1 A 0 Radius_Quake(2,24,0,15,0)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/hgrenadeex",CHAN_BODY)
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,128) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 1 A_SpawnItem("NemesisRocketEx")
	TNT1 A 0 A_Explode(Random(100,125),400,0,0)
	TNT1 A 0 A_PlaySound("Explosion",CHAN_WEAPON)
	TNT1 A 0 A_PlaySound("FAREXPL",CHAN_VOICE)
	TNT1 AAA 1 A_SpawnItemEx("NemesisRocketEx",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 48
	Stop
	}
}

Actor VexedNemesisASGZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	VNAS A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
	}
}

Actor VexedNemesisASGZombieGhostB : VexedNemesisASGZombieGhostA
