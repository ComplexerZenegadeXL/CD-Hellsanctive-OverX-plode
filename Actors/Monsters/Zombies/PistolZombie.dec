Actor PistolZombie : Zombieman
{
  Health 20
  Species ""
  AttackSound "weapons/tpfire"
  DropItem "HealthFlask" 35
  DropItem "ArmorCharge" 35
  DropItem "AmmoPack" 20
  DropItem "HandGrenadeAmmo" 50 1
  DropItem "MineAmmoRandomizer" 25 1
  DropItem "BulletMagPickup" 256 4
  DropItem "Handgun" 128
  Obituary "$CFPistolZombieObit"
  Tag "$CFPistolZom"
  States
  {
  Spawn:
    POSS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	POSS AB 10 A_Look
    Loop
  See: 
	POSS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	POSS CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop
  Missile:
	POSS EE 6 A_FaceTarget
	POSS F 4 Bright A_CustomBulletAttack (15.5, 0, 1, random(9,15), "ModdedBulletPuff", 0, CBAF_NORANDOM)
	POSS E 6 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	POSS F 4 Bright A_CustomBulletAttack (15.5, 0, 1, random(9,15), "ModdedBulletPuff", 0, CBAF_NORANDOM)
	POSS E 6 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	POSS F 4 Bright A_CustomBulletAttack (15.5, 0, 1, random(9,15) , "ModdedBulletPuff", 0, CBAF_NORANDOM)
	POSS E 6 A_SpawnItemEx("BulletCasing",30,0,30,frandom(2,4),frandom(3,6),frandom(3,6),0)
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
	POSS H 5
	POSS I 5 A_Scream 
	POSS J 5 A_Fall 
	POSS K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	POSS L -1
	Stop 
  XDeath:
	POSS M 3 A_XScream
	POSS N 3 A_GiveInventory("XDeathCheck",1)
	POSS O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	POSS P 3 A_Fall
	POSS QRST 3
	POSS U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	POSS KJIH 5
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	POSS UTSRQPONM 4
	Goto See
  }
}