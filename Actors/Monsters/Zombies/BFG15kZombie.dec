//Enemy from older complex version

Actor BFG15KMajor 18555
{ 
  //$Category Monsters/LCA/DJB
  //$Sprite 15KZA1
  //$Title "BFG15K Major"
  Health 460
  Radius 20
  Height 56
  Speed 8
  Mass 100
  PainChance 80
  Species ""
  DamageFactor "Zombie15K", 0.0
  DropItem "BFG15KGiver" 16 1
  DropItem "PortableMedkit" 190
  DropItem "ArmorPlate" 190
  DropItem "BackPack" 55
  DropItem "NewCellPackPickup" 256
  DropItem "HandGrenadeAmmo" 200 1
  DropItem "MineAmmoRandomizer" 123 1
  DropItem "FlareBox" 32
  Tag "$CFBfg15kZom"
  Monster 
  +FLOORCLIP
  +MISSILEMORE
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  AttackSound "weapons/bfg15kfire"
  Obituary "$CFBFG15KMajorObit"
  var int user_lowlag;
  States
  {
  Spawn:
	15KZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    15KZ A 10 A_Look
	15KX A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
    15KZ AABBCCDD 3 A_Chase
    Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	TNT1 A 0 A_PlayWeaponSound("weapons/bfg15kidle")
    15KZ AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    15KZ CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    Loop
  Missile:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    15KZ E 10 A_FaceTarget
	15KZ E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    15KZ F 6 Bright A_CustomMissile("ZombieBFG15KBall",34,0,0)
	15KZ E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    15KZ F 6 Bright A_CustomMissile("ZombieBFG15KBall",34,0,0)
	15KZ E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    15KZ F 6 Bright A_CustomMissile("ZombieBFG15KBall",34,0,0)
	15KZ E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    15KZ F 6 Bright A_CustomMissile("ZombieBFG15KBall",34,0,0)
	15KZ E 25 A_PlaySound("weapons/bfg15kcooldown")
    Goto See
  Pain:
    15KZ G 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    15KZ H 5 A_Scream
    15KZ I 5 A_Fall
    15KZ J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    15KZ KLM 5
    15KZ N -1
    Stop
  XDeath:
	15KZ O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    15KZ P 3 A_XScream
    15KZ R 3 A_Fall
    15KZ STUV 3
    15KZ W -1 
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	15KZ NMLKJIH 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	15KZ VUTSRQPO 5
	Goto See
  }
}

Actor ZombieBFG15KBall : BFG15KBall
{
  Height 15
  Radius 15
  Decal "BFG10K"
  Speed 75
  Damage (Random(125,200)) //35
  DamageType "Zombie15K"
  Scale 0.4
  +NOEXTREMEDEATH
  +THRUSPECIES
  Species "ZombieDeud"
  ExplosionDamage 50
  ExplosionRadius 25
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
}