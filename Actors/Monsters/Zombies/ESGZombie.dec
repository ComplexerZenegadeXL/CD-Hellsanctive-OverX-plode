Actor ExplosiveShotgunZombie : ShotgunZombie 17577
{ 
//$Category Monsters/CF
//$Sprite ESGZA1
//$Title "Explosive Shotgun Zombie"
  Health 150
  PainChance 80
  DropItem "StimKit" 180
  DropItem "ArmorBooster" 180
  DropItem "AmmoPack" 165
  DropItem "HandGrenadeAmmo" 196 1
  DropItem "MineAmmoRandomizer" 180 1
  DropItem "NewShellPickup" 192
  DropItem "NewShellBoxPickup" 96
  DropItem "Armorplate" 215 1
  DropItem "Portablemedkit" 230 1
  DropItem "Backpack" 80 1
  DropItem "ExplosiveShotgunGiver" 30
  DropItem "Flare", 64
  DamageFactor "EMGEx", 0.0
  AttackSound " "
  SeeSound "fem/sight"
  PainSound "fem/pain"
  DeathSound "fem/death"
  ActiveSound "fem/active"
  Obituary "$CFExplosiveShotgunZombieObit"
  Tag "$CFEsgZom"
  States
  {
  Spawn:
    ESGZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:	
	ESGZ A 10 A_Look
    Loop
  See:
    ESGZ AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    ESGZ CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    Loop
  Missile:
    ESGZ E 15 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-15,15),0)
    ESGZ F 5 Bright A_CustomBulletAttack(18,6,6,Random(12,18),"BulletPuff",0,CBAF_NORANDOM)
    ESGZ E 10 A_FaceTarget
	ESGZ E 8 A_PlaySound("weapons/ExplosiveSG/pump",7)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -8, 0, 30, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	ESGZ E 8
    Goto See
  Pain:
    ESGZ G 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    ESGZ H 5 A_Scream
    ESGZ I 5 A_Fall
    ESGZ J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ESGZ KLM 5
    ESGZ N -1
    Stop
  XDeath:
    ESGZ O 3 A_XScream
    ESGZ P 3 A_GiveInventory("XDeathCheck",1)
    ESGZ Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ESGZ R 3 A_Fall
    ESGZ STUV 3
    ESGZ W -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    ESGZ NMLKJIH 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ESGZ VUTSRQPO 5
	Goto See
  }
}