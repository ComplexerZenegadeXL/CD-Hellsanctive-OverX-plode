Actor LegendaryLieutenant : LegendaryAssaultCaptain
{
  Health 1150
  Speed 12
  PainChance 20
  Species "Zombie"
  +BRIGHT
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryCoachgunGiver" 202
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 130
  DropItem "LegendaryPowerShard" 30
  DropItem "LegendaryArmor" 92
  DropItem "LegendaryAmmoSphere" 95
  DropItem "HandGrenadeAmmo" 237 2
  DropItem "MineAmmoRandomizer" 242 2
  DropItem "Backpack" 202
  DropItem "Armorplate" 212
  DropItem "Portablemedkit" 217
  DropItem "StimKit" 222
  DropItem "HealthFlask" 227
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  SeeSound "Lieutenant/sight"
  AttackSound " "
  PainSound "Lieutenant/pain"
  DeathSound "Lieutenant/death"
  Obituary "$CFLegendaryLieutenantObit"
  Tag "$CFLegLieu"
  var int user_reload;
  States
  {
  Spawn:
	LSSZ A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  SpawnLoop:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LSSZ A 10 A_Look
	Loop
  Idle:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	LSSZ AA 3 A_Wander
	TNT1 A 0 A_Look
	LSSZ BB 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	LSSZ CC 3 A_Wander
	TNT1 A 0 A_Look
	LSSZ DD 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LSSZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,752)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	LSSZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	LSSZ CCDD 3 A_Chase
	TNT1 A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_Jump(64,"Dodge")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	Loop
  Rush:
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegLieutenantGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	TNT1 A 0 A_Jump(64,"Dodge")
	Loop
  Strafing:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LSSZ AA 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LSSZ BB 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LSSZ CC 3 A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LSSZ DD 3 A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Dodge:
	LSSZ A 1 A_FaceTarget
	LSSZ E 0 ThrustThingZ(0,20,0,0)
	LSSZ A 0 A_Jump(256,"DodgeRight","DodgeLeft")
  DodgeLeft:
	LSSZ E 0 ThrustThing(angle*256/360+192, 15, 0, 0)
	Goto See
  DodgeRight:
	LSSZ E 0 ThrustThing(angle*256/360+64, 15, 0, 0)
	Goto See
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_JumpIf(user_reload == 2,"Reload")
	TNT1 A 0 A_Jump(40,"Grenade")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_JumpIfCloser(300,"Double")
  Normal:
	LSSZ EE 4 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",CHAN_WEAPON)
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_SetUserVar(user_reload,1)
	LSSZ F 4 A_CustomBulletAttack(8.0,3.0,10,Random(25,35),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LSSZ EE 4 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_JumpIf(user_reload == 2,"Reload")
	TNT1 A 0 A_PlaySound("Coachgun/Fire2",CHAN_WEAPON)
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_SetUserVar(user_reload,2)
	LSSZ F 4 A_CustomBulletAttack(8.0,3.0,10,Random(25,35),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LSSZ EE 4 A_GiveInventory("LegZombieStrafing",1)
	Goto Reload
  Double:
	TNT1 A 0 A_JumpIf(user_reload == 1,"Normal")
	TNT1 A 0 A_FaceTarget(45)
	LSSZ E 5 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_FaceTarget(45)
	LSSZ E 5 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_FaceTarget(45)
	LSSZ E 5 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_PlaySound("Coachgun/Fire1",CHAN_WEAPON)
	TNT1 AAAAAAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_SetUserVar(user_reload,2)
	LSSZ F 5 A_CustomBulletAttack(22.5,10.0,20,Random(25,35),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LSSZ EEE 5 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Jump(64,"Grenade")
	Goto Reload
  Grenade:
	TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	LSSZ CE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	LSSZ E 1 Bright A_CustomMissile("LieutenantGrenade",32,0,0,2,4)
	TNT1 A 0 A_JumpIf(user_reload == 2,"Reload")
	Goto Dodge
  Reload:
	LSSZ E 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LSSZ A 6 A_PlaySound("Coachgun/Open")
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing",-8,6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	LSSZ B 1 A_SpawnItemEx("BlueShellCasing",-10,6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	LSSZ B 6 A_PlaySound("Coachgun/Load")
	TNT1 A 0 A_SetUserVar(user_reload,0)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LSSZ C 6 A_PlaySound("Coachgun/Close")
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LSSZ D 6
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_Jump(10,"Protection")
	LSSZ G 3 A_Jump(20,"Dodge")
	LSSZ G 3 A_Pain
	TNT1 A 0 A_Jump(192,"Missile")
	Goto See
  Protection:
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LSSZ E 2 ACS_NamedExecuteAlways("LegendaryProtection",0)
	Goto See
  Death:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	LSSZ H 6 A_Scream
	LSSZ I 6 A_ChangeFlag("BRIGHT",0)
	LSSZ J 6 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	LSSZ K 6 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LSSZ L -1
	Stop
  LegendarySoul:
	LSSZ H 6 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ I 6 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegSSGGuyGib",0,0,12,frandom(0.1,1.0),frandom(0.1,1.0),frandom(0.1,1.0),frandom(0,360),SXF_CLIENTSIDE)
	LSSZ J 6 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ K 6 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LSSZ L 6 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSSZ L 140 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LSSZ LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LSSZ L 525 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION,0)
	LSSZ L 5 A_FadeOut(0.1,1)
	Wait
  XDeath:
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	LSSZ M 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LSSZ N 5 A_XScream
	LSSZ O 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LSSZ PQRST 5
	LSSZ U -1
	Stop
  }
}

Actor LegLieutenantGhostA
{
  Alpha 0.7
  Renderstyle Translucent
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	LSSZ A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor LegLieutenantGhostB : LegLieutenantGhostA
{   
  States
  {
  Fade:
	LSSZ B 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegLieutenantGhostC : LegLieutenantGhostA
{   
  States
  {
  Fade:
	LSSZ C 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegLieutenantGhostD : LegLieutenantGhostA
{   
  States
  {
  Fade:
	LSSZ D 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegLieutenantGhostE : LegLieutenantGhostA
{   
  States
  {
  Fade:
	LSSZ E 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LieutenantGrenade : LegThrownGrenade { Obituary "%o was surprised by the grenade of a Legendary Lieutenant." }