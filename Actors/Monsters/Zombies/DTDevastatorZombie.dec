Actor DTDevastatorZombie 16550
{
  //$Category Monsters/LCA
  //$Sprite DEVZA1
  //$Title "DT-Devastator Zombie"
  Obituary "$CFDTDevastatorZombieObit"
  Health 350
  Radius 20
  Height 56
  Mass 100
  Speed 8
  PainChance 45
  Species ""
  DropItem "Armorplate" 186 2
  DropItem "Portablemedkit" 159 2
  DropItem "Backpack" 58 1
  DropItem "DemonTechDevastatorGiver" 55 1
  DropItem "HandGrenadeAmmo" 210 3
  DropItem "MineAmmoRandomizer" 210 3
  DropItem "DemonAmmoBoxPickup" 255 
  DamageFactor "ZombieDev", 0.0
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Monster
  +FLOORCLIP
  +QUICKTORETALIATE
  Tag "$CFDevaZom"
  States
  {
  Spawn:
    DEVZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DEVZ AZ 10 A_Look
	DEVZ Z 1 A_PlaySound("devastator/idle",6,1.0,1)
    Loop
  See:
    DEVZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
	DEVZ CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
	TNT1 A 0 A_PlayWeaponSound("devastator/idle")
    Loop
  Missile:
    DEVZ E 0 A_FaceTarget
	TNT1 A 0 A_StopSound(6)
    DEVZ E 0 A_PlaySound ("devastator/charge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
    DEVZ EEEEEEEEEEEEEEE 4 Bright A_FaceTarget
    DEVZ F 10 Bright
    DEVZ F 0 A_PlaySound ("devastator/fire")
	TNT1 A 0 A_FaceTarget
	DEVZ F 10 Bright A_CustomMissile("ZombieDevastatorBall",32,10,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    DEVZ E 50
    goto See
  Pain:
    DEVZ G 3
    DEVZ G 3 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    DEVZ H 5 A_StopSound(6)
    DEVZ I 5 A_Scream
    DEVZ J 5 A_NoBlocking
    DEVZ KLM 5
	DEVZ N 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    DEVZ N -1
    Stop
  XDeath:
    DEVZ O 5 A_StopSound(6)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	DEVZ O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    DEVZ P 5 A_XScream
    DEVZ Q 5 A_NoBlocking
    DEVZ RS 5
    DEVZ T -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	DEVZ NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	DEVZ TSRQPO 5
	Goto See
  }
}