Actor NemesisAssaultCaptain : LegendaryAssaultCaptain 28001
{
  Health 1700
  Speed 20
  BloodColor "Black"
  PainChance 20
  DamageFactor 0.6
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Explosion", 0.2
  DamageFactor "PlayerDTRG", 0.4
  DamageFactor "DTRailgun", 0.4
  DamageFactor "PDTPuff", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "PlayerPyro", 0.2
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "VileFires", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "Superweapon", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "StimKit", 222
  DropItem "HealthFlask", 227
  DropItem "Armorplate", 212
  DropItem "LegendaryAmmoSphere", 95
  DropItem "PortableMedkit", 217
  DropItem "ProxLauncherGiver" 128
  DropItem "ProxMines" 196
  DropItem "EnragedLegendaryArmor", 92
  DropItem "EnragedLegendaryPowerShard", 35
  DropItem "HandGrenadeAmmo", 237, 2
  DropItem "MineAmmoRandomizer", 242, 2
  DropItem "BackPack", 256
  DropItem "NemesisShellPickup", 256
  DropItem "NemesisShellBoxPickup", 130
  //DropItem "NemesisAssaultShotgunGiver", 128
  DropItem "AmpGogglesUpgrade", 64
  SeeSound "NemesisAssaultCaptain/sight"
  AttackSound " "
  PainSound "NemesisAssaultCaptain/pain"
  DeathSound "NemesisAssaultCaptain/death"
  ActiveSound "NemesisAssaultCaptain/active"
  Obituary "$CFNemesisAssaultCaptainObit"
  Tag "$CFNemSguy"
  var int user_infammo;
  var int user_deathtimer;
  var int user_deathtimeractive;
  States
  {
  Spawn:
	NASG A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	NASG AZ 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NASG AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_deathtimeractive == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("NemesisDeathTimerForVexed",0)
	TNT1 A 0 A_SetUserVar("user_deathtimeractive",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,701)
	TNT1 A 0 A_SetUserVar("user_music",1)
	NASG AABB 4 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG CCDD 4 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(40,"Teleport")
	TNT1 A 0 A_Jump(64,"Mine")
	TNT1 A 0 A_Jump(64,"Rush")
	TNT1 A 0 A_Jump(64,"DodgeLeft","DodgeRight")
	TNT1 A 0 A_Jump(64,"Chase")
	Loop
  Chase:
	NASG AA 1 Bright A_FastChase
	TNT1 A 0 A_Jump(1,"Heal")
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	NASG AA 1 Bright A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	NASG BB 1 Bright A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	NASG BB 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	NASG CC 1 Bright A_Chase
	TNT1 A 0 A_Jump(10,"Heal")
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	NASG CC 1 Bright A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	NASG DD 1 Bright A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	NASG DD 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(40,"Teleport")
	TNT1 A 0 A_Jump(95,"Mine")
	TNT1 A 0 A_Jump(128,"Dodge")
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisASGZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NASG D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(85,"See")
	Loop
  Heal:
	NASG A 5 Bright A_SetUserVar("user_effect_type",11)
	TNT1 A 0 HealThing(5)
	TNT1 A 0 A_PlaySound("pickups/flask",0,1.0,0)
	Goto See
  Heal2:
	NASG A 5 Bright A_SetUserVar("user_effect_type",11)
	TNT1 A 0 HealThing(15)
	TNT1 A 0 A_PlaySound("pickups/pstimpack",0,1.0,0)
	Goto See
  Heal3:
	NASG A 5 Bright A_SetUserVar("user_effect_type",11)
	TNT1 A 0 HealThing(25)
	TNT1 A 0 A_PlaySound("pickups/pmedkit",0,1.0,0)
	Goto See
  InfiniteAmmo:
	TNT1 A 0 A_JumpIf(user_infammo == 1,"Missile")
	NASG A 5 Bright A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("EnemyInfiniteAmmo",0)
	TNT1 A 0 A_PlaySound("legammo/use",0,1.0,0,0.5)
	Goto See
  SeeNoDodge:
	NASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Goto Chase
  Dodge:
	NASG A 1 Bright A_FaceTarget
	TNT1 A 0 ThrustThingZ(0, 20, 0, 0)
	TNT1 A 0 A_Jump(256, "DodgeRight", "DodgeLeft")
  DodgeLeft:
	TNT1 A 0 ThrustThing(angle*256/360+192, 15, 0, 0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	TNT1 A 0 A_Jump(20,"InfiniteAmmo")
	Goto SeeNoDodge
  DodgeRight:
	TNT1 A 0 ThrustThing(angle*256/360+64, 15, 0, 0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	TNT1 A 0 A_Jump(20,"InfiniteAmmo")
	Goto SeeNoDodge
  Teleport:
	NASG A 1 Bright A_UnSetShootable
	TNT1 AAAA 0 A_SpawnItemEx("NemesisHellionSmokeSpawner")
	NASG AAAAAAAAAA 1 Bright A_FadeOut(0.1,0)
	NASG A 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	NASG A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAA 0 A_SpawnItemEx("NemesisHellionSmokeSpawner")
	NASG AAAAAAAAAA 1 Bright A_FadeIn(0.1)
	NASG A 1 Bright A_SetShootable
	Goto See  
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnsetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(30,"InfiniteAmmo")
	TNT1 A 0 A_Jump(30,"SuperCombo")
	NASG E 3 Bright A_GiveInventory("NemesisLegZombieStrafing",1)
  MissileLoop:
	TNT1 A 0 A_JumpIf(user_infammo == 1,"MissileLoopInfAmmo")
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_JumpIfInventory("ASGZAmmo",16,"Reload")
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("ASGZAmmo",1)
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",-8,7,30,4,0,frandom(3,4),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("NemesisASG/Fire",5)
	//TNT1 AAAA 0 Bright A_CustomMissile("NemesisTracer",Random(28,34),0,Random(6,-6),0)
	//TNT1 A 0 Bright A_CustomBulletAttack(15,12,4,0,"NemesisASGPuffExplode",0)
	//NASG F 2 Bright A_CustomBulletAttack(15,12,4,Random(5,15)*6,"NemesisASGBulletPuff",0,CBAF_NORANDOM)
	TNT1 AAAAAAA 0 A_CustomMissile("NemesisASGBall",32,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-6,6))
	NASG F 2 Bright A_CustomMissile("NemesisASGBall",32,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-6,6))
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 Bright A_CPosRefire
	TNT1 A 0 A_Jump(6,"Heal")
	TNT1 A 0 A_Jump(5,"Heal2")
	TNT1 A 0 A_Jump(4,"Heal3")
	TNT1 A 0 A_Jump(3,"InfiniteAmmo")
	TNT1 A 0 A_Jump(20,"MidAttackTeleport")
	TNT1 A 0 A_Jump(10,"Grenade")
	TNT1 A 0 A_JumpIfCloser(300,"MidAttackTeleport")
	Loop
  MissileLoopInfAmmo:
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_TakeInventory("ASGZAmmo",16)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",-8,7,30,4,0,frandom(3,4),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("NemesisASG/Fire",5)
	//TNT1 AAAA 0 Bright A_CustomMissile("NemesisTracer",Random(28,34),0,Random(6,-6),0)
	//TNT1 A 0 Bright A_CustomBulletAttack(15,12,4,0,"NemesisASGPuffExplode",0)
	//NASG F 2 Bright A_CustomBulletAttack(15,12,4,Random(5,15)*6,"NemesisASGBulletPuff",0,CBAF_NORANDOM)
	TNT1 AAAAAAA 0 A_CustomMissile("NemesisASGBall",32,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-6,6))
	NASG F 2 Bright A_CustomMissile("NemesisASGBall",32,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-6,6))
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_Jump(6,"Heal")
	TNT1 A 0 A_Jump(5,"Heal2")
	TNT1 A 0 A_Jump(4,"Heal3")
	TNT1 A 0 A_Jump(10,"Grenade")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NASG AA 3 Bright A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NASG BB 3 Bright A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NASG CC 3 Bright A_GiveInventory("NemesisLegZombieStrafing",1)  
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NASG DD 3 Bright A_GiveInventory("NemesisLegZombieStrafing",1)
	Goto See
  Mine:
	NASG C 1 Bright A_JumpIf(user_infammo == 1,"MineInfAmmo")
	NASG C 12 Bright A_CustomMissile("NemesisSpringMineSet",32,0,0,2,15)
	NASG E 12 Bright
	NASG C 3 Bright
	Goto See
  MineInfAmmo:
	NASG C 1 Bright
	NASG C 12 Bright A_CustomMissile("NemesisSpringMineSet",32,0,0,2,15)
	NASG E 12 Bright
	TNT1 A 0 A_SetAngle(random(0,360))
	NASG C 3 Bright
	TNT1 A 0 A_Jump(64,"See")
	Loop
  Grenade:
	TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	NASG CE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	NASG E 1 Bright A_CustomMissile("NemesisGrenade",32,0,0,2,4)
	Goto Dodge
  MidAttackTeleport:
	NASG E 1 Bright A_UnSetShootable
	NASG E 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG EEE 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG EEE 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG EEE 1 Bright A_FadeOut(0.1,0)
	NASG E 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	NASG E 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NASG EEEEEEEEEE 1 Bright A_FadeIn(0.1)
	NASG EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 1 Bright A_FadeIn(0.1)
	NASG E 1 Bright A_SetShootable
	Goto Grenade
  SuperCombo:
	TNT1 A 0 A_JumpIf(user_infammo == 1,"Missile")
	NASG A 5 Bright A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("EnemyInfiniteAmmo",0)
	TNT1 A 0 A_PlaySound("legammo/use",0,1.0,0,0.5)
  SuperComboASG:
	TNT1 A 0 A_JumpIf(user_infammo == 0,"See")
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_TakeInventory("ASGZAmmo",16)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",-8,7,30,4,0,frandom(3,4),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("NemesisASG/Fire",5)
	TNT1 AAAAAA 0 Bright A_CustomMissile("NemesisTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 Bright A_CustomBulletAttack(15,12,4,0,"NemesisASGPuffExplode",0)
	NASG F 2 Bright A_CustomBulletAttack(15,12,6,Random(6,12)*5,"NemesisASGBulletPuff",0,CBAF_NORANDOM)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_TakeInventory("ASGZAmmo",16)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",-8,7,30,4,0,frandom(3,4),frandom(-80,-90),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("NemesisASG/Fire",5)
	TNT1 AAAAAA 0 Bright A_CustomMissile("NemesisTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 Bright A_CustomBulletAttack(15,12,4,0,"NemesisASGPuffExplode",0)
	NASG F 2 Bright A_CustomBulletAttack(15,12,6,Random(6,12)*5,"NemesisASGBulletPuff",0,CBAF_NORANDOM)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	TNT1 A 0 A_TakeInventory("ASGZAmmo",16)
	NASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("NemesisShellCasing",-8,7,30,4,0,frandom(3,4),frandom(-90,-980),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("NemesisASG/Fire",5)
	TNT1 AAAAAA 0 Bright A_CustomMissile("NemesisTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 Bright A_CustomBulletAttack(15,12,4,0,"NemesisASGPuffExplode",0)
	NASG F 2 Bright A_CustomBulletAttack(15,12,6,Random(6,12)*5,"NemesisASGBulletPuff",0,CBAF_NORANDOM)
	NASG E 4 Bright A_FaceTarget
	Goto MidSuperCombo
  SuperComboGrenade:
	TNT1 A 0 A_JumpIf(user_infammo == 0,"See")
	TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	NASG CE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	NASG E 1 Bright A_CustomMissile("NemesisGrenade",32,0,0,2,4)
	TNT1 A 0 A_Jump(32,"See")
	Goto MidSuperCombo
  SuperComboMines:
	NASG C 1 Bright A_JumpIf(user_infammo == 0,"See")
	NASG C 6 Bright A_CustomMissile("NemesisSpringMineSet",32,0,0,2,15)
	NASG E 6 Bright
	TNT1 A 0 A_SetAngle(frandom(0,360))
	NASG C 3 Bright
	TNT1 A 0 A_Jump(100,"MidSuperCombo")
	TNT1 A 0 A_Jump(32,"See")
	Loop
  MidSuperCombo:
	TNT1 A 0 A_JumpIf(user_infammo == 0,"See")
	NASG E 1 Bright A_UnSetShootable
	NASG E 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 3 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 3 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 3 Bright A_FadeOut(0.1,0)
	NASG E 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	NASG E 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NASG EEEEEEEEEE 1 Bright A_FadeIn(0.1)
	NASG E 3 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 3 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 3 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("NemesisLegZombieStrafing",1)
	NASG E 1 Bright A_FadeIn(0.1)
	NASG E 1 Bright A_SetShootable
	TNT1 A 0 A_Jump(128,"SuperComboASG","SuperComboMines")
	Goto SuperComboGrenade
  Reload:
	TNT1 A 0 A_ChangeFlag("NoPain",1)
	TNT1 A 0 A_PlaySound("lasgguy/asgout")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner",-8,7,30,4,0,frandom(3,4),frandom(-90,-80),SXF_CLIENTSIDE)
	NASG E 20 Bright A_TakeInventory("ASGZAmmo",16)
	NASG E 8 Bright A_PlaySound("lasgguy/asgin") 
	NASG E 10 Bright A_PlaySound("LShotgun/Cock")
	TNT1 A 0 A_ChangeFlag("NoPain",0)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(30,"Teleport")
	NASG G 3 Bright A_Jump(20,"Dodge")
	NASG G 3 Bright A_Pain
	TNT1 A 0 A_Jump(40,"Dodge")
	TNT1 A 0 A_Jump(192,"Missile")
	Goto See
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",3)
	TNT1 A 0 ACS_NamedExecuteWithResult("VexCheck",0,10)
	NASG H 5 A_Jump(36,"LegendarySoul")
	NASG I 5 A_Scream
	NASG J 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("NemesisDust",random(1,3),256)
	NASG J 5 A_SpawnItem("BodyCrash",0,0,0,0)
	NASG K 5
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NASG L -1
	Stop
  LegendarySoul:
	TNT1 A 0 A_StopSound(6)
	NASG H 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NASG I 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NASG J 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NASG J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NASG K 5
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NASG L 140
	NASG L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	NASG LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	NASG L -1
	Stop
  VexedSpawn:
	NASG G 3 Bright A_Pain
	NASG G 0 A_PlaySoundEx("brain/spit",7,0,2)
	NASG GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisLightning")
	NASG GGGGGGGGGGGG 2 Bright A_SpawnItemEx("VexedNemesisFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisAssaultCaptain",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop	
  MoreStuff:
	NASG L 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	NASG LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 1 A_SpawnItem("NemesisAssaultCaptainItemRandomizer")
	NASG L 1 A_SpawnItemEx("NemesisZombieSuperItemRandomizer")
	NASG L -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 ACS_NamedExecuteWithResult("VexCheck",0,10)
	NASG O 5 A_SpawnItemEx("NemesisGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NASG P 5 A_XScream
	NASG Q 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("NemesisDust",random(1,3),256)
	NASG RSTUV 5
	TNT1 A 0 A_Jump(100,"MoreStuff2")
	NASG W -1
	Stop
  MoreStuff2:
	NASG W 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	NASG WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW 1 A_SpawnItem("NemesisAssaultCaptainItemRandomizer")
	NASG W 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	NASG W -1
	Stop
  }
}

Actor NemesisAssaultCaptainInfAmmo : PowerTargeter  //Did not recode this because it is not used.  Use it and you will break GZDoom.
{
  States
  {
  Targeter:
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 6 A_SpawnItemEx("LegendaryBluePowerLine",random(32,-32),random(32,-32),random(8,48),0,0,random(1,4),0,SXF_CLIENTSIDE,0) 
	Loop
  }
}

