Actor NemesisAssaultCaptainInfAmmoCheck : Inventory {}
Actor CFGrenadeTime : Inventory { Inventory.Maxamount 35 }

Actor NemesisAssaultCaptainInfAmmoGiver : PowerupGiver
{
  +NOTIMEFREEZE
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ADDITIVETIME
  Inventory.MaxAmount 0
  Powerup.Type "NemesisAssaultCaptainInfAmmo"
  Powerup.Duration -15
}

Actor NemesisASGZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	NASG A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor NemesisASGZombieGhostB : NemesisASGZombieGhostA
{   
  States
  {
  Fade:
	NASG B 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor NemesisASGZombieGhostC : NemesisASGZombieGhostA
{   
  States
  {
  Fade:
	NASG C 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor NemesisASGZombieGhostD : NemesisASGZombieGhostA
{   
  States
  {
  Fade:
	NASG D 2 A_FadeOut(0.1,1)
	Loop
	}
}

Actor NemesisGrenadeSmoke : TrueNemesisHellionSmoke { Scale 0.1 }

Actor NemesisGrenade : ThrownGrenade
{
  Species "LegendaryZombie"
  DamageType "Legendary"
  Obituary "$CFNemesisGrenadeObit"
  States
  {
  Spawn:
	TNT1 A 0 A_StopSound
	HGN1 A 3 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 B 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 C 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 D 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 E 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 F 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 G 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 H 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 A 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 B 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 C 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 D 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 E 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 F 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 G 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 H 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 A 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 B 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 C 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 D 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 E 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 F 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 G 3 A_GiveInventory("CFGrenadeTime",1)
	TNT1 A 0 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 H 3 A_GiveInventory("CFGrenadeTime",1)
	Goto Death
  Crash:
  Death:
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	HGN1 H 1 A_SpawnItemEx("NemesisGrenadeSmoke",0,0,2,0,0,frandom(0,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HGN1 H 1 A_GiveInventory("CFGrenadeTime",1)
	HGN1 H 1 A_JumpIfInventory("CFGrenadeTime",35,"XDeath")
	Goto Death+2
  XDeath:
	HGN1 H 1 A_ChangeFlag(EXTREMEDEATH,1)
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_Explode(Random(100,125),200,0,0)
	TNT1 A 0 Radius_Quake(2,24,0,15,0)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/hgrenadeex",CHAN_BODY)
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 1 A_SpawnItem("NemesisRocketEx")
	TNT1 A 0 A_Explode(Random(100,125),400,0,0)
	TNT1 A 0 A_PlaySound("Explosion",CHAN_WEAPON)
	TNT1 A 0 A_PlaySound("FAREXPL",CHAN_VOICE)
	TNT1 AAA 1 A_SpawnItemEx("NemesisRocketEx",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 48
	Stop
  }
}

Actor NemesisSpringMineSet : SpringMineSet
{
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	NSPM A 1 Bright
	Loop
  Death:
	TNT1 A 0
	TNT1 A 1 A_CustomMissile("NemesisSpringMineActive",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Stop
  } 
}

Actor NemesisSpringMineActive : SpringMineActive
{
  -FRIENDLY
  +THRUSPECIES
  +MTHRUSPECIES
  +NORADIUSDMG
  Species "LegendaryZombie"
  DamageType "Legendary"
  Obituary "$CFNemesisSpringMineActiveObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 A 0 A_PlaySound("SMNSET1")
	NSPM AAAAAAAAAA 2
	TNT1 A 0 A_PlaySound("SMNSET2")
	NSPM AD 1
  SpawnLoop:
	NSPM ADAD 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Attack")
	TNT1 A 0 A_JumpIf(user_counter >= 260,"Attack")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	Loop
  Attack:
  Death:
	NSPM ABC 2
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 ThrustThingZ(0,45,0,0)
	TNT1 A 0 A_PlaySound("MINLNCH")
	NSPM AAAAAAAAA 2
	NSPM AAA 1
	TNT1 A 0 A_PlaySound("SPRNMNXP")
	TNT1 A 0 A_Explode(Random(275,300),200,0,1,50)
	//TNT1 A 0 A_SpawnItemEx("SMineExplosion",0,0,5,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,0)
	TNT1 A 10 A_SpawnItemEx("WhiteProjExplodeLarge",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor NemesisAssaultCaptainItemRandomizer
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(25,"Ammo")
	TNT1 A 0 A_Jump(256,"Health","Armor")
  Health:
	TNT1 A 1 A_SpawnItemEx("NemesisHealthBonusMax",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
	Stop
  Armor:
	TNT1 A 1 A_SpawnItemEx("NemesisArmorBonusMax",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
	Stop
  Ammo:
	TNT1 A 1 A_SpawnItemEx("NemesisShellPickup",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
	Stop
  }
}
