Actor RepeaterZombie 17580
{
//$Category Monsters/CF
//$Sprite REPZA1
//$Title "Repeater Zombie"
  Monster
  Health 200
  Height 56
  Radius 20
  Speed 8
  PainChance 30
  PainChance "Mine", 128
  Species ""
  +FLOORCLIP
  +QUICKTORETALIATE
  DropItem "PortableMedkit", 200, 1
  DropItem "HealthFlask", 250, 2
  DropItem "ArmorPlate", 200, 1
  DropItem "AmmoPack", 100, 2
  DropItem "HandGrenadeAmmo", 100, 1
  DropItem "MineAmmoRandomizer", 100, 1
  DropItem "NewCellPackPickup", 128
  DropItem "PlasmaRepeaterGiver", 32
  DropItem "ShieldSphere", 32, 1
  SeeSound "Grunt/Sight"
  ActiveSound "Grunt/Active"
  PainSound "Grunt/Pain"
  DeathSound "Grunt/Death"
  Obituary "$CFRepeaterZombieObit"
  Tag "$CFRepZom"
  States
  {
  Spawn:
	REPZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:	
	REPZ A 10 A_Look
	Loop
  Idle:
	TNT1 A 0 A_JumpIfInventory("RepeaterZombieFiring",1,"SpinDown")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	REPZ A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIfInventory("RepeaterZombieFiring",1,"SpinDown")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	REPZ AB 4 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,0,0)
	REPZ CD 4 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,0,0)
	Loop 
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_GiveInventory("RepeaterZombieFiring",1)
	TNT1 A 0 A_PlaySound("PlasmaRepeater/Spin",7)
	REPZ EEFF 7 A_FaceTarget
  Normal:
	REPZ G 1 Bright A_CustomMissile("ZombieRepeaterPlasma",32,0,frandom(-8,8))
	REPZ G 1 A_FaceTarget
	REPZ H 1 Bright A_CustomMissile("ZombieRepeaterPlasma",32,0,frandom(-8,8))
	REPZ H 1 A_FaceTarget
	TNT1 A 0 A_Monsterrefire(36,"See")
	Loop
  SpinDown:
	TNT1 A 0 A_PlaySound("PlasmaRepeater/Down",7)
	TNT1 A 0 A_TakeInventory("RepeaterZombieFiring",1)
	REPZ EFEEFF 3
	Goto See
  Pain:
	TNT1 A 0 A_StopSound(7)
	REPZ I 3
	REPZ I 3 A_Pain 
	Goto See 
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_StopSound(7)
	REPZ I 4
	REPZ J 5
	REPZ K 5 A_Scream 
	REPZ L 5 A_Fall
	REPZ M 5
	REPZ N -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(7)
	REPZ O 5
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,30,0,0,0,0,SXF_CLIENTSIDE)
	REPZ P 5 A_XScream
	REPZ Q 5
	REPZ R 5 A_Fall
	REPZ STUV 5
	REPZ W -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	REPZ NMLKJI 5
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	REPZ WVUTSRQPO 5
	Goto See
  } 
}

Actor RepeaterZombieFiring : Inventory { }

Actor ZombieRepeaterPlasma : OverseerPlasma { DamageType "Normal" }