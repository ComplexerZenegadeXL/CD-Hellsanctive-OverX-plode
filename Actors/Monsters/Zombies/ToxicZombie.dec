Actor ToxicZombie 30340
{
  //$Category Monsters/CF
  //$Sprite TOXZA1
  //$Title "Toxic Zombie"
  Monster
  Health 450
  Height 56
  Radius 20
  Mass 400
  Scale 1.075
  Speed 4
  BloodColor "Green"
  Painchance "Mine", 128
  PainChance "Acid", 0
  PainChance "Poison", 0
  PainChance "PoisonCloud", 0
  PainChance 45
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species ""
  DamageFactor "Acid", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  //No Infighting
  DamageFactor "HTZombie", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "MiniRocket", 0.0
  DamageFactor "ZExplosiveBullets", 0.0
  DamageFactor "ZombieCannon", 0.0
  DamageFactor "ZGrenade", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "LifeEssence", 185, 15
  DropItem "CFArmorBonusMax5", 135
  DropItem "CFArmorBonusMax5", 135
  DropItem "PortableMedkit", 200
  DropItem "HealthFlask", 250, 6
  DropItem "ArmorPlate", 100
  DropItem "HandGrenadeAmmo", 60, 1
  DropItem "MineAmmoRandomizer", 25, 1
  DropItem "AmmoPack", 125
  DropItem "BarbatosCannon", 32, 1
  DropItem "DemonAmmoBoxPickup", 128
  DropItem "ShieldSphere", 32, 1
  DropItem "FlareBox", 32
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFToxicZombieObit"
  Tag "$CFToxZom"
  var int user_loop;
  States
  {
  Spawn:
	TOXZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  SpawnLoop:	
	TOXZ AZ 10 A_Look
	Loop
  Idle:
	TOXZ AAAAAA 1 A_Wander
	TNT1 A 0 A_Look
	TOXZ BBBBBB 1 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	TOXZ CCCCCC 1 A_Wander
	TNT1 A 0 A_Look
	TOXZ DDDDDD 1 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	Loop
  See:
	TOXZ AAAAAABBBBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	TOXZ CCCCCCDDDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	Loop
  Missile:
	TNT1 A 0 A_Jump(92,"Seekers")
	TNT1 A 0 A_JumpIfCloser(250,"ToxicSpray")
	TOXZ EE 8 A_FaceTarget
	TOXZ F 2 Bright A_CustomMissile("ToxicZombieComet",32,0,0)
	TNT1 A 0 A_CustomMissile("ToxicZombieComet",32,0,-5)
	TOXZ F 6 Bright A_CustomMissile("ToxicZombieComet",32,0,5)
	TOXZ E 20
	Goto See
  Seekers:
	TOXZ EE 10 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ToxicZombieCometSeeker",32,0,-8)
	TOXZ F 10 Bright A_CustomMissile("ToxicZombieCometSeeker",32,0,8)
	TOXZ E 20
	Goto See
  ToxicSpray:
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	TOXZ EE 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("Daedabus/Chem")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ToxicSprayLoop:
	TOXZ F 2 Bright A_CustomMissile("ZombieChemSpray",32,0,frandom(-16,16),CMF_AIMOFFSET)
	TOXZ F 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 19,1)
	Loop
	TOXZ F 2 Bright A_CustomMissile("ZombieChemSpray",32,0,frandom(-16,16),CMF_AIMOFFSET)
	TOXZ E 12
	Goto See
  Pain:
	TOXZ G 6 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TOXZ H 5 A_Scream
	TOXZ I 5 A_Fall
	TOXZ J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("ToxicZombiePoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TOXZ KLM 5
	TOXZ N -1
	Stop
  XDeath:
	TOXZ O 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TOXZ P 3 A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	TOXZ Q 3 A_Fall
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ToxicZombiePoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TOXZ RSTUV 3
	TOXZ W -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	TOXZ TSRQPO 5
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TOXZ VUTSRQPO 4
	Goto See
  }
}

Actor ToxicZombieComet : BarbatosComet
{
  Damage 8
  +DONTHARMSPECIES
  +THRUSPECIES
  //DamageType "Poison" why
  Damagetype "Acid"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BRTB C 3 Bright A_Explode(42,102)
	BRTB D 3 Bright A_SetTranslucent(0.75,1)
	TNT1 AAAAA 0 A_SpawnItemEx("ToxicZombiePoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4),0,SXF_SETMASTER,0)
	BRTB EFG 3 Bright
	Stop
  }
}

Actor ToxicZombieCometSeeker : ToxicZombieComet
{
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(15,15)
	BRTB AAAAA 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,15)
	BRTB BBBBB 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  }
}

Actor ZombieChemSpray : DaedabusChemSpray
{
  Speed 12
  +DONTHARMSPECIES
  +THRUSPECIES
  Species "EliteZombies"
  DamageType "Acid"
}

Actor ToxicZombiePoison : BarbatosPoison
{
  +DONTHARMSPECIES
  +THRUSPECIES
  Species "EliteZombies"
  DamageType "Acid"
}