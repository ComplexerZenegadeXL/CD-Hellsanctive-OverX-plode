Actor TrueLegendaryZombie : LegendaryZombie 17500
{ 
  //$Category Monsters/CF
  //$Sprite TLZOA1
  //$Title "True Legendary Zombie"
  Health 1099
  Speed 10
  PainChance "Melee", 128
  BloodColor "Blue"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256 
  DropItem "LegendaryArmor" 120
  DropItem "LegendaryAmmoSphere" 128
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 235 2
  DropItem "Backpack" 198
  DropItem "Armorplate" 205
  DropItem "Portablemedkit" 210
  DropItem "LDemonAmmoBoxPickup" 200 
  DropItem "LDemonAmmoPickup" 250 
  //DropItem "LegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryPowerShard" 80
  DropItem "TrueLegendaryBFGUpgrade" 35
  Tag "$CFTlegZom"
  DamageFactor 0.65
  DamageFactor "PlayerPyro", 0.1
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerBHole", 0.2
  DamageFactor "BFG9500Ball", 0.4
  DamageFactor "BFGSplash", 0.3
  DamageFactor "UpBFG9500Ball", 0.3
  DamageFactor "UpBFGSplash", 0.15
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.05
  DamageFactor "PlayerDevBall2", 0.05
  DamageFactor "Player", 0.3
  DamageFactor "Players", 0.05
  DamageFactor "PlayerDevTracer", 0.05
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "PlayerDBFG", 0.2
  DamageFactor "PlayerDBFG2", 0.2
  DamageFactor "PlayerDBFG10K2", 0.2
  DamageFactor "PlayerDBFGSplash2", 0.2
  DamageFactor "PlayerIce", 0.6
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.1
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.05
  DamageFactor "PlayerNemesisPlasma", 0.4
  DamageFactor "PlayerNemesisBFG", 0.4
  DamageFactor "DiscoBFG", 0.3
  DamageFactor "RailG", 0.9
  DamageFactor "Hitscan", 0.9
  DamageFactor "Normal", 0.9
  DamageFactor "Melee", 0.5
  DamageFactor "Players", 0.75
  DamageFactor "Marine", 0.75
  DamageFactor "NemesisBeam", 0.25
  DamageFactor "NemesisBall", 0.1
  DamageFactor "Lightning", 0.5
  DamageFactor "PlayerLegendary", 0.25
  SeeSound "TLegZomb/sight"
  AttackSound "Null"
  PainSound "TLegZomb/pain"
  DeathSound "TLegZomb/death"
  ActiveSound "TLegZomb/active"
  Obituary "$CFTrueLegendaryZombieObit"
  var int user_script;
  States
  {
  Spawn:
    TLZO A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1,3)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,41)
    TNT1 A 0 A_SetUserVar("user_script",1)
  Idle:
    TLZO A 10 Bright A_Look
	TLZI A 10 Bright A_Look
    Loop
  Remove:
    TNT1 A 1
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	Stop
  See:
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,300)
	TNT1 A 0 A_SetUserVar("user_music",1)
    TLZO A 0 A_JumpIfTargetInLOS("Strafing")
    TLZO AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TLZO A 0 A_JumpIfTargetInLOS("Strafing")
	TLZO CCDD 3 Bright A_Chase
	TLZO A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
    Loop
  Rush:
    TLZO A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("TLegZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLZO D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	TLZO AA 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	TLZO BB 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    TLZO CC 2 Bright A_GiveInventory("TLegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	TLZO DD 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	Goto See
  Pause:
	TLZO E 0 A_PlaySound("weapons/demontechsteam")
	TLZO EEEEEEEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	Goto See	
  Missile:
	TNT1 A 0 A_Jump(40,"Railgun","SuperPlasma")
	TNT1 A 0 A_Jump(10,"Rage")
  Plasma:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("LegendaryProjectile",32,0,random(-4,4),0)
	TNT1 A 0 A_CustomMissile("LegendaryProjectile",32,0,random(-4,4),0)
	TLZO F 2 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_SpidRefire
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	Goto Plasma+5
  Railgun:
	TNT1 A 0 A_PlaySound("legendary/defense")
	TLZO EEEEE 6 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("TLegZRailgunProj",32,0,frandom(-2,2),0)
	TLZO F 4 Bright A_PlayWeaponSound("monsters/darkcyberrail")
	TLZO E 2 Bright
	TNT1 A 0 A_Jump(256,"Plasma","See")
  SuperPlasma:
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("SuperLegPlasma",32,0,frandom(-6,6),0)
	TLZO F 2 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("SuperLegPlasma",32,0,frandom(-6,6),0)
	TLZO F 2 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("SuperLegPlasma",32,0,frandom(-6,6),0)
	TLZO F 2 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_Jump(256,"Plasma","See")
  Rage:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("TLegZomb/Sight",7,1,0,ATTN_NONE)
	TNT1 A 0 A_PlaySound("legendary/defense")
	TLZO EEEEEEEEE 6 Bright A_FaceTarget
  Rage2:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	TLZO EEE 2 Bright A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("TLegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("SuperLegPlasma",32,0,random(-4,4),0)
	TLZO F 2 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_MonsterRefire(240,"See")
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	Goto Rage2+5
  Pain:
    TNT1 A 0 A_Jump(10,"Protection")
	TNT1 A 0 A_Jump(192,"PainMissile")
    TLZO G 2 Bright A_GiveInventory("TLegZombieStrafing",1)
    TLZO G 0 A_Pain
	TLZO GG 2 Bright A_GiveInventory("TLegZombieStrafing",1)
    Goto See
  PainMissile: 
    TLZO G 2 Bright A_GiveInventory("TLegZombieStrafing",1)
    TLZO G 0 A_Pain
	TLZO GG 2 Bright A_GiveInventory("TLegZombieStrafing",1)
    Goto Missile	
  Protection:
    TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	TLZO E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto See	
  Death:
    TNT1 A 0 A_StopSound(6)
	TLZO H 5 A_Scream
    TLZO I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
    TLZO J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TLZO K 5 
    TLZO L -1 
	Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
	TLZO O 3 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TLZO P 3 A_XScream
    TLZO R 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	TNT1 A 0 A_DropItem("NemesisDust",random(2,4),256)
    TLZO STUV 3 
    TLZO W -1 
    Stop
  }
}

Actor TLegendaryZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	Goto Fade
  Fade:
    TNT1 A 1
    TLZO A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor TLegendaryZombieGhostB : TLegendaryZombieGhostA
{   
  States
  {
  Fade:
    TNT1 A 1
    TLZO B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor TLegZombieGhostC : TLegendaryZombieGhostA
{   
  States
  {
  Fade:
    TNT1 A 1
    TLZO C 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor TLegendaryZombieGhostD : TLegendaryZombieGhostA
{   
  States
  {
  Fade:
    TNT1 A 1
    TLZO D 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor TLegendaryZombieGhostE : TLegendaryZombieGhostA
{   
  States
  {
  Fade:
    TNT1 A 1
    TLZO E 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor TLegendaryZombieGhostF : TLegendaryZombieGhostA
{   
  States
  {
  Fade:
    TNT1 A 1
    TLZO F 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor TLegZombieStrafing : CustomInventory
{
  Inventory.MaxAmount 0
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE       
  +COUNTITEM
  +NOTIMEFREEZE
  States
  {
  Pickup:
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,5,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-5,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop	
  }
}


Actor TLegZRailgunProj : FastProjectile
{
  Radius 6
  Height 6
  Speed 300
  Damage (Random(20,28))
  DeathSound "cyberrail/impact"
  DamageType "Legendary"
  MissileType "LegRevRailgunTrail"
  +RIPPER
  +THRUSPECIES
  +EXTREMEDEATH
  +NOTIMEFREEZE
 +BLOODLESSIMPACT
   +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 1
    Loop
  Death:
	TNT1 A 0
	TNT1 AA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAAAAA 0 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 1 A_SpawnItem("RailgunImpact")
	Stop
  }
}

Actor SuperLegPlasma : LegendaryProjectile
{
  Projectile
  Height 10
  Radius 8
  Scale 1
  Speed 40
  FastSpeed 60
  RenderStyle Add
  Damage (random(30,40))
  Damagetype "Legendary"
  States
  {
  Spawn:
	FNBE A 1 Bright A_SpawnItemEx("SuperLegPlasmaTrail",frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(-1,1),frandom(-1,1),frandom(-1,1),random(0,360))
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(120,120)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItem("RailgunImpact")
	TNT1 AAAAAAAAAA 0 A_CustomMissile("BouncyLegProjectile", 0, 0, frandom(0,360), 2, frandom(0,360))
	FNBE AAAAAAAAAAAAA 2 Bright A_FadeOut(0.1)
	Stop
  }
}

Actor SuperLegPlasmaTrail : AHellionSmoke
{
  Scale 0.8
  RenderStyle Add
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    FNBE AAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_FadeOut(0.05,1)
    Stop
  }
}

Actor BouncyLegProjectile : LegendaryProjectile
{
  Speed 20
  BounceType Hexen
  BounceCount 3
}