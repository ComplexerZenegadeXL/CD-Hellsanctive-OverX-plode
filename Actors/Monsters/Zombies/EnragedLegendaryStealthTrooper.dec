Actor EnragedLegendaryStealthTrooper : LegendaryStealthTrooper
{ 
  Health 1350
  Speed 12
  Mass 100
  BloodColor "Red"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "EnragedLegendaryArmor" 80
  DropItem "LegendaryAmmoSphere" 130
  DropItem "HandGrenadeAmmo" 256 2
  DropItem "MineAmmoRandomizer" 256 2
  DropItem "Backpack" 256
  DropItem "Armorplate" 256
  DropItem "Portablemedkit" 256
  DropItem "ELegendaryBulletBoxPickup" 180 
  DropItem "ELegendaryLMGBulletMagPickup" 256 20
  //DropItem "EnragedLegendaryLightMachineGunGiver" 202
  DropItem "EnragedLegendaryPowerShard" 32
  DropItem "LegendaryRandomSphere" 16
  DamageType "Legendary"
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.4
  DamageFactor "PlayerNemesisBFG", 0.25
  +BRIGHT
  SeeSound "ELEGCommando/See"
  PainSound "ELEGCommando/pain"
  DeathSound "ELEGCommando/death"
  ActiveSound "ELEGCommando/active"
  Obituary "$CFEnragedLegendaryStealthTrooperObit"
  Tag "$CFEnrTroop"
  var int user_TurretUse;
  var int user_SniperLoopStart;
  var int user_SniperLoop;
  var int user_SniperAttack;
  States 
  {
  Spawn:
    ECMD A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
    ECMD AZ 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ECMD AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,407)
	TNT1 A 0 A_SetUserVar("user_music",1)
    ECMD A 0 A_JumpIfTargetInLOS("Strafing")
    ECMD AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	ECMD A 0 A_JumpIfTargetInLOS("Strafing")
	ECMD CCDD 3 A_Chase
	TNT1 A 0 A_Jump(80,"Phase")		
	ECMD A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
    Loop
  Rush:
    ECMD A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostA")
	ECMD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostA")
	ECMD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostB")
	ECMD B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostB")
	ECMD B 1 A_Chase
	TNT1 A 0 A_Jump(80,"Phase")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostC")
	ECMD C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostC")
	ECMD C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostD")
	ECMD D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedLegCommandoGhostD")
	ECMD D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ECMD AA 3 A_GiveInventory("LegZombieStrafingg",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ECMD BB 3 A_GiveInventory("LegZombieStrafingg",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    ECMD CC 3 A_GiveInventory("LegZombieStrafingg",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ECMD DD 3 A_GiveInventory("LegZombieStrafingg",1)
	Goto See  
Phase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	ECMD E 2 A_FaceTarget
	ECMD E 1 A_SetTranslucent(0.75)
	ECMD E 1 A_SetTranslucent(0.55)
	ECMD E 1 A_SetTranslucent(0.35)
	ECMD E 1 A_SetTranslucent(0.20)
	Goto Phased
  UnPhase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	ECMD E 1 A_SetTranslucent(0.15)
	ECMD E 1 A_SetTranslucent(0.35)
	ECMD E 1 A_SetTranslucent(0.55)
	ECMD E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	ECMD E 2 A_FaceTarget		
    Goto See	
  Phased:
	ECMP AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
	ECMP AABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase")
	Goto Phased+32	
  Pause:
	ECMD EEEEE 3 A_GiveInventory("LegZombieStrafingg",1)
	Goto See	
  Missile:
    TNT1 A 0 A_SetUserVar(user_SniperLoop,0)
	TNT1 A 0 A_SetUserVar(user_SniperAttack,0)
    ECMD E 10 A_FaceTarget
	TNT1 A 0 A_JumpIfInventory ("ELegAK47Ammo", 92, "Reload")
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_GiveInventory ("ELegAK47Ammo", 1)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomBulletAttack(12.5,10,1,Random(10,20)*6,"EnragedBulletPuff",0,CBAF_NORANDOM)
	ECMD F 0 A_PlaySoundEx("weapons/LMGFire","Weapon")
	ECMD F 3 A_GiveInventory("LegZombieStrafingg",1)	
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",frandom(28,34),0,frandom(6,-6),0)
	TNT1 A 0 A_GiveInventory ("ELegAK47Ammo", 1)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomBulletAttack(12.5,10,1,Random(16,30)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	ECMD F 0 A_PlaySoundEx("weapons/LMGFire","Weapon")
	ECMD F 3 A_GiveInventory("LegZombieStrafingg",1)	
    TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_Jump(12,"Turrets")
	TNT1 A 0 A_Jump(2,"Pause")
	TNT1 A 0 A_Jump(8,"Nade")
	TNT1 A 0 A_Jump(18,"Sniper")
    Goto Missile+3
  Nade:
    ECMD E 1 A_JumpIfCloser(1000,1)
	Goto Missile
	ECMD E 0 A_JumpIfCloser(280,"Missile")
    ECMD E 6 A_GiveInventory("LegZombieStrafingg",1)
    ECMD EEE 4 A_GiveInventory("LegZombieStrafingg",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafingg",1)
    ECMD E 6 A_CustomMissile("ELegStealthTrooperNade",32,0,0,2,10)
	ECMD E 1
	Goto See
  Turrets:
    TNT1 A 0 A_JumpIf(user_TurretUse == 1,"Sniper")
	TNT1 A 0 A_PlaySound("ELegCommando/Star",0,1,0,ATTN_NONE)
	ECMD C 8
	ECMD E 3 A_CustomMissile("ELTurretSpawner",32,0,25,0,15)
	ECMD C 3 A_CustomMissile("ELTurretSpawner",32,0,-25,0,15)
	ECMD E 3 A_CustomMissile("ELTurretSpawner",32,0,0,0,15)
	ECMD E 24
	TNT1 A 0 A_SetUserVar(user_TurretUse,1)
	Goto See
  Sniper:
	TNT1 A 0 A_PlaySound("superzombie/sight")
	TNT1 A 0 A_GiveInventory("LegZombieStrafingg",1)	
	ECMD E 5 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegZombieStrafingg",1)	
	ECMD E 5 A_FaceTarget
  SniperLoopStart:
	TNT1 A 0 A_JumpIf(user_SniperLoopStart == 35,"SniperLoop")	
	ECMD E 1 A_CustomRailgun(-1,7,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,1,0,RailTargetPuff,0,0,0,0,2,0,"EnragedLaserSight")
	TNT1 A 0 A_SetUserVar(user_SniperLoopStart,user_SniperLoopStart+1)
	Loop
  SniperLoop:
	TNT1 A 0 A_JumpIf(user_SniperLoop == 100, "See")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_JumpifTargetinLOS("SniperAttack")
	ECMD E 1 A_CustomRailgun(-1,7,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,1,0,RailTargetPuff,0,0,0,0,2,0,"EnragedLaserSight")
	TNT1 A 0 A_SetUserVar(user_SniperLoop,user_SniperLoop+1)
	Loop
  SniperAttack:
	TNT1 A 0 A_SetUserVar(user_SniperLoopStart,0)
	TNT1 A 0 A_JumpIf(user_SniperAttack == 8, "See")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",frandom(28,34),0,frandom(-2,2),0)
	TNT1 A 0 A_PlaySoundEx("weapons/LMGFire","Weapon")
	TNT1 A 0 A_JumpIfInventory ("ELegAK47Ammo", 92, "Reload")
	TNT1 A 0 A_CustomRailgun(-1,7,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,1,0,RailTargetPuff,0,0,0,0,2,0,"EnragedLaserSight")
	TNT1 A 0 A_GiveInventory ("ELegAK47Ammo", 1)
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomBulletAttack(6,8,1,Random(20,25)*6,"EnragedBulletPuff",0,CBAF_NORANDOM)
	ECMD F 2
	ECMD EE 1 A_CustomRailgun(-1,7,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,1,0,RailTargetPuff,0,0,0,0,2,0,"EnragedLaserSight")
	TNT1 A 0 A_SetUserVar(user_SniperAttack,user_SniperAttack + 1)
	Loop
  Pain:
   	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(15,"Protection")
	TNT1 A 0 A_Jump(90,"Phase")
    ECMD G 3 A_GiveInventory("LegZombieStrafingg",1)
    ECMD G 0 A_Pain
	ECMD G 3 A_GiveInventory("LegZombieStrafingg",1)
	TNT1 A 0 A_Jump(25,"Turrets")
    Goto See
  Protection:
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	ECMD E 2 ACS_NamedExecuteAlways("EnragedLegendaryProtection")
	Goto See	
  Reload:
    TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("weapons/LMGReload2")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    ECMD EE 25 A_TakeInventory ("ELegAK47Ammo", 92)
    ECMD E 20 A_PlaySound("weapons/LMGReload1") 
	ECMD E 40 A_PlaySound("weapons/LMGReload3")
    TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    Goto See
  Death:
    TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
    TNT1 A 0 A_Jump(36,"LegendarySoul") 
	TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_StopSound(6)
	ECMD H 5 A_Scream
    ECMD I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
    ECMD J 5 A_SpawnItemEx("BodyCrash")
    ECMD K 5 
    ECMD L -1 
	Stop
  LegendarySoul:
	TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ECMD H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    ECMD I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    ECMD J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    ECMD K 5 
	ECMD L 140
	ECMD L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	ECMD LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_SpawnItem("ELegSoulEventSmokeSpawner",1)
	TNT1 A 0 A_SpawnItemEx("EnragedLegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	ECMD L -1
	Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
	ECMD O 3 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    ECMD P 3 A_XScream
    ECMD R 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
    ECMD STUV 3 
    ECMD W -1 
    Stop
  }
}

Actor EnragedLegCommandoGhostA : LegCommandoGhostA
{
  +NOINTERACTION
  +NOBLOCKMAP
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 1
	ECMD A 2 A_FadeOut(0.10)
	Goto Fade+1
  Vanilla:
	TNT1 A 0
	Stop
  }
}

Actor EnragedLegCommandoGhostB : LegCommandoGhostA 
{   
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 1
	ECMD B 2 A_FadeOut(0.10)
	Goto Fade+1
  }
}

Actor EnragedLegCommandoGhostC : LegCommandoGhostA 
{   
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 1
	ECMD C 2 A_FadeOut(0.10)
	Goto Fade+1
  }
}

Actor EnragedLegCommandoGhostD : LegCommandoGhostA 
{   
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 1
	ECMD D 2 A_FadeOut(0.10)
	Goto Fade+1
  }
}
	
Actor ELegAK47Ammo: Ammo { Inventory.MaxAmount 92 }

Actor ELegStealthTrooperNade : ELACGrenade { Obituary "$CFELegStealthTrooperNadeObit" }

Actor ELTurretSpawner : ELACThrownMine
{
  Species "Zombie"
  Obituary ""
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	LSTS AAAAABBBBBBCCCCCCDDDDDDEEEEEEFFFFFF 1 Bright A_CheckFloor("Death")
	TNT1 A 0 A_CountDown
	Loop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Scream
	TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
	LSTS ABCDEF 1 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LSTS A 0 A_CustomMissile("EnragedLegendaryTurret",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Stop
  }
}

Actor EnragedLegendaryTurret
{
  Obituary "$CFEnragedLegendaryTurretObit"
  Health 300
  Radius 16
  Height 56
  Mass 100000
  Speed 0
  Monster
  Decal "ELegBulletChip"
  +FLOORCLIP
  //+FRIENDLY
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOTARGET
  +QUICKTORETALIATE
  +NOBLOOD
  +LOOKALLAROUND
  +DROPOFF
  +STANDSTILL
  +NOTIMEFREEZE
  -COUNTKILL
  DamageType "Legendary"
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.2
  DropItem "ELegendaryBulletBoxPickup" 100
  DropItem "ELegendaryLMGBulletMagPickup" 230 20
  DamageFactor 0.8
  var int user_TurretLoop;
  States
  {
  Spawn:
    TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
  See:
	TNT1 A 0 A_SetUserVar(user_TurretLoop,0)
    SENT AAAAAAAAAAAAAAA 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySound("sentry/beep")
	TNT1 A 0 A_ClearTarget
    Loop
  Missile:
  TurretLoopStart:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckTargetMonster") == 1,"See")
	TNT1 A 0 A_JumpIf(user_TurretLoop == 15,"TurretLoop")
	//SENT A 1 A_CustomMissile("EnragedLaserSight3",40,0,0,CMF_AIMDIRECTION,0)
	SENT A 1 A_CustomRailgun(0,0,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,0,"RailTargetPuff",0,0,4096,0,2.0,0,"EnragedLaserSight",5)  
	TNT1 A 0 A_SetUserVar(user_TurretLoop,user_TurretLoop+1)
	Loop
  TurretLoop:
    //SENT A 1 A_CustomMissile("EnragedLaserSight3",40,0,0,CMF_AIMDIRECTION,0)
	SENT A 1 A_CustomRailgun(0,0,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,0,"RailTargetPuff",0,0,4096,0,2.0,0,"EnragedLaserSight",5)  
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",frandom(38,42),0,frandom(-5,5),0)
	TNT1 A 0 A_PlaySound("weapons/LMGFire")
    TNT1 A 0 A_SpawnItemEx("ELegRifleCasing", 12, 6, 30, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 A 0  A_CustomBulletAttack(32,5,1,random(25,35),"EnragedBulletPuff",4096,CBAF_NORANDOM)
    //SENT B 1 Bright A_CustomMissile("EnragedLaserSight3",40,0,0,CMF_AIMDIRECTION,0)
	SENT B 1 A_CustomRailgun(0,0,NONE,NONE,RGF_SILENT|RGF_NOPIERCING,0,0,"RailTargetPuff",0,0,4096,0,2.0,0,"EnragedLaserSight",5)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_CPosRefire 
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION,SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySound("weapons/rocklx")
    TNT1 A 1 A_SpawnItem("RocketEx",0,32)
    Stop
  }
}