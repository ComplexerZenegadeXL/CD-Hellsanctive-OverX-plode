Actor ProShotgunner
{
  Monster 
  Health 130
  GibHealth 130
  Height 56
  Radius 20
  Mass 100
  Speed 6
  FastSpeed 8
  PainChance 160
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species "EliteZombies"
  //No Infighting
  DamageFactor "RST", 0.0
  DamageFactor "SoapOpera", 0.0
  DamageFactor "ZombieDev", 0.0
  Damagefactor "ZExplosiveBullets", 0.0
  Damagefactor "HTZombie", 0.0
  DamageFactor "ZombieCannon", 0.0
  DamageFactor "MiniRocket", 0.0
  Damagefactor "ZGrenade", 0.0
  DropItem "HealthFlask", 35
  DropItem "ArmorCharge", 35
  DropItem "AmmoPack", 20
  DropItem "HandGrenadeAmmo", 150, 1
  DropItem "MineAmmoRandomizer", 125, 1
  DropItem "CombatShotgunGiver", 256, 1
  DropItem "ShieldSphere", 32, 1
  SeeSound "grunt/sight"
  AttackSound "weapons/12gaugefire"
  PainSound "grunt/pain"
  DeathSound "grunt/death"
  ActiveSound "grunt/active"
  Obituary "$CFProShotgunnerObit"
  Tag "$CFProShotgunner"
  States
  {
  Spawn:
	ZSP1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	ZSP1 AA 10 A_Look
	Loop
  See:
	TNT1 A 0 A_UnSetSolid
	ZSP1 A 1
	TNT1 A 0 ThrustThing(angle*256/360+Random(192.0,64.0),15,0,0)
	ZSP1 A 2
	TNT1 A 0 A_SetSolid
  Chase:
	ZSP1 AAAABB 1 A_Chase
	ZSP1 BB 1 A_FastChase
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	ZSP1 CCCCDDD 1 A_Chase
	ZSP1 D 1 A_FastChase
	TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	Loop
  Missile:
	ZSP1 E 6 A_FaceTarget
	ZSP1 F 2 Bright A_FaceTarget
	TNT1 A 0 ThrustThingZ(0,18,0,0)
	TNT1 A 0 ThrustThing(angle*256/360+frandom(192.0,64.0),15,0,0)
	TNT1 A 0 A_CustomBulletAttack(22.5,0,5,Random(6,9),"ZbulletPuff",0,CBAF_NORANDOM)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),0)
	ZSP1 E 6 A_FaceTarget
	ZSP1 E 4 A_PlaySound("weapons/12gsgcock")
	TNT1 A 0 A_SpawnItemEx("ShellCasing",-8,0,30,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE,0)
	ZSP1 E 2
	Goto Chase
  Pain:
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(96,"NoPainShield")
  PainShield:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
  NoPainShield:
	ZSP1 G 6 A_Pain
	Goto Chase
  Death:
	ZSP1 H 5 A_Scream
	ZSP1 I 5 A_Fall
	ZSP1 J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	ZSP1 K 5
	ZSP1 L 63000 CanRaise
	Stop
  XDeath:
	ZSP1 G 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	ZSP1 H 3 A_XScream
	ZSP1 I 3 A_Fall
	ASGZ PQRSTUV 3
	ASGZ W 63000 CanRaise
	Stop
  Raise:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	ASGZ WVUTSRQP 5
	ZSP1 IHG 5
	Goto Chase
  }
}

Actor ZMiniRocket : MiniRocket
{
  DamageType "ZExplosiveBullets"
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(80,"Homing")
	Goto Normal
  Normal:
	TNT1 A 0 A_Jump(3,"Homing")
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("MiniRocketFly",0,1.0,0)
	Loop
  Homing:
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	MICR A 1 Bright A_SpawnItemEx("MissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_SeekerMissile(8,12)
	TNT1 A 0 A_PlaySound("MiniRocketFly",0,1.0,0)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,1,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_Explode(10,30,0)
	TNT1 A 0 A_SetTranslucent(0.85,1)
	H2BL JKLMN 4 Bright
	Stop
  }
}

