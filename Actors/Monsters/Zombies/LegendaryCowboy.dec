Actor LegendaryCowboy 18556
{
  //$Category Monsters/LCA/DJB
  //$Sprite LWGUA1
  //$Title "Legendary Cowboy"
  Health 999
  Radius 20
  Height 56
  Speed 12
  PainChance 20
  Species "Zombie"
  Monster
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOTELEFRAG
  AttackSound "REVFIRE"
  SeeSound "LegendaryCowboy/See"
  PainSound "LegendaryCowboy/pain"
  DeathSound "LegendaryCowboy/death"
  ActiveSound "LegendaryCowboy/active"
  Obituary "$CFLegendaryCowboyObit"
  BloodColor "Blue"
  //DropItem "LegendaryRevolverGiver" 200
  DropItem "LegendaryLMGBulletMagPickup" 250 3
  DropItem "LegendaryBulletBoxPickup" 125 1
  DropItem "LegendaryArmor" 90
  DropItem "LegendaryAmmoSphere" 93
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 240 2
  DropItem "Backpack" 200
  DropItem "Armorplate" 210
  DropItem "Portablemedkit" 215
  DropItem "StimKit" 220
  DropItem "HealthFlask" 225
  DropItem "LegendaryPowerShard" 35
  DropItem "LegendaryPowerSphere" 35
  Species "Zombie"
  Tag "$CFLegNoon"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Explosion", 0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LWGU A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  SpawnLoop:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    LWGU AA 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,25)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LWGU AABBCCDD 3 Bright A_Chase
    Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,25)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LWGU A 0 A_JumpIfTargetInLOS("Strafing")
    LWGU AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	LWGU A 0 A_JumpIfTargetInLOS("Strafing")
	LWGU CCDD 3 Bright A_Chase
	LWGU A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    Loop
  Rush:
    LWGU A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegWestZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LWGU D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItem("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LWGU AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LWGU BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItem("FootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    LWGU CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LWGU DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Missile:
	TNT1 A 0 A_Jump(40,"Multipleshots") 
    LWGU EEE 2 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    TNT1 A 0 A_JumpIfInventory ("WestAmmo", 6, "Reload")
    LWGU E 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 4 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 2 Bright A_FaceTarget
	TNT1 A 0 A_CPosRefire
    Goto Missile
  Multipleshots:
	TNT1 A 0 A_JumpIfInventory ("WestAmmo", 1, "Reload")
    LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 Bright A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
    LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.55,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("WestAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LWGU F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LWGU E 3 Bright A_FaceTarget
	TNT1 A 0 A_CPosRefire 
  Reload:
   	TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("REVOPEN")
	TNT1 AAAAAA 0 A_SpawnItemEx("LegBulletCasing", -8, 7, 30, 4, 0,frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    LWGU E 24 Bright A_TakeInventory ("WestAmmo", 6)
    LWGU E 12 Bright A_PlaySound("REVINSR") 
	LWGU E 12 Bright A_PlaySound("REVCLOSE")
	LWGU E 1 Bright A_PlaySound("REVSPIN")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  Pain:
    TNT1 A 0 A_Jump(50,"Protection")
	TNT1 A 0 A_Jump(192,"PainMissile")
    LWGU G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LWGU G 0 A_Pain
	LWGU G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto See
  PainMissile: 
    LWGU G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LWGU G 0 A_Pain
	LWGU G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto Missile	
  Protection:
    TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LWGU E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0)
	Goto See	
  Death:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    LWGU H 5 A_StopSound(6)
    LWGU I 5 A_Scream
    LWGU J 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LWGU J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LWGU K 5
    LWGU L -1
    Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LWGU H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LWGU I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LWGU J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LWGU K 5 
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LWGU L 140
	LWGU L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LWGU LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LWGU L -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
    LWGU M 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LWGU N 5 A_XScream
    LWGU O 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LWGU PQRST 5
    LWGU U -1
    Stop
  }
}


Actor WestAmmo: Ammo { Inventory.MaxAmount 12 }

Actor LegWestZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    LWGU A 2 A_FadeOut(0.10)
    Loop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegWestZombieGhostB : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    LWGU B 2 A_FadeOut(0.10)
    Loop
  }
}

Actor LegWestZombieGhostC : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    LWGU C 2 A_FadeOut(0.10)
    Loop
  }
}

Actor LegWestZombieGhostD : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    LWGU D 2 A_FadeOut(0.10)
    Loop
  }
}