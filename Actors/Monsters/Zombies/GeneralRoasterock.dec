    HFBA D 0 A_CustomMissile("RSTFuelExplosion01",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("RSTFuelExplosion01",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_Mushroom("RSTMushroomFireballs",8,MSF_STANDARD|MSF_DONTHURT)
	TNT1 A 0 A_Explode(Random(300,500),256,0)
    HFBA DEFGHIJKLMN 1 Bright 
	TNT1 A 0 A_SpawnItemEx("PyroShotEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Stop
  }
}

