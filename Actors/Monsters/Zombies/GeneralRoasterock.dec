Actor GeneralRoasterock 32445
{
  Health 3000
  Radius 20
  Height 56
  Mass 400
  Speed 9
  PainChance 2
  Monster
  MinMissileChance 90
  Scale 1.25
  Species "ChefBoyardee"
  DamageFactor "PlayerFireSword", 0.8
  DamageFactor "BeheComet", 0.3
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.2
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SoapOpera", 0.0 
  DamageFactor "ZombieDev", 0.0
  DamageFactor "RST", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor 0.65
  DamageFactor "BFGSplash", 0.15
  DamageFactor "BFGSpray", 0.15
  DamageFactor "Explosion", 0.60
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Bullet", 0.3
  DamageFactor "HellComet", 0.6
  DamageFactor "ZombieDemonTech", 0.0
  DamageFactor "ZombieRocket", 0.0
  DamageFactor "Railg", 0.5
  DamageFactor "GeneralTracer", 0.0
  DamageFactor "BFG10K", 0.40
  DamageFactor "PDTBFG", 0.20
  DamageFactor "PDTBFGTracer", 0.20
  DamageFactor "PlayerDevBall", 0.12
  DamageFactor "PlayerDevBall2", 0.12
  DamageFactor "PlayerDevTracer", 0.12
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LACGrenade", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "GeneralTracer", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerLegendary", 0.0
  //if infight
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "Legendary1", 0.0 // Leg Imp
  DamageFactor "VileFires", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "BeheComet", 0.0
  MaxStepHeight 32
  MaxDropOffHeight 32
  +BOSS
  +MISSILEMORE
  +MISSILEEVENMORE
  +LOOKALLAROUND
  +DONTRIP
  +NOTELEFRAG
  +NOTIMEFREEZE
  +NOTARGET
  +CANTSEEK
  +FLOORCLIP
  +AVOIDMELEE
  +QUICKTORETALIATE
  +NORADIUSDMG
  +DONTMORPH
  +BOSSDEATH
  +NOICEDEATH
  DropItem "RocketLauncherGiver", 120, 1
  DropItem "GrenadeLauncherGiver", 120, 1
  DropItem "HomingRocketLauncherGiver", 120, 1
  DropItem "RapidShotgunGiver", 120, 1
  DropItem "Beacon", 120, 1
  DropItem "ArmorCharge", 150, 2
  DropItem "Armorplate", 186, 2
  DropItem "Portablemedkit", 159, 2
  DropItem "Backpack", 190, 1
  DropItem "SkullOfPowerGiver", 72, 1
  SeeSound "roaster/sight"
  PainSound "roaster/pain"
  DeathSound "roaster/death"
  ActiveSound "roaster/idle"
  AttackSound "roaster/fire"
  Obituary "$CFGeneralRoasterockObit"
  Tag "$CFRoast"
  var int user_missile;
  var int user_music;
  var int user_loop;
  var int user_lowlag;
  States
  {
  Spawn:
    ROST A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  See2:
	ROST A 10 A_Look
	RSTI A 10 A_Look
	Loop
  Idle:
	BSZM A 0 A_LookEx(0,0,2048,2048,100)
	TNT1 A 0 A_SpawnItemEx("RoasterStepQuiet",0,0,0,0)
	ROST AAAABBBB 2 A_Wander
	BSZM A 0 A_LookEx(0,0,2048,2048,100)
	TNT1 A 0 A_SpawnItemEx("RoasterStepQuiet",0,0,0,0)
	ROST CCCCDDDD 2 A_Wander
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ROST AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,603)
	TNT1 A 0 A_SetUserVar("user_music",1)
	ROST A 0 A_Jump(30,"Sprint")
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	ROST AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	ROST CCDD 3 A_Chase
	Loop
  Strafing:
	ROST A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ROST AABB 3 A_GiveInventory("CommandoStrafing",1)
	ROST C 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    ROST CCDD 3 A_GiveInventory("CommandoStrafing",1)
	Goto See	
  Sprint:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  SprintLoop:
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	ROST AAAABBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	ROST CCCCDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("RoasterStep",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto SprintLoop
	TNT1 A 0
	Goto See
  Pause:
	TNT1 A 0 A_PlaySoundEx("roaster/stop","SoundSlot6")
	ROST G 10
	Goto See
  Missile:
	TNT1 A 0 A_Jump(10,"MegaAttack")
    TNT1 A 0 A_Jump(30,"PyroCannon","MLGRocket","MLGRocket2")
	TNT1 A 0 A_Jump(150,"Chaingun")
	//TNT1 A 0 A_Jump(150,"Cannon", "Chaingun", "LegMissile","ShoulderMissile","DTBFG10K","Devastator","FireBalls","MLGRocket")
  Cannon:
	ROST E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CannonLoop:
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTRocket",28,10,frandom(-4, 4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Goto CannonLoop
	TNT1 A 0
	Goto See
  MLGRocket:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	WDMK G 0 A_JumpIf(ceilingz-floorz<=100,"DTBFG10K")
	ROST E 10 A_FaceTarget
	ROST E 5 A_FaceTarget
	ROST F 4 Bright A_CustomMissile("RSTRocketJump",-10,10,0)
	TNT1 A 0 ThrustThingZ(0,70,0,1)
	ROST F 0 A_PlaySound ("Cardinal/9k")
	ROST EE 5 Bright A_FaceTarget
	ROST F 4 Bright A_FaceTarget
	ROST F 2 Bright A_CustomMissile("RSTDTBFG10KBall")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  MLGRocket2:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	WDMK G 0 A_JumpIf(ceilingz-floorz<=100,"Devastator")
	ROST E 10 A_FaceTarget
	ROST E 5 A_FaceTarget
	ROST F 4 Bright A_CustomMissile("RSTRocketJump",-10,10,0)
	TNT1 A 0 ThrustThingZ(0,70,0,1)
	ROST F 0 A_PlaySound ("devastator/fire")
	ROST E 5 Bright A_FaceTarget
	ROST F 4 Bright A_FaceTarget
	ROST F 2 Bright A_CustomMissile("RSTDevastatorBall")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  DTBFG10K:
    ROST F 0 A_PlaySound ("Cardinal/9k")
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST E 4 Bright A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST EE 4 Bright A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST EE 4 Bright A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST EFF 2 Bright A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST FF 4 Bright A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 2 Bright A_CustomMissile("RSTDTBFG10KBall")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ROST E 35
    Goto See
  Devastator:
    ROST E 0 A_FaceTarget
    ROST E 0 A_PlaySound ("devastator/charge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_missile", 0)
  DevCharge:
    TNT1 A 0 A_JumpIf(user_missile > 55,"Charged")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
    ROST E 2 Bright A_FaceTarget
    Loop
  Charged:
	ROST F 4 Bright A_FaceTarget
    ROST F 0 A_PlaySound ("devastator/fire")
    ROST F 10 Bright A_CustomMissile("RSTDevastatorBall")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    ROST E 35
    Goto See
  Chaingun:
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ZCGN E 0 A_PlaySoundEx("roaster/start","SoundSlot6")
	ROST GGGGGG 5 A_FaceTarget
	//ZCGN E 0 A_PlaySoundEx("roaster/loop","SoundSlot6",true)
	Goto ChainLoop
  ChainLoop:
    ROST G 0 A_JumpIfInventory("RoasterChainTimer",40,"ChainEnd")
	TNT1 A 0 A_PlaySoundEx("roaster/fire","SoundSlot6")
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(30,34),-10,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 12, 6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	ROST H 0 A_CustomBulletAttack(5.5, 5.5, 1,frandom(10,20), "RSTBulletPuff", 0, CBAF_NORANDOM)
    ROST H 1 Bright
	ROST G 1 A_GiveInventory("RoasterChainTimer",1)
	TNT1 A 0 A_StopSoundEx("Roaster")
    ROST G 0 A_MonsterRefire(10, "ChainEnd")
    Loop
  ChainEnd:
    TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ZCGN E 0 A_PlaySoundEx("roaster/stop","SoundSlot6")
	ROST G 0 A_TakeInventory("RoasterChainTimer",40)
	ROST G 10
	Goto See
  LegMissile:
	ZCGN E 0 A_PlaySoundEx("roaster/prep","SoundSlot6")
	ROST IIIIII 5 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/leg", CHAN_WEAPON)
    ROST J 2 Bright A_CustomMissile("RoasterLegMissile",12,-10)
	ROST I 3 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/leg", CHAN_WEAPON)
    ROST J 2 Bright A_CustomMissile("RoasterLegMissile",12,-10)
	ROST I 3 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/leg", CHAN_WEAPON)
    ROST J 2 Bright A_CustomMissile("RoasterLegMissile",12,-10)
	ROST I 14
    Goto See
  ShoulderMissile:
	ZCGN E 0 A_PlaySoundEx("roaster/prep","SoundSlot6")
	ROST IIIIII 5 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/shoulder", CHAN_WEAPON)
    ROST K 2 Bright A_CustomMissile("RoasterShoulderMissile",62,20)
	ROST I 3 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/shoulder", CHAN_WEAPON)
    ROST K 2 Bright A_CustomMissile("RoasterShoulderMissile",62,20)
	ROST I 3 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/shoulder", CHAN_WEAPON)
    ROST K 2 Bright A_CustomMissile("RoasterShoulderMissile",62,20)
	ROST I 3 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/shoulder", CHAN_WEAPON)
    ROST K 2 Bright A_CustomMissile("RoasterShoulderMissile",62,20)
	ROST I 14
    Goto See
  MegaAttack:
	ROST L 0 A_PlaySound("roaster/pain")
	ROST LLLLLL 4 A_FaceTarget
	ROST J 0 A_PlaySound("roaster/javelin", CHAN_WEAPON)
	ROST J 0 A_PlaySoundEx("roaster/leg", "SoundSlot6")
	ROST J 0 A_PlaySoundEx("roaster/shoulder", "SoundSlot5")
	ROST L 0 A_CustomMissile("RoasterShoulderMissile",62,20)
	ROST L 0 A_CustomMissile("RoasterLegMissile",12,-10)
	ROST L 0 A_CustomMissile("RSTPyroShot",28,10)
    ROST M 2 Bright
	ROST L 14
    Goto See
  FireBalls:
	ROST E 20 A_FaceTarget
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	ROST E 5 A_FaceTarget
	ROST E 0 A_GiveInventory("CommandoStrafing",1)
	ROST F 4 Bright A_CustomMissile("RSTFireBall",28,10,frandom(-4, 4))
	Goto See
   PyroCannon:
    ROST L 0 A_PlaySound("roaster/See7")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ROST EEEEEEE 5 A_FaceTarget
	ROST F 5 A_FaceTarget  
	TNT1 A 0 A_PlaySound("weapons/PCNNF")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    ROST F 4 Bright A_CustomMissile("RSTPyroShot",28,10, 0)
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam")
	ROST EEE 20 Bright A_SpawnItemEx("LegendaryCannonSmoke",28,10,0)
    Goto See
  Dodge:
	ROST A 1 A_FaceTarget
	ROST E 0 ThrustThingZ(0, 20, 0, 0)
	ROST A 0 A_Jump(256, "DodgeRight", "DodgeLeft")
  DodgeLeft:
	ROST E 0 ThrustThing(angle*256/360+192, 15, 0, 0)
	Goto Sprint
  DodgeRight:
	ROST E 0 ThrustThing(angle*256/360+64, 15, 0, 0)
	Goto Sprint
  Pain:
    ROST N 5 A_Pain
	TNT1 A 0 A_Jump(100,"Missile")
    Goto See
  PainMissile:
    ROST N 5 A_Pain
    Goto Missile
  Pain.PlayerDBFG10K2:
  Pain.DBFG10K2:
  Pain.DBFG:
  Pain.PlayerDBFG:
  Pain.DBFG2:
  Pain.PlayerDBFG210K:
  Pain.DBFG210K:
  Pain.DBFG2Splash:
    TNT1 A 0 A_Jump(256,"Dodge")
	Goto See
  Death.PlayerIce:
  Death:
    ROST A 0 A_NoBlocking
    ROST A 0 A_Scream
	TNT1 A 0 A_Jump(10,"RNGESUS")
    TNT1 A 0 A_Jump(50,"GoodDeath")
	Goto Death2
  GoodDeath:
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
    TNT1 A 0 A_SpawnItemEx("DemonicChaliceGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("Backpack",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	Goto Death2
  RNGESUS:
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
    TNT1 A 0 A_SpawnItemEx("DemonicChaliceGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("Backpack",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("PyrocannonGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,180)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
  Death2:
	ROST OPQRSTU 6 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	ROST U -1
  }
}

Actor RoasterStepQuiet
{
  Radius 1
  Height 1
  +NOCLIP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 1 A_PlaySoundEx("roaster/stepquiet","Weapon")
    Stop
  }
}

Actor RoasterStep : RoasterStepQuiet
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_PlaySoundEx("roaster/step","Weapon")
	Stop
  }
}

Actor RoasterLegMissile
{
  Radius 6
  Height 8
  Speed 35
  FastSpeed 45
  Species "ChefBoyardee"
  DamageType "RST"
  Damage (random(50,90)) //20
  Projectile
  +RANDOMIZE
  +DEHEXPLOSION
  +ROCKETTRAIL
  DeathSound "weapons/rocklx"
  Obituary "$CFRoasterLegMissileObit" // "%o rode %k's rocket."
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(80,"TurnIntoSeeker")
  SpawnLoop:
    RMIS A 5 Bright
    Loop
  TurnIntoSeeker:
	TNT1 A 0 A_ChangeFlag("SEEKERMISSILE",1)
	Goto SpawnSeeker
  SpawnSeeker:
	RMIS A 5 Bright A_SeekerMissile(40, 15)
	Loop
  Death:
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 Radius_Quake(2,12,0,8,0)
    TNT1 A 0 A_Explode(80,128,0)
    TNT1 A 0 A_Explode(50,256,0)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 20
    Stop
  }
}

Actor RSTDTBFG10KBall : ZombieDTBFG10KBall
{
  Species "ChefBoyardee"
  DamageType "RST"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    CRS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 C 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    CRS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  DTBFGSFX:
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,-6),frandom(6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 C 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn
  }
}

