Actor RSTFireball
{
  Game Doom
  Radius 6
  Height 8
  Speed 50
  FastSpeed 60
  Damage (Random(75,150)) //25
  Projectile
  +RANDOMIZE
  +DONTREFLECT
  +SEEKERMISSILE
  +EXTREMEDEATH
  Species "ChefBoyardee"
  DamageType "RST"
  RenderStyle Translucent
  Alpha 1
  Scale 1.0
  SeeSound "imp/attack"
  DeathSound "comet/explosion"
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_PlaySoundEx("HFCyb/rocket", 1, 0, 2)
	Goto Fly
  Fly:
	FRTB AB 1 Bright A_SpawnItemEx("HFCybFireballTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(0,2)
	TNT1 A 0 A_CustomMissile ("SuperMeteor_m_TrailFX_Smoke", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (10, 40))
	Loop
  Death:
	TNT1 A 0 A_Explode(60,160,0)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, frandom(0,360))
    TNT1 AAAAAA 0 A_CustomMissile ("OrangeParticleSpawner", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 180))
	EXPL A 0 Radius_Quake(15,20,0,20,0)
    TNT1 A 0 A_AlertMonsters
	Goto EndAnimation
  EndAnimation:
	TNT1 A 0 A_SpawnItemEx("RSTSuperMeteor_m_Explosion", 0, 0, 0, 0, 0, 0, -1, SXF_NOCHECKPOSITION)//A_CustomMissile("Meteor_m_Explosion",0+Random(5,80),0+Random(35,-35),0+Random(0,370))
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke", 0, 0, 0, frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	Stop
  }
}

Actor RSTPyroShot
{
  Projectile
  +SEEKERMISSILE
  +FORCERADIUSDMG
  +NOGRAVITY
