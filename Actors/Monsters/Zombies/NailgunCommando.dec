Actor NailgunCommando 18550
{
  //$Category Monsters/LCA/DJB
  //$Sprite NLBCA1
  //$Title "Nailgun Commando"
  Obituary "$CFNailgunCommandoObit"
  Health 400
  Radius 20
  Height 56
  Mass 200
  Speed 14
  PainChance 80
  Species ""
  Scale 1.2
  SeeSound "Monsters/NBSight"
  ActiveSound "Monsters/NBAct"
  PainSound "Monsters/NBPain"
  DeathSound "Monsters/NBDeath"
  Translation 1
  BloodColor "7F 3F 00"
  DropItem "HealthFlask" 55
  DropItem "ArmorCharge" 55
  DropItem "AmmoPack" 40
  DropItem "HandGrenadeAmmo" 100 1
  DropItem "MineAmmoRandomizer" 50 1
  DropItem "BulletMagPickup" 128
  DropItem "BulletMagPickup" 64
  DropItem "NailgunGiver" 50 1
  Tag "$CFNailZom"
  Monster
  +FLOORCLIP
  var int user_lowlag;
  States
  {
  Spawn:
	NLBC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	NLBC AB 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NLBC AABBCCDD 4 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	NLBC AA 4 A_Chase
	NLBC A 0 A_PlaySound("Monsters/NBWalk")
	NLBC BBCC 4 A_Chase
	NLBC CC 0 A_PlaySound("Monsters/NBWalk")
	NLBC DD 4 A_Chase
	Loop
  Missile:
  	NLBC E 0 A_Jump(96, 27)
    NLBC E 0 A_Jump(96, 34)
    NLBC E 8 A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright
	NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 10, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 0, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 2 Bright A_CustomMissile("BorgNail1", 32, 0, frandom(-6, 6), 0, 1)
    NLBC E 1 Bright
    Goto See
    NLBC E 8 A_FaceTarget
    NLBC E 0 A_PlaySound("weapons/nailfire")
    NLBC F 4 A_CustomMissile("BorgNail2", 28, 10, 4, 0, 1)
    NLBC F 0 A_CustomMissile("BorgNail2", 28, 10, -4, 0, 1)
    NLBC F 0 A_CustomMissile("BorgNail2", 36 ,10 ,4 , 0, 1)
    NLBC F 0 A_CustomMissile("BorgNail2", 36, 10, -4, 0, 1)
    NLBC F 0 Bright A_CustomMissile("BorgCenterNail", 32, 0, 0, 0)
    NLBC E 12
    Goto See
    NLBC E 8 A_FaceTarget
    NLBC E 0 A_PlaySound("Weapons/NailBomb")
    NLBC F 4 A_CustomMissile("BorgNailBomb", 32, 10, frandom(-6, 6), 0)
    NLBC E 8
    Goto See
  Pain:
	NLBC C 3
	NLBC C 3 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	NLBC H 5 A_Scream
	NLBC I 5
	NLBC J 5 A_NoBlocking
	NLBC J 0 A_PlaySound("Weapons/NailBomb")
	NLBC K 5 A_CustomMissile("BorgNailBombBig", 32, 0, frandom(-6, 6), 0)
	NLBC L 5 A_SpawnItem("BodyCrash",0,0,0,0)
	NLBC M 5
	NLBC N -1
	Stop
  XDeath:
	NLBC O 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	NLBC P 5 A_XScream
	NLBC Q 5 A_NoBlocking
	NLBC Q 0 A_PlaySound("Weapons/NailBomb")
	NLBC RTUV 5 A_CustomMissile("BorgNailBombBig", 32, 0, frandom(-6, 6), 0)
	NLBC W -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	NLBC KJIH 5
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	NLBC WVUTSRQPO 4
	Goto See
  }
}
		
Actor BorgNailBomb
{
  Radius 24
  Height 24
  Speed 20
  Reactiontime 35
  SeeSound "Weapons/NBBounce"
  DeathSound "Weapons/NailBombExp"
  Projectile
  -SHOOTABLE
  +DOOMBOUNCE
  +RANDOMIZE
  +GRENADETRAIL
  -NOGRAVITY
  +CANBOUNCEWATER
  +BOUNCEONACTORS
  var int user_loop;
  States
  {
  Spawn:
	NBMB A 2 A_Countdown
	NBMB AB 6
	Loop
  Death:
  DeathLoop:
	WSMK E 0 A_CustomMissile("BorgNail1", 4, 2, user_loop * 40)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	WSMK ABCDE 5
	Stop
  }
}

Actor BorgNailBombBig : BorgNailBomb
{
  Scale 1.4
  States
  {
  Spawn:
	NBMB A 2 A_Countdown
	NBMB AB 6
	Loop
  Death:
  DeathLoop:
	WSMK E 0 A_CustomMissile("BorgNail1", 4, 2, user_loop * 20)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	WSMK ABCDE 5
	Stop
  }
}

Actor BorgNail1
{
  Projectile
  Radius 5
  Height 8
  Speed 32
  Damage (Random(15,25)) //6
  Scale 0.6
  +BLOODSPLATTER
  SeeSound ""
  DeathSound ""
  Decal "Bulletchip"
  States
  {
  Spawn:
    DART A 1 A_CustomMissile("NailBlur1", 0, 0, 180)
    DART A 0 A_PlaySound("weapons/nailflight")
    Loop
  Crash:
    DART B 0 A_PlaySound("weapons/nailhit")
    DART BCDEFG 2
    Stop
  XDeath:
    DART B 0 A_PlaySound("weapons/nailhitbleed")
    DART BCDEFG 2
    Stop
  Death:
    DART B 0 A_PlaySound("weapons/nailhit")
    DART BCDEFG 2
    Stop
  }
}

