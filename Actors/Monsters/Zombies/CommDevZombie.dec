Actor CommanderDevastatorZombie : DTDevastatorZombie
{
  Obituary "$CFCommanderDevastatorZombieObit"
  Health 350
  PainChance 20
  DropItem "Armorplate" 186 2
  DropItem "Portablemedkit" 159 2
  DropItem "Backpack" 58 1
  DropItem "CommanderDevUpgrade" 32 1
  DropItem "HandGrenadeAmmo" 210 3
  DropItem "MineAmmoRandomizer" 210 3
  DropItem "DemonAmmoBoxPickup" 128 
  DamageFactor "ZombieDev", 0.0
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Bloodcolor "Purple"
  +FLOORCLIP
  +QUICKTORETALIATE
  Tag "$CFCommDevaZom"
  var int user_loop;
  var int user_lowlag;
  States
  {
  Spawn:
    CDVZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:	
	CDVZ A 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ A 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ A 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ A 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ A 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ Z 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ Z 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ Z 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ Z 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ Z 2 A_Look
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
	CDVZ Z 1 A_PlaySound("devastator/idle",6,1.0,1)
    Loop
  /*See:
    CDVZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	CDVZ CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_PlayWeaponSound("devastator/idle")
    Loop*/
  See:
    TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CDVZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    Loop
  MoreSee:
    TNT1 A 0 A_SetUserVar("user_lowlag",1)
	CDVZ A 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ A 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    CDVZ C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ D 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ D 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_PlayWeaponSound("devastator/idle")
    Loop
  Missile:
	TNT1 A 0 A_JumpIfCloser(400,"Missile2")
	TNT1 A 0 A_Jump(128,"Missile2")
    CDVZ E 0 A_FaceTarget
	TNT1 A 0 A_StopSound(6)
    CDVZ E 0 A_PlaySound ("devastator/charge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
    CDVZ EEEEEEEEEEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
    CDVZ F 10 Bright
    CDVZ F 0 A_PlaySound ("devastator/fire")
	TNT1 A 0 A_FaceTarget
    CDVZ F 10 Bright A_CustomMissile("ZombieCommanderDevastatorBall",32,10,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    CDVZ E 50
    Goto See
  Missile2:
    TNT1 A 0 A_StopSound(6)
    CDVZ F 0 A_PlaySound ("Cardinal/9k")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	CDVZ EEEEEFFFFF 4 Bright A_FaceTarget
	CDVZ F 2 Bright A_CustomMissile("ZombiePurpleDTBFG10KBall",32,10,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	CDVZ E 70
    Goto See
  Pain:
    CDVZ G 3
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    CDVZ G 3 A_Pain
	TNT1 A 0 A_SpawnItemEx("RMPurpleParticleSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,160)
    Goto See
  Death:
    TNT1 A 0 A_StopSound(6)
    CDVZ H 5
    CDVZ I 5 A_Scream
    CDVZ J 5 A_NoBlocking
    CDVZ KLM 5
	CDVZ N 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CDVZ N -1
    Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
    CDVZ O 5
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	CDVZ O 3 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CDVZ P 5 A_XScream
    CDVZ Q 5 A_NoBlocking
    CDVZ RS 5
    CDVZ T -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	CDVZ NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	CDVZ TSRQPO 5
	Goto See
  }
}

Actor ATic : Inventory
{
  Inventory.Amount 4
  Inventory.MaxAmount 4
  -INVBAR 
}


Actor ZombieCommanderDevastatorBall : CommanderDevastatorBall
{
  Damage (Random(1500,2000))
  Obituary "$CFZombieCommanderDevastatorBallObit"
  DamageType "ZombieDev"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" A 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" C 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PurpleDevastatorTrail",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple2",frandom(6,-6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" D 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0,0)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,random(0,360))
	"CPS1" C 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple",frandom(6,-6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" A 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PurpleDevastatorTrail",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" D 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" B 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0,0)
	TNT1 A 0 A_JumpIfInventory("ATic",4,"SpawnLoop")
	TNT1 A 0 A_GiveInventory("ATic",1)
	Loop
  SpawnLoop:
	TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" A 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" C 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PurpleDevastatorTrail",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" D 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" C 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" A 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PurpleDevastatorTrail",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	TNT1 A 0 A_CustomMissile("ZombieCommDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("ZombieCommanderLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	"CPS1" D 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	"CPS1" B 1 Bright A_CustomMissile("ZombieCerComDevastatorTracerAttack",frandom(-4,4),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	Loop
  Death:
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 AAA 0 A_CustomMissile("ZombieDTBFG10KTracerPurple",0,0,user_loop * 10,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_JumpIf(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurpleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)	
	TNT1 A 0 A_Explode(64,256,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	"CPS1" A 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(64,256,0,0)
	"CPS1" B 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(64,256,0,0)
	"CPS1" C 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(64,256,0,0)
	"CPS1" D 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(64,256,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto DeathLoop2
	TNT1 A 0 A_Explode(128,1024,0,0)
	TNT1 A 0 A_Explode(256,640,0,0)
	TNT1 A 0 A_Explode(512,256,0,0)
	TNT1 AAA 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("PurpleDevastatorShockWave2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PurpleDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	TNT1 AAA 0 A_CustomMissile("ZombieCommanderDevastatorBall2",0,0,user_loop * 18,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 19,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	CPE1 AAAAAABBBBBBCCCCCCDDDDDD 1 Bright A_CustomMissile("PurpleKaboomDevastator2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	CPE1 EF 6 Bright
	TNT1 A 35
	Stop    
  }
}

Actor ZombieCerComDevastatorTracerAttack : CebComDTBFGTracerAttack
{
  Obituary "$CFZombieCerComDevastatorTracerAttackObit"
  DamageType "ZombieDev"
  States
  {
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(6,14),0,NONE,"80 00 FF",RGF_SILENT|RGF_FULLBRIGHT,1,2,"ZombieCommDevRailgunSlugPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor ZombieCommDevRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "ZombieDev"
}

Actor ZombieCommanderLiteShot : CommanderLiteShot
{
  Obituary "$CFZombieCommanderLiteShotObit"
  DamageType "ZombieDev"
}

Actor ZombieCommanderDevastatorBall2 : CommanderDevastatorBall2
{
  Obituary "$CFZombieCommanderDevastatorBall2Obit"
  DamageType "ZombieDev"
}

Actor ZombieCommDevastatorBolt : CommDevastatorBolt
{
  Obituary "$CFZombieCommDevastatorBoltObit"
  DamageType "ZombieDev"
}

Actor ZombiePurpleDTBFG10KBall : CommanderPurpleDTBFG10KBall
{
  Obituary "$CFZombiePurpleDTBFG10KBallObit"
  DamageType "ZombieDev"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	CPS1 A 1 Bright A_CustomMissile("ZombieCerComDTBFGTracerAttack",frandom(-8,8),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	CPS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),random(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	CPS1 C 1 Bright A_CustomMissile("ZombieCerComDTBFGTracerAttack",frandom(-8,8),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	CPS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  DTBFGSFX:
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	CPS1 A 1 Bright A_CustomMissile("ZombieCerComDTBFGTracerAttack",frandom(-8,8),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	CPS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),random(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(3,5,SMF_LOOK|SMF_PRECISE)
	CPS1 C 1 Bright A_CustomMissile("ZombieCerComDTBFGTracerAttack",frandom(-8,8),frandom(-8,8),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	CPS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Goto Spawn  
  Death:
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 AAA 0 A_CustomMissile("ZombieDTBFG10KTracerPurple",0,0,user_loop * 10,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurpleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	CPS1 ABCD 6 Bright A_SpawnItemEx("PurpleDTech10KShockwave",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,240,0,0)
	TNT1 AAA 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode",6)
	TNT1 A 0 A_SpawnItemEx("PurpleDTech10KShockwave2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 20 A_SpawnItemEx("PurpleDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE)
	Stop   
  }
}

Actor ZombieCerComDTBFGTracerAttack : CebComDTBFGTracerAttack
{
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(2,8),0,NONE,"80 00 FF",RGF_SILENT|RGF_FULLBRIGHT,0,2,"ZombiePurpleDTBFGRailgunSlugPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor ZombiePurpleDTBFGRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "ZombieDev"
}

Actor ZombieDTBFG10KTracerPurple : DTBFG10KTracerZombie
{
  +NOTIMEFREEZE
  States
  {
  XDeath:
	TNT1 A 1 A_SpawnItemEx("PurpleSpray")
	Stop
  }
}