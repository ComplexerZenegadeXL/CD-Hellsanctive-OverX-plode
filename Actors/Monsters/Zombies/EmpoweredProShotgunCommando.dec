Actor EmpoweredProShotgunCommando : ProShotgunCommando
{
  Health 330
  +MISSILEEVENMORE
  DropItem "NewShellPickup", 255, 4
  DropItem "NewShellBoxPickup", 128
  DropItem "HealthFlask", 55
  DropItem "ArmorCharge", 55
  DropItem "AmmoPack", 40
  DropItem "HandGrenadeAmmo", 100, 1
  DropItem "MineAmmoRandomizer", 50, 1
  DropItem "PortableMedkit", 190
  DropItem "ArmorPlate", 190
  DropItem "BackPack", 56
  DropItem "ShieldSphere", 32
  DropItem "RapidShotgun", 20
  DropItem "SphereOfPower" 196
  //AttackSound "weapons/ExplosiveSG/fire"
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFEmpoweredProShotgunCommandoObit"
  Tag "$CFEmpComm"
  States
  {
  Spawn:
	EGCH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	EGCH AZ 10 A_Look
	Loop
  See:
	EGCH AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop
  Chase:
	EGCH AA 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	EGCH AA 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	EGCH BB 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	EGCH BB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	EGCH CC 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	EGCH CC 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	EGCH DD 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	EGCH DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(64,"Dodge")
	Loop
 Strafing:
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	EGCH AABB 3 A_GiveInventory("CFCommandoStrafing",1)
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	EGCH CCDD 3 A_GiveInventory("CFCommandoStrafing",1)
	Goto See	
  SeeNoDodge:
	EGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	EGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Goto Chase
 Dodge:
	EGCH A 1 A_FaceTarget
	TNT1 A 0 ThrustThingZ(0,20,0,0)
	TNT1 A 0 A_Jump(256,"DodgeRight","DodgeLeft")
  DodgeLeft:
	TNT1 A 0 ThrustThing(angle*256/360+192,15,0,0)
	Goto SeeNoDodge
  DodgeRight:
	TNT1 A 0 ThrustThing(angle*256/360+64,15,0,0)
	Goto SeeNoDodge
  Missile:
	TNT1 A 0 A_SetUserVar("user_attack",1)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_JumpIfCloser(250,"CloserAttack")
	EGCH EE 5 A_FaceTarget(45)
  Refire:
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	EGCH E 4 Bright A_CustomBulletAttack(0,0,1,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	EGCH F 4 Bright A_CustomBulletAttack(0,0,1,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	TNT1 A 0 A_Jump(20,"Pause")
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	Loop
  CloserAttack:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
	EGCH A 1 A_GiveInventory("CFCommandoStrafing",1)
	EGCH A 2 A_FaceTarget
	EGCH B 1 A_GiveInventory("CFCommandoStrafing",1)
	EGCH B 2 A_FaceTarget
	EGCH BC 2 A_FaceTarget
	EGCH C 1 A_GiveInventory("CFCommandoStrafing",1)
	EGCH C 2 A_FaceTarget
	EGCH D 1 A_GiveInventory("CFCommandoStrafing",1)
	EGCH D 2 A_FaceTarget
  Refire2:
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	EGCH Q 4 Bright A_CustomBulletAttack(0,0,1,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 Bright A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	EGCH R 4 Bright A_CustomBulletAttack(0,0,1,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-98),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 Bright A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	EGCH S 4 Bright A_CustomBulletAttack(0,0,1,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",6)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-23,23),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 Bright A_CustomBulletAttack(22.5,18.3,4,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	EGCH T 4 Bright A_CustomBulletAttack(0,0,1,Random(12,18),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	TNT1 A 0 A_Jump(15,"Pause")
	Loop
  MissileEnd:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	Goto See
  Pause:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	EGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	EGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	EGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	EGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	EGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	Goto See
  Pain:
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(96,"NoPainShield")
  PainShield:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
  NoPainShield:
	TNT1 A 0 A_JumpIf(user_attack > 0,"WeapodDown")
	EGCH G 6 A_Pain
	Goto See
  WeapodDown:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	EGCH G 6 A_Pain
	Goto See
  Death:
	EGCH H 5 A_StopSound(CHAN_WEAPON)
	EGCH I 5 A_Scream 
	EGCH J 5 A_Fall 
	EGCH K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EGCH LMNO 5
	EGCH P -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	EGCH PONMLKJIH 5
	Goto See
  }
}

Actor SummonedEmpoweredProShotgunCommando : EmpoweredProShotgunCommando { -COUNTKILL }