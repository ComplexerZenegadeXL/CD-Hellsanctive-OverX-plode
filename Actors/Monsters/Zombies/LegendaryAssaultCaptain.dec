Actor LegendaryAssaultCaptain 16501
{
  //$Category Monsters/LCA
  //$Sprite LASGA1
  //$Title "Legendary Assault Captain"
  Health 1020
  Radius 20
  Height 56
  Speed 12
  PainChance 20
  Species "Zombie"
  Monster
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  SeeSound "lasgguy/sight"
  AttackSound "Weapons/LegAutoShotgun"
  PainSound "lasgguy/pain"
  DeathSound "lasgguy/death"
  ActiveSound "lasgguy/active"
  Obituary "$CFLegendaryAssaultCaptainObit"
  BloodColor "Blue"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryAssaultShotgunGiver" 202
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 130
  DropItem "LegendaryPowerShard" 30 1
  DropItem "LegendaryArmor" 92 1
  DropItem "LegendaryAmmoSphere" 95 1
  DropItem "HandGrenadeAmmo" 237 2
  DropItem "MineAmmoRandomizer" 242 2
  DropItem "Backpack" 202 1
  DropItem "Armorplate" 212 1
  DropItem "Portablemedkit" 217 1
  DropItem "StimKit" 222 3
  DropItem "HealthFlask" 227 5
  DropItem "ProxLauncherGiver" 64
  DropItem "ProxMines" 196
  DropItem "LegendaryRandomSphere" 16 1
  Species "Zombie"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PDTBFG", 0.20
  DamageFactor "PDTBFGTracer", 0.20
  DamageFactor "PlayerDevBall", 0.120
  DamageFactor "PlayerDevBall2", 0.120
  DamageFactor "PlayerDevTracer", 0.120
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LACGrenade", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.70
  Tag "$CFLegSguy"
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LASG A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    LASG AZ 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LASG AABB 4 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,9)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    LASG AABB 4 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG CCDD 4 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(64,"Mine")
	LASG A 0 A_Jump(64,"Rush")
	TNT1 A 0 A_Jump(64,"DodgeLeft","DodgeRight")
	TNT1 A 0 A_Jump(64,"Chase")
	Loop
  Chase:
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LASG AA 1 Bright A_FastChase
	TNT1 A 0 A_Jump(1,"Heal")
	LASG A 0 A_JumpIfCloser(130,"Dodge")
	LASG AA 1 Bright A_Chase
	LASG A 0 A_JumpIfCloser(130,"Dodge")
	LASG BB 1 Bright A_Chase
	LASG A 0 A_JumpIfCloser(130,"Dodge")
	LASG BB 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG A 0 A_JumpIfCloser(150,"Dodge")
	LASG CC 1 Bright A_Chase
	TNT1 A 0 A_Jump(10,"Heal")
	LASG A 0 A_JumpIfCloser(150,"Dodge")
	LASG CC 1 Bright A_FastChase
	LASG A 0 A_JumpIfCloser(130,"Dodge")
	LASG DD 1 Bright A_FastChase
	LASG A 0 A_JumpIfCloser(130,"Dodge")
	LASG DD 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(95,"Mine")
	LASG A 0 A_Jump(128,"Dodge")
	Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegASGZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(85,"See")
	Loop
  Heal:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	LASG A 5 Bright
	TNT1 A 0 HealThing(5)
	TNT1 A 0 A_PlaySound("pickups/flask",0,1.0,0)
	Goto See
  Heal2:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	LASG A 5 Bright
	TNT1 A 0 HealThing(10)
	TNT1 A 0 A_PlaySound("pickups/pstimpack",0,1.0,0)
	Goto See
  Heal3:
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	LASG A 5 Bright
	TNT1 A 0 HealThing(15)
	TNT1 A 0 A_PlaySound("pickups/pmedkit",0,1.0,0)
	Goto See
  SeeNoDodge:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	LASG CCDD 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Goto Chase
  Dodge:
	LASG A 1 Bright A_FaceTarget
	LASG E 0 ThrustThingZ(0, 20, 0, 0)
	LASG A 0 A_Jump(256, "DodgeRight", "DodgeLeft")
  DodgeLeft:
	LASG E 0 ThrustThing(angle*256/360+192, 15, 0, 0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	Goto SeeNoDodge
  DodgeRight:
	LASG E 0 ThrustThing(angle*256/360+64, 15, 0, 0)
	TNT1 A 0 A_Jump(40,"Heal")
	TNT1 A 0 A_Jump(35,"Heal2")
	TNT1 A 0 A_Jump(30,"Heal3")
	Goto SeeNoDodge
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	LASG E 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIfInventory ("ASGZAmmo", 16, "Reload")
    LASG E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_GiveInventory ("ASGZAmmo", 1)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing", -8, 7, 30, 4, 0, frandom(3, 4), Random(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 Bright A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	LASG F 2 Bright A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LASG E 4 Bright A_FaceTarget
	TNT1 A 0 Bright A_CPosRefire
    TNT1 A 0 A_Jump(6,"Heal")
    TNT1 A 0 A_Jump(5,"Heal2")
    TNT1 A 0 A_Jump(4,"Heal3")
	TNT1 A 0 A_Jump(10,"Grenade")
    TNT1 A 0 A_JumpIfCloser(300,"Grenade")
    Goto Missile+4
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootstep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LASG AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LASG BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootstep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LASG CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LASG DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Mine:
	LASG C 1 Bright
	LASG C 12 Bright A_CustomMissile("LACThrownMine",32,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,15)
	LASG E 12 Bright
	LASG C 3 Bright
	Goto See
  Grenade:
	TNT1 A 0 A_PlaySound("weapons/hgrenadepin",0,1.0,0)
	LASG CE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/hgrenadethrow",0,1.0,0)
	LASG E 1 Bright A_CustomMissile("LegThrownGrenade",32,0,0,2,4)
	Goto Dodge
  Reload:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("lasgguy/asgout")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    LASG E 48 Bright A_TakeInventory ("ASGZAmmo", 16)
    LASG E 8 Bright A_PlaySound("lasgguy/asgin") 
	LASG E 20 Bright A_PlaySound("LShotgun/Cock")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  Pain:
	TNT1 A 0 A_Jump(10,"Protection")
	TNT1 A 0 A_Jump(20,"Dodge")
	TNT1 A 0 A_Jump(192,"PainMissile")
    LASG G 3 Bright
    LASG G 3 Bright A_Pain
	TNT1 A 0 A_Jump(40,"Dodge")
    Goto See
  PainMissile:
    LASG G 3 Bright
    LASG G 3 Bright A_Pain
    Goto Missile	
  Protection:
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LASG E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0)
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    LASG H 5
    LASG I 5 A_Scream
    LASG J 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LASG J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LASG K 5
    LASG L -1
    Stop
  LegendarySoul:
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LASG H 5
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LASG I 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LASG J 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LASG K 5
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LASG L 140
	LASG L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LASG LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION )
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION )
	LASG L -1
    Stop	
  XDeath:
	TNT1 A 0 A_StopSound(6)
    TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	LASG O 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LASG P 5 A_XScream
    LASG Q 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LASG RSTUV 5
    LASG W -1
    Stop
  }
}

Actor ASGZAmmo: Ammo { Inventory.MaxAmount 16 }

Actor LegASGZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LASG A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegASGZombieGhostB : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LASG B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor LegASGZombieGhostC : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LASG C 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor LegASGZombieGhostD : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LASG D 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor LACGrenade : ThrownGrenade
{
  Damagetype "Legendary"
  Damage (0)
  Obituary "$CFLACGrenadeObit"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
    HGN1 A 3 A_StopSound
    HGN1 BCDEFGHABCDEFGHABCDEFGH 3
    Goto Death      
  Death: 
   	TNT1 A 0
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySound("weapons/hgrenadeex")
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    MISL B 4 Bright A_CustomMissile("LACGrenadeExplosion",0,0,0,CMF_TRACKOWNER)
    MISL CD 4 Bright A_SetTranslucent(0.75,1)
    Stop
  }
}

Actor LACGrenadeExplosion
{
  Radius 1
  Height 1
  Speed 0
  Scale 2.4
  Projectile
  DamageType "LACGrenade"
  RenderStyle Add
  Alpha 0.95
  +FLOORHUGGER
  +NOCLIP
  +NODAMAGETHRUST
  +NORADIUSDMG
  +NOTIMEFREEZE
  Obituary "$CFLACGrenadeExplosionObit"
  States
  {
   Spawn:
	TNT1 A 1 
	TNT1 A 0 A_Explode(128,146)
	Stop
  }
}

Actor LACThrownMine : ThrownMine
{
  Species "Zombie"
  Obituary "$CFLACThrownMineObit"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	LLIN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_CheckFloor("Death")
	LLIN BBBBBBBBBB 1 Bright A_CheckFloor("Death")
	LLIN A 0 A_CountDown
	Loop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Scream
	TNT1 A 0 A_ChangeFlag("NOINTERACTION",1)
	LLIN A 1 A_CustomMissile("LACLiveMine",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Stop
  }
}

Actor LACLiveMine
{
  Scale 0.85
  Projectile
  Radius 10
  Height 8
  Mass 1000000
  Speed 0
  Health 10
  +DROPOFF
  +FLOORCLIP
  +NOTELEPORT
  +NODAMAGE
  +FORCEPAIN
  -NOGRAVITY
  +MOVEWITHSECTOR
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  //+THRUACTORS
  -NOBLOCKMAP
  +CANBOUNCEWATER
  +FORCEYBILLBOARD
  +SHOOTABLE
  +NOTIMEFREEZE
  +NOBLOOD
  Species "Zombie"
  DamageType "Legendary"
  Obituary "$CFLACLiveMineObit"
  var int user_counter;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	LLIN AAAB 10
	//LLIN AB 1
  SpawnLoop:
	LLIN AAA 10 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Attack")
	LLIN B 10 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Attack")
	TNT1 A 0 A_JumpIf(user_counter >= 18,"Attack")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	Loop
  Attack:
  Death:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	LLIN B 15 Bright A_PlaySound("weapons/minebeep")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Explode(Random(200,225),160,0)
	TNT1 A 0 A_SpawnItemEx ("BarrelKaboom",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("weapons/mineexplode")
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("LegendaryBlueRocketEx",0,0,0,0,0,0,0)
	Stop
  }
}

