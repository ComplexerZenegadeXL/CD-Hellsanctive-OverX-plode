Actor NemesisCommando : LegendaryCommando //28007
{
  Health 1800
  Speed 20
  BloodColor "Black"
  DamageFactor 0.6
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Explosion", 0.2
  DamageFactor "PlayerDTRG", 0.4
  DamageFactor "DTRailgun", 0.4
  DamageFactor "PDTPuff", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "PlayerPyro", 0.2
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "VileFires", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "Superweapon", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "EnragedLegendaryArmor", 100
  DropItem "LegendaryAmmoSphere", 88
  DropItem "EnragedLegendaryPowerShard", 50
  DropItem "HandGrenadeAmmo", 235, 2
  DropItem "MineAmmoRandomizer", 235, 2
  DropItem "Backpack", 198
  DropItem "Armorplate", 205
  DropItem "Portablemedkit", 210
  DropItem "NLDemonAmmoBoxPickup", 200 
  DropItem "NLDemonAmmoPickup", 250 
  //DropItem "NemesisPlasmaticCannonGiver", 128
  SeeSound "NemesisCommando/sight"
  PainSound "NemesisCommando/pain"
  DeathSound "NemesisCommando/death"
  ActiveSound "NemesisCommando/active"
  Obituary "$CFNemesisCommandoObit"
  Tag "$CFNemChain"
  var int user_deathtimer;
  var int user_deathtimeractive;
  var int user_loop;
  States
  {
  Spawn:
	NCOS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
    NCOS A 10 Bright A_Look
	NCOI A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NCOS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_deathtimeractive == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("NemesisDeathTimerForVexed",0)
	TNT1 A 0 A_SetUserVar("user_deathtimeractive",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,703)
	TNT1 A 0 A_SetUserVar("user_music",1)
    NCOS A 0 A_JumpIfTargetInLOS("Strafing")
    NCOS AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	NCOS A 0 A_JumpIfTargetInLOS("Strafing")
	NCOS CCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Teleport")
	NCOS A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
    Loop
  Rush:
    NCOS A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisCommandoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NCOS D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NCOS AA 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NCOS BB 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    NCOS CC 3 Bright A_GiveInventory("NLegZombieStrafing2",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	NCOS DD 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	Goto See
  Teleport:
	NCOS A 1 Bright A_UnSetShootable
	NCOS AAAAAAAAAA 1 Bright A_FadeOut(0.1,0)
	NCOS A 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	NCOS A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NCOS AAAAAAAAAA 1 Bright A_FadeIn(0.1)
	NCOS A 1 Bright A_SetShootable
	Goto See  
  Pause:
	NCOS EEEEE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	Goto See	
  Missile:
	TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(88,"Laser","IonBeam","MiniBFG","10kProjectiles")
  Normal:
	NCOS EEEE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	NCOS E 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_CustomMissile("NemesisZombieCannonProj",32,0,0)
	NCOS F 3 Bright A_PlaySound("NemesisCannon/Fire",7)
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+3
  Laser:
	NCOS E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	NCOS E 1 Bright A_FaceTarget
	NCOS EEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	TNT1 A 0 A_PlaySound("NemesisCannon/Mode2")
	NCOS EEEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	NCOS E 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LaserLoop:
	TNT1 A 0 A_PlaySound("NemesisCannon/Laser",7)
	TNT1 A 0 A_CustomMissile("NemesisZombieCannonLaser",32,0,frandom(-6,6))
	NCOS FE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	NCOS EEEEEE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_Jump(80,"MiniBFG")
	Goto See
  IonBeam:
	NCOS E 0 A_PlaySound("cydes/mischrg",7,1,0,0.5)
	NCOS E 1 Bright A_FaceTarget
	NCOS EEEEEEEEEEEEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	TNT1 A 0 A_PlaySound("NemesisCannon/BigLaser",CHAN_WEAPON)
	NCOS F 7 A_CustomMissile("NemesisZombieCannonIonBeam",32,0,0)
	NCOS E 10 A_FaceTarget
	TNT1 A 0 A_Jump(196,"See")
	TNT1 A 0 A_PlaySound("NemesisCannon/BigLaser",CHAN_WEAPON)
	NCOS F 7 A_CustomMissile("NemesisZombieCannonIonBeam",32,0,0)
	NCOS E 10 A_FaceTarget
	Goto See
  MiniBFG:
	NCOS E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	NCOS E 0 A_PlaySound("superzombie/sight")
	NCOS E 1 Bright A_FaceTarget
	NCOS EEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	TNT1 A 0 A_PlayWeaponSound("star/load3")
	NCOS EEEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	NCOS E 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	NCOS F 0 A_PlayWeaponSound("star/fire")
	NCOS F 7 Bright A_CustomMissile("MiniNemesisBFGBall",32,0,0)
	NCOS EEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	NCOS F 0 A_PlayWeaponSound("star/fire")
	NCOS F 7 Bright A_CustomMissile("MiniNemesisBFGBall",32,0,0)
	NCOS EEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	NCOS E 8 Bright A_FaceTarget
	Goto See
  10kProjectiles:
	NCOS E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	NCOS E 1 Bright A_FaceTarget
	NCOS EEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	NCOS EEEEEEEE 3 Bright A_GiveInventory("NLegZombieStrafing3",1)
	NCOS E 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_loop",0)
  10kProjectilesLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Nemesis10kProjectile",32,0,frandom(-4,4))
	NCOS FE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	NCOS EEEEEE 3 Bright A_GiveInventory("NLegZombieStrafing2",1)
	TNT1 A 0 A_Jump(80,"MiniBFG")
	Goto See
  Pain:
	TNT1 A 0 A_Jump(35,"Teleport")
	NCOS G 3 Bright
	NCOS G 3 Bright A_Pain
	TNT1 A 0 A_Jump(192,"Missile")
	Goto See
  XDeath:
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",3)
	TNT1 A 0 ACS_NamedExecuteWithResult("VexCheck",0,10)
    TNT1 A 0 A_Jump(36,"LegendarySoul")
	NCOS H 5 A_Scream
    NCOS I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("NemesisDust",random(1,3),256)
    NCOS J 5 A_SpawnItem("BodyCrash",0,0,0,0)
    NCOS KLM 5 
	TNT1 A 0 A_Jump(100,"MoreStuff")
    NCOS N -1 
	Stop
  MoreStuff:
	NCOS N 100
	TNT1 A 0 A_SpawnItem("HellionSmokeAttack")
	NCOS NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 1 A_SpawnItem("NemesisZombieItemRandomizer")
	NCOS N 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	NCOS N -1
	Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NCOS H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    NCOS I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    NCOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    NCOS K 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    NCOS L 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    NCOS M 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NCOS N 140
	NCOS N 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	NCOS NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	NCOS N -1
	Stop	
  VexedSpawn:
	NCOS G 3 Bright A_Pain
	NCOS G 0 A_PlaySoundEx("brain/spit",7,0,2)
	NCOS GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisLightning")
	NCOS GGGGGGGGGGGG 2 Bright A_SpawnItemEx("VexedNemesisFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisCommando",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop	
  }
}

Actor SummonedNemesisCommando : NemesisCommando { -COUNTKILL }

Actor NemesisZombieCannonLaser : NemesisCannonLaser
{
  DamageType "Legendary"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(100,128,0,1)
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteProjExplode")
	TNT1 AAAA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 A 10
    Stop
  }
}

Actor NemesisZombieCannonIonBeam : NemesisCannonIonBeam
{
  DamageType "Legendary"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(400,256,0,1)
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteProjExplodeLarge")
	TNT1 AAAA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisZombieCannonProj2",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(170,190),SXF_NOCHECKPOSITION)	
	TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("NemesisZombieCannonProj2",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(-14,14),SXF_NOCHECKPOSITION)
    TNT1 A 50 Bright
    Stop
  }
}

Actor NemesisZombieCannonProj : NemesisCannonProj
{
  Damage (Random(100,200))
  DamageType "Legendary"
  States
  {
  Death:
	TNT1 A 0 A_PlaySound("weapons/rocklx",2)
  XDeath:
	TNT1 A 0
	TNT1 AA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 I 8 A_Explode(32,80,0)
	TNT1 J 6
	TNT1 K 4
	Stop
  }
}

Actor NemesisZombieCannonProj2 : NemesisZombieCannonProj { Damage (Random(20,35)) }

Actor Nemesis10kProjectileZombie : Nemesis10kProjectile { DamageType "Legendary" }

Actor NLegZombieStrafing3 : LegZombieStrafing
{
States
{
  Pickup:
	TNT1 A 0 A_SpawnItem("TrueNemesisHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegCommandoStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegCommandoStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,6,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-6,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop	
  }
}

Actor NemesisCommandoGhost : LegCommandoGhost
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    NCOS A 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor NLegZombieStrafing2 : LegZombieStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegCommandoStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegCommandoStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,6,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-6,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop	
  }
}