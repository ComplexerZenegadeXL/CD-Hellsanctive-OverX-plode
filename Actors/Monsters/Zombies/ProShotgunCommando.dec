Actor ProShotgunCommando
{
  Monster 
  Health 220
  Height 56
  Radius 20
  Speed 20
  Mass 100
  MaxTargetRange 2048
  MinMissileChance 100
  PainChance 43
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species ""
  DropItem "NewShellPickup", 255, 4
  DropItem "NewShellBoxPickup", 128
  DropItem "HealthFlask", 55
  DropItem "ArmorCharge", 55
  DropItem "AmmoPack", 40
  DropItem "HandGrenadeAmmo", 100, 1
  DropItem "MineAmmoRandomizer", 50, 1
  DropItem "PortableMedkit", 190
  DropItem "ArmorPlate", 190
  DropItem "BackPack", 56
  DropItem "ShieldSphere", 32, 1
  DropItem "FlareBox", 32
  //AttackSound "weapons/12gaugefire"
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFProShotgunCommandoObit"
  Tag "$CFProComm"
  var int user_attack;
  States
  {
  Spawn:
	SGCH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	SGCH AZ 10 A_Look
	Loop
  See:
	SGCH AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop
  Chase:
	SGCH AA 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	SGCH AA 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	SGCH BB 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	SGCH BB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	SGCH CC 1 A_Chase
	TNT1 A 0 A_JumpIfCloser(150,"Dodge")
	SGCH CC 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	SGCH DD 1 A_FastChase
	TNT1 A 0 A_JumpIfCloser(130,"Dodge")
	SGCH DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(64,"Dodge")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	SGCH AABB 3 A_GiveInventory("CFCommandoStrafing",1)
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	SGCH CCDD 3 A_GiveInventory("CFCommandoStrafing",1)
	Goto See	
  SeeNoDodge:
	SGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	SGCH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Goto Chase
  Dodge:
	SGCH A 1 A_FaceTarget
	TNT1 A 0 ThrustThingZ(0,20,0,0)
	TNT1 A 0 A_Jump(256,"DodgeRight","DodgeLeft")
  DodgeLeft:
	TNT1 A 0 ThrustThing(angle*256/360+192,15,0,0)
	Goto SeeNoDodge
  DodgeRight:
	TNT1 A 0 ThrustThing(angle*256/360+64,15,0,0)
	Goto SeeNoDodge
  Missile:
	TNT1 A 0 A_SetUserVar("user_attack",1)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_JumpIfCloser(250,"CloserAttack")
	SGCH EE 5 A_FaceTarget(45)
  Refire:
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",CHAN_WEAPON,1.0,1)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,Random(2,6),0,Random(1,3),Random(-80,-90),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	SGCH E 4 Bright A_CustomBulletAttack(0,0,1,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_FaceTarget
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	SGCH F 4 Bright A_CustomBulletAttack(0,0,1,Random(9,15),"ZBulletPuff",8192,CBAF_NORANDOM)
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	TNT1 A 0 A_Jump(20,"Pause")
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	Loop
  CloserAttack:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
	SGCH A 1 A_GiveInventory("CFCommandoStrafing",1)
	SGCH AB 1 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH BCC 1 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH CD 1 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH DD 1 A_FaceTarget
  Refire2:
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",CHAN_WEAPON,1.0,1)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH Q 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH R 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH S 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),CMF_OFFSETPITCH,frandom(-3.0,3.0))
	TNT1 A 0 A_SpawnItemEx("ShellCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",6)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_GiveInventory("CFCommandoStrafing",1)
	SGCH T 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"ZBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	TNT1 A 0 A_Jump(15,"Pause")
	Loop
  MissileEnd:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	Goto See
  Pause:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	SGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	SGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	SGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	SGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	SGCH A 3 A_FaceTarget
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	Goto See
  Pain:
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(96,"NoPainShield")
  PainShield:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
  NoPainShield:
	TNT1 A 0 A_JumpIf(user_attack > 0,"WeapodDown")
	SGCH G 6 A_Pain
	Goto See
  WeapodDown:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	SGCH G 6 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	SGCH H 5 A_StopSound(CHAN_WEAPON)
	SGCH I 5 A_Scream 
	SGCH J 5 A_Fall 
	SGCH K 5 A_SpawnItem("BodyCrash",0,0,0,0)
	SGCH LMNOP 5
	SGCH P -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	SGCH PONMLKJIH 5
	Goto See
  }
}

Actor SummonedProShotgunCommando : ProShotgunCommando { -COUNTKILL }

Actor CFCommandoStrafing : CustomInventory
{
  -COUNTITEM
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,3,0,0) //3
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-3,0,0) //-3
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
	Stop
	TNT1 A 0 A_Recoil(1)
	Stop	
  }
}

Actor MonsterStrafeLeft : CFCommandoStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 ThrustThing(angle*256/360+64,3+Random(0,2),0,0) //3
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(0.1)
	Stop
  }
}

Actor MonsterStrafeRight : CFCommandoStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 ThrustThing(angle*256/360+192,3+Random(0,2),0,0) //-3
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(0.1)
	Stop
  }
}

Actor MonsterFadeOut : CFCommandoStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 A_FadeOut(0.1,0)
    Stop
  }
}

Actor MonsterFadeIn : CFCommandoStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 A_FadeIn(0.1)
    Stop
  }
}

Actor MonsterTeleport : CFCommandoStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 A_Wander
	TNT1 A 0 A_FaceTarget
    Stop
  }
}