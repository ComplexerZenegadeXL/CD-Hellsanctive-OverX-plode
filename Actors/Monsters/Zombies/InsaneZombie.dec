Actor InsaneZombie
{
  Health 350
  Radius 20
  Height 56
  Speed 8
  PainChance 200
  Species ""
  Monster
  +FLOORCLIP
  +AVOIDMELEE
  +FLOAT
  +NOGRAVITY
  +MISSILEEVENMORE
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOGRAVITY
  +DONTFALL
  +NOICEDEATH
  DamageFactor "Normal", 0.65
  DamageFactor "EMGEx", 0.0
  DropItem "HandGrenadeAmmo" 80 2
  DropItem "MineAmmoRandomizer" 45 1
  DropItem "AmmoPack" 128
  DropItem "AmmoPack" 64
  DropItem "AmmoPack" 32
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFInsaneZombieObit"
  Tag "$CFInsZom"
  var int user_script;
  States
  {
  Spawn:
	INZM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,42)
    TNT1 A 0 A_SetUserVar("user_script",1)
  Idle:
    INZM AAAAA 4 A_Look
    Loop	
  See:
    INZM AAA 2 A_Chase
	TNT1 A 0 A_Jump(80,"Evade")
    INZM AAA 2 A_Chase
	TNT1 A 0 A_Jump(80,"Evade")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	INZM AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	INZM AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"lasers")
	INZM AAA 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	INZM B 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,-10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")	
	INZM C 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	INZM A 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	INZM B 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,-10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	INZM C 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,-10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	INZM A 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	INZM B 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,-10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	INZM C 3 Bright A_CustomMissile("MinigunnerExplosiveTracer",32,-10,frandom(-6,6))
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 14, 6, 36, 4, 0, frandom(3, 4), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(80,1)
	Goto See
	TNT1 A 0
	Goto Missile+1
  Lasers:
	INZM AAA 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	INZM B 3 Bright A_CustomMissile("SpecOpsLaser",32,-10,frandom(-6,6))
	TNT1 A 0 A_PlaySound("monsters/fusionfire")	
	INZM C 3 Bright A_CustomMissile("SpecOpsLaser",32,10,frandom(-6,6))
	INZM A 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	INZM B 3 Bright A_CustomMissile("SpecOpsLaser",32,-10,frandom(-6,6))
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	INZM C 3 Bright A_CustomMissile("SpecOpsLaser",32,-10,frandom(-6,6))
	INZM A 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	INZM B 3 Bright A_CustomMissile("SpecOpsLaser",32,-10,frandom(-6,6))
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	INZM C 3 Bright A_CustomMissile("SpecOpsLaser",32,-10,frandom(-6,6))
	Goto See
  Pain:
    INZM A 3
    INZM A 3 A_Pain
    Goto See
  Death:
  XDeath:
	INZM A 0 A_StopSound(7)
    INZM A 0 A_Scream
    INZM E 2 ThrustThingZ(0,frandom(2,8),0,0)
    INZM E 0 ThrustThing(frandom(0,255),frandom(2,8),0,0)
    INZM F 2 A_NoBlocking
    INZM GHIEFGHIE 2
    INZM IE 2
    INZM F 2 A_SpawnItemEx("CFKaboom",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE)
    INZM GH 2
    INZM E 2 A_SpawnItemEx("CFKaboom",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE)
    INZM FG 2
    INZM H 2 A_SpawnItemEx("CFKaboom",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE)
    INZM AAAAAA 0 A_SpawnItemEx("CFKaboom",frandom(-30,30),frandom(-30,30),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE)
    INZM A 0 A_SpawnItemEx("GibbedGenerator")
    Stop
  }
}

Actor Jetfire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  RenderStyle Add
  Scale 0.2
  States
  {
  Spawn:
	TNT1 A Random(0,3)
	FIR1 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor JetfireSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_PlaySound("monster/ambientfire")
    TNT1 AAAAAA 0 A_SpawnItemEx("Jetfire",-17,0,30,frandom(-3,1),frandom(-2,2),frandom(-6,-2),0,SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
  }
}