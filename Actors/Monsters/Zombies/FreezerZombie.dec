Actor FreezerZombie : ChaingunGuy 16555
{
  //$Category Monsters/LCA
  //$Sprite FRZRA1
  //$Title "Freezer Zombie"
  Health 215
  Radius 20
  Height 56
  Speed 8
  Mass 100
  PainChance 105
  Species ""
  Monster 
 +FLOORCLIP
 +MISSILEMORE
 +MISSILEEVENMORE
  +QUICKTORETALIATE
  SeeSound "fzombie/sight"
  PainSound "fzombie/pain"
  DeathSound "fzombie/death"
  ActiveSound "fzombie/active"
  Obituary "$CFFreezerZombieObit"
  DropItem "FreezerRifleGiver" 64 1
  DropItem "HandGrenadeAmmo" 142 2
  DropItem "MineAmmoRandomizer" 167 2
  DropItem "Armorplate" 152 1
  DropItem "Portablemedkit" 156 1
  DropItem "Backpack" 122 1
  DropItem "NewCellPackPickup" 128 
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  Tag "$CFIceZom"
  var int user_loop;
  States
  {
  Spawn:
    FRZR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	FRZR AZ 10 A_Look
    Loop
  See:
    FRZR AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
	FRZR CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Pause:
	FRZR E 20
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfCloser(325,"Missile3")
  Missile2:
	FRZR E 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/iceshot",1)
	FRZR F 2 Bright A_CustomMissile("NewZombieFreezeBlast", 30, 4, 0)
	FRZR E 4 A_FaceTarget
	TNT1 D 0 A_PlaySound("weapons/chill",5)
	TNT1 A 0 A_Jump(1,"Pause")
	TNT1 A 0 A_SentinelRefire
	Goto Missile2+1
  Missile3:
	TNT1 A 0 A_PlaySound("freeze/altfire",1)
	FRZR EE 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("freeze/althold",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Missile3Loop:
	FRZR F 1 Bright A_CustomMissile("ZombieFlameShot",32,0,frandom(-4,4),0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 19,1)
	Goto Missile3Loop
	TNT1 A 0 A_PlaySound("freeze/altstop",1)
	FRZR E 24
	Goto See
  Pain:
    FRZR G 3
    FRZR G 3 A_Pain
    Goto See
  Death.PlayerIce:
  Death:
    FRZR H 5
    FRZR I 5 A_Scream
    FRZR J 5 A_Fall
    FRZR K 5
	FRZR L 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FRZR L -1
    Stop
  XDeath:
    FRZR O 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FRZR O 3 A_GiveInventory("XDeathCheck",1)
	FRZR P 5 A_XScream
    FRZR Q 5 A_Fall
    FRZR RSTU 5
    FRZR V -1
    Stop
  Burn:
    BURN A 5 Bright
    BURN B 5 Bright A_Pain
    BURN CD 5 Bright
    BURN E 5 Bright A_Pain
    BURN FG 5 Bright
    BURN H 5 Bright A_Pain
    BURN IJKLM 5 Bright
    BURN N 5 Bright A_Scream
    BURN O 5 Bright A_NoBlocking
    BURN PQRSTU 5 Bright
    BRNT V -1 
    Stop        
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	FRZR LKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	FRZR VUTSRQPO 4
	Goto See
  }
}

Actor ZombieFreezeBlast
{
  Game Doom
  SpawnID 51
  Radius 13
  Height 8
  Speed 55
  Damage 12
  Projectile
  +RANDOMIZE
  RenderStyle Add
  Alpha 0.75
  Scale 0.9
  SeeSound "weapons/iceshot"
  DeathSound "weapons/icehit"
  DamageType "Ice"
  Decal "FreezeBlastMelt"
  States
  {
  Spawn:
    FBLS A 6 Bright A_SpawnItemEx("FreezeBlastTrail",0,0,0,0,0,0,0)
    Loop
  Death:
    TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    FBLS BCDE 4 Bright
    Stop
  }
}

Actor ProjectileTrailParticleBlue :  EnergyProjectileSparkGreen
{
  +NOGRAVITY
  Scale 0.02
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	SPKB A 2 Bright A_FadeOut(0.08)
	Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}