Actor AHellionSmoke
{
  +MISSILE
  +DONTSPLASH
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  +NONETID
  Scale 0.4
  RenderStyle Normal
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LMKE ABCDEFGHIJKL 2 Bright A_FadeOut
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegHellionSmoke2 : AHellionSmoke { Scale 0.6 +NOTIMEFREEZE }

Actor LegSoulSmoke : AHellionSmoke { Scale 0.12 +NOTIMEFREEZE }

Actor LHellionSmokeSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("AHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor LHellionSmokeAttackSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("LegHellionSmoke2",frandom(-12,12),frandom(-12,12),frandom(12,18),0,0,frandom(6,9),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("LegHellionSmoke2",frandom(-22,22),frandom(-22,22),frandom(6,12),0,0,frandom(3,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop	
  }
}

Actor LegZombieStrafing : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE       
  +COUNTITEM
  Inventory.MaxAmount 0
  +NOTIMEFREEZE
  States
  {
  Pickup:
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,3,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-3,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop	
  }
}

Actor LegZombieJumping : LegZombieStrafing
{
  +NOTIMEFREEZE
  States
  {
  Pickup:
    TNT1 A 1 A_CheckFloor(1)
    Stop
	TNT1 A 1 A_Jump(242,2)
	TNT1 A 1 ThrustThingZ(0,25,0,1)
    Stop
	TNT1 A 1
    Stop
  }
}

Actor LegZombieStrafeSens : Inventory {}