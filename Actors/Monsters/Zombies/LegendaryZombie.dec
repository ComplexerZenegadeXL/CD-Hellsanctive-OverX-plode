Actor LegendaryZombie 16500
{ 
  //$Category Monsters/LCA
  //$Sprite LPOSA1
  //$Title "Legendary Zombie"
  Health 999
  Radius 20
  Height 56
  Speed 10
  Mass 100
  PainChance 15
  Species "Zombie"
  PainChance "ZombieDemonTech", 0
  BloodColor "Blue"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryArmor" 85 1
  DropItem "LegendaryAmmoSphere" 88 1
  DropItem "LegendaryPowerShard" 35 1
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 235 2
  DropItem "Backpack" 198 1
  DropItem "Armorplate" 205 1
  DropItem "Portablemedkit" 210 1
  DropItem "LDemonAmmoBoxPickup" 200 
  DropItem "LDemonAmmoPickup" 250 
  //DropItem "LegendaryPlasmaticRifleGiver" 128
  DropItem "LegendaryRandomSphere" 16
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor 0.75
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Explosion", 0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  Monster
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  SeeSound "legzom/sight"
  AttackSound "Null"
  PainSound "legzom/pain"
  DeathSound "legzom/death"
  ActiveSound "legzom/active"
  Obituary "$CFLegendaryZombieObit"
  Tag "$CFLegZom"
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LPOS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LPOS AQ 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LPOS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,1)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LPOS A 0 A_JumpIfTargetInLOS("Strafing")
    LPOS AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	LPOS A 0 A_JumpIfTargetInLOS("Strafing")
	LPOS CCDD 3 Bright A_Chase
	LPOS A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LPOS A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    TNT1 A 0 //A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LPOS AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LPOS BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    LPOS CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LPOS DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Pause:
	LPOS E 0 A_PlaySound("weapons/demontechsteam")
	LPOS EEEEE 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See	
  Missile:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	LPOS EEE 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_CustomMissile("LegendaryProjectile",32,0,frandom(-2,2),0)
	LPOS F 3 Bright A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_SpidRefire
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	Goto Missile+5
  Pain:
    TNT1 A 0 A_Jump(10,"Protection")
	TNT1 A 0 A_Jump(192,"PainMissile")
    LPOS G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LPOS G 0 A_Pain
	LPOS G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto See
  PainMissile: 
    LPOS G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LPOS G 0 A_Pain
	LPOS G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto Missile	
  Protection:
    TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LPOS E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0,0,0,0)
	Goto See	
  Death:
	TNT1 A 0 A_CheckFlag("FRIENDLY","Death2")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1 || ACS_NamedExecuteWithResult("CheckSpawnScore") < 80, "Death2")
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckSpawnScore") < 80,"Death2")
	TNT1 A 0 A_Jump(96,"TrueLeg")
  Death2:
    TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    TNT1 A 0 A_StopSound(6)
	LPOS H 5 A_Scream
    LPOS I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LPOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LPOS K 5 
    LPOS L -1 
	Stop
  TrueLeg:
    TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_StopSound(6)
	LPOS H 5 A_Scream
    LPOS I 5 A_Fall
    LPOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LPOS K 5 
    LPOS L 140
	LPOS L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LPOS LLLLLLLLLLLLLLLLLLLLLLLLLLLL 4 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LPOS L 0 A_PlaySoundEx("TLegZomb/Resurrect",7,0)
	TLZO LKJGH 15 Bright
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryZombie",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop
  LegendarySoul:
    TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_StopSound(6)
	LPOS H 5 A_Scream
    LPOS I 5 A_Fall
    LPOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LPOS K 5 
    LPOS L 140 A_PlaySoundEx("brain/spit","Voice",0,2)
	LPOS LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LPOS L -1
	Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1 || ACS_NamedExecuteWithResult("CheckSpawnScore") < 80, "XDeath2")
    //TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckSpawnScore") < 80,"Death2")
	TNT1 A 0 A_Jump(96,"TrueLeg")
  XDeath2:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	LPOS O 3 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LPOS P 3 A_XScream
    LPOS R 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LPOS STUV 3 
    LPOS W -1 
    Stop
  }
}

Actor LegZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LPOS A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegendaryZombieGhostB : LegZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LPOS B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

