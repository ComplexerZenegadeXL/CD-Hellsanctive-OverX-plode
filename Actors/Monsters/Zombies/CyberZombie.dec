Actor CyberZombie
{
  Monster
  Health 425
  Height 59
  Radius 20
  Scale 1.15
  Speed 4
  Mass 400
  //ReactionTime 15
  BloodColor "Purple"
  PainChance "Mine", 128
  PainChance 30
  MissileType "BorgNail"
  +FLOORCLIP
  +NODROPOFF
  +MISSILEMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  -LOOKALLAROUND
  Species ""
  DamageFactor "Acid", 3.8
  DamageFactor 0.9
  //No Infighting
  DamageFactor "RST", 0.0
  DamageFactor "ZExplosiveBullets", 0.0
  DamageFactor "HTZombie", 0.0
  DamageFactor "ZombieCannon", 0.0
  DamageFactor "MiniRocket", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Cacolich", 0.0
  DropItem "ArmorCharge", 150, 2
  DropItem "PortableMedCell", 80, 1
  DropItem "HealthFlask", 120, 2
  DropItem "HandGrenadeAmmo", 150, 1
  DropItem "MineAmmoRandomizer", 120, 1
  DropItem "AmmoPack", 190, 2
  DropItem "FlareBox", 32
  SeeSound "Monsters/NBSight"
  ActiveSound "Monsters/NBAct"
  PainSound "Monsters/NBPain"
  DeathSound "Monsters/NBDeath"
  Obituary "$CFCyberZombieObit"
  Tag "$CFCyZom"
  States
  {
  Spawn:
	NLBG A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  SpawnLoop:
	NLBG A 10 A_Look //A_LookEx(0,0,1024,1024,180,"See")
	Loop
  Idle:
	NLBG A 10 A_Look
	Loop
  See:
	NLBG A 1 A_Chase
	NLBG AAAAA 1 A_Chase("","")
	NLBG B 1 A_Chase
	NLBG BBBBB 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("CyZomStep",0,0,5,0,0,-20)
	NLBG C 1 A_Chase
	NLBG CCCCC 1 A_Chase("","")
	NLBG D 1 A_Chase
	NLBG DDDDD 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("CyZomStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(62,"Run")
	Loop
  Run:
	NLBG B 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG B 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG B 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG B 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CyZomStep",0,0,5,0,0,-20)
	NLBG D 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG D 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG D 1 A_Chase("","")
	TNT1 A 0 A_Chase
	NLBG D 1 A_Chase("","")
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CyZomStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(26,"See")
	Loop
  Missile:
	NLBG E 6 A_FaceTarget(45)
  Refire:
	NLBG F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("BorgNail",30,10,frandom(-2,2))
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	NLBG E 6 A_FaceTarget
	NLBG FF 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("BorgNail",30,10,frandom(-2,2))
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	NLBG E 6 A_FaceTarget
	NLBG F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("BorgNail",30,10,frandom(-2,2))
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	NLBG E 6 A_FaceTarget
	NLBG F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/nailfire",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("BorgNail",30,10,frandom(-2,2))
	TNT1 A 0 A_Jump(72,"MissileEnd")
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	NLBG E 6 A_FaceTarget
	Loop
  MissileEnd:
	NLBG EEEEEEEEEEE 1 A_Chase("","Refire",CHF_NOPLAYACTIVE|CHF_DONTMOVE)
	Goto See
  Pain:
	NLBG G 2 A_Pain
	NLBG G 3
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	NLBG H 5 A_Scream
	NLBG I 5 A_Fall
	NLBG JKLM 4
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NLBG N -1
	Stop
  XDeath:
	NLBG O 5 A_XScream
	TNT1 A 0 A_Fall
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	TNT1 A 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	NLBG PQRSTUV 5
	NLBG W -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	NLBG MLKJIH 4
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	NLBG VUTSRQPO 4
	Goto See
  }
}

Actor SummonedCyberZombie : CyberZombie { -COUNTKILL }

Actor BorgNail
{
  Projectile
  Radius 3
  Height 3
  Speed 72
  Damage (Random(6,12)) //1
  Scale 0.3
  Decal "Bulletchip"
  +RIPPER
  +NOBOSSRIP
  +BLOODSPLATTER
  +DONTHARMSPECIES
  Species "EliteZombies"
  Damagetype "ZExplosiveBullets"
  SeeSound ""
  DeathSound ""
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("weapons/nailflight",6,1.0,1)
	Goto Fly
  Fly:
	CZNI A 1 A_CustomMissile("CFNailBlur",0,0,180)
	Loop
  Crash:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/nailhit",7,1.0,0)
	TNT1 A 0 A_SpawnItemEx("ModdedBulletPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	CZNI BCDEFG 2
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/nailhitbleed",7,1.0,0)
	CZNI BCDEFG 2
	Stop
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("weapons/nailhit",7,1.0,0)
	TNT1 A 0 A_SpawnItemEx("ModdedBulletPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	CZNI BCDEFG 2
	Stop
  }
}

Actor CFNailBlur
{
  Height 8
  Radius 1
  Scale 0.3
  Speed 0.2
  RenderStyle Translucent
  Alpha 0.5
  Damage (0)
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  +DROPOFF
  States
  {
  Spawn:
	CZNI A 1 A_FadeOut(0.1,1)
	Loop
  }
}