Actor EraserZombie 16552
{
  //$Category Monsters/LCA
  //$Sprite PYRZA1
  //$Title "Eraser Zombie"
  Obituary "$CFEraserZombieObit"
  Health 350
  Radius 20
  Height 56
  Mass 100
  Speed 8
  PainChance 170
  Species ""
  DamageFactor "SoapOpera", 0.0 
  DropItem "Armorplate" 215 1
  DropItem "Portablemedkit" 230 1
  DropItem "Backpack" 60 1
  DropItem "DemonTechBFG10KGiver" 58 1
  DropItem "HandGrenadeAmmo" 210 1
  DropItem "MineAmmoRandomizer" 210 1
  DropItem "DemonAmmoBoxPickup" 128
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Monster
  +FLOORCLIP
  +QUICKTORETALIATE
  Tag "$CFEraZom"
  States
  {
  Spawn:
    PYRZ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PYRZ AX 10 A_Look
	TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kidle")
    loop
  See:
    PYRZ AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
	PYRZ CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
	TNT1 A 0 A_PlayWeaponSound("weapons/dtech10kidle")
    loop
  Missile:
    TNT1 A 0 A_StopSound(6)
    PYRZ F 0  A_PlaySound ("Cardinal/9k")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	PYRZ EEEEE 4 Bright A_FaceTarget
    PYRZ FFFFF 4 Bright A_FaceTarget
	PYRZ F 2 Bright A_CustomMissile("ZombieDTBFG10KBall")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	PYRZ E 70
    Goto See
  Pain:
    PYRZ G 3
    PYRZ G 3 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    TNT1 A 0 A_StopSound(6)
    PYRZ H 5
	PYRZ I 5 A_Scream
    PYRZ J 5 A_NoBlocking
    PYRZ KLM 5
	PYRZ N 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    PYRZ N -1
    Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
    PYRZ O 5
    PYRZ O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PYRZ P 5 A_XScream
    PYRZ Q 5 A_NoBlocking
    PYRZ RS 5
    PYRZ T -1
    Stop
  }
}

Actor ZombieDTBFG10KBall : SentientDTBFG10KBall
{
  DamageType "SoapOpera"
  Obituary "$CFZombieDTBFG10KBallObit"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    CRS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 C 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    CRS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  DTBFGSFX:
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,-6),frandom(6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    CRS1 C 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CRS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("DTBFG10KTracerMind",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRedSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CRS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(Random(400,600),300)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItemEx("RedDTBFGEx",0,0,-10,0,0,0,0)
    Stop
  }
}
