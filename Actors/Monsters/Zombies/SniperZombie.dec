	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_TakeInventory("SpecOpsZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("SpecOpsZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,5,0,0)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-5,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1.5)
	Stop
