{
  States
  {
  Pickup:
	TNT1 A 0 A_CheckFloor(1)
	Stop
	TNT1 A 0 A_Jump(242,2)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	Stop
	TNT1 A 0
