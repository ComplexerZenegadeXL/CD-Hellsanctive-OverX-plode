Actor SniperRifleGuy 30325
{
  //$Category Monsters/CF
  //$Sprite ZSNPA1
  //$Title "Zombie with a sniper rifle"
  Monster
  Health 200
  WoundHealth	0
  Radius 20
  Height 56
  Mass 100
  Speed 8
  MaxDropOffHeight 24
  PainChance 170
  +FLOORCLIP
  +AVOIDMELEE
  +NODROPOFF
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  Species ""
  DropItem "ArmorPlate" 120
  DropItem "ArmorCharge", 60, 2
  DropItem "HealthFlask", 120, 2
  DropItem "ShieldSphere", 32, 1
  DropItem "BulletBoxPickup", 64, 1
  SeeSound "Shotguy/sight"
  PainSound "shotguy/pain"
  DeathSound "shotguy/death"
  ActiveSound "shotguy/active"
  Obituary "$CFSniperRifleGuy"
  Tag "$CFSniper"
  var int user_lowlag;
  States
  {
  Spawn:
	ZSNP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    ZSNP AB 10 A_Look
	TNT1 A 0 Healthing(1)
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ZSNP AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetTranslucent(1)
	//TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	ZSNP A 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP A 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP B 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP B 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	//TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	ZSNP C 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP C 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP D 3 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	ZSNP D 3 A_Chase
	TNT1 A 0 Healthing(1)
	Loop
  Strafing:
	//TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ZSNP AAA 1 A_GiveInventory("SpecOpsZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ZSNP BBB 1 A_GiveInventory("SpecOpsZombieStrafing",1)
	//TNT1 A 0 A_SpawnItemEx("FootStep2",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
       ZSNP CCC 1 A_GiveInventory("SpecOpsZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	ZSNP DDD 1 A_GiveInventory("SpecOpsZombieStrafing",1)
	Goto See
  Rush:
	TNT1 A 0 A_Jump(128,"Rush2")
  Rush1:
	ZSNP A 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush3")
  Rush2:
	ZSNP AAA 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush4")
  Rush3:
	ZSNP A 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush5")
  Rush4:
	ZSNP AAA 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush6")
  Rush5:
	ZSNP B 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush7")
  Rush6:
	ZSNP BBB 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush8")
  Rush7:
	ZSNP B 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush9")
  Rush8:
	ZSNP BBB 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush10")
  Rush9:
	ZSNP C 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush11")
  Rush10:
	ZSNP CCC 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush12")
  Rush11:
	ZSNP C 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush13")
  Rush12:
	ZSNP CCC 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush14")
  Rush13:
	ZSNP D 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush15")
  Rush14:
	ZSNP DDD 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush16")
  Rush15:
	ZSNP D 3 A_FastChase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(128,"Rush1")
  Rush16:
	ZSNP DDD 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",45,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_Jump(8,"See")
	Goto Rush
  Dodge:
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	TNT1 A 0 A_Jump(64,"See")
	Goto Missile
  DodgeSee:
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	TNT1 A 0 A_Jump(64,"Rush")
	Goto See
  Missile:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfTargetInLOS("SniperShot",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	ZSNP E 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("SniperGuy/Fire",CHAN_WEAPON,1.0,0)
	ZSNP F 10 A_CustomMissile("ZombieSniperProjectile",47,0,frandom(-2,2))
	ZSNP E 10 A_PlaySound("SniperGuy/Reload",CHAN_ITEM,1.0,0)
	Goto See
  SniperShot:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
	ZSNP E 10 A_FaceTarget
	ZSNP E 1 A_MonsterRefire(0,"DodgeSee")
	TNT1 A 0 A_Jump(96,2)
	ZSNP E 10 A_FaceTarget
	ZSNP E 1 A_MonsterRefire(0,"DodgeSee")
	TNT1 A 0 A_Jump(96,2)
	ZSNP E 10 A_FaceTarget
	ZSNP E 1 A_MonsterRefire(0,"DodgeSee")
	TNT1 A 0 A_Jump(96,2)
	ZSNP E 10 A_FaceTarget
	ZSNP E 1 A_MonsterRefire(0,"DodgeSee")
	TNT1 A 0 A_Jump(96,2)
	ZSNP E 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("SniperGuy/Fire",CHAN_WEAPON,1.0,0)
	ZSNP F 10 A_CustomMissile("ZombieSniperProjectileStrong",47,0)
	ZSNP E 10 A_PlaySound("SniperGuy/Reload",CHAN_ITEM,1.0,0)
	Goto See
  Wound:
	"####" "#" 3
	"####" "#" 3 A_Pain
	TNT1 A 0 A_JumpIfInventory("Tic",5,"See")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_ClassBossHealth
	TNT1 A 0 A_MonsterRefire(0,"Rush")
	Goto See
  IgnoreDamage:
	ZSNP A 1 A_UnSetShootable
	TNT1 AAAA 0 A_SpawnItemEx("AbyssalSatyrFlame",frandom(-20,20),frandom(-20,20),frandom(30,60),0,0,0)
	ZSNP AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TNT1 A 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 2 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAA 0 A_SpawnItemEx("AbyssalSatyrFlame",frandom(-20,20),frandom(-20,20),frandom(30,60),0,0,0)
	ZSNP AAAAAAAAAA 1 A_FadeIn(0.1)
	ZSNP A 1 A_SetShootable
	Goto PainMissile
  PainMissile: 
	ZSNP EE 3 A_GiveInventory("CFZombieStrafing",1)
	Goto Missile
  Pain:
	TNT1 A 0 A_Jump(48,"IgnoreDamage")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(96,"NoPainShield")
  PainShield:
	TNT1 A 0 A_GiveInventory("ZombieShieldSphere",1)
  NoPainShield:
	ZSNP G 3
	ZSNP G 3 A_Pain
	Goto Dodge
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	ZSNP H 9
	ZSNP I 9 A_Scream
	ZSNP J 9
	ZSNP K 9 A_NoBlocking
	TNT1 A 0 A_TakeInventory("Tic",999999)
	ZSNP L -1
	Stop
  XDeath:
	ZSNP O 5
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	ZSNP P 5 A_XScream
	ZSNP Q 5 A_NoBlocking
	TNT1 A 0 A_TakeInventory("Tic",999999)
	POSS PQRST 5
	POSS U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	ZSNP KJIH 5
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	POSS TSRQP 5
	ZSNP QPO 5
	Goto See
  }
}

Actor ZombieSniperProjectile : FastProjectile
{
  Projectile
  Height 5
  Radius 2
  Speed 300
  Scale 0.375
  Decal "Bulletchip"
  Missiletype "ZombieSniperTrailSpawner"
  Damage (Random(30,45))
  +NOEXTREMEDEATH
  +BLOODSPLATTER
  +THRUSPECIES
  Species "EliteZombies"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("SniperGuy/BulletLoop",CHAN_BODY,1.0,1)
	PROJ A 1
	Goto Spawn+2
  Death:
  Crash:
	TNT1 AAA 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_PlaySound("SniperGuy/WallHit",CHAN_BODY)
	PUFF ABCD 4
	Stop
  XDeath:
	TNT1 AAA 0 A_StopSound(CHAN_BODY)
	TNT1 A 1 A_PlaySound("SniperGuy/FleshHit",CHAN_BODY)
	TNT1 A 1 A_GiveToTarget("Health",20)
	Stop
  }
}

Actor ZombieSniperProjectileStrong : ZombieSniperProjectile
{
  Damage (Random(45,60))
  +PIERCEARMOR
}

Actor ZombieSniperTrailSpawner : FastProjectile
{
 Speed 150
 +MISSILE
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
  Death:
	TNT1 A 1 A_SpawnItemEx("ZombieSniperTrail",-(velx*1.05),-(vely*1.05),(velz*-1.05),(velx*0.95),(vely*0.95),(velz*0.95),-Angle,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEVELOCITY|SXF_ABSOLUTEPOSITION)
	Stop
  }
}

Actor ZombieSniperTrail
{
  RenderStyle Translucent
  Alpha 0.5
  Scale 0.5
  +MISSILE
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	PUFF CD 4
	Stop
  }
}

Actor SpecOpsZombieStrafing : CustomInventory
{
  -COUNTITEM
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("SpecOpsZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("SpecOpsZombieStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("SpecOpsZombieStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("SpecOpsZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("SpecOpsZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,3,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-3,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-1)
	Stop
	TNT1 A 0 A_Recoil(1)
	Stop	
  }
}

Actor SpecOpsZombieJumping : SpecOpsZombieStrafing
{
  States
  {
  Pickup:
	TNT1 A 0 A_CheckFloor(1)
	Stop
	TNT1 A 0 A_Jump(242,2)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	Stop
	TNT1 A 0
	Stop
  }
}

Actor SpecOpsZombieStrafeSens : Inventory {}

