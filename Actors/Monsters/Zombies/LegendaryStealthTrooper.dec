Actor ExplosionFlames: FlameTrails
{
  Scale 1.2
  Speed 2
  States
  {
  Spawn:
    TXPB AA 3 Bright
	TXPB AAA 0 A_CustomMissile ("ExplosionSmoke", 0, 0, frandom(0, 360), CMF_AIMDIRECTION, frandom(0, 360))
    TXPB GHII 3 Bright
    Stop
  }
}

Actor SmallExplosionFlames: ExplosionFlames
{
  Scale 0.6
  Speed 3
  States
  {
  Spawn:
	TXPB AA 2 Bright 
	TXPB BCDFGHII 1 Bright
	Stop
  }
}

Actor SpawnedExplosionSmall
{
  +NOCLIP
  +NOGRAVITY
  Speed 30
  States
  {
  Spawn:
	TNT1 A 4
	FXPO A 0 A_CustomMissile ("SmokeFXN", 0, 0, frandom(0, 360), CMF_AIMDIRECTION, frandom(0, 360))
	FXPO A 0 A_CustomMissile ("SmokeFXN", 0, 0, frandom(0, 360), CMF_AIMDIRECTION, frandom(0, 360))
	TNT1 AAAA 0 A_CustomMissile ("SmallExplosionFlames", 0, 0, frandom(0, 360), CMF_AIMDIRECTION, frandom(0, 360))
	Stop
  }
}

