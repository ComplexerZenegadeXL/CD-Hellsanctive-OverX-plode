Actor LegendaryStealthTrooper 16502 
{ 
  //$Category Monsters/LCA
  //$Sprite LCMDA1
  //$Title "Legendary Stealth Trooper"
  Health 1100
  Radius 20
  Height 56
  Speed 10
  Mass 100
  PainChance 25
  Species "Zombie"
  PainChance "ZombieDemonTech", 0
  BloodColor "Blue"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryArmor" 87 1
  DropItem "LegendaryAmmoSphere" 90 1
  DropItem "HandGrenadeAmmo" 237 2
  DropItem "MineAmmoRandomizer" 237 2
  DropItem "Backpack" 200 1
  DropItem "Armorplate" 207 1
  DropItem "Portablemedkit" 212
  DropItem "ProxLauncherGiver" 64
  DropItem "ProxMines" 196
  DropItem "LegendaryBulletBoxPickup" 202 
  DropItem "LegendaryLMGBulletMagPickup" 252 20
  //DropItem "LegendaryLightMachineGunGiver" 202
  DropItem "LegendaryPowerShard" 65
  DropItem "LegendaryRandomSphere" 16
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Explosion", 0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  Monster 
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  SeeSound "lcmdo/sight"
  AttackSound "Null"
  PainSound "lcmdo/pain"
  DeathSound "lcmdo/death"
  ActiveSound "lcmdo/active"
  Obituary "$CFLegendaryStealthTrooperObit"
  Tag "$CFLegTroop"
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {  
  Spawn:
    LCMD A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    LCMD AZ 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LCMD AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,19)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LCMD A 0 A_JumpIfTargetInLOS("Strafing")
    LCMD AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	LCMD A 0 A_JumpIfTargetInLOS("Strafing")
	LCMD CCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(80,"Phase")		
	LCMD A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(25,"Teleport")
    Loop
  Rush:
    LCMD A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD B 1 Bright A_Chase
	TNT1 A 0 A_Jump(80,"Phase")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegCommandoGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCMD D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LCMD AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LCMD BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    LCMD CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LCMD DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Phase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LCMD E 2 A_FaceTarget
	LCMD EEEE 1 A_FadeTo(0.15,0.25,0)
	//LCMD E 1 A_FadeTo(0.15,0.10,1)
	Goto Phased
  UnPhase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	//LCMD E 1 A_FadeTo(0.10,0)
	LCMD EEEE 1 A_FadeTo(1.0,0.25,0)
	LCMD E 2 A_FaceTarget		
    Goto See	
  Phased:
	LCMD AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
	LCMD AABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase")
	Goto Phased+32
  Teleport:
	LCMD A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LCMD AAAAAAAAAA 1 A_FadeTo(0.0,0.1,0)
	LCMD A 2 
	LCMD AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LCMD A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LCMD AAAAAAAAAA 1 A_FadeTo(1.0,0.1,0)
    LCMD A 1 Bright A_SetShootable
    Goto See	
  Pause:
	//LCMD E 0 A_PlaySound("weapons/demontechsteam")
	LCMD EEEEE 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See	
   Missile:
	LCMD E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpIfInventory("LegAK47Ammo",76,"Reload")
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_GiveInventory("LegAK47Ammo",1)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomBulletAttack(12.5,10,1,Random(10,20)*5,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySound("weapons/LMGFire",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)	
	LCMD E 6 Bright A_CPosAttack
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_GiveInventory("LegAK47Ammo",1)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomBulletAttack(12.5,10,1,Random(10,20)*5,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySound("weapons/LMGFire",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)	
	LCMD F 6 Bright A_CPosAttack
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_Jump(20,"Pause")
	TNT1 A 0 A_Jump(45,"LegNade")
	Goto Missile+1
  Nade:
    LCMD E 1 A_JumpIfCloser(1000,1)
	Goto Missile
	LCMD E 0 A_JumpIfCloser(280,"Missile")
    LCMD E 6 A_GiveInventory("LegZombieStrafing",1)
    LCMD EEE 4 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    LCMD E 6 A_CustomMissile("LGrenade",32,0,0,2,10)
	LCMD E 1
	Goto See
  LegNade:
    LCMD E 1 A_JumpIfCloser(1000,1)
	Goto Missile
	LCMD E 0 A_JumpIfCloser(280,"Missile")
    LCMD E 12 A_GiveInventory("LegZombieStrafing",1)
    LCMD EEE 6 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    LCMD E 6 A_CustomMissile("LegThrownGrenade",32,0,0,2,10)
	LCMD EE 25
	Goto See
  Mine:
	LCMD C 1 Bright
	LCMD C 12 Bright A_CustomMissile("LACThrownMine",32,0,0,5,15)
	LCMD C 0 Bright A_CustomMissile("LACThrownMine",32,0,0,-5,15)
	LCMD C 0 Bright A_CustomMissile("LACThrownMine",32,0,0,0,15)
	LCMD E 12 Bright
	LCMD C 3 Bright
	Goto See
  Pain:
   	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(15,"Protection")
	TNT1 A 0 A_Jump(90,"Phase")
    LCMD G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LCMD G 0 A_Pain
	LCMD G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto See
  Protection:
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LCMD E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0,0,0,0)
	Goto See	
  Reload:
    TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("weapons/LMGReload2")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    LCMD EE 25 Bright A_TakeInventory ("LegAK47Ammo", 76)
    LCMD E 20 Bright A_PlaySound("weapons/LMGReload1") 
	LCMD E 40 Bright A_PlaySound("weapons/LMGReload3")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  Death:
    TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul") 
    TNT1 A 0 A_StopSound(6)
	LCMD H 5 A_Scream
    LCMD I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,24)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LCMD J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LCMD K 5 
    LCMD L -1 
	Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LCMD H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    LCMD I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    LCMD J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    LCMD K 5 
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LCMD L 140
	LCMD L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LCMD LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LCMD L -1
	Stop
  XDeath:
    TNT1 A 0 A_StopSound(6)
	LCMD O 3 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LCMD P 3 A_XScream
    LCMD R 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,24)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LCMD STUV 3
    LCMD W -1 
    Stop
  }
}

Actor LegCommandoGhostA 
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States 
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	TNT1 A 1
	LCMD A 2 A_FadeOut(0.10)
	Goto Fade+1
  Vanilla:
	TNT1 A 0
	Stop
  }
}

