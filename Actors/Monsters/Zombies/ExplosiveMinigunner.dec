Actor ExplosiveMinigunner : ChaingunGuy 16556
{
  //$Category Monsters/LCA
  //$Sprite EXP2A1
  //$Title "Explosive Minigunner"
  Health 150
  PainChance 110
  Speed 7
  Mass 100
  DropItem "StimKit" 180
  DropItem "ArmorBooster" 180
  DropItem "AmmoPack" 165
  DropItem "HandGrenadeAmmo" 250 1
  DropItem "MineAmmoRandomizer" 180 1
  DropItem "BulletMagPickup" 196 10
  DropItem "BulletBoxPickup" 128
  DropItem "Armorplate" 215 1
  DropItem "Portablemedkit" 230 1
  DropItem "Backpack" 80 1
  DropItem "ExplosiveMinigunGiver" 65
  DamageFactor "EMGEx", 0.0
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  AttackSound "weapons/minigunfire"
  Obituary "$CFExplosiveMinigunnerObit"
  +MISSILEMORE
  +QUICKTORETALIATE
  Tag "$CFExpChain"
  States
  {
  Spawn:
    EXP2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	EXP2 A 10 A_Look
	EXPI A 10 A_Look
    Loop
  See:
    EXP2 AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    EXP2 CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Missile:
    TNT1 A 0 A_PlaySound("weapons/expmgunspinstart")
    EXP2 E 25 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("weapons/expmgunspin","Voice")
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-15,15),0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 12, 6, 28, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    EXP2 E 4 Bright A_CPosAttack
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(30,34),0,frandom(-15,15),0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 12, 6, 30, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    EXP2 F 4 Bright A_CPosAttack
	TNT1 A 0 A_PlaySound("weapons/expmgunspinstop")
	TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_CPosRefire
    Goto Missile+2
  Pain:
    EXP2 G 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    EXP2 H 5 A_StopSoundEx("Voice")
    EXP2 I 5 A_Scream 
    EXP2 J 5 A_Fall
    EXP2 K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    EXP2 LM 5
    EXP2 N -1
    Stop
  XDeath:
    EXP2 O 3 A_XScream
    EXP2 P 3 A_GiveInventory("XDeathCheck",1)
    EXP2 Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    EXP2 R 3 A_Fall 
    EXP2 STUV 3
	EXP2 W -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    EXP2 NMLKJIH 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	EXP2 WVUTSRQPO 5
	Goto See
  }
}

Actor MinigunnerExplosiveTracer : BabySentientExplosiveTracer
{
  DamageType "EMGEx"
  States
  {
  Spawn:
    TRAC A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("SentientExplosiveEffect",0,0,0,0,0,0,0)
    MISL B 4 Bright A_Explode(Random(3,6)*5,72)
    MISL CD 3 Bright
    Stop
  }
}