Actor DemonicZombie 16557
{ 
  //$Category Monsters/LCA
  //$Sprite DZMIA1
  //$Title "Demonic Zombie"
  Health 200
  Radius 20
  Height 56
  Speed 8
  Mass 400
  Scale 1.075
  PainChance 100
  Species ""
  PainChance "ZombieCannon", 0
  DropItem "PortableMedkit" 200
  DropItem "ArmorPlate" 200
  DropItem "HandGrenadeAmmo" 225 1
  DropItem "MineAmmoRandomizer" 125 1
  DropItem "AmmoPack" 125
  DropItem "DemonAmmoPickup" 250 60
  DropItem "DemonAmmoBoxPickup" 105
  DropItem "BehemothCannonGiver" 72
  DropItem "RedArmor" 1
  DamageFactor "ZombieCannon", 0.0
  Monster 
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFDemonicZombieObit"
  Tag "$CFDemZom"
  States
  {
  Spawn:
    DZMM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DZMM A 10 A_Look
	DZMI A 10 A_Look
    Loop
  See:
    DZMM AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    DZMM CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Missile:
    TNT1 A 0 A_Jump(128,"Missile2")
	TNT1 A 0 A_Jump(64,"Missile3")
	Goto See
  Missile2:
    DZMM E 15 A_FaceTarget
	DZMM F 0 A_CustomMissile("ZombieComet", 32, 0, -2)
	DZMM F 0 A_CustomMissile("ZombieComet", 32, 0, 2)
    DZMM F 15 Bright A_CustomMissile("ZombieComet", 32, 0, 0)
	DZMM E 12 A_FaceTarget
	DZMM F 0 A_CustomMissile("ZombieComet", 32, 0, -2)
	DZMM F 0 A_CustomMissile("ZombieComet", 32, 0, 2)
    DZMM F 15 Bright A_CustomMissile("ZombieComet", 32, 0, 0)
	DZMM E 20
	TNT1 A 0 A_Jump(64,"Missile3")
	Goto See
  Missile3:
    DZMM E 15 A_FaceTarget
	DZMM F 0 A_CustomMissile("ZombieSeekingComet", 32, 0, -10)
	DZMM F 15 Bright A_CustomMissile("ZombieSeekingComet", 32, 0, 10)
	DZMM E 20 
	Goto See
  Pain:
    DZMM G 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    DZMM H 5 A_Scream
    DZMM I 5 A_Fall
    DZMM J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    DZMM KLM 5
    DZMM N -1
    Stop
  XDeath:
    DZMM O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	DZMM P 3 A_XScream
    DZMM Q 3 A_Fall
    DZMM RSTUV 3
    DZMM W -1 
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    DZMM NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	DZMM WVUTSRQPO 4
	Goto See
  }
}

Actor ZombieComet : BehemothComet { DamageType "ZombieCannon" }

Actor ZombieSeekingComet : Comet
{
  Scale 0.55
  DamageType "ZombieCannon"
  RenderStyle Add
  Alpha 0.85
  //Species "Player"
  Decal "Scorch"
  +THRUSPECIES
  +SEEKERMISSILE
  +SCREENSEEKER
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
	BHTB AAAAA 1 Bright A_SpawnItemEx("BehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,15,SMF_LOOK)
	BHTB BBBBB 1 Bright A_SpawnItemEx("BehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}