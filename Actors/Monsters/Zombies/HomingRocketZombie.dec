Actor HomingRocketZombie
{
  Health 120
  Radius 20
  Height 56
  Mass 100
  Speed 8
  PainChance 90
  Species ""
  Monster
  +FLOORCLIP
  +MISSILEMORE
  SeeSound "grunt/sight"
  PainSound "grunt/pain"
  Deathsound "grunt/death"
  ActiveSound "grunt/active"
  PainChance "ZombieRocket", 0
  DropItem "PortableMedkit" 120
  DropItem "ArmorPlate" 120
  DropItem "AmmoPack" 80
  DropItem "MissileBoxPickup" 256 5
  DropItem "HandGrenadeAmmo" 200 1
  DropItem "MineAmmoRandomizer" 100 1
  DamageFactor "ZombieRocket", 0.25
  Obituary "$CFHomingRocketZombieObit"
  Tag "$CFHrlZom"
  States
  {
  Spawn:
    MMGY A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	MMGY A 10 A_Look
	MMGI A 10 A_Look
    Loop
  See:
	MMGY AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    MMGY CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop
  Missile:
    MMGY E 14 A_FaceTarget
    MMGY F 6 Bright A_CustomMissile("ZombieHomingRocket", 50, 0, 0)
	MMGY E 20 A_PlaySound("rocket/drumspin")
    Goto See
  Pain:
	MMGY H 2
	MMGY H 2 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	MMGY I 4
	MMGY J 4 A_Scream
	MMGY K 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MMGY L 4 A_Fall
	MMGY L -1
	Stop
   XDeath:
	MMGY M 5 A_XScream
	MMGY O 5 A_GiveInventory("XDeathCheck",1)
	MMGY P 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MMGY Q 5 A_Fall
	MMGY RST 5
	MMGY U -1
	Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	MMGY LLKJI 5
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	MMGY UTRSQPOM 5
	Goto See
  }
}

Actor ZombieHomingRocket : HellFireRocket { Damage 15 DamageType "ZombieRocket" -THRUSPECIES }