Actor VexedNemesisZombie : NemesisZombie 28009
{ 
  Health 2000
  Speed 30
  DamageFactor 0.5
  DamageFactor "Explosion", 0.01
  DamageFactor "PlayerDTRG", 0.01
  DamageFactor "DTRailgun", 0.01
  DamageFactor "PDTPuff", 0.01
  DamageFactor "RailG", 0.01
  DamageFactor "PyroShot", 0.01
  DamageFactor "PlayerPyro", 0.01
  DamageFactor "PlayerBHole", 0.025
  DamageFactor "PlayerDBFG", 0.015
  DamageFactor "PlayerDBFG2", 0.015
  PainChance "Explosion", 128
  PainChance "PlayerDTRG", 128
  PainChance "DTRailgun", 128
  PainChance "PDTPuff", 128
  PainChance "RailG", 128
  SeeSound "VexedNemesisZombie/Sight"
  PainSound "VexedNemesisZombie/Pain"
  DeathSound "VexedNemesisZombie/Death"
  ActiveSound "VexedNemesisZombie/Active"
  Obituary "$CFVexedNemesisZombieObit"
  Tag "$CFVexZom"
  var int user_missile;
  States
  {
  Spawn:
	VNZO A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,5)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	VNZO A 10 Bright A_Look
	VNZI A 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,712)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	VNZO AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	VNZO CCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(20,"Teleport")
	TNT1 A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  Rush:
	TNT1 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("VexedNemesisZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VNZO D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Teleport:
	VNZO A 1 Bright A_UnSetShootable
	VNZO AAAAAAAAAA 1 Bright A_FadeOut(0.1,0)
	VNZO A 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	VNZO A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	VNZO AAAAAAAAAA 1 Bright A_FadeIn(0.1)
	VNZO A 1 Bright A_SetShootable
	Goto See  
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	VNZO AA 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	VNZO BB 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	VNZO CC 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)  
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	VNZO DD 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	Goto See
  Pause:
	TNT1 A 0 A_PlaySound("weapons/demontechsteam")
	VNZO EEEEE 3 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	Goto See  
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_Jump(20,"Rage")
	TNT1 A 0 A_SetTranslucent(1)
	VNZO EEE 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
  MissileLoop:
	VNZO E 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 AA 0 A_CustomMissile("NemesisRifleShotEnemy",32,0,frandom(-4,4),0)
	VNZO F 2 Bright A_PlaySoundEx("NemesisRifle/Fire","Weapon")
	TNT1 A 0 A_Jump(10,"MidAttackTeleport")
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_SpidRefire
	Loop
  MidAttackTeleport:
	VNZO E 1 Bright A_UnSetShootable
	VNZO E 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeOut(0.1,0)
	VNZO E 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	VNZO E 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	VNZO EEEEEEEEEE 1 Bright A_FadeIn(0.1)
	VNZO EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeIn(0.1)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO E 1 Bright A_FadeIn(0.1)
	VNZO E 1 Bright A_SetShootable
	Goto MissileLoop
  Rage:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_PlaySound("VexedNemesisZombie/Sight",7,1.0,0,ATTN_NONE)
	VNZO EEEEEEEE 2 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  RageLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 50,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	VNZO E 1 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 AA 0 A_CustomMissile("NemesisRifleShotEnemy",32,0,frandom(-4,4),0)
	VNZO F 1 Bright A_PlaySoundEx("NemesisRifle/Fire","Weapon")
	TNT1 A 0 A_Jump(30,"MidRageTeleport")
	Loop
  MidRageTeleport:
	VNZO E 1 Bright A_UnSetShootable
	VNZO E 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO EEE 1 Bright A_FadeOut(0.3,0)
	VNZO E 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	VNZO E 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	VNZO EEE 1 Bright A_FadeIn(0.3)
	TNT1 A 0 A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	VNZO E 1 Bright A_FadeIn(0.1)
	VNZO E 1 Bright A_SetShootable
	Goto RageLoop
  Pain:
	TNT1 A 0 A_Jump(30,"Teleport")
  Pain2:
	TNT1 A 0 A_Jump(192,"PainMissile")
	VNZO G 3 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_Pain
	VNZO G 3 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	Goto See
  PainMissile: 
	VNZO G 3 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	TNT1 A 0 A_Pain
	VNZO G 3 Bright A_GiveInventory("VexedNemesisLegZombieStrafing",1)
	Goto Missile  
  Pain.RailG:
  Pain.PDTPuff:
  Pain.DTRailgun:
  Pain.PlayerDTRG:
  Pain.Explosion:
	Goto Rage
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
    TNT1 A 0 A_Jump(36,"LegendarySoul")
	VNZO H 5 A_Scream
	VNZO I 5 A_Fall
	VNZO J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	VNZO K 5 
	VNZO L 100
	TNT1 A 0 A_JumpIfInTargetInventory("NemesisFragmentToken",1,3)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",6) == 0,2)
	TNT1 A 0 A_SpawnItemEx("NemesisFragmentSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,192)
	TNT1 A 0 A_Jump(100,"MoreStuff")
	VNZO L -1
	Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VNZO H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    VNZO I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    VNZO J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    VNZO K 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    VNZO L 5 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VNZO L 140 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VNZO L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	VNZO LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	VNZO L -1
	Stop	
  XDeath:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
    TNT1 A 0 A_Jump(36,"LegendarySoul")
	VNZO O 3 A_SpawnItemEx("NemesisGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VNZO P 3 A_XScream
	VNZO R 3 A_Fall
	VNZO STUV 3
	VNZO W 100
	TNT1 A 0 A_JumpIfInTargetInventory("NemesisFragmentToken",1,3)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",6) == 0,2)
	TNT1 A 0 A_SpawnItemEx("NemesisFragmentSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,192)
	TNT1 A 0 A_Jump(100,"MoreStuff2")
	VNZO W -1
	Stop
  MoreStuff:
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VNZO LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO L 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	VNZO L -1
	Stop
  MoreStuff2:
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VNZO WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO W 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	VNZO W -1
	Stop
  }
}

Actor SummonedVexedNemesisZombie : VexedNemesisZombie
{
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "EnragedLegendaryArmor", 85
  DropItem "LegendaryAmmoSphere", 88
  DropItem "EnragedLegendaryPowerShard", 35
  DropItem "HandGrenadeAmmo", 235, 2
  DropItem "MineAmmoRandomizer", 235, 2
  DropItem "Backpack", 198
  DropItem "Armorplate", 205
  DropItem "Portablemedkit", 210
  DropItem "NLDemonAmmoBoxPickup", 100
  DropItem "NLDemonAmmoPickup", 125 
  -COUNTKILL
  States
  {
  MoreStuff:
	VNZO L 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VNZO LLLLLLLLLLLLLLLLLLLL 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO LLLLLLLLLLLLLLLLLLLL 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO L 1
	VNZO L -1
	Stop
  MoreStuff2:
	VNZO W 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VNZO WWWWWWWWWWWWWWWWWWWW 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO WWWWWWWWWWWWWWWWWWWW 1 A_SpawnItem("NemesisHKItemRandomizer")
	VNZO W 1
	VNZO W -1
	Stop
  }
}

Actor VexedNemesisZombieGhostA
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTIMEFREEZE
  Scale 1.1
  Renderstyle Translucent
  Alpha 0.7
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Null")
	VNZO A 2 A_FadeOut(0.1,1)
	Loop
	}
}

Actor VexedNemesisZombieGhostB : VexedNemesisZombieGhostA
{
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Null")
	VNZO B 2 A_FadeOut(0.1,1)
	Loop
	}
}

