Actor VexedNemesisLegZombieStrafing : NemesisLegZombieStrafing
{
States
  {
  Pickup:
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_GiveInventory("LegZombieJumping",1)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)  
	TNT1 A 0 A_TakeInventory("LegZombieStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegZombieStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,6,0,0)
	TNT1 A 0 A_Jump(256,2)  
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-6,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_JumpIfCloser(300,2)
	TNT1 A 0 A_Recoil(-2)
	Stop
	TNT1 A 0 A_Recoil(2)
	Stop  
  }
}

Actor VexedNemesisFlameSpawner : LSoulFlameSpawner
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("vile/firecrkl")
	TNT1 A 0 A_Explode(3,128)
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("NemesisSoulFlame",frandom(-20,20),frandom(-20,20),frandom(0,60),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop	
  }
}