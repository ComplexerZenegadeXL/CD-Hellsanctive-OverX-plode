Actor NemesisImpNoVexed : NemesisImp 28021
{
  States
  {
  Death:
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Death2")
  DeathContinue:
	NSIN I 8
	NSIN J 8 A_Scream
	NSIN K 6
	NSIN L 6 A_NoBlocking
	NSIN M 1
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NSIN N -1
	Stop
  Death2:
	TNT1 A 0
	Goto Death2Continue
  Death2Continue:
	NSI2 I 8 A_SetTranslucent(1)
	NSI2 J 8 A_Scream
	NSI2 K 6
	NSI2 L 6 A_Fall
	TNT1 A 0 A_Jump(100,"MoreStuff2")
	NSI2 M -1
	Stop
  }
}

Actor SummonedNemesisImpNoVexed : NemesisImpNoVexed { -COUNTKILL }

