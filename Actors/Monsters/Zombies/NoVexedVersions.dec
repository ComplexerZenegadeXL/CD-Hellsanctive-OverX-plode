Actor NemesisZombieNoVexed : NemesisZombie 28019
{ 
  States
  {
  Death:
	TNT1 A 0 A_StopSound(6)
    TNT1 A 0 A_Jump(36,"LegendarySoul")
	NSZO H 5 A_Scream
	NSZO I 5 A_Fall
	NSZO J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NSZO K 5 
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NSZO L -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
	NSZO O 3 A_SpawnItemEx("NemesisGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NSZO P 3 A_XScream
	NSZO R 3 A_Fall
	NSZO STUV 3 
	TNT1 A 0 A_Jump(100,"MoreStuff2")
	NSZO W -1
	Stop
  }
}

Actor SummonedNemesisZombieNoVexed : NemesisZombieNoVexed { -COUNTKILL }

