Actor InsaneChaingunner
{
  Health 350
  Radius 20
  Height 56
  Speed 8
  PainChance 100
  Species ""
  Monster
  +FLOORCLIP
  +AVOIDMELEE
  +MISSILEEVENMORE
  +MISSILEMORE
  +QUICKTORETALIATE
  DamageFactor "Normal", 0.65
  DropItem "HandGrenadeAmmo" 80 2
  DropItem "MineAmmoRandomizer" 45 1
  DropItem "AmmoPack" 128
  DropItem "AmmoPack" 64
  DropItem "AmmoPack" 32
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  DropItem "ExplosiveMinigunGiver" 40
  DropItem "FlareBox", 32
  Attacksound "Sentient/Fire"
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFInsaneChaingunnerObit"
  Tag "$CFInsChain"
  States
  {
  Spawn:
    IGOS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	IGOS AA 10 A_Look
    Loop
  See:
    IGOS AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    IGOS CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    Loop
  Missile:
    IGOS E 10 A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",37,-13,frandom(-6,6),CMF_OFFSETPITCH,frandom(-0.8,0.8))
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",37,13,frandom(-6,6),CMF_OFFSETPITCH,frandom(-0.8,0.8))
	TNT1 A 0 A_SpawnItemEx("RifleCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",12,6,36,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
    IGOS E 4 Bright
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",37,-13,frandom(-6,6),CMF_OFFSETPITCH,frandom(-0.8,0.8))
	TNT1 A 0 A_CustomMissile("MinigunnerExplosiveTracer",37,13,frandom(-6,6),CMF_OFFSETPITCH,frandom(-0.8,0.8))
	TNT1 A 0 A_SpawnItemEx("RifleCasing",12,-6,36,frandom(2,6),0,frandom(1,3),frandom(-80,-90),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",12,6,36,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
    IGOS F 4 Bright
    TNT1 A 0 A_CPosRefire
    Goto Missile+1
 Pain:
	IGOS G 6 A_Pain
	TNT1 A 0 A_jump(80,"Missile")
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	//TNT1 A 0 A_SpawnItemEx("Smallcratesforsmallmonsters",0,0,12,Frandom(4,-4),Frandom(4,-4),Frandom(1,2),0,SXF_NOCHECKPOSITION,236)
    IGOS H 5 A_Scream
    IGOS I 5 A_Fall
    IGOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IGOS KLM 5
    IGOS N -1
    Stop
  XDeath:
	IGOS O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    IGOS P 3 A_XScream
    IGOS Q 3
    IGOS R 3 A_Fall
    IGOS ST 3
    IGOS T -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    IGOS MLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	IGOS TSRQPO 5
	Goto See  
  }
}