Actor LegendarySuperShotgunZombie 18502
{ 
  //$Category Monsters/LCA/DJB
  //$Sprite LES2A1
  //$Title "Legendary SuperShotgun Zombie"
  Health 1050
  Radius 20
  Height 56
  Speed 12
  Mass 100
  PainChance 20
  Species "Zombie"
  BloodColor "Blue"
  //DropItem "LegendaryCoachgunGiver" 200
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 128
  DropItem "LegendaryArmor" 90
  DropItem "LegendaryAmmoSphere" 93
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "Backpack" 200
  DropItem "Armorplate" 210
  DropItem "Portablemedkit" 215
  DropItem "StimKit" 220
  DropItem "HealthFlask" 225
  DropItem "LegendaryPowerShard" 35
  DropItem "LegendaryPowerSphere" 35
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Explosion", 0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  Tag "$CFLegSSGSguy"
  Monster 
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOTELEFRAG
  SeeSound "Legssgzomb/sight"
  PainSound "Legssgzomb/pain"
  DeathSound "Legssgzomb/death"
  ActiveSound "Legssgzomb/active"
  Obituary "$CFLegendarySuperShotgunZombieObit"
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LES2 A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LES2 A 10 Bright A_Look
	LESI A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,26)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LES2 AABBCCDD 3 Bright A_Chase
    Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,26)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LES2 A 0 A_JumpIfTargetInLOS("Strafing")
    LES2 AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	LES2 A 0 A_JumpIfTargetInLOS("Strafing")
	LES2 CCDD 3 Bright A_Chase
	LES2 A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    Loop
  Rush:
    LES2 A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendarySSGGuyGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LES2 D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LES2 AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LES2 BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItem("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    LES2 CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LES2 DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Missile:        
    TNT1 A 0 A_Jump(45,"LegNade")
	TNT1 A 0 A_JumpIfCloser(275,"Double")
  Normal:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	LES2 EE 1 Bright A_FaceTarget
	LES2 E 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/LegSGsingle")
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	LES2 F 3 Bright A_CustomBulletAttack(16.8,14.7,4,Random(30,40),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LES2 EE 3 Bright A_GiveInventory("LegZombieStrafing",1)
	LES2 E 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_PlaySound("Weapons/LegSGsingle")
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	LES2 F 3 Bright A_CustomBulletAttack(22.5,0,3,Random(30,40),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LES2 EE 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto Reload
  Double:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	LES2 EE 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/LegSGboth")
	TNT1 AAAAAAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	LES2 F 4 Bright A_CustomBulletAttack(19.5,15.3,14,Random(30,35),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LES2 EEE 2 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto Reload
  Reload:
	LES2 E 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LES2 E 6 Bright A_PlaySound("wWeapons/LegSGopen")
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing", -8, 6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	LES2 E 1 Bright A_SpawnItemEx("BlueShellCasing", -10, 6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	LES2 E 6 Bright A_PlaySound("Weapons/LegSGin")
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LES2 E 6 Bright A_PlaySound("Weapons/LegSGclose")
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	LES2 E 6 Bright A_CPosRefire
	Goto See
  LegNade:
	LES2 E 0 Bright A_JumpIfCloser(280,"Missile")
    LES2 E 12 Bright A_GiveInventory("LegZombieStrafing",1)
    LES2 EEE 6 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 Bright A_GiveInventory("LegZombieStrafing",1)
    LES2 E 6 Bright A_CustomMissile("LSSGGrenade",32,0,0,2,10)
	LES2 EE 25 Bright
	Goto See
  Pain:
    TNT1 A 0 A_Jump(10,"Protection")
	TNT1 A 0 A_Jump(192,"PainMissile")
    LES2 G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LES2 G 0 A_Pain
	LES2 G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto See
  PainMissile: 
    LES2 G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LES2 G 0 Bright A_Pain
	LES2 G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto Missile
  Protection:
    TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LES2 E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0,0,0,0)
	Goto See
  Death:
    TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    TNT1 A 0 A_StopSound(6)
	LES2 H 5 A_Scream
    LES2 I 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
    LES2 J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LES2 K 5 
    LES2 L -1 
	Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LES2 H 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LES2 I 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LES2 J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LES2 K 5 
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LES2 L 140
	LES2 L 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LES2 LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LES2 L -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
    LASG O 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LASG P 5 A_XScream
    LASG Q 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
    LASG RSTUV 5
    LASG W -1
    Stop
  }
}

Actor LegendarySSGGuyGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LES2 A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

