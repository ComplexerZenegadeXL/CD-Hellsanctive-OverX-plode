Actor LegendaryRevolverZombie 18501
{
  //$Category Monsters/LCA/DJB
  //$Sprite LGRZA1
  //$Title "Legendary Revolver Zombie"
  Health 1015
  Radius 20
  Height 56
  Speed 12
  PainChance 20
  Species ""
  Monster
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOTELEFRAG
  AttackSound "REVFIRE"
  SeeSound "Legrevolzomb/Sight"
  AttackSound "revfire"
  PainSound "lcmdo/pain"
  DeathSound "Legrevolzomb/Death"
  ActiveSound "legzom/active"
  Obituary "$CFLegendaryRevolverZombieObit"
  BloodColor "Blue"
  DropItem ".357Revolver" 200
  DropItem "LegendaryLMGBulletMagPickup" 250 3
  DropItem "LegendaryBulletBoxPickup" 125 1
  DropItem "LegendaryArmor" 90
  DropItem "LegendaryAmmoSphere" 93
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 240 2
  DropItem "Backpack" 200
  DropItem "Armorplate" 210
  DropItem "Portablemedkit" 215
  DropItem "StimKit" 220
  DropItem "HealthFlask" 225
  DropItem "LegendaryPowerShard" 35
  DropItem "LegendaryPowerSphere" 35
  Species "Zombie"
  Tag "$CFLegMagnum"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Explosion", 0.4
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.70
  var int user_music;
  var int user_protection;
  var int user_protected;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LGRZ A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    LGRZ A 10 Bright A_Look
	LGRI A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,28)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LGRZ AABBCCDD 3 Bright A_Chase
    Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,28)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LGRZ A 0 A_JumpIfTargetInLOS("Strafing")
    LGRZ AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	LGRZ A 0 A_JumpIfTargetInLOS("Strafing")
	LGRZ CCDD 3 Bright A_Chase
	LGRZ A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
    Loop
  Rush:
    LGRZ A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ C 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegRevZombieGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LGRZ D 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LGRZ AA 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LGRZ BB 3 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItem("LegendaryFootStep",0,0,0,0)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    LGRZ CC 3 Bright A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	LGRZ DD 3 Bright A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Missile:
	TNT1 A 0 A_Jump(40,"Multipleshots") 
    LGRZ EEE 2 Bright A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
    TNT1 A 0 A_JumpIfInventory ("LegRevZombieAmmo",6,"Reload")
    LGRZ E 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo",1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 4 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 2 Bright A_FaceTarget
	TNT1 A 0 A_CPosRefire
    Goto Missile
  Multipleshots:
	TNT1 A 0 A_JumpIfInventory ("LegRevZombieAmmo", 1, "Reload")
    TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
    LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
    LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 3 Bright A_FaceTarget
    TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_GiveInventory ("LegRevZombieAmmo", 1)
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer", 0,0,0,0)
	LGRZ F 3 Bright A_CustomBulletAttack(5,2.5,1,Random(60,70),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LGRZ E 3 Bright A_FaceTarget
	TNT1 A 0 A_CPosRefire 
  Reload:
    TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("REVOPEN")
	TNT1 AAAAAA 0 A_SpawnItemEx("LEGBulletCasing", -8, 7, 30, 4, 0,frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    LGRZ E 24 Bright A_TakeInventory ("LegRevZombieAmmo", 6)
    LGRZ E 12 Bright A_PlaySound("REVINSR") 
	LGRZ E 12 Bright A_PlaySound("REVCLOSE")
	LGRZ E 1 Bright A_PlaySound("REVSPIN")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  Pain:
    TNT1 A 0 A_Jump(50,"Protection")
	TNT1 A 0 A_Jump(192,"PainMissile")
    LGRZ G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LGRZ G 0 A_Pain
	LGRZ G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto See
  PainMissile: 
    LGRZ G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    LGRZ G 0 A_Pain
	LGRZ G 3 Bright A_GiveInventory("LegZombieStrafing",1)
    Goto Missile	
  Protection:
    TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	LGRZ E 2 Bright ACS_NamedExecuteAlways("LegendaryProtection",0,0,0,0)
	Goto See	
	Goto Missile	
  Death:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
    LRZD U 5 A_StopSound(6)
    LRZD V 5 A_Scream
    LRZD W 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LRZD X 5 
    LRZD Y 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LRZD Z -1
    Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	LRZD U 5 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LRZD V 5 A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LRZD W 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    LRZD X 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LRZD Y 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LRZD Z 140
	LRZD Z 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LRZD ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LRZD Z -1
	Stop
  XDeath:
	TNT1 A 0 A_StopSound(6)
    LGRZ M 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LGRZ N 5 A_XScream
    LGRZ O 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LGRZ PQRST 5
    LGRZ U -1
    Stop
  }
}

Actor LegRevZombieAmmo: Ammo { Inventory.MaxAmount 12 }

Actor LegRevZombieGhostA
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LGRZ A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegRevZombieGhostB : LegASGZombieGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LGRZ B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

