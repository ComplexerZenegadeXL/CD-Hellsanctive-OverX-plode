Actor InsaneSergeant
{
  Health 350
  Radius 20
  Height 56
  Speed 8
  PainChance 90
  Species ""
  Monster
  +FLOORCLIP
  +AVOIDMELEE
  +MISSILEEVENMORE
  +MISSILEMORE
  +QUICKTORETALIATE
  DamageFactor "Normal", 0.65
  DropItem "HandGrenadeAmmo" 80 2
  DropItem "MineAmmoRandomizer" 45 1
  DropItem "AmmoPack" 128
  DropItem "AmmoPack" 64
  DropItem "AmmoPack" 32
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  DropItem "PortableMedkit" 159
  DropItem "ArmorBooster" 186
  DropItem "ExplosiveSSGGiver" 40
  SeeSound "superzombie/sight"
  PainSound "superzombie/pain"
  DeathSound "superzombie/death"
  ActiveSound "superzombie/active"
  Obituary "$CFInsaneSergeantObit"
  Tag "$CFInsSerg"
  States
  {
  Spawn:
    IFAT A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:		
	IFAT AA 10 A_Look
    Loop
  See:
    IFAT AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    IFAT CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    Loop
  Missile:
	TNT1 A 0 A_JumpIfInventory("SSGZombieToken",2,"Reload")
	TNT1 A 0 A_JumpIfCloser(275,"Double")
  Normal:
    IFAT E 15 A_FaceTarget
	TNT1 A 0 A_PlaySound("ExpSSG/Fire2")
	TNT1 A 0 A_GiveInventory("SSGZombieToken",1)
	TNT1 AAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(26,29),0,frandom(-5,5),0)
    IFAT F 4 Bright A_CustomBulletAttack(13.8,5.7,5,Random(9,15),"BulletPuff",0,CBAF_NORANDOM)
    IFAT E 8 A_FaceTarget
	TNT1 A 0 A_JumpIfInventory("SSGZombieToken",2,"Reload")	
	Goto See
  Double:
    TNT1 A 0 A_JumpIfInventory("SSGZombieToken",1,"Normal")
    IFAT E 15 A_FaceTarget
	IFAT E 9 A_Facetarget
	TNT1 A 0 A_PlaySound("ExpSSG/Fire")
	TNT1 A 0 A_GiveInventory("SSGZombieToken",2)
	TNT1 AAAAAAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",frandom(26,29),0,frandom(-8,8),0)
    IFAT F 5 Bright A_CustomBulletAttack(17.8,9.6,10,Random(5,12),"BulletPuff",0,CBAF_NORANDOM)
    IFAT E 15 A_FaceTarget
  Reload:
	TNT1 A 0 A_TakeInventory("SSGZombieToken",2)
	IFAT E 6 A_FaceTarget
	IFAT E 12 A_PlaySound("weapons/sawedopen")
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -8, 6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    IFAT E 1 A_SpawnItemEx("OrangeShellCasing", -10, 6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	IFAT E 12 A_PlaySound("weapons/shellslide")
	IFAT E 12 A_PlaySound("weapons/sawedclose")
    IFAT E 6
    Goto See
  Pain:
	IFAT G 6 A_Pain
	TNT1 A 0 A_Jump(80,"Missile")
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	IFAT H 5 A_Scream
    IFAT I 5 A_Fall
    IFAT J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IFAT KLM 5
    IFAT N -1
    Stop
  XDeath:
	IFAT O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    IFAT P 3 A_XScream
    IFAT Q 3
    IFAT R 3 A_Fall
    IFAT ST 3
    IFAT T -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    IFAT MLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	IFAT TSRQPO 4
	Goto See  
  }
}