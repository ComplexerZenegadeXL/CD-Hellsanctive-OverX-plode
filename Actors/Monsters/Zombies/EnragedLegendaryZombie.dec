Actor EnragedLegendaryZombie : LegendaryZombie
{ 
  Health 1200
  Speed 35
  PainChance 25
  BloodColor "Red"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "EnragedLegendaryArmor" 85
  DropItem "LegendaryAmmoSphere" 88
  DropItem "HandGrenadeAmmo" 235 2
  DropItem "MineAmmoRandomizer" 235 2
  DropItem "Backpack" 198
  DropItem "Armorplate" 205
  DropItem "Portablemedkit" 210
  DropItem "ILDemonAmmoBoxPickup" 200 
  DropItem "ILDemonAmmoPickup" 250 
  DropItem "LegendaryPowerShard" 100
  DropItem "EnragedLegendaryPowerShard" 15
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryRandomSphere" 16
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor 0.65
  DamageFactor "LegendaryPlayer", 0.25
  +BRIGHT
  SeeSound "Elegzom/sight"
  PainSound "Elegzom/pain"
  DeathSound "Elegzom/death"
  ActiveSound "Elegzom/active"
  Obituary "$CFEnragedLegendaryZombieObit"
  Tag "$CFEnrZom"
  var int user_missile;
  States
  {
  Spawn:
    IPOS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
    TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IPOS A 10 A_Look
	IPO2 A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IPOS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,402)
	TNT1 A 0 A_SetUserVar("user_music",1)
    IPOS A 0 A_JumpIfTargetInLOS("Strafing")
    IPOS AA 3 A_Chase
	IPOS BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IPOS A 0 A_JumpIfTargetInLOS("Strafing")
	IPOS CC 3 A_Chase
	IPOS DD 3 A_Chase
	IPOS A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
    LoopSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,402)
	TNT1 A 0 A_SetUserVar("user_music",1)
    IPOS A 0 A_JumpIfTargetInLOS("Strafing")
    IPOS AA 3 A_Chase
	IPOS BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	IPOS A 0 A_JumpIfTargetInLOS("Strafing")
	IPOS CC 3 A_Chase
	IPOS DD 3 A_Chase
	IPOS A 0 A_Jump(80,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
    Loop
  Rush:
    TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IPOS A 0 A_JumpIfTargetInLOS("Strafing")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostAA")
	IPOS A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostAA")
	IPOS A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostBB")
	IPOS B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostBB")
	IPOS B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostCC")
	IPOS C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegZombieGhostCC")
	IPOS C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostDD")
	IPOS D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryZombieGhostDD")
	IPOS D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Strafing:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IPOS AA 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IPOS BB 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
    IPOS CC 3 A_GiveInventory("LegZombieStrafing",1)	
	TNT1 A 0 A_Chase("","Missile",CHF_DONTMOVE)
	IPOS DD 3 A_GiveInventory("LegZombieStrafing",1)
	Goto See
  Pause:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar(user_missile,0)
	IPOS E 0 A_PlaySound("weapons/demontechsteam")
	IPOS EEEEE 3 A_GiveInventory("LegZombieStrafing",1)
	Goto See	
  Missile:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IPOS EEEE 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Jump(20,"Rapid")
	IPOS E 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_GiveInventory("LegZombieStrafing",1)
	TNT1 AA 0 A_CustomMissile("RLegendaryProjectile",32,0,Frandom(-1,1),0)
	IPOS F 3 A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
	TNT1 A 0 A_Jump(24,"Pause")
	TNT1 A 0 A_SpidRefire
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	Goto Missile+5
  Rapid:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_PlaySound("ELegCommando/Star",0,1,0,ATTN_NONE)
    IPOS EEEEEEEE 3 A_GiveInventory("LegZombieStrafing",1)
  RapidLoop:
    TNT1 A 0 A_JumpIf(user_missile == 20,"Pause")
    IPOS E 1 A_GiveInventory("LegZombieStrafing",1)
	TNT1 AA 0 A_CustomMissile("RLegendaryProjectile",32,0,Frandom(-1,1),0)
	IPOS F 3 A_PlaySoundEx("weapons/DemonTechRifle","Weapon")
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	Loop
  Pain:
	TNT1 A 0 A_Jump(10,"Protection")
  Pain2:
	TNT1 A 0 A_Jump(192,"PainMissile")
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
    IPOS G 3 A_GiveInventory("LegZombieStrafing",1)
    TNT1 A 0 A_Pain
	IPOS G 3 A_GiveInventory("LegZombieStrafing",1)
    Goto See
  PainMissile: 
	IPOS G 3 A_GiveInventory("LegZombieStrafing",1)
	TNT1 A 0 A_Pain
	IPOS G 3 A_GiveInventory("LegZombieStrafing",1)
	Goto Missile	
  Protection:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIf(user_protection >= 3,"Pain2")
	TNT1 A 0 A_JumpIf(user_protected == 1,"Pain2")
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_FaceTarget
	IPOS E 2 ACS_NamedExecuteAlways("EnragedLegendaryProtection")
	Goto See	
  Death:
    TNT1 A 0 A_ChangeFlag("BRIGHT",0)
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
    TNT1 A 0 A_Jump(36,"LegendarySoul")
	IPOS H 5 A_Scream
    IPOS I 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
    IPOS J 5 A_SpawnItem("BodyCrash")
    IPOS K 5 
    IPOS L -1 
	Stop
  LegendarySoul:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	IPOS H 5 A_Scream
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IPOS I 5 A_Fall
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IPOS J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    IPOS KLL 5 A_SpawnItem("EnragedHellionSmokeSpawner")
	IPOS L 140
	IPOS N 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	IPOS LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_SpawnItem("ELegSoulEventSmokeSpawner",1)
	TNT1 A 0 A_SpawnItemEx("EnragedLegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	IPOS L -1
	Stop	
  XDeath:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IPOS P 3 A_XScream
    IPOS Q 3 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
    IPOS RSTUV 3 
    IPOS W -1 
    Stop
  }
}

Actor LegZombieGhostAA : LegZombieGhostA
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    IPOS A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

