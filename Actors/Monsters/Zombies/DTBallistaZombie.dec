Actor DemonTechBallistaZombie 18553 
{ 
  //$Category Monsters/LCA/DJB
  //$Sprite ZMBYA1
  //$Title "DemonTech-Ballista Zombie"
  Health 60
  Radius 20
  Height 56
  Speed 8
  Mass 100
  PainChance 80
  Species ""
  PainChance "ZombieDemonTech", 0
  DropItem "DemonTechBallistaGiver" 16 1
  DropItem "StimKit" 150
  DropItem "ArmorBooster" 150
  DropItem "HandGrenadeAmmo" 150 1
  DropItem "MineAmmoRandomizer" 75 1
  DropItem "AmmoPack" 75
  DropItem "DemonAmmoPickup" 256 80
  DamageFactor "ZombieDemonTech", 0.15
  Monster 
  +MISSILEMORE
  +MISSILEEVENMORE
  SeeSound "fem/sight"
  PainSound "fem/pain"
  DeathSound "fem/death"
  ActiveSound "fem/active"
  Tag "$CFBallistaZom"
  Obituary "$CFDemonTechBallistaZombieObit"
  var int user_lowlag;
  States
  {
  Spawn:
	ZMBY A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ZMBY A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ZMBY AABBCCDD 3 A_Chase
	Loop	
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	ZMBY AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	ZMBY CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop	
  Missile:
	ZMBY EE 7 A_FaceTarget
	TNT1 AAAAA 0 A_CustomMissile("BDemonTechProjectile",32,0,frandom(-2,2),0,frandom(-0.5,0.5))
	ZMBY F 3 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	ZMBY E 30
	Goto See
  Pain:
	ZMBY G 6 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	ZMBY H 5 A_Scream
	ZMBY I 5 A_Fall
	ZMBY J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	ZMBY K 5
	ZMBY L -1
	Stop
  XDeath:
	ASGZ O 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	ASGZ P 3 A_XScream
	ASGZ R 3 A_Fall
	ASGZ STUV 3
	ASGZ W -1 
	Stop	
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	ZMBY LKJIH 6
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ASGZ VUTSRQPO 5
	Goto See
  }
}

Actor BDemonTechProjectile : ZDemonTechProjectile { Damage (Random(10,20)) }