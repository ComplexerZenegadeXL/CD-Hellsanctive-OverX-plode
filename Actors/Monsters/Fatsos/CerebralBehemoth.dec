Actor CerebralBehemoth : Behemoth 27900
{
  Health 2400
  PainChance 80
  Scale 1.2
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Legendary", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor 0.75
  DropItem "BossLifeEssence", 128, 25
  DropItem "BossArmorBonusMax", 128, 1
  DropItem "DemonAmmoBoxPickup", 128, 200
  DropItem "BehemothCannonGiver", 256
  DropItem "CannongunSphere", 128
  DropItem "HellfireUltrasphere", 12
  +MISSILEMORE
  +DONTHURTSPECIES
  SeeSound "CerebralBehemoth/Sight"
  PainSound "CerebralBehemoth/Pain"
  DeathSound "CerebralBehemoth/Death"
  ActiveSound "CerebralBehemoth/Active"
  Obituary "$CFCerebralBehemothObit"
  Tag "$CFCereBehe"
  States
  {
  Spawn:
    CBEH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CBEH A 8 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20) 
    CBEH AABBCCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    CBEH EEFF 3 A_Chase
    Loop
  Missile:
	TNT1 A 0 A_Jump(128,"Seekers","InfernalRockets","BFG15K","BFG9K","HFCyberBalls")
  Normal:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Attack")
    CBEH G 15 A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, 38, frandom(-12,6))
    CBEH H 4 Bright A_CustomMissile("BehemothComet", 20, -38, frandom(-6,12))
    CBEH IG 4 A_FaceTarget      
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, 38, frandom(-12,6))
    CBEH H 4 Bright A_CustomMissile("BehemothComet", 20, -38, frandom(-6,12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("BehemothComet", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("BehemothComet", 20, -38, frandom(7, 12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("BehemothComet", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("BehemothComet", 20, -38, frandom(7, 12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("BehemothComet", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("BehemothComet", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("BehemothComet", 20, -38, frandom(7, 12))
    CBEH IG 12
    Goto See
  Seekers:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Attack")
    CBEH G 15 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothSeekingComet", 20, 38, -16)
    CBEH H 6 Bright A_CustomMissile("BehemothSeekingComet", 20, -38, 16)
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothSeekingComet", 20, 38, -16)
    CBEH H 6 Bright A_CustomMissile("BehemothSeekingComet", 20, -38, 16)
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothSeekingComet", 20, 38, -16)
    CBEH H 6 Bright A_CustomMissile("BehemothSeekingComet", 20, -38, 16)
    CBEH IG 12   
    Goto See
  InfernalRockets:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Attack")
    CBEH GG 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("InfernalBehemothRocket", 20, 38, frandom(-12,6))
    CBEH H 6 Bright A_CustomMissile("InfernalBehemothRocket", 20, -38, frandom(-6,12))
    CBEH IG 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("InfernalBehemothRocket", 20, 38, frandom(-12,6))
    CBEH H 6 Bright A_CustomMissile("InfernalBehemothRocket", 20, -38, frandom(-6,12))
    CBEH IG 12 A_FaceTarget
    TNT1 A 0 A_CustomMissile("InfernalBehemothRocket", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("InfernalBehemothRocket", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("InfernalBehemothRocket", 20, 38, frandom(-12,-7))
    CBEH H 6 Bright A_CustomMissile("InfernalBehemothRocket", 20, -38, frandom(7, 12))
    CBEH IG 16
    Goto See
  BFG15K:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Rage")
	TNT1 A 0 A_PlaySound("weapons/charge15k",7)
    CBEH GGGGGG 5 A_FaceTarget    
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, 38, frandom(-12,6))
    CBEH H 6 Bright A_CustomMissile("DBusBFG15K", 20, -38, frandom(-6,12))
    CBEH IG 6 A_FaceTarget      
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, 38, frandom(-12,6))
    CBEH H 6 Bright A_CustomMissile("DBusBFG15K", 20, -38, frandom(-6,12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("DBusBFG15K", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("DBusBFG15K", 20, -38, frandom(7, 12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("DBusBFG15K", 20, 38, frandom(-6,0))	   
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("DBusBFG15K", 20, -38, frandom(7, 12))
    CBEH IG 12
    Goto See
  BFG9K:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Rage")
	TNT1 A 0 A_PlaySound("weapons/bfgf",7)
    CBEH GGGGGGG 5 A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("BehemothBFG9500Ball", 20, 38, frandom(-12,6))
    CBEH H 10 Bright A_CustomMissile("BehemothBFG9500Ball", 20, -38, frandom(-6,12))
    CBEH IG 20
    Goto See
  HFCyberBalls:
    TNT1 A 0 A_PlaySound("CerebralBehemoth/Rage")
    CBEH GGG 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-12,6))
    CBEH H 4 Bright A_CustomMissile("BehemothFireBalls", 20, -38, frandom(-6,12))
    CBEH IG 4 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-12,6))
    CBEH H 4 Bright A_CustomMissile("BehemothFireBalls", 20, -38, frandom(-6,12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-6,0))
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("BehemothFireBalls", 20, -38, frandom(7, 12))
    CBEH IG 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, -38, frandom(0, 6))
    CBEH H 2 Bright A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-6,0))
    TNT1 A 0 A_CustomMissile("BehemothFireBalls", 20, 38, frandom(-12,-7))
    CBEH H 4 Bright A_CustomMissile("BehemothFireBalls", 20, -38, frandom(7, 12))
    CBEH IG 12
    Goto See
  Pain:	
    TNT1 A 0 A_Jump(87,"PainMissile")
    CBEH J 6 A_Pain
    Goto See
  PainMissile:
    CBEH J 6 A_Pain
    Goto Missile
  Death:
	CBEH K 6
    CBEH L 6 A_Scream
    TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CBEH M 6 A_NoBlocking
    TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CBEH NOPQRS 6
    CBEH T -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    CBEH SRQPONMLK 6
    Goto See
  }
}

Actor InfernalBehemothRocket : InfernalCyberNobleRocket
{
  Species "Fatsos"
  DamageType "BeheComet"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,0,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,45,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,90,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,135,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,180,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,225,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,270,6)
    TNT1 A 0 A_CustomMissile("BehemothHellBoom",0,0,315,6)
	CROC B 6 Bright A_Explode(64,128)
	CROC CD 5 Bright A_SetTranslucent(0.75,1)
	Stop
  }
}

Actor BehemothHellBoom : HellBoom
{
  Species "Fatsos"
  DamageType "BeheComet"
  States
  {
  Spawn:
    TNT1 AAAAA 3 A_SpawnItem("BehemothHellFX",0,0)
    Stop
  }
}

Actor BehemothHellFX : HellFX { Species "Fatsos" DamageType "BeheComet" }

Actor BehemothBFG9500Ball : TerminatorBFG9500Ball
{
  Species "Fatsos"
  DamageType "BeheComet"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveRed2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom18", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRE3 AB 8 Bright A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BRE3 C 8 Bright A_BFGSpray("BehemothCustomSprayRed",15,15)
    BRE3 DEF 8 Bright
    Stop  
  }
}

Actor BehemothCustomSprayRed : DesolatorCustomSprayRed { Species "Fatsos" DamageType "BeheComet" }

Actor BehemothFireBalls : HFCyberFireBalls { Species "Fatsos" DamageType "BeheComet" }