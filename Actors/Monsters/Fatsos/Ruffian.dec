Actor Ruffian : Hectebus
{
  Monster
  Health 1800
  Height 64
  Radius 48
  Mass 1000
  Speed 4
  Scale 1.1
  BloodColor "Blue"
  PainChance "Mine", 50
  PainChance 12
  +BOSSDEATH
  +NOTARGET
  +FLOORCLIP
  +MISSILEMORE
  +DONTHARMSPECIES
  DamageFactor "DemonTechProjectile", 0.5
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Cacolich", 0.0
  DropItem "BossLifeEssence", 256 
  DropItem "NemesisArmorBonusMax", 256
  DropItem "NemesisArmorBonusMax", 256
  DropItem "NemesisArmorBonusMax", 256
  DropItem "NemesisArmorBonusMax", 256
  DropItem "ExtraArmor", 128, 1 
  DropItem "RuffianCannonGiver", 64
  SeeSound "ruffian/sight"
  ActiveSound "ruffian/idle"
  PainSound "ruffian/pain"
  DeathSound "ruffian/death"
  Obituary "$CFRuffianObit"
  Tag "$CFRuff"
  States
  {
  Spawn:
	RFT2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	RFT2 CC 8 A_Look
	RFTI CC 8 A_Look
	Loop
  See:
	TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)   
	RFT2 AAAAABBBBBCCCCCDDDDD 1 A_Chase
	TNT1 A 0 HealThing(10)
	TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
	RFT2 EEEEEFFFFF 1 A_Chase
	TNT1 A 0 HealThing(5)
	Loop
  Missile:
	TNT1 A 0 A_PlaySound("ruffian/attack")
	TNT1 A 0 A_Jump(78,"BigComets","CurseComets")
  Normal:
	RFT2 GGG 5 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget 
	TNT1 AA 0 A_CustomMissile("RuffianComet",26,30,frandom(-12,6))
	RFT2 HH 3 Bright A_CustomMissile("RuffianComet",26,-30,frandom(-6,12))
	RFT2 IG 6 A_FaceTarget      
	TNT1 A 0 A_CustomMissile("RuffianComet",26,30,frandom(-12,6))
	RFT2 HH 3 Bright A_CustomMissile("RuffianComet",26,-30,frandom(-6,12))
	RFT2 IG 10 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("RuffianComet",26,-30,frandom(0,6))
	RFT2 HH 1 Bright A_CustomMissile("RuffianComet",26,30,frandom(-6,0))
	TNT1 AA 0 A_CustomMissile("RuffianComet",26,30,frandom(-13,-7))
	RFT2 HH 3 Bright A_CustomMissile("RuffianComet",26,-30,frandom(7,13))
	RFT2 I 12
	Goto See
  BigComets:
	RFT2 GGG 5 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	RFT2 H 6 Bright A_CustomMissile("PaladinComet",26,30,frandom(-12,6))
	RFT2 IG 6 A_FaceTarget
	RFT2 H 6 Bright A_CustomMissile("PaladinComet",26,-30,frandom(-6,12))
	RFT2 IG 10 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinComet",26,-30,frandom(0,6))
	RFT2 H 2 Bright A_CustomMissile("PaladinComet",26,30,frandom(-6,0))
	TNT1 A 0 A_CustomMissile("PaladinComet",26,30,frandom(-13,-7))
	RFT2 H 6 Bright A_CustomMissile("PaladinComet",26,-30,frandom(7,13))
	RFT2 I 12
	Goto See
  CurseComets:
	RFT2 GGG 5 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	RFT2 H 6 Bright A_CustomMissile("CurseComet",26,30,frandom(-12,6))
	RFT2 IG 6 A_FaceTarget
	RFT2 H 6 Bright A_CustomMissile("CurseComet",26,-30,frandom(-6,12))
	RFT2 IG 10 A_FaceTarget
	RFT2 H 2 Bright A_CustomMissile("CurseComet",26,30,frandom(-6,0))
	RFT2 H 6 Bright A_CustomMissile("CurseComet",26,-30,frandom(7,13))
	RFT2 I 12
	Goto See
  Pain:
	TNT1 A 0 A_Jump(87,"Missile")
	RFT2 J 6 A_Pain
	Goto See
  Death:
	RFT2 K 6
	RFT2 L 6 A_Scream
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_RadiusGive("RuffRevive",670,RGF_CORPSES|RGF_MONSTERS,1)
	RFT2 MMMMMMM 1 Bright A_SpawnItemEx("BlueFire2",frandom(-8,8),frandom(-8,8),frandom(10,25),frandom(-2,2),frandom(-2,2),frandom(2,5),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	RFT2 M 1 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	RFT2 NOPQR 6
	TNT1 A 0 A_RemoveChildren
	RFT2 S 6
	RFT2 T -1
	Stop
  Raise:
	Stop
  }
}

Actor CurseComet : Comet
{
  Damage (random(20,50)) //8
  +SEEKERMISSILE
  +HITTRACER
  +DONTHARMSPECIES
  Species "Fatsos"
  DamageType "BeheComet"
  DeathSound "barbcomet/explosion"
  States
  {
  Spawn:
	RUBB AAABBB 1 Bright A_SpawnItemEx("CurseCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Crush:
  Death:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("Kaboom23",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom23",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	RUBB C 3 Bright A_Explode(42,102)
	RUBB D 3 Bright A_SetTranslucent(0.75,1)
	RUBB EFG 3 Bright
	Stop
  }
}

Actor CurseCometTail : CometTail
{
  Alpha 0.85
  Scale 0.75
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
	RUBT ABCDE 2 Bright A_FadeOut(0.2,1)
	Stop
  }
}

Actor RuffianComet : CFHomingCometBase
{
  Speed 21
  FastSpeed 25
  ReactionTime 29
  Damage (Random(15,30)) //4
  Species "Fatsos"
  DamageType "BeheComet"
  +DONTHARMSPECIES
}

Actor RuffRevive : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
   {
   PickUp:
    TNT1 A 0 A_JumpIfHealthLower(25,"PickUp.Revive") //25
	TNT1 AAA 0 A_SpawnItemEx("DFMarkFX",0,0,0)
    TNT1 A 0 HealThing(217,999)
    Stop
    PickUp.Revive:
    TNT1 A 0 A_Jump(45,"PickUp.Nightmare")
    TNT1 A 0 A_CustomMissile("HellionResRadius",10,0,frandom(0,360),0)
    Stop
    PickUp.Nightmare:
    TNT1 A 0 A_SpawnItemEx("Nightmare",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_NOCHECKPOSITION)
    Stop
  }
}