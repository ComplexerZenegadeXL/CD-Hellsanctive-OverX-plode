Actor Demobus : Hectebus 
{
  Health 1400
  PainChance 40
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  Monster
  +DONTHURTSPECIES
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128
  DropItem "BFG10KGiver" 70 1
  SeeSound "monsters/volsee"
  PainSound "monsters/volpain"
  DeathSound "monsters/voldeath"
  ActiveSound "manc/idle"
 Obituary "$CFDemobusObit"
 Tag "$CFDemobus"
  States
  {
  Spawn:
    BFAT A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BFAT A 10 A_Look
    Loop
  See:  
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    BFAT AABBCCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    BFAT EEFF 3 A_Chase
    Loop
  Missile:
    TNT1 A 0 A_PlaySound("weapons/charge15k")
    BFAT G 20 A_FaceTarget    
    TNT1 A 0 A_FaceTarget 	   
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 26, 26, frandom(-12, 6))
    BFAT H 8 Bright A_CustomMissile("DBusBFG15K", 26, -26, frandom(-6, 12)) 
    BFAT I 6 A_FaceTarget     
    BFAT G 6 A_FaceTarget   
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 26, 26, frandom(-12, 6))
    BFAT H 8 Bright A_CustomMissile("DBusBFG15K", 26, -26, frandom(-6, 12))
    BFAT I 10 A_FaceTarget
    BFAT G 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 26, 26, frandom(-13, -7))
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 26, 26, frandom(-6, 0))     
    TNT1 A 0 A_CustomMissile("DBusBFG15K", 26, -26, frandom(0, 6))
    BFAT H 8 Bright A_CustomMissile("DBusBFG15K", 26, -26, frandom(7, 13))  
    BFAT I 8
    Goto See
  Pain:	
    BFAT J 6 A_Pain
    Goto See
  Death:
	BFAT K 6
    BFAT L 6 A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    BFAT M 6 A_NoBlocking
    BFAT NOPQR 6
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    BFAT S 6
    BFAT T -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    BFAT SRQPONMLK 6
    Goto See
  }
}

Actor DBusBFG15K : BFG15KBall
{
  FastSpeed 30
  Scale 0.6
  SeeSound "weapons/bfg15kfire"
  Species "Fatsos"
  DamageType "BeheComet"
  +DONTHARMSPECIES
 -THRUSPECIES
  States
  {
  Spawn:
    TNT1 AA 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    CFS1 A 4 Bright
    TNT1 AA 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-8,8),frandom(-8,8),Random(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	CFS1 B 4 Bright
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom14", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CFE1 A 3 Bright A_Explode(80,162)
    CFE1 BC 3 Bright 
    CFE1 BA 3 Bright
    CFG9 ABCDEF 3 Bright   
    Stop
  }
}