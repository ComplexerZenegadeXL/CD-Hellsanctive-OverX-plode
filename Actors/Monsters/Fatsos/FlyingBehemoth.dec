Actor FlyingBehemoth : Hectebus
{
  Health 1100
  PainChance 80
  Scale 0.8
  Radius 26
  Speed 6
  Height 64
  Mass 2000
  Monster
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "LifeEssence" 140
  DropItem "ArmorBonusMax" 140
  DropItem "BehemothCannonGiver" 128
  +MISSILEMORE
  +DONTHURTSPECIES
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY
  -FLOORCLIP
  SeeSound "monsters/volsee"
  PainSound "monsters/volpain"
  DeathSound "monsters/voldeath"
  ActiveSound "manc/idle"
  Obituary "$CFFlyingBehemothObit"
  Tag "$CFFlyBehe"
  States
  {
  Spawn:
    KSFA A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	KSFA A 10 A_Look   
    Loop
  See:   
    KSFA AA 2 A_Chase
    Loop
  Missile:
	TNT1 A 0 A_Jump(82,"Seekers")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/volattack")
    KSFA G 15 A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("BehemothComet", 36, 24, frandom(-12, 6))
    KSFA H 6 Bright A_CustomMissile("BehemothComet", 36,  -24, frandom(-6, 12))
    KSFA FG 8 A_FaceTarget      
    TNT1 A 0 A_CustomMissile("BehemothComet", 36, 24, frandom(-12, 6))
    KSFA H 6 Bright A_CustomMissile("BehemothComet", 36,  -24, frandom(-6, 12))
    KSFA FG 12 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BehemothComet", 36,  -24, frandom(0, 6))
    KSFA H 2 Bright A_CustomMissile("BehemothComet", 36, 24, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("BehemothComet", 36, 24, frandom(-12, -7))
    KSFA H 6 Bright A_CustomMissile("BehemothComet", 36,  -24, frandom(7, 12))
    KSFA FG 12
    Goto See
  Seekers:
    TNT1 A 0 A_PlaySound("monsters/volattack")
    KSFA G 15 A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("BehemothSeekingComet", 36, 24, -16)
    KSFA H 6 Bright A_CustomMissile("BehemothSeekingComet", 36,  -24, 16)
    KSFA FG 12    
    Goto See  
  Pain:	
    TNT1 A 0 A_Jump(87,2)
    KSFA J 6 A_Pain
    Goto See		   
    KSFA J 6 A_Pain
    Goto Missile
  Death:
    KSFA K 6
    KSFA L 6 A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    KSFA M 6 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    KSFA NOP 6   
    KSFA Q -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    KSFA QPONMLK 6
    Goto See
  }
}