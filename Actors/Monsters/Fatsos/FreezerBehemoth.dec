Actor FreezerBehemoth : Hectebus 16565
{
  //$Category Monsters/LCA
  //$Sprite FRBHA1D1
  //$Title "Freezer Behemoth"
  Health 1550
  Radius 48
  Height 64
  PainChance 55
  Scale 1.1
  BloodColor "Sky Blue"
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DropItem "BossLifeEssence" 250
  DropItem "BossArmorBonusMax" 250
  DropItem "NewCellPackPickup" 250
  DropItem "FreezerRifleGiver" 150 1 
  DropItem "FreezerBFGGiver" 16
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOTARGET
  +QUICKTORETALIATE
  +MISSILEMORE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOICEDEATH
  +THRUSPECIES
  SeeSound "FreezerBehe/Sight"
  PainSound "FreezerBehe/Pain"
  DeathSound "FreezerBehe/Death"
  ActiveSound "manc/idle"
  Obituary "$CFFreezerBehemothObit"
  Tag "$CFIceManc"
  States
  {
  Spawn:
    FRBH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	FRBH CC 8 Bright A_Look
	QATI CC 8 Bright A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20) 
    FRBH AABBCCDD 3 Bright A_Chase
	FRBH BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    FRBH EEFF 3 Bright A_Chase
    Loop
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_JumpIfCloser(350,"Freezethrowers")
	TNT1 A 0 A_Jump(110,"Seekers")
  Normal:
    TNT1 A 0 A_PlaySound("FreezerBehe/Cannon")
    FRBH G 15 Bright A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("FRZRBehBomb", 30, 30, frandom(-12, 6))
    FRBH H 6 Bright A_CustomMissile("FRZRBehBomb", 30, -30, frandom(-6, 12))
    FRBH IG 8 Bright A_FaceTarget      
    TNT1 A 0 A_CustomMissile("FRZRBehBomb", 30, 30, frandom(-12, 6))
    FRBH H 6 Bright A_CustomMissile("FRZRBehBomb", 30, -30, frandom(-6, 12))
    FRBH IG 12 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("FRZRBehBomb", 30, -30, frandom(0, 6))
    FRBH H 2 Bright A_CustomMissile("FRZRBehBomb", 30, 30, frandom(0, -6))	   
    TNT1 A 0 A_CustomMissile("FRZRBehBomb", 30, 30, frandom(-12, -7))
    FRBH H 6 Bright A_CustomMissile("FRZRBehBomb", 30, -30, frandom(7, 12))
    FRBH IG 12 Bright
	TNT1 A 0 A_Jump(70,"Seekers")
    Goto See
  Freezethrowers:
    TNT1 A 0 A_Jump(82,"Normal")
	TNT1 A 0 A_PlaySound ("freeze/altfire", 6)
	FRBH GG 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("freeze/althold", 6)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6,-6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("FRZRFlameShot", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    FRBH H 1 Bright A_CustomMissile("FRZRFlameShot", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	FRBH IG 12 Bright A_StopSound(6)
	Goto See
  Seekers:
    TNT1 A 0 A_PlaySound("FreezerBehe/Sight")
	FRBH IG 14 Bright A_FaceTarget	   
    TNT1 A 0 A_CustomMissile("FRZRBehBall",30,30,0)
    FRBH H 8 Bright A_CustomMissile("FRZRBehBall",30,-30,0)
    FRBH IG 12 Bright
    Goto See
  Pain:	
    TNT1 A 0 A_Jump(87,"PainMissile")
    FRBH J 6 Bright A_Pain
    Goto See
  PainMissile:
    FRBH J 6 Bright A_Pain
    Goto Missile
  Death.PlayerIce:
  Death:
	FRBH K 6 Bright
    TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FRBH L 6 Bright A_Scream
	FRBH M 6 Bright A_NoBlocking
    TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FRBH NOPQR 6 Bright
    FRBH S 6 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FRZRIceSpike", frandom(-256,256), frandom(-256,256), 0, 0, 0, 0, 0, 34, 0)
    FRBH T -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    FRBH SRQPONMLK 6 Bright
    Goto See
  }
}

Actor FRZRFlame
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  RenderStyle Add
  Scale 0.5
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A Random(3,5)
	QMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor FRZRFlameSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 AAAAAA 0 A_SpawnItemEx("FRZRFlame",frandom(-30,-0),frandom(-30,30),frandom(0,64),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor FRZRBehemothSeekingComet : Comet
{
  Scale 0.55
  Damage (random(25,40)) //12
  Species "Fatsos"
  DamageType "Ice"
  RenderStyle Add
  Alpha 0.85
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0 A_Tracer2
	FRBC AAAAA 1 Bright A_SpawnItemEx("FRZRBehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Tracer2
	FRBC BBBBB 1 Bright A_SpawnItemEx("FRZRBehemothSeekingTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor FRZRBehemothSeekingTail : CometTail
{
  Alpha 0.85
  Scale 0.75
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A Random(5,7)
	FRBT ABCDE 2 Bright A_FadeOut(0.12)
	Stop
  }
}

Actor FRZRIceSpikeSpawner
{
  Radius 5
  Height 5
  Speed 20
  FastSpeed 25
  Damage 0
  +RIPPER
  +FLOORHUGGER
  +BLOODLESSIMPACT
  +THRUSPECIES
  Species "Fatsos"
  DamageType "Ice"
  Projectile
  States
  {
  Spawn: 
	TNT1 AAAA 1 A_Weave(3,0,1.0,0.0)
	TNT1 A 1 A_CustomMissile("FRZRIceSpike",0,0,0,CMF_TRACKOWNER)
    Loop
  Death:  
    TNT1 A 1
    Stop
  }
}

Actor FRZRIceSpike
{
  Scale 0.7
  Health 40
  Damage (Random(0,2))
  +SOLID
  +NOBLOOD
  +RIPPER
  +DONTHARMSPECIES
  +FLOORHUGGER
  +MTHRUSPECIES
  +THRUSPECIES
  +MISSILE
  +PIERCEARMOR
  +NODAMAGETHRUST
  Radius 32
  Height 93
  Mass 999999
  Species "Fatsos"
  DamageType "Ice"
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FatFlamer", 0
  DamageFactor "BeheComet", 0
  States
  {
  Spawn:
	TNT1 A 0
	ICPL I 6 ThrustThingZ(0, 9999, 1, 1)
	TNT1 A 0 A_PlaySound("icespike")
	ICPL I 0 A_ChangeFlag("SHOOTABLE", 1)
	ICPL I 200 //200 
	Goto Death
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	ICPL I 0 A_ChangeFlag("SHOOTABLE", 0)
	ICPL I 1 A_ChangeFlag("SOLID", 0)
	ICPL IHGFEDCBA 2 A_SpawnItemEx("IceMiniSmokeEffect",0,0,frandom(0,93),0,0,0,0,SXF_CLIENTSIDE,158)
	TNT1 A 0 A_PlaySound("icespike")
	Stop
  }
}

Actor IceMiniSmokeEffect
{
  RenderStyle Translucent
  Speed 18
  Alpha 0.8
  Radius 4
  Height 4
  Damage 0
  Scale 2.0
  +NOBLOOD
  +CLIENTSIDEONLY
  +DONTSPLASH
  +DOOMBOUNCE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	PLSS JKLMNOPQRSTUVWX 2 A_FadeOut(0.02)
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor BeheIceSpikeInventory : CustomInventory
{
  Inventory.PickupMessage ""
  Inventory.PickupSound ""
  -COUNTITEM
  +INVENTORY.AUTOACTIVATE
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FRZRIceSpike", frandom(-256,256), frandom(-256,256), 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION, 0)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FRZRIceSpike", frandom(-256,256), frandom(-256,256), 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION, 0)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FRZRIceSpike", frandom(-256,256), frandom(-256,256), 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION, 0)
	Stop
  }
}

Actor FRZRBehBomb
{
  Radius 13
  Height 8
  Speed 25
  FastSpeed 30
  Damage (random(30,45)) //12
  Scale 1.5
  Alpha 0.75
  RenderStyle Translucent
  Species "Fatsos"
  DamageType "Ice"
  Projectile
  +DONTHARMSPECIES
  SeeSound "icespike"
  DeathSound "iceexplode"
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 A 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 B 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 C 1 Bright	
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 A 0 A_Explode(32,102,0)
	TNT1 A 0 A_PlaySound("icespike",7)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	SHEX G 0 A_CustomMissile("FRZRBehBombProj",0,0,user_loop * 20,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	SHEX DCEFG 3 Bright
	Stop
  }
}

Actor FRZRBehBombTrail : BFG9500Trail
{
  Scale 1.2
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
  SpawnLoop:
    FX05 ABC 2 A_FadeOut(0.25)
    Loop
  }
}

