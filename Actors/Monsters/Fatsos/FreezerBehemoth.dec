	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),Random(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
