  }
}

Actor FRZRBehBall
{
  Radius 10
  Height 10
  Speed 25
  Scale 0.5
  Damage (Random(45,65)) //15
  Species "Fatsos"
  DamageType "Ice"
  RenderStyle Add
  Alpha 0.75
  SeeSound "icespike"
  DeathSound "icefurry"
  +SEEKERMISSILE
  +HEXENBOUNCE
  BounceCount 3
  Projectile
  States
  {
  Spawn:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,5,SMF_LOOK)
	ICBL A 1 Bright A_SpawnItemEx("FRZRBehBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,5,SMF_LOOK)
	ICBL B 1 Bright A_SpawnItemEx("FRZRBehBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,5,SMF_LOOK)
	ICBL C 1 Bright A_SpawnItemEx("FRZRBehBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,5,SMF_LOOK)
	ICBL D 1 Bright A_SpawnItemEx("FRZRBehBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	ICBL A 0 A_Explode(32,104,0)
	ICBL A 0 A_PlaySound("icefurry")
	TNT1 AAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("BlueKaboom3",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20))
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("FRZRFlameShotEffect",frandom(-3,3),frandom(-3,3),CMF_AIMDIRECTION,frandom(-6,6),frandom(-6,6),frandom(-3,3))
	Stop
  }
}

Actor FRZRFlameShotEffect : FRZRFlameShot
{
  Damage 0
  States
  {
  Spawn:
    TNT1 A 0
  Death:
	TNT1 A 0
	Stop
