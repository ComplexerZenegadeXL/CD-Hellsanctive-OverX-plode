Actor Mancutank : Hectebus 17559
{
  //$Category Monsters/CF
  //$Sprite BS1WA1
  //$Title "Mancutank"
  Health 1400
  Mass 2000
  Speed 12
  Scale 0.9
  PainChance 20
  Species "Fatsos"
  +NORADIUSDMG
  +MISSILEMORE
  SeeSound "MancuTank/sight"
  PainSound "MancuTank/pain"
  DeathSound "MancuTank/death"
  ActiveSound "MancuTank/active"
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "MissileBoxPickup" 128 20
  DropItem "BulletBoxPickup" 128 20
  DropItem "ExplosiveMinigunGiver" 128 1
  Obituary "$CFMancutankObit"
  Tag "$CFMancuT"
  States
  {
  Spawn:
	BS1W A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_PlaySound("Mancutank/Tank",7,1,True)
	BS1W AC 10 A_Look
	Loop
  See:
	TNT1 A 0 A_PlaySound("Mancutank/Tank",7,1,True)
	BS1W ABCD 3 A_Chase
    Goto See
  Missile:
    TNT1 A 0 A_Jump(256, "Chainguns", "Missiles")
  Chainguns:
	BS1T AAAA 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_FaceTarget
	BS1T B 0 A_CustomMissile("MancutankExplosiveTracer",53,-36,frandom(-5,5))
	BS1T B 2 Bright A_CustomMissile("MancutankExplosiveTracer",53,36,frandom(-5,5))
	BS1T A 4 A_FaceTarget
	TNT1 A 0 A_SpidRefire
	Goto Chainguns+4
  Missiles:
	BS1T AAAA 4 A_FaceTarget
	BS1T C 0 A_CustomMissile("MancutankRocket",71,-49)
	BS1T C 8 A_CustomMissile("MancutankRocket",71,49)
	BS1T AA 12 A_FaceTarget
	BS1T D 0 A_CustomMissile("MancutankRocket",64,-49)
	BS1T D 8 A_CustomMissile("MancutankRocket",64,49)
	BS1T AA 12 A_FaceTarget
	BS1T E 0 A_CustomMissile("MancutankRocket",53,-49)
	BS1T E 8 A_CustomMissile("MancutankRocket",53,49)
	Goto See
  Pain:
	BS1W A 3
	BS1W A 3 A_Pain
	Goto See
  Death:
    TNT1 A 0 A_StopSound(7)
	BS1B A 6
	BS1B B 6 A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(1-0,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BS1B CCCCDDDD 3 Bright A_SpawnItemEx("CFKaboom",frandom(-60,60),frandom(-60,60),frandom(20,70),0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BS1B EEEEFFFFGGGG 3 Bright A_SpawnItemEx("CFKaboom",frandom(-60,60),random(-60,60),frandom(20,70),0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BS1B HHHIII 3 Bright A_SpawnItemEx("CFKaboom",frandom(-60,60),frandom(-60,60),frandom(20,70),0,0,0,0,SXF_NOCHECKPOSITION)
	BS1B JK 6 A_NoBlocking
	BS1B L -1
	Stop
  Raise:
	Stop
  }
}

Actor MancutankRocket : NewRocket
{
  Speed 23
  Damage (Random(70,110)) //20
  FastSpeed 28
  Species "Fatsos"
  DamageType "BeheComet"
  -THRUSPECIES
  +DONTHARMSPECIES
}

Actor MancutankExplosiveTracer : SentientExplosiveTracer
{
  Scale 0.4
  Species "Fatsos"
  DamageType "BeheComet"
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TRAC A 10 Bright
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItem("SentientExplosiveEffect")
    MISL B 4 Bright A_Explode(Random(15,30),72)
    MISL CD 3 Bright
    Stop
  }
}