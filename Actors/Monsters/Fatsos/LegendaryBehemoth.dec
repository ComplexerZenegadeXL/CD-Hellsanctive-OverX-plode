Actor LegendaryBehemoth 16512
{
  //$Category Monsters/LCA
  //$Sprite LEG2A1D1
  //$Title "Legendary Behemoth"
  Monster
  Radius 48
  Height 64
  Health 2200
  PainChance 30
  Scale 1.25
  Speed 9
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Legendary1", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.6
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendarySphere" 110 1
  DropItem "LDemonAmmoBoxPickup" 250 
  DropItem "LDemonAmmoPickup" 250 
  //DropItem "LegendaryPlasmaticCannonGiver" 175 1
  DropItem "LegendaryTimeFreezeSphere" 75
  DropItem "LegendaryRandomSphere" 16 1
  BloodColor "Blue"
  Species "Fatsos"
  +FLOORCLIP
  +BOSS
  +BOSSDEATH
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOICEDEATH
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +NOTIMEFREEZE
  +NOFEAR
  +BRIGHT
  +NOTELEFRAG
  Mass 1500
  SeeSound "LegendaryFat/Sight"
  PainSound "LegendaryFat/Pain"
  DeathSound "LegendaryFat/Death"
  ActiveSound "manc/idle"
  Obituary "$CFLegendaryBehemothObit"
  Tag "$CFLegBehe"
  var int user_heal;
  var int user_music;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LEG2 C 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	LEG2 CC 8 Bright A_Look
	LEGI CC 8 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LEG2 AABBCCDD 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,11)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
    TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
    LEG2 AABBCCDD 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	LEG2 EE 2 Bright A_Chase
	LEG2 FF 2 Bright A_Chase
	TNT1 A 0 A_Jump(35,"Teleport")
    Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20) 
	LEG2 AAAAA 0 A_Chase
	LEG2 A 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEG2 AAAAA 0 A_Chase
	LEG2 B 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEG2 AAAAA 0 A_Chase
	LEG2 C 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEG2 AAAAA 0 A_Chase
	LEG2 D 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	LEG2 AAAAA 0 A_Chase
	LEG2 E 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEG2 AAAAA 0 A_Chase
	LEG2 F 2 Bright A_SpawnItemEx("LBGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop   
  Teleport:
	LEG2 A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	LEG2 AAAAAAAAAA 1  A_FadeOut(0.1,0)
	LEG2 A 2 
	LEG2 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	LEG2 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LEG2 AAAAAAAAAA 1 A_FadeIn(0.1)
	LEG2 A 1 Bright A_SetShootable
	Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
	LEG2 G 0 ACS_NamedExecuteAlways("TakeResistance")
    //TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    //TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIfCloser(350,"BlueFlame")
	TNT1 A 0 A_Jump(156,"BFGG","Cannon","Combo","Floor")
	TNT1 A 0 A_Jump(26,"Proton")
  Normal:
    TNT1 A 0 A_PlaySound("LegendaryFat/Attack")
    LEG2 G 15 Bright A_FaceTarget    
    TNT1 A 0 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, -30, frandom(0, 6))
    LEG2 H 2 Bright A_CustomMissile("LegBehComet", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, 30, frandom(-12, -7))
    LEG2 H 6 Bright A_CustomMissile("LegBehComet", 30, -30, frandom(7, 12))
    LEG2 IG 8 Bright A_FaceTarget    
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, -30, frandom(0, 6))
    LEG2 H 2 Bright A_CustomMissile("LegBehComet", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, 30, frandom(-12, -7))
    LEG2 H 6 Bright A_CustomMissile("LegBehComet", 30, -30, frandom(7, 12))
    LEG2 IG 8 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, -30, frandom(0, 6))
    LEG2 H 2 Bright A_CustomMissile("LegBehComet", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("LegBehComet", 30, 30, frandom(-12, -7))
    LEG2 H 6 Bright A_CustomMissile("LegBehComet", 30, -30, frandom(7, 12))
    LEG2 IG 8 Bright A_Jump(48,"BFGG")
    Goto See
  BFGG:
	LEG2 G 1 Bright A_PlaySound("LegendaryFat/Sight")
	LEG2 G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LEG2 G 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/volattack")
	TNT1 A 0 A_PlayWeaponSound("weapons/bfgf")
    LEG2 GGGGGGGGG 4 A_FaceTarget
	LEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)  
	LEG2 H 0 A_CustomMissile("LegBehBFGBall", 30, 30, 0)
    LEG2 H 6 Bright A_CustomMissile("LegBehBFGBall", 30, -30, 0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
    LEG2 IG 8 Bright A_Jump(80,"Cannon")
    Goto See
  Cannon:
	LEG2 G 1 Bright A_PlaySound("LegendaryFat/Sight")
	LEG2 G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    LEG2 GG 2 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/charge")
    LEG2 GGGGGGGGG 4 Bright A_FaceTarget
	LEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CannonLoop2:
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/fire")
	TNT1 A 0 A_CustomMissile("LegBehCannonProj", 30, -30, frandom(0, 6))
    LEG2 H 2 Bright A_CustomMissile("LegBehCannonProj", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("LegBehCannonProj", 30, 30, frandom(-12, -7))
    LEG2 H 6 Bright A_CustomMissile("LegBehCannonProj", 30, -30, frandom(7, 12))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,3)
    LEG2 IG 8 Bright A_FaceTarget
	Goto CannonLoop2
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
    LEG2 IG 8 Bright A_Jump(80,"Floor")
    Goto See	
  Floor:
	TNT1 A 0 A_PlaySound("LegendaryFat/Attack")
    LEG2 G 15 Bright A_FaceTarget    
    TNT1 A 0 A_FaceTarget    
    TNT1 A 0 A_CustomMissile("LegBehFloorFire", 30, 30, 0)
    LEG2 H 8 Bright A_CustomMissile("LegBehFloorFire", 30, -30, 0)
    LEG2 IG 8 Bright A_FaceTarget      
    TNT1 A 0 A_CustomMissile("LegBehFloorFire", 30, 30, 0)
    LEG2 H 8 Bright A_CustomMissile("LegBehFloorFire", 30, -30, 0)
    LEG2 IG 8 Bright A_Jump(80,"Combo")
    Goto See
  Combo:
    TNT1 A 0 A_PlaySound("LegendaryFat/Attack")
    LEG2 G 8 Bright A_FaceTarget
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ComboLoop:
    LEG2 H 4 Bright A_CustomMissile("LegBehBall", 30, 30, 0)
    LEG2 IG 2 Bright A_FaceTarget
	LEG2 H 4 Bright A_CustomMissile("LegBehBall", 30, -30, 0)
    LEG2 IG 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto ComboLoop
	LEG2 I 0 A_Jump(80,"Proton")
    Goto See
  Proton:
	LEG2 G 1 Bright A_PlaySound("LegendaryFat/Sight")
	LEG2 G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    LEG2 GG 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/volattack")
	TNT1 A 0 A_PlayWeaponSound("legproton/load")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
    LEG2 GGGGGGGGG 4 Bright A_FaceTarget
	LEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_PlaySound("Petrovec/Fire",1)
	TNT1 A 0 A_PlaySound("Petrovec/AddFire",6)
	TNT1 A 0 A_PlaySound("Petrovec/Ambient",5)
	TNT1 A 0 A_CustomMissile("LehBehProntonBolt", 30, -30, frandom(0, 6))
    LEG2 H 2 Bright A_CustomMissile("LehBehProntonBolt", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("LehBehProntonBolt", 30, 30, frandom(-12, -7))
    LEG2 H 6 Bright A_CustomMissile("LehBehProntonBolt", 30, -30, frandom(7, 12))
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
    LEG2 IG 8 Bright A_Jump(80,"Floor")
    Goto See 
  BlueFlame:
	TNT1 A 0 A_Jump(148,"BFGG","Combo","Floor")
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LEG2 GG 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fatsofire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BlueFlameLoop:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LegBehFlame", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    LEG2 H 1 Bright A_CustomMissile("LegBehFlame", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,1)
	Goto BlueFlameLoop
	LEG2 IG 12 Bright
	Goto See	   
  Pain:	
	TNT1 A 0 A_Jump(45,"Teleport")
	TNT1 A 0 A_Jump(40,"Healing")
    TNT1 A 0 A_Jump(156,"PainMissile")
    LEG2 J 6 Bright A_Pain
    Goto See
  PainMissile:
    LEG2 J 6 Bright A_Pain
    Goto Missile
  Healing:
	TNT1 A 0 A_JumpIf(user_heal >= 3,"See")
    TNT1 A 0 A_PlaySoundEx("monsters/volsee","HEAL")
	TNT1 A 0 A_SetUserVar("user_effect_type",10)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetInvulnerable
	LEG2 J 0 A_SetUserVar("user_heal",user_heal+1)
	LEG2 J 2 Bright HealThing(300)
	TNT1 A 0 A_UnSetInvulnerable
	LEG2 J 2 Bright
    Goto See   
  Death:
	LEG2 K 6 A_StopSound(6)
	TNT1 A 0 A_Explode(24,64,0)
    LEG2 L 6 A_Scream
    TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LEG2 M 6 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
    TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LEG2 NOPQRS 6
    LEG2 T -1
    Stop
  }
}

Actor LegBehComet : Comet
{
  Scale 0.55
  Species "Fatsos"
  DamageType "Legendary"
  RenderStyle Add
  Damage (Random(50,75)) //15
  Alpha 0.85
  +SEEKERMISSILE
  +DOOMBOUNCE
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  BounceCount 3
  Speed 30
  Decal Scorch
  States
  {
  Spawn:
	LHTB AAAAABBBBBB 1 Bright A_SpawnItemEx("LegBehCometTail", 0, 0, 0, 0, 0, 0, 0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
  Fly:
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LHTB AAAAA 1 Bright A_SpawnItemEx("LegBehCometTail", 0, 0, 0, 0, 0, 0, 0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LHTB BBBBB 1 Bright A_SpawnItemEx("LegBehCometTail", 0, 0, 0, 0, 0, 0, 0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BCOM DE 3 Bright
	Stop
  }
}

Actor LegBehCometTail : CometTail
{
  Alpha 0.85
  Scale 0.75
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	LBHT ABCDE 2 Bright A_FadeOut(0.12)
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor LegBehCannonProj
{
  Radius 8
  Height 10
  Speed 70
  Damage (Random(75,125)) //25
  Scale 0.17
  Projectile 
  +SEEKERMISSILE 
  +RANDOMIZE
  +EXTREMEDEATH
  +DOOMBOUNCE
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  BounceCount 2
  DeathSound "lrball3/exp"
  DamageType "Legendary"
  Species "Fatsos"
  DamageType "Legendary"
  RenderStyle Add
  States
  {
  Spawn:
    LRB3 A 0
    LRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 AA 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LRB3 A 0 A_SeekerMissile(1,8,SMF_LOOK)
	LRB3 BB 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 CC 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	LRB3 DD 1 Bright A_SpawnItemEx("LegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 A 8 A_Explode(32,80,0)
    TNT1 A 6
    TNT1 A 4
    Stop
  }
}

Actor LegBehBFGBall : BFGBall
{
  +EXTREMEDEATH
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  DeathSound "lrball3/exp"
  Scale 1.4
  Speed 35
  Decal "BlueBFG9500Lightning"
  Species "Fatsos"
  DamageType "Legendary"
  States
  {
  Spawn:
    LTB1 A 0 A_CustomMissile("LegBehBFGBallTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	LTB1 AAA 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LTB1 B 0 A_CustomMissile("LegBehBFGBallTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	LTB1 BBB 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    Loop
  Death:
    TNT1 A 0 A_Explode(48,156,0)
	TNT1 A 0 A_PlaySound("lrball3/exp")
    LTB1 CDEF 4 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("lrball3/exp")
	TNT1 A 0 A_Explode(48,156,0)
    LTB1 CDEF 4 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("lrball3/exp")
	TNT1 A 0 A_Explode(48,156,0)
    LTB1 CDEF 4 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("lrball3/exp")
