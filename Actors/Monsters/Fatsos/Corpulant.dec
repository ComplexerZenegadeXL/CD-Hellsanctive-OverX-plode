Actor Corpulant : Hectebus
{  
  Health 1200 
  Radius 48
  Height 64 
  Mass 1000
  Speed 12
  PainChance 80
  Scale 1.1
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "BulletMagPickup" 256 10
  DropItem "BulletBoxPickup" 128
  DropItem "ExplosiveMinigunGiver" 90
  DamageFactor 0.7
  BloodColor "Red"
  Monster
  +FLOORCLIP 
  +DONTHURTSPECIES
  +MISSILEEVENMORE
  +BOSSDEATH
  SeeSound "monsters/volsee"
  PainSound "monsters/volpain"
  DeathSound "monsters/voldeath"
  ActiveSound "manc/idle"
  Obituary "$CFCorpulantObit"
  Tag "$CFCorpul"
  States
  {
  Spawn:
    FOFO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	FOFO A 7 A_Look
    Loop
  See:
    FOFO ABCDDEF 4 A_Chase
    Loop
  Missile:
    TNT1 A 0 A_Jump(32,"Missile2")
	TNT1 A 0 A_PlaySound("mosnters/volattack")
	FOFO GG 10 Bright A_FaceTarget
	FOFO G 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpidRefire
	FOFO H 3 Bright A_CustomMissile("MancutankExplosiveTracer",36,33,frandom(-8,8),0)	
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-80, -90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpidRefire
	FOFO I 4 Bright A_CustomMissile("MancutankExplosiveTracer",36,-33,frandom(-8,8),0)
	TNT1 A 0 A_StopSoundEx("Weapon")
    TNT1 A 0 A_SpidRefire
    Goto Missile+3
  Missile2:
	FOFO E 15 Bright
	TNT1 A 0 A_FaceTarget
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 0)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 5)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -5)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 15)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -15)
    FOFO F 15 Bright
	TNT1 A 0 A_FaceTarget
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 25)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -25)
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 35)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -35)
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 45)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -45)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 55)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -55)
    FOFO E 15 Bright
	TNT1 A 0 A_FaceTarget
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 65)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -65)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 75)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -75)
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 85)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -85)
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 95)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -95)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 105)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -105)
    FOFO F 15 Bright
	TNT1 A 0 A_FaceTarget
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 115)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -115)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 125)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -125)
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 135)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -135)
	FOFO E 15 Bright
	TNT1 A 0 A_FaceTarget
	FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 145)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -145)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 155)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -155)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 165)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -165)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, 175)
    FOFO A 0 A_CustomMissile("HellbornFireSpawner", 32, 0, -175)
	FOFO A 10  A_FadeOut(0.1,0)
	FOFO BCDEFBCDEF 1 A_Wander
	TNT1 A 0 A_FaceTarget
    FOFO A 1 A_PlayWeaponSound("boss/teleport")
	FOFO A 10 A_FadeIn(0.1)
	Goto See
  Pain:
    FOFO J 3
    FOFO J 3 A_Pain
	TNT1 A 0 A_Jump(20,"Missile2")
    Goto See
  Death:
    FOFO K 6
    FOFO L 6 A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FOFO M 6 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FOFO NOPQRS 6
    FOFO T -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    FOFO SRQPONMLK 6
    Goto See
  }
}

Actor HellbornFireSpawner
{
  Radius 5
  Height 5
  Speed 20
  FastSpeed 25
  Damage 0
  +RIPPER
  +FLOORHUGGER
  +BLOODLESSIMPACT
  +THRUSPECIES
  +DONTHARMSPECIES
  Species "Fatsos"
  DamageType "BeheComet"
  Obituary "$CFHellbornFireSpawnerObit"
  Projectile
  States
  {
  Spawn: 
    TNT1 AAAA 1 Bright A_Weave(3,0,1.0,0.0)
	TNT1 A 1 Bright A_SpawnItemEx("BehemothFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    Loop
  Death:  
    TNT1 A 1
    Stop
  }
}

Actor BehemothFire : PyroFire { Species "Fatsos" DamageType "BeheComet" }