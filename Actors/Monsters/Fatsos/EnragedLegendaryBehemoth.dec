Actor EnragedLegendaryBehemoth : LegendaryBehemoth
{
  Health 3100
  PainChance 25
  Scale 1.3
  Speed 11
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.55
  BloodColor "Red"
  Species "Fatsos"
  +THRUSPECIES
  +NOTARGET
  Mass 4500
  SeeSound "FreezerBehe/Sight"
  PainSound "FreezerBehe/Pain"
  DeathSound "FreezerBehe/Death"
  ActiveSound "manc/idle"
  DropItem "EnragedLegendarySphere" 90
  DropItem "ILDemonAmmoBoxPickup" 256 
  DropItem "ILDemonAmmoPickup" 256 
  DropItem "LegendaryBossLifeEssence" 256 
  DropItem "LegendaryBossArmorBonusMax" 256 
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "LegendaryBossLifeEssence" 32
  DropItem "LegendaryBossArmorBonusMax" 32
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 125
  DropItem "LegendaryPowerSphere" 144
  DropItem "LegendaryTimeFreezeSphere" 95
  DropItem "HSBFGupgrade" 12
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFEnragedLegendaryBehemothObit"
  Tag "$CFEnrBehe"
  var int user_delay;
  States
  {
  Spawn:
	EEG2 C 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
	EEG2 CC 8 A_Look
	EEGI CC 8 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EEG2 AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,411)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
    TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
    EEG2 AABBCCDDEEFF 2 A_Chase
	TNT1 A 0 A_Jump(35,"Teleport")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	EEG2 AAAAA 0 A_Chase
	EEG2 A 2 A_SpawnItemEx("EBGhost")
	EEG2 AAAAA 0 A_Chase
	EEG2 B 2 A_SpawnItemEx("EBGhost")
	EEG2 AAAAA 0 A_Chase
	EEG2 C 2 A_SpawnItemEx("EBGhost")
	EEG2 AAAAA 0 A_Chase
	EEG2 D 2 A_SpawnItemEx("EBGhost")
	TNT1 A 0 A_SpawnItemEx("LegendaryBeefyStep",0,0,5,0,0,-20)
	EEG2 AAAAA 0 A_Chase
	EEG2 E 2 A_SpawnItemEx("EBGhost")
	EEG2 AAAAA 0 A_Chase
	EEG2 F 2 A_SpawnItemEx("EBGhost")
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop   
  Teleport:
	EEG2 A 1 A_UnSetShootable
	EEG2 AAAAA 1  A_FadeOut(0.2,0)
	EEG2 A 2 
	EEG2 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	EEG2 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	EEG2 AAAAA 1 A_FadeIn(0.2)
	EEG2 A 1 A_SetShootable
	Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfCloser(350,"NotBlueFlame")
	TNT1 A 0 A_Jump(44,"Hellstorm")
	TNT1 A 0 A_Jump(156,"BFGG","Cannon","Spikes","Floor")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/volattack")
    EEG2 G 15 A_FaceTarget
    TNT1 A 0 A_FaceTarget
  CometLoop:
	TNT1 A 0 A_JumpIf(user_delay >= 5,"CometEnd")
    TNT1 A 0 A_CustomMissile("ELegBehComet", 30, -30, frandom(0, 6))
    EEG2 H 2 A_CustomMissile("ELegBehComet", 30, 30, frandom(-6,0))
    TNT1 A 0 A_CustomMissile("ELegBehComet", 30, 30, frandom(-12,-7))
    EEG2 H 4 A_CustomMissile("ELegBehComet", 30, -30, frandom(7, 12))
    EEG2 IG 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  CometEnd:
	TNT1 A 0 A_SetUserVar(user_delay,0)
    EEG2 IG 8 A_Jump(48,"BFGG")
    Goto See
  BFGG:
	EEG2 G 1 A_PlaySound("FreezerBehe/Sight")
	EEG2 G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    EEG2 G 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/volattack")
	TNT1 A 0 A_PlayWeaponSound("weapons/bfgf")
  BFGGCharge:
	TNT1 A 0 A_JumpIf(user_delay >= 18,"BFGGFire")
    EEG2 G 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  BFGGFire:
	TNT1 A 0 A_SetUserVar(user_delay,0)
	EEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	EEG2 H 0 A_CustomMissile("EnragedBFG9500B",30,30)
    EEG2 H 6 A_CustomMissile("EnragedBFG9500B",30,-30)
    EEG2 IG 8 A_Jump(80,"Cannon")
    Goto See
  Cannon:
	EEG2 G 1 A_PlaySound("FreezerBehe/Sight")
	EEG2 G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    EEG2 G 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/volattack")
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/charge")
  CannonCharge:
	TNT1 A 0 A_JumpIf(user_delay >= 18,"CannonLoop")
	EEG2 G 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  CannonLoop:
	TNT1 A 0 A_JumpIf(user_delay >= 23,"CannonEnd")
	EEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/fire")
	TNT1 A 0 A_CustomMissile("ELegBehCannonProj", 30, -30, frandom(0, 6))
    EEG2 H 2 A_CustomMissile("ELegBehCannonProj", 30, 30, frandom(-6, 0))	   
    TNT1 A 0 A_CustomMissile("ELegBehCannonProj", 30, 30, frandom(-32, -25))
    EEG2 H 6 A_CustomMissile("ELegBehCannonProj", 30, -30, frandom(25, 32))
    EEG2 IG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  CannonEnd:
	TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
    EEG2 IG 8 A_Jump(80,"Floor")
    Goto See	
  Floor:
	TNT1 A 0 A_PlaySound("monsters/volattack")
    EEG2 GGGG 10 A_FaceTarget   
  FloorLoop:
	TNT1 A 0 A_JumpIf(user_delay >= Random(2,4),"FloorEnd")
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,22)
    TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,45)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,67)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,90)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,112)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,135)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,157)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,180)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-157)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-135)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-112)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-90)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-67)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-45)
	TNT1 A 0 A_CustomMissile("EnragedStompFireSpawner",30,0,-22)
    EEG2 H 8 A_CustomMissile("EnragedStompFireSpawner",30)
    EEG2 IG 8 A_FaceTarget    
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  FloorEnd:
	TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    EEG2 GG 8
    Goto See 
  NotBlueFlame:
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	EEG2 GG 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fatsofire")
  BlueFlameLoop:
	TNT1 A 0 A_JumpIf(user_delay >= 21,"BlueFlameEnd")
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ELegBehFlame", 30, 30, frandom(6, -6), CMF_AIMOFFSET)
    EEG2 H 1 A_CustomMissile("ELegBehFlame", 30, -30, frandom(6, -6), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  BlueFlameEnd:
	TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_Jump(128,"BFGG","Spikes")
	EEG2 IG 12
	Goto See
  Spikes:
	TNT1 A 0 A_PlaySound("EnragedBehemoth/Attack",0,1,0,ATTN_NONE)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("EnragedSpike",frandom(-512,512),frandom(-512,512), 0, 0, 0, 0, 0, 34, 0)
	EEG2 GGGGGGGHHIIGGGG 4 A_FaceTarget
	Goto See
  Hellstorm:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("EnragedBehemoth/Attack",0,1,0,ATTN_NONE)
	TNT1 A 0 A_Jump(128,"StreetSweeperCharge")
  HellstormCharge:
	TNT1 A 0 A_JumpIf(user_delay >= 23,"HellstormFire")
	EEG2 G 0 A_FaceTarget
    EEG2 G 2 A_SpawnItemEx("LHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  HellstormFire:
	TNT1 A 0 A_JumpIf(user_delay >= 28,"HellstormFire2")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_CustomMissile("EHSShot", 30, 30, frandom(-6, 6))
	EEG2 H 4 A_CustomMissile("EHSShot", 30, -30, frandom(-6, 6))
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	EEG2 IG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  HellstormFire2:
	TNT1 A 0 A_JumpIf(user_delay >= 31,"FloorEnd")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_CustomMissile("EHSShot", 30, 30, frandom(-32, -25))
    TNT1 A 0 A_CustomMissile("EHSShot", 30, -30, frandom(25, 32))
	TNT1 A 0 A_CustomMissile("EHSShot", 30, 30, frandom(-6, 6))
	EEG2 H 4 A_CustomMissile("EHSShot", 30, -30, frandom(-6, 6))
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	EEG2 IG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StreetSweeperCharge:
	TNT1 A 0 A_JumpIf(user_delay >= 25,"StreetSweeperFire")
	EEG2 G 0 A_FaceTarget
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
    EEG2 G 2 A_SpawnItemEx("LHellionSmokeSpawner",random(-24,24),random(-24,24))
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StreetSweeperFire:
	TNT1 A 0 A_JumpIf(user_delay >= 28,"StreetSweeperFire2")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,-20)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,-40)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,20)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,40)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,-20)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,-40)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,20)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,40)
	EEG2 H 4 A_CustomMissile("EBehe15K", 30, -30)
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	EEG2 IG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StreetSweeperFire2:
	TNT1 A 0 A_JumpIf(user_delay >= 31,"StreetSweeperFire3")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,-15)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,-30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,-45)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,15)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, 30,45)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,-15)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,-30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,-45)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,15)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,30)
	TNT1 A 0 A_CustomMissile("EBehe15K", 30, -30,45)
	EEG2 H 4 A_CustomMissile("EBehe15K", 30, -30)
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	EEG2 IG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StreetSweeperFire3:
	TNT1 A 0 A_PlayWeaponSound("Cardinal/9k")
  StreetSweeperFinalCharge:
	TNT1 A 0 A_JumpIf(user_delay >= 49,"StreetSweeperFinal")
	EEG2 G 0 A_FaceTarget
    EEG2 G 2 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24))
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StreetSweeperFinal:
	TNT1 A 0 A_SetUserVar(user_delay,0)
	EEG2 G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	EEG2 H 0 A_CustomMissile("EnragedBFG9500B",30,30,-20)
    EEG2 H 0 A_CustomMissile("EnragedBFG9500B",30,-30,20)
	EEG2 H 0 A_CustomMissile("EnragedBFG9500B",30,30,20)
    EEG2 H 0 A_CustomMissile("EnragedBFG9500B",30,-30,-20)
	EEG2 H 0 A_CustomMissile("EnragedBehemothDTBFG10KBall",30,30)
    EEG2 H 6 A_CustomMissile("EnragedBehemothDTBFG10KBall",30,-30)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    EEG2 IG 15
    Goto See
  Pain:
	TNT1 A 0 A_Jump(45,"Teleport")
    EEG2 J 6 A_Pain
	TNT1 A 0 A_Jump(156,"Missile")
    Goto See
  Death:
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	EEG2 K 6 A_StopSound(6)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("EnragedSpike",frandom(-512,512),frandom(-512,512), 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION,0)
    EEG2 L 6 A_Scream
    TNT1 A 0 A_SpawnItemEx("EnragedGibbedGenerator")
    EEG2 M 6 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
    TNT1 A 0 A_SpawnItemEx("EnragedGibbedGenerator")
    EEG2 NOPQRS 6
    EEG2 T -1
    Stop
  }
}

Actor ELegBehComet : LegBehComet
{
  Damage (Random(70,100)) //19
  Scale 1.2
  Alpha 1.0
  Renderstyle Normal
  States
  {
  Spawn:
	ENCM AAAAAABBBBBBCCCCCCDDDDDD 1 Bright A_SpawnItemEx("ELNCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
  Fly:
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	ENCM AAAAABBBBBB 1 Bright A_SpawnItemEx("ELNCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	ENCM CCCCCCDDDDDD 1 Bright A_SpawnItemEx("ELNCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	ENCM EFGHI 3 Bright
	Stop
  }
}

Actor ELegBehCannonProj : EnragedCYNCannonProj { Species "Fatsos" DamageType "Legendary" }

Actor EBehe15K : ELegSoul15K { Species "Fatsos" DamageType"Legendary" }

Actor EnragedBFG9500B : EnragedBFG9500 { Species "Fatsos" DamageType "Legendary" }

Actor EBGhost : LBGhost
{
  Scale 1.3
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    EEG2 CCCCCCCCCC 2 A_FadeOut(0.09)
    Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor ELegBehFlame : ELegFiendFlameBreath { Species "Fatsos" DamageType "Legendary" }	

Actor EHSShot
{
  Radius 16
  Height 16
  Damage (Random(100,200)) //30
  Speed 32
  Scale 0.6
  RenderStyle Translucent
  Alpha 0.95
  Projectile
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +SKYEXPLODE
  +THRUSPECIES
  +NOTIMEFREEZE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Renderstyle Add
  Alpha 0.75
  Species "Fatsos"
  DamageType "Legendary"
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("EnragedBeheDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))	
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("EnragedBeheDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))	
	TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE) 	
	EFS3 A 4 A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("EnragedBeheDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))	
