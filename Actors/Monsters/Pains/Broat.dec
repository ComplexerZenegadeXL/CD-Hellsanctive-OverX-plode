Actor Broat : SoulKeeper
{
  Monster
  Health 900
  Height 45
  Radius 31
  Mass 900
  Speed 17
  FloatSpeed 7
  PainChance "Mine", 128
  PainChance "SatanGuard", 0
  PainChance "BloodElemental", 0
  PainChance "Wicked", 0
  PainChance 80
  +NOBLOOD
  +FLOORCLIP
  +FLOAT
  +NOGRAVITY
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  DamageType "Broat"
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  //No Infighting
  DamageFactor "Broat", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "EleSouls", 0.0
  DamageFactor "CacoComet", 0.0
  DropItem "LifeEssence", 200, 13
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  SeeSound "broat/sight"
  ActiveSound "broat/active"
  PainSound "broat/pain"
  DeathSound "broat/death"
  Obituary "$CFBroatObit"
  Tag "$CFBroat"
  var int user_lowlag;
  States
  {
  Spawn:
	CORS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CORS A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CORS AABBAABBAABB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	CORS AABBAABBAABB 2 A_Chase
	TNT1 A 0 A_Jump(80,"Rush")
	Loop
  Rush:
	TNT1 AA 0 A_Chase
	CORS A 1 A_PlaySound("PDD/blur")
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 AA 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0) 
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1  
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS A 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0) 
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	CORS B 1 
	TNT1 AA 0 A_Chase
	TNT1 A 0 A_SpawnItem("DSFX3",0,0)
	TNT1 A 0 A_Jump(96,"See")
	Goto Rush
  Melee:
  Missile:
	TNT1 A 0 HealThing(5)
	TNT1 A 0 A_Jump(85,"Spread")
  Normal:
	CORS B 5 A_FaceTarget
	CORS C 2 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("BroatHomer",39,0,0)
	CORS B 8
	Goto See
  Spread:
	CORS B 5 A_FaceTarget
	CORS C 2 Bright A_FaceTarget
	CORS CCCCCC 1 Bright A_CustomMissile("BROATPL",32,frandom(-17.0,17.0),frandom(-5,5),0,frandom(-5,5))
	CORS B 15
	Goto See
  Pain:
	CORS A 2
	CORS A 2 A_Pain
	Goto See
  Death:
	CORS D 6 A_Scream
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	TNT1 A 0 A_PainDie("SummonedWicked")
	TNT1 AAA 0 A_CustomMissile("Kaboom3",35,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",35,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	CORS GH 4
	TNT1 A 0 A_Fall
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	CORS I 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",12,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)	
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	CORS JK 3
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,0)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	CORS L -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,0)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	CORS LKJIHGD 5
	Goto See
  }
}

Actor SummonedBroat : Broat { Tag "$CFSBroat" -COUNTKILL }

Actor BroatPL : CFNewImpBall
{
  Projectile
  Height 2
  Radius 2
  Speed 5
  Damage (Random(6,16))
  +RANDOMIZE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Species "PainElemental"
  DamageType "Broat"
  DeathSound "Hellion/balldth"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ThrustThingZ(0,random(5,-5),0,0)
	TNT1 A 0 A_ScaleVelocity(50.0)
  SLoop:
	BAL1 AB 1 Bright A_SpawnItemEx("ImpBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)	
	Loop
  }
}

Actor BroatHomer : WickedHomer
{
  Damage (Random(16,32))
  Species "PainElemental"
  DamageType "Broat"
}

Actor DSFX3
{
  Projectile
  Height 2
  Radius 2
  Speed 0
  RenderStyle Translucent
  Alpha 0.9
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 3
	CORS A 3 A_FadeOut(0.1,1)
	Wait
  }
}