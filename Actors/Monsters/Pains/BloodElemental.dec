Actor BloodElemental : SoulKeeper
{
  Monster
  Health 450
  Height 56
  Radius 30
  Mass 400
  Speed 7
  FloatSpeed 4
  Scale 1.2
  PainChance "Mine", 128
  PainChance "SatanGuard", 0
  PainChance "Broat", 0
  PainChance "Wicked", 0
  PainChance 76
  +FLOAT
  +NOGRAVITY
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  //No Infighting
  DamageFactor "BloodElemental", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "Broat", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "EleSouls", 0.0
  DamageFactor "CacoComet", 0.0
  DropItem "LifeEssence", 200, 13
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  SeeSound "grell/sight"
  ActiveSound "grell/active"
  PainSound "grell/pain"
  DeathSound "grell/death"
  Obituary "$CFBloodElementalObit"
  Tag "$CFBloodElem"
  var int user_currenthp;
  States
  {
  Spawn:
	GREL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	GREL A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_SetSolid
	GREL AAABBBCCCAAABBBCCC 1 A_Chase
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	Loop
  Melee:
  Missile:
	TNT1 A 0 A_SetSolid
	GREL A 1 A_Jump(128,"BloodSpit","Normal")
	TNT1 A 0 A_Jump(89,"Wicked","BabyWatcher","Cruel")
  Normal:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInventory("Tic",10,"BloodSpit")
	GREL D 4 A_FaceTarget
	GREL EF 3 Bright A_FaceTarget
	TNT1 A 0 A_DualPainAttack("SummonedBloodSkull")
	TNT1 A 0 A_GiveInventory("Tic",1)
	GREL ED 8
	Goto See
  BloodSpit:
	GREL D 3 A_FaceTarget
	GREL EF 2 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BloodSpit",47,9,0)
	TNT1 A 0 A_CustomMissile("BloodSpit",47,-9,0)
	TNT1 A 0 A_TakeInventory("Tic",1)
	GREL ED 4
	Goto See
  Wicked:
	TNT1 A 0 A_JumpIfInventory("Tic",10,"BloodSpit")
	GREL D 4 A_FaceTarget
	GREL EF 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedWicked")
	TNT1 A 0 A_GiveInventory("Tic",1)
	GREL EDD 4
	Goto See
  BabyWatcher:
	TNT1 A 0 A_JumpIfInventory("Tic",10,"BloodSpit")
	GREL D 4 A_FaceTarget
	GREL EF 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedBabyWatcher")
	TNT1 A 0 A_GiveInventory("Tic",1)
	GREL EDD 4
	Goto See
  Cruel:
	TNT1 A 0 A_JumpIfInventory("Tic",10,"BloodSpit")
	GREL D 4 A_FaceTarget
	GREL EF 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedCruel")
	TNT1 A 0 A_GiveInventory("Tic",1)
	GREL EDD 4
	Goto See
  Pain:
	GREL G 3
	GREL G 3 A_Pain
	"####" "#" 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	"####" "#" 1 HealThing(((user_currenthp - Health)*0.75)+1)
	"####" "#" 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_TakeInventory("Tic",1)
	Goto See
  Death.PlayerIce:
    "####" "#" 0 A_PainDie("SummonedBloodSkull")
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  XDeath:
  Death:
	GREL H 1 A_ChangeFlag(FLOATBOB,0)
	GREL H 1 A_Scream
	GREL H 1 A_SpawnItemEx("GibbedGenerator",0,0,44,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	GREL H 1 A_PainDie("SummonedBloodSkull")
	GREL I 1 A_Fall
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	GREL I 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",12,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)	
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,44)
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,0)
	GREL J 4 A_PlaySound("grell/thud",CHAN_AUTO)
	GREL KLM 4
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	GREL N -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,0)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	GREL MLKJIH 5
	Goto See
  }
}

Actor SummonedBloodElemental : BloodElemental { Tag "$CFSBloodElem" -COUNTKILL }

Actor BloodSpit
{
  Projectile
  Height 6
  Radius 6
  Speed 34
  Scale 0.5
  Mass 1
  Gravity 0.02
  Decal "BloodSplat"
  ReactionTime 88
  Damage (Random(9,12))
  -NOGRAVITY
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "PainElemental"
  DamageType "BloodElemental"
  SeeSound "Blood/Spit"
  DeathSound "Blood/Impact"
  States
  {
  Spawn:
	BSHT AABB 1 A_CustomMissile("NewFlyingBlood",0,0,180,2)
	TNT1 A 0 A_Countdown
	Loop
  Crash:
  Death:
	BSHT C 2 A_SetGravity(0.1)
	BSHT C 4
	BSHT D 6 
	Stop
  XDeath:
	BSHT C 2
	TNT1 AAA 0 A_CustomMissile("BloodSpitExplode",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("NewFlyingBlood",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BSHT C 4
	BSHT D 6 
	Stop
  }
}

Actor BloodSpitExplode : RedBloodCloud { Scale 0.4 }
Actor SummonedWicked : Wicked
{
  -COUNTKILL
  -NOINFIGHTING
  Tag "$CFSWick"
}
Actor SummonedCruel : Cruel
{
  -COUNTKILL
  -NOINFIGHTING
  Tag "$CFSCruel"
}
Actor SummonedBloodSkull : BloodSkull2
{
  -COUNTKILL
  -NOINFIGHTING
  Tag "$CFSblSkull"
}
Actor SummonedBabyWatcher
{ 
  Monster 
  Health 150
  Radius 24
  Height 40 
  Mass 150 
  Speed 7
  FloatSpeed 7
  FastSpeed 7
  Bloodcolor "Green"
  ReactionTime 23
  PainChance "SatanGuard", 0
  PainChance "BabyWatcher", 0
  PainChance "BloodElemental", 0
  PainChance "Broat", 0
  PainChance 160
  MeleeRange 40
  MeleeDamage 4
  ReactionTime 17
  +FLOAT
  +NOGRAVITY
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  -COUNTKILL
  -NOINFIGHTING
  Species "PainElemental"
  DamageType "BabyWatcher"
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor 0.75
  //No Infighting
  DamageFactor "BabyWatcher", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "Broat", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "EleSouls", 0.0
  DropItem "LifeEssence", 180, 4
  DropItem "CFArmorBonusMax5", 180
  SeeSound "observer/see" 
  ActiveSound "observer/idle" 
  AttackSound "caco/melee"
  PainSound "observer/pain" 
  DeathSound "observer/death" 
  Obituary "$CFSummonedBabyWatcherObit"
  Tag "$CFSummBWatch"
  States 
  { 
  Spawn: 
	OBVS A 10 A_Look
	Loop 
  See:
	OBVS AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	OBVS AAA 0 A_FastChase
	Loop 
  Missile:
	TNT1 A 0 A_Jump(80,"Tracer")
	OBVS EFG 4 Bright A_FaceTarget 
	OBVS G 1 Bright A_CustomMissile("ObserverShot",12,0,0) 
	OBVS DBCA 4
	Goto See
  Tracer:
	OBVS ABEFG 3 Bright A_FaceTarget 
	OBVS G 1 Bright A_CustomMissile("WatcherTracer",12,0,0) 
	OBVS DBCA 4
	Goto See
  Melee:
	OBVS BCDCBA 3 A_FaceTarget
	OBVS A 0 A_MeleeAttack
	OBVS A 2
	Goto See
  Pain:
	OBVS H 3 
	OBVS H 3 A_Pain 
	Goto See
  XDeath:
  Death: 
	TNT1 A 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_PlaySound("Gore/Splat")
	OBVS I 4 A_Scream
	OBVS JK 3
	TNT1 A 0 A_Fall
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	OBVS L 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)	
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	OBVS MN 3
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	OBVS O 525
  Fade:
	OBVS O 5 A_FadeOut(0.1,1)
	Loop
  }
}