Actor LegendaryTormentor 16508
{
  //$Category Monsters/LCA
  //$Sprite LPAIA1
  //$Title "Legendary Tormentor"
  Monster
  Health 1600
  Radius 31
  Height 56
  Mass 400
  Speed 12
  PainChance 28
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +NOINFIGHTING
  +BOSS
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +NOTELEFRAG
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NORADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  BloodColor "Blue"
  Species "PainElemental"
  DamageType "Legendary"
  DamageFactor 0.65
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.110
  DamageFactor "PlayerDevBall2", 0.110
  DamageFactor "PlayerDevTracer", 0.110
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryPowerSphere" 75 1
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LDemonAmmoPickup" 256
  DropItem "LDemonAmmoBoxPickup" 256
  DropItem "LegendaryTimeFreezeSphere" 80 1
  DropItem "LegendarySphere" 150 1
  //DropItem "LegendaryPlasmaticRifleGiver" 190 1
  DropItem "LegendaryRandomSphere" 16 1
  SeeSound "legbanished/see"
  PainSound "legbanished/pain"
  DeathSound "legbanished/death"
  ActiveSound "legbanished/idle"
  Obituary "$CFLegendaryTormentorObit"
  Tag "$CFLegTorm"
  Scale 0.85
  var int user_delay;
  var int user_portal;
  var int user_timer;
  var int user_music;
  var int user_souls;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LPAI A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    LPAI A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LPAI AAABBB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,20)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
    LPAI AAA 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    LPAI BBB 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    LPAI CCC 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    Loop
  Rush:
    TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LPAI AA 0 A_Chase
    LPAI A 1 Bright A_SpawnItemEx("LegendaryBanishedGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Jump(12,"See")
	LPAI AA 0 A_Chase
    LPAI B 1 Bright A_SpawnItemEx("LegendaryBanishedGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Jump(12,"See")
	LPAI AA 0 A_Chase
    LPAI C 1 Bright A_SpawnItemEx("LegendaryBanishedGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Jump(12,"See")	
    Loop
  Avoid:
	LPAI G 0
	LPAI G 0 A_SetAngle(angle+frandom(0,359))
	LPAI G 0 A_Recoil(-50)
	LPAI G 0 A_FaceTarget
	LPAI GGGGGGGGGGGGG 1 A_SpawnItemEx("LegendaryBanishedGhost2")
	TNT1 A 0 A_Jump(155,"See")
	LPAI G 1 A_Stop
    Goto Avoid
  Teleport:
    LPAI A 1 A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LPAI AAAAAAAAAAA 1 A_FadeOut(0.1,0)
	LPAI AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LPAI A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LPAI AAAAAAAAAAA 1 A_FadeIn(0.1)
    LPAI A 1 A_SetShootable
    Goto See
  Missile:	
    TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_Jump(32,"Portal","Laser","LegSoulProj")
    TNT1 A 0 A_Jump(128,"Souls","StormShot","Combo","Barrage","SoulAttack")
  Normal:
    LPAI JJJJ 2 Bright A_FaceTarget 
    LPAI K 0 A_CustomMissile("LegBanBall1",92,-40,0,0)
    LPAI K 0 A_CustomMissile("LegBanBall1",8,-40,0,0)
    LPAI K 0 A_CustomMissile("LegBanBall1",92,40,0,0)
    LPAI K 0 A_CustomMissile("LegBanBall1",8,40,0,0)
    LPAI K 0 A_CustomMissile("LegBanBall1",54,-50,0,0)
    LPAI K 4 Bright A_CustomMissile("LegBanBall1",54,50,0,0)
    LPAI J 4 Bright A_FaceTarget 
	TNT1 A 0 A_Jump(128,"Avoid","Normal","Souls")
    Goto See	
  Souls:
    LPAI D 0 A_JumpIf(user_souls >= 4,"StormShot")
    LPAI DE 4 Bright A_FaceTarget
    LPAI FFFF 3 Bright A_PainAttack("BanTerrorSoul")
	LPAI F 2 Bright A_FaceTarget
	LPAI FFF 3 Bright A_PainAttack("BanForgottenOne")
	LPAI F 2 Bright A_FaceTarget
	LPAI FFF 3 Bright A_PainAttack("BanPoisonSoul")
	LPAI F 2 Bright A_FaceTarget
	LPAI FF 3 Bright A_PainAttack("BanRictus")
	TNT1 A 0 A_SetUserVar("user_souls",user_souls+1)
    Goto See
  StormShot:
    LPAI DE 4 Bright A_FaceTarget
	LPAI F 0 A_PlayWeaponSound("legbanished/attack2")
    LPAI F 4 Bright A_CustomMissile("LegBanBall2",43,0,0,0,0)
	TNT1 A 0 A_Jump(148,"Avoid","SoulAttack")
    Goto See
  SoulAttack:
    LPAI DE 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SoulAttckLoop:
    LPAI F 4 Bright A_CustomMissile("LegBanLostSoul",43,0,0,0,0)
	LPAI F 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	TNT1 A 0 A_Jump(148,"Avoid","Combo")
    Goto See
  Combo:
    LPAI JJ 4 Bright A_FaceTarget 
    LPAI K 0 A_CustomMissile("LegBanBall4",92,-40,frandom(-3,3))
    LPAI K 0 A_CustomMissile("LegBanBall4",8,-40,frandom(-3,3))
    LPAI K 0 A_CustomMissile("LegBanBall4",92,40,frandom(-3,3))
    LPAI K 0 A_CustomMissile("LegBanBall4",8,40,frandom(-3,3))
    LPAI K 0 A_CustomMissile("LegBanBall4",54,-50,frandom(-3,3))
    LPAI K 3 Bright A_CustomMissile("LegBanBall4",54,50,frandom(-3,3))
	TNT1 A 0 A_Jump(8,"Avoid","See","Barrage")
	LPAI J 0 A_CPosRefire
    LPAI J 3 Bright A_FaceTarget 
    Goto Combo+5
  Barrage:
    LPAI D 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",15)
	LPAI D 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("legbanished/see")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
    LPAI DE 6 Bright A_FaceTarget
	LPAI FF 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-10)
  BarrageLoop:
	LPAI F 0 A_CustomMissile("LegBanBall3",43,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,2)
	TNT1 A 0 A_Jump(256,"BarrageLoop")
	LPAI FE 3 Bright A_FaceTarget
	LPAI D 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LPAI D 3 Bright A_FaceTarget
	TNT1 A 0 A_Jump(48,"Laser")
	TNT1 A 0 A_Jump(148,"Avoid")
	Goto See
  Laser:
    LPAI G 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",15)
	LPAI G 0 A_FaceTarget
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
	TNT1 A 0 A_PlaySound("legbanished/pain",CHAN_AUTO,1.0,False,ATTN_NONE)
    LPAI GG 6 Bright A_FaceTarget
    LPAI HHHHHHHHHH 6 Bright A_FaceTarget
	LPAI D 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_PlaySound("legbanished/see",CHAN_AUTO,1.0,False,ATTN_NONE)
	LPAI I 0 A_FaceTarget
	LPAI IIII 4 Bright A_CustomMissile("LegBanishedLaserBeam",43,0,0)
	LPAI I 0 A_FaceTarget
	LPAI IIII 4 Bright A_CustomMissile("LegBanishedLaserBeam",43,0,0)
	LPAI I 0 A_FaceTarget
	LPAI IIII 4 Bright A_CustomMissile("LegBanishedLaserBeam",43,0,0)
	LPAI I 0 A_FaceTarget
	LPAI IIII 4 Bright A_CustomMissile("LegBanishedLaserBeam",43,0,0)
	TNT1 A 0 A_Jump(48,"LegSoulProj")
	TNT1 A 0 A_Jump(148,"Teleport")
	Goto See
  LegSoulProj:
    LPAI G 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LPAI G 0 A_FaceTarget
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
	TNT1 A 0 A_PlaySound("legbanished/pain",CHAN_AUTO,1.0,False,ATTN_NONE)
    LPAI GGG 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
    LPAI HHHHHHHHHH 6 Bright A_FaceTarget
	LPAI D 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LPAI I 0 A_FaceTarget
	LPAI I 4 Bright A_CustomMissile("LegendarySoulProj",3,0,0)
	TNT1 A 0 A_Jump(148,"Teleport")
	Goto See
  Portal:
    TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	LPAI E 1 Bright A_JumpIf(user_portal > 1,"Missile")
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LPAI E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
    LPAI EF 6 Bright A_FaceTarget
	LPAI G 0 A_SetUserVar("user_delay",0)
	LPAI G 0 A_Stop
	LPAI G 3 Bright A_SpawnItemEx("LegBanPortal",64,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
  PortalCharge:
	LPAI G 0 A_JumpIf(user_delay >= 145,"PortalDone")
	LPAI G 0 A_SetUserVar("user_delay",user_delay+1)
	LPAI G 0 HealThing(random(2,3))
	LPAI G 3 Bright A_Stop
	Loop
  PortalDone:
	LPAI G 3 Bright A_FaceTarget
	LPAI G 0 A_SetUserVar("user_portal",1)
	LPAI G 0 A_Jump(127,"Teleport")
	Goto See
  Pain:
    TNT1 A 0 A_SetUserVar("user_effect_type",14)
	//TNT1 A 0 A_KillChildren
    TNT1 A 0 A_Jump(8,"Barrage")	
  	TNT1 A 0 A_Jump(21,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile")
    LPAI L 2 Bright
    LPAI L 2 Bright A_Pain
    Goto See
  PainMissile: 
    LPAI L 2 Bright
    LPAI L 2 Bright A_Pain
    Goto Missile
  Death:
    LPAI M 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LPAI NNNNNNNNNNNNN 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI OOOOOOOOOOOOO 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	LPAI P 0 A_KillChildren
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI PPPPPPP 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI QQQQQQQ 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI RRRRRRR 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI SSSSSSS 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPAI TTTTTTT 2 Bright A_GiveInventory("LegBanishedDeathEffect",1)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(100,"LegendarySoul")
	TNT1 A 0 A_SpawnItemEx("MiniDeathBall",0,0,0,0,0,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LPAI UUUUU 0 A_CustomMissile("LegBanFlesh1",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
	LPAI UUUUU 0 A_CustomMissile("LegBanFlesh2",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh3",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh4",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh5",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh6",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI U 0 A_CustomMissile("LegBanBigArm1",40,-40,-90,2,frandom(-1,1)) 
    LPAI U 0 A_CustomMissile("LegBanBigArm2",40,40,90,2,frandom(-1,1))
    LPAI U 0 A_CustomMissile("LegBanSmallArm1",100,-30,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm1",100,30,90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm2",100,-30,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm2",100,30,90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanHorn1",110,-16,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanHorn2",110,16,90,2,frandom(-15,15))
	LPAI U 0 A_NoBlocking
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX",frandom(30,60),0,frandom(0,360),2,frandom(0,360))	
	LPAI UV 4 Bright
	TNT1 A 70
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 3 A_SpawnItemEx("LegBanSpawners",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,64)
    Stop
  LegendarySoul:
	TNT1 A 0 A_SpawnItemEx("TrueDeathBall",0,0,0,0,0,0,0)
	LPAI UUUUU 0 A_CustomMissile("LegBanFlesh1",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
	LPAI UUUUU 0 A_CustomMissile("LegBanFlesh2",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh3",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh4",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh5",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI UUUUUUUUUU 0 A_CustomMissile("LegBanFlesh6",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15)) 
    LPAI U 0 A_CustomMissile("LegBanBigArm1",40,-40,-90,2,frandom(-1,1)) 
    LPAI U 0 A_CustomMissile("LegBanBigArm2",40,40,90,2,frandom(-1,1))
    LPAI U 0 A_CustomMissile("LegBanSmallArm1",100,-30,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm1",100,30,90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm2",100,-30,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanSmallArm2",100,30,90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanHorn1",110,-16,-90,2,frandom(-15,15))
    LPAI U 0 A_CustomMissile("LegBanHorn2",110,16,90,2,frandom(-15,15))
	LPAI U 0 A_NoBlocking
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	LPAI UV 4 Bright
	TNT1 A 245
    TNT1 A 0 A_SpawnItemEx("LegSoulSpawners",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_SETMASTER,192)
	TNT1 A 0 A_SpawnItemEx("LegendarySoul",0,0,16,0,0,0,0,SXF_CLIENTSIDE|SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    Stop
  }
}

Actor LegBanishedDeathEffect : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  +COUNTITEM
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_Jump(178,2)
	TNT1 A 0 A_CustomMissile("LegBanLostSoul",32,0,frandom(0,360),CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	Stop
  }
}

Actor LegBanBall1 : CacodemonBall
{
  Damage (Random(10,30)) //5
  Species "PainElemental"
  DamageType "Legendary"
  Speed 30
  Alpha 0.80
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  SeeSound "legbanished/attack1"
  DeathSound "legbanished/explode1"
  States
  {
  Spawn:
  	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LAN1 AB 1 Bright A_SpawnItemEx("LegBanBall1Trail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)
	Loop
  Death:
  	TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LAN1 CDEEFGH 3 Bright
	Stop
  }
}

Actor LegBanBall1Trail : BFG9500Trail
{
  Scale 0.85
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LAN1 ABABABAB 2 A_FadeOut(0.15)
	Stop
  }
}

Actor LegBanBall2 : LegBanBall1
{
  Radius 12
  Height 6
  Speed 35
  Damage (Random(100,200)) //35
  Projectile
  RenderStyle Add
  Alpha 0.80
  Scale 1.5
  +NODAMAGETHRUST
  +EXTREMEDEATH
  DeathSound "legbanished/explode2"
  DamageType "BombBreath"
  Decal "BFG9500LightningBlue"
  var int user_delay;
  States
  {
  Spawn:
	LAN2 STUVX 1 Bright A_SpawnItemEx("LegBanBall2Trail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(15,256,0)
	Loop
  Death:
	TNT1 A 0 A_JumpIf(user_delay >= 48,"Death2")
	TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LAN2 S 1 Bright
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LAN2 T 1 Bright	
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LAN2 U 1 Bright
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LAN2 V 1 Bright
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 0 A_Explode(15,256,0)
	LAN2 W 1 Bright
	Loop
  Death2:
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))   
	TNT1 A 0 A_Explode(128,256,0)
	Stop	
  }
}

