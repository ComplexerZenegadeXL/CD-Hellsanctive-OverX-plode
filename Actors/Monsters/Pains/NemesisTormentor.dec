}

Actor NemesisUmbra : ForgottenOne
{
  Health 250
  PainChance 40
  Scale 1.0
  Obituary "$CFNemesisUmbraObit"
  Damage (random(20,50)) //10
  -NOBLOOD
  +BRIGHT
  +NOTIMEFREEZE
  +NOINFIGHTING
  +THRUSPECIES
  -COUNTKILL
  BloodColor "Black"
  Species "PainElemental"
  DamageType "Nemesis"
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerNemesisPlasma", 0.0
  DamageFactor "PlayerNemesisBFG", 0.0
  DropItem "NemesisHealthBonusMax", 256, 32
  DropItem "NemesisArmorBonus32", 256
  SeeSound "ChaosSoul/Sight"
  AttackSound "ChaosSoul/Sight"
  PainSound "ChaosSoul/pain"
  DeathSound "ChaosSoul/death"
  Tag "$CFUmbra"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",36)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:	
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"GiveToTormentor")
    NTUM AABB 2 A_Look
    Loop
  GiveToTormentor:
	TNT1 A 0 A_GiveInventory("MarineKilled",1,AAPTR_MASTER)
	TNT1 A 0 A_TakeInventory("MarineKilled")
	Goto SpawnLoop
  See:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"GiveToTormentor")
    NTUM AABB 2 A_Chase
    Loop
  Missile:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"GiveToTormentor")
	TNT1 A 0 A_Jump(128,"Projectile")
    NTUM AC 6 A_FaceTarget
    NTUM D 2 A_SkullAttack(40)
  Cont:
    NTUM CDD 2 A_FaceTarget
    Loop
  Projectile:
    NTUM AC 6 A_FaceTarget
    NTUM D 2 A_CustomMissile("NemesisTormentorHadesBall1",15)
    NTUM DC 2
	Goto See
  Pain:
    NTUM E 3 A_Pain
    NTUM E 3
    Goto See
  Death:
    NTUM EFG 4
    NTUM H 4 A_Scream
    NTUM I 4
    TNT1 AA 0 A_SpawnItemEx("NemesisKaboom",0,0,32,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    NTUM J 4 A_NoBlocking
    NTUM KL 4
    Stop
  }
}

