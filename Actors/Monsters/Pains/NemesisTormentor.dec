Actor NemesisTormentorGhost
{
  Scale 0.85
  Alpha 0.7
  Renderstyle Translucent
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    NPAI A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

