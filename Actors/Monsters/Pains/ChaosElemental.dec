Actor ChaosElemental : SoulKeeper 17575
{
  //$Category Monsters/CF
  //$Sprite CHELA1
  //$Title "Chaos Elemental"
  Health 2000
  Radius 31
  Height 56
  Mass 1000
  Speed 13
  PainChance 20
  Scale 0.85
  Obituary "$CFChaosElementalObit"
  Monster
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +DONTHARMSPECIES
  PainChance "PainElemental", 0
  PainChance "ChaosSoul", 0
  DamageFactor "CurseComet", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "ChaosEssence" 64
  DropItem "BigCFManaPickup" 128 100
  DropItem "CFManaPickup" 256 30
  DropItem "CFManaPickup" 256 30
  MeleeDamage 20
  MeleeRange 68
  BloodColor "Green"
  SeeSound "ChaosElemental/Sight"
  PainSound "ChaosElemental/Pain"
  DeathSound "ChaosElemental/Death"
  ActiveSound "ChaosElemental/Active"
  MeleeSound "caco/melee"
  Tag "$CFChaosElem"
  var int user_lowlag;
  States
  {
  Spawn:
	CHEL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CHEL A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CHEL AABBAACC 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	CHEL A 0 A_SetTranslucent(1)
	CHEL A 0 A_SetShootable
    CHEL A 0 A_UnSetInvulnerable
    CHEL AABBAACC 3 A_Chase
    CHEL A 0 A_Jump(32,"Teleport")
    Loop
  Missile:
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Jump(256,"Missile3")
	TNT1 A 0 A_Jump(200,"Missile2","Missile3")
    Goto Missile1
  Missile1:
    CHEL DE 8 A_FaceTarget
    CHEL FF 8 Bright A_PainAttack("SummonedChaosSoul")
    CHEL ED 8 A_FaceTarget
    Goto See
  Missile2:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("ChaosElemental/Sight")
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX5",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX5",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX4",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX4",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX3",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX3",40,43,0,0)
    CHEL G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX2",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX2",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("OverseerBrainSFX",0,0,0,0)
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,43,0,0)
    CHEL H 4 Bright A_FaceTarget
    CHEL I 8 Bright A_CustomMissile("ChaosSuperLightningProj",43,0,0,0,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	CHEL HG 10 Bright
	Goto See
  Missile3:
	CHEL JJ 4 A_FaceTarget
    CHEL K 0 A_CustomMissile("ChaosLightning",82,-34,frandom(-3,3),0,frandom(-3,3))
    CHEL K 0 A_CustomMissile("ChaosLightning",16,-34,frandom(-3,3),0,frandom(-3,3))
    CHEL K 0 A_CustomMissile("ChaosLightning",82,34,frandom(-3,3),0,frandom(-3,3))
    CHEL K 0 A_CustomMissile("ChaosLightning",16,34,frandom(-3,3),0,frandom(-3,3))
    CHEL K 0 A_CustomMissile("ChaosLightning",54,-42,frandom(-3,3),0,frandom(-3,3))
    CHEL K 4 Bright A_CustomMissile("ChaosLightning",54,42,frandom(-3,3),0,frandom(-3,3))
    CHEL J 4 A_SpidRefire
    CHEL J 0 A_Jump(32,"See")
    Goto Missile3+8
  Melee:
    CHEL ADF 5 A_FaceTarget
    CHEL E 5 A_MeleeAttack
    Goto See
  Pain:
    CHEL L 0 A_Jump(20,"Teleport")
    CHEL L 6
    CHEL L 6 A_Pain
    Goto See
  Teleport:
    CHEL J 1 Bright A_UnSetShootable
	CHEL JJJJJJJJJJJ 1 A_FadeOut(0.1,0)
	CHEL J 1 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    CHEL J 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	CHEL JJJJJJJJJJJ 1 A_FadeIn(0.1)
    CHEL J 1 Bright A_SetShootable
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_PainDie("SummonedChaosSoul")
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    CHEL L 20 A_Scream
    CHEL M 8 Bright
	TNT1 A 0 A_Playsound("BFlan/LightningExp",7)
	TNT1 A 0 A_SpawnItem("PlayerDTBFGEx",0,30)
	TNT1 AAAAAA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, frandom(30,50), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX",frandom(30,50), 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAAAAAAAA 0 A_CustomMissile("Kaboom11",frandom(30,50),0,frandom(0,360),2,frandom(0,360))
	TNT1 A 0 Radius_Quake(20,8,0,12,0)
    TNT1 A 0 A_Explode(260,200)
    CHEL N 4 Bright A_SpawnItemEx("GreenGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Explode(260,200)
    CHEL NOO 4 Bright A_SpawnItemEx("GreenGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,40),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_PainDie("SummonedChaosSoul")
    CHEL PPPPP 0 A_CustomMissile("ChaosFlesh1",frandom(0,90),frandom(0,40),random(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL PPPPP 0 A_CustomMissile("ChaosFlesh2",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL PPPPPPPP 0 A_CustomMissile("ChaosFlesh3",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL PPPPPPPP 0 A_CustomMissile("ChaosFlesh4",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL PPPPPPPP 0 A_CustomMissile("ChaosFlesh5",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL PPPPPPPP 0 A_CustomMissile("ChaosFlesh6",frandom(0,90),frandom(0,40),frandom(-180,180),CMF_AIMDIRECTION,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosBigArm1",40,-40,-90,2,frandom(-1,1))
    CHEL P 0 A_CustomMissile("ChaosBigArm2",40,40,90,2,frandom(-1,1))
    CHEL P 0 A_CustomMissile("ChaosSmallArm1",100,-30,-90,2,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosSmallArm1",100,30,90,2,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosSmallArm2",100,-30,-90,2,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosSmallArm2",100,30,90,2,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosHorn1",110,-16,-90,2,frandom(-15,15))
    CHEL P 0 A_CustomMissile("ChaosHorn2",110,16,90,2,frandom(-15,15))
    CHEL PQRSTUV 8 Bright
    Stop
  }
}

Actor SummonedChaosElemental : ChaosElemental { Tag "$CFSChaosElem" -COUNTKILL }

Actor ChaosSuperLightningFX : ImpballTrail
{
  Scale 1
  Renderstyle Add
  Alpha 1
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    CLIG ABCDE 1 Bright
    Stop
  }
}

Actor ChaosSuperLightningFX2 : ChaosSuperLightningFX { Scale 0.8 }

Actor ChaosSuperLightningFX3 : ChaosSuperLightningFX { Scale 0.6 }

Actor ChaosSuperLightningFX4 : ChaosSuperLightningFX { Scale 0.4 }

Actor ChaosSuperLightningFX5 : ChaosSuperLightningFX { Scale 0.2 }

Actor ChaosSuperLightningProj : FastProjectile
{
  Radius 12
  Height 6
  Speed 80
  Damage (Random(150,300)) //50
  RenderStyle Add
  +NODAMAGETHRUST
  +FORCEXYBILLBOARD
  +FORCERADIUSDMG
  Species "PainElemental"
  DamageType "BombBreath"
  DeathSound "BFlan/LightningExp"
  Missiletype "ChaosSuperLightningTrailSpawner"
  Missileheight 8
  States
  {
  Spawn:
    CLIG ABCDE 1 Bright
    Loop
  Death:
    TNT1 AAAAAA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, frandom(15,35), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX", frandom(15,35), 0, random(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAA 0 A_CustomMissile("Kaboom11",frandom(15,35),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItem("PlayerDTBFGEx",0,-10)
	TNT1 A 0 Radius_Quake(20,8,0,12,0)
    BFE3 AB 4 Bright A_Explode(260,200)
	BFE3 CDEF 5 Bright
    Stop
  }
}

Actor ChaosSuperLightningTrailSpawner
{
  Radius 0
  Height 0
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 AA 0 A_SpawnItemEx("ChaosSuperLightningTrail", frandom(-20, 20), frandom(-20, 20), frandom(-20, 20), 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor ChaosSuperLightningTrail : ImpballTrail
{
  Scale 1.2
  Renderstyle Add
  Alpha 0.8
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    TNT1 A 0 A_Jump(255, "Puff1", "Puff2", "Puff3")
  Puff1:
    CLIG F 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    CLIG G 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    CLIG H 1 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor ChaosFlesh1
{
  Speed 16
  Mass 100
  Radius 1
  Height 1
  Projectile
  +THRUGHOST
  -NOGRAVITY
  +NOBLOCKMAP
  States
  {
  Spawn:
    CHF1 ACEGIKM 5 A_SpawnItemEx("GreenGibTrail", 0, 0, 0, frandom(-1,1), frandom(-1,1), frandom(-1,1), 0, SXF_CLIENTSIDE)
    Loop
  Death:
    CHF1 O 3
    CHF1 QQQQQQQQQQ 7 A_FadeOut(0.1,1)
    Stop
  }
}

