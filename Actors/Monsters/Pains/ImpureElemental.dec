Actor ImpureElemental : SoulKeeper
{
  Health 1700
  Speed 6
  FloatSpeed 6
  Radius 30
  Height 56
  Mass 1200
  PainChance 15
  BloodColor "Blue"
  MeleeRange 70
  MeleeDamage 15
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  //Damagetype "SatanGuard"
  DamageFactor "Acid", 0.3
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Legendary", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor 0.75
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "CacoLich", 0.0
  DamageFactor "PhazoDemon", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "EleSouls", 0.0
  DropItem "BossLifeEssence", 200, 30
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "ModdedSoulSphere", 32
  SeeSound "ImpElem/sight"
  PainSound "ImpElem/pain"
  ActiveSound "ImpElem/active"
  MeleeSound "caco/melee"
  DeathSound "ImpElem/death"
  Obituary "%o was reduced to ashes by an Impure Elemental"
  HitObituary "$CFImpureElementalHitObit"
  Tag "$CFImpElem"
  var int user_currenthp;
  States
  {
  Spawn:
	IMCC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SetSolid
	IMCC A 10 Bright A_Look
	TNT1 A 0 HealThing(2)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	Loop
  See:
	TNT1 A 0 A_SetSolid
	IMCC AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Chase
	TNT1 A 0 HealThing(random(1,2))
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	Loop
  Melee:
	TNT1 A 0 A_SetSolid
	TNT1 A 0
	TNT1 A 0 A_Stop
	IMCC EFG 4 Bright A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	IMCC FE 4 Bright
	Goto See
  Missile:
	TNT1 A 0 A_SetSolid
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_Jump(64,"HomingComets","Souls")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth",0)*0.13),"Dual")
	IMCC EFG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,5,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,10,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,-5,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,-10,0)
	IMCC FE 3 Bright
	Goto See
  RapidFire:
	IMCC EFG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMCC FE 3 Bright
	Goto See
  Comet:
	IMCC EF 4 Bright A_FaceTarget
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinComet",24,0,0)
	IMCC GFE 3 Bright
	Goto See
  HomingComets:
	IMCC EF 4 Bright A_FaceTarget
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,5)
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,-5)
	IMCC GFE 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_Jump(89,"Souls")
	Goto See
  Souls:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	//TNT1 A 0 A_Jump(32,"LegLostSoul")
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	Goto See
  LegLostSoul:
	TNT1 A 0 A_PainAttack("LegendaryHeroSoul")
	IMCC EF 3 Bright
	Goto See
  Dual:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_DualPainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_Jump(89,"Rapid")
	Goto See
  Rapid:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	Goto See
  Pain:
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	IMCC H 3 Bright A_Pain
	TNT1 A 0 A_Jump(40,"Missile")
	Goto See
  Death.PlayerIce:
    "####" "#" 0
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	"----" A 0 A_PainDie("SummonedImpureSoul")
	Wait
  Death:
	IMCC I 6 Bright A_Scream
	IMCC J 3 Bright A_Fall
	TNT1 A 0 A_PlaySound("comet/explosion",CHAN_BODY,1.0,0)
	TNT1 AAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(70,198)
	TNT1 AAAAAA 0 A_SpawnItemEx("Debris",0,0,32,frandom(-8,8),frandom(-8,8),frandom(8,12),0,SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom27",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_PainDie("SummonedImpureSoul")
	IMCC KL 3 Bright
	IMCC MNOP 2 Bright
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999)
  Fall:
	IMCC Q 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",12,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,0)
	IMCC RSTU 3
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	IMCC V -1
	Stop
  }
}

Actor SummonedImpureElemental : ImpureElemental { Tag "$CFSImpElem" DamageFactor 0.85 -COUNTKILL }