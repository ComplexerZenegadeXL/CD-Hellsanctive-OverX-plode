Actor Damned : CFBaronofHell
{
  Monster
  Health 1500
  Height 64
  Radius 24
  Mass 1000
  Speed 4
  MeleeRange 64
  PainChance "Mine", 128
  PainChance 38
  MeleeDamage 18
  +BOSSDEATH
  +NOTARGET
  +FLOORCLIP
  +FASTMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species "Nobles"
  //Species "SatanGuard"
  DamageFactor "Acid", 0.3
  DamageFactor "Nobles", 0.3
  DamageFactor "Fire", 0.5
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DamageFactor "UBDTR", 0.0
  DamageFactor "DarkbruiserBFG10K", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "AfritComet", 0.0
  DropItem "BossLifeEssence", 200, 25
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "ModdedSoulSphere", 64
  SeeSound "profane/sight"
  ActiveSound "baron/active"
  MeleeSound "imp/melee"
  PainSound "baron/pain"
  DeathSound "profane/death"
  Obituary "$CFDamnedObit"
  HitObituary "$CFDamnedHitObit"
  Tag "$CFDamned"
  States
  {
  Spawn:
	DAMN A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DAMN A 10 A_Look
	Loop
  See:
	DAMN AAA 1 A_Chase("Melee","")
	DAMN AA 1 A_Chase
	DAMN BBB 1 A_Chase("Melee","")
	DAMN BB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DAMN CCC 1 A_Chase("Melee","")
	DAMN CC 1 A_Chase
	DAMN DDD 1 A_Chase("Melee","")
	DAMN DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  Melee:
	DAMN EEEFFFGG 1 A_FaceTarget
	TNT1 A 0 A_GiveToTarget("HeterodoxCurse")
	TNT1 A 0 A_MeleeAttack
	DAMN FEE 3
	Goto See	
  Missile:
	TNT1 A 0
	TNT1 A 0 A_Jump(80,"BigSpread")
  Normal:
	DAMN E 5 Bright A_FaceTarget
	DAMN FG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DamnedBall",32,0,frandom(0,8))
	TNT1 A 0 A_CustomMissile("DamnedBall",32,0,frandom(-8,0))
	DAMN FE 6
	Goto See
  BigSpread:
	DAMN EEEEEFFFGG 1 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("DamnedBall",32,0,frandom(0,8))
	TNT1 AAA 0 A_CustomMissile("DamnedBall",32,0,frandom(-8,0))
	DAMN FE 6
	Goto See
  Homer:
	DAMN E 5 Bright A_FaceTarget
	DAMN FG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DamnedHomer",32,0,0)
	DAMN FE 6
	Goto See
  Pain:
	DAMN H 2 A_Pain
	DAMN H 3
	Goto See
  XDeath:
  Death:
	DAMN I 4 A_SpawnItemEx("GibbedGenerator",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Scream
	TNT1 A 0 A_PlaySound("Profane/die",6,1.0,0)
    DAMN J 8 A_Fall
	TNT1 A 0 A_BossDeath
    DAMN KLMN 8
    DAMN O -1
    Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    DAMN ONMLKJI 5
    Goto See
  }
}

Actor SummonedDamned : Damned { -COUNTKILL }
	
Actor DamnedBall : BaronBall
{
  Speed 22
  FastSpeed 28
  Scale 1.2
  Decal "DoomImpScorch"
  Damage (Random(15,30))
  +DONTHARMSPECIES
  Species "Nobles"
  DamageType "Damned"
  States
  {
  Spawn:	
	BAL3 AB 1 Bright A_SpawnItemEx("DamnedBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)	
	Loop
  Death:
	BAL3 CDE 3 Bright
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom10",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BAL3 CDE 3 Bright
	Stop
  }
}

Actor DamnedBallTrail
{
  Height 1
  Radius 1
  RenderStyle Add
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	BAL3 ABABABABABAB 1 A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor DamnedHomer : HadesTracer
{
  Damage (Random(10,24))
  Species "Nobles"
  DamageType "Damned"
}