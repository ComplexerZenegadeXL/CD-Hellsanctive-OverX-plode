Actor InsanityCyberNoble : InfernalCyberNoble
{ 
  Health 2500
  PainChance 50
  Scale 1.2
  DamageFactor "Normal", 0.65
  Obituary "$CFInsanityCyberNobleObit"
  HitObituary "$CFInsanityCyberNobleHitObit"
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "BFG10KGiver" 50 
  DropItem "NewCellPackPickup" 128
  DropItem "NewShellPickup" 256
  DropItem "NewShellBoxPickup" 128
  DropItem "ExplosiveShotgunGiver" 200
  DropItem "ExplosiveRailgunGiver" 64
  Tag "$CFInsNoble"
  var int user_lowlag;
  var int user_loop;
  States 
  { 
  Spawn: 
    SLAU A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	SLAU A 10 A_Look
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	SLAU AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(62,"Rush")
    SLAU AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    SLAU CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU B 1 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SLAU D 1 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
	TNT1 A 0 A_Jump(42,"See")	
	Loop
  Pause:
	SLAU E 10
	Goto See
  Pause2:
	SLAU A 10
	Goto See
  Melee:
    SLAU PQ 7 A_FaceTarget
    SLAU R 7 A_MeleeAttack
    Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"Asg","laser","Ballspam","InfernalRockets")
    TNT1 A 0 A_jump(100,"BFG15k","Smallcomets","Spreadballs","SpreadSC")
    TNT1 A 0 A_jump(80,"Railgun","Bfg10k","comets","Spreadcomets","ExplosiveRailgun")
  Normal:
    SLAU E 12 A_FaceTarget
	SLAU E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("InsaneNobleDemonTech",42,20,frandom(8,-8))
	SLAU F 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(20,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+1
  InfernalRockets:
    SLAU EE 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  InfernalRocketsLoop:
    SLAU F 6 Bright A_CustomMissile("InfernalCyberNobleRocket",32,20,0,0)
    SLAU E 7 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    SLAU E 10
    Goto See
  Ballspam:
	SLAU PQ 7 A_FaceTarget 
	SLAU R 3 Bright A_CustomMissile("RIBall", 32, 0, 0)		
	SLAU PQ 4 A_FaceTarget
	SLAU R 3 Bright A_CustomMissile("RIBall", 32, 0, 0)	
	SLAU PQ 4 A_FaceTarget
	SLAU R 3 Bright A_CustomMissile("RIBall", 32, 0, 0)		
	SLAU R 4 A_FaceTarget
	TNT1 A 0 A_Jump(20,"Pause2")
	TNT1 A 0 A_SpidRefire
	Goto Ballspam+1
  ASG:
	TNT1 A 0 A_JumpifCloser(200,"SSG")
	SLAU E 14 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAAAA 0 Bright A_CustomMissile("CybernobleExplosiveTracer",42,20,frandom(-5,5),0)
	SLAU F 4 Bright A_CustomBulletAttack(12,5,6,Random(10,20),"CyNoblePuff",0,CBAF_NORANDOM)
	SLAU E 8
    TNT1 A 0 A_Jump(128,"See")
    TNT1 A 0 A_SpidRefire
	Goto ASG+1
  SSG:
    SLAU E 8 A_FaceTarget
	SLAU E 12 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAAAAAAA 0 Bright A_CustomMissile("CybernobleExplosiveTracer",42,20,frandom(-8,8),0)
	TNT1 A 0 A_CustomBulletAttack(12, 8, 10, Random(9,15),"CyNoblePuff",0,CBAF_NORANDOM)
	SLAU F 4 Bright A_PlaySoundEx("weapons/sshotf","Weapon")
    TNT1 A 0 A_Jump(128,"Pause")
	SLAU E 12
    TNT1 A 0 A_SpidRefire
	Goto Normal  
  Laser:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    SLAU EEEE 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
    SLAU F 5 Bright A_CustomMissile("InsaneNoblelaser",42,20,0,0)
	SLAU E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	SLAU F 5 Bright A_CustomMissile("InsaneNoblelaser",42,20,0,0)
	SLAU E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	SLAU F 5 Bright A_CustomMissile("InsaneNoblelaser",42,20,0,0)
    SLAU E 20
	TNT1 A 0 A_Jump(64,"Railgun","BFG10K","Bfg15k")
	Goto See
  Smallcomets:
	SLAU PQ 7 A_FaceTarget 
	SLAU R 3 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)		
	SLAU PQ 4 A_FaceTarget
	SLAU R 3 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)	
	SLAU PQ 4 A_FaceTarget
	SLAU R 3 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)		
	Goto See
  Spreadballs:
    SLAU PQ 8 A_FaceTarget
	SLAU R 1 Bright A_CustomMissile("RIBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("RIBall", 32, 0, 6)
	SLAU R 1 Bright A_CustomMissile("RIBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("RIBall", 32, 0, 12)
	SLAU R 5 Bright A_CustomMissile("RIBall", 32, 0, -12)
	TNT1 A 0 A_jump(64,"SpreadSC","Comets","Spreadcomets")
	Goto See
  SpreadSC:
	SLAU PQ 8 A_FaceTarget
	SLAU R 1 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("RISeekerComet", 32, 0, 6)
	SLAU R 1 Bright A_CustomMissile("ArcradimusComet2", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("RISeekerComet", 32, 0, 12)
	SLAU R 5 Bright A_CustomMissile("ArcradimusComet2", 32, 0, -12)
	TNT1 A 0 A_jump(64,"Comets","Spreadcomets")
	Goto See
  BFG10k:
	TNT1 A 0 A_PlayWeaponSound("weapons/charge15k")
    SLAU E 25 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10kLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    SLAU F 4 Bright A_CustomMissile("Cy10K",42,20,0,0)
    SLAU E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    SLAU E 10 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"railgun")
    Goto See
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    SLAU E 18 A_FaceTarget
	SLAU E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15kLoop:
    SLAU F 4 Bright A_CustomMissile("Cybruiser15K",32,20,frandom(-4,4))	
	SLAU E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	SLAU E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"railgun")
	Goto See
  Railgun:
	TNT1 A 0 A_changeflag("Nopain",1)
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    SLAU EEEE 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
    SLAU F 5 Bright A_CustomMissile("CydestroyerRail",42,20,0,0)
    SLAU E 20
	TNT1 A 0 A_changeflag("Nopain",0)
	Goto See
  Comets:
	SLAU PQ 8 A_FaceTarget 
	SLAU R 7 Bright A_CustomMissile("Comet", 32, 0, 0)		
	Goto see
  Spreadcomets:
	SLAU PQ 8 A_FaceTarget 
	SLAU R 3 Bright A_CustomMissile("Comet", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("Comet", 32, 0, 6)
	SLAU R 3 Bright A_CustomMissile("Comet", 32, 0, -6)
	Goto see
  ExplosiveRailgun:
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Charge")
	TNT1 A 0 A_PlaySound("InfernalCyberbaron/Attack",7)
    SLAU EE 20 A_FaceTarget
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
    TNT1 A 0 A_CustomMissile("NobleExplosiveRailgunImpact",32,20,0,0)
    SLAU F 5 Bright A_CustomRailgun(50,20,None,None,RGF_SILENT,1,0,"BruiserRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
    SLAU EE 15 A_FaceTarget
	TNT1 A 0 A_Jump(128,"See","BFG10K")
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
    TNT1 A 0 A_CustomMissile("NobleExplosiveRailgunImpact",32,20,0,0)
    SLAU F 5 Bright A_CustomRailgun(50,20,None,None,RGF_SILENT,1,0,"BruiserRailPuff",0,0,0,0,40,0,"ExplosiveRailgunTrail")
    SLAU EE 15
	TNT1 A 0 A_Jump(64,"BFG10K")
	Goto See
  Pain: 
    SLAU G 4 A_Pain
    TNT1 A 0 A_Jump(87,"Missile")
    Goto See
  Death:
  XDeath:
	SLAU G 10
    SLAU I 10 A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SLAU JJJJ 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SLAU KKKK 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SLAU LLLL 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SLAU MMMM 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SLAU N 4 Bright A_NoBlocking
    SLAU O 3
    SLAU O -1
    Stop
  XRaise:
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    SLAU N 5
	SLAU MLKJI 5
	Goto See
  } 
}

Actor SummonedInsanityCyberNoble :  InsanityCyberNoble { -COUNTKILL }

//Attacks
Actor InsaneNobleDemonTech : RedZDemonTechProjectile
{
  Species "Nobles"
  DamageType "NobleComet"
  Speed 75
  Damage (Random(15,20)) //4
}

Actor InsaneNoblelaser : SpecOpsLaser { Species "Nobles" DamageType "NobleComet" Damage (Random(40,80)) }

Actor InsaneNobleGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  Scale 1.15
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    SLAU A 2 A_FadeOut(0.18)
    Loop	
  }
}

Actor InsaneNobleGhostB : InsaneNobleGhostA
{
  States
  {
  Spawn:
    SLAU B 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneNobleGhostC : InsaneNobleGhostA
{
  States
  {
  Spawn:
    SLAU C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneNobleGhostD : InsaneNobleGhostA
{
  States
  {
  Spawn:
    SLAU D 2 A_FadeOut(0.18)
    Loop
  }
}