Actor STBelphegor : CFBaronOfHell //18552
{
  //$Category Monsters/LCA/DJB
  //$Sprite BELPA1
  //$Title "Belphegor"
  Health 1500
  GibHealth 100
  PainChance 100
  PainChance "SoulToxic", 20
  PainChance "FatFlamer", 20
  PainChance "FiendFire", 20
  BloodColor "Green"
  DamageFactor "NobleComet", 0.0
  Species "Nobles"
  DropItem "LifeEssence" 100
  DropItem "ArmorBonusMax" 100
  SeeSound "Belphegors/See" 
  DeathSound "Belphegors/Death"
  ActiveSound "Belphegors/Active"
  MeleeDamage 16
  Obituary "$CFSTBelphegorObit"
  HitObituary "$CFSTBelphegorHitObit"
  MeleeSound "baron/melee"
  Tag "$CFBelph"
  +MISSILEMORE
  +FASTMELEE
  +DONTHURTSPECIES
  var int user_lowlag;
  States
  {
  Spawn:
	BELP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BELP AA 7 A_Look
	BELI AA 7 A_Look
	Loop
  See:
    TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BELP AABBCCDD 3 A_Chase
    Loop
  MoreSee:
    TNT1 A 0 A_SetUserVar(user_lowlag,1)
	BELP AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    BELP CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    Loop
  Missile:
	TNT1 A 0 A_Jump(128,"GiantBalls","Comet")
  Normal:
	BELP IJ 8 A_FaceTarget
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 12)
	BELP K 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -12)
	BELP IJ 4 A_FaceTarget
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 12)
	BELP K 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -12)
    BELP IJ 4 A_FaceTarget
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	BELP K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 12)
	BELP K 8 Bright A_CustomMissile("CyNobleBall", 32, 0, -12)
	TNT1 A 0 A_Jump(87,"GiantBalls","Comet")
	Goto See
  GiantBalls:
    BELP EF 8 A_FaceTarget
	BELP G 7 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
    BELP ST 8 A_FaceTarget
	BELP U 7 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	BELP EF 5 A_FaceTarget
	BELP G 4 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
    BELP ST 5 A_FaceTarget
	BELP U 4 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	BELP EF 4 A_FaceTarget
	BELP G 3 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
    BELP ST 4 A_FaceTarget
	BELP U 3 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    BELP IJ 8 A_FaceTarget	
	BELP K 7 Bright A_CustomMissile("HDComet", 32, 0, 0)
	BELP IJ 6 A_FaceTarget	
	BELP K 5 Bright A_CustomMissile("HDComet", 32, 0, 0)
    Goto See
  Melee:
	BELP EF 8 A_FaceTarget
	BELP G 8 A_MeleeAttack
	Goto See
  Pain:
	BELP H 4 A_Pain
	Goto See
  Death: 
    BELD A 7
    BELD B 6 A_Scream 
    BELD C 5 A_Fall 	
    BELD D 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BELD EF 4
    BELD G -1
    Stop 
  XDeath:
	BELX A 5
	BELX B 5 A_GiveInventory("XDeathCheck",1)
	BELX C 4 A_XScream
	BELX D 4 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BELX E 3 A_Fall
	BELX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BELX GH 3
	BELX I -1
	Stop 	
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	BELD GFEDCBA 6
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	BELX IHGFEDCBA 5
	Goto See
  }
}