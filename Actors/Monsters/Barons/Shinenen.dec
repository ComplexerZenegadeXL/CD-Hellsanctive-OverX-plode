Actor Shinenen : CFBaronofHell  //not in spawners
{ 
  Monster
  Health 2000
  Height 64
  Radius 24
  Mass 1000
  Speed 4
  FloatSpeed 6
  Scale 1.05
  BloodColor "purple"
  PainChance 50
  MeleeRange 68
  MeleeDamage 8
  +BOSSDEATH
  +FLOAT
  +NOGRAVITY
  +DONTFALL
  -FLOORCLIP
  +FASTMELEE
  +MISSILEMORE
  +DONTHARMSPECIES
  Species "Nobles"
  DamageFactor "Acid", 2.5
  DamageFactor "Fire", 0.0
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DropItem "NemesisHealthBonusMax", 200, 25
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "BerserkSphere", 40
  SeeSound "Shin/sight"
  ActiveSound "Shin/act"
  MeleeSound "baron/melee"
  PainSound "Shin/pain"
  DeathSound "Shin/death"
  Obituary "$CFShinenenObit"
  HitObituary "$CFShinenenHitObit"
  Tag "$CFShien"
  var int user_loopm;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	SHIN A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",35)
	TNT1 A 0 A_SetUserVar("user_effect_delay",5)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	SHIN ABC 5 A_Look
	Loop
  See:
	SHIN AAAABBBBCCCC 1 A_Chase
	Loop
  Pain:
	SHIN Q 5 A_Pain
	SHIN Q 2
	GoTo See
  Melee:
	TNT1 A 0 A_Jump(128,"Melee2")
	SHIN EFG 4 A_FaceTarget
	SHIN G 1 A_MeleeAttack
	SHIN GFE 4
	GoTo See
  Melee2:
	SHIN IJK 4 A_FaceTarget
	SHIN K 1 A_MeleeAttack
	SHIN KJI 4
	GoTo See
  Missile:
	TNT1 A 0 A_JumpIfCloser(68,"Melee")
	TNT1 A 0 A_Jump(128,"Alt","Alt","Alt","Alt","SlowSpam","SlowSpam","Haunt")
	Goto Normal
  Normal:
	SHIN EFG 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN G 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN GFE 4
	Goto See
  Alt:
	SHIN IJK 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN K 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN K 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN KJI 4
	Goto See
  SlowSpam:
	TNT1 A 0 A_SetUserVar("user_loopm",0)
	SHIN MMMNN 4 Bright
  2HuLoop:
	TNT1 A 0 A_CustomMissile("SlowBouncer",32,0,random(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH|CMF_AIMDIRECTION,random(0,360))
	SHIN O 3 Bright
	TNT1 A 0 A_CustomMissile("SlowBouncer",32,0,random(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH|CMF_AIMDIRECTION,random(0,360))
	TNT1 A 0 A_SetUserVar("user_loopm",user_loopm+1)
	TNT1 A 0 A_JumpIf(user_loopm>20,1)
	Loop
	SHIN O 15 Bright
	TNT1 A 0 A_Jump(42,"Haunt")
	SHIN NMM 5 Bright
	Goto See
  Haunt:
	SHIN OONMMM 5 Bright
	SHIN M 2 Bright
	TNT1 A 0 A_SpawnItemEx("HauntTargeter",22,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	SHIN M 2 Bright
	TNT1 A 0 A_SpawnItemEx("HauntTargeter",22,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	SHIN M 2 Bright
	TNT1 A 0 A_SpawnItemEx("HauntTargeter",22,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	SHIN M 2 Bright
	TNT1 A 0 A_SpawnItemEx("HauntTargeter",22,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	SHIN M 2 Bright
	TNT1 A 0 A_SpawnItemEx("HauntTargeter",22,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	SHIN MNOO 5 Bright
	Goto See
  XDeath:
  Death:
	TNT1 AAA 0 A_CustomMissile("SmokeFX",47,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom19",frandom(43,63),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	SHIN R 4 Bright
	SHIN S 3 Bright A_Scream
	SHIN TUV 3 Bright
	SHIN W 3 Bright A_Fall
	TNT1 A 0 A_BossDeath
	SHIN XYZ 2
	SHIN Z 1 A_KillChildren
	TNT1 A 1 A_ChangeFlag(DONTFALL,0)
	SHIN Z 1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 1 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 1 A_ChangeFlag(DONTFALL,1)
	SHIN ZYXWVUTSR 5
	Goto See
  }
}

Actor SlowBouncer : AdvisorBall
{
  Speed 5
  Damage (random(5,10))
  Species "Nobles"
  DamageType "NobleComet"
  BounceCount 50
  BounceFactor 1.0
  WallBounceFactor 1.0
  var int user_flight;
  ReactionTime 50
  States
  {
  Spawn:
    SBS4 ABCD 3 Bright A_SpawnItemEx("AdvisorBallTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
  SpawnLoop:
	SBS4 E 3 A_SpawnItemEx("AdvisorBallTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_SetUserVar("user_flight",user_flight+1)
    TNT1 A 0 A_JumpIf(user_flight>22,1)
    Loop
    TNT1 A 0 A_ScaleVelocity(2.6)
  Flight:
    SBS4 E 1 Bright A_SpawnItem("AdvisorBallTail")
    TNT1 A 0 A_ScaleVelocity(1.001)
    TNT1 A 0 A_SeekerMissile(15,3,SMF_LOOK|SMF_CURSPEED,82,2)
	TNT1 A 0 A_CountDown
    Loop
  Death:
    SBS4 FGHIJKL 3 Bright
    TNT1 A 0 A_Explode(random(10,17),125,0,0,random(78,112))
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 1, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))    
    Stop
  }
}

Actor Haunted : Inventory {}

Actor HauntTargeter : DShadowTargeter
{
  Species "Nobles"
  DamageType "NobleComet"
  Obituary "$CFHauntTargeterObit"
  States
  {
  See:
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("Haunted",1,"ClearTarget")
	TNT1 A 0 A_GiveToTarget("Haunted",1)
	TNT1 AA 1 A_FaceTarget
	TNT1 A 0 A_VileTarget("HauntSpawner")
	TNT1 AAAAA 35
	TNT1 A 2
	TNT1 A 1 A_TakeFromTarget("Haunted",1)
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor HauntSpawner
{
  +ISMONSTER
  -COUNTKILL
  +NOTARGET
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Haunter",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	TNT1 AAA 35
	TNT1 A 0 A_Jump(256,1,2,3,4)
	TNT1 AAA 35
	TNT1 A 1 A_KillChildren
	Stop
  }
}

Actor Haunter : Shinenen
{
  Health 500
  MeleeDamage 1
  +NOCLIP
  -BOSSDEATH
  -COUNTKILL
  DropItem "BossLifeEssence", 80, 5
  DropItem "CFBossArmorBonusMax25", 80
  DropItem "CFArmorBonusMax5", 80
  DropItem "CFArmorBonusMax5", 80
  Obituary "%o was haunted to death by a Shin'en-en."
  HitObituary "%o was haunted to death by a Shin'en-en."
  Tag "\ctShin'en-en\c-"
  States
  {
  Missile:
	TNT1 A 0 A_JumpIfCloser(68,"Melee")
	TNT1 A 0 A_Jump(128,"Alt")
	Goto Normal
  Normal:
	SHIN EFG 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,random(-20,20))
	SHIN GF 3
	SHIN FE 6
	Goto See
  Alt:
	SHIN IJK 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AdvisorBall",32,0,frandom(-20,20))
	SHIN KJ 3
	SHIN JII 3
	Goto See
  Death:
	TNT1 AAA 0 A_CustomMissile("SmokeFX",47,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom19",frandom(43,63),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	SHIN R 4 Bright
	SHIN S 3 Bright A_Scream
	SHIN TUV 3 Bright
	SHIN W 3 Bright A_Fall
	SHIN XYZ 2
	SHIN Z 1 A_KillChildren
	TNT1 A 1
	Stop
  Raise:
	Stop
  }
}

Actor ShinenenFire : AbyssalSatyrFlame
{
  Scale 0.3
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
}

Actor ShinenenFireSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_PlaySound("monster/ambientfire")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAA 0 A_SpawnItemEx("ShinenenFire",frandom(-12,12),frandom(-12,12),frandom(25,50),0,0,frandom(0,-5),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 1
	Stop
  }
}