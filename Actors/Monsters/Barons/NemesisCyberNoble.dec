	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2))	
	NROC B 2 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(4,6),frandom(-2,2))
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
