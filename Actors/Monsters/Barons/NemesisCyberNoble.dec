Actor MiniNemesisGuruStruckGlowX : CFGuruStruckGlowX 
{ 
  Scale 0.1 
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	Goto Fade
  Fade:
	TNT1 A 0 A_SetScale(ScaleX +0.1, ScaleY +0.025)
	NEMF A 1 Bright A_FadeOut(0.01,1)
	Loop
  }
}

