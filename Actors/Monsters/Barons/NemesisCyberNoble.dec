Actor MiniNemesisBFGBall : NemesisHKSuperBall
{
  -SEEKERMISSILE
  Species "Nobles"
  DamageType "Nemesis"
  Scale 1.5
  Speed 60
  Damage (Random(300,600)) //100
  BounceType None
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_LoopActiveSound
  SpawnLoop:
	TNT1 A 0 A_SpawnItemEx("MiniCyberNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360))
    CLBB D 1 Bright A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_Explode(50,400,0)
	TNT1 A 0 A_SpawnItemEx("MiniCyberNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
    CLBB D 6 Bright A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 A 0 A_Explode(50,400,0)
	TNT1 A 0 A_SpawnItemEx("MiniCyberNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
    CLBB D 6 Bright A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 A 0 A_Explode(50,400,0)
	TNT1 A 0 A_SpawnItemEx("MiniCyberNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
    CLBB D 6 Bright A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 A 0 A_Explode(50,400,0)
	TNT1 A 0 A_SpawnItemEx("MiniCyberNemesisGuruSphereSmokeProjectile",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("NemesisWhiteProjParticleSuperLarge2",0,0,0,frandom(-10,10),frandom(-10,10),frandom(-10,10),frandom(0,360))
    CLBB D 6 Bright A_SpawnItem("NemesisWhiteProjExplodeLarge")
	TNT1 A 1 A_SpawnItem("MiniNemesisDeathBall")
    Stop
  }
}


Actor NemesisCyberNobleSummoner
{
  Radius 24
  Height 8
  Speed 17
  Monster
  -SHOOTABLE
  -COUNTKILL
  -SOLID
  var int user_limit;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SetAngle(random(0,359))
	TNT1 A 1 A_Recoil(-40)
	TNT1 A 0 A_JumpIf(user_limit > 3,"Death")
	TNT1 A 0 A_SetUserVar("user_limit",user_limit+1)
	TNT1 A 1 A_Recoil(-4)
	TNT1 A 2 A_Jump(48,"Death")
    Goto Spawn+3
  Death:
    TNT1 A 0 A_SpawnItemEx("TeleportFog")
    TNT1 A 5 A_SpawnItemEx("NemesisCYNMinion")
	TNT1 A 1 A_Fall
	Stop
  }
}

