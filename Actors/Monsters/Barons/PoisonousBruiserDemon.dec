Actor PoisonousBruiserDemon : BruiserDemon 16570
{ 
  //$Category Monsters/LCA
  //$Sprite BRUSA1
  //$Title "PoisonousBruiserDemon"
  Health 1500
  Radius 24
  Height 64
  Mass 2000
  Speed 12
  PainChance 6
  Monster
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  +BOSS
  +FLOORCLIP
  +LOOKALLAROUND
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  SeeSound "PoisonousBruiserDemon/scream"
  PainSound "PoisonousBruiserDemon/pain"
  DeathSound "PoisonousBruiserDemon/death"
  ActiveSound "PoisonousBruiserDemon/act"
  MeleeSound "baron/melee"
  Obituary "$CFPoisonousBruiserDemonObit"
  HitObituary "$CFPoisonousBruiserDemonHitObit"
  MeleeDamage 60
  Scale 1.25
  Tag "$CFPoiBruiser"
  States
  {
  Spawn:
    PBRS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PBRS AB 10 Bright A_Look
    Loop
  See:
    PBRS AABBCCDD 3 Bright A_Chase
    Loop
  Melee:
    PBRS EF 6 Bright A_FaceTarget
    PBRS G 6 Bright A_ComboAttack
    Goto See
  Missile:
    PBRS E 0 A_Jump(144, 8)
    PBRS EF 6 Bright A_FaceTarget
    PBRS G 6 Bright A_CustomMissile("PoisonousBruiserBall",56,12)
    PBRS G 0 A_Jump(96, 1)
    Goto See
    PBRS HI 6 Bright A_FaceTarget
    PBRS J 6 Bright A_CustomMissile("PoisonousBruiserBall",56,-12)
    Goto See
    PBRS E 0 A_Jump(96, 20)
    PBRS EF 6 Bright A_FaceTarget
    PBRS F 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-40,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-30,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-20,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-10,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,0,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,10,0)
    PBRS G 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,20,0)
    PBRS G 0 A_Jump(96, 1)
    Goto See
    PBRS HI 6 Bright A_FaceTarget
    PBRS I 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,40,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,30,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,20,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,10,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,0,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-10,0)
    PBRS J 2 Bright A_CustomMissile("PoisonousBruiserBall2",56,0,-20,0)
    Goto See
    PBRS KL 6 Bright A_FaceTarget
    PBRS M 2 Bright A_CustomMissile("PoisonousBruiserFireSpawner",16,0,-15,0)
    PBRS M 2 Bright A_CustomMissile("PoisonousBruiserFireSpawner",16,0,0,0)
    PBRS M 2 Bright A_CustomMissile("PoisonousBruiserFireSpawner",16,0,15,0)
    Goto See
  Pain:
    PBRS N 5 Bright A_Pain
     Goto See
  Death:
    PBRE A 6 Bright A_Scream
    PBRE BCDEFG 4 Bright
    PBRE H 4 Bright A_Fall
    PBRE IJKLMNOP 4 Bright
    PBRE QRSTUV 4
    PBRE W -1
    Stop
  }
}

Actor PoisonousBruiserBall
{
  Radius 16
  Height 16
  Speed 18
  Damage (Random(60,100)) //26
  Species "Fiends"
  DamageType "Poison"
  Projectile
  +RANDOMIZE
  RenderStyle Add
  Alpha 0.9
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  Decal "Scorch"
  States
  {
  Spawn:
    PBB1 AABB 2 Bright A_SpawnItemEx("PoisonousBruiserBallTrail2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    Loop
  Death:
    PBB1 KLMNOPQRSTUVWX 3 Bright
    Stop
  }
}

Actor PoisonousBruiserBall2 : PoisonousBruiserBall
{
  Radius 8
  Height 8
  Speed 10
  Damage (Random(40,80)) //18
  Decal "BaronScorch"
  States
  {
  Spawn:
    PBB2 AB 6 Bright
    Loop
  Death:
    PBB2 CDEFGHI 3 Bright
    Stop
  }
}

