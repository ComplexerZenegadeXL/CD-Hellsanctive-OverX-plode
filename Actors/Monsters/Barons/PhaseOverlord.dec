Actor PhaseOverlord 16562
{ 
  //$Category Monsters/LCA
  //$Sprite BOS3A1C1
  //$Title "Phase Overlord"
  Health 1650 
  Radius 24 
  Height 64 
  Mass 1000 
  Speed 8 
  Species "Nobles"
  PainChance 20 
  DropItem "UltraSphere" 40 
  DropItem "ExtraArmor" 65 
  DropItem "BossLifeEssence" 210 
  DropItem "BossArmorBonusMax" 210 
  DamageFactor "NobleComet", 0.0
  Monster
  MeleeDamage 12
  Obituary "$CFPhaseOverlordObit"
  HitObituary "$CFPhaseOverlordHitObit"
  BloodColor "cf 00 b0"
  +NOTARGET
  +QUICKTORETALIATE
  +FLOORCLIP 
  +MISSILEMORE
  +MISSILEEVENMORE
  +NORADIUSDMG
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  SeeSound "PhaseOverlord/Sight" 
  PainSound "baron/pain" 
  DeathSound "PhaseOverlord/Death"
  MeleeSound "baron/melee"
  Tag "$CFPhOverlord"
  SpawnID 174
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States 
  { 
  Spawn: 
    BOS3 A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,5)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    TNT1 A 0 A_JumpIfInventory("IsInvisible",1,"UnPhase")
	BOS3 AX 14 A_Look 
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfInventory("IsInvisible",1,"See.Invisible")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BOS3 AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 AA 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 CC 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 DD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(26,"Phase")
	Loop
  See.Invisible:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	BOS3 AA 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 CC 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 DD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(8,"UnPhase")  //8
	Loop
  Rush:
	TNT1 A 0 A_JumpIfInventory("IsInvisible",1,"Rush.Invisible")
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SpawnItemEx("OverlordGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	BOS3 A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlordGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	BOS3 A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlorddGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlorddGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlordGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlordGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlorddGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("OverlorddGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	BOS3 D 1 A_Chase
	BOS3 D 1 A_Chase	
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")		
	Loop
  Rush.Invisible:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetTranslucent(0.2,0)
	TNT1 A 0 A_UnsetShootable
	BOS3 AABB 1 A_Chase("PhaseMelee","PhaseMissile")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	BOS3 CCDD 1 A_Chase("PhaseMelee","PhaseMissile")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PurpleWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 Healthing(1)
	TNT1 A 0 A_Jump(48,"See")
	Loop
  Phase:
    BOS3 A 4 A_FaceTarget
    BOS3 AAAA 1 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.8,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.6,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.4,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.2,0)
	//BOS3 AAAA 1 A_FadeOut(0.2)
	TNT1 A 0 A_GiveInventory("IsInvisible",1)
    //TNT1 A 0 A_HideThing
	TNT1 A 0 A_UnsetShootable
    Goto See.Invisible
  UnPhase:
	TNT1 A 0 A_UnsetShootable
	TNT1 A 0 A_PlaySound("phaseimp/telepUnPhaseUnPhaseort",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	BOS3 A 2 A_SetTranslucent(0.2,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.3,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.4,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.5,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.6,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.7,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.8,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.9,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(1,0)
	TNT1 A 0 A_TakeInventory("IsInvisible",1)
	//TNT1 A 0 A_UnhideThing
	TNT1 A 0 A_SetShootable
	Goto See
  Missile:
    TNT1 A 0 A_Jump(30,"Phase")
  MissileNoPhase:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
	BOS3 B 0 A_Jump(156,"PhazoLaser","Spread","Comet")   
  Normal:
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 EF 8 A_FaceTarget 
	TNT1 A 0 A_PlaySound("imp/attack")
	BOS3 G 0 A_CustomMissile("PhaseImpBall",28,0,-13)
    BOS3 G 0 A_CustomMissile("PhaseImpBall",28,0,0)
    BOS3 G 6 A_CustomMissile("PhaseImpBall",28,0,13)
	BOS3 ST 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	BOS3 U 0 A_CustomMissile("PhaseImpBall",28,0,-13)
    BOS3 U 0 A_CustomMissile("PhaseImpBall",28,0,0)
    BOS3 U 6 A_CustomMissile("PhaseImpBall",28,0,13)
	TNT1 A 0 A_Jump(88,"PhazoLaser")  
	Goto See
  Melee:
    TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 EF 8 A_FaceTarget 
    BOS3 G 8 A_CustomMeleeAttack(10*random(1,8),"baron/melee","None","Melee",1)
    Goto See 
  Melee2:
	BOS3 SSTT 4 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	BOS3 U 6 A_CustomMeleeAttack(10*random(1,8),"baron/melee","None","Melee",1)
	TNT1 A 0 A_Jump(64,"Melee3")
	Goto See
  Melee3:
	BOS3 HHII 4 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	BOS3 JJ 3 A_CustomMeleeAttack(10*random(1,8),"baron/melee","None","Melee",1)
	Goto See
  PhaseMelee:
	TNT1 A 0 A_PlaySound("phaseimp/teleport",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	BOS3 E 2 A_SetTranslucent(0.2,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 E 2 A_SetTranslucent(0.3,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 E 2 A_SetTranslucent(0.4,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 E 2 A_SetTranslucent(0.5,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 F 2 A_SetTranslucent(0.6,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 F 2 A_SetTranslucent(0.7,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 F 2 A_SetTranslucent(0.8,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 F 2 A_SetTranslucent(0.9,0)
	TNT1 A 0 A_TakeInventory("IsInvisible",1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetTranslucent(1,0)
	BOS3 G 6 A_CustomMeleeAttack(10*random(1,8),"baron/melee","None","Melee",1)
	BOS3 F 4
	TNT1 A 0 A_Jump(128,"Melee2")
	Goto See
  PhaseMissile:
	TNT1 A 0 A_PlaySound("phaseimp/teleport",6)
	TNT1 A 0 A_TakeInventory("IsInvisible",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	BOS3 A 2 A_SetTranslucent(0.2,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.3,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.4,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.5,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.6,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.7,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.8,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(0.9,0)
	TNT1 A 0 A_FaceTarget(45)
	BOS3 A 1 A_SetTranslucent(1,0)
	Goto MissileNoPhase
  PhazoLaser:
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 EF 2 A_FaceTarget
    BOS3 G 2 A_CustomMissile("PhazoLaser",28,0,0)	
	BOS3 ST 2 A_FaceTarget
    BOS3 U 2 A_CustomMissile("PhazoLaser",28,0,0)
	BOS3 EF 2 A_FaceTarget
    BOS3 G 2 A_CustomMissile("PhazoLaser",28,0,0)	
	BOS3 ST 2 A_FaceTarget
    BOS3 U 2 A_CustomMissile("PhazoLaser",28,0,0)
	BOS3 EF 2 A_FaceTarget
    BOS3 G 2 A_CustomMissile("PhazoLaser",28,0,0)	
	BOS3 ST 2 A_FaceTarget
    BOS3 U 2 A_CustomMissile("PhazoLaser",28,0,0)
	BOS3 EF 2 A_FaceTarget
    BOS3 G 2 A_CustomMissile("PhazoLaser",28,0,0)	
	BOS3 ST 2 A_FaceTarget
    BOS3 U 2 A_CustomMissile("PhazoLaser",28,0,0)	
	TNT1 A 0 A_Jump(88,"Spread")
	Goto See
  Spread:
	TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 HI 6 A_FaceTarget 
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,4)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,-4)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,2)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,-2)
    BOS3 J 4 A_CustomMissile("PhazoFastShot",28,0,0)
	BOS3 HI 6 A_FaceTarget 
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,4)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,-4)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,2)
	BOS3 J 0 A_CustomMissile("PhazoFastShot",28,0,-2)
    BOS3 J 4 A_CustomMissile("PhazoFastShot",28,0,0)
	TNT1 A 0 A_Jump(88,"Comet")
    Goto See	   
  Comet:
    TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	BOS3 HI 8 A_FaceTarget
    BOS3 J 0 A_Custommissile("PArchonComet",32,0,0)
	BOS3 J 0 A_Custommissile("PArchonComet",32,0,5)
	BOS3 J 0 A_Custommissile("PArchonComet",32,0,-5)
	BOS3 J 7 Bright A_Custommissile("PArchonComet",32,0,10)
    Goto See
  Melee:
    TNT1 A 0 A_SetUserVar("user_effect_type",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    TNT1 A 0 A_FadeIn(1.0)
	BOS3 EF 8 A_FaceTarget 
    BOS3 G 6 A_MeleeAttack
    BOS3 G 0 A_Jump (128,1)
	Goto See
    BOS3 ST 8 A_FaceTarget
    BOS3 U 6 A_MeleeAttack
    BOS3 G 0 A_Jump (64,1)
    Goto See
    BOS3 HI 8 A_FaceTarget
    BOS3 J 0 A_MeleeAttack
    BOS3 J 6 A_MeleeAttack
	Goto See
  Pain: 
    TNT1 A 0 A_JumpIfInventory("IsInvisible",1,2)
	TNT1 A 0 A_Jump(48,"Phase")
	BOS3 K 2 
    BOS3 K 2 A_Pain 
    Goto See 
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
	BOS3 L 8 A_SetTranslucent(1,0)
	BOS3 M 8 A_Scream 
	BOS3 N 8 
	BOS3 O 8 A_NoBlocking 
	BOS3 PQ 8 
	BOS3 R -1
	Stop
  XDeath:
	XARC A 5 A_SetTranslucent(1,0)
	XARC B 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	XARC B 5 A_XScream
	XARC C 5 A_NoBlocking
	XARC DEFGH 5
	XARC I -1
	Stop
  XRaise:
  Raise:
	Stop
  } 
}

Actor SummonedPhaseOverlord : PhaseOverlord { -COUNTKILL }

Actor IsInvisible : Inventory { Inventory.InterHubAmount 0 }

Actor PArchonComet
{
  Radius 8
  Height 12
  Speed 25
  Damage 20
  DamageType "NobleComet"
  Scale 1.0
  SpawnID 251
  Projectile
  RenderStyle Normal
  +THRUGHOST
  +FIREDAMAGE
  SeeSound "weapons/firbfi"
  DeathSound "weapons/hellex"  
  States
  {
  Spawn:
    LRCB AAAABBBBCCCC 1 Bright A_SpawnItemEx("PArchonCometTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  Death:
    LRCB J 0 Bright A_SetTranslucent (0.67,1)
    LRCB J 3 Bright
    LRCB K 3 Bright A_Explode(128,128,0)
    LRCB LMN 3 Bright
    Stop
  }
}

 Actor PArchonCometTrail
{   
  Radius 3
  Height 3
  Scale 0.75
  Speed 0
  Projectile
  RenderStyle Add
  +CLIENTSIDEONLY
  Alpha 0.67
  States
  {
  Spawn:
	TNT1 A Random(3,5)
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 3
    LRCB DEFGHI 3 Bright
    Stop
  Vanilla:
    TNT1 A 0
	Stop		  
  }
}
Actor OverlordGhostA
{
  Scale 1.1
  Radius 2
  Height 2
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +DONTSPLASH
  +THRUACTORS
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    BOS3 AAAAAAAAAA 2 A_FadeOut(0.10)
    Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor OverlorddGhostB : OverlordGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    BOS3 BBBBBBBBBB 2 A_FadeOut(0.10)
    Stop
  }
}

Actor OverlordGhostC : OverlordGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    BOS3 CCCCCCCCCC 2 A_FadeOut(0.10)
    Stop
  }
}

Actor OverlorddGhostD : OverlordGhostA
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    BOS3 DDDDDDDDDDD 2 A_FadeOut(0.10)
    Stop
  }
}

Actor PHellionSmoke
{
  +MISSILE
  +DONTSPLASH
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  Scale 0.4
  RenderStyle Normal
  States
  {
  Spawn:
	PMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor PHellionSmoke2 : PHellionSmoke { Scale 0.6 }

Actor PSoulSmoke : PHellionSmoke { Scale 0.12 }

Actor PHellionSmokeSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("PHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor PHellionSmokeAttackSpawner : RedParticleSpawner
{
  States
  {
  Spawn:   
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("PHellionSmoke2",frandom(-12,12),frandom(-12,12),frandom(12,18),0,0,frandom(6,9),0,SXF_CLIENTSIDE,0)
