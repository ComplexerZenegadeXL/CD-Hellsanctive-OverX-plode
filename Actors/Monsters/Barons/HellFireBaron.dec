Actor HellFireBaron : CFBaronOfHell 31042
{
  Health 2300
  PainChance 30
  Scale 1.1
  Speed 14
  PainChance "SoulToxic", 20
  PainChance "FatFlamer", 20
  PainChance "FiendFire", 20
  BloodColor "ff 5f 00"
  DamageFactor "NobleComet", 0.0
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  Species "Nobles"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "BigGasPickup" 128 200
  MeleeDamage 10
  Obituary "$CFHellFireBaronObit"
  HitObituary "$CFHellFireBaronHitObit"
  SeeSound "HellFireBaron/sight"
  PainSound "monsters/baronpain"
  DeathSound "HellFireBaron/Death"
  MeleeSound "baron/melee"
  Tag "$CFHfBar"
  +MISSILEEVENMORE
  +FASTMELEE
  -TELESTOMP
  +NOICEDEATH
  +DONTHARMSPECIES
  +QUICKTORETALIATE
  var int user_script;
  var int user_script_type;
  var int user_lowlag;
  States 
  { 
  Spawn:
    HFBY A 0
	TNT1 A 0 A_JumpIf(user_script == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,14)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",13)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HFBY AA 7 A_Look
	HFBI AA 7 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HFBY AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(70,"Rush")
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("HFBaronWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HFBY AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HFBaronWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HFBY BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HFBY CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HFBaronWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY DD 3 Bright A_Chase
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	HFBY A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	HFBY A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("HFBaronGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFBY D 1 A_Chase
	HFBY D 1 A_Chase	
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(80,"See")		
	Loop
  Missile:
	TNT1 A 0 A_Jump(128,"GiantBalls","Comet","Tracers","Spread","SeekerComets")
  Normal:
    HFBY EF 6 Bright A_FaceTarget
	HFBY G 0 A_CustomMissile("HFBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, -5)
	HFBY G 3 Bright A_CustomMissile("HFBall", 32, 0, 5)
	HFBY HI 6 Bright A_FaceTarget
	HFBY G 0 A_CustomMissile("HFBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, -5)
	HFBY G 3 Bright A_CustomMissile("HFBall", 32, 0, 5)
	TNT1 A 0 A_Jump(87,"GiantBalls","Comet","Tracers","Spread")
	Goto See
  Spread:
	HFBY KL 8 A_FaceTarget
	HFBY M 0 A_CustomMissile("HFBall", 32, 0, 0)
	HFBY M 0 A_CustomMissile("HFBall", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, -3)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, 6)
	HFBY M 0 A_CustomMissile("HFBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, 9)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, -9)
	TNT1 A 0 A_CustomMissile("HFBall", 32, 0, 12)
	HFBY M 7 Bright A_CustomMissile("HFBall", 32, 0, -12)
	TNT1 A 0 A_Jump(87,"GiantBalls")
	Goto See
  GiantBalls:
    HFBY EF 8 A_FaceTarget
	HFBY G 0 A_CustomMissile("BBall2", 32, 0, 0)
	HFBY G 0 A_CustomMissile("BBall2", 32, 0, 5)
	HFBY G 7 Bright A_CustomMissile("BBall2", 32, 0, -5)
	HFBY HI 8 A_FaceTarget
	HFBY J 0 A_CustomMissile("BBall2", 32, 0, 0)
	HFBY J 0 A_CustomMissile("BBall2", 32, 0, 5)
	HFBY J 7 Bright A_CustomMissile("BBall2", 32, 0, -5)
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    HFBY EF 6 Bright A_FaceTarget
	HFBY G 0 A_CustomMissile("Comet", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("Comet", 32, 0, -5)
	HFBY G 3 Bright A_CustomMissile("Comet", 32, 0, 5)
	HFBY HI 6 Bright A_FaceTarget
	HFBY G 0 A_CustomMissile("Comet", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("Comet", 32, 0, -5)
	HFBY G 3 Bright A_CustomMissile("Comet", 32, 0, 5)
	TNT1 A 0 A_Jump(87,"SeekerComets","Tracers")
	Goto See
  Tracers:
    HFBY ML 8 A_FaceTarget	
	HFBY K 0 A_CustomMissile("HFBaronTracer", 32, 0, 0)
	HFBY K 0 A_CustomMissile("HFBaronTracer", 32, 0, 5)
	HFBY K 0 A_CustomMissile("HFBaronTracer", 32, 0, -5)
	HFBY K 0 A_CustomMissile("HFBaronTracer", 32, 0, 10)
	HFBY K 8 Bright A_CustomMissile("HFBaronTracer", 32, 0, -10)
	Goto See
  SeekerComets:
    HFBY ML 8 A_FaceTarget	
	HFBY K 0 A_CustomMissile("SeekerComet", 60, 40, 0)
    HFBY K 3 Bright A_CustomMissile("SeekerComet", 60, -40, 0)
	HFBY K 0 A_CustomMissile("SeekerComet", 60, 40, 0)
	HFBY K 3 Bright A_CustomMissile("SeekerComet", 60, -40, 0)
	HFBY K 0 A_CustomMissile("SeekerComet", 60, 40, 0)
	HFBY K 3 Bright A_CustomMissile("SeekerComet", 60, -40, 0)
	Goto See
  Melee:
    HFBY EF 6 A_FaceTarget
	HFBY G 4 A_MeleeAttack
	Goto See
  Pain:
    TNT1 A 0 A_Jump(87,"PainMissile")
	HFBY N 6 A_Pain
	Goto See
  PainMissile:
    HFBY N 6 Bright A_Pain
    Goto Missile
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
    HFBY O 7
    HFBY P 6 A_Scream 
    HFBY Q 5 A_Fall 	
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HFBaronLavaMist",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
    HFBY R 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBY ST 4
    HFBY U -1
    Stop 
  XDeath:
	HFBX A 5
	HFBX B 5 A_GiveInventory("XDeathCheck",1)
	HFBX C 4 A_XScream
	TNT1 AAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("HFBaronLavaMist",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	HFBX D 4 A_SpawnItemEx("OrangeGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBX E 3 A_Fall
	HFBX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBX GH 3
	HFBX I -1
	Stop 	
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	HFBY TSRQPO 6
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	HFBX IHGFEDCBA 5
	Goto See
  }
}

Actor SummonedHellFireBaron : HellFireBaron { -COUNTKILL  }

Actor HFBaronLavaMist : HFLavaMist
{
  DamageType "NobleComet"
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("HFbaronLava")
    Stop
  } 
}

Actor HFBaronLava : HFLava { DamageType "NobleComet" }

Actor HellFireBaronFlameSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_SpawnItemEx("CardinalFire",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 1
    Stop
  }
}

Actor FlameAuraSpawner : HellFireBaronFlameSpawner
{
  Species "Player"
  -CLIENTSIDEONLY
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 AAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("AuraFire",frandom(-128,128),frandom(-128,128),0,0,0,frandom(1,3),0,SXF_NOCHECKPOSITION|SXF_SETMASTER ,0)
    TNT1 A 1
    Stop
  }
}

Actor HFBaronGhost
{
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    HFBY A 2 A_FadeOut(0.09)
    Loop
  }
}
Actor HFBaronWalkFire
{
  Scale 1.4
  Speed 0
  RenderStyle Add
  Alpha 0.75
  Damage 0
  +NOCLIP
  +MISSILE
  +DROPOFF
  +RANDOMIZE
  +DONTSPLASH
  +NOTELEPORT
  +DONTHURTSPECIES
  +THRUSPECIES
  Species "Nobles"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 10
    HFWF ABC 3 Bright
    TNT1 A 0 A_Jump(191,3)
    TNT1 A 0 A_CustomMissile("HFBaronWalkFire", 0, 24, 0)
    TNT1 A 0 A_CustomMissile("HFBaronWalkFire", 0, -24, 0)
    HFWF DEFGHIJKLMNO 3 Bright
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}
Actor HFBall : PBall
{
  Speed 20
  FastSpeed 28
  Damage (Random(35,45)) //10
}

Actor HFBaronTracer
{
  Radius 5
  Height 5
  Damage (Random(25,40))  //9
  RenderStyle Add
  Alpha 0.65
  Projectile
  +FLOORHUGGER
  +DONTSPLASH
  -NOGRAVITY
  Speed 25
  FastSpeed 30
  DamageType "NobleComet"
  Obituary "$CFHFBaronTracerObit"
  Seesound "weapons/diasht"
  DeathSound "weapons/firex3"   
  States
  {
  Spawn:
    TNT1 A 0 A_PlaySound("monster/ambientfire2")
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)	
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    FTRA K 4 Bright
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    FTRA L 4 Bright A_Explode(32, 64)
    FTRA MNO 3 Bright
    Stop
  }
}

Actor HellFireBaron2 : HellFireBaron
{
  Species "Cybers"
  DamageFactor "HFCyber", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "CadaverRocket", 0.0
  +THRUSPECIES
  -COUNTKILL
  States
  {
  Death: 
    HFBY O 7
    HFBY P 6 A_Scream 
    HFBY Q 5 A_Fall 	
    HFBY R 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBY ST 4
    HFBY U -1 
    Stop 
  XDeath: 
	HFBX AB 5
	HFBX C 4 A_XScream
	HFBX D 4 A_SpawnItemEx("OrangeGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBX E 3 A_Fall
	HFBX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFBX GH 3
	HFBX I -1 
	Stop
  }
}