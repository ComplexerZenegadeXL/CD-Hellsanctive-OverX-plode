Actor Wrathlord : CFBaronofHell
{ 
  Health 2000
  Radius 24
  Height 64
  Mass 1000
  Speed 12
  PainChance 65
  Monster
  Scale 1.1
  Species "Nobles"
  Obituary "$CFWrathlordObit"
  HitObituary "$CFWrathlordHitObit"
  SeeSound "cbaron/sight" 
  PainSound "cbaron/pain"
  DeathSound "cydes/death"
  ActiveSound "cbaron/active"
  DamageFactor "NobleComet", 0.0
  DamageFactor 0.7
  DropItem "LifeEssence" 256
  DropItem "ArmorBonusMax" 256
  DropItem "BossLifeEssence" 192 25
  DropItem "BossArmorBonusMax" 192 1
  DropItem "MissilePickup" 256
  DropItem "MissileBoxPickup" 128
  DropItem "NewCellPackPickup" 128
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "RailgunGiver" 190
  DropItem "RocketLauncherGiver" 150
  DropItem "GrenadeLauncherGiver" 120
  DropItem "BFG10KGiver" 70
  DropItem "HellstormBFGGiver" 50
  DropItem "HSBFGUpgrade" 5 1
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  +QUICKTORETALIATE
  +NOTARGET
  +DONTHURTSPECIES
  Tag "$CFWrathL"
  var int user_loop;
  States 
  { 
  Spawn: 
    WRTS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	WRTS AA 7 A_Look
    WRTI AA 7 A_Look
    Loop 
  See:
    WRTS AABB 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    WRTS CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Melee:
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_JumpIfCloser(150,"Flamethrowers")
	TNT1 A 0 A_JumpIfCloser(300,"Grenadier")
    TNT1 A 0 A_Jump(128,"Rockets","HomingRockets")
	TNT1 A 0 A_Jump(64,"BFG15K","BFG10K","RailgunV2","Wrath","HellStorm")
  Normal:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    WRTS EE 10 A_FaceTarget
	WRTS E 2 A_FaceTarget
	WRTS E 1
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("RailgunImpactRed",35,20)
    WRTS F 10 Bright A_CustomRailgun(Random(41, 61),20, "Red", None, 1, 1, 0, "BruiserRailPuff")
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("RailgunImpactRed",35,20)
	WRTS F 5 Bright A_CustomRailgun(Random(41, 61),20, "Red", None, 1, 1, 0, "BruiserRailPuff")
	WRTS EE 10 A_FaceTarget
	WRTS E 2 A_FaceTarget
	WRTS E 1
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("RailgunImpactRed",35,20)
    WRTS F 10 Bright A_CustomRailgun(Random(41, 61),20, "Red", None, 1, 1, 0, "BruiserRailPuff")
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("RailgunImpactRed",35,20)
	WRTS F 5 Bright A_CustomRailgun(Random(41, 61),20, "Red", None, 1, 1, 0, "BruiserRailPuff")
    WRTS E 20
	TNT1 A 0 A_Jump(164,"Rockets","HomingRockets","BFG15K","BFG10K","Flamethrowers")
	TNT1 A 0 A_Jump(50,"Wrath","HellStorm")
	Goto See
  Grenadier:
	WRTS E 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	WRTS FF 4 Bright A_CustomMissile("CydestroyerGrenade",35,20,frandom(-4,4))
	WRTS E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	WRTS FF 4 Bright A_CustomMissile("CydestroyerGrenade",35,20,frandom(-4,4))
	WRTS E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	WRTS FF 4 Bright A_CustomMissile("CydestroyerGrenade",35,20,frandom(-4,4))
	WRTS E 12 A_FaceTarget	
	Goto See		
  Rockets:
    WRTS E 10 A_FaceTarget 
    WRTR AA 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
    WRTS E 10 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS E 10 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS E 10 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS E 10 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
    WRTS E 10
	TNT1 A 0 A_Jump(128,"HomingRockets","BFG15K","BFG10K")
	TNT1 A 0 A_Jump(32,"Wrath","HellStorm")
    Goto See
  HomingRockets:
    WRTS E 10 A_FaceTarget
	WRTR AA 5 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
    WRTS E 10 A_FaceTarget
	WRTR AA 5 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS E 10 A_FaceTarget
	WRTR AA 5 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
    WRTS E 10
	TNT1 A 0 A_Jump(128,"BFG15K","BFG10K","DTR")
	TNT1 A 0 A_Jump(32,"Wrath","HellStorm")
    Goto See
  Wrath:
    TNT1 A 0 A_ChangeFlag("NoPain", 1)
    WRTS E 2 Bright A_PlayWeaponSound("cydes/mischrg")
	WRTS E 1 Bright A_FaceTarget
	WRTS EEEEEEEEEEEEEEE 4 Bright A_FaceTarget
	WRTS F 1 Bright A_FaceTarget
	WRTS F 0 A_PlaySound("smissile/fire")
	WRTS F 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_FaceTarget
	WRTS F 0 A_PlaySound("smissile/fire")
	WRTS F 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_FaceTarget
	WRTS F 0 A_PlaySound("smissile/fire")
	WRTS F 4 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("CyNobleRocket",35,20,0,0)
	WRTS F 1 Bright A_FaceTarget
	WRTS F 0 A_PlaySound("smissile/fire")
	WRTS F 4 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 4 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 1 Bright A_FaceTarget
	WRTS F 0 A_PlaySound("smissile/fire")
	WRTS F 4 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 1 Bright A_CustomMissile("BruiserMissile",35,20,0,0)
	WRTS F 1 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NoPain", 0)
	WRTS E 20
	TNT1 A 0 A_Jump(128,"Wrath")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    WRTS E 18 A_FaceTarget
	WRTS E 6 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("Cybruiser15K",35,20,frandom(-4,4))
	WRTS E 4 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("Cybruiser15K",35,20,frandom(-4,4))
	WRTS E 4 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("Cybruiser15K",35,20,frandom(-4,4))
	WRTS E 4 A_FaceTarget
	WRTR AA 4 Bright A_CustomMissile("Cybruiser15K",35,20,frandom(-4,4))
	WRTS E 4 A_FaceTarget
    WRTR AA 4 Bright A_CustomMissile("Cybruiser15K",35,20,frandom(-4,4))
	WRTS E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"BFG10K","RailgunV2")
	Goto See	 
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    WRTS E 18 A_FaceTarget
	WRTS E 6 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("weapons/bfg15kfire")
	WRTR AA 4 Bright A_CustomMissile("Cy10K",35,20,frandom(-4,4))
	WRTS E 8 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("weapons/bfg15kfire")
	WRTR AA 4 Bright A_CustomMissile("Cy10K",35,20,frandom(-4,4))
	WRTS E 8 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("weapons/bfg15kfire")
	WRTR AA 4 Bright A_CustomMissile("Cy10K",35,20,frandom(-4,4))
	WRTS E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"RailgunV2")
	Goto See
  DTR:
    WRTS E 18 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTRLoop:
	TNT1 A 0 A_PlaySound("weapons/demontechfire")
    WRTS F 6 Bright A_CustomMissile("CyDemonTechProjectile",35,20,frandom(-1,1),0)
	WRTS F 3 Bright A_CustomMissile("CyDemonTechProjectile",35,20,frandom(-1,1),0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,1)
	Goto DTRLoop
	WRTS E 20 A_PlaySound("weapons/demontechsteam")
	TNT1 A 0 A_Jump(128,"RailgunV2")
	Goto See
  RailgunV2:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    WRTS EE 10 A_FaceTarget
	WRTS E 2 A_FaceTarget
	WRTS E 1
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	WRTS F 5 Bright A_CustomMissile("CydestroyerRail",35,20)
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	WRTS F 5 Bright A_CustomMissile("CydestroyerRail",35,20)
    WRTS E 20
	Goto See
  Flamethrowers:
    TNT1 A 0 A_Jump(82,"Normal")
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	WRTS EE 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fatsofire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FlamethrowersLoop:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CydestroyerFlamethrower", 35, 20, frandom(-6, 6), CMF_AIMOFFSET)
    WRTR A 1 Bright A_CustomMissile("CydestroyerFlamethrower", 35, 20, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 21,1)
	Goto FlamethrowersLoop
	WRTS EE 12
	Goto See
  HellStorm:
	TNT1 A 0 A_PlaySound("weapons/Hcharge10k")
    WRTS EEEEEE 5 A_FaceTarget
	WRTS E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HellStormLoop:
	TNT1 A 0 A_PlaySound("weapons/Hbfg10kfire",6)
    WRTR A 4 Bright A_CustomMissile("HSBFG10kShotWrath",35,20,frandom(-4,4))
	WRTS E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/Hbfg10kfire",6)
    WRTR A 4 Bright A_CustomMissile("HSBFG10kShotWrath",35,20,frandom(-4,4))
	WRTS EE 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto HellStormLoop
	WRTS E 20 A_PlaySound("weapons/Hbfg10kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"RailgunV2")
	Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"MissilePain")
    WRTS J 4 A_Pain
    Goto See
  MissilePain:
    WRTS J 4 A_Pain
    Goto Missile	
  XDeath:
  Death: 
    WRTD K 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WRTD LLLL 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	WRTD MMMM 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WRTD NNN 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WRTD OOO 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    WRTD P 4 Bright A_NoBlocking
    WRTD Q 3 Bright 
	WRTD R 3
	WRTS S 3
    WRTS T -1
    Stop
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    WRTS TS 4
	WRTD RQPONMLK 4
	Goto See
  } 
}

Actor SummonedWrathlord : Wrathlord { -COUNTKILL }