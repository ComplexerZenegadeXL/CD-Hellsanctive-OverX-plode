Actor MiniDeathBall : CyberGuruBall
{
  Obituary "$CFMiniDeathBallObit"
  Species "Nobles"
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5) 
	Goto Death
  Death:
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_Explode(1024,192,0,1)
	TNT1 A 0 A_BFGSpray("MiniGuruSpray",15,20)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("MiniGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("MiniGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("MiniCyberGuruSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),0,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("MiniGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("MiniGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,0,0)
	Stop
  }
}

