Actor LegendaryCyberNoble : CFBaronOfHell 16511
{ 
  //$Category Monsters/LCA
  //$Sprite LCBSA1
  //$Title "Legendary Cyber Noble"
  Health 2300
  Radius 24
  Height 64
  Mass 1500
  Speed 8
  PainChance 45 
  +NORADIUSDMG
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE
  +MISSILEMORE
  +MISSILEEVENMORE  
  +NOICEDEATH
  +DONTGIB
  +FASTMELEE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NOFEAR
  +NOTELEFRAG
  Scale 1.23
  SeeSound "lcnoble/see"
  PainSound "lcnoble/pain"
  DeathSound "lcnoble/death"
  ActiveSound "lcnoble/active"
  MeleeSound "baron/melee"
  MeleeDamage 18
  BloodColor "Blue"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  DamageFactor "NobleComet", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  Species "Nobles"
  Obituary "%$CFLegendaryCyberNobleObit"
  HitObituary "$CFLegendaryCyberNobleHitObit"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendarySphere" 192
  DropItem "LDemonAmmoBoxPickup" 256
  DropItem "LDemonAmmoPickup" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 128
  //DropItem "LegendaryAssaultShotgunGiver" 128
  //DropItem "LegendaryBFG10KGiver" 32
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 128
  DropItem "LegendaryRandomSphere" 16
  Tag "$CFLegNoble"
  var int user_missile;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  var int user_loop;
  States
  {
  Spawn: 
    LCBS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
  Idle:
    LCBS AAZZ 7 Bright A_Look
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LCBS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,14)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	LCBS AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCBS BB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCBS CC 3 Bright A_Chase
	TNT1 A 0 A_Playsound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LCBS DD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(32,"Teleport")
	Goto See
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	LCBS A 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	LCBS A 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LCBS B 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	LCBS B 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	LCBS C 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	LCBS C 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase  
	TNT1 A 0 A_Playsound("monster/bruwlk")
	LCBS D 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	LCBS D 2 Bright A_SpawnItemEx("LCNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_Jump(24,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Teleport:
    LCBS P 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LCBS PPPPPPPPPP 1 A_FadeOut(0.1,0)
	LCBS P 2 
	LCBS EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LCBS P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LCBS PPPPPPPPPPP 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LCBS P 1 Bright A_SetShootable
    Goto See		
  Pause:
    TNT1 A 0 A_PlaySound("lasgguy/asgout")
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0,frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LCBS E 5 Bright A_PlaySound("lasgguy/asgin") 
	LCBS E 10 Bright A_PlaySound("LShotgun/Cock")
	Goto See
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpifCloser(350,"LegendaryAsg")
	TNT1 A 0 A_Jump(127,"Hugger","Rage","BestAttack","Rain","Rockets","Seekers","BFG10K","Railgun","RocketRage","BestAttack2","LegCannon2","LegCannon1")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(9,"MinionSummoner")
	TNT1 A 0 A_Jump(100,"BlueComet","4Comets")
  Normal:
	LCBS PQ 5 Bright A_FaceTarget
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,-8)
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,-4)
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,4)
	LCBS R 5 Bright A_CustomMissile("LegNobleBall",40,0,0)
	LCBS PQ 5 Bright A_FaceTarget
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,-8)
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,-4)
	LCBS R 0 A_CustomMissile("LegNobleBall",40,0,4)
	LCBS R 5 Bright A_CustomMissile("LegNobleBall",40,0,0)	
	TNT1 A 0 A_Jump(127,"Rockets","Seekers")
	Goto See
   LegendaryAsg:
    LCBS E 5 Bright A_FaceTarget
	LCBS E 6 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing", 0, 32, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 Bright A_CustomMissile("LegendaryBlueTracer",frandom(32,38),0,frandom(6,-6),0)
	TNT1 A 0 Bright A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	LCBS F 2 Bright A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
    TNT1 A 0 A_Jump(45,"Pause")
    TNT1 A 0 A_SpidRefire
	Goto LegendaryAsg+1
  Hugger:
    LCBS RQ 9 Bright A_FaceTarget
	LCBS PPPP 2 Bright A_FaceTarget
	LCBS P 0 A_CustomMissile("LegNobleBall3",38,-20,0)
    LCBS P 0 Bright A_CustomMissile("LegNobleBall3",38,-20,0)
	LCBS PPPP 2 Bright A_FaceTarget
	TNT1 A 0 A_Jump(80,"BlueComet")
    Goto See	
  BlueComet:
    LCBS PQ 7 Bright A_FaceTarget
	LCBS R 2 Bright A_CustomMissile("LegNobleComet", 38, 0, 0)
	LCBS R 0 A_CustomMissile("LegNobleComet", 38, 0, 6)
	LCBS R 4 Bright A_CustomMissile("LegNobleComet", 38, 0, -6)
    LCBS PQ 7 Bright A_FaceTarget
	LCBS R 2 Bright A_CustomMissile("LegNobleComet", 38, 0, 0)
	LCBS R 0 A_CustomMissile("LegNobleComet", 38, 0, 6)
	LCBS R 4 Bright A_CustomMissile("LegNobleComet", 38, 0, -6)
	TNT1 A 0 A_Jump(80,"4Comets")
    Goto See
   4Comets:
    LCBS PQ 8 Bright A_FaceTarget
	LCBS R 0 A_CustomMissile("BigBlueComet", 38, 0, 0)
	LCBS R 0 A_CustomMissile("BigBlueComet", 38, 0, -5)
	LCBS R 0 A_CustomMissile("BigBlueComet", 38, 0, 5)
	LCBS R 7 Bright A_CustomMissile("BigBlueComet", 38, 0, 10)
	TNT1 A 0 A_Jump(127,"Rage")
	Goto See
  Rage:	
    LCBS Q 1 Bright A_PlaySound("lcnoble/see")
	LCBS Q 1 Bright A_FaceTarget
	LCBS Q 1 Bright A_SetUserVar("user_missile",0)
    LCBS RQ 8 Bright
  Raging:
    LCBS Q 0 A_JumpIf(user_missile >= 28,"See")	 
    LCBS Q 0 A_SetUserVar("user_missile",user_missile+1)
    LCBS QQ 0 Bright A_CustomMissile("LegNobleBall3Small",0,0,frandom(0,360))	
    LCBS Q 4 Bright
    Loop
  BestAttack:
    LCBS Q 1 Bright A_PlaySound("lcnoble/see")
    LCBS P 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LCBS PPPPPPQQQQQQ 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LCBS R 1 Bright A_CustomMissile("FakeLegNobleBall4",38,0,6)
	LCBS R 0 Bright A_CustomMissile("FakeLegNobleBall4",38,0,-6)
    LCBS R 8 Bright A_CustomMissile("LegNobleBall4",38,0,0)
	TNT1 A 0 A_Jump(60,"BestAttack2")
    Goto See
  BestAttack2:
    LCBS E 1 Bright A_PlaySound("lcnoble/see")
    LCBS E 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LCBS EEEEEEEEEEEF 6 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("star/fire")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    LCBS F 8 Bright A_CustomMissile("LegCyberKnightBlueStar",40,6,0)
    Goto See
  LegCannon1:
    LCBS E 0 Bright A_FaceTarget
	LCBS E 15 Bright A_PlaySound("legendarycannon/charge")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegCannon1Loop:
	TNT1 A 0 A_PlaySound("legendarycannon/fire")
	LCBS F 2 Bright A_CustomMissile("LegendaryCYNCannonProj",40,26,0,0)
    LCBS EE 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_Jump(90,"LegCannon2")
	TNT1 A 0 A_Jump(87,"Seekers","BFG10K","Railgun")
  LegCannon2:
    LCBS E 0 Bright A_FaceTarget
	LCBS E 15 Bright A_PlaySound("legendarycannon/charge")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegCannon2Loop:
    LCBS F 2 Bright A_CustomMissile("LegendaryCYKCannonBall",40,26,0,0)
    LCBS EE 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	TNT1 A 0 A_PlaySound ("legendarycannon/steam")
	TNT1 A 0 A_CustomMissile("LegendaryCannonSmoke",35,26,0,0)
	TNT1 A 0 A_Jump(87,"Seekers","BFG10K","Railgun")
	Goto See
  Rain:
    LCBS P 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    LCBS PPQQ 7 Bright A_FaceTarget
    LCBS Q 0 A_CustomMissile("BlueRainCometNull",32,0,200)
    LCBS Q 0 A_CustomMissile("BlueRainCometNull",32,0,90)
    LCBS Q 0 A_CustomMissile("BlueRainCometNull",32,0,-90)	
    LCBS Q 8 Bright A_CustomMissile("BlueRainCometNull",32,0,0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    LCBS QQQQQQQQQQQQQQQQQQQQQ 6 Bright A_FaceTarget
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    Goto See
  Rockets:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  RocketsLoop:
	LCBS E 4 Bright A_FaceTarget
    LCBS F 3 Bright A_CustomMissile("LegendaryRocket",40,26,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_Jump(87,"Seekers","BFG10K","Railgun")
    Goto See
  Seekers:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekersLoop:
	LCBS E 4 Bright A_FaceTarget
    LCBS F 3 Bright A_CustomMissile("LegendaryHomingRocket",40,26,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_Jump(87,"BFG10K","Railgun","RocketRage")
    Goto See
  RocketRage:
  	TNT1 A 0 A_Jump(128,8)
    LCBS EE 2 Bright A_FaceTarget
    LCBS F 0 A_CustomMissile("LegendaryRocket", 40, 26, frandom(-6, 6))
	LCBS FF 2 Bright A_FaceTarget
	TNT1 A 0 A_CposRefire
    TNT1 A 0 A_Jump(10,"See","Hugger","Rage","BestAttack","Rain","Rockets","Seekers","BFG10K","Railgun","BestAttack2")
	Goto RocketRage
	LCBS EE 2 Bright A_FaceTarget
    LCBS F 0 A_CustomMissile("LegendaryHomingRocket", 40, 26, frandom(-6, 6))
	LCBS FF 2 Bright A_FaceTarget
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_Jump(10,"See","Hugger","Rage","BestAttack","Rain","Rockets","Seekers","BFG10K","Railgun","BestAttack2")
	Goto RocketRage	
  Railgun:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    LCBS E 25 Bright A_FaceTarget
    LCBS F 5 Bright A_CustomMissile("LegendaryCyberRail",40,26,0,0)
	LCBS E 10 Bright A_FaceTarget
    LCBS F 5 Bright A_CustomMissile("LegendaryCyberRail",40,26,0,0)
	Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	LCBS E 18 Bright A_FaceTarget
	LCBS E 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	LCBS F 3 Bright A_CustomMissile("Legendary10KProjectile",40,26,frandom(-4, 4))	
	LCBS E 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	LCBS E 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)	
	Goto See
  MinionSummoner:
    LCBS P 1 Bright A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_PlaySound("monster/brusit")
	LCBS P 54 Bright
	TNT1 A 0 A_Playsound ("hk/summon")
	TNT1 A 0 A_CustomMissile("CyberNobleSummoner",20,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("CyberNobleSummoner",20,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("CyberNobleSummoner",20,0,225,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("CyberNobleSummoner",20,0,305,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	LCBS P 25 Bright
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See	
  Melee:
    LCBS PQ 6 Bright A_FaceTarget
    LCBS R 6 Bright A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(8,"Rage")	
  	TNT1 A 0 A_Jump(42,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile","Rage2")
    LCBS H 4 Bright A_Pain
    Goto See
  Rage2:
	LCBS H 4 Bright A_Pain
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1)
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 Bright A_PlaySound("brain/spit")
	LCBS RQ 5 Bright
	LCBS PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 1 Bright A_SpawnItemEx("LegCyNobleSpike",frandom(-600,600),frandom(-600,600),0,0,0,0,SXF_NOCHECKPOSITION)
	LCBS P 5 Bright
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto 4Comets 
  PainMissile:
    LCBS H 4 Bright A_Pain
    Goto Missile	
  XDeath:
  Death:
    LCBS I 0 A_Scream
	LCBS IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII 2 Bright A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 A 0 A_SpawnItemEx("MiniDeathBall")
	LCBS JJJKKK 2 Bright A_CustomMissile ("PainfulDeathKaboom", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    LCBS L 4 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
    LCBS MN 3 Bright
    LCBS O -1
    Stop
  XRaise:
  Raise:
	Stop
  } 
}

Actor LCNGhost
{
  Scale 1.22
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LCBS A 2 A_FadeOut(0.09)
    Loop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor LegCyNobleSpike : DukeFire
{
  +EXTREMEDEATH
  +NOTIMEFREEZE
  DamageType "Legendary"
  Scale 3
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySound("monsters/hellionflame")
	BTRD AB 2 Bright
    BTRD C 10 Bright A_Explode(38,92,0)
	BTRD DEFGHIJ 1 Bright 
    Stop
  }
}

