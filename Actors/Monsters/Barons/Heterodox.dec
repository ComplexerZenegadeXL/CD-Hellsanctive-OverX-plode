  Alpha 0.86
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	NEBL ABABAB 1 Bright A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
