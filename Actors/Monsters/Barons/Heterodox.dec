Actor Heterodox : CFBaronofHell
{
  Monster
  Health 1600
  Height 64
  Radius 24
  Mass 1000
  Speed 6
  BloodColor "Black"
  PainChance "Mine", 128
  PainChance 28
  MeleeDamage 18
  +BOSSDEATH
  +NOTARGET
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FASTMELEE
  +DONTHARMSPECIES
  Species "Nobles"
  Damagetype "NobleComet"
  DamageFactor "Acid", 0.3
  DamageFactor "Fire", 0.5
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DamageFactor "UBDTR", 0.0
  DamageFactor "DarkbruiserBFG10K", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "AfritComet", 0.0
  DropItem "BossLifeEssence", 200, 25
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "ModdedSoulSphere", 64
  SeeSound "diablo2/goatman/sight"
  ActiveSound "diablo2/goatman/idle"
  PainSound "diablo2/goatman/pain"
  DeathSound "Goat/death"
  MeleeSound "baron/melee"
  Obituary "$CFHeterodoxObit"
  HitObituary "$CFHeterodoxHitObit"
  Tag "$CFHeter"
  var int user_lowlag;
  States
  {
  Spawn:
	AZEW A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	AZEW A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	AZEW AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("Tic",999)
	AZEW AAAABBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	AZEW CCCCDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(67,"Rush")
	Loop
  Rush:
	AZEW A 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_FastChase
	AZEW A 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase("Melee","")
	AZEW A 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	AZEW B 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	AZEW B 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase("Melee","")
	AZEW B 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	AZEW C 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	AZEW C 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase("Melee","")
	AZEW C 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase("Melee","")
	AZEW D 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	AZEW D 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	AZEW D 1 A_SpawnItemEx("AzFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_Chase("Melee","")
	TNT1 A 0 A_Jump(34,"See")
	Loop
  Melee:
	AZEA AAABBBCC 1 A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	AZEA CCCCC 1 A_JumpIfCloser(64,"Alt")
	AZEA BAA 3
	Goto See
  Alt:
	AZEA DDDDEEEFF 1 A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	TNT1 A 0 A_JumpIfInventory("Tic",15,"AltEnd")
	TNT1 A 0 A_GiveInventory("Tic",1)
	AZEA FFFF 1 A_JumpIfCloser(64,"Melee")
  AltEnd:
	AZEA EDD 3
	Goto See
  Missile:
	TNT1 A 0 A_TakeInventory("Tic",999)
	TNT1 A 0 A_Jump(120,"Homers")
	TNT1 A 0 A_Jump(76,"BigSpread","DarkFireballs")
	TNT1 A 0 A_Jump(30,"AcidBall")
  Normal:
	AZEA ABC 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("DamnedBall2",32,5,frandom(0,8))
	AZEA CDEF 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("DamnedBall2",32,-5,frandom(-8,0))
	AZEA F 7
	Goto See
  Homers:
	AZEA ABC 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DamnedHomer",32,5,0)
	AZEA CDEF 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DamnedHomer",32,-5,0)
	AZEA F 7
	Goto See
  BigSpread:
	AZEA ABC 3 Bright A_FaceTarget
	TNT1 AAAAAA 0 A_CustomMissile("DamnedBall2",32,5,frandom(0,11))
	AZEA CDEF 3 Bright A_FaceTarget
	TNT1 AAAAAA 0 A_CustomMissile("DamnedBall2",32,-5,frandom(-11,0))
	AZEA F 7
	Goto See
  DarkFireBalls:
	AZEA ABC 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("HeterodoxBall",32,5,frandom(0,11))
	AZEA CDEF 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("HeterodoxBall",32,-5,frandom(-11,0))
	AZEA F 7
	Goto See
  AcidBall:
	AZEA ABC 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeterodoxAcid",32,5,0)
	AZEA CDEF 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeterodoxAcid",32,-5,0)
	AZEA F 7
	Goto See
  Pain:
	AZEP A 2 A_Pain
	AZEP A 3
	Goto See
  XDeath:
  Death:
	AZED A 2
	TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,32,0,0,0,0,SXF_CLIENTSIDE)
	AZED B 5 A_Scream
	AZED C 5 A_Fall
	AZED D 4
	AZED E 4 A_BossDeath
	AZED F 3 A_RemoveChildren
	AZED G -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	AZED GFEDCBA 5
	Goto See
  }
}

Actor SummonedHeterodox : Heterodox { -COUNTKILL }

Actor CFHalfDamage : PowerDamage { Damagefactor "Normal", 0.5 }

Actor HeterodoxCurse : PowerUpGiver
{
  +INVENTORY.QUIET
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  Powerup.Color "Black" 0.5
  PowerUp.Type "CFHalfDamage"
  PowerUp.Duration -5
}

Actor AzFX
{
  Height 64
  Radius 1
  RenderStyle Translucent
  Alpha 0.75
  +NONSHOOTABLE
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	AZEW AABBCCDD 1 A_FadeOut(0.09,0)
	AZEW D 1 A_FadeOut(0.09,1)
	Stop
  }
}

Actor HeterodoxAcid : BaronBall
{
  FastSpeed 25
  Damage (Random(10,20))
  Species "Nobles"
  DamageType "NobleComet"
  SeeSound "Whiteballssee"
  DeathSound "Whiteballsdeth"
  +PIERCEARMOR
  +NOEXPLODEFLOOR
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Scale 1.28
  Speed 19
  Decal "DoomImpScorch"
  States
  {
  Spawn:	
    ANFB A 1 Bright A_SpawnItemEx("HeteracidTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE,0)	
    TNT1 A 0 A_Weave(0,4,0,1)
	Loop
  Death:
	TNT1 AAA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_RadiusGive("AcidDamageHeterodox",100,RGF_PLAYERS,1)
    TNT1 A 0 A_Explode(18,120,0,100)
	ANFB CDE 3 Bright
    Stop
  }
}

Actor AcidDamageHeterodox : CustomInventory
{
 +INVENTORY.ALWAYSPICKUP
 States
  {
   PickUp:
	"####" "#" 0 A_JumpIfInventory("MeltCount",1,2)
	"####" "#" 0 ACS_NamedExecuteAlways("Melt")
	"####" "#" 0 A_GiveInventory("MeltCount",3)
	Stop
   PickUp.No:
    "####" "#" 0
	Stop
  }
}
Actor PestilenceAcid : HeterodoxAcid
{
  +SEEKERMISSILE
  States
  {
  Spawn:
    ANFB A 1 Bright A_SpawnItemEx("HeteracidTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE,0)	
    TNT1 A 0 A_Weave(0,4,0,1)
    ANFB A 1 Bright A_SpawnItemEx("HeteracidTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE,0)	
    TNT1 A 0 A_Weave(0,4,0,1)
	TNT1 A 0 A_SeekerMissile(9,14,SMF_LOOK)
	Loop
  }
}

Actor HeterodoxBall : DoomImpBall
{
  Speed 22
  FastSpeed 25
  Scale 1.28
  Renderstyle Translucent
  Alpha 0.86
  Decal "DoomImpScorch"
  BounceCount 3
  BounceType Hexen
  ReactionTime 525
  Damage (Random(10,30))
  +PIERCEARMOR
  +HEXENBOUNCE
  +SEEKERMISSILE
  +DONTHARMSPECIES
  +FORCEXYBILLBOARD
  +HITTRACER
  Species "Nobles"
  DamageType "NobleComet"
  States
  {
  Spawn:
	NEBL A 1 Bright A_SpawnItemEx("HeterodoxBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	NEBL B 1 Bright A_SpawnItemEx("HeterodoxBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	NEBL C 1 Bright A_SpawnItemEx("HeterodoxBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	NEBL D 1 Bright A_SpawnItemEx("HeterodoxBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_SeekerMissile(5,7)
	TNT1 A 0 A_CountDown
	Loop
  Crash:
  Death:
	NEBL EFGHIJ 3 Bright
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("BlackParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom35",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_GiveInventory("HeterodoxCurse",1,AAPTR_TRACER)
	NEBL EFGHIJ 3 Bright
	Stop
  }
}

Actor HoundDBBall : HeterodoxBall
{
  Damage 2
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("BlackParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("Kaboom35", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	NEBL CDE 3 Bright
    Stop
  }   
}

Actor EnergyProjectileSparkBlack : EnergyProjectileSparkRed
{
  Gravity 0.2
  BounceFactor 0.6
  Renderstyle Translucent
  Alpha 0.9
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	SPKZ A 2 Bright A_FadeOut(0.05,1)
	Loop
  }
}

Actor EPSZ1 : EnergyProjectileSparkBlack { Scale 0.06 }

Actor EPSZ2 : EnergyProjectileSparkBlack { Speed 1 Scale 0.05 }

Actor EPSZ3 : EnergyProjectileSparkBlack { Speed 2 Scale 0.04 }

Actor EPSZ4 : EnergyProjectileSparkBlack { Speed 3 Scale 0.03 }

Actor EPSZ5 : EnergyProjectileSparkBlack { Speed 4 Scale 0.02 }

Actor EPSZ6 : EnergyProjectileSparkBlack { Speed 5 Scale 0.01 }

Actor BlackParticleSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("EPSZ1",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("EPSZ2",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("EPSZ3",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("EPSZ4",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("EPSZ5",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("EPSZ6",0,0,0,frandom(-4,4),Random(-4,4),Random(-4,4),0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor DamnedBall2 : DamnedBall
{
  Damage (Random(10,40))
  Species "Nobles"
  DamageType "NobleComet"
}

Actor HeteracidTrail
{
  Height 1
  Radius 1
  Renderstyle Add
  Alpha 1.0
  Gravity 0.0
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	ANFB AAABBBCCCCCCC 1 Bright A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor HeterodoxBallTrail
{
  Height 1
