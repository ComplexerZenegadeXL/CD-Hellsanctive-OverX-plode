Actor RMAfrit : CFBaronOfHell 31049
{ 
  Health 1200
  Speed 8
  PainChance 30
  PainChance "SoulToxic", 20
  PainChance "FatFlamer", 20
  PainChance "FiendFire", 20
  BloodColor "ff 50 00"
  Mass 1000
  DamageFactor "NobleComet", 0.0
  DropItem "BossLifeEssence" 100
  DropItem "ArmorBonusMax" 100
  MeleeDamage 8
  PainSound "monsters/baronpain"
  MeleeSound "baron/melee"
  Species "Nobles"
  +FLOAT
  +MISSILEMORE
  +FASTMELEE
  +NOGRAVITY
  +BOSSDEATH
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  -FLOORCLIP
  Obituary "$CFAfritObit"
  HitObituary "$CFAfritHitObit"
  Tag "$CFAfrit"
  var int user_script;
  var int user_script_type;
  States 
  { 
  Spawn:
    AFRT A 0
	TNT1 A 0 A_JumpIf(user_script == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,13)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",12)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:	  
    AFRT ABCD 6 Bright A_Look
    Loop
  See:
    AFRT ABCD 3 Bright A_Chase
    Loop      
  Melee:
    AFRT ST 5 Bright A_FaceTarget
    AFRT U 4 Bright A_MeleeAttack
    AFRT TS 4 Bright A_FaceTarget  
    Goto See
  Missile:
	TNT1 A 0 A_Jump(127,"Comet","Tracers")
    AFRT ST 6 Bright A_FaceTarget
	AFRT U 3 Bright A_FaceTarget
	AFRT U 1 Bright A_CustomMissile("AfritBall", 44, 0, 0)	  
	AFRT U 0 A_CustomMissile("AfritBall", 44, 0, 3)
	AFRT U 1 Bright A_CustomMissile("AfritBall", 44, 0, -3)
    AFRT TS 5 Bright A_FaceTarget
    AFRT T 6 Bright A_FaceTarget	  
	AFRT U 3 Bright A_FaceTarget
	AFRT U 1 Bright A_CustomMissile("AfritBall", 44, 0, 0)
	AFRT U 0 A_CustomMissile("AfritBall", 44, 0, 3)
	AFRT U 1 Bright A_CustomMissile("AfritBall", 44, 0, -3) 
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    AFRT EF 8 Bright A_FaceTarget
    AFRT G 1 Bright A_CustomMissile("Comet", 44, 0, 0)
    AFRT G 0 A_CustomMissile("Comet", 44, 0, 6)
    AFRT G 4 Bright A_CustomMissile("Comet", 44, 0, -6)
    AFRT G 6 Bright A_FaceTarget
	TNT1 A 0 A_Jump(87,"Tracers")
	Goto See
  Tracers:
    AFRT GFE 8 Bright A_FaceTarget
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_CustomMissile ("AfritTracer",0,40,0)	  
    AFRT E 1 Bright A_CustomMissile ("AfritTracer",0,-40,0)
    AFRT E 4 Bright A_FaceTarget	
    Goto See	  
  Pain: 
	TNT1 A 0 A_Jump(87,"PainMissile")
    AFRT H 8 Bright A_Pain
    Goto See
  PainMissile:
    AFRT H 8 Bright A_Pain
    Goto Missile	  
  XDeath:
  Death: 
    AFRT I 5
    AFRT I 1 Bright A_Scream
    AFRT J 4 Bright A_Fall
    AFRT KLMNOPQ 3 Bright
    AFRT R 3 Bright
	TNT1 A -1
    Stop  
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	AFRT RQPONMLKJI 3 Bright
    Goto See
  } 
}

Actor SummonedRMAfrit : RMAfrit { -COUNTKILL }

Actor AfritFire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  RenderStyle Add
  Scale 0.3
  States
  {
  Spawn:
  FIR1 ABCDEFGHIJKL 2 Bright A_FadeOut
  Stop
  }
}

Actor AfritFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_PlaySound("monster/ambientfire")
	TNT1 A 0 A_SpawnItemEx("AfritFireEx",frandom(-12,12),frandom(-12,12),frandom(30,60),0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)	
    TNT1 AAAA 0 A_SpawnItemEx("RMAfritFire",frandom(-18,18),frandom(-18,18),frandom(25,60),0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor AfritBall
{
  Radius 8
  Height 10
  Speed 18
  FastSpeed 22
  Damage (Random(20,50)) //8
  Species "Nobles"
  DamageType "NobleComet"
  Projectile
  RenderStyle Add
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  States
  {
  Spawn:
    FRTM AB 1 Bright A_SpawnItemEx("AfritTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    FRTM CDE 3 Bright
    Stop
  }
}

Actor AfritTrail : BFG9500Trail
{
  States
  {
  Spawn:
  Death:
    FRTM B 1 A_SetTranslucent(0.7,1)
    FRTM A 1 A_SetTranslucent(0.6,1)
    FRTM B 1 A_SetTranslucent(0.5,1)
    FRTM A 1 A_SetTranslucent(0.4,1)
    FRTM B 1 A_SetTranslucent(0.3,1)
    Stop
  }
}

Actor AfritTracer
{
  Radius 5
  Height 5
  Damage (Random(20,30)) //6
  RenderStyle Add
  Alpha 0.65
  Projectile
  +SEEKERMISSILE
  +FLOORHUGGER
  +DONTSPLASH
  -NOGRAVITY
  Speed 20
  FastSpeed 25
  Species "Nobles"
  DamageType "NobleComet"
  Obituary "$CFAfritTracerObit"
  Seesound "weapons/diasht"
  DeathSound "weapons/firex3"   
  States
  {
  Spawn:
    TNT1 A 0 A_PlaySound("monster/ambientfire2")
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)	
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    FTRA K 4 Bright
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    FTRA L 4 Bright A_Explode(32, 64)
    FTRA MNO 3 Bright
    Stop
  }
}

Actor ATracerPuff
{
  Radius 1
  Height 1
  Speed 0
  RenderStyle Add
  Alpha 0.6
  Scale 1.25
  Projectile
  +FLOORHUGGER
  -NOGRAVITY
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    FTRA ABCDEFGHIJ 2 Bright
    Stop
  }
}


