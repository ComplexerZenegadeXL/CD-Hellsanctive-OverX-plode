{
  Species "Cybers"
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  +THRUSPECIES
  +DONTHARMSPECIES
  +NOTELEFRAG
  +NOTELESTOMP
  -COUNTKILL
  States
  {
  Death: 
    AFRT I 6 Bright A_Scream
    AFRT J 4 Bright A_Fall
    AFRT KLMNOPQ 3 Bright
    AFRT R 3 Bright
	TNT1 A -1
    Stop
  }
}

