Actor HellfireIfrit : RMAfrit
{
  Health 2000
  Speed 10
  PainChance 50
  Scale 1.15
  Obituary "$CFHellfireIfritObit"
  HitObituary "$CFHellfireIfritHitObit"
  Tag "$CFIfrit"
  +BRIGHT
  SeeSound "HellfireIfrit/Sight"
  DeathSound "HellfireIfrit/Death"
  PainSound "HellfireIfrit/Pain"
  ActiveSound "HellfireIfrit/Active"
  var int user_lowlag;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
    HIFR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",38)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    HIFR AB 4 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	HIFR AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",38)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
    HIFR AB 2 A_Chase
	TNT1 A 0 A_Jump(15,"Evade")
    Loop    
  Evade:
    TNT1 A 0 A_Jump(128,"Evade2")
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
    HIFR ABABAB 2 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Evade2:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
    HIFR ABABAB 2 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Melee:
  Missile:
    TNT1 A 0 A_Jump(256,"Missile1","Missile2","Missile3")
  Missile1:
    HIFR CCCC 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(64,192),16,0,0)
    HIFR ABABA 2 A_FaceTarget
	TNT1 A 0 A_Stop
    HIFR B 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    HIFR C 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("PyroComet",44,0,frandom(-6,6))
    Goto See
  Missile2:
    HIFR CCCC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(64,192),16,0,0)
    HIFR ABABA 2 A_FaceTarget
	TNT1 A 0 A_Stop
    HIFR B 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    HIFR CC 2 A_FaceTarget
    HIFR C 0 A_CustomMissile("Comet",44,0,frandom(-10,10))
    HIFR C 2 A_CustomMissile("Comet",44,0,0)
    Goto See
  Missile3:
    HIFR CCCC 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("NobleBehemothSeekingComet",44,0,0)
    HIFR CCC 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("NobleBehemothSeekingComet",44,0,0)
    HIFR CC 2 A_FaceTarget
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),16,0,0)
    HIFR AABABA 2 A_FaceTarget
	TNT1 A 0 A_Stop
    HIFR B 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("NobleBehemothSeekingComet",44,0,0)
    HIFR CCC 2 A_FaceTarget
    HIFR C 2 A_CustomMissile("NobleBehemothSeekingComet",44,0,0)
    HIFR CC 2 A_FaceTarget
    Goto See
  Pain:
    HIFR D 2
    HIFR D 2 A_Pain
    Goto See
  XDeath:
  Death:
    HIFR D 6 A_Scream
    HIFR E 5 A_NoBlocking
    HIFR FGHI 5
	HIFR I -1 A_SetFloorClip
    Stop
  XRaise:
  Raise:
    Stop
  }
}

Actor SummonedHellfireIfrit : HellfireIfrit { -COUNTKILL }

Actor NobleBehemothSeekingComet : BehemothSeekingComet { Species "Nobles" DamageType "NobleComet" }