  Death:
    AZAT UVW 3 Bright A_Explode(4, 8, 0)
    Stop
  }
}

Actor HellShieldSignal
{
  Monster
  -COUNTKILL
  +NOCLIP
  +NOGRAVITY
  +NOTARGET
  +DONTREFLECT
  +STANDSTILL
 +DONTBLAST
 +FLOATBOB
 -ISMONSTER
  Speed 0
  Mass 500000
  Scale 1.3
  Radius 2
  Height 2
  var int user_count;
  States
  {
  Spawn:
	ASSH A 2 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(1 == user_count, "Death")
	ASSH A 10
	ASSH B 10 Bright
	TNT1 A 0 A_SetUserVar("user_count", user_count + 1)
	Loop
  Death:
	ASSH B  1 Bright A_FadeOut(0.1)
	Loop
  }
}

