Actor GungnirBombardment
{
  Radius 30
  Height 30
  Speed 0
  Projectile
  +THRUSPECIES
  +NOGRAVITY
  +SPAWNCEILING
  +CEILINGHUGGER
  +DONTBLAST
  +NOINTERACTION
  +NOCLIP
  -NONETID
  ReactionTime 60
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
  Death:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_SetAngle(Angle + frandom(0.0,360.0))
	TNT1 A 5 A_CustomMissile("GungnirSpear",0,frandom(460.0,5.0),0,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-85.0,-90.0))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 60,1)
	Goto DeathLoop
	TNT1 A 0
	Stop
  }
}

