  FINALFLASH://RUUUUUUN 
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("LordAsmodeus/Active")
    TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_flash", 0)
	TNT1 A 0 A_GiveToTarget("MyEyesIdiot",1)
	TNT1 A 0 A_Blast(0, 18, 240, 24)
	LRAS VWXY 30 Bright
	LRAS Z 20 Bright A_PlaySound("LordAsmodeus/Sight",0,1000)
  JapaneseCartoon:
    TNT1 A 0 A_SetUserVar("user_runes",15)
  JapaneseCartoonLoop:
	TNT1 A 0 A_JumpIf(user_flash >= 10 + user_runes,"RipEyes")	 
    TNT1 A 0 A_SetUserVar("user_flash",user_flash+1)
	LRAS Z 4 Bright A_FaceTarget
	TNT1 A 0 A_JumpIfTargetInLOS(1,120,JLOSF_DEADNOJUMP,2048)
	Loop
	TNT1 A 0 A_GiveToTarget("MyEyesIdiot",1)
	Loop
  RipEyes:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  COMEHERE:
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("LordAsmodeus/Sight")
	LRAS H 80 Radius_Quake(10,80,0,720,0)
    LRAS EF 6 A_FaceTarget
	LR45 G 150 Bright A_CustomMissile("BerserkAsmoBlackHoleEffect",0,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_Jump(10,"FINALFLASH") //if it happens, sorry 
	Goto See
  Pain:
    //TNT1 A 0 A_JumpIf(user_phase2 == 1,"PainMissile")
	TNT1 A 0 A_JumpIf(user_berserk == 1,"PainMissile")
	TNT1 A 0 ACS_NamedExecuteAlways("LordAsmodeusBerserk")
  NormalPain:
    TNT1 A 0 A_JumpIfCloser(100, "Parry")
    TNT1 A 0 A_Jump(128,"PainMissile")
	TNT1 A 0 A_Jump(90,"Pissed")
    TNT1 A 0 A_SetAngle(angle+frandom(0,360))
	TNT1 A 0 A_Recoil(-10)
	TNT1 A 0 A_Stop
    LRAS K 4 A_Pain
    Goto See
  PainMissile:
    TNT1 A 0 A_SetAngle(angle+frandom(0,360))
	TNT1 A 0 A_Recoil(-10)
	TNT1 A 0 A_Stop
    LRAS K 2 A_Pain
    Goto Missile
  Parry:
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LR4S KJ 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("baron/melee")
	LR4S I 8 A_GiveToTarget("ohgodohfuck",1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto Execute
  Execute:
    TNT1 A 0 A_JumpIfCloser(200, "Missile")
	LR45 I 0 A_PlaySound("LordAsmodeus/Active")
	LR4S IJ 15 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bladeswing1")
	LR4S K 10 A_MeleeAttack
	LR4S K 0 A_CustomMissile("BladeofAgonySlash",20,0,0)
	LR4S K 0 A_CustomMissile ("BerserkAsmoSwordProjectile",32,0,0,0)
	Goto See
  Pissed: 
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    LR45 H 10 Bright A_PlaySound("LordAsmodeus/Active")
	TNT1 A 0 A_Explode(20,100,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 10 Bright A_Blast(0, 9, 100, 24)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto Missile
  UltraPissed: 
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    LR45 H 5 Bright A_PlaySound("LordAsmodeus/Sight")
	TNT1 A 0 A_Explode(40,240,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 10 Bright A_Blast(0, 18, 240, 24)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto Missile
  XDeath:
  Death:
    TNT1 A 0 A_Scream
    TNT1 A 0 A_SetUserVar("user_deathloop",0)
  DeathLoop:
    TNT1 A 0 A_JumpIf(user_deathloop >= 34,"DeathContinue")     
    TNT1 A 0 A_SetUserVar("user_deathloop",user_deathloop+1)
    TNT1 A 0 A_SpawnItemEx("BerserkFireBig",0,0,0,frandom(-2,2),frandom(-2,2),frandom(0,2))
    LRAS K 4 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  DeathContinue:
    TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BerserkFireBig",0,0,frandom(0,30),frandom(8,20),0,frandom(-3,3),frandom(0,360))
    TNT1 A 0 A_SpawnItemEx("GungnirLockdown",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    TNT1 A 0 A_Quake(8,40,0,2500)
    LRAS L 9 A_PlaySound("LordAsmodeus/Death2",1,1.0,0,ATTN_NONE) 
    LRAS M 8
    LRAS N 8 A_Fall     
    LRAS OPQ 8 
    LRAS R -1
    Stop
  Raise:
	Stop
  }
}

Actor AsmoComet : Comet
{
  Speed 45
  FastSpeed 55
  +NOTIMEFREEZE
}

Actor LordAsmodeusBall : BaronBall
{
  Speed 45
  FastSpeed 55
  +THRUSPECIES
  +DONTREFLECT
  +NOTIMEFREEZE
  States
  {
  Spawn:
    ASMB ABC 1 Bright A_SpawnItemEx("LordAsmodeusBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
