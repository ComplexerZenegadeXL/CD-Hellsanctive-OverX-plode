Actor AsmodeusStand
{
  Monster
  -COUNTKILL
  +NOCLIP
  +NOGRAVITY
  +NOTARGET
  +DONTBLAST
  +DONTREFLECT
  +THRUSPECIES
  +STANDSTILL
  -ISMONSTER
  +BRIGHT
  RenderStyle Translucent
  Scale 0.8
  Alpha 0.9
  Species "Nobles"
  DamageFactor "Noblecomet", 0.0
  Mass 99000
  Speed 0
  Radius 2
  Height 2
  var int user_count;
  Tag "$CFAsmodeusStand"
  Obituary "$CFAsmodeusStandObit"
  States
  {
  Spawn:
	AFRT AB 2 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(10 == user_count, "Death")
	AFRT S 3 A_FaceTarget
	AFRT T 2 A_FaceTarget
	AFRT U 1 Bright A_CustomMissile("LordAsmodeusBall",25,0,0)
	AFRT UTS 3 Bright
	TNT1 A 0 A_SetUserVar("user_count", user_count + 1)
	Loop
  Death:
	AFRT AB 2 Bright A_FadeOut(0.1)
	Stop
  }
}

