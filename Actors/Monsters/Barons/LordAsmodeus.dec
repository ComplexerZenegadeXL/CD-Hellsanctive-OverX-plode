Actor LordAsmodeus
{
  Monster
  Radius 30
  Height 81
  Species "Nobles"
  DamageFactor "NobleComet", 0
  DamageFactor "Fire", 0
  Health 3500
  MeleeRange 75
  PainChance 15
  DamageFactor 0.6
  MaxStepHeight 32
  MaxDropOffHeight 32
  Mass 6000
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "PlayerFireSword", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "Explosion", 0.2
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "DTRailgun", 0.5
  DamageFactor "PDTPuff", 0.5
  DamageFactor "RailG", 0.5
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "Cyber10K", 0.0
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "LegendaryGuru", 0.2
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "BFGSplash", 0.0
  DamageFactor "BFGSpray", 0.0
  DamageFactor "PlayerDevBall", 0.020
  DamageFactor "PlayerDevBall2", 0.020
  DamageFactor "PlayerDevTracer", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.5
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "DBFG10K", 0.5
  DamageFactor "PlayerDBFG10K", 0.5
  DamageFactor "PlayerDBFG2", 0.5
  DamageFactor "PlayerDBFG210K", 0.5
  DamageFactor "PlayerDBFG", 0.5
  DamageFactor "DBFG", 0.5
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "Bullet", 0.3
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  // no infight 4 u
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleCOmet", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "HellComet", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "T3rm", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "Baby15k", 0.0
  DamageFactor "C0mm4nder", 0.0
  DropItem "BossLifeEssence" 128
  DropItem "BossArmorBonusMax" 128
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "FlameSwordGiver" 256
  DropItem "HellfireUltraSphere"
  Speed 10
  Scale 1.1
  BloodColor "DarkRed"
  SeeSound "LordAsmodeus/Sight" 
  ActiveSound "LordAsmodeus/Active" 
  DeathSound "LordAsmodeus/Death"
  PainSound "monsters/baronpain"
  MeleeSound "baron/melee"
  MeleeDamage 50
  Obituary "$CFLordAsmodeusObit"
  HitObituary "$CFLordAsmodeusHitObit"
  +BOSS
  +QUICKTORETALIATE
  +LOOKALLAROUND
  +NOTARGET
  +NORADIUSDMG
  +DONTHURTSPECIES
  +FLOORCLIP
  +NOFEAR
  +NOTIMEFREEZE
  +FIRERESIST
  +MISSILEEVENMORE
  +NOICEDEATH
  +NOTELEFRAG
  Tag "$CFAsmodeo"
  var int user_flash;
  var int user_runes;
  var int user_berserk;
  var int user_alreadyberserk;
  var int user_stand;
  var int user_phase2;
  var int user_missile;
  var int user_music;
  var int user_deathloop;
  var int user_lowlag;
  States
  {
  Spawn:
    LRAS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
    LRAS A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LRAS AABB 3 A_Chase
	TNT1 A 0 A_PlaySound("asmo/step")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,696)
	TNT1 A 0 A_SetUserVar("user_music",1)
    TNT1 A 0 A_JumpIfInventory("DontSpampls",1,2)
    TNT1 A 0 A_JumpIfHealthLower(1500,"HellShield")
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkSee")	 
    LRAS AABB 3 A_Chase
    TNT1 A 0 A_PlaySound("asmo/step")
	LAVD C 0 A_SpawnItemEx("firestep",0,5,0)  
    LRAS CCDD 3 A_Chase
    TNT1 A 0 A_PlaySound("asmo/step")
	LAVD C 0 A_SpawnItemEx("firestep",0,5,0)  
	TNT1 A 0 A_Jump(30,"Teleport")
    Loop
  BerserkSee:
    LR45 AABB 2 Bright A_Chase
	LAVD C 0 A_SpawnItemEx("firestep",0,5,0)  
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_PlaySound("asmo/step")
    LR45 CCDD 2 Bright A_Chase
	LAVD C 0 A_SpawnItemEx("firestep",0,5,0)  
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_PlaySound("asmo/step")
    Loop
  Melee:
    TNT1 A 0 A_SetShootable
	TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkMelee")	 
	LR4S IJ 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bladeswing1")
	LR4S K 5 A_MeleeAttack
	LR4S K 0 A_CustomMissile("BladeofAgonySlash",20,0,0)
	LR4S K 0 A_GiveInventory("Health",100)
	TNT1 A 0 A_Jump(100,1)
	Goto See
  BerserkMelee:
    TNT1 A 0 A_Recoil(-5)
	LR4S IJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bladeswing1")
	LR4S K 3 A_MeleeAttack
	LR4S K 0 A_CustomMissile("BladeofAgonySlash",20,0,0)
	LR4S K 0 A_GiveInventory("Health",250)
	Goto See
  Teleport:
    LR45 H 1 Bright A_UnSetShootable
	LR45 HHHHHHHHHH 1  A_FadeOut(0.1,0)
	LR45 H 2 
	LR45 HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH 0 A_Wander
    LR45 H 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAAAAAAAA 0 A_SpawnItemEx("BerserkFireBig",0,0,frandom(0,30),frandom(8,20),0,frandom(-3,3),frandom(0,360))
	LR45 HHHHHHHHHH 1 A_FadeIn(0.1)
    LR45 H 1 Bright A_SetShootable
	TNT1 A 0 A_Jump(80,"Surprise")
	Goto See
   Surprise:
	LRAS H 10 Bright A_FaceTarget
	LRAS H 0 A_CustomMissile("SeekerBlade",60,40,0)
	LRAS H 4 Bright A_CustomMissile("SeekerBlade",60,-40,0)
    Goto See
  Missile:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_JumpIfInventory("DontSpampls",1,2)
    TNT1 A 0 A_JumpIfHealthLower(1500,"HellShield")
	//TNT1 A 0 A_Jump(128,"FINALFLASH")
	TNT1 A 0 A_Jump(128,"Combo","FloorHugger","Stand","BladeOfAgony","SeekerBlades","2Zedek4Me","SeekerComets","CometCombo","Tracers")
	TNT1 A 0 A_Jump(55,"BladesGenerator")
	TNT1 A 0 A_Jump(40,"Gungnir")
	TNT1 A 0 A_Jump(15,"FINALFLASH")
	TNT1 A 0 A_Jump(10,"COMEHERE")
  Missile1:
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkFireBall")
    TNT1 A 0 A_Jump(128,"Missile2")
    LRAS EF 8 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 6)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 4)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -4)
    LRAS G 7 Bright A_CustomMissile("LordAsmodeusBall", 32, 0, 0)
    TNT1 A 0 A_Jump(87,"Combo","SeekerComets","CometCombo")
    Goto See
  Missile2:
    LRAS ST 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 6)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 4)
	TNT1 A 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -4)
    LRAS U 7 Bright A_CustomMissile("LordAsmodeusBall", 32, 0, 0)
    TNT1 A 0 A_Jump(87,"Combo","SeekerComets","CometCombo")
    Goto See
  HellShield:
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,697)
	//TNT1 A 0 ACS_NamedExecuteAlways("LordAsmodeusMemeMusic")
	//TNT1 A 0 A_SetUserVar("user_berserk",0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_GiveInventory("DontSpampls",1)
    LRAS J 20 A_FaceTarget
	LRAS I 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 6 A_ChangeFlag(DontRip,1)
	TNT1 A 0 A_ChangeFlag(DontBlast,1)
	//TNT1 A 0 A_ChangeFlag(AlwaysFast,1)
	TNT1 A 0 A_ChangeFlag(CantSeek,1)
	TNT1 A 0 A_ChangeFlag(NoTelefrag,1)
	TNT1 A 0 ACS_NamedExecuteAlways("HellShield")
	TNT1 A 0 HealThing(1000,3500)
	//TNT1 A 0 A_SetUserVar("user_berserk",1)
	//TNT1 A 0 A_SetUserVar("user_phase2",1)
	TNT1 A 0 A_Blast(0, 100, 400, 24)
	//TNT1 A 0 A_SpawnItemEx("HellShieldFollower",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("HellShieldSignal", 0, 0, 80, 0, 0, 0, 0, SXF_SETMASTER | SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto ComeHere
  BerserkFireBall:
    LR4S BE 7 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, 6)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, -3)
    LR4S G 6 Bright A_CustomMissile("AsmoComet", 32, 0, 0)
    LR4S DF 7 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, 9)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, -9)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, 6)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("AsmoComet", 32, 0, -3)
    LR4S H 6 Bright A_CustomMissile("AsmoComet", 32, 0, 0)
    TNT1 A 0 A_Jump(87,"Combo","SeekerComets","CometCombo")
    Goto See
  Combo:
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkCombo")
	LRAS HI 10 A_FaceTarget
	LRAS J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 0)
	LR45 J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 6)
	LR45 J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -6)
	LRAS J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 12)
    LRAS J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -12)
	LR45 J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 16)
	LR45 J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, -16)
	LRAS J 0 A_CustomMissile("LordAsmodeusBall", 32, 0, 20)
	LRAS J 7 A_CustomMissile("LordAsmodeusBall", 32, 0, -20)
    TNT1 A 0 A_Jump(87,"SeekerComets","CometCombo")
	Goto See
  BerserkCombo:
    TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 I 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, 0)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, 6)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, -6)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, 12)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, -12)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, 16)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, -16)
	LR45 J 0 A_CustomMissile("AsmoComet", 32, 0, 20)
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 J 7 Bright A_CustomMissile("AsmoComet", 32, 0, -20)
	TNT1 A 0 A_Jump(87,"SeekerComets","CometCombo")
	Goto See
  CometCombo:
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkCometCombo")
	LRAS H 5 A_FaceTarget
	LRAS I 5 A_FaceTarget
	LRAS J 0 A_CustomMissile("AsmodeusComet", 32, 0, 0)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 6)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -6)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 12)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -12)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 16)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -16)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 20)
	LRAS J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -20)
	TNT1 A 0 A_Jump(87,"SeekerComets")
	Goto See
  BerserkCometCombo:
    TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 I 5 A_FaceTarget
	TNT1 A 0 A_SetAngle(angle+random(0,359))
	TNT1 A 0 A_Recoil(-20)
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 0)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 6)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -6)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 12)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -12)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 16)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -16)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, 20)
	LR45 J 1 Bright A_CustomMissile("AsmodeusComet", 32, 0, -20)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 24)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, -24)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 28)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, -28)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 34)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, -34)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 38)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, -38)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, 42)
	LR45 J 0 A_CustomMissile("AsmodeusComet", 32, 0, -42)
	TNT1 A 0 A_Jump(87,"SeekerComets")
	Goto See
  SeekerComets:
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkSeekerComets")
    LRAS H 6 Bright A_FaceTarget
	LRAS H 0 A_CustomMissile("SeekerComet",60,40,0)
	LRAS H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LRAS H 2 Bright A_FaceTarget
	LRAS H 0 A_CustomMissile("SeekerComet",60,40,0)
	LRAS H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LRAS H 2 Bright A_FaceTarget
	LRAS H 0 A_CustomMissile("SeekerComet",60,40,0)
	LRAS H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LRAS H 2 Bright A_FaceTarget
	LRAS H 0 A_CustomMissile("SeekerComet",60,40,0)
	LRAS H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	Goto See
  BerserkSeekerComets:
    TNT1 A 0 A_SetAngle(angle+random(0,359))
	TNT1 A 0 A_Recoil(-20)
    LR45 H 6 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LR45 H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LR45 H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
    LR45 H 6 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LR45 H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LR45 H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerComet",60,-40,0)
	LR45 H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 0 A_CustomMissile("SeekerExplosiveComet",60,40,0)
	LR45 H 2 Bright A_CustomMissile("SeekerExplosiveComet",60,-40,0)
	Goto See
  FloorHugger:
    TNT1 A 0 A_CheckFlag(FLOAT,"SeekerComets",AAPTR_TARGET)
    TNT1 A 0 A_JumpIf(user_berserk >= 1,"BerserkFloorHugger")
	LRAS HI 10 A_FaceTarget
	LRAS J 1 Bright A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 0)		
	LRAS J 1 Bright A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0,-12)
	LRAS J 7 Bright A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 12)
	TNT1 A 0 A_Jump(87,"Tracers")
	Goto See
  BerserkFloorHugger:
    TNT1 A 0 A_SetAngle(angle+random(0,359))
	TNT1 A 0 A_Recoil(-20)
    TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 H 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 I 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("AsmodeusFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LR45 C 1 Bright A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 0)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 4)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, -4)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 6)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, -6)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 8)
	LR45 C 0 A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, -8)
	LR45 J 1 Bright A_CustomMissile("AsmodeusFloorFireSpawner", 32, 0, 12)
