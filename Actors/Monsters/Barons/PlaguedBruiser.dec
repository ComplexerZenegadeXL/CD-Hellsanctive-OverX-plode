Actor PlagueDeathParticleSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("PLEPSP1",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PLEPSP2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("PLEPSP3",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PLEPSP4",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("PLEPSP5",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PLEPSP6",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
  }
}

Actor PlagueGhostA
{
  Scale 1.1
  Radius 2
  Height 2
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +DONTSPLASH
  +THRUACTORS
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	PLBB AAAAAAAAAA 2 A_FadeOut(0.10)
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

