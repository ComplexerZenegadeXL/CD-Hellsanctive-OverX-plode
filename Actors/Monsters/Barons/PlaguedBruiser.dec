Actor PlaguedBruiserDemon : BruiserDemon
{ 
  Health 1700
  PainChance 50
  BloodColor "Purple"
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "PoisonCloud", 0.0
  DropItem "ExtraArmor" 65
  DropItem "BossLifeEssence" 210
  DropItem "BossArmorBonusMax" 210
  MeleeDamage 10
  Scale 1.1
  +BRIGHT
  +NOTARGET
  +MISSILEMORE
  Obituary "$CFPlaguedBruiserDemonObit"
  HitObituary "$CFPlaguedBruiserDemonHitObit"
  Tag "$CFPlagueBr"
  var int user_lowlag;
  var int user_loop;
  States
  {
  Spawn:
	PLBB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PLBB AA 7 A_Look
	PLBI AA 7 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PLBB AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	PLBB AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	PLBB CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(70,"Rush")
	Loop
  Rush:
	TNT1 A 0 A_UnHideThing
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PlagueGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBB DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Missile:
	TNT1 A 0 A_Jump(128,"LargeBall","Comets","LargeComet")
	TNT1 A 0 A_Jump(64,"LargeComets","SuperFloorFire")
  Normal:
	PLBB EF 6 A_FaceTarget
	PLBB G 1 A_CustomMissile("PlagueBall",32,0,0)
	TNT1 A 0 A_CustomMissile("PlagueBall",32,0,-5)
	PLBB G 5 A_CustomMissile("PlagueBall",32,0,5)
	PLBB HI 6 A_FaceTarget	
	PLBB J 1 A_CustomMissile("PlagueBall",32,0,0)
	TNT1 A 0 A_CustomMissile("PlagueBall",32,0,-5)
	PLBB J 5 A_CustomMissile("PlagueBall",32,0,5)
	TNT1 A 0 A_Jump(100,"Comets")
	Goto See
  LargeBall:
	PLBB EF 6 A_FaceTarget
	PLBB G 5 A_CustomMissile("PlagueBallBig",32,0,0)
	PLBB HI 6 A_FaceTarget
	PLBB J 5 A_CustomMissile("PlagueBallBig",32,0,0)
	PLBB EF 6 A_FaceTarget
	PLBB G 5 A_CustomMissile("PlagueBallBig",32,0,0)
	TNT1 A 0 A_Jump(100,"Comets","LargeComet")
	Goto See
  Comets:
	PLBB KL 7 A_FaceTarget  
	PLBB M 2 A_CustomMissile("PlagueComet",32,0,0)
	TNT1 A 0 A_CustomMissile("PlagueComet",32,0,10)
	PLBB M 4 A_CustomMissile("PlagueComet",32,0,-10)
	TNT1 A 0 A_Jump(128,"See","Normal")
	PLBB LKL 7 A_FaceTarget  
	PLBB M 2 A_CustomMissile("PlagueComet",32,0,0)
	TNT1 A 0 A_CustomMissile("PlagueComet",32,0,10)
	PLBB M 4 A_CustomMissile("PlagueComet",32,0,-10)
	Goto See
  LargeComet:
	PLBB KL 10 A_FaceTarget  
	PLBB M 10 A_CustomMissile("PlagueCometLarge",32,0,0)
	TNT1 A 0 A_Jump(128,"See","LargeBall")
	PLBB LKL 10 A_FaceTarget  
	PLBB M 10 A_CustomMissile("PlagueCometLarge",32,0,0)
	Goto See
  LargeComets:
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("superbaron/scream")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LargeCometsLoop:
	TNT1 A 0 A_FaceTarget
	PLBB K 6 A_SpawnItemEx("PlagueAttackFireSpawner")  
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	PLBB L 12
	PLBB M 2 A_CustomMissile("PlagueCometLarge",32,0,0)
	TNT1 A 0 A_CustomMissile("PlagueCometLarge",32,0,12)
	PLBB M 16 A_CustomMissile("PlagueCometLarge",32,0,-12)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_Jump(100,"SuperFloorFire")
	Goto See
  SuperFloorFire:
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("superbaron/scream")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SuperFloorFireLoop:
	TNT1 A 0 A_FaceTarget
	PLBB K 6 A_SpawnItemEx("PlagueAttackFireSpawner")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop 
	PLBB KL 10 Bright A_FaceTarget 	
	PLBB M 0 A_Custommissile("PBruiserFireSpawner",16,0,0)
	PLBB M 0 A_Custommissile("PBruiserFireSpawner",16,0,8)
	PLBB M 0 A_Custommissile("PBruiserFireSpawner",16,0,-8)
	PLBB M 0 A_Custommissile("PBruiserFireSpawner",16,0,16)
	PLBB M 0 A_Custommissile("PBruiserFireSpawner",16,0,-16)
	PLBB M 8 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  Melee:
	PLBB EF 8 A_FaceTarget
	PLBB G 7 A_MeleeAttack
	Goto See
  Pain:
	//TNT1 A 0 A_Jump(61,"MissilePain")		it's time to stop
	PLBB N 4 A_Pain
	TNT1 A 0 A_Jump(80,"Missile") //do this instead please
	Goto See
  XDeath:
  Death: 
	PLBD A 7
	PLBD B 6 A_Scream 
	PLBD D 5 A_Fall 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), 2, frandom(0,360))  
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PlagueBruiserPoisonCloudLarge",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	PLBD EFGHIJKL 4 A_SpawnItemEx("PlagueDeathParticleSpawner", frandom(10,-10), frandom(10,-10), frandom(30,60), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	PLBD MNOP 4
	PLBD QRST 3
	PLBD V 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLBD W -1
	Stop 
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	PLBD VUTSRQP 2
	TNT1 A 0 A_ChangeFlag("BRIGHT",1)
	PLBD ONMLKJIHGFEDCBA 2
	Goto See
  }
}

Actor SummonedPlaguedBruiserDemon : PlaguedBruiserDemon { -COUNTKILL }

Actor PBruiserFire : PyroFire
{
  Obituary "$CFPBruiserFireObit"
  States
  {
  Spawn:
	PLFB AB 2 Bright
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_SpawnItemEx("PlagueBruiserPoisonCloudMedium",0,0,4,frandom(-2,2),frandom(-2,2),frandom(0,6))  
    PLFB C 2 Bright A_Explode(42,106,0)
    PLFB DEFGHIJKLMNOPQRST 2 Bright
    Stop       
	}
}

Actor PBruiserFireSpawner : PyroFireSpawner
{
  Obituary "$CFPBruiserFireSpawnerObit"
  States
  {
  Spawn: 
	TNT1 AAAAAA 1 Bright A_Weave(3,0,3,0)
	TNT1 A 0 A_PlaySound("weapons/rocklx")
	TNT1 A 1 Bright A_SpawnItemEx("PBruiserFire",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
    Loop
  Death:  
    TNT1 A 1
    Stop
  }
}

Actor PlagueAttackFireSpawner : RedParticleSpawner
{
  ReactionTime 6
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("PHellionSmoke",0,36,59,frandom(-1,1),frandom(-1,1),frandom(0,4))
	TNT1 A 0 A_SpawnItemEx("PHellionSmoke",0,-36,59,frandom(-1,1),frandom(-1,1),frandom(0,4))
	TNT1 A 1 A_CountDown
	Stop
  Death:
	Stop
  }
}

Actor PlagueComet : Comet
{
  Species "Nobles"
  DamageType "NobleComet"
  Decal "Scorch"
  States
  {
  Spawn:
	PNCM AAABBBCCC 1 Bright A_SpawnItemEx("PlagueCometTail")
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(64,102)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	PNCM D 3 Bright A_SpawnItemEx("PlagueCometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAA 0 A_SpawnItemEx("PlagueBruiserPoisonCloudMedium",0,0,4,frandom(-6,6),frandom(-6,6),frandom(-6,6))  
	PNCM E 3 Bright A_SpawnItemEx("PlagueCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PlagueCometTail : CometTail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	PLUR ABCDEFGHI 1 Bright
	Stop
  }
}

Actor PlagueCometDeath : CometDeath
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAA 0 A_CustomMissile("PlagueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	PNCM FGHI 3 Bright A_FadeOut(0.1)
	Stop
	}
}

