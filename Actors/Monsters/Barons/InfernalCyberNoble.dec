Actor NobleExplosiveRailgunTrail : ExplosiveRailgunTrail
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("NobleExplosiveRailgunTrailExplode",frandom(0,4),0,0,frandom(0,4),0,frandom(-4,4),frandom(0,360),0,SXF_CLIENTSIDE)
	RGPR ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04)
	Stop
  }
}

Actor NobleExplosiveRailgunTrailExplode : ExplosiveRailgunTrailExplode
{
  Species "Nobles"
  DamageType "NobleComet"
  Obituary "$CFNobleExplosiveRailgunTrailExplodeObit"
}