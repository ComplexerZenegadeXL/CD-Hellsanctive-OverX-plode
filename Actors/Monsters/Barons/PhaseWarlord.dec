Actor TTKPurpleSmoke
{
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 1
    TNT1 A 0 A_JumpIf(user_loop == 3,6)
    TNT1 AAAA 4 A_SpawnItemEx("PHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
    Goto Spawn+1
    TNT1 A 5
    Stop
  }
}

