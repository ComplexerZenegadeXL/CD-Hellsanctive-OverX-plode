}

Actor PurpleDukeBallTrail2 : BruiserBallTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    PBRB CDEFGHIJ 3 Bright A_FadeOut
    Stop       
  }
}

Actor CorruptedPhaseOverlord : PhaseOverlord
{
  DamageFactor "FiendFire", 0.0
  +THRUSPECIES
  -COUNTKILL
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CadaverRocket", 0.0
  Tag "$CFCorrPhOverlord"
  States
  {
  Death: 
    TNT1 A 0 A_UnHideThing
    TNT1 A 0 A_SetTranslucent(1)
	BOS3 L 8 
    BOS3 M 8 A_Scream 
    BOS3 N 8 
    BOS3 O 8 A_NoBlocking 
    BOS3 PQ 8 
    BOS3 R -1
    Stop
  }
}

Actor ThePhaser : CustomInventory
{
  +NOTIMEFREEZE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.IGNORESKILL
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  Pickup:
	TNT1 A 1
	TNT1 A 0 A_JumpIfInventory("PhasePill",1,"DoNothing")
	TNT1 A 0 A_GiveInventory("PhasePill")
	TNT1 A 0 ACS_NamedExecuteAlways("PhaseMorph",0,1)
	TNT1 A 1
	Stop
  DoNothing:
	TNT1 A 1
	Stop
  }
}

