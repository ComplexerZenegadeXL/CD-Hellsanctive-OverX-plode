	TNT1 A 0 A_SpawnItemEx("PhaseBaronOfHell",0,frandom(0,340),0,0,10,0,305,SXF_SETMASTER)
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
	PWRL M 25 Bright A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  PhaseOverlords:
	TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    PWRL ON 8 Bright A_FaceTarget 
