Actor PhaseArchonTracer
{
  Speed 14
  FastSpeed 16
  Damage (Random(30,60)) //10
  Species "Nobles"
  DamageType "NobleComet"
  Radius 8
  Height 6
  Renderstyle Translucent
  Alpha 0.85
  Scale 0.45
  SeeSound "famine/attack"
  DeathSound "monsters/newfireexplode"
  Projectile
  +SEEKERMISSILE
  +DOOMBOUNCE
  +DONTSPLASH
  BounceCount 2
  BounceFactor 1
  Decal "RevenantScorch"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    PSAB AB 2 Bright
	Loop
  Homing:
	TNT1 A 0 A_Jump(128,1,3,5,7,9)
    PSAB ABABABABAB 2 Bright
	Goto StartSeek
  StartSeek:
    TNT1 A 0 A_SpawnItemEx("PhaseArchonTrailSmoke",0,0,6,0,0,0,0,SXF_CLIENTSIDE) 
    PSAB A 2 Bright	A_Tracer2
	PSAB B 2 Bright A_SpawnItemEx("PhaseArchonTrailSmoke",0,0,6,0,0,0,0,SXF_CLIENTSIDE) 
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("PhaseMindfuck",80, RGF_PLAYERS)
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 A 1 A_SpawnItemEx("PhaseArchonTracerEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Stop
  }
}

