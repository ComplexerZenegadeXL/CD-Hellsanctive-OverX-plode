//please don't put the monsters below in a random spawner
Actor PhaseBaronOfHell : CFBaronOfHell
{
  +THRUSPECIES
  -COUNTKILL
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CadaverRocket", 0.0
  BloodColor "cf 00 b0"
  Tag "$CFPhBaron"
  States
  {
  Spawn:
	PFRY A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PFRY AA 7 A_Look
	Loop
  See:
    PFRY AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    PFRY CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    Loop
  Missile:
	TNT1 A 0 A_Jump(128,"GiantBalls","Comet")
  Normal:
	PFRY KL 8 A_FaceTarget
	PFRY M 1 Bright A_CustomMissile("PhazoFastShot", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("PhazoFastShot", 32, 0, 6)
	PFRY M 1 Bright A_CustomMissile("PhazoFastShot", 32, 0, -6)
	TNT1 A 0 A_CustomMissile("PhazoFastShot", 32, 0, 12)
	PFRY M 5 Bright A_CustomMissile("PhazoFastShot", 32, 0, -12)
	TNT1 A 0 A_Jump(87,"GiantBalls","Comet")
	Goto See
  GiantBalls:
    PFRY EF 8 A_FaceTarget
	PFRY G 7 Bright A_CustomMissile("PurpleDukeBall", 32, 0, 0)
    PFRY HI 8 A_FaceTarget
	PFRY J 7 Bright A_CustomMissile("PurpleDukeBall", 32, 0, 0)
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    PFRY KL 8 A_FaceTarget	
	PFRY M 7 Bright A_CustomMissile("PArchonComet2", 32, 0, 0)
    Goto See
  Melee:
	PFRY EF 8 A_FaceTarget
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	PFRY G 8 A_MeleeAttack
	Goto See
  Pain:
	PFRY N 4 A_Pain
	Goto See
  Death: 
    PFRY O 7
    PFRY P 6 A_Scream 
    PFRY Q 5 A_Fall 	
    PFRY R 4 A_SpawnItemEx("BodyCrash",0,0,0,0)
	PFRY ST 4
    PFRY U -1 
    Stop 
  XDeath: 
	PFRX AB 5
	PFRX C 4 A_XScream
	PFRX D 4 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PFRX E 3 A_Fall
	PFRX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0)
	PFRX GH 3
	PFRX I -1 
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	PFRY TSRQPO 6
	Goto See
  }
}

