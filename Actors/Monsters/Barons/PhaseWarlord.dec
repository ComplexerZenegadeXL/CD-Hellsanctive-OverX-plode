    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 1 A_CustomMissile("PhaseArchonFire2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 1 A_Weave(3,0,1.0,0.0)	
    Loop
  Death:
    TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck",80, RGF_PLAYERS)
	TNT1 AAAA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    PFTR K 4 Bright
    PFTR L 4 Bright A_Explode(28,74)
    PFTR MNO 3 Bright
    Stop
  }
}

