Actor PhaseWarlord : BaronOfHell  //More like Phase Landcarrier
{ 
  Health 3000
  Speed 9 
  PainChance 10
  Mass 4000
  BloodColor "cf 00 b0" 
  Scale 1.1
  MeleeDamage 16
  DamageFactor 0.7
  DropItem "BossLifeEssence" 128
  DropItem "BossArmorBonusMax" 128
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "PhaseSphere"
  DropItem "PhaseArmor"
  DropItem "BossLifeEssence" 256 
  DropItem "BossArmorBonusMax" 256 
  DropItem "PainLordSoul" 256
  DropItem "CFDoomsphere" 128 1
  DamageFactor "PlayerDTRG", 0.4
  DamageFactor "DTRailgun", 0.4
  DamageFactor "PDTPuff", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "PlayerPyro", 0.5
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.1
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "NobleComet", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerIce", 0.5
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "Explosion", 0.3
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "HellComet", 0.4
  Species "Nobles"
  Monster 
  +FLOORCLIP
  +MISSILEMORE
  +NOICEDEATH
  +FASTMELEE
  +BOSS
  +NOTARGET
  +NOFEAR
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  -BOSSDEATH
  Renderstyle Add
  Alpha 0.8
  Obituary "$CFPhaseWarlordHitObit"
  HitObituary "$CFPhaseWarlordHitObit"
  SeeSound "PArchon/Sight"
  ActiveSound "PArchon/Active"
  PainSound "PArchon/Pain"
  DeathSound "PArchon/Death"
  MeleeSound "Baron/Melee"
  Tag "$CFPhWarlord"
  var int user_nomore;
  var int user_loop;
  var int user_lowlag;
  States 
  { 
  Spawn:
    PWRL A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,10)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PWRL A 10 A_Look
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    Loop  
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PWRL AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(87,"Rush")
    PWRL AA 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	PWRL BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	PWRL CC 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	PWRL DD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(62,"Phase")
	Loop
  Rush:
	TNT1 A 0 A_UnHideThing
    TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordASpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)	
	PWRL A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordASpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordBSpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordBSpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordCSpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordCSpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordDSpawner")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PArchonGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PWRL D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordDSpawner")
	TNT1 A 0 A_Jump(84,"See")		
	Loop
  Phased:
    PWRL AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
    PWRL AABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase")
    Goto Phased+32
  Phase:
    TNT1 A 0 A_PlaySound("phaseimp/teleport")
    PWRL E 2 A_FaceTarget
    PWRL E 1 A_SetTranslucent(0.75)
    PWRL E 1 A_SetTranslucent(0.55)
    PWRL E 1 A_SetTranslucent(0.35)
	PWRL E 1 A_SetTranslucent(0.15)
    Goto Phased
  UnPhase:
    TNT1 A 0 A_PlaySound("phaseimp/teleport")
	PWRL E 1 A_SetTranslucent(0.15)
    PWRL E 1 A_SetTranslucent(0.35)
    PWRL E 1 A_SetTranslucent(0.55)
    PWRL E 1 A_SetTranslucent(0.75)
  	TNT1 A 0 A_SetTranslucent(0.8)
    PWRL E 2 A_FaceTarget		
    Goto See
  Missile:  
    TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 ACS_NamedExecuteWithResult("ProgressivePhaser") // CF 4.1.4 only
    TNT1 A 0 A_Jump(128,"Comets","Spread","Seekers2","FloorHugger","DarkMatter","UltimateFloorHugger")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(80,"Minions")
	TNT1 A 0 A_JumpIf(user_nomore == 3,"Seekers")
    TNT1 A 1 A_Jump(25,"Kurwamac")  //75
	//TNT1 A 0 A_Jump(5,"ZAWARUDO")
  Seekers:
	PWRL EF 4 Bright A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordFSpawner")
    PWRL G 0 A_Custommissile ("PhaseArchonBall", 32, 0, 0) 
	PWRL G 0 A_Custommissile ("PhaseArchonBall", 32, 0, 10)
	PWRL G 3 Bright A_Custommissile ("PhaseArchonBall", 32, 0, -10)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordGSpawner")
    PWRL IJ 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordJSpawner")
    PWRL K 0 A_Custommissile ("PhaseArchonBall", 32, 0, 0)
	PWRL K 0 A_Custommissile ("PhaseArchonBall", 32, 0, 10)
	PWRL K 3 Bright A_Custommissile ("PhaseArchonBall", 32, 0, -10)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordKSpawner")
	TNT1 A 0 A_Jump(87,"Spread")
    Goto See
  Kurwamac:
	TNT1 A 0 A_SetUserVar("user_nomore",user_nomore + 1)
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
    PWRL M 4 Bright A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    PWRL M 0 A_Custommissile("TTKFire",0,0,0)
    PWRL M 0 A_Custommissile("TTKFire",0,0,90)
    PWRL M 0 A_Custommissile("TTKFire",0,0,180)
    PWRL M 0 A_Custommissile("TTKFire",0,0,270)
	TNT1 A 0 A_RadiusGive("ThePhaser",1000,RGF_MONSTERS,1) 
    PWRL M 4 Bright A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  Spread:
	TNT1 A 0 A_SetTranslucent(0.8)
	PWRL MN 5 A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordNSpawner")
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,6)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-6)
    PWRL O 4 A_CustomMissile("PhazoFastShot",28,0,0)
    TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	PWRL MN 5 A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordNSpawner")
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,6)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-6)
    PWRL O 4 A_CustomMissile("PhazoFastShot",28,0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	PWRL MN 5 A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,6)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-6)
    PWRL O 4 A_CustomMissile("PhazoFastShot",28,0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	PWRL MN 5 A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-12)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,6)
	PWRL O 0 A_CustomMissile("PhazoFastShot",28,0,-6)
    PWRL O 4 A_CustomMissile("PhazoFastShot",28,0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	TNT1 A 0 A_Jump(70,"Comets")
    Goto See	 
  Comets:
	TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordMSpawner")
    PWRL MN 8 Bright A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordNSpawner")
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, 0)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, 6)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, -6)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, 12)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, -12)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL O 0 A_Custommissile ("PArchonComet2", 32, 0, 18)
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    PWRL O 7 Bright A_Custommissile ("PArchonComet2", 32, 0, -18)	
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	Goto See
  Seekers2:
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordQSpawner")
    PWRL QQ 5 Bright A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordQSpawner")
    PWRL Q 0 A_Custommissile ("PhaseArchonTracer", 64, 0, 0) 
	PWRL Q 0 A_Custommissile ("PhaseArchonTracer", 64, 0, 6)
	PWRL Q 4 Bright A_Custommissile ("PhaseArchonTracer", 64, 0, -6)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordQSpawner")
    PWRL QQ 5 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordQSpawner")
    PWRL Q 0 A_Custommissile ("PhaseArchonTracer", 64, 0, 0)
	PWRL Q 0 A_Custommissile ("PhaseArchonTracer", 64, 0, 6)
	PWRL Q 4 Bright A_Custommissile ("PhaseArchonTracer", 64, 0, -6)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordQSpawner")
	Goto See
  DarkMatter:
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
    PWRL EF 10 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	PWRL F 20 Bright A_Facetarget
    PWRL G 0 A_Custommissile ("DarkMatterBallRM", 32, 0, 0) 
	PWRL G 0 A_Custommissile ("DarkMatterBallRM", 32, 0, 8) 
	PWRL G 8 Bright A_Custommissile ("DarkMatterBallRM", 32, 0, -8)
    PWRL IJ 4 Bright A_FaceTarget
    PWRL K 0 A_Custommissile ("DarkMatterBallRM", 32, 0, 0)
	PWRL K 0 A_Custommissile ("DarkMatterBallRM", 32, 0, 8) 
	PWRL K 8 Bright A_Custommissile ("DarkMatterBallRM", 32, 0, -8)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  FloorHugger:
	PWRL MN 8 A_FaceTarget	
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordNSpawner")
	PWRL O 0 A_CustomMissile("PhaseArchFire", 32, 0, 0)
	PWRL O 0 A_CustomMissile("PhaseArchFire", 32, 0, 5)
	PWRL O 0 A_CustomMissile("PhaseArchFire", 32, 0, -5)
	PWRL O 0 A_CustomMissile("PhaseArchFire", 32, 0, 10)
	PWRL O 8 Bright A_CustomMissile("PhaseArchFire", 32, 0, -10)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordOSpawner")
	TNT1 A 0 A_Jump(80,"UltimateFloorHugger")
    Goto See
  UltimateFloorHugger:
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	PWRL M 15 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  UltimateFloorHuggerLoop:
	PWRL M 2 A_FaceTarget	
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
    Goto UltimateFloorHuggerLoop
    TNT1 A 0 A_SetUserVar("user_loop",0)
  UltimateFloorHuggerLoop2:
	PWRL N 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto UltimateFloorHuggerLoop2
    TNT1 A 0 A_SetUserVar("user_loop",-9)
  UltimateFloorHuggerLoop3:
	PWRL O 0 A_CustomMissile("PhaseAFireSpawner", 32, 0, user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 9,2)
	TNT1 A 0 A_Jump(256,"UltimateFloorHuggerLoop3")
	PWRL O 15 Bright A_CustomMissile("PhaseAFireSpawner", 32, 0, -50)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Melee:
    TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordESpawner")
    PWRL EF 5 Bright A_FaceTarget 
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordFSpawner")
    PWRL G 4 Bright A_MeleeAttack 
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordGSpawner")
    PWRL FE 3 Bright A_FaceTarget 		
	TNT1 A 0 A_SpawnItemEx("PhaseWarlordFSpawner")
    Goto See
  ZAWARUDO:
    TNT1 A 0 A_GiveInventory("CommanderHax",1)
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
	PWRL ONM 35 Bright A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL AABBCCDDAABBCCDDAABBCCDDAABBCCDD 0 A_ExtChase(0,0)
    PWRL AABBCCDDAABBCCDD 0 A_Chase
	Goto UltimateFloorHugger
  Pain: 
    TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(20,"Minions")
	TNT1 A 0 A_Jump(90,"PainMissile")
    TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL Q 0 A_RadiusGive("PhaseMindfuck",300,RGF_PLAYERS)	
    PWRL Q 10 Bright A_Pain 
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Goto See 
  PainMissile:
    TNT1 A 0 A_SetTranslucent(0.8)
    TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PWRL Q 0 A_RadiusGive("PhaseMindfuck",300,RGF_PLAYERS)	
    PWRL Q 10 Bright A_Pain 
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Goto Missile 
  Minions:
	TNT1 A 0 A_Jump(90,"PhaseImps")
	TNT1 A 0 A_Jump(70,"PhaseBarons")
	TNT1 A 0 A_Jump(60,"PhaseCaco")
	TNT1 A 0 A_Jump(50,"PhaseOverlords")
	TNT1 A 0 A_Jump(40,"PhaseNightmare")
	TNT1 A 0 A_Jump(40,"PhaseGhoul")
	TNT1 A 0 A_Jump(40,"PhaseExile")
	Goto PhaseImps
  PhaseImps:
	TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    PWRL ON 8 Bright A_FaceTarget 
	TNT1 A 0 A_GiveInventory("Health",50)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PhaseImpsLoop:
	TNT1 A 0 A_SpawnItemEx("CorruptedPhaseImp",0,frandom(0,340),10,0,40,0,user_loop * 30,SXF_SETMASTER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 12,2)
	TNT1 A 0 A_Jump(256,"PhaseImpsLoop")
	TNT1 A 0 A_PlaySound("PArchon/Sight2")
	PWRL M 25 Bright A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  PhaseBarons:
	TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    PWRL ON 8 Bright A_FaceTarget 
	TNT1 A 0 A_GiveInventory("Health",100)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SpawnItemEx("PHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
