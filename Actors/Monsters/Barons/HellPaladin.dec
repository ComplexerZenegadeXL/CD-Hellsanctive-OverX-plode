Actor PaladinTrail
{
  Projectile
  Height 10
  Radius 10
  Speed 20
  Scale 0.5
  Reactiontime 27
  Damage (Random(20,80))
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +DONTBLAST
  +FLOORHUGGER
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  +THRUSPECIES
  Species "Nobles"
  DamageType "NobleComet"
  SeeSound "PaladinTrailSpawn"
  DeathSound "PaladinTrailDeath"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
	TNT1 A 0 A_SpawnItemEx("BlueSpike",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION,0)
	Goto Travel
  Travel:
	SBFR AAA 1 Bright A_SpawnItemEx("PaladinTrailTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,30,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(10,60,0)
	SBFR BBB 1 Bright A_SpawnItemEx("PaladinTrailTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,30,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(10,60,0)
	SBFR CCC 1 Bright A_SpawnItemEx("PaladinTrailTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,30,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(10,60,0)
	TNT1 A 0 A_CountDown
	Loop
  Crash:
  Death:
	STRD KLMNO 3 Bright A_FadeOut(0.1,1)
	Stop
  XDeath:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	STRD K 3 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_Explode(34,98,0)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom23",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	STRD LMNO 3 Bright A_FadeOut(0.1,1)
	Stop
  }
}
