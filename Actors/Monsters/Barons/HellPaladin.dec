Actor HellPaladin : CFBaronofHell 30332
{
  Monster
  Health 3666
  Height 70
  Radius 24
  Mass 1000
  Speed 12
  YScale 1.3
  XScale 1.15
  BloodColor "Blue"
  PainChance "SatanGuard", 0
  PainChance 11 //WHY 64
  MeleeRange 70
  MeleeDamage 45
  +NOFEAR
  +BOSSDEATH
  +DONTBLAST
  +DONTMORPH
  +DONTRIP
  +NOTARGET
  +FLOORCLIP
  +FASTMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species "Nobles"
  DamageType "NobleComet"
  DamageFactor "Acid", 0.1
  DamageFactor "Fire", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerIce", 0.25
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.01
  DamageFactor "AfritComet", 0.1
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Legendary", 0.1
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor 0.55
  //No Infighting
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "CurseComet", 0.0
  DropItem "BossLifeEssence", 200, 25
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "DemonAmmoBoxPickup", 180, 200
  DropItem "LifeSphere", 80
  DropItem "SuperArmorSphere", 48, 1
  DropItem "SalvationSphere" 100
  SeeSound "paladin/sight"
  ActiveSound "paladin/active"
  MeleeSound "imp/melee"
  PainSound "paladin/pain"
  DeathSound "paladin/death"
  Obituary "$CFHellPaladinObit"
  HitObituary "$CFHellPaladinHitObit"
  Tag "$CFHellP"
  var int user_currenthp;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn: 
	SATG A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",21)
	TNT1 A 0 A_SetUserVar("user_effect_delay",5)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  SpawnLoop:
	SATG A 5 A_Look
	SATI A 5 A_Look
	SATG A 5 A_Look
	SATI A 5 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
    Loop
  Idle:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
  IdleLoop:
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    SATG A 2 Bright A_Wander
	SATG A 1 Bright A_Look
	SATG A 2 Bright A_Wander
	SATG A 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    SATG B 2 Bright A_Wander
	SATG B 1 Bright A_Look
	SATG B 2 Bright A_Wander
	SATG B 1 Bright A_Look
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	SATG C 2 Bright A_Wander
	SATG C 1 Bright A_Look
	SATG C 2 Bright A_Wander
	SATG C 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	SATG D 2 Bright A_Wander
	SATG D 1 Bright A_Look
	SATG D 2 Bright A_Wander
	SATG D 1 Bright A_Look
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"Shield")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 5,"Pain.Crush")
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	SATG AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",21)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
  SeeLoop:
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    SATG AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    SATG BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	SATG CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	SATG DD 3 Bright A_Chase
    Loop
  Missile:
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Rage")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIfTargetInLOS("VeryFarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1500)
	TNT1 A 0 A_JumpIfTargetInLOS("FarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("LongRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,800)
	TNT1 A 0 A_JumpIfTargetInLOS("NearRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,500)
	TNT1 A 0 A_JumpIfTargetInLOS("CloserAttack",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	Goto Shield
  VeryFarRange:
	TNT1 A 0 A_Jump(256,"HomingComets","HomingComets","RFLv2")
  FarRange:
	TNT1 A 0 A_Jump(256,"Spread","Spread","Spread","HomingComets")
  LongRange:
	TNT1 A 0 A_Jump(256,"Spread","Spread","FireBlast","Comet","Comet")
  NearRange:
	TNT1 A 0 A_Jump(256,"Spread","FireBlast","FireBlast","Comet")
  CloserAttack:
	TNT1 A 0 A_Jump(256,"Normal","Normal","FireBlast")
  Normal:
    SATG EEFF 4 Bright A_FaceTarget(45)
	SATG GGG 1 Bright A_CustomMissile("PaladinBall",32,0,random(-5,5))
	SATG GGIIJJ 3 Bright A_FaceTarget
	SATG KKK 1 Bright A_CustomMissile("PaladinBall",32,0,frandom(-5,5))		
	SATG K 2 Bright A_FaceTarget
    Goto See
  Rage:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
    TNT1 A 0 A_Jump(255,"Spread","FireBlast","Comet","HomingComets","RFLv2","Normal")
	Goto Shield
  RFLv2:
	SATG MN 6 Bright A_FaceTarget(45)
    SATG OOOOOOOOOOO 1 Bright A_CustomMissile("PaladinBall",32,0,frandom(8,-8))
    Goto See
  Spread:
    SATG MN 6 Bright A_FaceTarget(45)
    SATG O 1 Bright A_CustomMissile("PaladinBall",32,0,random(8,-8))
	TNT1 AAAAAAAAAA 0 A_CustomMissile("PaladinBall",32,0,random(8,-8))
	SATG OOOOO 1 Bright A_FaceTarget(45)
	Goto See
  Comet:
	SATG MNO 6 Bright A_FaceTarget(45)
	TNT1 A 0 A_Custommissile("PaladinComet",32,0,0)
	TNT1 A 0 A_Custommissile("PaladinComet",32,0,-8)
	TNT1 A 0 A_Custommissile("PaladinComet",32,0,-16)
	TNT1 A 0 A_Custommissile("PaladinComet",32,0,8)
	TNT1 A 0 A_Custommissile("PaladinComet",32,0,16)
	SATG OO 5 Bright A_FaceTarget(45)
    Goto See
  HomingComets:
    SATG OON 4 Bright A_FaceTarget(45)
	TNT1 A 0 A_CustomMissile("HomingComet",65,24,0,2)
	TNT1 A 0 A_CustomMissile("HomingComet",65,-24,0,2)
	SATG M 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HomingComet",75,24,0,2)
	TNT1 A 0 A_CustomMissile("HomingComet",75,-24,0,2)
    Goto See
  Shield:
  	TNT1 A 0 A_SetReflectiveInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
    SATG MN 6 Bright A_FaceTarget
	TNT1 A 0 A_TakeInventory("Tic",999999)
  ShieldLoop:
	SATG OOOOO 1 Bright A_SpawnItemEx("BlueShieldFX",frandom(-30,30),frandom(-30,30),frandom(10,70),0,0,0,frandom(0,360))
	TNT1 AAA 0 Bright A_CustomMissile("PaladinTrail",0,0,frandom(0,360),CMF_AIMDIRECTION)
	TNT1 A 0 A_JumpIfInventory("Tic",21,"ShieldEnd")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  ShieldEnd:
	TNT1 A 0 A_JumpIf((user_currenthp - Health) < 0,2)
	TNT1 A 0 HealThing(((user_currenthp - Health)*0.75)+1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	SATG ONMM 3 Bright
	Goto See
  FireBlast:
	SATG MNO 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-9)
  FireBlastLoop:
	TNT1 A 0 A_CustomMissile("PaladinTrail",0,0,user_loop * 5,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,2)
	TNT1 A 0 A_Jump(256,"FireBlastLoop")
	SATG ONMM 3 Bright
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"Shield")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 10,"Pain.Crush")
	GoTo See
  Melee:
	TNT1 A 0 A_FaceTarget(45)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	SATG EFG 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinMeleeAttack",30,0,0)
    SATG FE 4  Bright A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 1000,"Shield")
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_Pain
	TNT1 A 0 A_JumpIfCloser(300,"PainMissile")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 1000,"Shield")
	TNT1 A 0 A_Jump(32,"Shield")
    SATG Q 10 Bright
	Goto See
  Pain.Crush:
	TNT1 A 0 A_Pain
	Goto See
  PainMissile:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	SATG QQQQQQ 5 Bright
    Goto Missile
  XDeath:
  Death:
	SATG Q 3 Bright A_Scream
	SATG QQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 4 Bright A_CustomMissile("Kaboom66",frandom(20,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFlare3",0,0,48)
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom66",frandom(20,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAAAAA 0 A_CustomMissile("SmokeFX",frandom(40,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 A 0 A_CustomMissile("NightmareSummoner",47,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",47,0,75,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",47,0,-75,CMF_AIMDIRECTION)
	SATG RSTUV 6
	SATG W 7 A_Fall
	TNT1 A 0 A_BossDeath
	TNT1 A 0 A_KillMaster
    SATG "XY" 4
	SATG "Z" 525
    "####" "#" 5 A_FadeOut(0.1,1)
	Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor SummonedHellPaladin : HellPaladin { -COUNTKILL }

Actor HPBlueFire2Spawner : RedParticleSpawner
{
  Height 70
  Radius 1
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1 A_SpawnItemEx("BlueFire2",frandom(-20,20),frandom(-20,20),frandom(10,68),frandom(-2,2),frandom(-2,2),frandom(6,7),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor PaladinWalkFire
{
  Scale 1.8
  Height 8
  Radius 4
  Speed 0
  RenderStyle Add
  Alpha 0.75
  MaxStepHeight 4
  Damage (0)
  +MISSILE
  +DROPOFF
  +NOTARGET
  -NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +THRUACTORS
  +DONTSPLASH
  +MOVEWITHSECTOR
  +NOEXPLODEFLOOR
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 5
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BRTF ABC 3 Bright
	TNT1 A 0 A_Jump(191,3)
	TNT1 A 0 A_CustomMissile("PaladinWalkFire",0,24,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PaladinWalkFire",0,-24,0,CMF_TRACKOWNER)
	BRTF DEFGHIJKLMNOO 3 Bright A_FadeOut(0.08,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor PaladinBall : BaronBall
{
  Projectile
  Height 8
  Radius 8
  Speed 20
  FastSpeed 24
  Scale 0.72
  Renderstyle Add
  Damage (Random(25,40)) //8
  +DONTHARMSPECIES
  Species "Nobles"
  DamageType "NobleComet"
  States
  {
  Spawn:
	SATC AAABBB 1 Bright A_SpawnItemEx("PaladinBTrail",frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Crush:
  Death:
	SATC K 5 Bright
	SATC LMNOPQRSTUVWX 2 Bright A_FadeOut(0.015,1)
	Stop
  XDeath:
	SATC K 5 Bright
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_SpawnItemEx("PaladinBTrail2",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	SATC LMNOPQRSTUVWX 2 Bright A_FadeOut(0.015,1)
	Stop
  }
}

Actor PaladinBTrail : BlueFire
{
  Scale 0.25
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
}

Actor PaladinBTrail2 : PaladinBTrail { Scale 0.11 }

Actor BlueCometDeathGlow : CometDeathGlow
{
  Scale 2.0
  Alpha 0.6
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	STFR ABCDEFGHI 3 Bright
	Stop
  }
}

Actor BlueCometDeath : CometDeath
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom23",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	HPCM FGHI 3 Bright A_FadeOut(0.1,1)
	TNT1 A 1
	Stop
  }
}

Actor CFHomingCometBase
{
  Projectile
  Height 10
  Radius 10
  Speed 25
  FastSpeed 30
  Scale 0.85
  Reactiontime 14
  Damage (Random(3,5)) //1
  +SEEKERMISSILE
  +DONTHARMSPECIES
  SeeSound "comet/launch"
  DeathSound "comet/explosion"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(135,"Homing")
	TNT1 A 1 A_Jump(256,"Normal")
	Loop
  Normal:
	TNT1 A 0 A_Jump(20,"Homing")
	HPCM AAABBBCCCAAABBBCCC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Homing:
	HPCM AABB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_Jump(256,"Travel")
	Loop
  Travel:
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM AA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM AB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM BB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM BC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM CC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM DD 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM DA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM AA 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM BB 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_Explode(Random(64,96),Random(128,192),0)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM D 3 Bright A_SpawnItemEx("BlueCometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM E 3 Bright A_SpawnItemEx("BlueCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}


Actor HomingComet : CFHomingCometBase
{
  ReactionTime 27
  Damage (Random(15,30)) //5
  Species "Nobles"
  DamageType "NobleComet"
  States
 {
  Spawn:
	TNT1 A 0
	HPCM AAABBBCCCAAABBBCCC 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAA 0 A_Jump(256,"Travel")
	Loop
  Travel:
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM A 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(6,9)
	HPCM A 1 Bright A_SpawnItemEx("BlueCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
