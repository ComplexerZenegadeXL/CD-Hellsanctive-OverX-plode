Actor GreenSuperBall : SuperBall
{
  Species "Nobles"
  DamageType "NobleComet"
  Obituary "$CFGreenSuperBallObit"
  States
  {
  Spawn:
	GRBC A 0 A_CountDown
    GRBC AA 2 Bright A_SpawnItemEx("GreenSuperBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_Explode(128,128,0)
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("lrball3/exp")
    TNT1 AAAAAAAA 0 A_SpawnItemEx("GreenSuperSmallBall",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(170,190),SXF_NOCHECKPOSITION)	
    TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("GreenSuperSmallBall",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,frandom(-3,3),frandom(-14,14),SXF_NOCHECKPOSITION)
	MMSD A 8 Bright A_Explode(38, 140, 0)
    Stop
  }
}

Actor GreenSuperBallTrail : SuperBallTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
 {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(255, "Flash1", "Flash2", "Flash3", "Flash4")
  Flash1:
	GRB3 A 2 Bright A_FadeOut(0.08)
	Wait
  Flash2:
	GRB3 B 2 Bright A_FadeOut(0.08)
	Wait
  Flash3:
	GRB3 C 2 Bright A_FadeOut(0.08)
	Wait
  Flash4:
	GRB3 D 2 Bright A_FadeOut(0.08)
	Wait
  Vanilla:
	TNT1 A 0
   Stop  
  }
}

Actor GreenSuperSmallBall : SuperSmallBall
{
  Radius 8
  Height 10
  Speed 65
  Species "Nobles"
  DamageType "NobleComet"
  Damage (Random(4,8))
  Scale 0.17
  Projectile
  +RANDOMIZE
  +EXTREMEDEATH
  +SEEKERMISSILE
  SeeSound "MMBurst"
  DeathSound "MBExplodeD"
  Obituary "$CFGreenSuperSmallBallObit"
  RenderStyle Add
  States
  {
  Spawn:
    GRBC A 0
    GRBC A 0 A_SeekerMissile(15,8,SMF_LOOK)
	GRB3 AA 1 Bright A_SpawnItemEx("GreenSuperBallTrail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	GRBC A 0 A_SeekerMissile(1,8,SMF_LOOK)
	GRB3 BB 1 Bright A_SpawnItemEx("GreenSuperBallTrail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	GRBC A 0 A_SeekerMissile(15,8,SMF_LOOK)
	GRB3 CC 1 Bright A_SpawnItemEx("GreenSuperBallTrail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	GRBC A 0  A_SeekerMissile(15,8,SMF_LOOK)
	GRB3 DD 1 Bright A_SpawnItemEx("GreenSuperBallTrail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 I 8 A_Explode(8,80,0)
    TNT1 J 6
    TNT1 K 4
    Stop
  }
}

