Actor DarkCydestroyer : DarkCybruiser 27901
{
  Health 2500
  Speed 12
  Scale 1.2
  -FASTMELEE
  +BOSS
  //DamageFactor 0.45
  DropItem "NemesisHealthBonusMax" 200 25
  DropItem "NemesisArmorBonus16" 200
  DropItem "NemesisHealthBonusMax" 200 25
  DropItem "NemesisArmorBonus16" 200
  DropItem "BerserkSphere" 120
  DropItem "DemonAmmoBoxPickup" 220 200
  DropItem "DemonTechRifleGiver" 256
  DropItem "DemonTechRailgunGiver" 200
  DropItem "SuperArmorSphere" 60 
  DropItem "CannongunSphere" 128
  SeeSound "cydes/sight" 
  PainSound "cydes/pain"
  DeathSound "cydes/death"
  Obituary "$CFDarkCydestroyerObit"
  HitObituary "$CFDarkCydestroyerHitObit"
  Tag "$CFDCydes"
  var int user_missile;
  var int user_loop;
  States
  {
  Spawn:
	DB2S A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DB2S A 14 A_Look
	DB2I A 14 A_Look
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DB2S AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("BruiserStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar(user_lowlag,1)
	TNT1 A 0 A_SetTranslucent(1)
	DB2S AABB 2 A_Chase
	TNT1 A 0 A_ChangeFlag(NoPain,0)
	TNT1 A 0 A_SpawnItemEx("BruiserStep",0,0,5,0,0,-20)
	DB2S CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("BruiserStep",0,0,5,0,0,-20)
	TNT1 A 0 HealThing(20)
	TNT1 A 0 A_Jump(62,"Boost")
	Loop
  Boost:
	DB2S A 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S A 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S B 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S B 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BruiserStep",0,0,5,0,0,-20)
	DB2S C 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S C 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S D 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DB2S D 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("DCydestroyerGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BruiserStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(50,"See")
	Loop
  Pause:
	DB2S E 10
	DB2S E 20 A_PlaySound("weapons/12gsgcock")
	Goto See
  Melee:
  Missile:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(256,"ShoulderRockets")
    TNT1 A 0 A_JumpIfCloser(150,"Flamethrowers")
	TNT1 A 0 A_Jump(128,"Rockets","DTRailgun","HomingRockets","GreenLasers","ShoulderHomingRockets","ShoulderRockets")
	TNT1 A 0 A_Jump(64,"RocketSpammingCombo","BFG15K","BFG10K","RailgunV2")
	TNT1 A 0 A_Jump(32,"AntiLegendaryBlast")
  Normal:
	DB2S E 12 A_FaceTarget
	DB2S E 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DarkCyberNobleDemonTech",48,20,frandom(-2,2),0)
	TNT1 A 0 A_CustomMissile("DarkCyberNobleDemonTech",48,-20,frandom(-2,2),0)
	DB3S B 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(6,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+1
  DTRailgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DB2S EE 10 A_FaceTarget
	DB2S E 2 A_FaceTarget
	DB2S E 1
	TNT1 A 0 A_PlaySound("weapons/dtrailf")
	TNT1 A 0 A_CustomMissile("DTRailCore",48,20,0)
	TNT1 A 0 A_CustomMissile("DTRailCore",48,-20,0)
	TNT1 A 0 A_CustomMissile("DarkCyberNobleDTRail",48,20,0,0)
	DB3S B 5 Bright A_CustomMissile("DarkCyberNobleDTRail",48,-20,0,0)
	DB2S EE 10 A_FaceTarget
	DB2S E 2 A_FaceTarget
	DB2S E 1
	TNT1 A 0 A_PlaySound("weapons/dtrailf")
	TNT1 A 0 A_CustomMissile("DTRailCore",48,20,0)
	TNT1 A 0 A_CustomMissile("DTRailCore",48,-20,0)
	TNT1 A 0 A_CustomMissile("DarkCyberNobleDTRail",48,20,0,0)
	DB3S B 5 Bright A_CustomMissile("DarkCyberNobleDTRail",48,-20,0,0)
	DB2S E 20
	TNT1 A 0 A_Jump(164,"Rockets","HomingRockets","BFG15K","BFG10K","ShoulderHomingRockets","ShoulderRockets")
	TNT1 A 0 A_Jump(50,"RocketSpammingCombo")
	Goto See
/*  Grenadier:
	DB2S E 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	DB3S D 0 Bright A_CustomMissile("CydestroyerGrenade",35,-20,Random(4,-4))
	DB3S D 7 Bright A_CustomMissile("CydestroyerGrenade",35,20,Random(4,-4))
	DB2S E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	DB3S D 0 Bright A_CustomMissile("CydestroyerGrenade",35,-20,Random(4,-4))
	DB3S D 7 Bright A_CustomMissile("CydestroyerGrenade",35,20,Random(4,-4))
	DB2S E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	DB3S D 0 Bright A_CustomMissile("CydestroyerGrenade",35,-20,Random(4,-4))
	DB3S D 7 Bright A_CustomMissile("CydestroyerGrenade",35,20,Random(4,-4))
	DB2S E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	DB3S D 0 Bright A_CustomMissile("CydestroyerGrenade",35,-20,Random(4,-4))
	DB3S D 7 Bright A_CustomMissile("CydestroyerGrenade",35,20,Random(4,-4))
	DB2S E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	DB3S D 0 Bright A_CustomMissile("CydestroyerGrenade",35,-20,Random(4,-4))
	DB3S D 7 Bright A_CustomMissile("CydestroyerGrenade",35,20,Random(4,-4))
	DB2S E 12 A_FaceTarget	
    Goto See*/
  Rockets:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RocketsLoop:
	DB2S E 10 A_FaceTarget 
	DB3S B 0 A_CustomMissile("DarkCyberNobleRocket",48,-20,0,0)
	DB3S B 8 Bright A_CustomMissile("DarkCyberNobleRocket",48,20,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	DB2S E 10
	TNT1 A 0 A_Jump(128,"HomingRockets","BFG15K","BFG10K","ShoulderHomingRockets","ShoulderRockets")
	TNT1 A 0 A_Jump(32,"RocketSpammingCombo")
	Goto See
  HomingRockets:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HomingRocketsLoop:
	DB2S E 10 A_FaceTarget 
	DB3S B 0 Bright A_CustomMissile("DarkCyberHomer",48,-20,0,0)
	DB3S B 8 Bright A_CustomMissile("DarkCyberHomer",48,20,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	DB2S E 10
	TNT1 A 0 A_Jump(128,"BFG15K","BFG10K","ShoulderHomingRockets","ShoulderRockets","GreenLasers")
	TNT1 A 0 A_Jump(32,"RocketSpammingCombo")
	Goto See
  GreenLasers:
	DB2S E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile",0)
	GreenLasersLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 35,"See")   
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget  
	TNT1 A 0 A_CustomMissile("DarkCydestroyerMiniLaser",70,-20,0)
	DB3S A 3 Bright A_CustomMissile("DarkCydestroyerMiniLaser",70,20,0)
	Goto GreenLasersLoop
  ShoulderHomingRockets:
	DB2S E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShoulderHomingRocketsLoop:
	DB3S A 0 A_PlaySound("smissile/fire")
	DB3S A 6 Bright A_CustomMissile("DarkShoulderRocket",70,20,0)
	DB3S A 1 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	DB2S E 10
	TNT1 A 0 A_Jump(128,"BFG15K","BFG10K","AntiLegendaryBlast")
	TNT1 A 0 A_Jump(32,"RocketSpammingCombo")
	Goto See
  ShoulderRockets:
	DB2S E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShoulderRocketsLoop:
	DB3S A 6 Bright A_CustomMissile("DarkShoulderRocket2",70,20,0)
	DB3S A 1 Bright A_FaceTarget
	DB3S A 0 A_PlaySound("smissile/fire")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	DB2S E 10
	TNT1 A 0 A_Jump(128,"BFG15K","BFG10K","ShoulderHomingRockets","GreenLasers")
	TNT1 A 0 A_Jump(32,"RocketSpammingCombo")
	Goto See
  RocketSpammingCombo:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	DB2S E 2 Bright A_PlayWeaponSound("cydes/mischrg")
	DB2S E 1 Bright A_FaceTarget
	DB2S EEEEEEEEEE 4 Bright A_FaceTarget
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberNobleRocket",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberNobleRocket",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberNobleRocket",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberNobleRocket",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberNobleRocket",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberNobleRocket",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket2",70,-20,0)
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberHomer",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberHomer",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberHomer",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberHomer",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,-20,0)
	DB2S F 0 A_CustomMissile("DarkCyberHomer",48,-20,0,0)
	DB2S F 1 Bright A_CustomMissile("DarkCyberHomer",48,20,0,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,20,0)
	DB2S F 1 Bright A_FaceTarget
	DB2S F 0 A_PlaySound("smissile/fire")
	DB2S F 6 Bright A_CustomMissile("DarkShoulderRocket",70,-20,0)
	TNT1 A 0 A_ChangeFlag("NoPain", 0)
	DB2S E 20
	TNT1 A 0 A_Jump(128,"AntiLegendaryBlast")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DB2S E 18 A_FaceTarget
	DB2S E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15KLoop:
	TNT1 A 0 A_CustomMissile("DarkBruiser15K",48,-20,frandom(-4,4))
	DB3S B 4 Bright A_CustomMissile("DarkBruiser15K",48,20,frandom(-4,4))
	DB2S E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	DB2S E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"BFG10K","RailgunV2")
	Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DB2S E 18 A_FaceTarget
	DB2S E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("DarkBruiser10K",48,-20,frandom(-4,4))
	DB3S B 4 Bright A_CustomMissile("DarkBruiser10K",48,20,frandom(-4,4))
	DB2S E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	DB2S E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(128,"RailgunV2","AntiLegendaryBlast")
	Goto See
  RailgunV2:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DB2S EE 10 A_FaceTarget
	DB2S E 2 A_FaceTarget
	DB2S E 1
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("DarkBruiserRail",48,-20)
	DB3S B 5 Bright A_CustomMissile("DarkBruiserRail",48,20)
	DB2S E 20
	Goto See
  AntiLegendaryBlast:	
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	DB2S E 1 Bright A_FaceTarget
	DB2S EEEEE 4 Bright A_FaceTarget
	DB2S E 2 Bright A_PlayWeaponSound("lrball3/charge")
	DB2S EEEEEEEEEEEEEEEE 4 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
	DB2S E 10 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("lrball3/shot")
	TNT1 A 0 A_CustomMissile("GreenSuperBall",70,-20,0)  
	DB3S B 10 Bright A_CustomMissile("GreenSuperBall",70,20,0)
	DB2S E 10 A_FaceTarget
	Goto See
  Flamethrowers:
	TNT1 A 0 A_Jump(82,"Normal")
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	DB2S EE 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("Daedabus/Chem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FlamethrowersLoop:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PCydestroyerChemSpray", 48, 20, frandom(-6,6), CMF_AIMOFFSET)
	DB3S B 1 Bright A_CustomMissile("PCydestroyerChemSpray", 48, -20, frandom(-6,6), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 21,1)
	Loop
	DB2S EE 12
	Goto See
  Pain:
	TNT1 A 0 A_Jump(107,"MissilePain")
	DB2S G 8 A_Pain
	Goto See
  MissilePain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DB2S G 8 A_Pain
	Goto Missile  
  XDeath:
  Death: 
	DB2S G 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	DB2S GGGG 2 Bright A_CustomMissile("Kaboom4", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	DB2S HHHH 2 Bright A_CustomMissile("Kaboom4", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, random(0,360))  
	DB2S IIIJJJ 2 Bright A_CustomMissile("Kaboom4", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	DB2S KKKLLL 2 Bright A_CustomMissile("Kaboom4", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	DB2S M 4 Bright A_NoBlocking
	DB2S N 3 Bright 
	DB2S OP 3
	DB2S Q -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DB2S QPONMLK 4
	Goto See
  }
}

Actor SummonedDarkCydestroyer : DarkCydestroyer { -COUNTKILL }

Actor DarkBruiserRail : DarkCyberRail { Species "Nobles" DamageType "NobleComet" }

Actor DarkBruiser15K : DarkCyber15K { Species "Nobles" DamageType "NobleComet" }

Actor DarkCydestroyerMiniLaser : FastProjectile
{
  Height 5
  Radius 5
  Speed 70
  Scale 1
  Renderstyle Add
  Alpha 0.8
  Decal "Scorch"
  Damage (Random(20,35)) //7
  +RANDOMIZE
  MissileType "DarkCydestroyerMiniLaserTrail"
  MissileHeight 8
  SeeSound "lrball2/shot"
  DeathSound "lrball2/exp"
  Species "Nobles"
  DamageType "NobleComet"
  States
  {
  Spawn: 
	TNT1 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
	TNT1 A 1 //A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
	TNT1 A 1 //A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
	TNT1 A 1 //A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)  
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	TNT1 A 10
	Stop
  }
}

Actor DarkCydestroyerMiniLaserTrail
{
  RenderStyle Add
  Alpha 0.75
  Scale 0.04
  +NOGRAVITY
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	GDLS A 0 //A_SetScale(ScaleX -0.006, ScaleY -0.006)
	GDLS A 2 Bright A_FadeOut(0.2)
	Loop
  }
}

Actor DarkShoulderRocket : ShoulderRocket
{
  Species "Nobles"
  DamageType "NobleComet"
  Speed 30
  FastSpeed 40
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
    Loop
  Homing:
    TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2))		
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    MIS3 B 6 Bright A_Explode
    MIS3 CDEF 4 Bright A_SetTranslucent(0.75,1)
    Stop
  }
}

