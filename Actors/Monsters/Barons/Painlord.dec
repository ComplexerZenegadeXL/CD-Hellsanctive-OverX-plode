Actor PainLord : CFBaronOfHell 17556
{ 
  //$Category Monsters/CF
  //$Sprite PILDA1C1
  //$Title "Pain Lord"
  Health 2000
  PainChance 25
  BloodColor "Blue"
  Scale 1.2
  MeleeDamage 8
  DropItem "BossLifeEssence" 200
  DropItem "BossArmorBonusMax" 200
  DropItem "PainLordSoul" 200
  DropItem "ExtraArmor" 80
  DropItem "BigCFManaPickup" 128 100
  DropItem "CFManaPickup" 256 30
  +FLOORCLIP
  +QUICKTORETALIATE
  +AVOIDMELEE
  Obituary "$CFPainLordObit"
  HitObituary "$CFPainLordHitObit"
  SeeSound "Painlord/Sight" 
  ActiveSound "Painlord/Active"
  PainSound "Painlord/Pain"
  DeathSound "Painlord/Death"
  Tag "$CFPainL"
  var int user_lowlag;
  States 
  { 
  Spawn: 
    PILD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PILD A 10 A_Look 
    Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PILD AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PainlordWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    PILD AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PainlordWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    PILD BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("PainlordWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    PILD CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PainlordWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PILD DD 3 Bright A_Chase
    Loop
  Missile:  
    TNT1 A 0 A_Jump(100,"DarkMatter","Comets")
    TNT1 A 0 A_Jump(40,"DarkMatterBarrage")
  Normal:
    PILD EF 6 Bright A_FaceTarget 
    PILD G 0 A_CustomMissile("PainlordBall", 32, 0, 0) 
	PILD G 0 A_CustomMissile("PainlordBall", 32, 0, 6)
	PILD G 5 Bright A_CustomMissile("PainlordBall", 32, 0, -6)
    PILD IJ 6 Bright A_FaceTarget
    PILD K 0 A_CustomMissile("PainlordBall", 32, 0, 0)
	PILD K 0 A_CustomMissile("PainlordBall", 32, 0, 6)
	PILD K 5 Bright A_CustomMissile("PainlordBall", 32, 0, -6)
	TNT1 A 0 A_Jump(160,"DarkMatter","See")
    PILD MN 8 Bright A_FaceTarget 	
	PILD O 0 A_CustomMissile("PainlordBall", 32, 0, 5)
	PILD O 0 A_CustomMissile("PainlordBall", 32, 0, -5)
	PILD O 0 A_CustomMissile("PainlordBall", 32, 0, 10)
	PILD O 0 A_CustomMissile("PainlordBall", 32, 0, -10)
    PILD O 7 Bright A_CustomMissile("PainlordBall", 32, 0, 0)
    Goto See
  Comets:
    PILD EF 6 Bright A_FaceTarget 
	PILD G 0 A_CustomMissile("PainLordComet", 32, 0, frandom(-6,6))
	PILD G 5 Bright A_CustomMissile("PainLordComet", 32, 0, 0)
    PILD IJ 6 Bright A_FaceTarget
	PILD G 0 A_CustomMissile("PainLordComet", 32, 0, frandom(-6,6))
	PILD K 5 Bright A_CustomMissile("PainLordComet", 32, 0, 0)
	TNT1 A 0 A_Jump(128,"DarkMatter")
	TNT1 A 0 A_Jump(64,"See")
    PILD MN 8 Bright A_FaceTarget 	
	PILD O 0 A_CustomMissile("PainLordComet", 32, 0, 4)
	PILD O 0 A_CustomMissile("PainLordComet", 32, 0, -4)
	PILD O 0 A_CustomMissile("PainLordComet", 32, 0, 12)
    PILD O 7 Bright A_CustomMissile("PainLordComet", 32, 0, -12)
    Goto See
  DarkMatter:
    PILD MN 8 Bright A_FaceTarget 	
    PILD O 7 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 0)
	TNT1 A 0 A_Jump(64,"See")
    PILD NMN 8 Bright A_FaceTarget 	
    PILD O 7 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 0)	
	TNT1 A 0 A_Jump(64,"Normal","DarkMatterBarrage")	
	Goto See
  DarkMatterBarrage:
	PILD M 1 Bright A_Playsound("Painlord/Attack",4)
	PILD MMMMMMMMMMMMMMMMMMMM 2 Bright A_SpawnItemEx("PainlordSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    PILD MN 12 Bright A_FaceTarget 	
    PILD O 3 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 0)
    PILD O 0 A_CustomMissile("PainLordDarkMatter", 32, 0, -8)
    PILD O 6 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 8)
    PILD EF 5 Bright A_FaceTarget 	
    PILD G 5 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 0)
    PILD IJ 5 Bright A_FaceTarget 	
    PILD K 5 Bright A_CustomMissile("PainLordDarkMatter", 32, 0, 0)	
	TNT1 A 0 A_Jump(128,"See")	
	Goto See
  Melee:
    PILD EF 5 Bright A_FaceTarget 
    PILD G 4 Bright A_MeleeAttack 
    PILD FE 3 Bright A_FaceTarget 		
    Goto See
  Pain: 
    PILD Q 10 Bright A_Pain 
    Goto See 
  Death:
  XDeath:
	TNT1 A 0 Radius_Quake(3,35,0,32,8)
    PILD QQQQQQQQQQ 2 Bright A_SpawnItemEx("ShadowVaporSpawnerCF",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
    PILD QQQQQQQQQQ 3 Bright A_SpawnItemEx("PainLordDeathExplosionSpawner",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_SpawnItemEx("Debris",32,0,frandom(20,40),frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom", 32, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 32, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_NoBlocking
    TNT1 A 0 A_Explode(300,200,1)
    PILD RR 1 A_SpawnItemEx("ShadowVaporSpawnerCF",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
    PILD RR 1 A_SpawnItemEx("PainLordDeathExplosionSpawner",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
    PILD SS 1 A_SpawnItemEx("ShadowVaporSpawnerCF",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
    PILD SS 1 A_SpawnItemEx("PainLordDeathExplosionSpawner",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
    PILD TT 1 A_SpawnItemEx("ShadowVaporSpawnerCF",0,0,32,0,0,0,0,32)
    PILD TT 1 A_SpawnItemEx("PainLordDeathExplosionSpawner",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	PILD UV 8
	PILD WXY 6
	PILD Z -1 A_KillMaster
	Stop
  XRaise:
  Raise:
	Stop
  } 
}

Actor SummonedPainLord : PainLord { -COUNTKILL }

Actor PainLordSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("PainlordBallTrail",frandom(-30,30),frandom(-30,30),frandom(5,45),0,0,1)
    TNT1 A 1
    Stop
  }
}

Actor PainlordWalkFire : DukeWalkFire
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 10
    FRBB ABC 3 Bright
    TNT1 A 0 A_Jump(191,3)
    TNT1 A 0 A_CustomMissile("PainlordWalkFire", 0, 24, 0)
    TNT1 A 0 A_CustomMissile("PainlordWalkFire", 0, -24, 0)
    FRBB DEFGHIJKLMNO 3 Bright
    Stop
  }
}

Actor PainlordBall
{
  Projectile
  Radius 8
  Height 8
  Mass 20
  Speed 25
  Damage (Random(40,50)) //10
  RenderStyle Add
  Alpha 0.90
  Species "Nobles"
  DamageType "NobleComet"
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  States
  {
  Spawn:
    VLBB AABB 1 Bright A_SpawnItemEx ("PainlordBallTrail", 0, 0, 0, frandom(-2,0), frandom(-1, 1), frandom(-1, 1), 0, 0, 0)
    Loop
  Death:
	ICE9 AAAAAA 0 A_CustomMissile("PainlordBallSplitFire",0,0,frandom(0,360),CMF_TRACKOWNER,frandom(0,60))
	ICE9 A 2 Bright A_CustomMissile("PainlordBallSplitFire",0,0,frandom(0,360),CMF_TRACKOWNER,frandom(0,60))
    ICE9 BC 2 Bright
    ICE9 DEF 4 Bright
    Stop
  }
}

Actor PainlordBallSplitFire
{
  Projectile
  Radius 8
  Height 6
  Speed 25
  Damage (Random(20,30)) //5
  Renderstyle Add
  Alpha 0.90
  Gravity 0.825
  Species "Nobles"
  DamageType "NobleComet"
  +DROPOFF
  -NOGRAVITY
  States
  {
  Spawn:
    VBSB AAAABBBB 1 Bright A_SpawnItemEx ("PainlordBallTrail", 0, 0, 0, frandom(-2,0), frandom(-1, 1), frandom(-1, 1), 0, 0, 0)
    Loop
  Death:
    VLBE CBABCDE 4 Bright
    Stop
  }
}

Actor PainlordBallTrail : ImpBallTrail
{
  RenderStyle Add
  Alpha 1
  Scale 0.25
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    BMKE A 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE B 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE C 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE D 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE E 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE F 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE G 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE H 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE I 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE J 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE K 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
	BMKE L 1 Bright A_ChangeVelocity(0,0,0.7)
	TNT1 A 0 A_FadeOut
    Stop
  }
}


Actor PainLordComet : Comet
{
  Damage (Random(15,35)) //5
  DamageType "NobleComet"
  Species "Nobles"
  +DONTHURTSPECIES
  Speed 25
  Decal "Scorch"
  States
  {
  Spawn:
	PLCM AAAABBBBCCCC 1 Bright A_SpawnItemEx("PLCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_Explode(70,112)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	PLCM DE 3 Bright
	TNT1 A 0 A_SpawnItemEx("PLCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PLCometDeath : CometDeath
{
  States
  {
	Spawn:
	TNT1 A 0
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LNCM JJJKKKLLMMNN 1 Bright A_FadeOut(0.065)
	Stop
  }
}

Actor PLCometTail : CometTail
{
  Scale 1.15
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
	BLUR DEFGHI 2 Bright
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor PainLordDarkMatter : Comet
{
  Speed 32
  Damage (Random(100,170)) //30
  Scale 0.5
  +EXTREMEDEATH
  +FORCERADIUSDMG
  RenderStyle Translucent
  Alpha 0.625
  Species "Nobles"
  DamageType "NobleComet"
  States
  {
  Spawn:
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB A 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB A 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB A 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB C 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB C 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB C 1 Bright
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("PainLord/Explode1",7)
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,frandom(20,40),frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("BlueKaboom", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("PainLordDeathExplosionSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("ShadowVaporSpawnerCF",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Explode(130,200,1)
	TNT1 A 15 Radius_Quake(5,15,0,20,0)
	Stop
  }
}

Actor ShadowVaporSpawnerCF
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  Renderstyle None
  States
  {
  Spawn:
	TNT1 A 0 //NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Null")
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("ShadowVaporCF",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE)
	PLAY A 3
	PLAY BCDEF 5
	Stop
	}
}

Actor ShadowVaporCF
{
  Renderstyle Add
  Scale 0.65
  Alpha 0.7
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	VPXS MNOPQRSTUVWXYZ 1 Bright A_FadeOut(0.018)
	VPXZ ABC 2 A_FadeOut(0.018)
	Stop
	}
}

Actor PainLordDeathExplosionSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("PainLordVapor",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE)
	TNT1 A 1
	Stop
  Vanilla:
	TNT1 A 1
	Stop
	}
}

Actor PainLordVapor
{
  Renderstyle Add
  Scale 0.65
  Alpha 0.9
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Playsound("PainLord/Explode2",7)
	ICE9 ABCDEF 3
	Stop
  }
}