Actor EnragedLegendaryCybruiser : LegendaryCyberNoble
{ 
  Health 4000
  Mass 3500
  Speed 14
  PainChance 15 
  PainChance "PlayerDTRG", 256
  +BRIGHT
  Scale 1.25
  SeeSound "EnragedCybruiser/Sight"
  PainSound "EnragedCybruiser/Pain"
  DeathSound "EnragedCybruiser/Death"
  ActiveSound "EnragedCybruiser/Active"
  MeleeDamage 22
  BloodColor "Red"
  DamageType "Legendary"
  DamageFactor "PDTBFG", 0.2
  DamageFactor "PDTBFGTracer", 0.2
  DamageFactor "PlayerDevBall", 0.1
  DamageFactor "PlayerDevBall2", 0.1
  DamageFactor "PlayerDTRG", 0.3
  DamageFactor "PlayerDevTracer", 0.12
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor 0.55
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "HellComet", 0.4
  Obituary "$CFEnragedLegendaryCybruiserObit"
  HitObituary "$CFEnragedLegendaryCybruiserHitObit"
  Tag "$CFEnrCybr"
  DropItem "EnragedLegendarySphere" 187
  DropItem "EnragedLegendaryUltraSphere" 55
  DropItem "LegendaryAmmoSphere" 130
  DropItem "ILDemonAmmoBoxPickup" 256
  DropItem "ILDemonAmmoPickup" 256
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 128 
  //DropItem "EnragedLegendaryASGGiver" 128
  DropItem "EnragedLegendaryShellPickup" 256 4
  DropItem "DemonTechRailgunGiver" 256
  DropItem "EnragedLegendaryShellBoxPickup" 128
  DropItem "LegendaryRandomSphere" 16
  var int user_10K2;
  var int user_painspam;
  var int user_upgrade;
  States 
  { 
  Spawn: 
    ERUS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",7)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
  Idle:
	TNT1 A 0 A_JumpIf(user_upgrade == 2,"SpawnMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"SpawnMKII")
    ERUS AAZZ 7 A_Look
    Loop 
  SpawnMKII: 
    ERU2 AAZZ 7 A_Look
    Loop
  SpawnMKIII: 
    ERU3 AAMM 7 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ERUS AA 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERUS BB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,415)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_JumpIf(user_upgrade == 2,"SeeMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"SeeMKII")
	TNT1 A 0 A_Jump(80,"Rush")
	ERUS AA 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERUS BB 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERUS CC 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERUS DD 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	TNT1 A 0 A_Jump(32,"Teleport")
	Goto See
  SeeMKII:
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	TNT1 A 0 A_Jump(80,"RushMKII")
	ERU2 AA 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU2 BB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU2 CC 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU2 DD 3 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	TNT1 A 0 A_Jump(32,"TeleportMKII")
	Loop
  SeeMKIII:
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	TNT1 A 0 A_Jump(80,"RushMKIII")
	ERU3 AA 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU3 BB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU3 CC 2 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ERU3 DD 2 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	TNT1 A 0 A_Jump(32,"TeleportMKIII")
	Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	ERUS A 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERUS A 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERUS B 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERUS B 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERUS C 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERUS C 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase  
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERUS D 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERUS D 2 A_SpawnItemEx("ELCBGhost")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  RushMKII:
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	ERU2 A 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItem("LegendaryHoofStep")
	ERU2 A 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU2 B 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU2 B 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU2 C 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERU2 C 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase  
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERU2 D 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERU2 D 2 A_SpawnItemEx("ELCBGhostMKII")
	ERU2 AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"TeleportMKIII")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  RushMKIII:
    TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	ERU3 A 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU3 A 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU3 B 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERUS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU3 B 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ERU3 C 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase
	TNT1 A 0 A_Playsound("monster/bruwlk")
	ERU3 C 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase  
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERU3 D 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	ERU3 D 2 A_SpawnItemEx("ELCBGhostMKIII")
	ERU3 AAAA 0 A_Chase
	TNT1 A 0 A_PlaySound("monster/bruwlk")
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"TeleportMKIII")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ERUS I 1 A_UnSetShootable
	ERUS IIIII 1  A_FadeOut(0.2,0)
	ERUS P 2
	ERUS PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 0 A_Wander
    ERUS P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ERUS IIIII 1 A_FadeIn(0.2)
    ERUS I 1 A_SetShootable
    Goto See	
  TeleportMKII:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ERU2 E 1 A_UnSetShootable
	ERU2 EEEEE 1  A_FadeOut(0.2,0)
	ERU2 P 2 
	ERUS PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 0 A_Wander
    ERU2 P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ERU2 EEEEE 1 A_FadeIn(0.2)
    ERU2 E 1 A_SetShootable
    Goto SeeMKII
  TeleportMKIII:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ERU3 I 1 A_UnSetShootable
	ERU3 EEEE 1  A_FadeOut(0.25,0)
	ERU3 P 1 
	ERU3 PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 0 A_Wander
    ERUS P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ERU3 EEEE 1 A_FadeIn(0.25)
    ERU3 I 1 A_SetShootable
    Goto SeeMKIII
  Pause:
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    ERUS E 5 A_PlaySound("lasgguy/asgin") 
	ERUS E 10 A_PlaySound("LShotgun/Cock")
	Goto See
  PauseMKII:
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
    ERU2 EE 1 A_PlaySound("lasgguy/asgin") 
	ERU2 E 3
	ERU2 EE 1 A_PlaySound("LShotgun/Cock")
	ERU2 E 8
	Goto SeeMKII
  PauseMKIII:
	TNT1 A 0 A_SpawnItemEx("LegendaryEmptyDrumSpawner", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    ERU3 FF 1 A_PlaySound("lasgguy/asgin") 
	ERU3 E 3
	ERU3 EE 1 A_PlaySound("LShotgun/Cock")
	ERU3 E 6
	Goto SeeMKIII
  MissileMKIII:
    TNT1 A 0
    TNT1 A 0 A_Jump(56,"Jericho","FloorSpamSummon","DTGrenades")
    TNT1 A 0 A_Jump(256,"RocketRageMKIII","BFG10KMKIII","RailgunMKIII","LegCannon1MKIII","LegendaryAsgMKIII")
  MissileMKII:
    TNT1 A 0 A_Jump(48,"HarpoonFlak")
    TNT1 A 0 A_Jump(256,"RocketsMKII","SeekersLoopMKII","BFG10KMKII","RailgunMKII","LegCannon1MKII","LegCannon2MKII","LegendaryAsgMKII")
 Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIf(user_upgrade == 2,"MissileMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 0 && Health < 2750,"Upgrade")
	TNT1 A 0 A_JumpIf(user_upgrade == 1 && Health < 1500,"Upgrade")
	//TNT1 A 0 A_Jump(20,"Upgrade")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"MissileMKII")
	TNT1 A 0 A_JumpIfCloser(400,"ShoulderCharge")
  ChargeSkip:
    //TNT1 A 0 A_Jump(256,"LegDT")
	TNT1 A 0 A_Jump(40,"LegDT")
    TNT1 A 0 A_Jump(128,"BestAttack","Rain","Rockets","SeekersLoop","BFG10K","Railgun","LegCannon1","LegendaryAsg")
	TNT1 A 0 A_Jump(100,"Comet","4Comets")
  Normal:
    TNT1 A 0 A_JumpIf(user_missile >= 4,"See")
    ERUS GH 3 A_FaceTarget
	ERUS R 0 A_CustomMissile("ELegNobleBall",40,0,-8)
	ERUS R 0 A_CustomMissile("ELegNobleBall",40,0,-4)
	ERUS R 0 A_CustomMissile("ELegNobleBall",40,0,4)
	ERUS I 5 A_CustomMissile("ELegNobleBall",40,0)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  ShoulderCharge:
    TNT1 A 0 A_Jump(32,"LegendaryAsg")
	TNT1 A 0 A_Jump(176,"ChargeSkip")
	TNT1 A 0 A_PlaySound("EnragedCybruiser/Active",0,1,0,ATTN_NONE)
	TNT1 AAA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    ERUS IIII 3 A_FaceTarget
	TNT1 A 0 ThrustThingZ(0,6,0,1)
    ERUS I 2 A_Recoil(-50)
  ChargeLoop:
    TNT1 A 0 A_JumpIf(user_missile >= 5,"ChargeEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A  0 A_CustomMissile("ELCBLunge",18,0,0,CMF_AIMDIRECTION)
	TNT1 AAA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	ERUS I 2 
	Loop
  ChargeEnd:
    TNT1 A 0 A_Stop
	Goto See
  LegendaryAsg:
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"LegendaryASGMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"LegendaryASGMKII")
    ERUS EE 4 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,24,frandom(-6,6),0)
	TNT1 A 0 A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	ERUS F 2 A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
    TNT1 A 0 A_Jump(45,"Pause")
    TNT1 A 0 A_SpidRefire
	Goto LegendaryAsg+2
  LegendaryAsgMKII:
    ERU2 EE 4 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(-6, -2), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,24,frandom(-6,6),0)
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,-24,frandom(-6,6),0)
	TNT1 A 0 A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
	ERU2 F 2 A_Jump(45,"PauseMKII")
    TNT1 A 0 A_SpidRefire
	Loop
  LegendaryAsgMKIII:
    ERU3 EE 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(-6, -2), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("ECBShotgunRail",70,-20,frandom(-4,4))
	TNT1 A 0 A_CustomMissile("ECBShotgunRail",70,20,frandom(-4,4))
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,24,frandom(-6,6))
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,-24,frandom(-6,6))
	TNT1 A 0 A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
	ERU3 F 2 A_Jump(45,"PauseMKIII")
    TNT1 A 0 A_SpidRefire
	Loop
  Comet:
    ERUS GH 5 A_FaceTarget
	ERUS I 2 A_CustomMissile("ELegNobleComet", 38, 0, 0)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, 6)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, 18)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, -18)
	ERUS I 4 A_CustomMissile("ELegNobleComet", 38, 0, -6)
    ERUS GH 5 A_FaceTarget
	ERUS I 2 A_CustomMissile("ELegNobleComet", 38, 0, 0)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, 6)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, 18)
	ERUS R 0 A_CustomMissile("ELegNobleComet", 38, 0, -18)
	ERUS I 4 A_CustomMissile("ELegNobleComet", 38, 0, -6)
	TNT1 A 0 A_Jump(80,"4Comets")
    Goto See
  4Comets:
    ERUS GH 8 A_FaceTarget
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, 0)
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, -5)
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, 5)
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, -15)
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, 15)
	ERUS R 0 A_CustomMissile("BigRedComet", 38, 0, -25)
	ERUS I 7 A_CustomMissile("BigRedComet", 38, 0, 25)
	Goto See
  BestAttack:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ERUS H 1 A_PlaySound("lcnoble/see")
    ERUS G 2 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERUS GGGGGGGGGHHHHHHHHHI 4 A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ERUS R 0 A_CustomMissile("FakeELegNobleBall4",38,0,6)
	ERUS R 0 A_CustomMissile("FakeELegNobleBall4",38,0,-6)
	ERUS R 0 A_CustomMissile("FakeELegNobleBall4",38,0,35)
	ERUS R 0 A_CustomMissile("FakeELegNobleBall4",38,0,-35)
    ERUS I 8 A_CustomMissile("ELegNobleBall4",38)
    Goto See
  LegCannon1:
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"LegCannon1MKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"LegCannon1MKII")
    ERUS E 0 A_FaceTarget
	ERUS E 20 A_PlaySound("legendarycannon/charge")
  LegCannonLoop:
