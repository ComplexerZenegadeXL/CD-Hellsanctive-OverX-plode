	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2))	
	EROC B 2 Bright A_CustomMissile("EnragedParticleSpawner",frandom(4,6),frandom(-2,2))
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	EROC B 6 Bright A_Explode(70,128)
	EROC CD 5 Bright A_SetTranslucent(0.75,1)
	Stop
  }
}

Actor EnragedHomingRocket : LegendaryHomingRocket
{
  Speed 25
  FastSpeed 30
  Decal "EnragedRocketScorch"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
    Loop	
  Homing:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 2 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	Goto StartSeek
  StartSeek:
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    ECKM A 1 Bright A_CustomMissile("EnragedMissileTrailParticle",frandom(0,2),frandom(-2,2))		
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(70,128)
    Stop
  }
}

Actor ELCBGhost
{
  Scale 1.3
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    ERUS AAAAAAAAAAA 2 A_FadeOut(0.09)
    Stop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

