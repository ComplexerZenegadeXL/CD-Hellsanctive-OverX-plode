	Loop
  JerichoEnd:
	ERU3 E 7 A_SetUserVar(user_missile,0)
    Goto SeeMKIII
  Melee:
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"MissileMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"MissileMKII")
    ERUS GH 2 A_FaceTarget
    ERUS I 2 A_MeleeAttack
    Goto See
  Pain: 	
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"PainMKIII")
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"PainMKII")
    //TNT1 A 0 ACS_NamedTerminate("EnragedCybruiserUpgrade",0)
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
  	TNT1 A 0 A_Jump(42,"Teleport")	
    ERUS H 4 A_Pain
	//TNT1 A 0 A_Jump(8,"FloorSpam")
	TNT1 A 0 A_Jump(128,"Missile")
    Goto See	
  PainMKII: 	
    TNT1 A 0 ACS_NamedTerminate("EnragedCybruiserUpgrade",0)
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
  	TNT1 A 0 A_Jump(42,"TeleportMKII")	
    ERU2 G 4 A_Pain
	TNT1 A 0 A_Jump(128,"MissileMKII")
    Goto SeeMKII
  PainMKIII: 	
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
  	TNT1 A 0 A_Jump(42,"TeleportMKIII")	
    ERU3 G 4 A_Pain
	TNT1 A 0 A_Jump(128,"MissileMKIII")
    Goto SeeMKIII
  Pain.PlayerDTRG:
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"Pain.PlayerDTRGMKIII")
    TNT1 A 0 A_JumpIf(user_upgrade == 1,"Pain.PlayerDTRGMKII")
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
	TNT1 A 0 A_Jump(128,"BFG10K")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
  DTRGPainLoop:
    ERUS Q 0 A_JumpIf(user_missile >= 4,"RailgunLoop2")	 
    ERUS Q 0 A_SetUserVar("user_missile",user_missile+1)	
    ERUS E 4 A_SpawnItem("EnragedHellionSmokeSpawner")
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
    Loop
  Pain.PlayerDTRGMKII:
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
	TNT1 A 0 A_Jump(128,"BFG10KMKII")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
  DTRGPainLoopMKII:
    TNT1 A 0 A_JumpIf(user_missile >= 4,"RailgunLoop2MKII")	 
    TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)	
    ERU2 E 4 A_SpawnItem("EnragedHellionSmokeSpawner")
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
    Loop
  Pain.PlayerDTRGMKIII:
    TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_10K2,0)
	TNT1 A 0 A_Jump(128,"BFG10KMKIII")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
  DTRGPainLoopMKIII:
    TNT1 A 0 A_JumpIf(user_missile >= 4,"RailgunLoopMKIII")	 
    TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)	
    ERU2 E 4 A_SpawnItem("EnragedHellionSmokeSpawner")
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
    Loop
  Upgrade:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,1)
	TNT1 A 0 A_GiveInventory("Upgrading",1)
	TNT1 A 0 A_SetUserVar(user_upgrade,user_upgrade+1)
	TNT1 A 0 A_SpawnItemEx("UpgradeLineSpawner",0,0,32)
	TNT1 A 0 A_GiveInventory("EnragedCybruiserShieldGiver",1)
	TNT1 A 0 A_PlaySound("EnragedCybruiser/Upgrade",5,1.0,0,ATTN_NONE)
	TNT1 A 0 ACS_NamedExecuteAlways("EnragedCybruiserUpgrade",0,user_upgrade)
	TNT1 A 0 A_JumpIf(user_upgrade == 1,"UpgradeMKII")
	TNT1 A 0 A_CheckFlag("FRIENDLY",6)
	ERUS E 105
	"####" A 0 A_SpawnItemEx("AutomatonSummoner",70,70,16,0,0,0,0,SXF_NOCHECKPOSITION)
	"####" A 0 A_SpawnItemEx("AutomatonSummoner",70,-70,16,0,0,0,0,SXF_NOCHECKPOSITION)
	"####" A 0 A_SpawnItemEx("AutomatonSummoner",-70,70,16,0,0,0,0,SXF_NOCHECKPOSITION)
	"####" A 0 A_SpawnItemEx("AutomatonSummoner",-70,-70,16,0,0,0,0,SXF_NOCHECKPOSITION)
  UpgradeLoop:
	"####" AAAAAAA 0 A_SpawnItemEx("LegendaryRedPowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 	
	"####" E 4
	Loop
  UpgradeMKII:
    ERU2 E 105
	Goto Upgrade+10
  UpgradeEnd:
	TNT1 AAA 0 A_SpawnItemEx("EnragedDeathBallMedium",frandom(-86,86),frandom(-86,86))
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_TakeInventory("Upgrading",1)
	Goto See
  Death:
    TNT1 A 0 A_JumpIf(user_upgrade == 2,"DeathMKIII")
    TNT1 A 0 A_JumpIf(user_upgrade == 1,"DeathMKII")
    ERUS I 0 A_Scream
	ERUD KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_SpawnItemEx("EnragedDeathBallMedium")
	ERUD LLLMMM 2 A_CustomMissile ("EKaboomLN", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    ERUS N 4 A_NoBlocking
	Goto DeathEnd
  DeathMKII:
    ERU2 H 0 A_Scream
	ERU2 HHHHHHHHHHHHHHHHHHHHIIIIIIIII 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_SpawnItemEx("EnragedDeathBallMedium")
	ERU2 JJJKKK 2 A_CustomMissile ("EKaboomLN", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    ERU2 N 4 A_NoBlocking
	Goto DeathEnd
  DeathMKIII:
    ERU3 H 0 A_Scream
	ERU3 HHHHHHHHHHHHHHHHHHHHIIIIIIIII 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_SpawnItem("EnragedDeathBallMedium")
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("EnragedCommandoStarShock",0,0,15)
	TNT1 A 0 A_SpawnItem("EnragedDTBFGEx")
	ERU3 JJJKKK 2 A_CustomMissile ("EKaboomLN", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    ERU3 N 4 A_NoBlocking
  DeathEnd:
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(4,6),256)
    ERUD QPQR 3
	ERUS S 2 A_ChangeFlag("BRIGHT",0)
    ERUS T -1 A_KillMaster
	Stop
  } 
}

