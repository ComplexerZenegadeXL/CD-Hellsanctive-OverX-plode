Actor ECBFloorSpammer 
{
  Health 200
  Radius 24
  Height 64
  RenderStyle Add
  Alpha 0.0
  Monster
  +NOPAIN
  -COUNTKILL
  var int user_loop;
  Tag "\c[m6]Enraged\c- \c[z3]Legendary Cybruiser\c-"
  States
  {
  Spawn:
    TNT1 AAA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
    ERUS IIH 3 A_FadeIn(0.1)
	TNT1 AAA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	ERUS HGG 3 A_FadeIn(0.1)
  SpawnLoop:
    TNT1 A 0 A_JumpIf(user_loop >= 16,"SpawnEnd")
	TNT1 AAA 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	ERUS GGG 3 A_CustomMissile("ELegNobleBall3Small",0,0,frandom(0,360))
	TNT1 A 0 A_SetUserVar(user_loop,user_loop+1)
	Loop
  SpawnEnd:
    ERUS I 3 A_FadeOut(Alpha - 0.1)
	Loop
  Death:
    ERUS J 2 A_FadeOut(Alpha - 0.1)
	Loop
  }
}

