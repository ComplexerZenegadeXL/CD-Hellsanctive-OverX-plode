Actor EnragedLegendaryAutomaton
{
  Monster
  Health 1700
  Height 64
  Radius 24
  Mass 1000
  Speed 8
  Scale 1.1
  BloodColor "Red"
  PainChance 60
  MeleeDamage 8
  +NOFEAR
  -COUNTKILL
  -BOSSDEATH
  +FLOORCLIP
  +FASTMELEE
  +MISSILEMORE
  +NOTIMEFREEZE
  +DONTHURTSPECIES
  +LOOKALLAROUND
  +BRIGHT
  Species "Nobles"
  DamageFactor "NobleComet", 0.0
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "Cyber10K", 0.0
  DropItem ""
  SeeSound "monster/brusit" 
  PainSound "cbaron/pain"
  DeathSound "cbaron/death"
  MeleeSound "baron/melee"
  ActiveSound "cbaron/active"
  Obituary "$CFEnragedLegendaryAutomatonObit"
  HitObituary "$CFEnragedLegendaryAutomatonHitObit"
  Tag "\c[m6]Enraged\c- \c[z3]Legendary Automaton\c-"
  States 
  {
  Spawn: 
	ECBS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
  SpawnLoop:
	ECBS AAZZ 7 A_Look
	Loop 
  See:
	ECBS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	ECBS CCDD 3 A_Chase
	TNT1 A 0 A_Playsound("monster/bruwlk")
	Loop
  Pause:
	ECBS E 10
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BurstBall","LargeBall","Rocket")
  Melee:
  Normal:
	ECBS E 8 A_FaceTarget
	ECBS E 15 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("RedShellCasing", 0, 32, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("LegendaryRedTracer",44,24,frandom(-6,6),0)
	TNT1 A 0 A_CustomBulletAttack(8.0,3.0,6,Random(10,15)*4,"EnragedBulletPuff",0,CBAF_NORANDOM)
	ECBS F 2 Bright A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
	TNT1 A 0 A_Jump(64,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+1
  BurstBall:
	ECBS PQ 7 A_FaceTarget 
	ECBS R 1 Bright A_CustomMissile("ELegNobleBall2",32,0,0)
	TNT1 A 0 A_CustomMissile("ELegNobleBall2",32,0,6)
	ECBS R 5 Bright A_CustomMissile("ELegNobleBall2",32,0,-6)
	TNT1 A 0 A_Jump(87,"LargeBall","Rocket")
	Goto See
  LargeBall:
	ECBS PQ 7 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ELegNobleComet",32,0,-30)
	TNT1 A 0 A_CustomMissile("ELegNobleComet",32,0,30)
	ECBS R 6 Bright A_CustomMissile("BigRedComet",32,0,0)
  Rocket:
	ECBS E 10 A_FaceTarget
	ECBS F 8 Bright A_CustomMissile("EnragedRocket",32,0,0,0)
	ECBS E 10
	Goto See
  Pain: 
	ECBS H 4 A_Pain
	TNT1 A 0 A_Jump(87,"Missile")
	Goto See	
  Death:
	TNT1 A 0 A_ChangeFlag(BRIGHT,0)
	ECBS I 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	ECBS JJJKKK 2 A_CustomMissile("EKaboomLN",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("EnragedDeathBallSmall")
	ECBS L 4 A_NoBlocking
	CBOD MN 3
	ECBS O -1
	Stop
  } 
}

