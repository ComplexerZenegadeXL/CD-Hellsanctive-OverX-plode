Actor EnragedCybruiserRail : DTRail
{
  DamageType "NobleComet"
  Damage (Random(75,110))
  SeeSound "weapons/dtrail"
  MissileType "ELCBRailTrail"
  Species ""
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 1
