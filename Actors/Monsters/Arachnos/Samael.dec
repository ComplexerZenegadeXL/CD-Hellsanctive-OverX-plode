Actor Samael : Dualachnotron 
{
  Health 2000
  PainChance 30
  Scale 1.25
  Speed 15
  Radius 52
  Mass 2500
  FloatSpeed 18
  PainChance "SoulToxic", 30
  PainChance "FatFlamer", 30
  PainChance "FiendFire", 30
  PainChance "CacoShocks", 30
  SeeSound "baby/sight"
  PainSound "barachnophyte/pain"
  DeathSound "barachnophyte/death"
  ActiveSound "baby/active"
  AttackSound ""
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY
  +DONTHARMSPECIES
  -FLOORCLIP
  Obituary "$CFSamaelObit"
  Tag "$CFSamael"
  var int user_missile;
  var int user_script;
  var int user_script_type;
  var int user_lowlag;
  States
  {
  Spawn:
	SAML A 0
	TNT1 A 0 A_JumpIf(user_script == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,16)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",15)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	SAML AB 4 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	SAML AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	SAML AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Evade")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	SAML ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	SAML ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
    TNT1 A 0 A_Jump(130,"BFG10K","ExplosiveComets")
  Normal:
    SAML ABAB 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML C 0 A_FaceTarget
	SAML C 6 Bright A_CustomMissile("SamaelFireBall",16,8,frandom(-3,3))
	SAML D 0 A_FaceTarget
	SAML D 6 Bright A_CustomMissile("SamaelFireBall",16,-8,frandom(-3,3))
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML D 0 A_Jump(15,"BFG10K","ExplosiveComets")
	SAML D 0 A_CposRefire
    Goto Normal+4
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    SAML CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile",0)
  BFG10KLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 5,"BFG10KEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	SAML C 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML C 6 Bright A_FaceTarget
	SAML D 0 A_CustomMissile("BabySent10K",20,-8,frandom(-4,4))
	SAML C 0 A_PlaySound("weapons/bfg15kfire")
	SAML D 6 Bright A_FaceTarget
	SAML D 0 A_CustomMissile("BabySent10K",20,-8,frandom(-4,4))
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	Loop
  BFG10KEnd:
    SAML A 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	SAML AAAAA 4 Bright A_FaceTarget
	SAML A 1 A_Jump(60,"ExplosiveComets")
    Goto See
  ExplosiveComets:
    SAML AB 4 Bright A_FaceTarget
	SAML C 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML C 10 Bright A_CustomMissile("ExplosiveComet",16,8,frandom(-3,3))
	SAML D 0 A_FaceTarget
	SAML D 10 Bright A_CustomMissile("ExplosiveComet",16,-8,frandom(-3,3))
	SAML C 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML C 10 Bright A_CustomMissile("ExplosiveComet",16,8,frandom(-3,3))
	SAML D 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	SAML D 10 Bright A_CustomMissile("ExplosiveComet",16,-8,frandom(-3,3))
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
    Goto See
  Pain:
    TNT1 A 0 A_Jump(104,"PainMissile")
    SAML A 3 Bright A_Pain
	SAML A 3 Bright
    Goto See
  PainMissile:
    SAML A 3 Bright A_Pain
	SAML A 3 Bright
    Goto Missile
  Death:
    SAML A 20 Bright A_Scream
    SAML E 6 Bright A_Fall
	SAML F 6 Bright
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SAML GGGGG 2 Bright A_CustomMissile("CFKaboom2",frandom(20,40),frandom(-10,10),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",frandom(20,40),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    SAML H 6 Bright
    SAML I 4
	SAML J 2
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    SAML JIHGFE 5
    Goto See
  }
}

Actor ExplosiveComet : IComet
{
  Species "BabySpiders"
  DamageType "Baby15k"
  States
  {
  Death:
	TNT1 A 0 A_Explode
	TNT1 A 0 A_SetTranslucent(0.75,1)
    TNT1 AAA 0 A_SpawnItemEx("SamaelHellFlame",0,0,0,frandom(-6,6),frandom(-6,6),frandom(2,6),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Stop
  }
}

Actor SamaelHellFlame : HellFlame
{
  Species "BabySpiders"
  DamageType "Baby15k"
  States
  {
  Spawn:
  Death:
	TNT1 A 0 A_JumpIf(waterlevel > 1, "OhGodOhFuck")
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	TNT1 A 0 A_SetUserVar("user_fireloop",random(0,8))
	TNT1 A 0 A_PlaySound("monster/ambientfire",7,1.0,1)
  DeathLoop:
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF AABBCC 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(10,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF DDEEFF 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(10,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF GGHHII 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(10,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF KKLLMM 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(10,69)
	Loop
  }
}

Actor AsmodeusHellFlame : HellFlame { DamageType "NobleComet" }

Actor SamaelFireball : BBall
{
  Speed 45
  Species "BabySpiders"
  DamageType "Baby15k"
  FastSpeed 55
  Damage (Random(25,45))
  +SEEKERMISSILE
  States
  {
  Spawn:
    HLK1 AB 1 Bright A_SpawnItemEx("BBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(3,6)
    Loop
  }
}