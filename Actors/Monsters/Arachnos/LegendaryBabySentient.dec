Actor LegBabySentPlasmaBombCharge
{
  Radius 8
  Height 8
  Scale 1.0
  RenderStyle Add
  Projectile
  Speed 0
  +NOCLIP
  +FLOAT
  +FLOATBOB
  +NOGRAVITY
  Species "BabySpiders"
  DamageType "Legendary"
  var int user_maxtime;
  var int user_loop;
  States
  {
  Spawn:
	CBR4 E 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 0 A_PlaySound("legbabybomb/sound3")
	CBR4 D 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 E 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 0 A_SpawnItemEx("LegBabySentPlasmaBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 1 Bright A_SpawnItemEx("YellowParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBR4 D 0 A_JumpIf(user_maxtime >= 7, "Firee")
	CBR4 D 0 A_SetUserVar ("user_maxtime", user_maxtime + 1)
	CBR4 D 1 Bright
	Loop
  Firee: 
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FireeLoop:
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,-15)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,-10)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,-5)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,0)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,5)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,10)
	TNT1 A 0 A_CustomMissile("LegFusionShot",0,16,user_loop * 15,2,15)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 24,2)
	TNT1 A 0 A_Jump(256,"FireeLoop")
	TNT1 A 0 A_JumpIf(user_maxtime >= 5,"Death")
  	TNT1 A 0 A_SetUserVar("user_maxtime",user_maxtime+1)
	TNT1 A 35
	Loop
  Death:
	TNT1 A 1
	Stop
  }
}

