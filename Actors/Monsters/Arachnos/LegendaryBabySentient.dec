Actor LegendaryBabySentient 16513
{
  //$Category Monsters/LCA
  //$Sprite LBBSA1
  //$Title "Legendary Baby Sentient"
  Monster
  Health 1800
  PainChance 60
  Scale 1.25
  Speed 12
  Height 52
  Radius 52
  Mass 2500
  FloatSpeed 8
  SeeSound "legbabysentient/see"
  PainSound "legbabysentient/pain"
  DeathSound "legbabysentient/death"
  ActiveSound "legbabysentient/idle "
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  BloodColor "Blue"
  Species "BabySpiders"
  +BOSS
  +BOSSDEATH
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOICEDEATH
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +NOTIMEFREEZE
  +FLOAT
  +NOGRAVITY	
  +NOFEAR
  -FLOORCLIP
  +NOTELEFRAG
  DropItem "LegendaryArmor" 100
  DropItem "LDemonAmmoBoxPickup" 250
  DropItem "LDemonAmmoPickup" 250
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 170
  DropItem "LegendaryAmmoSphere" 70
  DropItem "BulletBoxPickup" 250
  DropItem "ExplosiveMinigunGiver" 180
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFLegendaryBabySentientObit"
  Tag "$CFLegBS"
  var int user_script;
  var int user_script_type;
  var int user_heal;
  var int user_music;
  var int user_drone;
  var int user_turret;
  var int user_MinionSummoner;
  var int user_traps;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LBBS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",0)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
	LBBS AB 8 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LBBS AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,17)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_script_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_Jump(100,"Rush")
	TNT1 A 0 A_Jump(3,"Trap")
	LBBS A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LBBS AB 2 Bright A_Chase
    Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_script_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	LBBS AAAAA 0 A_Chase
	LBBS A 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LBBS AAAAA 0 A_Chase
	LBBS B 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LBBS AAAAA 0 A_Chase
	LBBS A 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LBBS AAAAA 0 A_Chase
	LBBS B 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LBBS AAAAA 0 A_Chase
	LBBS A 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LBBS AAAAA 0 A_Chase
	LBBS B 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)	
	TNT1 A 0 A_Jump(30,"Teleport","Evade")
	TNT1 A 0 A_Jump(75,"See")
	TNT1 A 0 A_Jump(2,"Trap")
	Loop	
  Evade:
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	LBBS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	LBBS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Teleport:
	LBBS A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LBBS AAAAAAAAAA 1 A_FadeOut(0.1,0)
	LBBS A 2 
	LBBS AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	LBBS A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LBBS AAAAAAAAAA 1 A_FadeIn(0.1)
	LBBS A 1 Bright A_SetShootable
	Goto See		
  Pause:
	LBBS ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_JumpIf(user_MinionSummoner == 1,2)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
    TNT1 A 0 A_JumpIfHealthLower(900,"MinionSummoner")
    TNT1 A 0 A_Jump(128,"Railgun","BFG10K","BFG15K","PlasmaBomb","Cannon","Rage","Trap","EnergyBolt")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    LBBS ABABABA 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    LBBS K 2 Bright A_CustomMissile("LegBabySentientExplosiveTracer",20,0,frandom(-8,8),0)
    LBBS K 1 Bright
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    LBBS L 2 Bright A_CustomMissile("LegBabySentientExplosiveTracer",20,0,frandom(-8,8),0)
	LBBS L 1 Bright
	TNT1 A 0 A_Jump(48,"EnergyBolt")
	TNT1 A 0 A_Jump(24,"Pause","Missile")
    TNT1 A 0 A_SpidRefire
    Goto Normal+15
  Railgun:
	LBBS G 0 A_PlayWeaponSound("legbabysentient/load")
    LBBS CCCC 8 Bright A_FaceTarget
    LBBS D 4 Bright A_CustomMissile("LBSRailBall",28,0,frandom(-2,2)) 
	LBBS C 6 Bright A_FaceTarget
    LBBS D 4 Bright A_CustomMissile("LBSRailBall",28,0,frandom(-2,2)) 
	LBBS C 6 Bright A_FaceTarget
    LBBS D 4 Bright A_CustomMissile("LBSRailBall",28,0,frandom(-2,2)) 
	LBBS C 6 Bright A_FaceTarget	
    LBBS D 4 Bright A_CustomMissile("LBSRailBall",28,0,frandom(-2,2)) 
	LBBS C 6 Bright A_FaceTarget	
	TNT1 A 0 A_Jump(64,"BFG15K")
    Goto See	
  BFG9K:
  	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LBBS CCCCCC 4 Bright A_FaceTarget
    LBBS D 8 Bright A_CustomMissile("LBSBFG9KBall",20,0,0) 
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LBBS CCCCC 4 Bright A_FaceTarget
    LBBS D 8 Bright A_CustomMissile("LBSBFG9KBall",20,0,0)
	TNT1 A 0 A_Jump(144,"BFG10K")
    Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS DCC 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LegendaryBabySentient10KProjectile",10,0,frandom(-2,2)) 
	LBBS D 2 Bright A_FaceTarget
    LBBS C 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	LBBS C 18 Bright
	TNT1 A 0 A_Jump(144,"BFG15K")
    Goto See  
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LBSBFG15KBall",10,0,frandom(-2,2)) 
	LBBS DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LBSBFG15KBall",10,0,frandom(-2,2)) 
	LBBS DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LBSBFG15KBall",10,0,frandom(-2,2)) 
	LBBS DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LBSBFG15KBall",10,0,frandom(-2,2)) 
	LBBS DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LBBS D 2 Bright A_CustomMissile("LBSBFG15KBall",10,0,frandom(-2,2)) 
	LBBS D 2 Bright A_FaceTarget
    LBBS C 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	LBBS CCCCC 4 Bright
	TNT1 A 0 A_Jump(144,"PlasmaBomb")
    Goto See
  PlasmaBomb:
	TNT1 A 0 A_PlaySound("legbabysentient/see")
    LBBS CCCCCC 4 Bright A_FaceTarget
    LBBS D 2 Bright A_CustomMissile("LegBabySentPlasmaBomb",10,0,frandom(-2,2)) 
	LBBS D 4 Bright A_FaceTarget
	LBBS CCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(144,"Cannon")
    Goto See	
  Cannon:   
	LBBS C 0 A_GiveInventory("BossProtectionTierII",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	LBBS CC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/charge")
    LBBS CCCCCC 4 Bright A_FaceTarget
	LBBS C 1 Bright A_FaceTarget
	LBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CannonLoop:
	LBBS C 4 Bright A_FaceTarget
	LBBS D 0 A_PlayWeaponSound("legendarycannon/fire")
	LBBS D 4 Bright A_CustomMissile("LBSCannonProj",15,0,frandom(-2,2))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto CannonLoop
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(110,"Rage")
	Goto See
  Rage:
  	LBBS C 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
	LBBS C 0 A_PlaySound("legbabysentient/see")
    LBBS CCCCCCCC 4 Bright A_FaceTarget
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,120,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-120,6)
	LBBS CC 4 Bright A_FaceTarget
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,120,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-120,6)
	LBBS CC 4 Bright A_FaceTarget
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-80,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,120,6)
	LBBS C 0 A_CustomMissile("LBSRageBall",20,0,-120,6)
	LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	LBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_Jump(64,"Trap")
	Goto See
  Trap:
    TNT1 A 0 A_JumpIf(user_traps >= 3,"Missile")
  	LBBS C 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
	LBBS C 0 A_PlaySound("legbabysentient/see")
    LBBS CCCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_traps",user_traps+1)
	LBBS CCCCCCCCCCC 0 A_SpawnItemEx("LBSTrapSpawner",0,0,0,0,0,0,0,32,64)
	LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	LBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  MinionSummoner:
    TNT1 A 0 A_SetUserVar("user_MinionSummoner",1)
    LBBS C 1 Bright A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
	TNT1 A 0 A_PlaySound("legbabysentient/see")
	LBBS CCCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(Reflective,1)
	TNT1 A 0 A_Playsound ("hk/summon")
	TNT1 A 0 A_CustomMissile("SpiderSummoner1",20,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("SpiderSummoner2",20,0,180,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("SpiderSummoner3",20,0,225,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("SpiderSummoner4",20,0,305,CMF_AIMDIRECTION)
	LBBS C 25 Bright
	TNT1 AAA 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(Reflective,0)
	Goto See	
  Drone:
    TNT1 A 0 A_JumpIf(user_drone >= 4,"Trap")
  	LBBS C 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
	LBBS C 0 A_PlaySound("legbabysentient/see")
    LBBS CCCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_drone",user_drone+1)
	LBBS CCCCCCCCCC 0 A_SpawnItemEx("LBSPredatorSpawner",0,0,0,0,0,0,0,32,64)
	LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	LBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Turret:
    TNT1 A 0 A_JumpIf(user_turret >= 3,"Trap")
  	LBBS C 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",13)
	LBBS C 0 A_PlaySound("legbabysentient/see")
    LBBS CCCCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_turret",user_turret+1)
	LBBS CCCCCC 0 A_SpawnItemEx("LBSTurretSpawner",0,0,0,0,0,0,0,32,64)
	LBBS CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	LBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  EnergyBolt:
    LBBS CD 2 Bright A_CustomMissile("LBSEnergyBolt",20,0,frandom(-3,3),0)
	TNT1 A 0 A_Jump(24,"Pause","Missile")
    TNT1 A 0 A_SpidRefire
    Goto EnergyBolt
  Pain:	
	TNT1 A 0 A_Jump(45,"Teleport")
	TNT1 A 0 A_Jump(40,"Healing","Trap")
    TNT1 A 0 A_Jump(185,"PainMissile")
    LBBS A 3 Bright A_Pain
	LBBS A 3 Bright
    Goto See
  PainMissile:
    LBBS A 3 Bright A_Pain
	LBBS A 3 Bright
    Goto Missile
  Healing:
	TNT1 A 0 A_JumpIf(user_heal >= 3,"See")
	TNT1 A 0 A_SetUserVar("user_effect_type",10)
	TNT1 A 0 A_PlaySoundEx("monsters/volsee","HEAL")
	TNT1 A 0 A_SetInvulnerable
	LBBS A 0 A_SetUserVar("user_heal",user_heal+1)
	LBBS A 2 Bright HealThing(450)
	LBBS A 46 Bright
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	TNT1 A 0 A_UnSetInvulnerable
	LBBS A 2 Bright
	Goto See
  Death:
    LBBS A 20 Bright A_Scream
    LBBS E 6 Bright A_Fall
	LBBS F 6 Bright
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	TNT1 AAA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LBBS GGGGG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LBBS H 6 Bright
    LBBS I 4
	LBBS J 2
    Stop
  }
}

Actor LegBabySentientExplosiveTracer : LegSentientExplosiveTracer { Species "BabySpiders" DamageType "Legendary" }

Actor LegBabySentientKaboomGold : KaboomGold { Speed 1 Scale 0.45 }

Actor LBSBFG15KBall : BFG15KBall
{
  Height 15
  Radius 15
  Decal "LegBFG15K"
  Speed 65
  Damage (Random(100,200)) //35
  Species "BabySpiders"
  DamageType "Legendary"
  Scale 1.0
  -THRUSPECIES
  -MTHRUSPECIES
  +FORCERADIUSDMG
  +SKYEXPLODE
  +NOTIMEFREEZE
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
    LFS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
	LFS1 A 0 A_Explode(64,192,0)
	LFS1 A 0 A_SpawnItemEx("DTech10KShockwaveGold",0,0,15,0,0,0,0,SXF_CLIENTSIDE)
	LFS1 AB 8 Bright A_SpawnItemEx("DTech10KShockwaveGold",0,0,15,0,0,0,0,SXF_CLIENTSIDE)
	LFS1 A 0 A_Explode(64,192,0)
	LFS1 A 0 A_SpawnItemEx("DTech10KShockwaveGold",0,0,15,0,0,0,0,SXF_CLIENTSIDE)
	LFS1 AB 8 Bright A_SpawnItemEx("DTech10KShockwaveGold",0,0,15,0,0,0,0,SXF_CLIENTSIDE)
