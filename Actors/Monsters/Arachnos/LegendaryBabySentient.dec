Actor LBSTrap
{
  Radius 20
  Height 56
  Health 10
  Mass 8000
  Species "BabySpiders"
  +NOGRAVITY
  +SHOOTABLE
  +FLOATBOB
  +FLOAT
  +THRUSPECIES
  +NORADIUSDMG
  +LOOKALLAROUND
  +AMBUSH
  +NOBLOOD
  -SOLID
  +NOTIMEFREEZE
  Scale 2.0
  DamageType "Legendary"
  DamageFactor "Legendary", 0.0
  DamageFactor "Baby15K", 0.0
  var int user_timer;
  States
  {
  Spawn:
    TNT1 A 0 A_JumpIf(user_timer >= 30,"Death")
	TNT1 A 0 A_SetUserVar("user_timer",user_timer+1)
    CBR6 B 0 A_PlaySound("legbabysentient/trap")
    CBR6 BBAAAAAAAA 2 Bright A_Look
    Loop
  See:
	CBR6 B 0 A_PlaySound("legbabysentient/trap")
    CBR6 BAAAA 2 Bright A_Chase("","Missile",CHF_DONTMOVE)
	TNT1 A 0 A_Jump(64,"Clear")
	Loop
  Clear:
	CBR6 A 1 Bright A_ClearTarget
	Goto Spawn	
  Missile:
	CBR6 A 1 Bright A_CustomMissile("LBSTrapProj",0,0,0)
	Stop	
  Death:
	TNT1 A 0
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0
    Stop
  }
}

