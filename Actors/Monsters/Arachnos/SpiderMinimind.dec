//Enemy from older complex version

Actor SpiderMinimind : Dualachnotron //21259
{
  Obituary "$CFSpiderMinimindObit"
  Health 750
  PainChance 30
  Scale 1.1
  Speed 13
  DropItem "LifeEssence" 110
  SeeSound "CGunSpider/Sight"
  PainSound "monsters/fusionitepain"
  DeathSound "CGunSpider/Death"
  AttackSound "Null"
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  +MISSILEMORE
  +MISSILEEVENMORE
  Tag "$CFBabyMind"
  var int user_lowlag;
  States
  {
  Spawn:
    CHPI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CHPI A 10 A_Look
    Loop
  See:
    TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CHPI ABBCCDDEEFF 2 A_Chase
    Goto See
  MoreSee:
    TNT1 A 0 A_SetUserVar(user_lowlag,1)
	CHPI A 2 A_BabyMetal
    CHPI ABBCC 2 A_Chase
    CHPI D 2 A_BabyMetal
    CHPI DDEEFF 2 A_Chase
    Goto See
  Missile:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    CHPI A 10 A_FaceTarget
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(26,32),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", -8, 6, 28, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("RifleCasing", -12, 6, 28, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("ProjectileBullet",38,0,frandom(-16,16))
	TNT1 A 0 A_CustomBulletAttack(22.5, 18.3,4,Random(9,15),"SpiderBulletpuff",0,CBAF_NORANDOM)
    CHPI G 2 Bright A_PlaySoundEx("weapons/minigunfire","Weapon")
	CHPI H 2 Bright A_PlaySound("monsters/darkmasterwind2")
    TNT1 A 0 A_SpidRefire
	Goto Missile+2
  Pain:
    TNT1 A 0 A_Jump(87,"PainMissile")
    CHPI I 12 A_Pain
    Goto See
  PainMissile:
    CHPI I 12 A_Pain
    Goto Missile	
  Death:
    CHPI I 25 A_Scream
	CHPI J 6
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	CHPI KKKKKK 3 Bright A_CustomMissile("CFKaboom2", frandom(20,40), frandom(10,-10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CHPI L 6 A_NoBlocking
    CHPI MN 6
    CHPI O 6
    CHPI P -1
    Stop
  Raise:
   	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    CHPI PONMLKJ 5
    Goto See+1
  }
}

Actor SpiderBulletpuff : ModdedBulletPuff { Species "BabySpiders" DamageType "Baby15K" }