Actor Aracknight : Dualachnotron
{
  Health 1466
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Cacolich", 0.0
  DamageFactor "Acid", 0.6
  Radius 52
  Scale 1.0
  Height 64
  Mass 600
  Speed 8
  PainChance 21
  BloodColor "Blue"
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "BossLifeEssence" 230 25
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  //Species "SatanGuard"
  DamageFactor "DTRPlayer", 0.5
  DamageFactor "SatanGuard", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "Baby15K", 0.0
  Obituary "$CFAracknightObit"
  SeeSound "arakn/sight"
  PainSound "arakn/fusionitepain"
  DeathSound "arakn/death"
  ActiveSound "arakn/active"
  Species "BabySpiders"
  Tag "$CFArackn"
  Monster
  +NOFEAR
  +AVOIDMELEE
  +NOTARGET
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +MISSILEMORE
  var int user_loop;
  States
  {
  Spawn:
    ARAK A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    ARAK A 10 A_Look
    Loop
  See:
    ARAK A 1 A_BabyMetal
    ARAK AABBBCCC 1 A_Chase
    ARAK D 1 A_BabyMetal
    ARAK DDEEEFFF 1 A_Chase
    Goto See
  Missile:
    TNT1 A 0 A_Jump(80,"MiniComets","CerebralDrain","BouncerGroundshot")
  Normal:
    ARAK A 0 A_PlaySound("arakn/charge",0,2.0,0)
    ARAK AA 5 A_FaceTarget
    NLoop:
    ARAK G 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	TNT1 A 0 A_CustomMissile("ArackBall",30,0,frandom(-13,13),0)
    ARAK H 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
    TNT1 A 0 A_Jump(80,"MiniComets","CerebralDrain","BouncerGroundshot")
    Goto See
  MiniComets:
	ARAK AAAA 6 A_FaceTarget
    ARAK G 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ArackComet",30,0,frandom(-20,20),0)
    ARAK H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ArackComet",30,0,frandom(-20,20),0)
	ARAK G 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ArackComet",30,0,frandom(-20,20),0)
    ARAK H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ArackComet",30,0,frandom(-20,20),0)
    ARAK A 14
    TNT1 A 0 A_Jump(42,"Missile")
	Goto See
  BouncerGroundshot:
	ARAK A 15
	ARAK BBBBBBBBB 2 Bright A_SpawnItemEx("BlueFire2",0,0,35,0,0,frandom(5,11))
	ARAK C 1 Bright A_FaceTarget
	TNT1 AAAAAAAAAAAAA 0  A_CustomMissile("Kaboom23", frandom(20,40), frandom(10,-10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFlare2",0,0,37)
	TNT1 A 0 A_CustomMissile("AracknightGrounder",0,0,0)
	TNT1 A 0 A_CustomMissile("AracknightGrounder",0,0,25)
	TNT1 A 0 A_CustomMissile("AracknightGrounder",0,0,-25)
	ARAK C 5 Bright
	ARAK A 15
    TNT1 A 0 A_Jump(42,"Missile")
	Goto See
  CerebralDrain:
	 TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	 ARAK A 1 A_PlaySound("exile/voidstart")
	 ARAK A 6 A_FaceTarget
  VileChargeLoop:
	 TNT1 A 0 A_JumpIfInventory("Tic",210,"CheckLOS")
	 TNT1 A 0 A_SpawnItemEx("AracknightVileFire",0,0,60)
	 TNT1 A 0 HealThing(2)
	 TNT1 A 0 A_CustomMissile("AracknightVileFire",0,0,0)
  CheckLOS1:
	 ARAK G 4 Bright A_FaceTarget
	 TNT1 A 0 A_GiveInventory("Tic",4)
	 TNT1 A 0 A_JumpIfInventory("Tic",210,"CheckLOS")
	 TNT1 A 0 A_JumpIfTargetInLos("VileChargeLoop",360)
	 Loop
  CheckLOS:
	 TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	 TNT1 A 0 A_TakeInventory("Tic",999)
	 TNT1 A 0 A_JumpIfTargetInLos("VileExplode",360)
	 ARAK G 4
	 Goto See
  VileExplode:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	ARAK G 3 Bright A_FaceTarget
	TNT1 A 0 HealThing(80)
	TNT1 A 0 A_VileTarget("AracknightVileExplode")
	ARAK G 2 Bright A_FaceTarget
	ARAK A 5
    TNT1 A 0 A_Jump(32,"Missile")
	Goto See
  Pain:
    ARAK I 7 A_Pain
    Goto See	
  Death:
    ARAK I 10 A_Scream
	ARAK J 6
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ARA2 K 2 Bright A_CustomMissile("Kaboom23", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ARAK L 6 A_NoBlocking
    ARAK MNO 6
    ARAK P -1 
    Stop
  Raise:
	Stop
  }
}
Actor ArackComet : MiniComet
{
  Species "BabySpiders"
  DamageType "Baby15K"
  States
  {
  Death:
	TNT1 A 0 A_Explode(Random(64,96),Random(128,192),0)
	TNT1 A 0 A_RadiusGive("SlayersOmen",32,RGF_PLAYERS,1)
	TNT1 A 0 A_RadiusGive("DefilersMark",32,RGF_PLAYERS,1)
	TNT1 A 0 A_RadiusGive("SlayersOmen",16,RGF_MONSTERS,1)
	TNT1 A 0 A_RadiusGive("DefilersMark",16,RGF_MONSTERS,1)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM D 3 Bright A_SpawnItemEx("BlueCometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HPCM E 3 Bright A_SpawnItemEx("BlueCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}
Actor ArackBall : PaladinBall
{
  Species "BabySpiders"
  DamageType "Baby15K"
  Speed 32
  FastSpeed 36
  States
  {
  Spawn:	
    SATL AB 1 Bright A_SpawnItemEx("ArackBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
    Loop
  Death:
	SATC K 5 Bright
	TNT1 A 0 A_RadiusGive("DefilersMarkWeak",32,RGF_PLAYERS,1)
	TNT1 A 0 A_RadiusGive("DefilersMarkWeak",64,RGF_MONSTERS,1)
	SATC LMNOPQRSTUVWX 2 Bright A_FadeOut(0.015,1)
	Stop
  XDeath:
	SATC K 5 Bright
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_SpawnItemEx("PaladinBTrail2",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_RadiusGive("DefilersMarkWeak",32,RGF_PLAYERS,1)
	TNT1 A 0 A_RadiusGive("DefilersMarkWeak",64,RGF_MONSTERS,1)
	SATC LMNOPQRSTUVWX 2 Bright A_FadeOut(0.015,1)
	Stop
  }   
}

Actor ArackBallTrail
{
  RenderStyle Add
  Gravity 0.0
  Alpha 0.78
  +CLIENTSIDEONLY
   +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
    TNT1 A 1
    SATL ABABABAB 1 Bright A_FadeOut(0.1)
	Stop
  }
}

Actor AracknightVileFire
{
  XScale 1.0
  YScale 0.6
  Projectile
  RenderStyle Add
  Alpha 1.0
  Height 3
  Radius 3
  VSpeed 7
  Species "BabySpiders"
  Obituary "$CFAracknightVileFireObit"
  DamageType "Baby15K"
  +SEEKERMISSILE
  +PIERCEARMOR
  +NODAMAGETHRUST
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Warp(AAPTR_TRACER,11,0,36,0,WARPF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("DSFLAME",0,1.0,0)
	TNT1 A 0 A_SpawnItem("AracknightFireSpawner",0,0,0,0)
	SAFX C 3
    TNT1 A 0 A_Explode(2,75,0,0,75)
	SAFX CDDFFGGHHH 1 A_FadeOut
    Stop
  }
}
Actor AracknightVileFireB : AracknightVileFire
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("DSFLAME",0,1.0,0)
	TNT1 A 0 A_SpawnItem("AracknightFireSpawner",0,0,0,0)
	SAFX C 3 Bright
	SAFX CDDFFGGHHH 1 Bright A_FadeOut
    Stop
  }
}

Actor AracknightFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("Kaboom23",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(2,4),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("BlueFire2",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(4,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor AracknightVileExplode : AracknightVileFire
{
  States
  {
  Spawn:
	SAFX C 2 Bright
	TNT1 A 0 A_PlaySound("monsters/newfireexplode",0,1.0,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("AracknightFireSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_Explode(55,150,0,0,125)
	SAFX DDFFGGHHH 1 Bright A_FadeOut
    Stop
  }
}

Actor AracknightFireSpawner2 : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("Kaboom23",frandom(-16,16),frandom(-16,16),frandom(6,12),frandom(-5,5),frandom(-5,5),frandom(9,11),frandom(0,360),SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("BlueFire2",frandom(-16,-16),frandom(-16,16),frandom(6,12),frandom(-5,5),frandom(-5,5),frandom(7,9),frandom(0,360),SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor AracknightGrounder : HeresiarchTrail
{
  Bouncecount 4
  BounceFactor 1.1
  WallBounceFactor 1.1
  +HEXENBOUNCE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Species "BabySpiders"
  Damagetype "Baby15K"
}