Actor BabyBFGMastermind : Dualachnotron 23399
{
  Health 1500
  PainChance 70
  Scale 1.2
  Speed 13
  Radius 52
  SeeSound "minidemo/sight"
  ActiveSound "minidemo/active"
  PainSound "monsters/fusionitepain"
  DeathSound "minidemo/death"
  AttackSound ""
  DropItem "LifeEssence" 140
  DropItem "ArmorBonusMax" 140
  DropItem "NewCellPackPickup" 140
  DamageFactor "Baby15K", 0.0
  DropItem "RailgunGiver"
  Species "BabySpiders"
  +MISSILEMORE
  Obituary "$CFBabyBFGMastermindObit"
  Tag "$CFBbfgSpid"
  States
  {
  Spawn:
    BABM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BABM A 10 A_Look
    Loop
  See:
    BABM A 2 A_BabyMetal
    BABM ABBCC 2 A_Chase
    BABM D 2 A_BabyMetal
    BABM DEEFF 2 A_Chase
    Loop
  Missile:
    TNT1 A 0 A_Jump(82,"BFG15K","BFG10K")
  Normal: 
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    BABM G 13 A_FaceTarget
	BABM G 5 Bright A_FaceTarget
	BABM H 4 Bright A_CustomMissile("BabySpiderRail",20,0,0) 
    BABM G 35 Bright A_FaceTarget	
	TNT1 A 0 A_Jump(20,"BFG15K","BFG10K")
    Goto Missile
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    BABM G 18 Bright A_FaceTarget
	BABM G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget	
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 	
    BABM G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BABM H 4 Bright A_CustomMissile("BabyBFGM10K",20,0,frandom(4,-4)) 
    BABM G 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
    Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    BABM G 18 Bright A_FaceTarget
	BABM G 6 Bright A_FaceTarget
    BABM H 6 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget
    BABM H 6 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget	
    BABM H 6 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 	
    BABM G 6 Bright A_FaceTarget
    BABM H 4 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget
    BABM H 6 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 
    BABM G 6 Bright A_FaceTarget	
    BABM H 6 Bright A_CustomMissile("BabyDemo15K",20,0,frandom(4,-4)) 
    BABM G 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
    Goto See
  Pain:
    TNT1 A 0 A_Jump(87,"PainMissile")
    BABM I 12 A_Pain
    Goto See
  PainMissile:
	BABM I 12 A_Pain
    Goto Missile
  Death:
    BABM I 20 A_Scream
	BABM J 6
	TNT1 AAA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BABM KKKKK 2 Bright A_CustomMissile("Kaboom5", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BABM L 6 A_NoBlocking
    BABM MN 6
    BABM O 6
    BABM P -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    BABM PONMLKJ 5
    Goto See+1
  }
}

Actor BabyBFGM10K : DarkDemo10k
{
  DamageType "Baby15K"
  Species "BabySpiders"
  States
  {
  Death:
  XDeath:  
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("BabyBFGM10KEx")
    Stop
  }
}

Actor BabyBFGM10KEx : Player10KEx
{
  Radius 11
  Height 8
  Decal "BFG15KLightning"
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT 
  +FORCERADIUSDMG
  DamageType "Baby15K"
  Species "BabySpiders"
  Renderstyle Add
  Alpha 0.75
  Scale 0.85
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE1 A 4 Bright A_Explode(100,100,0)
    BFE1 BCDEF 4 Bright
    Stop
  }
}


Actor BabySpiderRail : FastProjectile
{
  Radius 5
  Height 5
  Speed 300
  Damage (Random(40,60))
  Decal "BFG9500Lightning"
  Scale 1.15
  SeeSound "monsters/darkcyberrail"
  MissileType "DarkCyberRailTrail"
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  DeathSound "cyberrail/impact"
  +RIPPER
  +THRUSPECIES
  +BLOODLESSIMPACT
  States
  {
  Spawn:
    DCRP A 1 Bright
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 1 A_SpawnItemEx("RailgunImpactEffectGreen")
	Stop
  }
}

