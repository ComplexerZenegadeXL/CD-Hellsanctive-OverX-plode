Actor BabyInsanitySpider : BabyDemolisher
{
  Health 1400
  PainChance 80
  Scale 1.2
  Speed 16
  DamageFactor "Normal", 0.65
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "NewCellPack" 128
  SeeSound "arakn/sight"
  DeathSound "arakn/death"
  ActiveSound "arakn/active"
  AttackSound ""
  +MISSILEMORE 
  Obituary "$CFBabyInsanitySpiderObit"
  Tag "$CFBInsSp"
  var int user_lowlag;
  States
  {
  Spawn:
	DVSP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DVSP A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DVSP AB 2 A_Chase
	TNT1 A 0 A_BabyMetal
	Loop
 MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_BabyMetal
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
    DVSP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP B 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP B 2 A_Chase
	TNT1 A 0 A_BabyMetal	
    TNT1 A 0 A_SpawnItemEx("InsanesmolGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP D 2 A_Chase
	TNT1 A 0 A_BabyMetal	
    TNT1 A 0 A_SpawnItemEx("InsanesmolGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP E 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP E 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP F 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsanesmolGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DVSP F 2 A_Chase  
	Loop
  Pause:
	DVSP A 10
	Goto See
  Missile:
	TNT1 A 0 A_Jump(100,"Railgun")
	TNT1 A 0 A_Jump(80,"Minidtbfg")
  Dtech:
	DVSP G 12 Bright A_FaceTarget
	DVSP G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("InsanesmolDemonTech",20,0,frandom(-4,4))
	DVSP H 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(20,"Pause")
	TNT1 A 0 A_Jump(12,"Railgun")
	TNT1 A 0 A_SpidRefire
	Goto Dtech+1
  Railgun:
	TNT1 A 0 A_ChangeFlag("Nopain",1)
	DVSP G 8 A_PlaySound("weapons/rgcharge")
	TNT1 A 0 A_FaceTarget
	DVSP GGGG 5 Bright A_FaceTarget
	DVSP G 6 Bright
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	DVSP H 5 Bright A_CustomMissile("CardinalRail",40,0,frandom(-4,4)) 
	DVSP G 35 Bright
	TNT1 A 0 A_ChangeFlag("Nopain",0)
	Goto See
  Minidtbfg:
	TNT1 A 0 A_ChangeFlag("Nopain",1)
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGCharge")
	DVSP GGGGGGG 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	DVSP H 4 Bright A_CustomMissile("InsaneMiniDTBFG10kball",20,0,0)   
	DVSP G 20 Bright
	TNT1 A 0 A_ChangeFlag("Nopain",0)
	Goto See
  Pain:
	DVSP I 12 A_Pain
	TNT1 A 0 A_Jump(87,"Missile")
	Goto See
  Death:
	DVSP I 20 A_Scream
	DVSP J 6
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	DVSP KKKKK 2 Bright A_CustomMissile("CFKaboom2", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	DVSP L 6 A_NoBlocking
	DVSP MN 6
	DVSP O 6
	DVSP P -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DVSP PONMLKJI 5
	Goto See
  }
}

//Projectiles
Actor InsanesmolDemonTech : RedZDemonTechProjectile
{
  Species "BabySpiders"
  DamageType "Baby15k"
  Speed 75
  Damage (Random(15,30)) //4
}

Actor InsaneRail : CardinalRail { Species "BabySpiders" DamageType "Baby15k" }

Actor InsaneMiniDTBFG10kball : LesserCardinalMiniDTBFG
{
  Species "BabySpiders"
  DamageType "Baby15K"
  Obituary "$CFInsaneMiniDTBFG10kBallObit"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("LesserCardinal/BFGIdle","Voice",1)
    CRS1 ABCDABCD 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",Random(-12,12),Random(-12,12),Random(12,22),Random(-2,2),Random(-2,2),Random(-2,2),Random(-20,20),128)
    TNT1 A 0 A_CustomMissile("BabyInsaneSpiderBFGProjectileAttack",Random(-10,10),0,0,CMF_TRACKOWNER)
    Loop  
  }
}

Actor BabyInsaneSpiderBFGProjectileAttack : LesserCardinalBFGProjectileAttack
{
  Species "BabySpiders"
  DamageType "Baby15K"
  Obituary "$CFBabyInsaneSpiderBFGProjectileAttackObit"
  States
  {
  Attack:
    TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomMissile("BabyInsaneSpiderLightningProjectile",-2,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto Death	
  }
}

Actor BabyInsaneSpiderLightningProjectile : LesserCardinalLightningProjectile { Species "BabySpiders" DamageType "Baby15K" }

Actor InsanesmolGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  Scale 1.15
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
	DVSP A 2 A_FadeOut(0.18)
	Loop  
  }
}

