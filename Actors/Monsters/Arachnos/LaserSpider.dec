Actor LaserSpider : Dualachnotron
{
  Monster
  Health 850
  Height 64
  Radius 52
  Mass 600
  Speed 5
  Scale 1.2
  BloodColor "Black"
  ReactionTime 25
  PainChance "Mine", 128
  MaxTargetRange 4096
  PainChance 45
  +FLOORCLIP
  +BOSSDEATH
  +AVOIDMELEE
  +MISSILEMORE
  +DONTHARMSPECIES
  Species "BabySpiders"
  DamageType "Baby15K"
  DamageFactor "Acid", 3.8
  //No Infighting
  DamageFactor "Baby15K", 0.0
  DropItem "BossLifeEssence", 196, 100
  DropItem "CFBossArmorBonusMax25", 196
  DropItem "CFArmorBonusMax5", 196
  DropItem "CFArmorBonusMax5", 196
  SeeSound "CGunSpider/Sight"
  PainSound "monsters/fusionitepain"
  DeathSound "CGunSpider/Death"
  AttackSound "Null"
  Obituary "$CFLaserSpiderObit"
  Tag "$CFLaserSp"
  States
  {
  Spawn:
	LSPI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	LSPI A 10 A_Look
	Loop
  See:
	LSPI A 1 A_BabyMetal
	LSPI AAAAA 1 A_Chase("","")
	TNT1 A 0 A_Jump(8,"MissileD1")
  See1:
	LSPI BBBB 1 A_Chase("","")
	TNT1 A 0 A_Jump(3,"MissileD2")
  See2:
	LSPI CCCC 1 A_Chase("","")
	TNT1 A 0 A_Jump(3,"MissileD3")
  See3:
	LSPI D 1 A_BabyMetal
	LSPI DDDD 1 A_Chase("","")
	TNT1 A 0 A_Jump(3,"MissileD4")
  See4:
	LSPI EEEE 1 A_Chase("","")
	TNT1 A 0 A_Jump(3,"MissileD5")
  See5:
	LSPI FFFFF 1 A_Chase("","")
	TNT1 A 0 A_Jump(80,"MissileD6")
	Goto See
  MissileD1:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See1
  MissileD2:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See2
  MissileD3:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See3
  MissileD4:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See4
  MissileD5:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See5
  MissileD6:
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See
  Missile:
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind",CHAN_AUTO)
	LSPI AAAAA 2 A_FaceTarget(45)
  MissileLoop: //because rapid fire railguns are fun
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2",CHAN_AUTO)
	TNT1 A 0 A_CustomMissile("SpecOpsLaser",29,0,frandom(-4,4),0)
	LSPI G 2 Bright A_PlaySound("monsters/fusionfire",CHAN_WEAPON)
	LSPI GG 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("SpecOpsLaser",29,0,frandom(-4,4),0)
	LSPI H 2 Bright A_PlaySound("monsters/fusionfire",CHAN_WEAPON)
	LSPI HH 1 Bright A_FaceTarget
	TNT1 A 0 A_Jump(8,"See")
	TNT1 A 0 A_SpidRefire
	Loop
  Pain:
	TNT1 A 0 A_Jump(61,"PainMissile")
	LSPI I 12 A_Pain
	Goto See
  PainMissile:
	LSPI I 12 A_Pain
	Goto Missile	
  Death:
	LSPI I 20 A_Scream
	LSPI J 6 A_KillChildren
	TNT1 AA 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LSPI KKKKK 2 Bright A_CustomMissile("CFKaboom2",frandom(20,40),frandom(-10,10),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",frandom(20,40),0,frandom(0,360),2,frandom(0,360))
	LSPI L 6 A_Fall
	TNT1 A 0 A_RemoveChildren
	LSPI MN 6
	LSPI O 6
	LSPI P -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LSPI PONMLKJ 5
	Goto See
  }
}

Actor SpiderLaser : SpecOpsLaser { Species "BabySpiders" DamageType "Baby25k" }

Actor RailgunImpactSpiderPuff
{
  Decal None
  +RIPPER
  +NOBOSSRIP
  +NOGRAVITY
  +NOBLOCKMAP
  +RANDOMIZE
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  +NODAMAGETHRUST
  Species "BabySpiders"
  DamageType "Baby15K"
  States
  {
  Spawn:
	TNT1 A 4
	Stop
  }
}

Actor RailgunImpactSpider : FastProjectile
{
  Radius 1
  Height 1
  Speed 200
  Decal "RedPlasmaScorch"
  Damage (0)
  +RIPPER
  +NOBOSSRIP
  +RANDOMIZE
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHARMSPECIES
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 0 A_SpawnItem("RedParticleSpawner")
	TNT1 A 0 A_SpawnItem("LaserSpidFlare")
	TNT1 A 0 A_SpawnItem("LaserSpidPuff")
	TNT1 A 1
	Stop
  }
}

Actor LaserSpidFlare : CFRedFlare { Scale 0.08 }

Actor LaserSpidPuff
{
  Height 1
  Radius 1
  Scale 0.5
  Renderstyle Add
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTELEPORT
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	XXXX A 4 Bright
	XXXX BBBBCCDDDEEE 1 Bright A_FadeOut(0.05,0)
  Fade:
	XXXX E 1 Bright A_FadeOut(0.1,1)
	Loop
  }
}