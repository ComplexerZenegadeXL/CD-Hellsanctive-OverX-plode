{
  States
  {
  Spawn:
    DMSP F 2 A_FadeOut(0.18)
    Loop
  }
}

Actor BabyDemo10K : 10KProjectile
{
  Species "BabySpiders"
  DamageType "Baby15K"
  -THRUSPECIES
  States
  {
  Death:
  XDeath:  
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("BabyDemo10KEx")
    Stop
  }
}
Actor BabyDemo10KEx : DarkDemo10KEx
{
  Obituary "$CFBabyDemo10KExObit"
  DamageType "Baby15K"
}