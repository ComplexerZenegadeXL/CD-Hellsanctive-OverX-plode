Actor BabyDDemolisher : Dualachnotron 23336
{
  Health 1200
  PainChance 70
  Scale 1.2
  Speed 13
  Radius 52
  SeeSound "minidemo/sight"
  ActiveSound "minidemo/active"
  PainSound "monsters/fusionitepain"
  DeathSound "minidemo/death"
  AttackSound ""
  BloodColor "DarkGreen"
  DropItem "LifeEssence" 140
  DropItem "ArmorBonusMax" 140
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonTechBallistaGiver" 32 1
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  +MISSILEMORE
  +QUICKTORETALIATE
  Obituary "$CFBabyDDemolisherObit"
  Tag "$CFBdDemol"
  var int user_lowlag;
  States
  {
  Spawn:
    DMSP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DMSP A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DMSP A 2 A_BabyMetal
    DMSP ABBCC 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(62,"Rush")
    DMSP A 2 A_BabyMetal
    DMSP ABBCC 2 A_Chase
    DMSP D 2 A_BabyMetal
    DMSP DEEFF 2 A_Chase
   Loop
   Rush:
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	DMSP A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP B 1 A_Chase
	TNT1 A 0 A_Metal		
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP D 1 A_Chase
	TNT1 A 0 A_Metal		
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP E 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP E 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP F 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BabyDDGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DMSP F 1 A_Chase	
	TNT1 A 0 A_Jump(84,"See")		
	Loop	
  Pause:
    DMSP A 10
    Goto See
  Missile:
    TNT1 A 0 A_Jump(70,"BFG10K")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    DMSP A 13 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySoundEx("weapons/minigunfire","Weapon")
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(26,30),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    DMSP Q 3 Bright A_CustomBulletAttack(20.0, 0, 1, frandom(9,15),"BabyPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySoundEx("weapons/minigunfire","Weapon")	
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    DMSP R 2 Bright A_CustomBulletAttack(20.0, 0, 1, frandom(9,15),"BabyPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_Jump(3,"Pause","Missile")
    TNT1 A 0 A_SpidRefire
    Goto Normal+2
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    DMSP G 16 Bright A_FaceTarget
	DMSP G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    DMSP H 4 Bright A_CustomMissile("BabyDemo10K",20,0,frandom(-4,4)) 
    DMSP G 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    DMSP H 4 Bright A_CustomMissile("BabyDemo10K",20,0,frandom(-4,4)) 
    DMSP G 6 Bright A_FaceTarget	
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    DMSP H 4 Bright A_CustomMissile("BabyDemo10K",20,0,frandom(-4,4)) 	
    DMSP G 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
    Goto See
  Pain:
    TNT1 A 0 A_Jump(87,"PainMissile")
    DMSP I 10 A_Pain
    Goto See
  PainMissile:
	DMSP I 10 A_Pain
    Goto Missile
  Death:
    DMSP I 20 A_Scream
	DMSP J 6
	TNT1 AAA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	DMS2 KKKKK 2 Bright A_CustomMissile("Kaboom5", frandom(20,40), frandom(10,-10), frandom(0,360), CBAF_NORANDOM, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CBAF_NORANDOM, frandom(0,360))
    DMSP L 6 A_NoBlocking
    DMSP MN 6
    DMSP O 6
    DMSP P -1 A_KillMaster
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    DMSP PONMLKJ 5
    Goto See+1
  }
}

Actor BabyDDGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  Scale 1.2
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    DMSP A 2 A_FadeOut(0.18)
    Loop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor BabyDDGhostB : BabyDDGhostA
{
  States
  {
  Spawn:
    DMSP B 2 A_FadeOut(0.18)
    Loop
  }
}

