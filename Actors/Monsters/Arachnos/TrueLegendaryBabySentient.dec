	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("TrueLegBabySentientFire",frandom(28,38),frandom(28,38),48,0,0,frandom(-4,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("TrueLegBabySentientFire",frandom(-38,-28),frandom(-38,-28),48,0,0,frandom(-4,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("TrueLegBabySentientFire",frandom(28,38),frandom(-38,-28),48,0,0,frandom(-4,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("TrueLegBabySentientFire",frandom(-38,-28),frandom(28,38),48,0,0,frandom(-4,-6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

