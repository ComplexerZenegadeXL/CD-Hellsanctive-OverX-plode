Actor TrueLegendaryBabySentient 16659  //Don't get any ideas, this is ONLY used as a minion for the TLS.
{
  //$Category Monsters/LCA
  //$Sprite TBBSA1
  //$Title "True Legendary Baby Sentient"
  Monster
  Health 2999
  PainChance 2
  Scale 1.3
  Height 52
  Speed 15
  Radius 52
  Mass 2500
  FloatSpeed 38
  SeeSound "TrueLegBaby/See"
  PainSound "TrueLegBaby/StrongPain"
  DeathSound "TrueLegBaby/Death"
  ActiveSound "TrueLegBaby/StrongAct"
  AttackSound ""
  DropItem "BossLifeEssence" 256
  DropItem "BossArmorBonusMax" 256
  DropItem "LegendaryArmor" 110
  DropItem "LDemonAmmoBoxPickup" 256 
  DropItem "LDemonAmmoPickup" 256 
  //DropItem "LegendaryPlasmaticCannonGiver" 180
  DropItem "LegendaryAmmoSphere" 80
  DropItem "LegendaryBulletBoxPickup" 256
  DropItem "LegendaryLMGBulletMagPickup" 252 20
  //DropItem "LegendaryLightMachineGunGiver" 200
  //DropItem "LegendaryAssaultShotgunGiver" 202
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 130
  DropItem "LegendarySphere" 128
  DropItem "LegendaryUltrasphere" 128
  //DropItem "LegendaryPlasmaticRifleGiver" 128
  DropItem "LegendaryDemonRune" 128
  DropItem "SkullofPowerGiver" 128
  DropItem "LegendaryTimeFreezeSphere" 128
  DropItem "TrueLegendaryBFGUpgrade" 150
  DropItem "LegendaryRandomSphere" 32
  DamageFactor 0.55
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Melee", 3.0
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFGTracer", 0.05
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "BFGSplash", 0.25
  DamageFactor "BFGSpray", 0.25
  DamageFactor "PlayerDevBall", 0.015
  DamageFactor "Railg", 0.5
  DamageFactor "PlayerDevBall2", 0.015
  DamageFactor "PlayerDevTracer", 0.015
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "Term", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Crush", 0.1
  DamageFactor "Player", 0.015
  DamageFactor "PlayerHellfire", 0.3
  DamageFactor "CDTBFG", 0.0
  DamageFactor "DBFG10K", 0.015
  DamageFactor "PlayerDTRG", 0.05
  DamageFactor "NobleComet", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "PlayerBHole", 0.0
  DamageFactor "PlayerDBFG10K", 0.015
  DamageFactor "DBFG", 0.015
  DamageFactor "PlayerBHole", 0.1
  DamageFactor "PlayerDBFG2", 0.015
  DamageFactor "DBFG210K", 0.015
  DamageFactor "PlayerDBFG210K", 0.015
  DamageFactor "PlayerDBFG", 0.015
  DamageFactor "DBFG2Splash", 0.015
  DamageFactor "Baby15K", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "HFCyber", 0.0
  DamageFactor "DementedTerminator", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "BabySpiders", 0.0
  DamageFactor "Commander", 0.0
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  BloodColor "Blue"
  Species "BabySpiders"
  +FLOAT
  +NOGRAVITY
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +MISSILEMORE
  +DONTMORPH
  +FIRERESIST
  +BOSSDEATH
  +NOICEDEATH
  +LOOKALLAROUND
  +DONTGIB
  +NOTELEFRAG
  +DONTRIP
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +CANTSEEK
  +NOFEAR
  +AVOIDMELEE
  +THRUSPECIES
  -FLOORCLIP
  -COUNTKILL
  +NOTELEFRAG
  Obituary "$CFTrueLegendaryBabySentientObit"
  Tag "$CFTLegBS"
  var int user_script;
  var int user_script_type;
  var int user_tlbsdelay;
  var int user_turning;
  var int user_wait;
  var int user_heal;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States
  {
  Spawn:
    TBBS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,5)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",4)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	TBBS AB 8 Bright A_Look
    Loop
  See:
    TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TBBS A 0 A_UnSetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TBBS AB 2 Bright A_Chase
	TBBS A 0 A_JumpIfCloser(300, "LegendaryASGMinigun")
	TBBS A 0 A_JumpIfCloser(200, "GoAway")
	TNT1 A 0 A_Jump(60, "Dodge")
	TNT1 A 0 A_Jump(45, "Teleport")
	TNT1 A 0 A_Jump(15,"Evade")
    Loop
  GoAway:
    TBBS A 0 ThrustThing(Angle*256/360, 1, 0, 0)
    TNT1 A 0 A_Recoil(30)
	TBBS A 0 A_JumpIfCloser(350, "Teleport")
	Goto See
  Dodge:
    TNT1 A 0 A_Jump(256, "DodgeLeft", "DodgeRight")
  DodgeLeft:
    TBBS A 5 Bright ThrustThing(Angle*256/360+64, Random(25, 45), 0, 0)
	Goto See
  DodgeRight:
    TBBS A 5 Bright ThrustThing(Angle*256/360-64, Random(25, 45), 0, 0)
	Goto See
  Rush:
	TNT1 A 0 A_SetUserVar("user_script_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RushLoop:
	TBBS AAAAA 0 A_Chase
	TBBS A 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TBBS AAAAA 0 A_Chase
	TBBS B 2 Bright A_SpawnItemEx("LBSGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TBBS AAAAA 0 A_Chase
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0 A_Jump(45,"Teleport","Evade")
	TNT1 A 0 A_Jump(75,"See")
    Loop	
  Evade:
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	TBBS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	TBBS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Teleport:
	TBBS A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TBBS AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TBBS A 2 
	TBBS AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TBBS A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TBBS AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TBBS A 1 Bright A_SetShootable
	Goto See		
  Pause:
	TBBS ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    TNT1 A 0 A_Jump(128,"TrueLegBFG10K","TrueLegBFG15K","Cannon","LegendaryStar","Railgun","EnergyBolt","TrueProtonCannon","Turning","LegendaryTech")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    TBBS ABAB 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("weapons/LMGFire")
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_SpawnItemEx("LegRifleCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    TBBS K 2 Bright A_CustomBulletAttack(42.5,14,1,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySound("weapons/LMGFire")
	TNT1 A 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
    TNT1 A 0 A_SpawnItemEx("LegRifleCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    TBBS L 2 Bright A_CustomBulletAttack(42.5,14,1,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_Jump(24,"Pause","TrueLegBFG10K","Cannon","LegendaryStar")
    TNT1 A 0 A_SpidRefire
    Goto Normal+9
  LegendaryASGMinigun:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    TBBS ABAB 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun")
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    TBBS K 6 Bright A_CustomBulletAttack(22.5,18.3,4,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun")
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",frandom(28,34),0,frandom(-6,6),0)
    TNT1 A 0 A_SpawnItemEx("BlueShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-80, -90), SXF_CLIENTSIDE)	
    TBBS L 6 Bright A_CustomBulletAttack(22.5,18.3,4,Random(10,15)*4,"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_Jump(24,"Pause","TrueLegBFG10K","Cannon","LegendaryStar")
    TNT1 A 0 A_SpidRefire
    Goto LegendaryASGMinigun+6
  TrueLegBFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TBBS CCCC 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TBBS D 3 Bright A_CustomMissile("TrueLegendaryBabySentient10KProjectile",20,0,frandom(-4,4))
	TBBS C 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG10KLoop2:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TBBS D 2 Bright A_CustomMissile("TrueLegendaryBabySentient10KProjectile",20,0,frandom(-4,4))
	TBBS C 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG10KLoop3:
    TBBS D 2 Bright A_CustomMissile("TrueLegendaryBabySentient10KProjectile",20,0,frandom(-4,4))	
	TBBS C 2 Bright A_FaceTarget	
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 11,1)
	Loop
	TBBS C 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TBBS C 15 Bright 	
	TNT1 A 0 A_Jump(64,"TrueLegBFG15K")
	Goto See
  TrueLegBFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TBBS CCCC 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG15KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TBBS D 4 Bright A_CustomMissile("TrueLegendaryBabySentientBFG15KBall",20,0,frandom(-4,4))		
	TBBS C 4 Bright A_FaceTarget	
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG15KLoop2:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TBBS D 3 Bright A_CustomMissile("TrueLegendaryBabySentientBFG15KBall",20,0,frandom(-4,4))		
	TBBS C 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegBFG15KLoop3:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TBBS D 2 Bright A_CustomMissile("TrueLegendaryBabySentientBFG15KBall",20,0,frandom(-4,4))	
	TBBS C 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 16,1)
	Loop
	TBBS C 4 Bright A_FaceTarget	
	TBBS C 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TBBS CCCCC 3 Bright 	
	TNT1 A 0 A_Jump(192,"Missile")
	Goto See
  Cannon:   
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
	TBBS C 8 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/charge")
    TBBS CCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TBBS C 0 A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CannonLoop:
	TBBS C 4 Bright A_FaceTarget
	TBBS D 0 A_PlayWeaponSound("legendarycannon/fire")
	TBBS D 2 Bright A_CustomMissile("LBSCannonProj",15,0,frandom(-2,2))	   
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 17,1)
	Loop
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto See
  EnergyBolt:
    TBBS CD 2 Bright A_CustomMissile("LBSEnergyBolt",20,0,frandom(-3,3),0)
	TNT1 A 0 A_Jump(12,"Pause","Missile")
    TNT1 A 0 A_SpidRefire
    Goto EnergyBolt
  LegendaryStar:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
    TBBS CCCCCCCC 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlayWeaponSound("star/load1")
    TBBS CCCCCCCC 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlayWeaponSound("star/load2")
    TBBS CCCCCCCCCCCC 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlayWeaponSound("star/load3")
    TBBS CCCCCCCC 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TBBS D 0 A_PlayWeaponSound("star/fire")
	TBBS D 7 Bright A_CustomMissile("LegBabyBlueStar",15,0,frandom(-2,2))
	TBBS C 6 Bright A_FaceTarget
	TBBS D 0 A_PlayWeaponSound("star/fire")
	TBBS D 7 Bright A_CustomMissile("LegBabyBlueStar",15,0,frandom(-2,2))
	TBBS C 6 Bright A_FaceTarget
	TBBS D 0 A_PlayWeaponSound("star/fire")
	TBBS D 7 Bright A_CustomMissile("LegBabyBlueStar",15,0,frandom(-2,2))
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TBBS C 8 Bright A_FaceTarget
	Goto See
  Railgun:
	TBBS G 0 A_PlayWeaponSound("legbabysentient/load")
    TBBS CCCC 8 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunLoop:
    TBBS D 4 Bright A_CustomMissile("LBSRailBall",28,0,frandom(-2,2)) 
	TBBS C 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	TNT1 A 0
    Goto See
  TrueProtonCannon:
    TBBS C 2 Bright A_FaceTarget
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TBBS CCCC 4 Bright A_FaceTarget
  TrueProtonCannonCharging:
    TNT1 A 0 A_JumpIf(user_tlbsdelay >= 32,"TrueProtonCannonGo")	 
    TNT1 A 0 A_SetUserVar("user_tlbsdelay",user_tlbsdelay+1)
	TNT1 A 0 A_FaceTarget
    TBBS C 2 Bright A_GiveInventory("TrueLegSentientStrafe", 1)
    Loop
  TrueProtonCannonGo:
    TBBS A 0 A_SetUserVar("user_tlbsdelay",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIf(user_tlbsdelay >= 3, "TrueProtonCannonFinish")
    TBBS A 0 A_UnSetShootable
	TBBS A 0 ThrustThing(Angle*256/360, 1, 0, 0)
	TBBS CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    TBBS A 0 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TBBS A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    TBBS A 0 A_SetShootable
  Dodge2:
    TNT1 A 0 A_Jump(256, "Dodge2Left", "Dodge2Right")
  Dodge2Left:
    TBBS A 5 Bright ThrustThing(Angle*256/360+64, Random(15, 35), 0, 0)
	Goto ProtonFire
  Dodge2Right:
    TBBS A 5 Bright ThrustThing(Angle*256/360-64, Random(15, 35), 0, 0)
	Goto ProtonFire
  ProtonFire:
	TBBS C 5 Bright A_FaceTarget
	TBBS D 0 A_PlaySound("Petrovec/Fire",1)
    TBBS D 0 A_PlaySound("Petrovec/AddFire",6)
    TBBS D 0 A_PlaySound("Petrovec/Ambient",5)
	TBBS D 6 Bright A_CustomMissile("TrueProtonBall",28,0,frandom(-2,2))
	TNT1 A 0 A_SetUserVar("user_tlbsdelay",user_tlbsdelay+1)
	Goto TrueProtonCannonGo+1
  TrueProtonCannonFinish:
    TBBS A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TBBS CCCCCCCCCC 4 Bright A_FaceTarget
	Goto Teleport
  Turning:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_JumpIf(user_turning >= 108,"SuperTurningCheck")
	TNT1 A 0 A_SetUserVar("user_turning",user_turning+1)
	TBBS C 1 Bright A_SetAngle(angle+10)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 AAA 0 A_SpawnItemEx("BHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TBBS D 1 Bright A_CustomMissile("TrueLegendaryBabySentient10KProjectile",22,0,0,CMF_AIMDIRECTION,random(-5,5))
	Loop
  SuperTurningCheck:
	TNT1 A 0
	TNT1 A 0 A_Jump(48,"EndTurning")
	TNT1 A 0 A_SetUserVar("user_turning",0)
	TBBS C 1 Bright A_PlaySound("baby/sight")
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TBBS C 40 Bright
  SuperTurning:
	TNT1 A 0 A_JumpIf(user_turning >= 108,"EndTurning")
	TNT1 A 0 A_SetUserVar("user_turning",user_turning+1)
	TBBS C 1 Bright A_SetAngle(angle+10)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TBBS D 1 Bright A_CustomMissile("TLegendaryBSBFG15KBall",22,0,0,CMF_AIMDIRECTION,frandom(-5,5))
	Loop
  EndTurning:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  LegendaryTech:
    TBBS KKKKKKKK 4 Bright A_FaceTarget
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",12)
    TBBS K 3 Bright A_PlaySound("TrueLegBaby/Taunt",5)
	TNT1 A 0 A_SetUserVar("user_wait",0)
  LegendaryTechWait:
    TNT1 A 0 A_JumpIf(user_wait >= 31,"LegendaryTechGo")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	TNT1 A 0 A_FaceTarget
    TBBS K 3 Bright
    Loop
  LegendaryTechGo:	
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_wait",0)
  LegendaryTechGoo:
    TNT1 A 0 A_JumpIf(user_wait >= 30,"LegendaryTechEnd")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	TNT1 A 0 A_FaceTarget
    TBBS KL 2 Bright A_CustomMissile("SentientLegendaryProjectile",-1,0,frandom(-8,8),0)
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    Loop	
  LegendaryTechEnd:
    TBBS KKKKKKKKKKKKKKKK 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(192,"Missile")
    Goto See
  Pain:
    TNT1 A 0 A_Jump(94,"Turning")
	TNT1 A 0 A_Jump(54,"Teleport")
	TNT1 A 0 A_Jump(44,"Healing")
    TNT1 A 0 A_Jump(104,"PainMissile")
    TBBS A 3 Bright A_Pain
	TBBS A 3 Bright
    Goto See
  PainMissile:
    TBBS A 3 Bright A_Pain
	TBBS A 3 Bright
    Goto Missile
  Healing:
	TNT1 A 0 A_JumpIf(user_heal >= 3,"See")
	TNT1 A 0 A_PlaySoundEx("monsters/volsee","HEAL")
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",10)
	TBBS A 0 A_SetUserVar("user_heal",user_heal+1)
	TBBS A 2 Bright HealThing(500)
	TBBS A 66 Bright
	TNT1 A 0 A_UnSetInvulnerable
	TBBS A 2 Bright
	Goto See	
  Death:
    TBBS A 20 Bright A_Scream
    TBBS E 6 Bright A_Fall
	TBBS F 6 Bright
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,30)
	TNT1 A 0 A_DropItem("LegendaryDust",random(4,6),256)
	TNT1 AAA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TBBS GGGGG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItem("TrueDeathBall")
    TBBS H 6 Bright
    TBBS I 4
	TBBS J 2
    Stop
  }
}

Actor TrueLegBabySentientFire : TrueLegSentientFire
{
  Scale 0.3
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	YMKE ABCDEFGHIJKL 1 Bright A_FadeOut
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor TrueLegBabySentientFireSpawner : SentientFireSpawner
{
  +NOTIMEFREEZE
  States
  {
