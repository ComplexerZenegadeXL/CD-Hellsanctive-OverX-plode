Actor DTechSpider : Dualachnotron
{
  Obituary "$CFDTechSpiderObit"
  Health 1000
  Radius 64
  Height 64
  Mass 600
  Speed 12
  Scale 1.2
  PainChance 80
  BloodColor "DarkGreen"
  DropItem "DemonTechRifleGiver" 256 1
  DropItem "LifeEssence" 140
  DropItem "ArmorBonusMax" 140
  SeeSound "minidemo/sight"
  ActiveSound "minidemo/active"
  PainSound "monsters/fusionitepain"
  DeathSound "minidemo/death"
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  Tag "$CFDtSpid"
  Monster
  +MISSILEMORE
  +QUICKTORETALIATE
  var int user_lowlag;
  States
  {
  Spawn:
    DTSD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DTSD A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DTSD ABBCC 2 A_Chase
    DTSD D 2 A_BabyMetal
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(62,"Rush")
    DTSD A 2 A_BabyMetal
    DTSD ABBCC 2 A_Chase
    DTSD D 2 A_BabyMetal
    DTSD DEEFF 2 A_Chase
    Loop
  Rush:
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	DTSD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD B 1 A_Chase
	TNT1 A 0 A_Metal		
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD D 1 A_Chase
	TNT1 A 0 A_Metal		
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD E 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD E 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD F 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpidGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DTSD F 1 A_Chase	
	TNT1 A 0 A_Jump(84,"See")		
	Loop	
  Missile:
	DTSD GG 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DTSDemonTechProjectile",28,0,frandom(-1.5,1.5),0)
	DTSD H 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(6,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Missile+1
  Pause:
	DTSD G 15 A_PlaySound("weapons/demontechsteam")
	Goto See	 
  Pain:
    DTSD I 3
    DTSD I 3 A_Pain
    Goto See+1
  Death:
    DTSD J 20 A_Scream
    DTSD K 7 A_NoBlocking
	TNT1 AAA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DTSD LMNO 7 Bright A_CustomMissile("Kaboom5", frandom(20,40), frandom(10,-10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DTSD P -1 A_KillMaster
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    DTSD PONMLKJ 5
    Goto See+1
  }
}

Actor DTSDemonTechProjectile : ZDemonTechProjectile { Species "BabySpiders" DamageType "Baby15k" }

Actor DTSpidGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  Scale 1.2
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    DTSD A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTSpidGhostB : DTSpidGhostA
{
  States
  {
  Spawn:
    DTSD B 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTSpidGhostC : DTSpidGhostA
{
  States
  {
  Spawn:
    DTSD C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTSpidGhostD : DTSpidGhostA
{
  States
  {
  Spawn:
    DTSD D 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTSpidGhostE : DTSpidGhostA
{
  States
  {
  Spawn:
    DTSD E 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTSpidGhostF : DTSpidGhostA
{
  States
  {
  Spawn:
    DTSD F 2 A_FadeOut(0.18)
    Loop
  }
}