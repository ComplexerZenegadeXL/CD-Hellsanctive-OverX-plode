Actor BabyOverseer : BabySentient 17574
{
  //$Category Monsters/CF
  //$Sprite BOVSA1
  //$Title "Baby Overseer"
  Health 1600
  PainChance 20
  Scale 1.4
  SeeSound "BabyOverseer/Sight"
  PainSound "BabyOverseer/pain"
  DeathSound "BabyOverseer/death"
  ActiveSound "BabyOverseer/active"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "NewCellPack" 128
  DropItem "NewCellPack" 64
  DropItem "PlasmaRepeaterGiver" 64
  DamageFactor "Baby15K", 0.0
  BloodColor "Green"
  Obituary "$CFBabyOverseerObit"
  Tag "$CFBOver"
  States
  {
  Spawn:
	BOVS A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,28)
    TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",27)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BOVS AB 4 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BOVS AB 2 Bright A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	BOVS AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(12,"Evade")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	BOVS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	BOVS ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Pause:
	BOVS ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_Jump(84,"BFG10K")
    TNT1 A 0 A_Jump(50,"Railgun")
  Normal:
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS AB 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS AB 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS AB 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS A 2 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BabyOverseerPlasma",7,-12,frandom(-6,6),0)
    BOVS K 3 Bright A_CustomMissile("BabyOverseerPlasma",7,12,frandom(-6,6),0)
    BOVS K 3 Bright
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 Bright A_CustomMissile("BabyOverseerPlasma",7,-12,frandom(-6,6),0)
    BOVS L 3 Bright A_CustomMissile("BabyOverseerPlasma",7,12,frandom(-6,6),0)
	BOVS L 3 Bright
  NormalLoop:
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_Jump(3,"Pause","BFG10K")
    TNT1 A 0 A_SpidRefire
    TNT1 A 0 A_Jump(256,"NormalLoop")
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BOVS D 2 Bright A_CustomMissile("BabyOverseer10K",18,0,frandom(-4,4)) 
	BOVS D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BOVS D 2 Bright A_CustomMissile("BabyOverseer10K",18,0,frandom(-4,4)) 
	BOVS D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS C 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BOVS D 2 Bright A_CustomMissile("BabyOverseer10K",18,0,frandom(-4,4)) 
	BOVS D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS C 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BOVS D 2 Bright A_CustomMissile("BabyOverseer10K",18,0,frandom(-4,4)) 
	BOVS D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS C 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    BOVS D 2 Bright A_CustomMissile("BabyOverseer10K",18,0,frandom(-4,4)) 
	BOVS D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
    BOVS C 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	BOVS C 18 Bright
    Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    BOVS CCCCCCCC 4 Bright A_FaceTarget
    BOVS D 2 Bright A_CustomMissile("BabyOverseerRail",18,0,frandom(-4,4)) 
	BOVS DC 4 Bright A_FaceTarget
	BOVS C 18 Bright
    Goto See
  Pain:
    TNT1 A 0 A_Jump(104,"PainMissile")
    BOVS A 3 Bright A_Pain
	BOVS A 3 Bright
    Goto See
  PainMissile:
    BOVS A 3 Bright A_Pain
	BOVS A 3 Bright
    Goto Missile
  Death:
    BOVS A 20 Bright A_Scream
    BOVS E 6 Bright A_Fall
	BOVS F 6 Bright
	TNT1 AAA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BOVS GGGGG 2 Bright A_CustomMissile("Kaboom5", frandom(20,40), frandom(10,-10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BOVS H 6 Bright
    BOVS I 4
	BOVS J 2
    TNT1 A 1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    BOVS JIHGFE 5
    Goto See
  }
}

Actor BabyOverseerPlasma : OverseerPlasma { Species "BabySpiders" DamageType "Baby15K" }

Actor BabyOverseerLaser : OverseerLaser { Species "BabySpiders" DamageType "Baby15K" }

Actor BabyOverseer10K : 10KProjectile
{
  Species "BabySpiders"
  DamageType "Baby15K"
  -THRUSPECIES
  States
  {
  Death:
  XDeath:  
	TNT1 A 0
	TNT1 A 1 A_SpawnItem("BabyOverseer10KEx")
	Stop
  }
}

Actor BabyOverseer10KEx : DarkDemo10KEx
{
  Obituary "$CFBabyOverseer10KExObit"
  Species "BabySpiders"
  DamageType "Baby15K"
}

Actor BabyOverseerRail : DarkCyberRail
{
  DamageType "Baby15K"
  Species "BabySpiders"
  Damage (Random(40,60))
}

Actor BabyOverseerFire : OverseerFire { Scale 0.4 }

Actor BabyOverseerFireSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(31,43),frandom(31,43),42,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(-43,-31),frandom(-43,-31),42,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(31,43),frandom(-43,-31),42,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(-43,-31),frandom(31,43),42,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor BabyOverseerFireSpawner2 : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(31,43),frandom(31,43),42,0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(-43,-43),frandom(-43,-31),42,0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(31,43),frandom(-43,-31),42,0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BabyOverseerFire",frandom(-43,-31),frandom(31,43),42,0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

