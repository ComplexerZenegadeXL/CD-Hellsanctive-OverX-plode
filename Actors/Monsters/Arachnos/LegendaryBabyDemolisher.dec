Actor LegendaryBabyDemolisher 30336
{
  Monster
  Health 2666
  Height 64
  Radius 52
  Mass 1250
  Speed 12
  Scale 1.15
  BloodColor "Blue"
  PainChance 30
  MeleeRange 188
  +BOSS
  +NOFEAR
  +BOSSDEATH
  +NOICEDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +BRIGHT
  +DONTHARMSPECIES
  +NOTELEFRAG
  Species "BabySpiders"
  DamageType "Baby15K"
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  //DamageFactor "DBFG2", 0.65
  //DamageFactor "DBFG10K2", 0.65
  //DamageFactor "PlayerDBFG2", 0.65
  //DamageFactor "PlayerDBFG10K2", 0.65
  //DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  //No Infighting
  DamageFactor "Baby15K", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "BabySpiders", 0.0
  DropItem "BossLifeEssence", 256
  DropItem "LegendaryBossLifeEssence", 256
  DropItem "LegendaryArmorBonusMax", 256
  DropItem "LegendarySphere", 110
  DropItem "LDemonAmmoPickup", 256
  DropItem "LDemonAmmoBoxPickup", 180
  //DropItem "LegendaryPlasmaticRifleGiver", 127
  DropItem "LegendaryTimeFreezeSphere", 80
  DropItem "LegendaryRandomSphere" 16
  SeeSound "LegBabyDemo/Sight"
  PainSound "monsters/fusionitepain"
  DeathSound "minidemo/death"
  ActiveSound "baby/active"
  Obituary "$CFLegendaryBabyDemolisherObit"
  Tag "$CFLegBD"
  var int user_heal;
  var int user_turning;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LBDS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  SpawnLoop:
	LBDS A 10 Bright A_Look
	TNT1 AAA 0 A_SpawnItemEx("LHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_JumpIfHealthLower(2666,"Idle")
	Loop
  Idle:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_music",0)
	TNT1 A 0 A_SetUserVar("user_turning",0)
	TNT1 A 0 A_Look
	LBDS A 2 Bright A_BabyMetal
	LBDS A 2 Bright A_Wander
	TNT1 A 0 A_Look
	LBDS BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	LBDS CC 2 Bright A_Wander
	TNT1 A 0 A_Look
	LBDS D 2 Bright A_BabyMetal
	LBDS D 2 Bright A_Wander
	TNT1 A 0 A_Look
	LBDS EE 2 Bright A_Wander
	TNT1 A 0 A_Look
	LBDS FF 2 Bright A_Wander
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LBDS A 2 Bright A_BabyMetal
	LBDS AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,809)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_turning",0)
	TNT1 A 0 A_Jump(100,"Rush")
	LBDS A 2 Bright A_BabyMetal
	LBDS ABBCC 2 Bright A_Chase
	LBDS D 2 Bright A_BabyMetal
	LBDS DEEFF 2 Bright A_Chase
	Loop
  Rush:
	TNT1 A 0 A_BabyMetal
	LBDS AAAA 0 A_Chase
	LBDS A 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 AAAAA 0 A_Chase
	LBDS B 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_Chase
	LBDS C 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_BabyMetal
	TNT1 AAAA 0 A_Chase
	LBDS D 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_Chase
	LBDS E 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_Chase
	LBDS F 2 Bright A_SpawnItemEx("LegBabyDemoGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(75,"See")
	Loop	
  Melee:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	LBDS GGGGGG 6 Bright A_FaceTarget
	LBDS G 3 Bright A_CustomMissile("LegArachThunder")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto See
  Missile:
	TNT1 A 0
	TNT1 A 0 A_Jump(96,"Railgun")
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K")
	TNT1 A 0 A_Jump(20,"Spread")
	TNT1 A 0 A_Jump(48,"DTBFG")
  Normal:
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind",CHAN_WEAPON)
	LBDS ABABABA 2 Bright A_FaceTarget(45)
  NormalLoop:
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2",5)
	TNT1 A 0 A_PlaySound("sentient/fire",6)
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing",8,8,18,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
	LBDS Q 2 Bright A_CustomMissile("LegBabySentientExplosiveTracer",20,0,Random(-8,8),0)
	LBDS Q 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire",7)
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing",8,-8,18,frandom(2,6),0,frandom(1,3),frandom(-80,-90),SXF_CLIENTSIDE)
	LBDS R 2 Bright A_CustomMissile("LegBabySentientExplosiveTracer",20,0,frandom(-8,8),0)
	LBDS R 1 Bright A_FaceTarget
	TNT1 A 0 A_Jump(12,"DTBFG")
	TNT1 A 0 A_Jump(8,"Pause","Missile")
	TNT1 A 0 A_JumpIfCloser(188,"Melee")
	TNT1 A 0 A_SpidRefire
	Loop
  Pause:
	LBDS ABAB 2 Bright
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge",CHAN_WEAPON)
	LBDS GGGGG 5 Bright A_FaceTarget(45)
	LBDS G 5 Bright A_FaceTarget
	LBDS H 10 Bright A_CustomMissile("LegArachRail",37,0,frandom(-1,1))
	LBDS GG 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(100,"BFG10K")
	Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON)
	LBDS GGGGGGG 5 Bright A_FaceTarget(45)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	LBDS H 2 Bright A_CustomMissile("LegArach10KProjectile",22,0,frandom(-4,4)) 
	LBDS G 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	LBDS H 2 Bright A_CustomMissile("LegArach10KProjectile",22,0,frandom(-4,4)) 
	LBDS G 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	LBDS H 2 Bright A_CustomMissile("LegArach10KProjectile",22,0,frandom(-4,4)) 
	LBDS G 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	LBDS H 2 Bright A_CustomMissile("LegArach10KProjectile",22,0,frandom(-4,4))
	LBDS G 2 Bright A_FaceTarget
	TNT1 A 0 A_JumpIfCloser(188,"Melee")
	TNT1 A 0 A_MonsterRefire(0,"BFG10KEnd")
	Loop
  BFG10KEnd:
	LBDS G 20 Bright A_PlaySound("weapons/bfg15kcooldown",6)
	TNT1 A 0 A_Jump(48,"DTBFG")
	TNT1 A 0 A_Jump(24,"Pause","Missile")
	Goto See
  BFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LBDS GGGG 5 Bright A_FaceTarget(45)
	LBDS H 10 Bright A_CustomMissile("LegArachBFG9500Ball",22,0,0)
	LBDS G 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LBDS GGGG 5 Bright A_FaceTarget
	LBDS H 10 Bright A_CustomMissile("LegArachBFG9500Ball",22,0,0)
	LBDS G 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(48,"DTBFG")
	Goto See
  DTBFG:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LBDS G 1 Bright A_PlaySound("LegBabyDemo/Sight",CHAN_VOICE)
	LBDS GGGGGGGG 2 Bright A_FaceTarget(45)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LBDS G 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k",CHAN_WEAPON)
	LBDS GGGGGGG 5 Bright A_FaceTarget
	LBDS H 10 Bright A_CustomMissile("LegArachDTBFGBall",18,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k",CHAN_WEAPON)
	LBDS GGGGGGG 5 Bright A_FaceTarget
	LBDS H 10 Bright A_CustomMissile("LegArachDTBFGBall",18,0,0)
	LBDS G 4 Bright A_FaceTarget
	Goto See
  Spread:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	//TNT1 A 0 A_SetInvulnerable
	LBDS GGGGGG 6 Bright A_FaceTarget(45)
  StartTurning:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON)
	LBDS GGG 6 Bright A_FaceTarget(45)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
  Turning:
	TNT1 A 0 A_JumpIf(user_turning >= 108,"SuperTurningCheck")
	TNT1 A 0 A_SetUserVar("user_turning",user_turning+1)
	LBDS G 1 Bright A_SetAngle(angle+10)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LBDS H 1 Bright A_CustomMissile("LegArach10KProjectile",22,0,0,CMF_AIMDIRECTION,random(-5,5))
	Loop
  SuperTurningCheck:
	TNT1 A 0 A_Jump(48,"EndTurning")
	TNT1 A 0 A_SetUserVar("user_turning",0)
	LBDS G 1 Bright A_PlaySound("LegBabyDemo/Sight")
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	LBDS G 40 Bright
  SuperTurning:
	TNT1 A 0 A_JumpIf(user_turning >= 108,"EndTurning")
	TNT1 A 0 A_SetUserVar("user_turning",user_turning+1)
	LBDS G 1 Bright A_SetAngle(angle+10)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LBDS H 1 Bright A_CustomMissile("LegendaryCyberBFG15KBall",22,0,0,CMF_AIMDIRECTION,random(-5,5))
	Loop
  EndTurning:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_Jump(32,"Healing")
	TNT1 A 0 A_Jump(96,"StartTurning")
	TNT1 A 0 A_Jump(156,"Missile")
  Pain2:
	LBDS I 1 Bright
	LBDS I 1 Bright A_Pain
	Goto See	
  Healing:
	TNT1 A 0 A_SetUserVar("user_effect_type",10)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_heal >= 3,"LowHealing")
	TNT1 A 0 A_PlaySound("LegBabyDemo/Sight",CHAN_BODY)
	TNT1 A 0 A_SetInvulnerable
	LBDS I 0 A_SetUserVar("user_heal",user_heal+1)
	LBDS I 2 Bright HealThing(200)
	LBDS IIIIIIIIIIII 4 Bright A_FaceTarget
	TNT1 A 0 A_UnSetInvulnerable
	LBDS I 2 Bright
	Goto See
  LowHealing:
	TNT1 A 0 A_JumpIf(user_heal >= 12,"VeryLowHealing")
	TNT1 A 0 A_PlaySound("LegBabyDemo/Sight",CHAN_BODY)
	TNT1 A 0 A_SetInvulnerable
	LBDS I 0 A_SetUserVar("user_heal",user_heal+1)
	LBDS I 2 Bright HealThing(random(50,125))
	LBDS IIIIIIIIIIII 4 Bright A_FaceTarget
	TNT1 A 0 A_UnSetInvulnerable
	LBDS I 2 Bright
	Goto See
  VeryLowHealing:
	TNT1 A 0 A_JumpIf(user_heal >= 24,"Pain2")
	TNT1 A 0 A_PlaySound("LegBabyDemo/Sight",CHAN_BODY)
	TNT1 A 0 A_SetInvulnerable
	LBDS I 0 A_SetUserVar("user_heal",user_heal+1)
	LBDS I 2 Bright HealThing(random(10,100))
	LBDS IIIIIIIIIIIIIIIIIIIIIII 2 Bright A_FaceTarget
	TNT1 A 0 A_UnSetInvulnerable
	LBDS I 2 Bright
	Goto See
  Death:
	LBDS I 2 A_Scream
	LBDS IIIIIIIII 3 A_CustomMissile("BlueKaboom", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LBDS J 6 A_SetUserVar("user_music",0)
	TNT1 AAA 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LBDS KKKKK 2 Bright A_CustomMissile("BlueKaboom3",frandom(20,40),frandom(-10,10),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",frandom(20,40),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItem("DeathBall2")
	LBDS L 6 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LBDS MN 6
	LBDS O 6 A_KillMaster
	LBDS P -1
	Stop
  }
}

Actor LegArachRail : DarkCyberRail
{
  Height 6
  Radius 6
  Speed 100
  Scale 1.26
  Damage (Random(20,50))
  MissileType "LegendaryCyberRailTrail"
  +RIPPER
  +THRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  +DONTHARMSPECIES
  Species "BabySpiders"
  DamageType "Legendary"
  SeeSound "monsters/darkcyberrail"
  DeathSound "cyberrail/impact"
  States
  {
  Spawn:
	DCRP A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveGold",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("KaboomGold2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 A 1 A_SpawnItem("RailGunImpactEffectGold")
	Stop
  }
}

Actor LegArach10KProjectile : Legendary10KProjectile
{
  DamageType "Legendary"
  States
  {
  Death:
  XDeath:
	TNT1 A 1 A_SpawnItemEx("LegArach10KEx",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	Stop
  }
}

Actor LegArach10KEx : LegCyber10KEx
{
  +DONTHARMSPECIES
  Species "BabySpiders"
  DamageType "Legendary"
}

Actor LegArachBFG9500Ball : BFG9500Ball
{
  Speed 45
  Damage (Random(200,500)) //150
  -THRUSPECIES
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  Species "BabySpiders"
  DamageType "Legendary"
  Obituary "$CFLegArachBFG9500BallObit"
  States
  {
  Spawn:
	LTB1 AAABBB 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),Random(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_Explode(256,186,0,0)
	TNT1 A 0 A_SpawnItemEx("LegArachBFGShockwaveBlue",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAAAA 0 A_CustomMissile("BlueKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LTB1 AB 2 Bright A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_BFGSpray("GoldenSpray",15,20)
	LTB1 CDEF 2 Bright
	Stop
  }
}

Actor LegArachBFGShockwaveBlue : BFGShockwave2 
{
  Scale 1.1
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	SHOB ABCDEFGHIJKLMNOPQR 1 Bright A_FadeOut(0.04,1)
	Stop
  }
}

Actor LegArachDTBFGBall : LegAnniDTBFGBall
{
  Damage (Random(250,650))
  +DONTHARMSPECIES
  Species "BabySpiders"
  DamageType "Legendary"
  Obituary "$CFLegArachDTBFGBallObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	LGS1 ABCD 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LegArachDTBFGTracerAttack",0,0,0,CMF_TRACKOWNER|CMF_AIMDIRECTION)
	Loop
  DTBFGSFX:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGS1 B 1 Bright  A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGS1 C 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGS1 D 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LegArachDTBFGTracerAttack",0,0,0,CMF_TRACKOWNER|CMF_AIMDIRECTION)
	Goto Spawn
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("LegArachDTBFGTracer",0,0,user_loop * 10,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 35,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGoldSpawner",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwaveGold",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,240,0,0)
	TNT1 AAA 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode",6)
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwaveGold1",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 20 A_SpawnItem("LegAnniDTBFGEx",0,-10)
	Stop
  }
}

Actor LegArachDTBFGTracerAttack : LegSentientDTBFGTracerAttack
{
  DamageType "Legendary"
  Obituary "$CFLegArachDTBFGTracerAttackObit"
  States
  {
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(6,12),0,NONE,"Yellow",RGF_SILENT|RGF_FULLBRIGHT,0,2,"LegArachRailgunSlugPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor LegArachRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "Legendary"
}

