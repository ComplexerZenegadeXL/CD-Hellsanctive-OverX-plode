Actor LegArachThunder
{
  Height 1
  Radius 1
  Scale 4.0
  Alpha 0.2
  Renderstyle Add
  Translation "80:111=160:167"
  +NOCLIP
  +NOGRAVITY
  +NOTIMEFREEZE
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_StopSoundEx("Weapon")
	TNT1 A 0 A_PlaySoundEx("thunder/hit","Weapon",0,2)
	TNT1 A 0 A_Explode(322,256,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("LegArachThunderSpark",0,0,0,frandom(1,10),0,frandom(1,10),frandom(0,360),SXF_CLIENTSIDE)
	THND AAAA 2 Bright A_FadeIn(0.2)
	THND AAAA 8 Bright A_FadeOut(0.2,1)
	Stop
  }
}

Actor LegArachThunderSpark
{
  Height 2
  Radius 2
  Speed 3
  Mass 0
  Gravity 0.125
  Scale 0.15
  RenderStyle Add
  +MISSILE
  +RANDOMIZE
  +NOINTERACTION
  +NOBLOCKMAP
  +THRUACTORS
  +NOTELEPORT
  +DONTSPLASH
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 4
	SPKO A 1 A_Jump(80,4)
	SPKO AAAA 32 Bright
	SPKR ABCDEFGHHH 1 Bright A_FadeOut(0.1,1)
	Stop
  Death:
	SPKO A 4 Bright A_FadeOut(0.1,1)
	SPKO BCDEFGHHH 1 Bright A_FadeOut(0.1,1)
	Stop		
  }
}

