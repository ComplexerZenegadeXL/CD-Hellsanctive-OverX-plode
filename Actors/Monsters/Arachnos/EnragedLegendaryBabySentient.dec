Actor EnragedLegendaryBabySentient : LegendaryBabySentient
{
  Monster
  Health 2700
  PainChance 40
  Scale 1.3
  Speed 15
  Height 52
  Radius 52
  FloatSpeed 10
  SeeSound "EnragedBabySentient/Sight"
  PainSound "EnragedBabySentient/Pain"
  DeathSound "EnragedBabySentient/Death"
  ActiveSound "EnragedBabySentient/Active"
  DamageType "Legendary"
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.3
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.3
  DamageFactor "PlayerBHole", 0.5
  DamageFactor "PlayerPyro", 0.4
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.55
  BloodColor "Red"
  Species "BabySpiders"
  +MISSILEMORE
  +NOTARGET
  DropItem "EnragedLegendaryArmor" 80
  DropItem "ILDemonAmmoBoxPickup" 250
  DropItem "ILDemonAmmoPickup" 250 
  DropItem "ELegendaryBulletBoxPickup" 220 
  DropItem "ELegendaryLMGBulletMagPickup" 256 20
  DropItem "LegendaryBossLifeEssence" 256 
  DropItem "LegendaryBossArmorBonusMax" 256 
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "LegendaryBossLifeEssence" 32
  DropItem "LegendaryBossArmorBonusMax" 32
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 170
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 144
  //DropItem "EnragedLegendaryLightMachineGunGiver" 112
  DropItem "LegendaryAmmoSphere" 70
  DropItem "BulletBoxPickup" 256
  DropItem "ExplosiveMinigunGiver" 256
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFEnragedLegendaryBabySentientObit"
  Tag "$CFEnrBS"
  var int user_delay;
  var int user_DTWarp;
  var int user_nuke;
  States
  {
  Spawn:
    EBBS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,7)
    TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",6)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
  Idle:
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS A 8 A_Look
	TNT1 AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS B 8 A_Look	
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EBBS AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,414)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_Jump(100,"Rush")
	TNT1 A 0 A_Jump(1,"ThermoNuke","Drone")
	EBBS A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	EBBS AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS AB 2 A_Chase
    Loop
  Rush:
    TNT1 A 0 A_JumpIf(user_delay >= 14,"See")
	EBBS AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS AAAAA 0 A_Chase
	EBBS A 2 A_SpawnItemEx("ELBSGhost")
	EBBS AAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS AAAAA 0 A_Chase
	EBBS B 2 A_SpawnItemEx("ELBSGhost")
	TNT1 A 0 A_Jump(30,"Teleport","Evade")
	TNT1 A 0 A_Jump(75,"See")
	TNT1 A 0 A_Jump(2,"Trap")
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop	
  Evade:
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(frandom(-90,90),20,0,0)
	EBBS ABABABAB 2 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(frandom(-90,90),20,0,0)
	EBBS ABABABAB 2 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Teleport:
	EBBS A 1 A_UnSetShootable
	EBBS AAAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS AAAAA 1 A_FadeOut(0.2,0)
	EBBS A 2 
	EBBS AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	EBBS A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	EBBS AAAA 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE)
	EBBS AAAAA 1 A_FadeIn(0.2)
	EBBS A 1 A_SetShootable
	TNT1 A 0 A_JumpIf(user_DTWarp >= 1,"DTBFG2")
	Goto See		
  Missile:
    TNT1 A 0 A_JumpIf(user_drone >= 1,2)
    TNT1 A 0 A_JumpIfHealthLower(1400,"Drone")
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SetUserVar(user_nuke,0)
	TNT1 A 0 A_Jump(136,"Railgun","BFG9K","BFG10K","BFG15K","LMG","Cannon","EnergyBolt","ThermoNuke","DTBFG","DTRailgun","Drone")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    EBBS ABAB 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    EBBS KK 0 A_CustomMissile("ELBSExplosiveTracer",4,0,frandom(-8,8),0)
    EBBS K 3
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)	
    EBBS LL 0 A_CustomMissile("ELBSExplosiveTracer",4,0,frandom(-8,8),0)
	EBBS L 3
	TNT1 A 0 A_Jump(16,"Missile")
    TNT1 A 0 A_SpidRefire
    Goto Normal+15
  EnergyBolt:
    EBBS CD 2 A_CustomMissile("ELBSEnergyBolt",20,0,frandom(-3,3),0)
	TNT1 A 0 A_Jump(24,"Missile")
    TNT1 A 0 A_SpidRefire
    Goto EnergyBolt
  Railgun:
	EBBS G 0 A_PlayWeaponSound("legbabysentient/load")
    EBBS CCCC 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,0)
  RailgunLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 6,"DTRailgun")
    EBBS D 4 A_CustomMissile("ELBSRailBall",28,0,frandom(-2,2)) 
	EBBS C 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  DTRailgun:
    EBBS G 0 A_PlayWeaponSound("legbabysentient/load")
    EBBS CCCC 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/dtrailf")
	EBBS D 9 A_CustomMissile("EnragedDTRailSpider",11)
	EBBS C 12
	Goto See
  BFG9K:
  	TNT1 A 0 A_PlaySound("weapons/bfgf")
	EBBS CCCCCC 4 A_FaceTarget
    EBBS D 8 A_CustomMissile("ELBSBFG9500",20) 
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	EBBS CCCCCC 4 A_FaceTarget
    EBBS D 8 A_CustomMissile("ELBSBFG9500",20)
	TNT1 A 0 A_Jump(144,"BFG10K")
    Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    EBBS CCCCCC 4 A_FaceTarget
  BFG10KLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 7,"BFG10KEnd")
    TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TNT1 A 0 A_CustomMissile("LegendaryBabySentient10KProjectile",15,0,frandom(-6,6)) 
	EBBS DDCC 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  BFG10KEnd:
    EBBS C 2 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_SetUserVar(user_delay,0)
	EBBS C 18
	TNT1 A 0 A_Jump(144,"BFG15K")
    Goto See  
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    EBBS CCCCCC 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,0)
  BFG15KLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 12,"BFG15KEnd")
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    EBBS D 2 A_CustomMissile("EBS15KBall",10,0,frandom(-2,2)) 
	EBBS DCCC 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  BFG15KEnd:
    EBBS C 2 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	EBBS C 18
    Goto See
  DTBFG:
    TNT1 A 0 A_PlaySound("Cardinal/9k")
	EBBS CCCCCC 4 A_FaceTarget
    EBBS D 8 A_CustomMissile("EnragedBabySentientDTBFG10KBall",20)
	TNT1 A 0 A_SetUserVar(user_DTWarp,1)
	Goto Teleport
  DTBFG2:
	TNT1 A 0 A_SetUserVar(user_DTWarp,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	EBBS CCCCC 4 A_FaceTarget
    EBBS D 8 A_CustomMissile("EnragedBabySentientDTBFG10KBall",20,0,0)
	TNT1 A 0 A_Jump(144,"BFG10K")
    Goto See
  ThermoNuke:
    TNT1 A 0 A_JumpIf(user_nuke >= 3,"Missile")
	TNT1 A 0 A_Stop
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("legbabysentient/see")
    EBBS CCCCC 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,0)
  ThermoNukeLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 15,"ThermoNukeFire")
    TNT1 A 0 A_SpawnItemEx("EnragedSphereLightningSpawner")
	TNT1 A 0 A_SpawnItemEx("ThermoNukeEnergy",frandom(65,135),frandom(-4,4),frandom(12,76))
	EBBS CC 4 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  ThermoNukeFire:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SpawnItemEx("EnragedTPFog",75)
    EBBS D 2 A_SpawnItemEx("EnragedThermoNuke",75) 
	TNT1 A 0 A_SetUserVar(user_nuke,user_nuke+1)
	EBBS DDCCCCCCC 2 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(84,"Cannon")
    Goto See	
  Cannon:   
	EBBS C 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EBBS C 1 A_FaceTarget
	EBBS CCC 2 A_SpawnItemEx("ELBabySentBlueFlameSpawner",frandom(-24,24),frandom(-24,24),-30)
	EBBS C 1 A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legendarycannon/charge")
    EBBS CCCCCCCCCCCC 2 A_SpawnItemEx("ELBabySentBlueFlameSpawner",frandom(-24,24),frandom(-24,24),-30,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	EBBS C 1 A_FaceTarget
	EBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar(user_delay,0)
  CannonLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 6,"CannonEnd")
	EBBS C 2 A_FaceTarget
	EBBS D 0 A_PlayWeaponSound("legendarycannon/fire")
	EBBS D 4 A_CustomMissile("ELBSCannonProj",15,0,frandom(-2,2))
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  CannonEnd:	
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto See
  LMG:
	EBBS KKKKK 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,0)
  LMGLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 11,"LMGEnd")
	TNT1 AA 0 A_CustomMissile("LegendaryRedTracer",9,frandom(-8,8),frandom(-2,2),0)
    TNT1 A 0 A_PlaySoundEx("weapons/LMGFire","Weapon")
	TNT1 A 0 A_SpawnItemEx("ELegRifleCasing", 12, -6, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	EBBS LK 2 A_CustomBulletAttack(6,10,1,Random(40,50),"EnragedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  LMGEnd:
	TNT1 A 0 A_RemoveChildren(1)
	Goto See
  Trap:
    TNT1 A 0 A_JumpIf(user_traps >= 3,"Missile")
  	EBBS C 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EBBS C 0 A_PlaySound("EnragedBabySentient/See")
    EBBS CCCCCCCCCCCCCCC 2 A_SpawnItemEx("ELBSFlameSpawner",frandom(-24,24),frandom(-24,24),-30,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_traps",user_traps+1)
	EBBS CCCCCCCCCCC 8 A_SpawnItemEx("ELBSTrapMine",0,frandom(26,32),frandom(6,9),0,0,0,frandom(0,359),SXF_NOCHECKPOSITION)
	EBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See	
  Drone:
    TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_JumpIf(user_drone >= 1,"Trap")
  	EBBS C 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EBBS C 0 A_PlaySound("EnragedBabySentient/see")
    EBBS CCCCCCCCCCCCCCC 2 A_SpawnItemEx("ELBSFlameSpawner",frandom(-24,24),frandom(-24,24),-30,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_drone",user_drone+1)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",-30)
	EBBS C 0 A_SpawnItemEx("ELBSHealEffectsSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	EBBS C 0 A_SpawnItemEx("ELBSSurveyor",-30,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	EBBS CCCCCCCCCCCC 2 A_SpawnItemEx("ELBSFlameSpawner",frandom(-24,24),frandom(-24,24),-30,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	EBBS C 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See	
  Pain:	
    TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_Jump(45,"Teleport")
	TNT1 A 0 A_Jump(40,"Trap")
    EBBS A 3 A_Pain
	EBBS A 3
	TNT1 A 0 A_Jump(185,"Missile")
    Goto See	
  Death:
    EBBS F 20 A_Scream
    EBBS F 6 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
	EBBS F 6
	TNT1 AAA 0 A_SpawnItemEx("EnragedGibbedGenerator")
	EBBS GGGGG 2 A_CustomMissile("EKaboomLN", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    EBBS H 6
    EBBS I 4
	EBBS J 2
	TNT1 A 0 A_KillMaster
    TNT1 A -1 A_KillChildren
    Stop
  }
}

Actor ELBSExplosiveTracer : LegSentientExplosiveTracer
{
  DamageType "Baby15K"
  States
  {
  Spawn:
    TRA3 A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItem("EKaboomLN2")
    EROC C 4 Bright A_Explode(Random(8,12)*5,72)
    EROC DE 3 Bright 
    Stop
  }
}

Actor EBS15KBall : ELegSoul15K { DamageType "Baby15K" }

Actor ELBSRailBall : DarkCyberRail
{
  Speed 100
  Damage (Random(75,85))
  SeeSound "monsters/darkcyberrail"
  MissileType "EnragedRailTrail"
  RenderStyle Add
  +THRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  +NOTIMEFREEZE
  +SEEKERMISSILE
  Species "BabySpiders"
  DamageType "Baby15K"
  Decal "MummyScorch"
  States
  {
  Spawn:
    CCRP AB 3 Bright
	TNT1 A 0 A_Jump(64,"Pause")
  Fly:
    CCRP AB 1 Bright
    Loop
  Pause:
	TNT1 A 0 A_SeekerMissile(25,35)
	Goto Fly
  Death:
	TNT1 A 0
	TNT1 A 0 A_PlayWeaponSound("cyberrail/impact")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))   
	TNT1 A 0 A_Explode(128,128,0)
	Stop
	}
}

Actor ELBSRailBall2 : ELBSRailBall
{
  States
  {
  Spawn:
    CCRP AB 1 Bright
    Loop
  Death:
	TNT1 A 0 A_PlayWeaponSound("cyberrail/impact")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))   
	TNT1 A 0 A_Explode(128,128,0)
	Stop
  }
}

Actor EnragedRailTrail : CardinalRailTrail { +NOTIMEFREEZE +NOINTERACTION +NOBLOCKMAP }

Actor ELBSCannonProj : ELegBehCannonProj { DamageType "Baby15K" }

Actor EnragedThermoNuke
{
  Radius 20
  Height 56
  Health 2000
  Mass 8000
  Species "BabySpiders"
  +SHOOTABLE
  +THRUSPECIES
  +NORADIUSDMG
  +LOOKALLAROUND
  +AMBUSH
  +NOBLOOD
  +NOTIMEFREEZE
  Scale 1.8
  DamageType "Baby15K"
  DamageFactor "Baby15K", 0.0
  Obituary "$CFEnragedThermoNukeObit"
  var int user_timer;
  States
  {
  Spawn:
    TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    EBSB AAAAA 4 Bright A_Look
    Loop
  See:
	EBSB AABBCC 3 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
  CountDown:
    TNT1 A 0 A_JumpIf(user_timer >= 4,"Explode")
	TNT1 A 0 A_PlaySound("EnragedBabySentient/NukeSiren",0,1,0,ATTN_NONE)
	EBSB CCCC 8 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar(user_timer,user_timer+3)
	Loop
  Explode:
    EBSB CCBBAAAAA 3 A_SpawnItemEx("EnragedHellionSmokeSpawner",frandom(-24,24),frandom(-24,24),0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySoundEx("legendary/strike","Voice",0,2)
    TNT1 A 0 A_Explode(Random(3000,6000),1024,0)
    TNT1 A 0 A_SpawnItemEx("ELegendaryStrikeN")
  Death:
	TNT1 A 0
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("EnragedLightningSpark",0,0,0,random(1,10),0,random(1,10),random(0,360),SXF_CLIENTSIDE)
	TNT1 AAAAAAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0
    Stop
  }
}


