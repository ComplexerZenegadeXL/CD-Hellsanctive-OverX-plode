Actor ELBSHealEffectsSpawner : ILegImpLineSpawner
{
  Monster
  +NOINTERACTION
  +NOBLOCKMAP
  -COUNTKILL
  var int user_rotate;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 AAA 0 A_SpawnItemEx("LegendaryRedPowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),user_rotate,SXF_CLIENTSIDE,0) 
	TNT1 A 0 A_CustomMissile("EnragedSparkleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1 A_Warp(AAPTR_MASTER,0,0,0,0,WARPF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+12)
	TNT1 A 0 A_JumpIf(user_rotate >= 360,1)
	Loop
	TNT1 A 0 A_SetUserVar(user_rotate,0)
    Loop
  Death:
    TNT1 A 1
	Stop
  }
}