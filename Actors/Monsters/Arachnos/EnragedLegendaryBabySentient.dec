Actor ELBSTrapMine
{
  Projectile
  Height 8
  Radius 4
  Mass 100
  Gravity 0.7
  ReactionTime 525
  Damage (Random(120,150)) //30
  -NOGRAVITY
  +CANBOUNCEWATER
  -MOVEWITHSECTOR
  +NOEXPLODEFLOOR
  +THRUGHOST
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +NOCLIP
  +NOTIMEFREEZE
  -COUNTKILL
  DamageType "Legendary"
  Species "Legendary"
  Obituary "$CFELBSTrapMineObit"
  States
  {
  Spawn:
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
  Fall:
	EBSG A 1 A_CheckFloor("Death")
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("EnragedBabySentient/TrapImpact")
    TNT1 A 0 A_SpawnItemEX("ELBSTrap")
	TNT1 A 0 A_SpawnItemEx("ELBSDirtFountain")
	Stop
  Crash:
  XDeath:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("Weapons/RockLX")
	TNT1 A 0 A_NoGravity
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_Explode(168,200)
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 1 
	Stop
  }
}

Actor ELBSTrap
{
  Mass 60000000
  Gravity 0.8
  Speed 0
  Species "Legendary"
  DamageType "Legendary"
  Monster
  +DOOMBOUNCE
  +THRUSPECIES
  +FORCERADIUSDMG
  +NOBLOOD
  +NOTIMEFREEZE
  +NOCLIP
  +NODAMAGE
  +NORADIUSDMG
  -COUNTKILL
  var int user_explodedelay;
  States
  {
  Spawn:
    TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 A 100 A_ChangeFlag(NOBLOCKMAP,0)
  SpawnLoop:
	TNT1 A 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,100,0,360,"Explode")
    TNT1 A 0 A_JumpIf(user_explodedelay >= 1500,"Explode")	 
    TNT1 A 0 A_SetUserVar("user_explodedelay",user_explodedelay+1)
	Loop
  Explode:
    TNT1 A 0 A_SpawnItemEx("ELBSDirtFountain")
	TNT1 A 0 ThrustThingZ(0,45,0,0)
	EBSG B 25 Bright A_PlaySound("EnragedBabySentient/TrapBeep")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_Explode(168,200)
	TNT1 A 0 A_PlaySound("weapons/mineexplode")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
    TNT1 AAAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(20,160))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 1 
    Stop
  }
}

