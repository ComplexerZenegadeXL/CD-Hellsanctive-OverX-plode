Actor ELBSSurveyor
{
  Health 1500
  Speed 28
  Radius 20
  Height 58
  Monster
  +NOBLOOD
  +NOPAIN
  +DONTFALL
  +NOGRAVITY
  +FLOAT
  +FLOATBOB
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOTIMEFREEZE
  -COUNTKILL
  Species "BabySpiders"
  SeeSound "drone/sight"
  ActiveSound "drone/active"
  DeathSound "drone/death"
  DamageFactor "Baby15K", 0.0
  Tag "\c[m6]Enraged\c- \c[z3]Legendary Surveyor\c-"
  Obituary "$CFELBSSurveyorObit"
  States
  {
  Idle:
	EBSD A 4 Bright A_Look
	Loop
  Spawn:
  See:
    EBSD AAAAAAAAAA 2 Bright A_Chase   
	TNT1 A 0 A_DamageMaster(-5)
    Loop
  Missile:
    EBSD AA 3 Bright A_FaceTarget
    EBSD A 0 A_CustomMissile("ELBSEnergyBolt",5,10,0)	
    EBSD A 5 Bright A_CustomMissile("ELBSEnergyBolt",5,-10,0)
	EBSD A 4 Bright A_FaceTarget
    Goto See
  Death:
	EBSD A 5 A_ScreamAndUnblock
	TNT1 A 0 A_KillSiblings
	EBSD A 5 A_PlayWeaponSound("weapons/rocklx")
	EBSD A 5 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	EBSD A 5
    Stop
  }
}

