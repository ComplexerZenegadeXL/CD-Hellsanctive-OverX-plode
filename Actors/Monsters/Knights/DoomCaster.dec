Actor DCPSTrail
{
  Gravity 0.0
  Scale 0.6
  Renderstyle Add
  Alpha 1.0
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	XXYZ AAAAAAAAAA 1 Bright A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

