Actor DoomCaster //Not in spawners
{
  Monster
  Health 2500
  Height 64
  Radius 24
  Speed 6
  Mass 1000
  PainChance 128
  PainChance "SatanGuard", 0
  MeleeDamage 25
  MeleeRange 48
  MeleeThreshold 72
  +NOFEAR
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +FASTMELEE
  +QUICKTORETALIATE
  +NOTARGET
  +DONTBLAST
  +DONTHARMSPECIES
  -BOSSDEATH
  +NOICEDEATH
  Species "Nobles"
  DamageType "NobleComet" 
  DamageFactor "Acid", 0.1
  DamageFactor "Fire", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerIce", 0.25
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.01
  DamageFactor "BFGSplash", 0.25
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.25
  DamageFactor "PlayerDevBall2", 0.25
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "AfritComet", 0.1
  DamageFactor "Legendary", 0.1
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor 0.6
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "NobleComet", 0.0
  DropItem "NemesisHealthBonusMax", 200, 16
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "DemonAmmoBoxPickup", 180, 200
  DropItem "CFDroppedSoulSphere", 140
  DropItem "ArmorSphere", 48, 1
  SeeSound "monster/ar2sit" 
  ActiveSound "superbaron/act"
  PainSound "superbaron/pain"
  DeathSound "monster/ar2dth"
  MeleeSound "imp/melee"
  Obituary "$CFDoomCasterObit"
  HitObituary "$CFDoomCasterHitObit"
  Tag "$CFDoomCast"
  var int user_currenthp;
  var int user_lcounter;
  var int user_loopc;
  var int user_loop;
  States
  {
  Spawn:
	DCST A 0
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  /*Idle:
	DCST A 10 Bright A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	Loop*/
  Idle:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
  IdleLoop:
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST AAAA 2 Bright A_Wander
	DCST A 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST BBBB 2 Bright A_Wander
	DCST B 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST CCCC 2 Bright A_Wander
	DCST C 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST DDDD 2 Bright A_Wander
	DCST D 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SetAngle(angle+22.5)
	TNT1 A 0 A_JumpIf(user_lcounter > 8,"Idle2")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	Loop
  Idle2:
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
  IdleLoop2:
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST AAAA 2 Bright A_Wander
	DCST A 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST BBBB 2 Bright A_Wander
	DCST B 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST CCCC 2 Bright A_Wander
	DCST C 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST DDDD 2 Bright A_Wander
	DCST D 1 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SetAngle(angle-22.5)
	TNT1 A 0 A_JumpIf(user_lcounter > 8,"Idle")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	Loop
  See:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
  SeeLoop:
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST AAAA 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST BBBB 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCST CCCC 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST DDDD 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  Melee:
	DCST EF 4 Bright A_FaceTarget
	DCST G 4 Bright A_CustomComboAttack("DCstBall",32,15,"Imp/Melee","SatanGuard")
	DCST FE 4 Bright A_FaceTarget
	Goto See
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
	TNT1 A 0 A_JumpIfCloser(300,"Normal")
	TNT1 A 0 A_JumpIfCloser(600,"PowerShot")
	TNT1 A 0 A_JumpIfCloser(1200,"PowerSpread")
	Goto Normal
  Normal:
	DCST EFG 4 Bright A_FaceTarget
	DCST G 1 Bright A_CustomMissile("DCstHomer",34,0,0,CMF_TRACKOWNER)
	DCST GFE 4 Bright
	TNT1 AAAA 0 A_CustomMissile("DCstBall",34,0,frandom(-15,15),CMF_TRACKOWNER)
	DCST IJK 4 Bright A_FaceTarget
	DCST K 1 Bright A_CustomMissile("DCstHomer",34,0,0,CMF_TRACKOWNER)
	TNT1 AAAA 0 A_CustomMissile("DCstBall",34,0,frandom(-15,15),CMF_TRACKOWNER)
	DCST KJI 4 Bright
	Goto See
  PowerShot:
	DCST M 6 Bright A_FaceTarget
	DCST N 4 Bright A_FaceTarget
	DCST O 2 Bright A_FaceTarget
	DCST O 1 Bright A_CustomMissile("DCstPowerShot",35,0,0,CMF_TRACKOWNER)
	DCST OONMM 3 Bright
	Goto See
  PowerSpread:
	DCST M 6 Bright A_FaceTarget
	DCST N 4 Bright A_FaceTarget
	DCST O 2 Bright A_FaceTarget
	DCST OO 1 Bright A_CustomMissile("DCstHomer",35,0,0,CMF_TRACKOWNER)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("DCstBall",34,0,frandom(-35,35),CMF_TRACKOWNER)
	DCST ONM 6 Bright
	Goto See
  ShieldsPain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DCST Q 8 Bright A_Pain
  Shields:
	DCS2 M 25 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShieldsLoop:
	TNT1 A 0 A_CustomMissile("DCstShieldSpawner",10,0,user_loop *25,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("DCstShieldSpawner2",10,0,user_loop *25,CMF_AIMDIRECTION|CMF_TRACKOWNER,25)
	TNT1 A 0 A_CustomMissile("DCstShieldSpawner3",10,0,user_loop *25,CMF_AIMDIRECTION|CMF_TRACKOWNER,35)
	TNT1 A 0 A_CustomMissile("DCstShieldSpawner4",10,0,user_loop *25,CMF_AIMDIRECTION|CMF_TRACKOWNER,45)
	TNT1 A 0 A_CustomMissile("DCstShieldSpawner5",10,0,user_loop *25,CMF_AIMDIRECTION|CMF_TRACKOWNER,55)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,2)
	TNT1 A 0 A_Jump(256,"ShieldsLoop")
	DCS2 M 33 Bright A_FaceTarget
	DCS2 M 1 Bright A_JumpIf((user_currenthp - Health) <= 0,2)
	DCS2 M 1 Bright HealThing(((user_currenthp - Health)*0.5)+1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	DCS2 M 29 Bright A_FaceTarget
	DCS2 M 1 Bright
	DCS2 N 4 Bright A_FaceTarget
	DSC2 O 1 Bright A_FaceTarget
	TNT1 A 0 A_Blast(BF_DONTWARN|BF_NOIMPACTDAMAGE,225,250,30)
	TNT1 A 0 A_Explode(220,250,XF_NOTMISSILE,0)
	DCS2 O 1 Bright A_CustomMissile("DCstPurpleComet",35,0)
	TNT1 A 0 A_CustomMissile("DCstPurpleComet",35,0,-25)
	TNT1 A 0 A_CustomMissile("DCstPurpleComet",35,0,25)
	DCS2 ONMM 3 Bright A_FaceTarget
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See
  Rush:
	DCST A 15 Bright
	TNT1 A 0 A_SetUserVar("user_loopc", 0)
  RLoop:
	TNT1 A 0 A_SetUserVar("user_loopC", user_loopc + 1)
	DCST A 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",60,0,frandom(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,frandom(-70,70))
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST A 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST A 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST B 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",60,0,frandom(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,frandom(-70,70))
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST B 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST B 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST C 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",60,0,frandom(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,frandom(-70,70))
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST C 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST C 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST D 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_CustomMissile("NightmareSummoner",60,0,frandom(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,frandom(-70,70))
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST D 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("PaladinWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCST D 1 Bright A_Chase("","")
	TNT1 A 0 A_Chase("","")
	TNT1 A 0 A_JumpIfCloser(48,"Melee")
	TNT1 A 0 A_JumpIf(user_loopc > 5, 1)
	Loop
	TNT1 A 0 //A_Jump(200,"See")
	//DCST AAA 0 A_CustomMissile("NightmareSummoner",60,0,frandom(0,360),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,frandom(-70,70))
	Goto See
  Pain:
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 1000,"ShieldsPain")
	TNT1 A 0 A_Jump(20,"ShieldsPain")
  Pain.Crush:
	TNT1 A 0 A_Jump(64,"Rush")
	DCST Q 8 Bright A_Pain
	Goto See
  XDeath:
  Death: 
	DCST R 8 Bright
	DCST S 7 Bright A_Scream 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("RedParticleSpawner",0,0,40,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,40,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,40,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCST U 5 Bright A_Fall 
	DCST VW 5 Bright
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DCST X 4 Bright A_CustomMissile("DCstSoul",86,0,0,CMF_AIMDIRECTION,90)
  Fade:
	DCST Z 1 Bright A_Fadeout(0.1,1)
	Loop
  XRaise:
  Raise:
	Stop
  }
}

Actor DCstSoul : FamineSoul
{   
  Scale 1
  States
  {
  Spawn:
	TNT1 A 0
	DCSZ ABCD 4 Bright
	TNT1 A 1
	Stop
  }
}

Actor DCstBall : BaronBall
{
  Scale 1
  Speed 35
  FastSpeed 40
  Damage (Random(45,55))
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Nobles"
  DamageType "NobleComet" 
  States
  {
  Spawn:
	DCSY ABC 1 Bright A_SpawnItemEx("DCstBallTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  Death:
	DCSY D 3 Bright
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom10",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	DCSY EFGH 3 Bright
	Stop
  }
}

Actor DCstBallTrail : MissileTrail
{
  Scale 0.78
  RenderStyle Add
  Damage(0)
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	DCSY ABCD 2 Bright A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
     }
}

Actor DCstPurpleComet : ASComet
{
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Nobles"
  DamageType "NobleComet" 
}

Actor DCstHomer : HadesTracer
{
  Speed 25
  FastSpeed 30
  Damage (Random(35,45))
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  -STRIFEDAMAGE
  Species "Nobles"
  DamageType "NobleComet" 
}

Actor DCstShieldSpawner
{
  Projectile
  Height 1
  Radius 1
  Speed 75
  +NOCLIP
  States
  {
  Spawn:
	TNT1 AAAAAAAAAA 0
	Goto Death
  Death:
	TNT1 A 1 A_SpawnItemEx("DCstShield",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	Stop
  }
}

Actor DCstShieldSpawner2 : DCstShieldSpawner
{
  States
  {
  Spawn:
	TNT1 AAAAAA 0
	Goto Death
  }
}

Actor DCstShieldSpawner3 : DCstShieldSpawner
{
  States
  {
  Spawn:
	TNT1 AAAA 0
	Goto Death
  }
}

Actor DCstShieldSpawner4 : DCstShieldSpawner
{
  States
  {
  Spawn:
	TNT1 AA 0
	Goto Death
  }
}

Actor DCstShieldSpawner5 : DCstShieldSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	Goto Death
  }
}

Actor DCstShield
{
  Height 55
  Radius 55
  Mass 0x7FFFFFFF
  Scale 3.5
  Renderstyle Add
  Alpha 1.0
  Reactiontime 16
  -COUNTKILL
  +NOGRAVITY
  +SOLID
  +SHOOTABLE
  +NOTARGET
  +NODAMAGE
  +NOBLOOD
  +REFLECTIVE
  +FORCEXYBILLBOARD
  //+RELATIVETOFLOOR
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  Species "Nobles"
  DamageType "NobleComet" 
  DeathSound "Monster/hadsit"
  Tag "DoomCaster Shield"
  States
  {
  Spawn:
	ENRS A 2 Bright
	//TNT1 AA 0 A_CustomMissile("Kaboom8",17,0,random(0,360),CMF_AIMDIRECTION,random(0,360))
	ENRS B 2 Bright
	//TNT1 AA 0 Bright A_CustomMissile("Kaboom8",17,0,random(0,360),CMF_AIMDIRECTION,random(0,360))
	TNT1 A 0 A_CountDown
	Loop
  Death:
	ENRS A 2 Bright
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("Kaboom25",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 A 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,17,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ASCometDeath",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 //A_SpawnItemEx("DCstShieldAttack",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	Stop
  }
}

Actor DCstShieldAttack
{
  Health 1000
  Height 20
  Radius 10
  Mass 2500
  Speed 33
  FastSpeed 33
  FloatSpeed 33
  Scale 3.5
  Renderstyle Add
  Alpha 1.0
  MeleeRange 20
  MeleeThreshold 1280
  +ISMONSTER
  -COUNTKILL
  +FLOAT
  +NOGRAVITY
  +DONTFALL
  +DROPOFF
  -FLOORCLIP
  +SHOOTABLE
  +NOTELEPORT
  +NOTARGET
  +NOINFIGHTING
  +NOICEDEATH
  +NOBLOOD
  +NOPAIN
  +LOOKALLAROUND
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +FORCEXYBILLBOARD
  Species "Nobles"
  DamageType "NobleComet"
  DamageFactor "NobleComet", 0.0
  DamageFactor "SatanGuard", 0.0
  ActiveSound "dcspark0"
  DeathSound ""
  Obituary "$CFDCstShieldAttackHitObit"
  HitObituary "$CFDCstShieldAttackHitObit"
  Tag "$CFDCstShieldAttack"
  var int user_lcounter;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("Tic",50+random(-10,10))
	TNT1 A 0 A_Jump(256,1,2,3,4,5,"SpawnLoop")
	ENRS AAAAA 1 Bright
  SpawnLoop:
	ENRS A 1 Bright A_Look
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS A 1 Bright A_Look
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS B 1 Bright A_Look
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS B 1 Bright A_Look
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_TakeInventory("Tic",1)
	TNT1 A 0 A_JumpIfInventory("Tic",1,2)
	TNT1 A 0 A_Jump(256,"Kill")
	TNT1 A 0
	Loop
  See:
	ENRS A 1 Bright A_Chase("Melee","")
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS A 1 Bright A_Chase("Melee","")
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS B 1 Bright A_Chase("Melee","")
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	ENRS B 1 Bright A_Chase("Melee","Missile")
	TNT1 A 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_TakeInventory("Tic",1)
	TNT1 A 0 A_JumpIfInventory("Tic",1,2)
	TNT1 A 0 A_Jump(256,"Kill")
	TNT1 A 0
	Loop
  Missile:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SkullAttack(33)
	ENRS AABBAABBAABBAABB 1 Bright A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_TakeInventory("Tic",1)
	TNT1 A 0 A_JumpIfInventory("Tic",1,2)
	TNT1 A 0 A_Jump(256,"Kill")
	Goto See
  Melee:
	TNT1 A 0 A_FaceTarget
	ENRS A 2 Bright A_CustomMeleeAttack(Random(0,2),"Monster/hadsit","","SatanGuard")
	Goto Kill
  Kill:
	TNT1 A 0 A_Die
	Goto Death
  Death:
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 AAAAAAAA 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom25",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,17,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ENRS ABABABABABABABABABAB 2 A_FadeOut(0.1,1)
	Stop
  XDeath:
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_ChangeFlag(DONTFALL,0)
	TNT1 AAAAAAAA 0 A_CustomMissile("Kaboom8",17,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom25",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,17,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ENRS ABABABABABABABABABAB 2 A_FadeOut(0.2,1)
	Stop
  }
}

Actor DCstPowerShot : FastProjectile
{
  Projectile
  Height 27
  Radius 27
  Scale 0.6
  Speed 30
  Renderstyle Translucent
  Alpha 0.85
  Damage (Random(60,80))
  +SEEKERMISSILE
  +SCREENSEEKER
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  Species "Nobles"
  DamageType "NobleComet"
  DeathSound "DCPSXpl"
  SeeSound "DCPSSht"
  States
  {
  Spawn:
	MCRG EE 1 Bright A_SpawnItemEx("DCPSTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DCPSTrail2A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("DCPSWizz",0,1.0,0)
	TNT1 A 0 A_SeekerMissile(5,11)
	MCRG FF 1 Bright A_SpawnItemEx("DCPSTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DCPSTrail2B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(5,11)
	Loop
  Death:
	MCRG F 1 Bright
	TNT1 A 0 A_SpawnItemEx("DCPSDeath",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAAA 0 A_CustomMissile("Kaboom10",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1
	Stop
  }
}

