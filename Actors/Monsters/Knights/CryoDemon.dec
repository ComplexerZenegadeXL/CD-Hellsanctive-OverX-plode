Actor CryoDemon : CFHellKnight 31155
{ 
  Health 750
  PainChance 80
  Scale 1.05
  MeleeDamage 8
  DamageFactor "PlayerFireSword", 3.0
  DropItem "LifeEssence" 120
  DropItem "ArmorBonusMax" 120
  DamageFactor "NobleComet", 0.0
  DropItem "FreezerRifleGiver" 100 1
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  +MISSILEMORE
  +FASTMELEE
  +NOBLOOD
  +QUICKTORETALIATE
  +NOICEDEATH
  Obituary "$CFCryoDemonObit"
  HitObituary "$CFCryoDemonHitObit"
  SeeSound "monster/ar2sit" 
  ActiveSound "pyro/active"
  PainSound "superbaron/pain"
  DeathSound "superbaron/pain"
  MeleeSound "baron/melee"
  Tag "$CFCryoDemon"
  States 
  { 
  Spawn: 
    CRYO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CRYO AA 7 Bright A_Look
    Loop 
  See: 
    CRYO AABB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    CRYO CCDD 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    Loop
  Missile:  
    TNT1 A 0 A_Jump(128,"Comet","FloorHugger")
  Normal:
    CRYO EF 7 Bright A_FaceTarget 
	CRYO G 1 Bright A_CustomMissile("CBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("CBall", 32, 0, -5)
	CRYO G 5 Bright A_CustomMissile("CBall", 32, 0, 5)
    CRYO IJ 7 Bright A_FaceTarget 
	CRYO K 1 Bright A_CustomMissile("CBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("CBall", 32, 0, -5)
	CRYO K 5 Bright A_CustomMissile("CBall", 32, 0, 5)
	TNT1 A 0 A_Jump(87,"Comet","FloorHugger")
    Goto See		
  Comet:
    CRYO MN 8 Bright A_FaceTarget
    CRYO O 7 Bright A_CustomMissile("CryoComet",32,0,0,0)
	TNT1 A 0 A_Jump(87,"FloorHugger")
    Goto See
  FloorHugger:
    CRYO MN 8 Bright A_FaceTarget
    CRYO O 8 Bright A_CustomMissile("CIceSpikeSpawner",16,0,0,0)
	Goto See
  Melee:
    CRYO EF 8 Bright A_FaceTarget
    CRYO G 7 Bright A_MeleeAttack
    Goto See
  Pain:
	TNT1 A 0 A_Jump(61,"PainMissile")
    CRYO Q 4 Bright A_Pain
    Goto See
  PainMissile:
	CRYO Q 4 Bright A_Pain
    Goto Missile
  Death.PlayerIce:
  XDeath:
  Death:
	CRYO Q 6 //6
	CRYO Q 1 Bright A_ScreamAndUnblock
	TNT1 AAA 0 A_SpawnItemEx("BlueParticleSpawner",frandom(-10,10),frandom(-10,10),frandom(30,60),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	CRYO Q 5 A_IceGuyDie
	Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    CRYO ZYXWVUTSR 5 Bright
    Goto See
  } 
}

Actor CryoSoul : FamineSoul
{   
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    CRSP ABCD 4 Bright
    Stop 
  }
}

Actor CBall : BaronBall
{
  Speed 15
  FastSpeed 20
  Species "Nobles"
  DamageType "Ice"
  States
  {
  Spawn:
    CRYB AB 1 Bright A_SpawnItemEx("CBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
    TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CRYB CDE 3 Bright
    Stop
  }
}

Actor CBallTrail : BFG9500Trail
{
  Scale 0.2
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	//TNT1 A 1
    FTRI ABC 1 A_FadeOut(0.17)
    Goto Spawn+2
  }
}

Actor CryoComet : Comet
{
  Species "Nobles"
  DamageType "Ice"
  Scale 0.85
  States
  {
  Spawn:
    CRTT AAAABBBBCCCC 1 Bright A_SpawnItemEx("CryoCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_SetDamageType("NobleComet")
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_Explode(64,102,0)
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    CRTT DE 3 Bright
    TNT1 A 0 A_SpawnItemEx("CryoCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Stop
  }
}

Actor CryoCometTail : CometTail
{
  Scale 0.9
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 2
    CRTT DEFGHI 2 Bright
    Stop
  }
}

Actor CryoCometDeath : CometDeath
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_CustomMissile("BlueKaboom", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CRTT JKLMN 3 Bright A_FadeOut(0.1)
    Stop
  }
}

Actor CIceSpikeSpawner
{
  Radius 5
  Height 5
  Speed 20
  FastSpeed 25
  Damage 0
  +FLOORHUGGER
  +BLOODLESSIMPACT
  +THRUSPECIES
  Species "Nobles"
  DamageType "Ice"
  Projectile
  Obituary "$CFCIceSpikeSpawnerObit"
  States
  {
  Spawn: 
    TNT1 AAAA 1 A_Weave(3,0,1.0,0.0)
	TNT1 A 1 A_CustomMissile("MiniIceSpike",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Loop
  Death:  
    TNT1 A 1
    Stop
  }
}
Actor MiniIceSpike
{
  Radius 1
  Height 1
  Speed 0
  Damage (Random(4,8))
  Scale 0.5
  Projectile
  RenderStyle Add
  Alpha 0.9
  +NOCLIP
  +FLOORHUGGER
  +DONTHARMSPECIES
  +THRUSPECIES
  +RIPPER
  Species "Nobles"
  DamageType "Ice"
  SeeSound "Icespike" 
  States
  {
  Spawn:
    ICPL I 2 Bright A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
    ICPL H 2 Bright A_Explode(36,106,0)
    ICPL GFEDCBA 2 Bright
    Stop       
  }
}