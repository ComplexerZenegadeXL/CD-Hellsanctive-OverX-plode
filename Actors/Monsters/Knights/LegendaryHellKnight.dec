Actor LegendaryHellKnight 16510
{
  //$Category Monsters/LCA
  //$Sprite LNBLA1
  //$Title "Legendary HellKnight"
  Health 1700
  Radius 24
  Height 64
  Mass 1000
  Speed 8
  PainChance 45 
  Monster
  +NORADIUSDMG
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +QUICKTORETALIATE
  +MISSILEMORE
  +MISSILEEVENMORE  
  +NOICEDEATH
  +DONTGIB
  +FASTMELEE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NOFEAR
  +NOTELEFRAG
  Scale 1.2
  SeeSound "lnoble/see"
  PainSound "lnoble/pain"
  DeathSound "lnoble/death"
  ActiveSound "lnoble/active"
  MeleeSound "baron/melee"
  MeleeDamage 16
  BloodColor "Blue"
  DamageFactor 0.65
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "NobleComet", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  Species "Nobles"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendarySphere" 192
  DropItem "LDemonAmmoBoxPickup" 256 
  DropItem "LDemonAmmoPickup" 256 
  DropItem "BossLifeEssence" 256 
  DropItem "BossArmorBonusMax" 256 
  //DropItem "LegendaryPlasmaticRifleGiver" 105
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFLegendaryHellKnightObit"
  HitObituary "$CFLegendaryHellKnightHitObit"
  Tag "$CFLegHK"
  var int user_missile;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LNBL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    LNBL AZ 14 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LNBL AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,4)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	LNBL AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL BB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL DD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("GoldWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(32,"Teleport")
	Loop
  Rush:
	LNBL A 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL A 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL B 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL B 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL C 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL C 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL D 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LNBL D 2 Bright A_SpawnItemEx("LNGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LNBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Teleport:
    LNBL P 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LNBL PPPPPPPPPP 1  A_FadeOut(0.1,0)
	LNBL P 2 
	LNBL PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 0 A_Wander
    LNBL P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LNBL PPPPPPPPPP 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LNBL P 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(16,"MinionSummoner")
	TNT1 A 0 A_Jump(128,"Spread","Hugger","Rage","BestAttack","Rain")
	TNT1 A 0 A_Jump(100,"4Comets","BlueComet")
  Normal:
    LNBL EF 5 Bright A_FaceTarget
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,-8)
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,-4)
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,4)
	LNBL G 5 Bright A_CustomMissile("LegNobleBall",32,0,0)
    LNBL ST 5 Bright A_FaceTarget
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,8)
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,4)
	LNBL G 0 A_CustomMissile("LegNobleBall",32,0,-4)
	LNBL U 5 Bright A_CustomMissile("LegNobleBall",32,0,0)	
	TNT1 A 0 A_Jump(127,"Spread")
	Goto See
  Spread:
    LNBL PQ 9 Bright A_FaceTarget
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,18)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-18)
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,15)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-15)
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,12)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-12)
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,9)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-9)
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,6)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-6)	
    LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,3)	
	LNBL R 0 A_CustomMissile("LegNobleBall2",32,0,-3)
    LNBL R 8 Bright A_CustomMissile("LegNobleBall2",32,0,0)
	TNT1 A 0 A_Jump(127,"Hugger")
    Goto See
  Hugger:
    LNBL RQ 9 Bright A_FaceTarget
	LNBL P 8 Bright
	LNBL P 0 A_CustomMissile("LegNobleBall3",32,20,0)
    LNBL P 0 A_CustomMissile("LegNobleBall3",32,-20,0)
	LNBL P 8 Bright
	TNT1 A 0 A_Jump(80,"BlueComet")
    Goto See	
  BlueComet:
    LNBL EF 7 Bright A_FaceTarget
	LNBL G 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LNBL G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LNBL G 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
    LNBL ST 7 Bright A_FaceTarget
	LNBL U 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LNBL G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LNBL U 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
	TNT1 A 0 A_Jump(80,"4Comets")
    Goto See
  4Comets:
    LNBL PQ 8 Bright A_FaceTarget
	LNBL R 0 A_CustomMissile("BigBlueComet", 32, 0, 0)
	LNBL R 0 A_CustomMissile("BigBlueComet", 32, 0, -5)
	LNBL R 0 A_CustomMissile("BigBlueComet", 32, 0, 5)
	LNBL R 7 Bright A_CustomMissile("BigBlueComet", 32, 0, 10)
	TNT1 A 0 A_Jump(127,"Rage")
	Goto See
  Rage:	
    LNBL Q 1 Bright A_PlaySound("lnoble/see")
	LNBL Q 1 Bright A_FaceTarget
	LNBL Q 1 Bright A_SetUserVar("user_missile",0)
    LNBL RR 4 Bright A_FaceTarget
	LNBL Q 8 Bright
  Raging:
    LNBL Q 0 A_JumpIf(user_missile >= 28,"See")	 
    LNBL Q 0 A_SetUserVar("user_missile",user_missile+1)
    LNBL QQ 0 A_CustomMissile("LegNobleBall3Small",0,0,frandom(0,360))	
    LNBL Q 4 Bright
    Loop
  BestAttack:
    LNBL Q 1 Bright A_PlaySound("lnoble/see")
    LNBL P 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LNBL PPPPPPPPPQQQQQQQQQR 4 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    LNBL R 8 Bright A_CustomMissile("LegNobleBall4",32,0,0)
    Goto See
  Rain:
    LNBL PPPPQQQQQ 4 Bright A_FaceTarget
    LNBL Q 0 A_CustomMissile("BlueRainCometNull",32,0,200)
    LNBL Q 0 A_CustomMissile("BlueRainCometNull",32,0,90)
    LNBL Q 0 A_CustomMissile("BlueRainCometNull",32,0,-90)	
    LNBL Q 8 Bright A_CustomMissile("BlueRainCometNull",32,0,0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    LNBL QQQQQQQQQQQQQQQQ 8 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
 MinionSummoner:
    LNBL P 1 Bright A_SetReflectiveInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",11)
	TNT1 A 0 A_PlaySound("knight/sight")
	LNBL PPPPPPPPP 4 Bright A_SpawnItemEx("GHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound ("hk/summon")
	TNT1 A 0 A_CustomMissile("HellKnightSummoner",20,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("HellKnightSummoner",20,0,180,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("HellKnightSummoner",20,0,225,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("HellKnightSummoner",20,0,305,CMF_AIMDIRECTION)
	LNBL P 25 Bright
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_UnSetReflectiveInvulnerable
	Goto See	
 Melee:
    LNBL EF 6 Bright A_FaceTarget 
    LNBL G 6 Bright A_MeleeAttack	
	LNBL ST 6 Bright A_FaceTarget 
    LNBL U 6 Bright A_MeleeAttack	
    Goto See 	
  Pain:
    TNT1 A 0 A_Jump(8,"Rage")	
  	TNT1 A 0 A_Jump(42,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile")
    LNBL H 2
    LNBL H 2 A_Pain
    Goto See
  PainMissile: 
    LNBL H 3 Bright	
    LNBL H 3 Bright A_Pain
    Goto Missile
  Death:
	LNBL I 8 A_StopSound(6)
    LNBL J 8 A_Scream
    LNBL K 8
    LNBL L 8 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
    LNBL MN 8
    LNBL O -1 A_BossDeath
    Stop
  XDeath:
	LNBX AB 5 A_StopSound(6)
	LNBX C 4 A_XScream
	LNBX D 4 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LNBX E 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LNBX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LNBX GH 3
	LNBX I -1
	Stop 	
  }
}

Actor LegNobleBall : GuardianTracer
{
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  RenderStyle Add
  Alpha 0.8
  Decal "BaronScorch"
  Speed 34
  FastSpeed 42
  Damage (Random(30,50)) //11
  DamageType "NobleComet"
  BounceCount 3
  Species "Nobles"
  -SEEKERMISSILE
  +DOOMBOUNCE
  +DONTHURTSPECIES
  +NOTIMEFREEZE
  States
  {
  Spawn:
    LBA1 ABC 1 Bright A_CustomMissile("LegNobleBallTrail",frandom(-1,1),frandom(-1,1))
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    LBA1 DEFG 3 Bright
    Stop
  }
}

Actor LegNobleBallTrail : MissileTrail
{
  Scale 1
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    LBA1 ABCD 2 Bright A_FadeOut
    Stop
  }
}

Actor LegNobleBall2 : BaronBall
{
  Damage (Random(60,90)) //18
  DamageType "NobleComet"
  Speed 28
  FastSpeed 36
  Species "Nobles"
  +DONTHURTSPECIES
  +NOTIMEFREEZE
  States
  {
  Spawn:
    LBAQ AB 1 Bright A_SpawnItemEx("LegNobleBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    LBAQ CDE 3 Bright
    Stop
  }
}

Actor LegNobleBall2Trail : BFG9500Trail
{
  Scale 0.85
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LBAQ AB 1 A_FadeOut(0.25)
    Goto Spawn+4
  }
}

Actor LegNobleBall3
{
  Height 10
  Radius 10
  Projectile
  +DROPOFF
  -NOGRAVITY
  +FLOORHUGGER
  +SEEKERMISSILE
  +EXTREMEDEATH
  +DONTHURTSPECIES
  +DONTSPLASH
  +NOTIMEFREEZE
  Speed 20
  RenderStyle Add
  Alpha 0.75
  Damage (Random(30,60))
  DamageType "NobleComet"
  ActiveSound "legfire/active"
  DeathSound "cyberrail/impact"
  Species "Nobles"
  ReactionTime 100
  States
  {
  Spawn:
	LBA3 A 0 
	LBA3 A 0 A_LoopActiveSound
  SpawnLoop:
	LBA3 A 0 A_CountDown
	LBA3 ABC 1 Bright A_SpawnItemEx("LegNobleBall3Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LBA3 A 0 A_SeekerMissile(14,0)
	Loop
  Death:
	LBA3 A 0 A_Explode(32,64,0)
	LBA3 A 0 A_SpawnItemEx("LegNobleBall3Explode")
	LBA3 ABC 4
	Stop
  }
}

Actor LegNobleBall3Trail : BFG9500Trail
{
  Scale 0.85
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LBA3 ABC 1 A_FadeOut(0.09)
    Goto Spawn+4
  }
}

Actor LegNobleBall3Explode
{
  +DONTHURTSPECIES
  +NOGRAVITY
  +FLOORHUGGER
  +NOTIMEFREEZE
  Species "Nobles"
  DamageType "NobleComet"
