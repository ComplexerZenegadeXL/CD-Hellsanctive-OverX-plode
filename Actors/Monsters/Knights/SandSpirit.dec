Actor SandStormWind
{
  Radius 8
  Height 8
  Speed 20
  Damage (Random(15,25)) //4
  Projectile
  +DOOMBOUNCE
  +SEEKERMISSILE
  +BOUNCEONACTORS
  BounceCount 4
  RenderStyle Translucent
  Species "Nobles"
  DamageType "NobleComet"
  Alpha 0.4 
  States
  {
  Spawn:
	SFX7 A 0
	SFX7 A 0 A_PlaySoundEx("sandstorm/loop","SoundSlot7",1)
	SFX7 ABC 3 A_SeekerMissile(3,3,SMF_LOOK)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("SandClouds",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("SandClouds",0,0,-20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	Loop
  Death:
	SFX7 G 0 A_StopSoundEx("SoundSlot7")
	SFX7 GFED 4
	Stop
  }
}

