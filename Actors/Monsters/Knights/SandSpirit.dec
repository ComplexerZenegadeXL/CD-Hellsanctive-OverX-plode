Actor SandSpirit : CFHellKnight 16559
{ 
  //$Category Monsters/LCA
  //$Sprite SOHIA1C1
  //$Title "Sand Spirit"
  Health 1500
  PainChance 50
  PainChance "SoulToxic", 20
  PainChance "FatFlamer", 20
  PainChance "FiendFire", 20
  MeleeDamage 15
  DropItem "BossLifeEssence" 250
  DropItem "BossArmorBonusMax" 250
  DropItem "ModdedMegaSphere" 10 1
  DropItem "ExtraArmor" 50 
  DamageFactor "NobleComet", 0.0
  Scale 1.1
  Species "Nobles"
  BloodColor "Burlywood"
  +MISSILEMORE
  +FASTMELEE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOTARGET
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  -BOSSDEATH
  Obituary "$CFSandSpiritObit"
  HitObituary "$CFSandSpiritHitObit"
  SeeSound "monster/ar2sit" 
  ActiveSound "superbaron/act"
  PainSound "superbaron/pain"
  DeathSound "monster/ar2dth"
  MeleeSound "baron/melee"
  Tag "$CFSandHK"
  var int user_lowlag;
  States 
  { 
  Spawn: 
    SOHS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	SOHS AA 7 Bright A_Look
	SOHI AA 7 Bright A_Look
    Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	SOHS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    SOHS AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("SandWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SOHS BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("SandWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SOHS CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("SandWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	SOHS DD 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("SandWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Missile:  
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(128,"SandComet","TrippleSandComet","SandStorm","BigSandStorm")
	//TNT1 A 0 Bright A_Jump(256,"SandSummoning")
  Normal:
    SOHS EF 6 Bright A_FaceTarget 
	SOHS G 1 Bright A_CustomMissile("SandSpiritBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("SandSpiritBall", 32, 0, -5)
	SOHS G 4 Bright A_CustomMissile("SandSpiritBall", 32, 0, 5)
    SOHS IJ 6 Bright A_FaceTarget 
	SOHS K 1 Bright A_CustomMissile("SandSpiritBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("SandSpiritBall", 32, 0, -5)
	SOHS K 4 Bright A_CustomMissile("SandSpiritBall", 32, 0, 5)		
	TNT1 A 0 A_Jump(147,"TrippleSandComet")
    Goto See
  TrippleSandComet:
    SOHS MN 7 Bright A_FaceTarget 
    SOHS O 1 Bright A_Custommissile("SSComet", 32, 0, 0)
	TNT1 A 0 A_Custommissile("SSComet", 32, 0, 6)
	SOHS O 6 Bright A_Custommissile("SSComet", 32, 0, -6)
	TNT1 A 0 A_Jump(87,"SandComet")
    Goto See
  SandComet:
    SOHS MN 8 Bright A_FaceTarget 	
	SOHS O 0 A_CustomMissile("SandComet", 32, 0, frandom(-8, 8))
	SOHS O 0 A_CustomMissile("SandComet", 32, 0, frandom(-7, 7))
	SOHS O 0 A_CustomMissile("SandComet", 32, 0, frandom(-6, 6))
	SOHS O 0 A_CustomMissile("SandComet", 32, 0, frandom(-8, -5))
	SOHS O 6 Bright A_CustomMissile("SandComet", 32, 0, frandom(-7, -4))
	TNT1 A 0 A_Jump(88,"SandStorm")
	Goto See
  SandStorm:
    SOHS O 0 A_PlaySound("sandstorm/start")
    SOHS OM 8 Bright A_FaceTarget 	
	SOHS N 0 A_CustomMissile("SandStormWind",10,15,0)
	SOHS N 6 Bright A_CustomMissile("SandStormWind",10,-15,0)
	TNT1 A 0 A_Jump(88,"BigSandStorm")
	Goto See
  BigSandStorm:
    SOHS MN 8 Bright A_FaceTarget 	
	SOHS O 6 Bright A_CustomMissile("BigSandStorm",32,0,0)
	Goto See		
  Melee:
    SOHS EF 8 Bright A_FaceTarget 
    SOHS G 8 Bright A_MeleeAttack	
    Goto See
  Pain: 
    SOHS Q 10 Bright A_Pain 
    Goto See 
  XDeath:
  Death: 
    SOHS R 8 Bright
    SOHS S 7 Bright A_Scream 
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
    SOHS U 5 Bright A_Fall 
    SOHS VW 5 Bright
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("SandClouds",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
    SOHS X 4 Bright A_CustomMissile("SandSoul",86,0,0,2,90)
    SOHS Z 4 Bright
	Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    SOHS ZYXWVUTSR 5 Bright
    Goto See 
  } 
}

Actor SummonedSandSpirit : SandSpirit { -COUNTKILL }

Actor SandSoul : FamineSoul
{   
  Scale 1
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    SASP ABCD 4 Bright
    Stop 
  }
}

Actor SBall : BaronBall
{
  Species "Nobles"
  DamageType "NobleComet"
  Speed 16
  FastSpeed 20
  States
  {
  Spawn:
