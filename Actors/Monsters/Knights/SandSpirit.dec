    TNT1 A 0 A_SpawnItemEx("SSSG1",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("SSSG2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("SSSG3",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("SSSG4",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("SSSG5",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("SSSG6",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
  }
}

