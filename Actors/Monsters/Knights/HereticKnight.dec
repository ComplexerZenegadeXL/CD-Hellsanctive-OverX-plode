  }
}

Actor WarpedFXGen : WarpPortalFXGen
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("CFRedFlare",0,0,0)
	TNT1 AAAA 0 A_SpawnItemEx("Kaboom12",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("HadesElectroSmoke",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("SHadesTrail1",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("SHadesTrail2",0,0,0,frandom(-20,20),frandom(-20,20),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
