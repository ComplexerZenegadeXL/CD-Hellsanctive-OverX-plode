Actor HereticKnight : CFHellKnight
{
  Monster
  Health 1750
  Height 64
  Radius 24
  Speed 5
  Mass 1000
  PainChance "SatanGuard", 0
  PainChance 120
  MeleeDamage 15
  +NOFEAR
  -BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +FASTMELEE
  +QUICKTORETALIATE
  +NOTARGET
  +DONTHARMSPECIES
  DamageFactor "Acid", 0.6
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Cacolich", 0.0
  DropItem "NemesisHealthBonusMax", 200, 20
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFDroppedSoulSphere", 40
  SeeSound "satyr/sight"
  PainSound "baron/pain"
  DeathSound "satyr/death"
  ActiveSound "baron/active"
  MeleeSound "imp/melee"
  Obituary "$CFHereticKnightObit"
  HitObituary "$CFHereticKnightHitObit"
  Tag "$CFHerHK"
  States
  {
  Spawn:
	HWAR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HWAR A 10 A_Look
	Loop
  See:
	//TNT1 A 0 A_TakeInventory("Blocking",1)
	TNT1 A 0 A_ChangeFlag(SHIELDREFLECT,0)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
  SeeLoop:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	HWAR A 1 A_Chase
	HWAR AAAA 1 A_Chase("","")
	HWAR B 1 A_Chase
	HWAR BBBB 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	HWAR C 1 A_Chase
	HWAR CCCC 1 A_Chase("","")
	HWAR D 1 A_Chase
	HWAR DDDD 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  Melee:
	TNT1 A 0 A_Jump(60,"Block")
  Missile:
	TNT1 A 0 A_Jump(60,"Block")
	TNT1 A 0 A_Jump(8,"HellWarp")
	HWAR EF 4 A_FaceTarget
	HWAR G 4 A_CustomComboAttack("PurpleFireShot",32,15,"Imp/Melee","SatanGuard")
	HWAR FE 4 A_FaceTarget
	Goto SeeLoop
  Pain:
	TNT1 A 0 A_Jump(140,"Block")
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOBLOOD,0)
	//TNT1 A 0 A_TakeInventory("Blocking",1)
	TNT1 A 0 A_TakeInventory("Tic",9999)
	HWAR J 5 A_Pain
	Goto See
  Block:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,1)
	TNT1 A 0 A_ChangeFlag(SHIELDREFLECT,1)
	//TNT1 A 0 A_GiveInventory("Blocking",1)
	TNT1 AA 0 A_Jump(256,"BouncePlasma","BounceAR","BounceMG","BounceCSG","BounceSSG","BounceQSG","BounceDTR","BounceRocket","BounceGrenade")
	Goto Blocking
  HellWarp:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,1)
	TNT1 A 0 A_ChangeFlag(SHIELDREFLECT,1)
	HWAR HHHH 6 A_FaceTarget(45)
	HWAR I 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Warp/Spawn2",0,1.0,0)
	TNT1 A 0 A_CustomMissile("WarpPortal",40,0,0,CMF_TRACKOWNER)
	HWAR I 1 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SHIELDREFLECT,0)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
	TNT1 A 0 A_ChangeFlag(NOBLOOD,0)
	TNT1 A 0 A_Recoil(random(-20.0,20.0))
	HWAR I 3 Bright
	HWAR H 4
	Goto See
  BouncePlasma:
	TNT1 A 0 HealThing(18)
	HWAR H 5 A_FaceTarget
	HWAR I 4 A_CustomMissile("RedBallPlasma",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 4 A_CustomMissile("RedBallPlasma",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 4 A_CustomMissile("RedBallPlasma",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 4 A_CustomMissile("RedBallPlasma",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	Goto Blocking
  /*BounceBFG:
	TNT1 A 0
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallBFG",32,0,0,0)
	Goto Blocking*/
  BounceAR:
	TNT1 A 0 HealThing(6)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallAR",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallAR",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallAR",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	Goto Blocking
  BounceMG:
	TNT1 A 0 HealThing(7)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	HWAR I 1 A_CustomMissile("RedBallMG",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_FaceTarget
	Goto Blocking
  BounceCSG:
	TNT1 A 0 HealThing(12)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallCSG",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  BounceSSG:
	TNT1 A 0 HealThing(24)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallSSG",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  BounceQSG:
	TNT1 A 0 HealThing(48)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallQSG",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  BounceRocket:
	TNT1 A 0 HealThing(35)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallRocket",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  BounceGrenade:
	TNT1 A 0 HealThing(35)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallGrenade",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  BounceDTR:
	TNT1 A 0 HealThing(12)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallDTR",32,0,0,CMF_TRACKOWNER)
	Goto Blocking
  /*BounceBFGSuper:
	TNT1 A 0
	TNT1 A 0 HealThing(12)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallBFGSuper",32,0,0,0)
	Goto Death*/
  /*BounceCSaw:
	TNT1 A 0 HealThing(12)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HWAR H 5 A_FaceTarget
	HWAR I 2 A_CustomMissile("RedBallCSaw",32,0,0,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto Blocking*/
  Blocking:
	TNT1 A 0 A_ChangeFlag(NOBLOOD,1)
	TNT1 A 0 A_JumpIfInventory("Tic",280,"BlockEnd")
	TNT1 A 0 A_Jump(5,"BlockEnd")
	TNT1 A 0 A_GiveInventory("Tic",1)
	HWAR H 1 A_FaceTarget
	Loop
  BlockEnd:
	TNT1 A 0 A_ChangeFlag(SHIELDREFLECT,0)
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
	TNT1 A 0 A_ChangeFlag(NOBLOOD,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	//TNT1 A 0 A_TakeInventory("Blocking",1)
	TNT1 A 0 A_TakeInventory("Tic",9999)
	Goto See
  XDeath:
  Death: 
	HWAR K 5 A_SpawnItemEx("HereticKnightShield",0,0,25,6,0,0,60,SXF_CLIENTSIDE)
	HWAR L 5 A_Scream
	HWAR M 5 A_Fall
	HWAR NOPQRS 5
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HWAR T -1
	Stop 
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	HWAR TSRQPONMLK 5 
	Goto See 
  } 
}

Actor SummonedHereticKnight : HereticKnight { -COUNTKILL }

Actor RedBallAR : ShadeMissile
{
  Speed 60
  Damage (Random(10,32))
  -SEEKERMISSILE
  Species "Nobles"
  DamageType "NobleComet"
}

Actor RedBallMG : ShadeMissile
{
  Speed 60
  Damage (Random(10,40))
  -SEEKERMISSILE
  Species "Nobles"
  DamageType "NobleComet"
}

Actor RedBallCSG : ShadeMissile
{
  Speed 5
  Damage (0)
  -SEEKERMISSILE
  Species "Nobles"
  DamageType "NobleComet"
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 AAAA 0 A_CustomMissile("RedBallAR",0,0,frandom(5,-5),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(5,-5))
	TNT1 A 1
	Stop
  }
}

Actor RedBallSSG : RedBallCSG
{
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 AAAAAAAA 0 A_CustomMissile("RedBallAR",0,0,frandom(5,-5),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(5,-5))
	TNT1 A 1
	Stop
  }
}

Actor RedBallQSG : RedBallCSG
{
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("RedBallMG",0,0,frandom(5,-5),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(5,-5))
	TNT1 A 1
	Stop
  }
}

Actor RedBallPlasma : RedBallAR
{
  Scale 1.5
  Speed 30
  Damage (Random(10,25))//4
  -STRIFEDAMAGE
}

Actor RedBallDTR : RedBallAR
{
  Speed 55
  Scale 0.5
  Damage (Random(20,45))//7
  SeeSound "weapons/demontechfire"
  DeathSound "weapons/demontechex"
  States
  {
  Spawn:
	SHBB AAABBB 1 Bright A_SpawnItemEx("RedBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Crash:
  Death:
	SHBB CDEFG 3 Bright
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom10",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	SHBB CDEFG 3 Bright
	Stop
  }
}

Actor RedBallRocket : Comet
{
  Speed 30
  Species "Nobles"
  DamageType "NobleComet"
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  States
  {
  Spawn:
	SHBB AAABBB 1 Bright A_SpawnItemEx("HadesCometTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_Explode(64,102)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom14",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	SHBB CDEFG 3 Bright
	Stop
  }
}

Actor HadesCometTrail : ShadePuff
{
  Scale 1.0
  Renderstyle Add
  Alpha 1.0
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	SHBT ABCDE 2 A_FadeOut(0.1,1)
	Wait
  Vanilla:
	TNT1 A 1
	Stop
  }
}
	 

Actor RedBallGrenade : RedBallRocket
{
  +HEXENBOUNCE
  -NOGRAVITY
  BounceCount 8
  BounceFactor 25
} 

Actor ShadowPuff2 : ShadePuff { Scale 0.7 }

Actor RedBallTrail
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("ShadowPuff2",frandom(-5,5),frandom(-5,5),frandom(-5,5),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("HadesFire",0,0,frandom(5,-5),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor HereticKnightShield
{
  Height 8
  Radius 4
  Speed 6
  BounceType Doom
  Species "Nobles"
  DamageType "NobleComet"
  +MISSILE
  +DROPOFF
  +NOBLOCKMAP
  +NOTELEPORT
  +DOOMBOUNCE
  States
  {
