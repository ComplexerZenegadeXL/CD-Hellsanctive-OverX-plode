	TNT1 AAA 0 A_SpawnItemEx("Kaboom10",0,0,0,frandom(-8,8),frandom(-20,20),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("HadesElectroSmoke",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("SHadesTrail1",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-20,20),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 1 A_SpawnItemEx("SHadesTrail2",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE,0)
