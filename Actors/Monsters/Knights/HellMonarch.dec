Actor HellMonarch : CFHellKnight  //Not in spawners
{
  Monster
  Health 750
  Height 64
  Radius 24
  Mass 1300
  Speed 6
  Scale 1.15
  BloodColor "Green"
  MeleeRange 70
  PainChance 50
  Painchance "Mine", 128
  -BOSSDEATH
  +FLOORCLIP
  +DONTHARMSPECIES
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DropItem "BossLifeEssence", 200, 16
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax1", 200
  SeeSound "knight/sight"
  ActiveSound "knight/active"
  PainSound "knight/pain"
  DeathSound "knight/death"
  Obituary "$CFHellMonarchObit"
  HitObituary "$CFHellMonarchHitObit"
  Tag "$CFHellMon"
  States
  {
  Spawn:
	BOS4 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BOS4 A 10 A_Look
	Loop
  See:
	BOS4 AAAABBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	BOS4 CCCCDDDD 1 A_Chase
	TNT1 AAA 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  Missile:
  Melee:
	BOS4 E 6 Bright A_FaceTarget(45)
	BOS4 FG 4 Bright A_FaceTarget
	BOS4 G 1 Bright A_CustomComboAttack("NewBaronBall",40,10*random(1,8),"baron/melee","Melee",1)
	BOS4 GFEE 2 Bright
	Goto See
  Pain:
	BOS4 H 2
	BOS4 H 2 A_Pain
	Goto See
  XDeath:
  Death:
	BOS4 I 8 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BOS4 J 6 A_Scream
	BOS4 K 5 A_Fall
	BOS4 L 5
	BOS4 MN 4
	BOS4 O -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	BOS4 ONMLKJI 8
	Goto See
  }
}

Actor NewBaronBall : BaronBall
{
  Scale 1.2
  Speed 22
  FastSpeed 28
  Species "Nobles"
  DamageType "NobleComet"
  Decal "DoomImpScorch"
  +DONTHARMSPECIES
  States
  {
  Spawn:	
	BAL6 AB 1 Bright A_SpawnItemEx("NewBaronBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)	
	Loop
  Crash:
  Death:
	BAL6 CDE 3 Bright
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BAL6 CDE 3 Bright
	Stop
  }
}

Actor NewBaronBallTrail
{
  RenderStyle Add
  +FORCEXYBILLBOARD
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
  Fade:
	BAL6 AB 1 A_FadeOut(0.1,1)
	Loop
  }
}