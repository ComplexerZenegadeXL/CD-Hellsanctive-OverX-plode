Actor RadiationKnight : CFHellKnight 28528
{ 
  Health 1125
  PainChance 45
  PainChance "Explosion", 60
  Scale 1.15
  BloodColor "Green"
  MeleeDamage 15
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DamageFactor "NobleComet", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "PoisonCloud", 0.0
  Species "Nobles"
  +MISSILEMORE
  +FASTMELEE
  +QUICKTORETALIATE
  Obituary "$CFRadiationKnightObit"
  HitObituary "$CFRadiationKnightHitObit"
  SeeSound "TLord/See"    
  DeathSound "TLord/Death"  
  PainSound "TLord/Pain"
  MeleeSound "baron/melee"
  Tag "$CFRadKni"
  States 
  { 
  Spawn: 
    TLOD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TLOD AA 7 Bright A_Look
    Loop 
  See: 
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TLOD AABB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    TLOD CCDD 3 Bright A_Chase
    Loop
  Missile:  
    TNT1 A 0 A_Jump(128,"GiantBalls","BurstComet")
  Normal:
    TLOD EF 6 Bright A_FaceTarget 
	TLOD G 1 Bright A_CustomMissile("PoisonBall", 42, 0, 0)		
	TNT1 A 0 A_CustomMissile("PoisonBall", 42, 0, -6)
	TLOD G 4 Bright A_CustomMissile("PoisonBall", 42, 0, 6)
    TLOD IJ 6 Bright A_FaceTarget 
	TLOD K 1 Bright A_CustomMissile("PoisonBall", 42, 0, 0)		
	TNT1 A 0 A_CustomMissile("PoisonBall", 42, 0, -6)
	TLOD K 4 Bright A_CustomMissile("PoisonBall", 42, 0, 6)		
	TNT1 A 0 A_Jump(87,"GiantBalls","BurstComet")
    Goto See
  GiantBalls:
	TLOD EF 7 Bright A_FaceTarget
	TLOD G 6 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	TLOD IJ 7 Bright A_FaceTarget
	TLOD K 6 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	TNT1 A 0 A_Jump(87,"BurstComet")
	Goto See
  BurstComet:
    TLO2 AB 8 Bright A_FaceTarget
    TLO2 C 2 Bright A_CustomMissile("TLordComet",32,0,0)
	TNT1 A 0 A_Custommissile("TLordComet",32,0,-10)
	TLO2 C 5 Bright A_CustomMissile("TLordComet",32,0,10)
    Goto See
  Melee:
    TLO2 AB 7 Bright A_FaceTarget 
    TLO2 C 6 Bright A_MeleeAttack 	
    Goto See
  Pain:
    TLOD N 4 Bright A_Pain
    Goto See
  PainMissile:
	TLOD N 10 Bright A_Pain
    Goto Missile
  XDeath:
  Death: 
	TLOD O 7
	TLOD P 6 A_Scream 
	TLOD Q 5 A_Fall 	
	TLOD R 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("TLordPoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TLOD ST 4 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TLOD U -1
	Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TLOD UTSRQPO 6
    Goto See 
  } 
}

Actor SummonedRadiationKnight : RadiationKnight { -COUNTKILL }

Actor PoisonBall : CStaffMissile
{
  Radius 8
  Height 12
  Damage 7
  Speed 18
  FastSpeed 22
  Renderstyle Add
  Alpha 0.90
  PoisonDamage 15
  Species "Nobles"
  DamageType "NobleComet"
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  Projectile
  +EXPLODEONWATER
  States
  {
  Spawn:
    FVN1 A 1 Bright A_BishopMissileWeave
    FVN1 A 0 A_SpawnItemEx("PoisonTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,10)
    FVN1 B 1 Bright A_BishopMissileWeave
    FVN1 B 0 A_SpawnItemEx("PoisonTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,10)
    FVN1 C 1 Bright A_BishopMissileWeave
    FVN1 C 0 A_SpawnItemEx("PoisonTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,10)
    FVN1 D 1 Bright A_BishopMissileWeave
    FVN1 D 0 A_SpawnItemEx("PoisonTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,10)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    FVN1 EFGHIJ 3 Bright
    Stop
  }
}

Actor PoisonTrail
{   
  Radius 0
  Height 1
  Projectile
  RenderStyle Add
  Alpha 0.80
  States
  {
  Spawn:
    TNT1 A 1
    SSFX ABCDEFG 2 Bright
    Stop 
  }
}

Actor TLordComet : Comet
{
  Damage (Random(15,30)) //6
  Species "Nobles"
  DamageType "NobleComet"
  DeathSound "barbcomet/explosion"
  States
  {
  Spawn:
    BRTB AAABBB 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRTB C 3 Bright A_Explode(42,128)
    BRTB D 3 Bright A_SetTranslucent(0.75,1)
    TNT1 AAAAA 0 A_SpawnItemEx("TLordPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-4,2))
    BRTB EFG 3 Bright
    Stop
  }
}

Actor GHellionSmokeSpawner4 : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("PoisonSoulGas",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor GHellionSmoke4 : GHellionSmoke { Scale 0.6 }

Actor TLordPoison : BarbatosPoison { Species "Nobles" DamageType "NobleComet" }

Actor ItemLoop : Inventory { Inventory.MaxAmount 99 }