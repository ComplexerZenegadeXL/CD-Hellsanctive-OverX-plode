Actor DarkCybernoble : CyberNoble 17571
{ 
  //$Category Monsters/CF
  //$Sprite CBO3A1
  //$Title "Dark Cybernoble"
  Health 1500
  PainChance 50
  Scale 1.15
  Speed 12
  Obituary "$CFDarkCybernobleObit"
  HitObituary "$CFDarkCybernobleHitObit"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonTechRifleGiver" 256
  DropItem "DemonTechRailgunGiver" 32
  Tag "$CFDNoble"
  var int user_lowlag;
  var int user_loop;
  States 
  { 
  Spawn: 
    CBO3 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CBO3 A 10 A_Look
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CBO3 AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(62,"Rush")
    CBO3 AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    CBO3 CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 B 1 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBO3 D 1 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
	TNT1 A 0 A_Jump(42,"See")	
	Loop
  Pause:
	CBO3 E 10
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"BurstBall","LargeBall","Rocket")
    TNT1 A 0 A_Jump(30,"DTRailgun")
  Normal:
    CBO3 E 12 A_FaceTarget
	CBO3 E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DarkCyberNobleDemonTech",32,20,frandom(-1.5,1.5),0)
	CBO3 F 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(6,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+1
  BurstBall:
	CBO3 PQ 7 A_FaceTarget 
	CBO3 R 1 Bright A_CustomMissile("RIBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("RIBall", 32, 0, 6)
	CBO3 R 5 Bright A_CustomMissile("RIBall", 32, 0, -6)
	TNT1 A 0 A_Jump(87,"LargeBall","Rocket")
	Goto See
  LargeBall:
  	CBO3 PQ 7 A_FaceTarget
	CBO3 R 6 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)
  Rocket:
    CBO3 E 14 A_FaceTarget
    CBO3 F 8 Bright A_CustomMissile("DarkCyberNobleRocket",32,20,0,0)
    CBO3 E 10 A_FaceTarget
    CBO3 F 8 Bright A_CustomMissile("DarkCyberNobleRocket",32,20,0,0)
    CBO3 E 10
    Goto See
  DTRailgun:
	CBO3 E 4 Bright A_PlaySoundEx("monster/brusit","Voice")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTRailgunLoop:
    TNT1 A 0 A_SpawnItemEx("GHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CBO3 E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Goto DTRailgunLoop
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    CBO3 EEE 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/dtrailf")
	TNT1 A 0 A_CustomMissile("DTRailCore",32,20,0)
    CBO3 F 8 Bright A_CustomMissile("DarkCyberNobleDTRail",32,20,0,0)
    CBO3 E 10
    Goto See
  Melee:
    CBO3 PQ 7 A_FaceTarget
    CBO3 R 7 A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"PainMissile")
    CBO3 H 4 A_Pain
    Goto See
  PainMissile:
    CBO3 H 4 A_Pain
    Goto Missile	
  XDeath:
  Death:
    CBO3 I 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	CBO3 JJJKKK 2 Bright A_CustomMissile ("Kaboom5", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CBO3 L 4 Bright A_NoBlocking
    CBO3 MN 3 Bright
    CBO3 O -1
    Stop
  XRaise:
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	CBO3 ONMLKJI 5
	Goto See
  } 
}

Actor DarkCyberNobleRocket : DarkCyberRocket { Species "Nobles" DamageType "NobleComet" }

Actor DarkCyberNobleDemonTech : ZDemonTechProjectile { Species "Nobles"DamageType "NobleComet" }

Actor DarkCyberNobleDTRail : DarkAnnihilatorRail { Species "Nobles" DamageType "NobleComet" }

Actor DarkCyberNobleGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  Scale 1.15
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    CBO3 A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DarkCyberNobleGhostB : DarkCyberNobleGhostA
{
  States
  {
  Spawn:
    CBO3 B 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DarkCyberNobleGhostC : DarkCyberNobleGhostA
{
  States
  {
  Spawn:
    CBO3 C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DarkCyberNobleGhostD : DarkCyberNobleGhostA
{
  States
  {
  Spawn:
    CBO3 D 2 A_FadeOut(0.18)
    Loop
  }
}