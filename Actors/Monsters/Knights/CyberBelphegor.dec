Actor CyberBelphegor : CyberNoble 18551
{ 
  //$Category Monsters/LCA/DJB
  //$Sprite CBELA1
  //$Title "Cyber Belphegor"
  Health 1800
  PainChance 60
  MeleeDamage 24
  Scale 1.1
  Obituary "$CFCyberBelphegorObit"
  HitObituary "$CFCyberBelphegorHitObit"
  SeeSound "monster/brusit" 
  PainSound "cbaron/pain"
  DeathSound "cbaron/death"
  MeleeSound "baron/melee"
  ActiveSound "cbaron/active"
  DamageFactor "NobleComet", 0.0
  DropItem "LifeEssence" 150
  DropItem "ArmorBonusMax" 150
  BloodColor "Green"
  Tag "$CFCyBelph"
  +MISSILEMORE
  +DONTHURTSPECIES
  +FASTMELEE
  States 
  { 
  Spawn: 
    CBEL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CBEL AA 7 A_Look
    Loop 
  See:
    CBEL AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    CBEL CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Pause:
	CBEL E 10
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"BurstBall","LargeBall","Rocket","Comet", "HomingRocket")
  BurstBall:
	CBEL PQ 7 A_FaceTarget 
	CBEL R 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	CBEL R 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
    CBEL PQ 5 A_FaceTarget 
	CBEL R 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	CBEL R 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
    CBEL PQ 5 A_FaceTarget 
	CBEL R 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	CBEL R 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
	TNT1 A 0 A_Jump(87,"LargeBall","Rocket","Comet", "HomingRocket")
	Goto See
  LargeBall:
  	CBEL PQ 7 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	CBEL PQ 4 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	CBEL PQ 4 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	CBEL PQ 4 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	CBEL PQ 4 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	CBEL PQ 4 A_FaceTarget
	CBEL R 2 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
  Rocket:
    CBEL E 14 A_FaceTarget
    CBEL F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    CBEL E 12 A_FaceTarget
	CBEL F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    CBEL E 10 A_FaceTarget
	CBEL F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    CBEL E 8 A_FaceTarget
    Goto See
  HomingRocket:
    CBEL E 14 A_FaceTarget 
    CBEL F 8 Bright A_CustomMissile("BruiserMissile",32,0,0,0)
    CBEL E 12 A_FaceTarget
    CBEL F 8 Bright A_CustomMissile("BruiserMissile",32,0,0,0)
    CBEL E 10 A_FaceTarget
    CBEL F 8 Bright A_CustomMissile("BruiserMissile",32,0,0,0)
    CBEL E 8 A_FaceTarget
    Goto See	
  Comet:
  	CBEL PQ 12 A_FaceTarget
	CBEL R 11 Bright A_CustomMissile("HDComet", 32, 0, 0)
    Goto See
  Melee:
    CBEL PQ 5 A_FaceTarget
    CBEL R 5 A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"PainMissile")
    CBEL H 4 A_Pain
    Goto See
  PainMissile:
    CBEL H 4 A_Pain
    Goto Missile	
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(98,2)
	"####" "#" 0 A_SpawnItemEx("DoubleBarrelShotgunGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  XDeath:
  Death:
  	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(98,2)
	TNT1 A 0 A_SpawnItemEx("DoubleBarrelShotgunGiver",0,0,12,0,0,0,0)
    CBEL I 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	CBEL JJJKKK 2 Bright A_CustomMissile ("Kaboom5", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CBEL L 4 Bright A_NoBlocking
    CBEL MN 3 Bright
    CBEL O -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	CBEL NMLKJI 5
	Goto See
  } 
}