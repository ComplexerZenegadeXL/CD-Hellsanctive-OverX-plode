   }
}

Actor ELegNobleRings : LegNobleRings
{
  States
  {
  Spawn:
    TNT1 A 0
    EBAR ABCDEFGHIJKLMNOPQR 2 Bright A_Explode(24,80)
    Stop
  }
}

Actor ELNGhost : LNGhost
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    ENBL A 2 A_FadeOut(0.09)
    Loop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor RedWalkFire : GoldWalkFire
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 10
    EQTF ABC 3 Bright
    TNT1 A 0 A_Jump(191,3)
    TNT1 A 0 A_CustomMissile("RedWalkFire",0,24)
    TNT1 A 0 A_CustomMissile("RedWalkFire",0,-24)
    EQTF DEFGHIJKLMNO 3 Bright
    Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor ELegNobleComet : LegNobleComet
{
  Damage (Random(20,35)) //7
  States
  {
  Spawn:
	ENCM AAAABBBBCCCC 1 Bright A_SpawnItemEx("ELNCometTail")
	Loop
  Death:
	TNT1 A 0 Bright A_Explode(70,112)
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner")
	ENCM DE 3 Bright
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	ENCM JJJKKKLLMMNN 1 Bright A_FadeOut(0.065)
	Stop
  }
}

Actor ELNCometTail : LNCometTail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
	ELUR DEFGHI 2 Bright
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor RedRainCometNull : BlueRainCometNull
{
  States
  {
  Spawn:
	TNT1 A 0 A_Countdown
    E4P5 A 1 Bright A_Wander
    E4P5 A 8 Bright A_CustomMissile("FallingRedComet",-24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(1,89))
    Loop
  Death:
    E4P5 A 0
    Stop
  }
}

Actor FallingRedComet : FallingBlueComet
{
  Damage (Random(60,100)) //30
  States
  {
  Spawn:
    ECOM AABBCC 1 Bright A_SpawnItemEx("ELNCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    Loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_Explode(48,192)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
	ECOM DEFGH 3 Bright
	Stop	
  }
}


Actor BigRedComet : BigBlueComet
{
  Damage (Random(55,85)) //18
  States
  {
  Spawn:
	ENBC AAAABBBBCCCC 1 Bright A_SpawnItemEx("BigRedCometTail")
	Loop
  Death:
	TNT1 A 0 A_Explode
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
	ENBC DE 3 Bright
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	ENBC JKLMN 3 Bright A_FadeOut(0.1)
	Stop
  }
}

Actor BigRedCometTail : BigBlueCometTail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 2
	ENBC DEFGHI 2 Bright
	Stop
  }
}