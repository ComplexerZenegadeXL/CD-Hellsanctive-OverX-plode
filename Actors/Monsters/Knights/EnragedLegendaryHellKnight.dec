Actor EnragedLegendaryHellKnight : LegendaryHellKnight
{
  Health 2400
  Height 78
  Speed 12
  +BRIGHT
  SeeSound "ELEGHK/See"
  DeathSound "ELEGHK/Rip"
  MeleeDamage 18
  BloodColor "Red"
  DamageFactor 0.6
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 64
  DropItem "EnragedLegendaryUltraSphere" 38
  DropItem "ILDemonAmmoBoxPickup" 256 
  DropItem "ILDemonAmmoPickup" 256 
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFEnragedLegendaryHellKnightObit"
  HitObituary "$CFEnragedLegendaryHellKnightHitObit"
  Tag "$CFEnrHK"
  var int user_fake;
  States
  {
  Spawn:
    ENBL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    ENBL A 14 A_Look
	ENBL Z 14 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ENBL AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,405)
	TNT1 A 0 A_SetUserVar("user_music",1)
    TNT1 A 0 A_Jump(100,"Rush")
	ENBL AA 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ENBL BB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ENBL CC 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	ENBL DD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("RedWalkFire")
	TNT1 A 0 A_Jump(32,"Teleport")
    Loop
  Rush:
    ENBL A 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL A 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL B 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL B 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL C 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL C 2 A_SpawnItemEx("ELNGhost")
	LNBL AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL D 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
    ENBL D 2 A_SpawnItemEx("ELNGhost")
	ENBL AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
    Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ENBL P 1 A_UnSetShootable
	ENBL PPPPPPPPPP 1  A_FadeOut(0.1,0)
	ENBL P 2 
	ENBL PEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    ENBL P 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ENBL PPPPPPPPPP 1 A_FadeIn(0.1)
    ENBL P 1 A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(127,"Spread","Hugger","Rage","BestAttack","Rain")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(9,"MinionSummoner")
	TNT1 A 0 A_Jump(100,"4Comets","RedComet")
  Normal:
    ENBL EF 5 A_FaceTarget
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,-8)
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,-4)
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,4)
	ENBL G 5 A_CustomMissile("ELegNobleBall",32)
    ENBL ST 5 A_FaceTarget
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,8)
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,4)
	ENBL G 0 A_CustomMissile("ELegNobleBall",32,0,-4)
	ENBL U 5 A_CustomMissile("ELegNobleBall",32)	
	TNT1 A 0 A_Jump(127,"Spread")
	Goto See
  Spread:
    ENBL PQ 9 A_FaceTarget
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,18)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-18)
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,15)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-15)
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,12)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-12)
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,9)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-9)
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,6)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-6)	
    ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,3)	
	ENBL R 0 A_CustomMissile("ELegNobleBall2",32,0,-3)
    ENBL R 8 A_CustomMissile("ELegNobleBall2",32)
	TNT1 A 0 A_Jump(127,"Hugger")
    Goto See
  Hugger:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL RQ 9 A_FaceTarget
	ENBL PP 4 A_FaceTarget
	ENBL P 0 A_CustomMissile("ELegNobleBall3",32,20)
    ENBL P 0 A_CustomMissile("ELegNobleBall3",32,-20)
	ENBL PP 4 A_FaceTarget
	TNT1 A 0 A_Jump(80,"RedComet")
    Goto See	
  RedComet:
    ENBL EF 7 A_FaceTarget
	ENBL G 2 A_CustomMissile("ELegNobleComet", 32)
	ENBL G 0 A_CustomMissile("ELegNobleComet", 32, 0, 6)
	ENBL G 4 A_CustomMissile("ELegNobleComet", 32, 0, -6)
    ENBL ST 7 A_FaceTarget
	ENBL U 2 A_CustomMissile("ELegNobleComet", 32)
	ENBL G 0 A_CustomMissile("ELegNobleComet", 32, 0, 6)
	ENBL U 4 A_CustomMissile("ELegNobleComet", 32, 0, -6)
	TNT1 A 0 A_Jump(80,"4Comets")
    Goto See
  4Comets:
    ENBL PQ 8 A_FaceTarget
	ENBL R 0 A_CustomMissile("BigRedComet", 32)
	ENBL R 0 A_CustomMissile("BigRedComet", 32, 0, -5)
	ENBL R 0 A_CustomMissile("BigRedComet", 32, 0, 5)
	ENBL R 7 A_CustomMissile("BigRedComet", 32, 0, 10)
	TNT1 A 0 A_Jump(127,"Rage")
	Goto See
  Rage:	
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL Q 1 A_PlaySound("ELEGHK/See")
	ENBL Q 1 A_FaceTarget
	ENBL Q 1 A_SetUserVar("user_missile",0)
    ENBL RRQQ 4 A_FaceTarget
  Raging:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL Q 0 A_JumpIf(user_missile >= 28,"See")	 
    ENBL Q 0 A_SetUserVar("user_missile",user_missile+1)
    ENBL QQ 0 A_CustomMissile("ELegNobleBall3Small",0,0,frandom(0,360))	
    ENBL Q 4 A_FaceTarget
    Loop
  BestAttack:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL Q 1 A_PlaySound("ELEGHK/See")
    ENBL P 2 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ENBL PPPPPPP 5 A_FaceTarget
	ENBL QQQQQQQQQ 4 A_FaceTarget
	ENBL R 2 A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	//TNT1 A 0 A_Jump(96,"Tornado")
    ENBL R 8 A_CustomMissile("ELegNobleBall4",32)
    Goto See
  /*Tornado:
    ENBL R 8 A_CustomMissile("EnragedTornado",32)*/
  Rain:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL PPPPQQQQ 4 A_FaceTarget
    ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,180)
    ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,90)
    ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,-90)
	ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,45)
    ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,135)
    ENBL Q 0 A_CustomMissile("RedRainCometNull",32,0,215)
    ENBL Q 8 A_CustomMissile("RedRainCometNull",32)
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    ENBL QQQQQQQQQQQQQQQQQQQQQ 6 A_FaceTarget
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  MinionSummoner:
    TNT1 A 0 A_SetUserVar("user_effect_delay",11)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	ENBL P 1 A_ChangeFlag(Invulnerable,1)
	TNT1 A 0 A_PlaySound("knight/sight")
	ENBL PPPPPPPPP 4 A_FaceTarget
	TNT1 A 0 A_PlaySound ("hk/summon")
	TNT1 A 0 A_SpawnItemEx("HellKnightSummoner",0,0,20,30)
	TNT1 A 0 A_SpawnItemEx("HellKnightSummoner",0,0,20,30,0,0,180)
	TNT1 A 0 A_SpawnItemEx("HellKnightSummoner",0,0,20,30,0,0,225)
	TNT1 A 0 A_SpawnItemEx("HellKnightSummoner",0,0,20,30,0,0,305)
	ENBL P 25
	TNT1 A 0 A_ChangeFlag(Invulnerable,0)
	Goto See	
 Melee:
    ENBL EF 3 A_FaceTarget 
    ENBL G 3 A_MeleeAttack	
	ENBL ST 3 A_FaceTarget 
    ENBL U 3 A_MeleeAttack	
    Goto See 	
  Pain:
    TNT1 A 0 A_Jump(8,"Rage")	
  	TNT1 A 0 A_Jump(42,"Teleport")
    ENBL H 2
    ENBL H 2 A_Pain
	TNT1 A 0 A_Jump(129,"Missile")
    Goto See
  XDeath:
  Death:
    TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	ENBL I 8
    ENBL J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,31)
	TNT1 A 0 A_DropItem("EnragedDust",random(4,6),256)
    ENBL K 8
    ENBL L 8 A_NoBlocking
    ENBL MN 8
    ENBL O -1 A_BossDeath
    Stop
  }
}

Actor ELegNobleBall : LegNobleBall
{
  Damage (Random(50,70)) //13
  BounceCount 4
  States
  {
  Spawn:
    EBA1 ABC 1 Bright A_CustomMissile("ELegNobleBallTrail",frandom(-1,1),frandom(-1,1))
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
    EBA1 DEFG 3 Bright
    Stop
    }
}

Actor ELegNobleBallTrail : LegNobleBallTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    EBA1 ABCD 2 Bright A_FadeOut
    Stop
  }
}

Actor ELegNobleBall2 : LegNobleBall2
{
  Damage (Random(70,110)) //22
  Speed 30
  FastSpeed 40
  States
  {
  Spawn:
    EBAQ AB 1 Bright A_SpawnItemEx("ELegNobleBall2Trail")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
    EBAQ CDE 3 Bright
    Stop
  }
}

