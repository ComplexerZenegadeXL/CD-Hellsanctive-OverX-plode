Actor ELegNobleBall3 : LegNobleBall3
{
  Speed 26
  Damage (Random(50,80)) //16
  States
  {
  Spawn:
	EBA3 A 0 
	EBA3 A 0 A_LoopActiveSound
  SpawnLoop:
	EBA3 A 0 A_CountDown
	EBA3 ABCABC 1 Bright A_SpawnItemEx("ELegNobleBall3Trail")
	TNT1 AA 0 A_CustomMissile("ELegNobleBall3Small",0,0,frandom(0,360))
	EBA3 A 0 A_SeekerMissile(14,0)
	Loop
  Death:
	EBA3 A 0 A_Explode(32,64,0)
	EBA3 A 0 A_SpawnItem("ELegNobleBall3Explode")
	EBA3 ABC 4
	Stop
  }
}

Actor ELegNobleBall3Trail : LegNobleBall3Trail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    EBA3 ABCABCABCABC 1 A_FadeOut(0.09)
    Stop
  }
}

Actor ELegNobleBall3Explode : LegNobleBall3Explode
{
  Renderstyle Add
  States
  {
  Spawn:
	EBAE A 0 A_Explode
	EBAE ABCDE 3 Bright
	Stop
  }
}

