Actor ELegNobleBall3SmallTrail : ELegNobleBall3Trail { Scale 0.424}

Actor ELegNobleBall4 : LegNobleBall4
{
   Damage (Random(200,400)) //80
   BounceCount 7
   States
   {
   Spawn:
	TNT1 A 0
	TNT1 A 0 A_LoopActiveSound
  SpawnLoop:
