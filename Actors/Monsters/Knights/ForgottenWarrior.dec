Actor ForgottenWarrior : CFHellKnight
{
  Monster
  Health 1300
  Height 64
  Radius 24
  Mass 1000
  Speed 8
  BloodColor "Purple"
  PainChance "Mine", 128
  PainChance 27
  MeleeRange 72
  MeleeDamage 20
  +FLOORCLIP
  +DONTHARMSPECIES
  -BOSSDEATH
  DamageFactor "Acid", 0.0
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DropItem "BossLifeEssence", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax5", 200
  SeeSound "deepone/sight"
  PainSound "deepone/pain"
  DeathSound "deepone/death"
  MeleeSound "deepone/melee"
  Obituary "$CFForgottenWarriorObit"
  HitObituary "$CFForgottenWarriorHitObit"
  Tag "$CFSquid"
  var int user_lowlag;
  var int user_loop;
  States
  {
  Spawn:
	CUTH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_Jump(150,"StealthSpawn")
  Idle:
	CUTH A 10 A_LookEx(0,0,0,0,0,"See")
	Loop
  StealthSpawn:
	TNT1 A 0 A_GiveInventory("ShadeInvisible",1)
  StealthIdle:
	TNT1 A 0 A_GiveInventory("ShadeInvisible",1)
	TNT1 A 0 A_SetTranslucent(0.2)
	CUTH A 1 A_Wander
	TNT1 A 0 A_GiveInventory("ShadeInvisible",1)
	TNT1 AAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
  SIdleLoop:
	CUTH A 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH A 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH A 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH A 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH B 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH B 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH B 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH B 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	CUTH C 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH C 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH C 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH C 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH D 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH D 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH D 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	CUTH D 1 A_Wander
	TNT1 A 0 A_LookEx(0,0,0,0,0,"See")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CUTH AAAABBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"UnStealth")
	TNT1 A 0 A_Jump(50,"ActiveSound")
	TNT1 A 0 A_Jump(21,"Stealth")
	CUTH AAAABBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	CUTH CCCCDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,2,0,0,-20)
	Loop
  ActiveSound:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"ActiveStealth")
	TNT1 A 0 A_PlaySound("DeepOne/Active",0,1.0,0)
	Goto See+2
  ActiveStealth:
	TNT1 A 0 A_PlaySound("deepone/stealth",0,1.0,0)
	Goto StealthWalk+2
  Stealth:
	CUTH A 1 A_SetTranslucent(1.0,0)
	CUTH A 1 A_SetTranslucent(0.9,0)
	CUTH A 1 A_SetTranslucent(0.8,0)
	CUTH A 1 A_SetTranslucent(0.7,0)
	CUTH A 1 A_SetTranslucent(0.6,0)
	CUTH A 1 A_SetTranslucent(0.5,0)
	CUTH A 1 A_SetTranslucent(0.4,0)
	CUTH A 1 A_SetTranslucent(0.3,0)
	CUTH A 1 A_SetTranslucent(0.2,0)
  StealthWalk:
	TNT1 A 0 A_GiveInventory("ShadeInvisible",1)
	TNT1 A 0 A_Jump(50,"ActiveStealth")
	CUTH AAAABBB 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	CUTH CCCCDDD 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	CUTH AAAABBB 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	CUTH CCCCDDD 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Chase
	TNT1 A 0 A_Jump(27,"Unstealth")
	Goto StealthWalk+1
  UnStealth:
	TNT1 A 0 A_TakeInventory("ShadeInvisible",9999)
	CUTH A 1 A_SetTranslucent(0.2,0)
	CUTH A 1 A_SetTranslucent(0.3,0)
	CUTH A 1 A_SetTranslucent(0.4,0)
	CUTH A 1 A_SetTranslucent(0.5,0)
	CUTH A 1 A_SetTranslucent(0.6,0)
	CUTH A 1 A_SetTranslucent(0.7,0)
	CUTH A 1 A_SetTranslucent(0.8,0)
	CUTH A 1 A_SetTranslucent(0.9,0)
	CUTH A 1 A_SetTranslucent(1.0,0)
	Goto See
  AttackStealth:
	TNT1 A 0 A_TakeInventory("ShadeInvisible",9999)
	CUTH A 1 A_SetTranslucent(0.2,0)
	CUTH A 1 A_SetTranslucent(0.4,0)
	CUTH A 1 A_SetTranslucent(0.6,0)
	CUTH A 1 A_SetTranslucent(0.7,0)
	CUTH A 1 A_SetTranslucent(0.8,0)
	CUTH A 1 A_SetTranslucent(1.0,0)
	Goto Missile
  MeleeStealth:
	TNT1 A 0 A_TakeInventory("ShadeInvisible",9999)
	CUTH A 1 A_SetTranslucent(0.2,0)
	CUTH A 1 A_SetTranslucent(0.4,0)
	CUTH A 1 A_SetTranslucent(0.6,0)
	CUTH A 1 A_SetTranslucent(0.7,0)
	CUTH A 1 A_SetTranslucent(0.8,0)
	CUTH A 1 A_SetTranslucent(1.0,0)
	Goto Melee
  AttackPain:
	TNT1 A 0 A_TakeInventory("ShadeInvisible",9999)
	CUTH A 1 A_SetTranslucent(0.2,0)
	CUTH A 1 A_SetTranslucent(0.6,0)
	CUTH A 1 A_SetTranslucent(1.0,0)
	Goto Pain
  Melee:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"MeleeStealth")
	TNT1 A 0 A_PlaySound ("deepone/meleegrowl",0,1.0,0) 
	CUTH EFG 4 A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	CUTH HIIGFE 3
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"AttackStealth")
	TNT1 A 0 A_Jump(68,"PhaseBall")
  Normal:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"AttackStealth")
	TNT1 A 0 A_PlaySound ("deepone/sight",0,1.0,0) 
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Normal.Hard")
	CUTH JJ 6 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeterodoxAcid",42,15,frandom(-18,9),CMF_TRACKOWNER)
	CUTH J 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto NormalLoop
	CUTH J 11
	Goto See
  PhaseBall:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"AttackStealth")
	TNT1 A 0 A_PlaySound("deepone/sight",0,1.0,0) 
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"PhaseBall.Hard")
	CUTH JJJJ 6 A_FaceTarget(45)
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15,0,CMF_TRACKOWNER)
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15,0,CMF_TRACKOWNER)
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15,0,CMF_TRACKOWNER)
	CUTH J 17
	Goto See
  Normal.Hard:
	CUTH JJJJ 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Normal.HardLoop:
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeterodoxAcid",42,15,frandom(-18,9))
	CUTH JJJJJ 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto Normal.HardLoop
	CUTH J 11
	Goto See
  PhaseBall.Hard: 
	CUTH JJJJ 6 A_FaceTarget
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15)
	TNT1 AAA 0 A_CustomMissile("PhaseImpBall",42,15,random(-19,19))
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15)
	TNT1 AAA 0 A_CustomMissile("PhaseImpBall",42,15,random(-19,19))
	CUTH KK 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("PhaseImpBall",42,15)
	CUTH J 17
	Goto See
  Pain:
	TNT1 A 0 A_JumpIfInventory("ShadeInvisible",1,"AttackPain")
	CUTH L 2 A_Pain
	CUTH L 4
	Goto See
  Death:
	CUTH M 3
	TNT1 A 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,37,0,0,0,0,SXF_CLIENTSIDE)
	CUTH M 3 A_Scream
	CUTH N 5 A_Fall
	CUTH O 5
	CUTH P 4
	CUTH Q -1
	Stop
  XDeath:
	CUTH R 5
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	CUTH S 5 A_Scream
	CUTH T 5 A_Fall
	CUTH UV 5
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	CUTH W -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	CUTH PONM 8
	Goto See
  XRaise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	CUTH VUTSR 4
	Goto See
  }
}

Actor SummonedForgottenWarrior : ForgottenWarrior { -COUNTKILL }