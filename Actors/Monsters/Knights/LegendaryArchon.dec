Actor LegendaryArchon : LegendaryHellKnight 17504
{ 
  //$Category Monsters/CF
  //$Sprite LGRCA1C1
  //$Title "Legendary Archon"
  Health 2500
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DropItem "LegendarySphere" 192
  DropItem "LDemonAmmoBoxPickup" 256 
  DropItem "LDemonAmmoPickup" 256 
  DropItem "BossLifeEssence" 256 
  DropItem "BossArmorBonusMax" 256 
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticRifleGiver" 105
  DropItem "LegendaryRandomSphere" 16
  Tag "$CFLegArch"
  Obituary "$CFLegendaryArchonObit"
  HitObituary "$CFLegendaryArchonHitObit"
  SeeSound "LegArchon/Sight" 
  ActiveSound "LegArchon/Active"
  PainSound "LegArchon/Pain"
  DeathSound "LegArchon/Death"
  var int user_loop;
  States 
  { 
  Spawn: 
	LGRC A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    LGRC A 14 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LGRC AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,307)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	LGRC AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegArchonWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LGRC BB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegArchonWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LGRC CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegArchonWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LGRC DD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("LegArchonWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(32,"Teleport")
	Loop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("BaronOfHell",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  Rush:
	LGRC A 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC A 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC B 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC B 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC C 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC C 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC D 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	LGRC D 2 Bright A_SpawnItemEx("LegArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(24,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LGRC M 1 Bright A_UnSetShootable
	LGRC MMMMMMMMMM 1  A_FadeOut(0.1,0)
	LGRC M 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LGRC M 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LGRC MMMMMMMMMM 1 A_FadeIn(0.1)
    LGRC M 1 Bright A_SetShootable
    Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(127,"Spread","Hugger","Rage","BestAttack","Rain","Rippers")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(9,"MinionSummoner")
	TNT1 A 0 A_Jump(100,"9Comets","BlueComet")
  Normal:
    LGRC EF 5 Bright A_FaceTarget
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,-12)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,-8)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,8)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,-4)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,4)
	LGRC G 5 Bright A_CustomMissile("LegNobleBall",32,0,0)
    LGRC IJ 5 Bright A_FaceTarget
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,12)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,-8)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,8)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,4)
	LGRC G 0 A_CustomMissile("LegNobleBall",32,0,-4)
	LGRC K 5 Bright A_CustomMissile("LegNobleBall",32,0,0)	
	TNT1 A 0 A_Jump(127,"Spread")
	Goto See
  Spread:
    LGRC MN 9 Bright A_FaceTarget
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,18)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-18)
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,15)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-15)
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,12)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-12)
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,9)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-9)
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,6)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-6)	
    LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,3)	
	LGRC R 0 A_CustomMissile("LegNobleBall2",32,0,-3)
    LGRC O 8 Bright A_CustomMissile("LegNobleBall2",32,0,0)
	TNT1 A 0 A_Jump(127,"Hugger")
    Goto See
  Hugger:
    LGRC ON 9 Bright A_FaceTarget
	LGRC MM 4 Bright A_FaceTarget
    TNT1 A 0 Bright A_Playsound("brain/spit",6,2.0,0,0.5)
    TNT1 A 0 A_CustomMissile("LegAfritFloorfireSpawner",32,0,10)
    TNT1 A 0 A_CustomMissile("LegAfritFloorfireSpawner",32,0,-10)
	LGRC MM 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(80,"BlueComet")
    Goto See	
  BlueComet:
    LGRC EF 7 Bright A_FaceTarget
	LGRC G 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LGRC G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LGRC G 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
    LGRC IJ 7 Bright A_FaceTarget
	LGRC K 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LGRC G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LGRC K 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
    LGRC EF 7 Bright A_FaceTarget
	LGRC G 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LGRC G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LGRC G 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
    LGRC IJ 7 Bright A_FaceTarget
	LGRC K 2 Bright A_CustomMissile("LegNobleComet", 32, 0, 0)
	LGRC G 0 A_CustomMissile("LegNobleComet", 32, 0, 6)
	LGRC K 4 Bright A_CustomMissile("LegNobleComet", 32, 0, -6)
	TNT1 A 0 A_Jump(80,"9Comets")
    Goto See
  9Comets:
    LGRC MN 8 Bright A_FaceTarget
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, -5)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, 5)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, -10)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, 10)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, -15)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, 15)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, -20)
	LGRC O 0 A_CustomMissile("BigBlueComet", 32, 0, 20)
	LGRC O 7 Bright A_CustomMissile("BigBlueComet", 32, 0, 0)
	TNT1 A 0 A_Jump(127,"Rage")
	Goto See
  Rippers:
	LGRC MMNN 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RippersLoop:
	TNT1 A 0 A_CustomMissile("LegArchonRipper",32,0,frandom(-15,15))
	LGRC O 2 Bright A_CustomMissile("LegArchonRipper",32,0,frandom(-3,3))
	LGRC O 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 16,1)
	Loop
	TNT1 A 0 A_Jump(127,"Hugger")
	Goto See
  Rage:	
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LGRC N 1 Bright A_PlaySound("LegArchon/Sight")
	LGRC N 1 Bright A_FaceTarget
	LGRC N 1 Bright A_SetUserVar("user_missile",0)
    LGRC OOOO 4 Bright A_FaceTarget
  Raging:
    LGRC O 0 A_JumpIf(user_missile >= 8,"See")	 
    LGRC O 0 A_SetUserVar("user_missile",user_missile+1)
    LGRC OO 0 A_CustomMissile("LegAfritFloorfireSpawner",0,0,frandom(0,360))	
    LGRC OOOOO 4 Bright A_FaceTarget
    Loop
  BestAttack:
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LGRC N 1 Bright A_PlaySound("LegArchon/Sight")
    LGRC M 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LGRC MMMMMMMMNNNNNNNNNO 4 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    LGRC O 8 Bright A_CustomMissile("LegArchonBigBall",32,0,0)
    Goto See
  Rain:
    TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LGRC MMMMNNNN 4 Bright A_FaceTarget
    LGRC N 0 A_CustomMissile("BlueRainCometNull",32,0,200)
    LGRC N 0 A_CustomMissile("BlueRainCometNull",32,0,90)
    LGRC N 0 A_CustomMissile("BlueRainCometNull",32,0,-90)	
    LGRC N 8 Bright A_CustomMissile("BlueRainCometNull",32,0,0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    LGRC NNNNNNNNNNNNNNNN 8 Bright A_FaceTarget
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
 MinionSummoner:
    TNT1 A 0 A_SetUserVar("user_effect_type",11)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LGRC M 1 Bright A_ChangeFlag("Invulnerable",1)
	TNT1 A 0 A_PlaySound("LegArchon/Sight")
	LGRC MMMMMMMMM 4 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(Reflective,1)
	TNT1 A 0 A_Playsound ("hk/summon")
	TNT1 A 0 A_SpawnItemEx("BaronSummoner",0,0,20,30,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("BaronSummoner",0,0,20,30,0,0,180,0)
	TNT1 A 0 A_SpawnItemEx("BaronSummoner",0,0,20,30,0,0,225,0)
	TNT1 A 0 A_SpawnItemEx("BaronSummoner",0,0,20,30,0,0,305,0)
	LGRC M 25 Bright
	TNT1 A 0 A_ChangeFlag(Invulnerable,0)
	TNT1 A 0 A_ChangeFlag(Reflective,0)
	Goto See	
 Melee:
    LGRC EF 6 Bright A_FaceTarget 
    LGRC G 6 Bright A_MeleeAttack	
	LGRC IJ 6 Bright A_FaceTarget 
    LGRC K 6 Bright A_MeleeAttack	
    Goto See 	
  Pain:
    TNT1 A 0 A_Jump(8,"Rage")
  	TNT1 A 0 A_Jump(42,"Teleport")
    LGRC Q 2 A_Jump(128,"PainMissile")
    LGRC Q 2 A_Pain
    Goto See
  PainMissile: 
    LGRC Q 3 Bright	
    LGRC Q 3 Bright A_Pain
    Goto Missile
  XDeath:
  Death:
	LGRC Q 4 Bright
	LGRC Q 4 Bright A_Scream
	LGRC QQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 2 Bright A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	LGRC R 8 Bright
	LGRC S 7 Bright
	TNT1 A 0 A_Jump(100,3)
	TNT1 A 0 A_SpawnItem("MiniDeathBall")
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_SpawnItem("TrueDeathBall")
	TNT1 AAA 0 Bright A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,40,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	LGRC U 5 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,28)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LGRC VW 5 Bright
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",Random(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LGRC X 4 Bright A_CustomMissile("LegArchonSoul",86,0,0,2,90)
	LGRC Z 4 Bright
	Stop
  } 
}

Actor LegArchonRipper
{
  Radius 8
  Height 8
  Speed 40
  Damage (Random(30,50)) //9
  Species "Nobles"
  DamageType "Legendary"
  Projectile
  +NOTIMEFREEZE
  Scale 0.9
  Seesound "legarchon/ripper"
  DeathSound "legarchon/ripperex"
  States
  {
  Spawn:
    LARB ABC 3 Bright A_SpawnItemEx("LegArchonRipperTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    ICE9 P 0 A_SetTranslucent (0.75,1)
    ICE9 A 2 Bright A_Explode(64,64,1)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,0,0,0)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,60,0,0)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,120,0,0)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,180,0,0)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,240,0,0)
    ICE9 P 0 A_SpawnItemEx("LegArchonRipperSpike",0,0,0,50,0,0,300,0,0)
    ICE9 BCDEF 2 Bright
    Stop
  }
}

Actor LegArchonRipperTrail : ImpBallTrail
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    ICE1 IJKLM 3
    Stop
  }
}

Actor LegArchonRipperSpike
{
  Radius 5
  Height 5
  Damage (Random(3,5)) //1
  Projectile
  Species "Nobles"
  DamageType "Legendary"
  +RIPPER
  +THRUGHOST
  +FORCEXYBILLBOARD
  -NOGRAVITY
  +LOWGRAVITY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    BONE A 3 Bright
    Loop
  Death:
    6PUF ABCDEFG 2 Bright
    Stop
  }
}

Actor LegArchonBigBall
{
  Radius 20
  Height 40
  Speed 75
  Damage (Random(250,425)) //75
  Projectile
  Renderstyle Add
  Alpha 0.8
  Scale 1.2
  BounceType Hexen
  BounceCount 8
  Species "Nobles"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +SEEKERMISSILE
  SeeSound "LegArchon/BigBall"
  DeathSound "LegArchon/BigBallXP"
  Decal "Scorch"
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(5,0)
	AFX4 A 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 B 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 C 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 D 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 E 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 F 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 G 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
	TNT1 A 0 A_SeekerMissile(5,0)
    AFX4 H 1 Bright A_Explode(64,64,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegArchonBigBallTrail")
    Loop
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("BlueDTech10KShockwave",0,0,15,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItem("BlueDTBFGEx",0,-10)
    AFX4 I 5 Bright A_Explode(128,128,0)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,0,2)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,60,2)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,120,2)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,180,2)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,240,2)
    AFX4 I 0 A_CustomMissile("LegArchonSmallBall1",0,0,300,2)
    AFX4 JKL 5 Bright A_Explode(128,128,0)
    Stop
  }
}

