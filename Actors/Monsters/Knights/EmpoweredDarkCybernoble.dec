Actor EmpoweredDarkCybernoble : DarkCybernoble
{ 
  Health 2200
  PainChance 30
  Speed 16
  BloodColor "Red"
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  Obituary "$CFEmpoweredDarkCybernobleObit"
  HitObituary "$CFEmpoweredDarkCybernobleHitObit"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonTechRifleGiver" 256
  DropItem "DemonTechRailgunGiver" 32
  DropItem "SphereOfPower" 100
  Tag "$CFEmpDNoble"
  States 
  { 
  Spawn: 
    PCNO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PCNO A 10 A_Look
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PCNO AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(62,"Rush")
    PCNO AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    PCNO CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO B 1 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("EDarkCyberNobleGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PCNO D 1 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
	TNT1 A 0 A_Jump(42,"See")	
	Loop
  Pause:
	PCNO E 10
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"BurstBall","LargeBall","Rocket")
    TNT1 A 0 A_Jump(60,"DTRailgun")
  Normal:
    PCNO E 12 A_FaceTarget
	PCNO E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("NoblePoweredDemonTech",32,20,frandom(-1.5,1.5),0)
	PCNO F 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(6,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Normal+1
  BurstBall:
	PCNO PQ 7 A_FaceTarget 
	PCNO R 1 Bright A_CustomMissile("RIBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("RIBall", 32, 0, 6)
	PCNO R 5 Bright A_CustomMissile("RIBall", 32, 0, -6)
	TNT1 A 0 A_Jump(87,"LargeBall","Rocket")
	Goto See
  LargeBall:
  	PCNO PQ 7 A_FaceTarget
	PCNO R 6 Bright A_CustomMissile("ArcradimusComet2", 32, 0, 0)
  Rocket:
    PCNO E 14 A_FaceTarget
    PCNO F 8 Bright A_CustomMissile("InfernalCyberNobleRocket",32,20,0,0)
    PCNO E 10 A_FaceTarget
    PCNO F 8 Bright A_CustomMissile("InfernalCyberNobleRocket",32,20,0,0)
    PCNO E 10 A_FaceTarget
    PCNO F 8 Bright A_CustomMissile("InfernalCyberNobleRocket",32,20,0,0)
    PCNO E 10 A_FaceTarget
    PCNO F 8 Bright A_CustomMissile("InfernalCyberNobleRocket",32,20,0,0)
    PCNO E 10
    Goto See
  DTRailgun:
	PCNO E 4 Bright A_PlaySoundEx("monster/brusit","Voice")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTRailgunLoop:
    TNT1 A 0 A_SpawnItemEx("HellFireBaronFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PCNO E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
    Loop
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    PCNO EEE 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/dtrailf")
	TNT1 A 0 A_CustomMissile("PoweredDTRailCore",32,20,0)
    PCNO F 8 Bright A_CustomMissile("NoblePoweredDTRail",32,20,0,0)
    PCNO E 10
    Goto See
  Melee:
    PCNO PQ 7 A_FaceTarget
    PCNO R 7 A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"PainMissile")
    PCNO H 4 A_Pain
    Goto See
  PainMissile:
    PCNO H 4 A_Pain
    Goto Missile	
  XDeath:
  Death:
    PCNO I 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	PCNO JJJKKK 2 Bright A_CustomMissile ("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    PCNO L 4 Bright A_NoBlocking
    PCNO MN 3 Bright
    PCNO O -1
    Stop
  XRaise:
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    PCNO N 5
	PCNO MLKJI 5
	Goto See
  } 
}

Actor NoblePoweredDemonTech : PoweredDemonTechProjectile
{
  -THRUSPECIES
  Species "Nobles"
  DamageType "NobleComet"
}

Actor NoblePoweredDTRail : PoweredDTRail
{
  Species "Nobles"
  DamageType "NobleComet"
}

Actor EDarkCyberNobleGhostA : DarkCyberNobleGhostA
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    PCNO A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor EDarkCyberNobleGhostB : EDarkCyberNobleGhostA
{
  States
  {
  Spawn:
    PCNO B 2 A_FadeOut(0.18)
    Loop
   }
}

Actor EDarkCyberNobleGhostC : EDarkCyberNobleGhostA
{
  States
  {
  Spawn:
    PCNO C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor EDarkCyberNobleGhostD : EDarkCyberNobleGhostA
{
  States
  {
  Spawn:
    PCNO D 2 A_FadeOut(0.18)
    Loop
  }
}