Actor ImpureVile : Exile 17563
{
  //$Category Monsters/CF
  //$Sprite IMVIA1D1
  //$Title "Impure Vile"
  Obituary "$CFImpureVileObit"
  Health 1200
  Radius 20 
  Height 56 
  Mass 500
  Speed 18
  PainChance 5
  BloodColor "Black"
  DropItem "BossLifeEssence" 210
  DropItem "BossArmorBonusMax" 210
  DropItem "HellionRegen" 200 1
  DropItem "BigCFManaPickup" 128 100
  DropItem "OccultSpellbook" 16
  Monster
  +FLOORCLIP
  +NOTARGET
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOINFIGHTING
  SeeSound "ImpureVile/Sight" 
  PainSound "ImpureVile/Pain" 
  DeathSound "ImpureVile/Death" 
  ActiveSound "ImpureVile/Active"
  Tag "$CFImpVile"
  var int user_loop;
  States 
  { 
  Spawn: 
    IMVI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	IMVI A 10 A_Look 
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IMVI AABBCC 3 A_VileChase
	IMVI A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(82,"Rush")
    IMVI A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    IMVI AABBCC 2 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    IMVI DDEEFF 2 A_VileChase
    Loop
   Rush:
	TNT1 A 0 A_SpawnItemEx("IMVGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI A 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	IMVI A 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI B 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI B 1 A_VileChase		
	TNT1 A 0 A_SpawnItemEx("IMVGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI C 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI C 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI D 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI D 1 A_VileChase		
	TNT1 A 0 A_SpawnItemEx("IMVGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI E 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI E 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI F 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("IMVGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IMVI F 1 A_VileChase
	TNT1 A 0 A_JumpIfTargetinLOS("Missile")
	TNT1 A 0 A_Jump(32,"See")
	Loop
  Missile:
    TNT1 A 0 A_Jump(128,"Floorshits","ImpureSouls")
	TNT1 A 0 A_JumpIfCloser(896,2)
    TNT1 A 0 A_Jump(256,"Floorshits","ImpureSouls")
    TNT1 A 0 A_FaceTarget
    IMVI G 10 Bright A_PlaySound("exile/voidstart")
    IMVI H 8 Bright A_VileTarget("ImpureVileFire")
    IMVI IJKLMN 8 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
	TNT1 A 0 A_JumpIfTargetInLOS(2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_VileTarget("ImpureVileFire2")
    IMVI O 8 Bright A_VileAttack
    IMVI P 20 Bright
    Goto See
  Floorshits:
    IMV2 AABB 10 Bright A_FaceTarget 
    IMV2 C 0 A_CustomMissile("ImpureVileFloorshits",40,0,30)
    IMV2 C 0 A_CustomMissile("ImpureVileFloorshits",40,0,-30)
    IMV2 C 10 Bright A_CustomMissile("ImpureVileFloorshits",40,0,0)
    Goto See
  ImpureSouls:
    IMVI KLM 8 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ImpureSoulsLoop:
    IMVI N 5 Bright A_CustomMissile("ImpureVileSoul",34,0,frandom(-4,4))
	TNT1 A 0 A_FaceTarget
    IMVI O 5 Bright A_CustomMissile("ImpureVileSoul",34,0,frandom(-4,4))
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
    IMVI P 20 Bright
    Goto See
  Pain: 
    IMVI Q 5 
    IMVI Q 5 A_Pain 
    TNT1 A 0 A_Jump(256,"Rush")
    Goto See 
  XDeath:
  Death:
    IMVI Q 5
	IMVI Q 1 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    IMVI R 5 A_Scream
    IMVI S 5 A_Fall
    IMVI TUV 5
	IMVI W 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IMVI XY 4
    IMVI Z -1
    Stop
  Heal:
    IMV2 ABC 10 Bright
    Goto See
  } 
}

Actor SummonedImpureVile : ImpureVile { -COUNTKILL }

Actor ImpureVileFire : ExileFireFX
{
  Scale 1.5
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    BRD3 H 1 Bright A_PlaySoundEx("exile/voidsuck","Voice")
    BRD3 HGGHHGGHHGGFFEEFFEEFFEEDDEEDDEEDDCCDDCCDDCCBBCCBBCCBBBBAAAA 1 Bright A_Fire
	BRD3 B 1 Bright A_StopSoundEx("Voice")
	BRD3 C 1 Bright A_PlaySoundEx("exile/voidend","Voice")
	BRD3 DEFGH 1 Bright
	TNT1 A 20
    Stop
  }
}

Actor ImpureVileFire2 : ExileFireFX
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_PlaySound("brain/spit",1)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,0,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,40,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,80,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,120,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,160,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,200,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,240,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,280,0)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,320,0)
	TNT1 A 20
    Stop
  }
}

Actor ImpureVileSoul
{
  Speed 25
  Damage (Random(10,30)) //5
  Scale 0.35
  Radius 6
  Height 12
  RenderStyle Add
  Alpha 0.75
  BounceType Doom
  BounceCount 3
  Species "Viles"
  DamageType "VileFires"
  Projectile
  +STRIFEDAMAGE
  +SEEKERMISSILE
  +PIERCEARMOR
  SeeSound "Soul/Fire"
  DeathSound "Soul/Hit"
  States
  {
  Spawn:
	IMSO A 2 Bright
	TNT1 A 0 A_CustomMissile("ImpureVileSoulTrail",0,0,0)
	IMSO A 2 Bright
	TNT1 A 0 A_CustomMissile("ImpureVileSoulTrail",0,0,0)
	IMSO B 2 Bright
	TNT1 A 0 A_CustomMissile("ImpureVileSoulTrail",0,0,0)
	IMSO B 2 Bright
	TNT1 A 0 A_CustomMissile("ImpureVileSoulTrail",0,0,0)
	Loop
  Death:
	IMSO CCDDEEFFGGHHIIJJKKLL 2 Bright A_FadeOut(0.05)
	Stop
  }
}
Actor ImpureVileSoulTrail
{
  Projectile
  +CLIENTSIDEONLY
  +NOINTERACTION
  +CLIENTSIDEONLY
  Damage 0
  RenderStyle Add
  Alpha 0.45
  Scale 0.9
  States
  {
  Spawn:
	TNT1 A 2
	PUF6 BDFHJLNPRTVXZ 1
	PUF7 B 1 A_FadeOut(0.2)
	Wait
  }
}

Actor ImpureVileFloorShits      
{
  Projectile
  +DROPOFF
  -NOGRAVITY
  +FLOORHUGGER
  +SEEKERMISSILE
  Speed 23
  RenderStyle Add
  Alpha 0.8
  Scale 1.5
  Damage (Random(15,30)) //5
  Species "Viles"
  DamageType "VileFires"
  SeeSound "weapons/diasht"
  DeathSound "weapons/firex3"
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	FLFB C 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB C 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB D 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB D 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB C 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB C 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB D 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	FLFB D 1 Bright A_CustomMissile("ImpureVileFloorshitsTrail", 0, 0, 0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_SeekerMissile(5, 25)
	Loop
  Death:
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 A_Explode(90, 120)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, random(0,360), CMF_AIMDIRECTION, random(0,360))
	FLFB KLMNO 4
	Stop
  }
}

