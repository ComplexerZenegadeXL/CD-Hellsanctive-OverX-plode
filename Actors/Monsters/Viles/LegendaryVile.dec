Actor LegendaryVile : Archvile 17503
{
  //$Category Monsters/CF
  //$Sprite LVLLA1D1
  //$Title "Legendary Vile"
  Obituary "$CFLegendaryVileObit"
  Health 2000
  Speed 18
  Scale 1.15
  PainChance 40
  BloodColor "Blue"
  Species "Viles"
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.65
  DamageFactor "VileFires", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DropItem "LegendaryUltraSphere" 160
  DropItem "LegendarySalvationSphere" 160
  DropItem "LDemonAmmoBoxPickup" 256
  DropItem "LDemonAmmoPickup" 256
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 128
  //DropItem "LegendaryPlasmaticRifleGiver" 128
  DropItem "LegendaryRandomSphere" 16
  DropItem "VileStaffGiver", 64
  Tag "$CFLegVile"
  Monster
  +NORADIUSDMG
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +QUICKTORETALIATE
  +MISSILEMORE
  +MISSILEEVENMORE  
  +NOICEDEATH
  +DONTGIB
  +FASTMELEE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NOFEAR
  +NOTELEFRAG
  SeeSound "Legvile/Sight" 
  PainSound "Legvile/Pain" 
  DeathSound "Legvile/Death" 
  ActiveSound "Legvile/Active" 
  var int user_music;
  var int user_amount;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  var int user_loop;
  States 
  { 
  Spawn:
	LVLL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",10)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    LVLL A 10 Bright A_Look 
    Loop 
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("ArchVile",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LVLL AABB 2 A_VileChase
	LVLL A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,304)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(82,"Rush")
    LVLL A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
    LVLL AABBCCDDEEFF 2 Bright A_VileChase
	TNT1 A 0 A_Jump(48,"Teleport")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegVileGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_VileChase	
	LVLL A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL B 1 Bright A_VileChase		
	TNT1 A 0 A_SpawnItemEx("LegVileGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL D 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL D 1 Bright A_VileChase		
	TNT1 A 0 A_SpawnItemEx("LegVileGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL F 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegVileGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_VileChase
	LVLL F 1 Bright A_VileChase
	TNT1 A 0 A_JumpIfTargetinLOS("Missile")
	TNT1 A 0 A_Jump(28,"Teleport")
	TNT1 A 0 A_Jump(32,"See")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LVL2 A 1 Bright A_UnSetShootable
	LVL2 AAAAAABBBB 1 A_FadeOut(0.1,0)
	LVL2 B 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LVL2 B 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LVL2 BBBBBCCCCC 1 A_FadeIn(0.1)
    LVL2 C 1 Bright A_SetShootable
    Goto See
  Missile:
	TNT1 A 0 A_Jump(90,"LegKnightImitate1","LegImpImitate","LegSoulImitate","LegTormImitate")
    TNT1 A 0 A_Jump(50,"EffectVoid"/*,"FlanVoid"*/)
    TNT1 A 0 A_Jump(30,"VileSummon")
    TNT1 A 0 A_Jump(210,"LegFiendImitate","Skullshots","RipperStuff")
  BasicVoid:
    TNT1 A 0 A_FaceTarget
    LVLL G 10 Bright A_PlaySound("exile/voidstart")
    LVLL H 8 Bright A_VileTarget("LegVileFire1")
    LVLL IJ 8 Bright A_FaceTarget
	TNT1 A 0 A_JumpIfCloser(300,"TeleportVoid")
	TNT1 A 0 A_Jump(128,"TeleportVoid")
	LVLL KLMN 8 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BasicVoidLoop:
	TNT1 A 0 A_PlaySound("exile/voidend")
    LVLL O 4 Bright A_VileAttack("vile/stop",10,20,70,0.5,"Legendary")
    LVLL N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Goto BasicVoidLoop
    LVLL P 20 Bright
    TNT1 A 0 A_Jump(128,"Skullshots","RipperStuff")
    Goto See
  TeleportVoid:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 Bright A_UnSetShootable
	LVLL KKKKKKKKLL 1 Bright A_FadeOut(0.1,0)
	LVLL L 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TNT1 A 0 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LVLL LLLLMMMMMMMM 1 Bright A_FadeIn(0.1)
    TNT1 A 0 Bright A_SetShootable
    LVLL N 8 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TeleportVoidLoop:
	TNT1 A 0 A_PlaySound("exile/voidend")
    LVLL O 4 Bright A_VileAttack("vile/stop",10,20,70,0.5,"Legendary")
    LVLL N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Goto TeleportVoidLoop
    LVLL P 20 Bright
    TNT1 A 0 A_Jump(128,"Skullshots","RipperStuff")
    Goto See
  SkullShots:
	LVLL GHIJKLMN 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SkullShotsLoop:
	TNT1 A 0 A_FaceTarget
	LVLL O 6 Bright A_CustomMissile("LegVileSkullShot",34,0,frandom(-5,5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto SkullShotsLoop
	LVLL P 6 Bright
    TNT1 A 0 A_Jump(128,"BasicVoid","RipperStuff")
	Goto See
  RipperStuff:
	TNT1 A 0 A_PlaySound("Legvile/Attack2")
	LVLL GHIJKLMN 4 Bright A_FaceTarget
    LVLL OO 4 Bright A_FaceTarget
    LVLL BBBB 0 A_CustomMissile("LegVileRipperStuff",34,0,frandom(-20,20))
    LVLL OP 2 Bright A_FaceTarget
    LVLL BBBB 0 A_CustomMissile("LegVileRipperStuff",34,0,frandom(-20,20))
    LVLL PP 2 Bright A_FaceTarget
    LVLL BBBB 0 A_CustomMissile("LegVileRipperStuff",34,0,frandom(-20,20))
    LVLL PP 2 Bright A_FaceTarget
    LVLL BBBB 0 A_CustomMissile("LegVileRipperStuff",34,0,frandom(-20,20))
    Goto See
  LegImpImitate:
	TNT1 A 0 A_CustomMissile("LegVileLegImpGhost",0)
	TNT1 A 0 A_PlaySound("legimp/chargingsound")
	LVLL GHIJKLMN 10 Bright A_FaceTarget
	TNT1 A 0 A_playSound("legimp/fiyabetch")
	LVLL O 10 Bright A_CustomMissile("LegVileLegImpBall",34,0,0)
	LVLL P 10 Bright
	Goto See
  LegFiendImitate:
	TNT1 A 0 A_PlaySound("Legvile/Attack2")
	TNT1 A 0 A_CustomMissile("LegVileLegFiendGhost",0)
	LVLL GHIJKLMN 4 Bright A_FaceTarget
	LVLL OOOOOOOO 2 Bright A_CustomMissile("LegVileFiendBall",34,0,frandom(-5,5))
	LVLL PPPPPPPP 2 Bright A_CustomMissile("LegVileFiendBall",34,0,frandom(-5,5))
	Goto See
  LegKnightImitate1:
	TNT1 A 0 A_PlaySound("Legvile/Attack1")
	TNT1 A 0 A_CustomMissile("LegVileLegKnightGhost",0)
	LVLL GHIJKLMN 10 Bright A_FaceTarget
	LVLL O 10 Bright A_CustomMissile("LegNobleBall4",34,0,0)
	LVLL P 10 Bright
	Goto See
  LegSoulImitate:
	TNT1 A 0 A_PlaySound("Legvile/Attack1")
	TNT1 A 0 A_CustomMissile("LegVileLegSoulGhost",20)
	LVLL GHIJKLMN 6 Bright A_FaceTarget
	LVLL O 6 Bright A_CustomMissile("LegSoulBigBall",34,0,0)
	LVLL P 6 Bright
	LVLL GHIJKLMN 5 Bright A_FaceTarget
	LVLL O 5 Bright A_CustomMissile("LegSoulBigBall",34,0,0)
	LVLL P 5 Bright
	LVLL GHIJKLMN 4 Bright A_FaceTarget
	LVLL O 4 Bright A_CustomMissile("LegSoulBigBall",34,0,0)
	LVLL P 4 Bright
	Goto See
  LegTormImitate:
	TNT1 A 0 A_PlaySound("Legvile/Attack1")
	TNT1 A 0 A_CustomMissile("LegVileLegTormGhost",0)
	LVLL GHIJKLMN 6 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	LVLL OOOO 4 Bright A_CustomMissile("LegVileLaserBeam",34,0,0)
	TNT1 A 0 A_FaceTarget
	LVLL OOOO 4 Bright A_CustomMissile("LegVileLaserBeam",34,0,0)
	TNT1 A 0 A_FaceTarget
	LVLL OOOO 4 Bright A_CustomMissile("LegVileLaserBeam",34,0,0)
	TNT1 A 0 A_FaceTarget
	LVLL OOOO 4 Bright A_CustomMissile("LegVileLaserBeam",34,0,0)
	LVLL P 4 Bright
	Goto See
  FlanVoid:
	TNT1 A 0 A_PlaySound("Legvile/Attack2")
    LVLL G 10 Bright A_PlaySound("exile/voidstart")
    TNT1 A 0 Bright A_VileTarget("LegVileFire2FX")
    LVLL H 2 Bright A_VileTarget("LegVileFire2")
	LVLL IHIHIHIHIHIHIH 4 Bright
	Goto See
  EffectVoid:
    TNT1 A 0 A_FaceTarget
    LVLL G 10 Bright A_PlaySound("exile/voidstart")
	TNT1 A 0 A_GiveToTarget("LegVileVoidEffect1",1)
    LVLL H 16 Bright A_VileTarget("LegVileFire3")
    LVLL IJKLMN 16 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
    LVLL O 12 Bright A_VileAttack("vile/stop",20,70,70,0.5,"Legendary")
    LVLL P 20 Bright
    Goto See
  VileSummon:
    TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_JumpIf(user_amount > 3,"Missile")
    LVLL GG 7 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("Legvile/Attack1")
	LVLL HIHIHIHI 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,180,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,225,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,305,0)
	LVLL HIHIHIHI 4 Bright A_FaceTarget
  	TNT1 AAAAAAAA 0 A_CustomMissile("LegVileResRadius",8,0,frandom(0,360),0)
	TNT1 A 0 A_SetUserVar("user_amount",user_amount+1)
	LVLL HI 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Heal:
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HealLoop:
	TNT1 A 0 A_CustomMissile("LegVileResRadius",10,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
    LVL2 ABC 8 Bright
    Goto See
  Pain: 
  	TNT1 A 0 A_Jump(58,"Teleport")	
    LVLL Q 5 Bright
    LVLL Q 5 Bright A_Pain 
    TNT1 A 0 A_Jump(128,"Missile")
    TNT1 A 0 A_Jump(256,"Rush")
    Goto See 
  Death:
    LVLL Q 6 Bright A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LVLL R 5 Bright A_Scream
    LVLL S 5 Bright A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("LegendaryDust",random(4,6),256)
    LVLL TUV 5 Bright
	LVLL W 4 Bright A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LVLL XY 4 Bright
	LVLL Z 100
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,180,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,225,0)
	TNT1 A 0 A_SpawnItemEx("LegVileSpawners",0,0,20,30,0,0,305,0)
    LVLL Z -1
    Stop
  } 
}

Actor LegVileRipperStuff
{
  Radius 6
  Height 8
  Speed 35
  Damage (Random(6,12)) //2
  Projectile
  RenderStyle Add
  +RIPPER
  +NOTIMEFREEZE
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  Species "Viles"
  DamageType "Legendary"
  Alpha 0.8
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  States
  {
  Spawn:
	TNT1 A 0 A_Explode(5,80)
    TNT1 A 1 Bright A_SpawnItem("LegVileRipperStuffTrail")
    Loop
  Death:
    LVRI AIJKLMN 3 Bright
    Stop
  }
}

Actor LegVileRipperStuffTrail : BFG9500Trail
{
  Scale 0.8
  +NOTIMEFREEZE
  -CLIENTSIDEONLY
  -NOINTERACTION
  +NOGRAVITY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 1 A_Explode(5,80)
    LVRI ABCDEFGH 1 A_FadeOut(0.05)
	Stop
  }
}

Actor LegVileSkullShot
{
  Radius 6
  Height 8
  Speed 60
  Damage (Random(30,45)) //8
  Projectile 
  +SEEKERMISSILE
  +NOTIMEFREEZE
  +EXTREMEDEATH
  RenderStyle Add
  Species "Viles"
  DamageType "Legendary"
  Scale 1.2
  Alpha 0.8
  SeeSound "Soul/Fire"
  DeathSound "Painlord/Explode2"
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(5,5)
    IFX1 AA 1 Bright A_SpawnItemEx("BHellionSmoke",-10,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(5,5)
    IFX1 AA 1 Bright A_SpawnItemEx("BHellionSmoke",-10,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(5,5)
    IFX1 AA 1 Bright A_SpawnItemEx("BHellionSmoke",-10,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(5,5)
    IFX1 AA 1 Bright A_SpawnItemEx("BHellionSmoke",-10,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  Death:
	TNT1 A 0 A_Setscale(1.0)
	TNT1 A 0 A_Explode(30,100)
    LVSK ABCDEFGHIJKL 2 Bright A_Explode(10,100)
    Stop
  }
}


Actor LegVileFire1 : ExileFireFX
{
  Scale 1.8
  +NOTIMEFREEZE
  Species "Viles"
  DamageType "Legendary"
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
    LRD3 H 1 Bright A_PlaySoundEx("exile/voidsuck","Voice")
    LRD3 GGHHFFEEFFEEFFEEFFDDEEDDEEDDCCDDCCDDCCBBCCBBCCBBAAAA 1 Bright A_Fire
	LRD3 B 1 Bright A_Fire
  SpawnLoop:
	LRD3 B 1 Bright A_PlaySoundEx("exile/voidend","Voice")
	LRD3 CCBBCCB 1 Bright A_Fire
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Goto SpawnLoop
	LRD3 CDEFGH 1 Bright
	TNT1 A 20
    Stop
  }
}

Actor LegVileFire2 : ArchvileFire
{
  RenderStyle Add
  Scale 0.5
  Alpha 1
  +DONTSPLASH
  +NOTIMEFREEZE
  Species "Viles"
  DamageType "Legendary"
  States
  {
  Spawn:
    TNT1 A 0
    LMVI A 1 Bright A_PlaySoundEx("BFlan/Vile","Voice",1)
    LMVI ABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_Fire
    LMV0 AABBCCDD 1 Bright A_Fire
    LMVI ABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_Fire
    LMV0 AABBCCDD 1 Bright A_Fire
	LMVI A 1 Bright A_StopSoundEx("Voice")
	LMVI A 1 Bright A_PlaySoundEx("exile/voidend","Voice")
	TNT1 A 0 A_Explode(150,300,1)
	TNT1 A 0 Radius_Quake(5,15,0,20,0)
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("LegNecromancerBlueFlame1", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("LegNecromancerBlueFlame3", frandom(5, 55), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(-40, 70))
	LMVI BBCCDDEE 1 Bright
	TNT1 A 20
	TNT1 A 0 A_StopSoundEx("Voice")
    Stop
  }
}

Actor LegVileFire2FX : LegVileFire2
{
  +PIERCEARMOR
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
  SpawnLoop:
    TNT1 A 2 A_Fire
	TNT1 A 0 A_Explode(Random(1,3),64)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 60,1)
	Goto SpawnLoop
    TNT1 A 0
    Stop
  }
}

Actor LegVileFire3 : LegVileFire1
{
  +PIERCEARMOR
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("LegVile/Void1","Voice",1)
  SpawnLoop:
    TNT1 A 2 A_Fire
	TNT1 A 0 A_Explode(Random(1,3),64)
	TNT1 A 0 A_SpawnItem("LegVileFireSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 55,1)
	Goto SpawnLoop
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 A_PlaySoundEx("exile/voidend","Voice")
	TNT1 A 0 A_Explode(150,300,1)
	TNT1 A 0 Radius_Quake(5,15,0,20,0)
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("LegNecromancerBlueFlame1", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("LegNecromancerBlueFlame3", frandom(5, 55), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(-40, 70))
    Stop
  }
}

