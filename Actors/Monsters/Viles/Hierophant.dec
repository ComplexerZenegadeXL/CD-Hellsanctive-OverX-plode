  Species "Viles"
  DamageType "VileFires"
  States
  {
  Spawn:
	TNT1 A 0
	BXPO AB 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(16,60,0)
	BXPO CD 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(16,60,0)
	BXPO EF 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(16,60,0)
	BXPO GHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

