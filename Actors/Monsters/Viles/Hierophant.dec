Actor HierophantGhostA
{
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
