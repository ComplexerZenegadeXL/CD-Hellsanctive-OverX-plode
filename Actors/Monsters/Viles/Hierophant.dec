Actor Hierophant : Exile 17579
{
  //$Category Monsters/CF
  //$Sprite HPHAA1C1
  //$Title "Hierophant"
  Health 1500
  Radius 20
  Height 56
  Mass 1000
  Speed 20
  PainChance 10
  PainChance "Mine", 128
  PainChance "SoulToxic", 1
  PainChance "FatFlamer", 1
  PainChance "FiendFire", 1
  Obituary "$CFHierophantObit"
  HitObituary "$CFHierophantHitObit"
  +NOTARGET
  +FLOORCLIP
  +MISSILEMORE
  +NORADIUSDMG
  +FLOAT
  +NOGRAVITY
  +DONTHURTSPECIES
  SeeSound "Hierophant/Sight"
  PainSound "Hierophant/Pain"
  DeathSound "Hierophant/Death"
  MeleeSound "baron/melee"
  ActiveSound "Hierophant/Active"
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "BigCFManaPickup" 128 100
  DropItem "CFManaPickup" 256 30
  DropItem "CFManaPickup" 256 30
  DropItem "DemonicChaliceGiver" 32
  DropItem "FantasyStaffGiver" 50
  DropItem "HellStaffGiver" 128
  Tag "$CFHiero"
  var int user_missile;
  var int user_loop;
  States
  {
  Spawn: 
    HPHA A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HPHA A 10 A_Look 
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HPHA AABB 4 A_VileChase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    HPHA AABBAA 4 A_VileChase
    HPHA A 0 A_Jump(64,"Rush") 
	HPHA CCDDCC 4 A_VileChase
    HPHA A 0 A_Jump(64,"Rush") 
    Loop
  Rush:
    HPHA A 0 A_SpawnItemEx("HierophantGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA A 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA A 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA B 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA B 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA A 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA A 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA C 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA C 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA D 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA D 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA C 1 A_Chase
    HPHA A 0 A_SpawnItemEx("HierophantGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HPHA C 1 A_Chase
	TNT1 A 0 A_Jump(64,"See")
    Loop 
  Missile:
    HPHA A 0 A_FaceTarget
    HPHA A 0 A_Jump(256,"PLBalls","NonHomingHellStaff","Beam","FantasySeal")
  PLBalls:
    HPHA EF 7 Bright A_FaceTarget
    HPHA G 0 A_CustomMissile("HierophantPLBall",26,0,frandom(-6,-1),0) 
    HPHA G 7 Bright A_CustomMissile("HierophantPLBall",26,0,frandom(1,6),0)
    HPHA A 3 Bright
    HPHA HI 7 Bright A_FaceTarget
    HPHA J 0 A_CustomMissile("HierophantPLBall",26,0,frandom(-6,-1),0) 
    HPHA J 7 Bright A_CustomMissile("HierophantPLBall",26,0,frandom(1,6),0)
    HPHA A 3 A_SpidRefire
    HPHA A 0 A_Jump(64,"PLBalls")
    Goto See
  NonHomingHellStaff:
    TNT1 A 0 A_SpawnItemEx("HierophantRedSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA K 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantRedSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA L 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantRedSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA M 8 Bright A_FaceTarget 
	TNT1 A 0 A_SetUserVar("user_missile",0)	
  NonHomingHellStaffLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 25,"NonHomingHellStaffEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
    HPHA N 3 Bright A_CustomMissile("HierophantHellStaffBall1",32,0,random(-3,3))
	HPHA O 2 Bright
	Loop
  NonHomingHellStaffEnd:
    HPHA O 10 Bright
    HPHA L 10
    Goto See
  Beam:
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA K 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA L 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA M 8 Bright A_FaceTarget 
    TNT1 A 0 A_PlaySound("FantasyStaff/Fire",7) 
	TNT1 A 0 A_SetUserVar("user_missile",0)	
  BeamLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"BeamEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
    HPHA YYY 1 Bright A_CustomMissile("FantasyStaffBeam",32,0,0,0,0)
    TNT1 A 0 A_PlaySound("FantasyStaff/FireLoop",6)
	Loop
  BeamEnd:
    HPHA Z 10 Bright //add GLDefs to that sprite too
    HPHA L 10
    Goto See
  FantasySeal:
    TNT1 A 0 A_PlaySound("FantasyStaff/Charge",7)
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA K 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA K 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA L 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA L 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA M 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA M 8 Bright A_FaceTarget 
    TNT1 A 0 A_SpawnItemEx("HierophantBlueSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HPHA M 8 Bright A_FaceTarget 
    TNT1 A 0 A_PlaySound("FantasyStaff/Fire2",6)
    TNT1 A 0 A_PlaySound("FantasyStaff/Meltdown",7)
    HPHA Y 15 Bright A_CustomMissile("FantasySeal",32,0,0,0,0)
    HPHA Z 15 Bright
    HPHA L 10 
    Goto See
/*  Melee:
    HPHA EF 4 A_FaceTarget 
    HPHA G 3 A_MeleeAttack
    HPHA A 3 
    HPHA A 0 A_Jump(128,1)
    Goto See
    HPHA HI 4 A_FaceTarget 
    HPHA J 3 A_MeleeAttack
    HPHA A 3 
    Goto See */
  Pain: 
    HPHA P 2 
    HPHA P 2 A_Pain 
    Goto See 
  Heal:
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HealLoop:
	TNT1 A 0 A_CustomMissile("HellionResRadius",10,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
    HPHA ONNOMMLLLKKK 4 Bright	
    Goto See
  XDeath:
  Death: 
    HPHA Q 6  
    HPHA R 6 A_Scream 
    HPHA S 6 A_NoBlocking 
    HPHA TUVW 6
    HPHA X -1 A_SetFloorClip 
    Stop
  } 
}

Actor SummonedHierophant : Hierophant { -COUNTKILL }

Actor HierophantPLBall : PainlordBall
{
  Species "Viles"
  DamageType "VileFires"
  States
  {
  Death:
	ICE9 AAAAAA 0 Bright A_CustomMissile("HierophantBallSplitFire",0,0,frandom(0,360),CMF_TRACKOWNER,frandom(0,60))
	ICE9 A 2 Bright A_CustomMissile("HierophantBallSplitFire",0,0,frandom(0,360),CMF_TRACKOWNER,frandom(0,60))
    ICE9 BC 2 Bright
    ICE9 DEF 4 Bright
    Stop
  }
}

Actor HierophantBallSplitFire : PainlordBallSplitFire { Species "Viles" DamageType "VileFires" }

Actor HierophantRedSmokeSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAAAA 1 A_SpawnItemEx("CerebralImpFireBallFX",frandom(-30,30),frandom(-30,30),frandom(5,45),0,0,1)
    TNT1 A 1
    Stop
  }
}

Actor HierophantBlueSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAAAA 1 A_SpawnItemEx("PainlordBallTrail",frandom(-30,30),frandom(-30,30),frandom(5,45),0,0,1)
    TNT1 A 1
    Stop
  }
}

Actor HierophantHellStaffBall1 : CacoHellStaffBall1 { Species "Viles" DamageType "VileFires" }

Actor FantasySeal : FastProjectile
{
  Speed 80
  Radius 12
  Height 8
  Damage (Random(150,300)) //50
  +CANNOTPUSH
  +NODAMAGETHRUST
  +SPAWNSOUNDSOURCE
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  Scale 0.7
  Renderstyle Add
  Alpha 0.6
  Species "Viles"
  DamageType "VileFires"
  MissileType "FantasySealTrail"
  MissileHeight 8
  DeathSound "FantasyStaff/Explode"
  States
  {
  Spawn:
    TNT1 A 1
    Loop
  Death:
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,60,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,120,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,180,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,240,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion",0,0,300,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_CustomMissile("FantasySealExplosion2",0,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_SpawnItem("BlueProjExplodeLarge")
	TNT1 A 0 A_Explode(30,200)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HBlueProjParticleSuperLarge",0,0,0,frandom(-7,7),frandom(-7,7),frandom(-7,7),frandom(0,360))
    CLBB C 1 Bright A_FadeOut(0.2)
    Goto Death+7
  }
}

Actor FantasySealTrail : HellStaffParticle
{
  Scale 0.6
  States
  {
  Spawn:
	TNT1 A 0 A_Jump(220,"Spark")
    CLBA CCCCCCCCCCCCCCCCCCCC 1 Bright
    TNT1 A 0 Bright A_SetScale(0.55)
    TNT1 A 0 Bright A_FadeOut(0.1)
    CLBA C 1
    TNT1 A 0 Bright A_SetScale(0.5)
    TNT1 A 0 Bright A_FadeOut(0.1)
