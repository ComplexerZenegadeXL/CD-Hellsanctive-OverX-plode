	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AA 0 A_SpawnItemEx("PBlackSmokeTrailNormal",frandom(-20,20),frandom(-20,20),frandom(12,64),frandom(-1,1),frandom(-1,1),frandom(0,3),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 1 A_SpawnItemEx("PBlackSmokeTrailDark",frandom(-20,20),frandom(-20,20),frandom(12,64),frandom(-1,1),frandom(-1,1),frandom(0,3),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop	
  }
}


