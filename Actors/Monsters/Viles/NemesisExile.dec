Actor NemesisExileMagicSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmoke",frandom(12,-12),frandom(12,-12),frandom(12,20),0,0,frandom(8,12),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmoke",frandom(24,-24),frandom(24,-24),frandom(2,10),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

