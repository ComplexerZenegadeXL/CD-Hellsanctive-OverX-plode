Actor Velocirator : Exile 16564
{
  //$Category Monsters/LCA
  //$Sprite HIABA1D1
  //$Title "Velocirator Vile"
  Health 1450
  Speed 16
  DropItem "ModdedInvulnerabilitySphere" 55
  DropItem "BossLifeEssence" 210
  DropItem "BossArmorBonusMax" 210
  DropItem "HellionRegen" 200 1
  DropItem "DemonAmmoBoxPickup" 255 
  DropItem "ModdedGreenArmor" 180 1
  BloodColor "Green"
  DamageType "VileFires"
  DamageFactor "VileFires", 0.0
  DamageFactor "PoP15K", 0.0
  RadiusDamageFactor 0.6
  Obituary "$CFVelociratorObit"
  Monster
  PainChance 5
  +FLOORCLIP
  +NOTARGET
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOINFIGHTING
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +BRIGHT
  SeeSound "monster/velsit" 
  PainSound "monster/velpai"
  ActiveSound "monster/velact" 
  DeathSound "monster/veldie"
  Tag "$CFWeedVile"
  var int user_amount;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States 
  { 
  Spawn: 
    HIAB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",12)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	HIAB A 10 Bright A_Look 	
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HIAB AABBCC 2 Bright A_VileChase
	TNT1 A 0  A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",12)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_Jump(82,"Rush")
    HIAB A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	HIAB AABBCC 2 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	HIAB DDEEFF 2 Bright A_VileChase
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_Jump(16,"Teleport")
	Loop
  Rush:
    TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",12)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB A 1 Bright A_VileChase
    TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB D 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB D 1 Bright A_VileChase
    TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB F 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB F 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB D 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB D 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB E 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB F 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("HInfernoFX",0,0,0,0,0,0,0)
    HIAB F 1 Bright A_VileChase
	TNT1 A 0 A_Jump(12,"Teleport")
	TNT1 A 0 A_Jump(128,"See")
    Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	HIA2 A 1 Bright A_UnSetShootable
	HIA2 AAAAAAAAAA 1 A_FadeOut(0.1,0)
	HIA2 A 2
	HIA2 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    HIA2 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	HIA2 AAAAAAAAAA 1 A_FadeIn(0.1)
    HIA2 A 1 Bright A_SetShootable
    Goto See	
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(168,"Floor","SuperFloor","Ghost","Summon")
  Normal:
	TNT1 A 0 A_FaceTarget
	HIAB G 10 Bright A_VileStart
    HIAB H 8 Bright A_VileTarget("VeloMagicAttack")
    HIAB IJKLMN 8 Bright A_FaceTarget
	HIAB O 8 Bright A_VileAttack
    HIAB P 20 A_Jump(140,"Floor")
    Goto See
  Floor:
    HIA2 AAAA 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("velocirator/spell2")
	HIA2 B 0 A_CustomMissile("VeloFloorTracer",0,32,0)
    HIA2 B 6 Bright A_CustomMissile("VeloFloorTracer",0,-32,0)
    HIA2 CC 4 Bright A_FaceTarget	
	TNT1 A 0 A_Jump(140,"Ghost")
    Goto See
  SuperFloor:
    TNT1 A 0 A_SetUserVar("user_effect_type",5)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	HIA2 AAAA 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("monster/velsit")
	HIA2 AAAAAAAAAA 8 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("brain/spit")
	HIA2 BBBBB 0 A_CustomMissile("VeloFireSpawner",0,32,frandom(0,359))
	HIA2 B 0 A_CustomMissile("VeloFireSpawner",0,32,frandom(-3,3))
	HIA2 B 0 A_CustomMissile("VeloFireSpawner",0,32,0)
	HIA2 B 0 A_CustomMissile("VeloFireSpawner",0,-32,frandom(-3,3))
    HIA2 B 6 Bright A_CustomMissile("VeloFireSpawner",0,-32,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",12)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    HIA2 CC 4 Bright A_FaceTarget	
	HIA2 C 0 HealThing(150)
	TNT1 A 0 A_Jump(140,"Summon")
    Goto See
  Summon:
    TNT1 A 0 A_JumpIf(user_amount > 3,"Missile")
    HIAB GGGG 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("monster/velsit")
	HIAB HIHIHIHIHIHIHIHI 2 Bright
	TNT1 AAAAAAAAAA 0 A_SpawnItemEx("VeloSpawners",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	HIAB HIHIHIHIHIHIHIHI 2 Bright
  	TNT1 AAAAAAAA 0 A_CustomMissile("VelociratorResRadius",8,0,frandom(0,360),0)
	TNT1 A 0 A_SetUserVar("user_amount",user_amount+1)
	HIAB HIHIHI 2 Bright
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 HealThing(random(180,220))
    Goto See
  Ghost:
	TNT1 A 0 A_PlaySound("velocirator/spell1")
	HIAB O 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB P 3 Bright A_FaceTarget
	HIAB P 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB N 3 Bright A_FaceTarget
	HIAB N 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB O 3 Bright A_FaceTarget
	HIAB O 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB P 3 Bright A_FaceTarget
	HIAB N 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB O 3 Bright A_FaceTarget
	HIAB O 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB P 3 Bright A_FaceTarget
	HIAB P 5 A_CustomMissile("VeloGhost",38,0,frandom(-4,4))
    HIAB N 3 Bright A_FaceTarget
	HIAB P 5 Bright
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(21,"Teleport")
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",12)
	HIAB Q 2 Bright A_Pain 
	Goto See	
  Heal:
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HealLoop:
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_CustomMissile("VelociratorResRadius",10,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
    HIA2 ABC 16 Bright
	HIA2 C 0 HealThing(100)
    Goto See	
  XDeath:
  Death:
    TNT1 A 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HIAD R 6 A_Scream
    HIAD S 6 A_Fall
    HIAD TUVW 6 
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HIAD XY 4 
    HIAD Z -1 
    Stop   
  }
}
Actor GHellionSmoke
{
  +MISSILE
  +DONTSPLASH
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NOTIMEFREEZE
  Scale 0.4
  RenderStyle Normal
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A Random(5,7)
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    GMKE ABCDEFGHIJKL 2 Bright A_FadeOut
    Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor GHellionSmoke2 : GHellionSmoke { Scale 0.6 }

Actor GSoulSmoke : GHellionSmoke { Scale 0.12 }

Actor GHellionSmokeSpawner : LegendaryRedParticleSpawner
{
  States
  {
  Spawn:
	TNT1 A Random(5,7)
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("GHellionSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}
Actor HInfernoFX : ExileFX
{   
  States
  {
  Spawn: 
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    HIAB ABCDEF 2 Bright A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
   }
}

Actor VeloMagicAttack : IFire
{
  Scale 1.15
  RenderStyle Translucent
  Alpha 0.75
  Species "Viles"
  DamageType "VileFires"
  +FORCERADIUSDMG
  Obituary "$CFVeloMagicAttackObit"
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
    HFIR A 1 Bright A_PlaySoundEx("necghost/active","Voice",1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop:
	TNT1 A 0 A_SpawnItemEx("VeloSmokeAttackSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HFIR A 1 Bright A_Explode(Random(1,3)*2,62)
	TNT1 A 0 A_SpawnItemEx("VeloSmokeAttackSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 Bright A_Explode(Random(1,3)*2,62)
    HFIR B 2 Bright A_Fire
	TNT1 A 0 A_SpawnItemEx("VeloSmokeAttackSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 Bright A_Explode(Random(1,3)*2,62)
    HFIR C 2 Bright A_Fire	
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto SpawnLoop
	TNT1 A 1 A_StopSoundEx("Voice")
	TNT1 A 1 A_PlaySound("exile/voidend")
    Stop
  }
}

Actor VeloSmokeAttackSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("GHellionSmoke2",frandom(-12,12),frandom(-12,12),frandom(12,20),0,0,frandom(8,12),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("GHellionSmoke2",frandom(-24,24),frandom(-24,24),frandom(2,10),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor VeloFloorTracer : DukeFireSpawner
{
  Speed 25
  FastSpeed 30
  Damage (Random(30,60)) //10
  Species "Viles"
  DamageType "VileFires"
  Species "Vile"
  Obituary "$CFVeloFloorTracerObit"
  ReactionTime 255
  +SEEKERMISSILE
  States
  {
  Spawn: 
	TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_CountDown
	TNT1 A 0 A_SpawnItemEx("VeloFloorFire")
	TNT1 A 2 A_SeekerMissile(15,15)
	Loop  
  Death:
    TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("Kaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    FTRD K 4 Bright
    FTRD L 4 Bright A_Explode(32,86)
    FTRD MNO 3 Bright
    Stop
  }
}

Actor VeloFloorFire : DukeFire
{
  Species "Viles"
  DamageType "VileFires"
  Obituary "$CFVeloFloorFireObit"
}

Actor VeloFire : PyroFire
{
  Damage (Random(40,60)) //11
  Obituary "$CFVeloFireObit"
  Species "Viles"
  DamageType "VileFires"
  States
  {
  Spawn:
    XBF2 AB 2 Bright
    XBF2 C 2 Bright A_Explode(34,106,0)
    XBF2 DEFGHIJKLMNOPQRST 2 Bright
    Stop       
  }
}

Actor VeloFireSpawner : PyroFireSpawner
{
  Species "Viles"
  DamageType "VileFires"
  Obituary "$CFVeloFireSpawnerObit"
  Projectile
  States
  {
  Spawn: 
    TNT1 AAAA 1 Bright A_Weave(3,0,1.0,0.0)
	TNT1 A 1 Bright A_CustomMissile("VeloFire",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Loop
  Death:  
    TNT1 A 1
    Stop
  }
}

Actor VeloSpawners
{
  Radius 12
  Height 8
  Speed 17
  Monster
  -SHOOTABLE
  -COUNTKILL
  -SOLID
  var int user_limit;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SetAngle(frandom(0,360))
	TNT1 A 1 A_Recoil(-40)
	TNT1 A 0 A_JumpIf(user_limit > 3,"Death")
	TNT1 A 0 A_SetUserVar("user_limit",user_limit+1)
	TNT1 A 1 A_Recoil(-4)
	TNT1 A 2 A_Jump(48,"Death")
    Goto Spawn+3
  Death:
    TNT1 A 0 A_SpawnItemEx("TeleportFog")
    TNT1 A 5 A_SpawnItemEx("VeloMinions")
	TNT1 A 1 A_Fall
	Stop
  }
}

Actor VeloMinions : RandomSpawner
{
  DropItem "SummonedImp", 256, 47
  DropItem "SummonedVoidImp", 256, 24
  DropItem "SummonedDevil", 256, 13
  DropItem "SummonedBullFiend", 256, 10
  DropItem "SummonedCyberFiend", 256, 6
}

Actor VeloGhost
{
  Speed 38
  Radius 6
  Height 6
  Damage 13
  RenderStyle "Translucent"
  Alpha 0.75
  SeeSound "weapons/spirit1"
  DeathSound "veloghost/death"
  DamageType "VileFires"
  Projectile
  States
  {
  Spawn:
	SPI2 ABABABABAB 2 Bright A_SpawnItemEx("GHellionSmoke")
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(16,48,0)
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SPI2 EFGHIJ 3 Bright 
	Stop
  }
}

Actor VelociratorResRadius
{
  Radius 8
  Height 4
  Speed 25
  Projectile
  +NORADIUSDMG
  +ISMONSTER
  +INVULNERABLE
  +THRUACTORS
  +FLOORHUGGER
  +NOCLIP
  -COUNTKILL
  +HITMASTER
  States
  {
  Spawn:
	TNT1 AAAAAAAAAA 2 A_VileChase
	Stop
  Heal:
	TNT1 A 0 A_ChangeFlag("NOCLIP",0)
	TNT1 A 0 A_ChangeFlag("THRUACTORS",0)
  Death:
	TNT1 A 1
	//TNT1 A 0 ACS_NamedExecuteWithResult("CheckPointers")
	Stop
  }
}