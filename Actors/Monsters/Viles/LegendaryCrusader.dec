Actor LegendaryCrusader : DeathKnight
{ 
  Health 3000
  Scale 1.15
  Speed 18
  MeleeDamage 40
  MeleeRange 100
  BloodColor "Blue"
  DamageType "Legendary"
  DamageFactor 0.5
  DamageFactor "VileFires", 0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  +NOTIMEFREEZE
  +SHIELDREFLECT
  +NOICEDEATH
  +NOTELEFRAG
  DropItem "LegendaryUltraSphere" 160
  DropItem "LegendarySalvationSphere" 160
  //DropItem "LegendarySaberGiver" 180
  DropItem "LDemonAmmoBoxPickup" 256
  DropItem "LDemonAmmoPickup" 256
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFLegendaryCrusaderObit"
  HitObituary "$CFLegendaryCrusaderHitObit"
  SeeSound "LegendaryCrusader/Sight" 
  PainSound "LegendaryCrusader/Pain" 
  DeathSound "LegendaryCrusader/Death" 
  //ActiveSound "monster/dknact" 
  Tag "$CFLegCrus"
  var int user_music;
  var int user_faminelimit;
  var int user_legrevlimit;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States 
  { 
  Spawn:
    LGCR A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",10)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
  Idle:
	LGCR A 10 Bright A_Look 
	Loop 
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LGCR AABB 3 A_VileChase
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Walk")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,735)
	TNT1 A 0 A_SetUserVar("user_music",1)
	LGCR A 0 A_UnSetReflective
	TNT1 A 0 A_RadiusGive("Health",500,RGF_MONSTERS,3)
	LGCR AABB 3 Bright A_VileChase
	TNT1 A 0 A_Jump(32,"Rush","Teleport")
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Walk")
	LGCR CCDD 3 Bright A_VileChase
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Walk")
	TNT1 A 0 A_Jump(32,"Rush","Teleport")
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostA")
	TNT1 A 0 A_VileChase
	LGCR A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostA")
	TNT1 A 0 A_VileChase	
	LGCR A 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostB")
	TNT1 A 0 A_VileChase
	LGCR B 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostB")
	TNT1 A 0 A_VileChase
	LGCR B 1 Bright A_VileChase	
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Walk")	
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostC")
	TNT1 A 0 A_VileChase
	LGCR C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostC")
	TNT1 A 0 A_VileChase
	LGCR C 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostD")
	TNT1 A 0 A_VileChase
	LGCR D 1 Bright A_VileChase
	TNT1 A 0 A_SpawnItemEx("LegendaryCrusaderGhostD")
	TNT1 A 0 A_VileChase
	LGCR D 1 Bright A_VileChase	
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Walk")	
	TNT1 A 0 A_Jump(28,"Teleport")
	TNT1 A 0 A_Jump(32,"See")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LGCR EA 1 Bright A_UnSetShootable
	LGCR EEEEEEEEE 1 A_FadeOut(0.1,0)
	LGCR E 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LGCR E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LGCR EEEEEEEEEE 1 A_FadeIn(0.1)
    LGCR E 1 Bright A_SetShootable
    Goto See
  Melee:
	LGCR E 5 A_FaceTarget
	LGCR F 1 A_Playsound("monster/dknswg")
	LGCR F 4 A_FaceTarget
	LGCR G 5 A_MeleeAttack 
	Goto See
  Missile:
	//TNT1 A 0 A_Jump(128,2)
	//TNT1 A 0 A_JumpIfCloser(300,"MeleeLunge")
  MissileContinue:
	TNT1 A 0 A_Jump(16,"Soulless")
	TNT1 A 0 A_Jump(256,"Darts1","Darts2","Bolts","Ripper","RazorWind")
	Goto See
  Darts1:
	LGCR E 6 Bright A_FaceTarget
	LGCR F 6 Bright A_Playsound("monster/kntswg")
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,6)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,3)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,0)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,-3)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,-6)
	Goto See
  Darts2:
	LGCR E 6 Bright A_FaceTarget
	LGCR F 6 Bright A_Playsound("monster/kntswg")
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,-6)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,-3)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,0)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,3)
	LGCR G 1 Bright A_CustomMissile("CrusaderDart",32,0,6)
	Goto See
  Bolts:
	TNT1 A 0 A_SetReflective
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BoltsLoop:
	LGCR T 2 Bright A_FaceTarget	
    LGCR U 2 Bright A_CustomMissile("CrusaderBolt",58,-4,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_UnSetReflective
	Goto See
  Ripper:
	TNT1 A 0 A_SetReflective
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RipperLoop:
	LGCR T 2 Bright A_FaceTarget	
    LGCR U 2 Bright A_CustomMissile("CrusaderRipper",58,-4,frandom(-6,6),0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,1)
	Loop
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_UnSetReflective
	Goto see
  RazorWind:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RazorWindLoop:
	LGCR E 6 Bright A_FaceTarget
	LGCR F 6 Bright A_Playsound("monster/kntswg")
	LGCR G 6 Bright A_CustomMissile("CrusaderRazorWind",32)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	TNT1 A 0
	Goto See
  Soulless:
	TNT1 A 0 A_JumpIf(user_faminelimit >= 5,"MissileContinue")
	TNT1 A 0 A_SetUserVar("user_faminelimit",user_faminelimit+1)
  SoullessSummon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LGCR EE 3 Bright A_FaceTarget 
	LGCR E 8 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegendarySoulless",50,50,20,0,0,0,frandom(0,360),SXF_SETMASTER,0)
	TNT1 A 0 A_PlaySound("LegendaryCrusader/Sight")
	TNT1 A 0 A_SpawnItemEx("LegCrusaderHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	LGCR E 25 Bright 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_Jump(80,"AOEHeal")
	Goto See
  AoeHeal:
	TNT1 A 0 A_Radiusgive("CrusaderBuffHealth",1000,RGF_MONSTERS)
	TNT1 A 0 A_SpawnItemEx("LegCrusaderHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	LGCR E 20 Bright A_PlaySound("LegendaryCrusader/Sight",0,1000)
	Goto see
  RaiseChildren:
	LGCR E 20 Bright A_PlaySound("LegendaryCrusader/Attack",0,1000)
	TNT1 A 0 A_RaiseChildren
	Goto See
  Heal:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HealLoop:
	TNT1 A 0 A_CustomMissile("CrusaderResRadius",10,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 17,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
	TNT1 A 0 A_SpawnItemEx("LegCrusaderHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	LGCR E 20 Bright A_PlaySound("LegendaryCrusader/Sight",2)
	TNT1 A 0 A_RadiusGive("CrusaderBuffLegResistance",1000,RGF_MONSTERS)
	TNT1 A 0 A_Jump(64,"BuffResurrected","AOEHeal")
	Goto See
  BuffResurrected:
	LGCR A 10 Bright
	TNT1 A 0 A_RadiusGive("CrusaderBuffAlwaysFast",2000,RGF_MONSTERS)
	TNT1 A 0 A_SpawnItemEx("LegCrusaderHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	LGCR E 20 Bright A_PlaySound("LegendaryCrusader/Attack",0,1.0,0,ATTN_NONE)
	Goto See
  Pain:
	LGCR H 2 
	LGCR H 2 A_Pain
	Goto See
  Death.PlayerIce:
  XDeath:
  Death:
	LGCR I 0 A_CustomMissile("CrusaderDeathSword",44,32,-90,0)
	LGCR I 8 Bright A_CustomMissile("CrusaderDeathShield",44,-32,90,0)
	TNT1 AAA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",frandom(-10,10),frandom(-10,10),frandom(30,60),frandom(0,5),frandom(0,5),frandom(0,5))
	TNT1 AAA 0 A_CustomMissile("LegBlueKaboomNoEffect",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LGCR J 8 Bright A_Scream 
	TNT1 AAA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",frandom(-10,10),frandom(-10,10),frandom(30,60),frandom(0,5),frandom(0,5),frandom(0,5))
	TNT1 AAA 0 A_CustomMissile("LegBlueKaboomNoEffect",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LGCR K 8 Bright
	TNT1 AAA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",frandom(-10,10),frandom(-10,10),frandom(30,60),frandom(0,5),frandom(0,5),frandom(0,5))
	TNT1 AAA 0 A_CustomMissile("LegBlueKaboomNoEffect",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",40,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LGCR L 8 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 A_DropItem("LegendaryDust",random(4,6),256)
	LGCR MN 8 Bright A_KillChildren
	LGCR O -1 
	Stop 
  } 
}

Actor LegCrusaderHealEffect : VileHealEffect
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 20 A_SpawnItemEx("LegCrusaderResFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor LegCrusaderResFlame : DukeHealFlame
{
  Scale 0.45
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	BMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor LegCrusaderResFlameSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 AAAAAAAA 2 A_SpawnItemEx("LegCrusaderResFlame",frandom(-12,12),frandom(-12,12),0,0,0,frandom(2,4),0,SXF_CLIENTSIDE,0)
    Stop
  }
}

Actor CrusaderResRadius : DeathKnightResRadius { +NOTIMEFREEZE }

Actor CrusaderDart : DKDart
{
  Speed 25
  Damage (Random(40,70)) //12
  Species "Viles"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +THRUSPECIES
  +EXTREMEDEATH
  States
  {
  Spawn:
	LCAT ABC 2 Bright A_SpawnItemEx("CrusaderDartTrail",-10)
	loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LCAT D 0 A_SetTranslucent (0.85,1)
	LCAT D 3 Bright A_Explode(32,64)
	LCAT EFGHIJKLM 3 Bright
	Stop
  }
}

Actor CrusaderDartTrail : ImpBallTrail
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LCAT ABC 1 A_FadeOut(0.25)
	Loop
  }
}

Actor CrusaderBolt : DKbolt
{
  Speed 25
  Damage (Random(50,70)) //15
  Species "Viles"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +SEEKERMISSILE
  +EXTREMEDEATH
  States
  {
  Spawn:
	TNT1 A 0 A_SpawnItemEx("CrusaderBoltTrail")
	TNT1 A 0 A_SeekerMissile(1,1)
	LBOL A 1 Bright A_BishopMissileWeave
	loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LHBA EFHI 2 Bright
	Stop
  }
}

Actor CrusaderBoltTrail : ImpBallTrail
{
  RenderStyle Add
  Alpha 1
  Scale 0.25
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
   TNT1 A 0
   TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
   BMKE ABCDEFGHIJK 1 Bright A_FadeOut
   Stop
  }
}

Actor CrusaderRipper : LegArchonRipper
{
  Species "Viles"
  DamageType "Legendary"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    ICE9 P 0 A_SetTranslucent (0.75,1)
    ICE9 A 2 Bright A_Explode(64,64,1)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,0,0,0)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,60,0,0)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,120,0,0)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,180,0,0)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,240,0,0)
    ICE9 P 0 A_SpawnItemEx("CrusaderRipperSpike",0,0,0,50,0,0,300,0,0)
    ICE9 BCDEF 2 Bright
    Stop
  }
}

Actor CrusaderRipperSpike : LegArchonRipperSpike { Species "Viles" DamageType "Legendary" }

Actor CrusaderRazorWind
{
  RenderStyle Add
  Alpha 0.95
  Radius 10
  Height 2
  Speed 60
  Damage (Random(15,30)) //5
  Species "Viles"
  DamageType "Legendary"
  DeathSound "Claw/Hit"
  Projectile
  +FORCERADIUSDMG
  +RIPPER
  +THRUACTORS
  +PIERCEARMOR
  +EXTREMEDEATH
  +FOILINVUL
  +DONTREFLECT
  +NOTIMEFREEZE
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_Jump(64,2)
	TNT1 A 0 A_Explode(64,90,0)
	TNT1 A 0 A_SetUserVar("user_loop",2)
	TNT1 A 1 Light("LegImpSeekBallExplode3") A_SpawnItemEx("CrusaderRazorWindTrail",0,0,2)
  SpawnLoop:
    TNT1 A 0 A_SpawnItemEx("CrusaderRazorWindTrail", (user_loop *velx)/-30.0, -(user_loop *vely)/-30.0, 2+(user_loop *velz)/-30.0, 0,0,0, 0, SXF_ABSOLUTEANGLE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 2)
	TNT1 A 0 A_JumpIf(user_loop > 26,2)
	TNT1 A 0 A_Jump(256,"SpawnLoop")
	TNT1 A 0
    Goto Spawn
  Death:
    TNT1 A 1
    Stop
  }
}

Actor CrusaderRazorWindTrail : RazorWindTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	LCSL A 1 A_Fadeout(0.2)
	Loop
  Vanilla:
    TNT1 A 0
	Stop			
  }
}

Actor CrusaderDeathSword : DKSword
{  
  +NOTIMEFREEZE
  States
  {
  Spawn:
	LSWD KLMNOPQ 3 Bright
	Goto Death
  Death:
	LSWD RS 4 Bright
	LSWD T 4 Bright
	LSWD U 4
	LSWD T 4 Bright
	LSWD U 8
	LSWD T 4 Bright
	LSWD U 16
	LSWD T 4 Bright
	LSWD U -1
	Stop
  }
}

Actor CrusaderDeathShield : DKShield
{  
  +NOTIMEFREEZE
  States
  {
  Spawn:
	LSHI ABCDEFGHI 3
	Goto Death
  Death:
	LSHI H -1
	Stop
  }
}

Actor CrusaderBuff : CustomInventory
{
  +NOTIMEFREEZE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.IGNORESKILL
  States
  {
  Spawn:
	TNT1 A 1
	Stop
  Nope:
	TNT1 A 0
	Stop
  }
}

Actor CrusaderBuffHealth : CrusaderBuff
{
  States
  {
  Pickup:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("GHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_GiveInventory("Health",200)
	Stop
  }
}

Actor CrusaderBuffLegResistance : CrusaderBuff
{
  States
  {
  Pickup:
	TNT1 A 1
	TNT1 A 0 A_JumpIfInventory("CrusaderBuffLegResistanceCheck",1,"Null")
	TNT1 A 0 A_GiveInventory("CrusaderBuffLegResistanceCheck")
	TNT1 A 0 A_GiveInventory("CrusaderPowerLegProtection")
	TNT1 A 0 ACS_NamedExecuteAlways("LegCrusaderLegResistance")
	Stop
  }
}
Actor CrusaderBuffLegResistanceCheck : Inventory {}
Actor CrusaderBuffLegResistanceEffectSpawner : LHellionSmokeSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("CrusaderBoltTrail",0,0,0,0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 
	TNT1 A 1
	Stop	
  }
}
Actor CrusaderLegProtection : PowerProtection
{
  DamageFactor "Legendary", 0
  DamageFactor "PlayerLegendary", 0.0
