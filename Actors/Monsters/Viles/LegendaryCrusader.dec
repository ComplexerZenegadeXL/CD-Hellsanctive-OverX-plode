Actor LegSoullessTracer : FamineTracer
{
  Speed 15
  FastSpeed 20
  Renderstyle Add
  Alpha 0.9
  +NOTIMEFREEZE
  Species "Viles"
  DamageType "Legendary"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(64,"Homing")
  Normal:
    IMSO AB 2 Bright
	Loop
  Homing:
	TNT1 A 0 A_Jump(128,1,3,5,7,9)
    IMSO ABABABABAB 2 Bright
	Goto StartSeek
  StartSeek:
    TNT1 A 0 A_SpawnItemEx("LegSoullessTracerTrail") 
    IMSO A 2 Bright	A_Tracer2
	IMSO B 2 Bright A_SpawnItemEx("LegSoullessTracerTrail") 
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetScale(0.75)
	IMSO CDEFGHIJKL 2 Bright A_FadeOut(0.05)
    Stop
    }
}

