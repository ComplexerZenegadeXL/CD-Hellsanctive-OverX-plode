Actor LegendaryCrusaderGhostA
{
  Scale 1.15
  RenderStyle Translucent
  Alpha 0.7
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	LGCR A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor LegendaryCrusaderGhostB : LegendaryCrusaderGhostA
{
  States
  {
  Fade:
	LGCR B 2 A_FadeOut(0.1,1)
	Loop
  }
}

