Actor ESoul : TerrorSoul
{ 
  Obituary "$CFESoulObit"
  Health 80
  Radius 16
  Height 56 //32
  Mass 400
  Speed 5
  Damage (Random(10,15)) //7
  DamageType "VileFires"
  Species "Viles"
  DamageFactor "VileFires", 0
  DamageFactor "NobleComet", 0
  DamageFactor "CadaverRocket", 0
  DamageFactor "CacoComet", 0
  DamageFactor "BeheComet", 0
  DamageFactor "Baby15K", 0
  DamageFactor "Cyber10K", 0
  DamageFactor "Masterminds", 0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  PainChance 128
  Renderstyle Add
  Alpha 0.4
  AttackSound "skull/melee"
  PainSound "nightmare/pain"
  DeathSound "nightmare/death"
  ActiveSound "nightmare/active"
  Monster
  Tag "$CFEtheSoul"
  +THRUSPECIES
  +FLOAT
  +NOGRAVITY
  +NOICEDEATH
  +MISSILEMORE
  +DONTFALL
  //+STEALTH
  +NOBLOOD
  -COUNTKILL
  States
  {
  Spawn:
    ETHS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ETHS ABCD 10 Bright A_Look
    Loop
  See:
    ETHS ABCD 6 Bright A_Chase 
    Loop
  Melee:
  Missile:
    ETHS C 6 Bright A_FaceTarget
    ETHS E 6 Bright A_SkullAttack(15)
    //ETHS EF 6 Bright
	//Goto Missile+2
    ETHS F 6 Bright A_SkullAttack(15)
    ETHS F 0 A_FaceTarget
    ETHS E 6 Bright A_SkullAttack(15)
    ETHS E 0 A_FaceTarget
    ETHS F 6 Bright A_SkullAttack(15)
    Goto See
  Pain:
    ETHS G 3 Bright
    ETHS G 3 Bright A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    ETHS F 3 Bright 
    ETHS H 3 Bright A_ScreamAndUnblock
    ETHS IJKLMNO 3 Bright
    Stop
  }
}

Actor MeleeRevenant
{
  Health 125
  Radius 20
  Height 56
  Mass 500
  Speed 10
  PainChance 100
  Monster
  Scale 0.8
  MeleeThreshold 60
  +MISSILEMORE 
  +FLOORCLIP
  -COUNTKILL
  Species "Viles"
  DamageType "VileFires"
  DamageFactor "VileFires", 0
  DamageFactor "NobleComet", 0
  DamageFactor "CadaverRocket", 0
  DamageFactor "CacoComet", 0
  DamageFactor "BeheComet", 0
  DamageFactor "Baby15K", 0
  DamageFactor "Cyber10K", 0
  DamageFactor "Masterminds", 0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  SeeSound "skeletons/sight"
  PainSound "monsters/guardianpain"
  DeathSound "skeleton/death"
  ActiveSound "skeleton/active"
  MeleeSound "skeleton/melee"
  HitObituary "$OB_UNDEADHIT" // "%o was punched by a revenant."
  Tag "$CFMeleeRev"
  States
  {
  Spawn:
    ZKEL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ZKEL A 10 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    ZKEL AAABBBCCC 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	ZKEL DDDEEEFFF 2 A_Chase
    Loop
  Melee:
    ZKEL G 1 A_FaceTarget
    ZKEL G 6 A_SkelWhoosh
    ZKEL H 0 A_FaceTarget
    ZKEL H 2 A_Recoil(-3)
    ZKEL H 0 A_FaceTarget
    ZKEL H 2 A_Recoil(-4)
    ZKEL H 0 A_FaceTarget
    ZKEL H 2 A_Recoil(-4 )
    ZKEL I 6 A_SkelFist
    Goto See
  Missile:
	TNT1 A 0 A_JumpIfCloser(275,1)
	Goto See
	TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-40)
    TNT1 A 0 A_SkelWhoosh	
	ZKEL GGGGG 1 A_SpawnItemEx("MeleeRevDashGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	ZKEL HHHHH 1 A_SpawnItemEx("MeleeRevDashGhostA2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("MeleeRevDashPunch",32,0,0,CMF_AIMDIRECTION)
	ZKEL III 1 A_SpawnItemEx("MeleeRevDashGhostA3",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	ZKEL I 2 A_Stop	
    Goto See
  Pain:
    ZKEL L 5
    ZKEL L 5 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    TNT1 A 0 A_JumpIfInventory("HesDeadJim",1,"Death2")
	ZKEL LM 7
    ZKEL N 7 A_Scream
    ZKEL O 7 A_NoBlocking
    ZKEL P 7 A_SpawnItemEx("BodyCrash",0,0,0,0)
  Death2:
	ZKEL Q -1
    Stop
  Raise:
    TNT1 A 0 A_JumpIfMasterCloser(256,4)
	TNT1 A 0 A_GiveInventory("HesDeadJim",1)
	TNT1 A 0 A_ChangeFlag("SOLID",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CF_SetHealth")
	Goto Death2
	TNT1 A 0 A_TakeInventory("HesDeadJim",1)
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
    TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    ZKEL Q 5
    ZKEL PONML 5
    Goto See
  }
}

Actor MeleeRevDashGhostA
{
  Scale 0.8
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    ZKEL G 2 A_FadeOut(0.18)
    Loop
  }
}

Actor MeleeRevDashGhostA2 : MeleeRevDashGhostA
{
  States
  {
  Spawn:
    ZKEL H 2 A_FadeOut(0.18)
    Loop
  }
}

Actor MeleeRevDashGhostA3 : MeleeRevDashGhostA
{
  States
  {
  Spawn:
    ZKEL I 2 A_FadeOut(0.18)
    Loop
  }
}


Actor MeleeRevGhost : MeleeRevDashGhostA
{
  States
  {
  Spawn:
    ZKEL A 2 A_FadeOut(0.12)
    Loop
  }
}

Actor MeleeRevDashPunch : FastProjectile
{
  Height 16
  Radius 18
  Speed 50
  Damage (4*Random(4,8))
  Species "Viles"
  DamageType "VileFires"
  SeeSound ""  
  DeathSound "skeleton/melee"  
  +THRUSPECIES
  States
  {
  Spawn:
    TNT1 A 0
    Stop
  Death:
    TNT1 A 1
    Stop
  }
}


Actor Ghoul 30123 
{ 
  Health 400 
  PainChance 24
  Speed 9 
  Radius 24 
  Height 56 
  Mass 320
  MeleeDamage 8
  Monster
  Species "Viles"
  DamageType "VileFires"
  DamageFactor "VileFires", 0
  DamageFactor "NobleComet", 0
  DamageFactor "CadaverRocket", 0
  DamageFactor "CacoComet", 0
  DamageFactor "BeheComet", 0
  DamageFactor "Baby15K", 0
  DamageFactor "Cyber10K", 0
  DamageFactor "Masterminds", 0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  BloodColor "20 60 20"
  +FLOORCLIP
  +MISSILEMORE
  +DONTHURTSPECIES
  +THRUSPECIES
  -COUNTKILL
  Obituary "$CFRMGhoulObit"
  HitObituary "$CFRMGhoulHitObit"
  SeeSound "monster/ghlsit" 
  MeleeSound "monster/ghlhit" 
  PainSound "monster/ghlpai" 
  DeathSound "monster/ghldth" 
  ActiveSound "monster/ghlact"
  Tag "$CFRmGhoul"
  States 
  { 
  Spawn: 
    GHUL P 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    GHUL A 10 A_Look 
    Loop 
  See: 
    GHUL AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHUL CCDD 2 A_Chase 
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop 
  Melee:
    GHUL E 0 A_Jump(128,5)
    GHUL E 6 A_FaceTarget
    GHUL F 0 A_PlaySound("monster/ghlswg")
    GHUL F 6 A_FaceTarget
    GHUL G 6 A_MeleeAttack
    Goto See
    GHUL R 6 A_FaceTarget
    GHUL S 0 A_PlaySound("monster/ghlswg")
    GHUL S 6 A_FaceTarget
    GHUL T 6 A_MeleeAttack
    Goto See
  Missile:
    GHUL Q 10 A_FaceTarget 
    GHUL Q 0 A_CustomMissile ("ToxinShot",44,-16,0,0,0)
    GHUL Q 8 A_CustomMissile ("ToxinShot",44,16,0,0,0)
    Goto See
  Pain: 
    GHUL H 2 
    GHUL H 2 A_Pain 
    Goto See 
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
	TNT1 A 0 A_JumpIfInventory("HesDeadJim",1,"Death2")
	GHUL I 5 A_CustomMissile ("ToxinCloud",40,0,0,0,0) 
	GHUL J 5 A_Scream 
	GHUL K 5 
	GHUL L 5 A_NoBlocking 
	GHUL MNO 5
  Death2:
	GHUL P -1
    Stop 
  Raise: 
    TNT1 A 0 A_JumpIfMasterCloser(256,4)
	TNT1 A 0 A_GiveInventory("HesDeadJim",1)
	TNT1 A 0 A_ChangeFlag("SOLID",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CF_SetHealth")
	Goto Death2
	TNT1 A 0 A_TakeInventory("HesDeadJim",1)
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    GHUL PONMLKJI 5 
    Goto See 
  } 
}

Actor ToxinShot
{
  Radius 5
  Height 5
  Speed 15
  Damage (Random(5,10)) //2
  PoisonDamage 16
  RenderStyle Add
  Species "Viles"
  DamageType "VileFires"
  Alpha 0.80
  Projectile
  +THRUGHOST
  +FLOATBOB
  Seesound "weapons/skulfi"
  DeathSound "weapons/bloodx"
  States
  {
  Spawn:
    GHFX A 1 Bright A_CustomMissile("Barbtrail",0,0,0,0)
    GHFX A 1 Bright A_Weave(3,0,1.0,0.0)
    GHFX B 1 Bright A_CustomMissile("Barbtrail",0,0,0,0)
    GHFX B 1 Bright A_Weave(3,0,1.0,0.0)
    Loop
  Death:
    GHFX CDEF 4 Bright
    Stop
  }
}

Actor ToxinCloud
{
  Radius 0
  Height 48
  RenderStyle Translucent
  Species "Viles"
  DamageType "VileFires"
  ReactionTime 20
  Alpha 0.67
  Monster
  -SOLID
  -SHOOTABLE
  -ACTIVATEMCROSS
  -COUNTKILL
  +NOTELEPORT
  +THRUGHOST
  +DROPOFF
  +LOWGRAVITY
  +NODAMAGETHRUST
  Seesound "weapons/poof1"
  States
  {
  Spawn:
    GGAS ABCDEFGFD 5 A_Explode(64,128,0)
    GGAS A 0 A_Countdown
    Goto Spawn+2
  Death:
    GGAS C 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS D 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS E 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS F 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS G 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS F 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS E 5 A_FadeOut(0.10)
    GGAS C 0 A_Explode(10,30)
    GGAS D 5 A_FadeOut(0.10)
    Loop
  }
}

