    Stop
  }
}

Actor LegendaryVesselHealClone
{
  Health 20
  Radius 20
  Height 80
  Speed 28
  Mass 1000
  PainChance 4
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  BloodColor "Blue"
  Monster 
  RenderStyle Add
  Alpha 0.8
  -COUNTKILL
  +NOTIMEFREEZE
  +FLOORCLIP
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +NOFEAR
  +NOCLIP
  +LOOKALLAROUND
  var int user_timer;
  States
  {
