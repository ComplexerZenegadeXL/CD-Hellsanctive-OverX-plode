Actor LegendaryBulwark
{
  Health 1000
  Radius 18
  Height 56
  Speed 12
  Mass 10000
  PainChance 2
  BloodColor "Blue"
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor 0.5
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  Monster
  Species "Viles"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +FORCERADIUSDMG
  +NOFEAR
  +LOOKALLAROUND
  -COUNTKILL
  +BRIGHT
  SeeSound "LegendaryBulwark/Sight"
  PainSound "LegendaryBulwark/Pain"
  DeathSound "LegendaryBulwark/Death"
  ActiveSound "LegendaryBulwark/Active"
  Obituary "$CFLegendaryBulwarkObit"
  Tag "$CFBulw"
  var int user_missile;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	LESC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
  SpawnLoop:
	LESC A 8 A_Look
	Loop
  See:
	LESC AABBCCDD 2 A_Chase
	Loop
  Missile:
  Melee:
	TNT1 A 0 A_Jump(90,"Flamethrower","LegImpBalls","Barrier")
	TNT1 A 0 A_JumpIfCloser(384,"Lunge")
	LESC EF 8 A_FaceTarget
	LESC G 8 A_CustomMissile("TLegendaryCyberBFG15KBall")
  Goto See
  Flamethrower:
	TNT1 A 0 A_PlaySound("agaures/swing")
	LESC EF 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("devil/scream",1)
  FlamethrowerLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 30,"Detox")
	TNT1 A 0 A_CustomMissile("LBulwarkFlamethrower",28,0,0,CMF_AIMDIRECTION)
	LESC G 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  LegImpBalls:
	LESC EF 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("LegendaryBall",28,0,-30)
	TNT1 A 0 A_CustomMissile("LegendaryBall",28,0,-15)
	TNT1 A 0 A_CustomMissile("LegendaryBall",28)
	TNT1 A 0 A_CustomMissile("LegendaryBall",28,0,15)
	LESC G 8 A_CustomMissile("LegendaryBall",28,0,30)
	Goto See
  Barrier:
	LESC EF 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,-40)
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,40)
	LESC G 6 A_CustomMissile("LBBarrierBall",28)
	LESC EF 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,-20)
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,20)
	LESC G 2 A_CustomMissile("LBBarrierBall",28)
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,-10)
	TNT1 A 0 A_CustomMissile("LBBarrierBall",28,0,10)
	LESC G 10 
	Goto See
  Lunge:
	TNT1 A 0 A_Jump(128,"Missile")
	TNT1 A 0 A_PlaySound("agaures/swing")
	TNT1 A 0 A_PlaySound("LegendaryBulwark/Lunge",2)
	LESC WWWX 5 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,30,0,1)
	LESC Y 2 A_Recoil(-40)
	TNT1 A 0 A_CustomMissile("LegendaryBulwarkLunge",18,0,0,CMF_AIMDIRECTION)
	//TNT1 A 0 A_SpawnItemEx("LegendaryBulwarkLunge",0,0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	LESC Y 25
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	Goto See
  Pain:
	LESC H 3 A_Pain
	LESC H 3
  Detox:
	TNT1 A 0 A_SetUserVar(user_missile,0)
	Goto See
  Death:
	TNT1 A 0 A_ChangeFlag(BRIGHT,0)
	LESC I 4 A_NoBlocking
	LESC J 4 A_Scream
	LESC KL 4
	TNT1 A 0 A_GiveInventory("BulwarkDeath",1,AAPTR_MASTER)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	LESC M 4 A_SpawnItem("TLegCybDTBFGEx",0,-10)
	LESC N -1
	Stop
  }
}

Actor LBulwarkFlamethrower : FlameShot 
{
  Species "Legendary"
  DamageType "Legendary"
  Damage (Random(8,12))
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 AAAA 1 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-1,1)+velx,frandom(-1,1)+vely,frandom(-1,1)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 1 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-2,2)+velx,frandom(-2,2)+vely,frandom(-2,2)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 0 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-3,3)+velx,frandom(-3,3)+vely,frandom(-3,3)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 1 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-3,3)+velx,frandom(-3,3)+vely,frandom(-3,3)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 0 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-3,3)+velx,frandom(-3,3)+vely,frandom(-3,3)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 1 A_SpawnItemEx("LBFlameTrail",0,0,0,frandom(-4,4)+velx,frandom(-4,4)+vely,frandom(-4,4)+velz,0,SXF_CLIENTSIDE|SXF_ABSOLUTEMOMENTUM)
	TNT1 A 18 
	Stop
  Death:
	TNT1 A 1
	Stop
  }
}

Actor LVDeathEffects
{
  +NOINTERACTION
  +NOBLOCKMAP
  //+ISMONSTER
  -COUNTKILL
  +CLIENTSIDEONLY
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0 A_JumpIf(user_loop >= 48, "Death")
    TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,7)
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(5,7),frandom(7,8))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(5,7),frandom(-7,-8))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,-7)
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(-5,-7),frandom(7,8))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(-5,-7),frandom(-7,-8))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,0,7)
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(7,8),7)
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(-7,-8),7)
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,0,frandom(-5,-7))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(7,8),frandom(-5,-7))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(-7,-8),frandom(-5,-7))
	TNT1 AA 0 A_SpawnItemEx("LBFlameTrail",0,0,20,frandom(-17,17),frandom(-17,17),frandom(4,10))
	TNT1 A 0 A_Warp(AAPTR_MASTER,0,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 2 A_SetUserVar(user_loop,user_loop+1)
	Loop
  Death:
    TNT1 A 1
	Stop
  }
}

