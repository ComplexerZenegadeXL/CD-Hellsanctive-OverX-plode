	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	BTPR E 1 Bright A_SpawnItemEx("LDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
