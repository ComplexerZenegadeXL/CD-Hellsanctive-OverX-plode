Actor LegendaryFormicidae
{
  Health 600
  GibHealth 40
  Radius 18
  Height 56
  Speed 10
  Mass 400
  PainChance 40
  Species "Viles"
  BloodColor "Blue"
  DropItem "LegendaryPowerShard" 1
  DropItem "LDemonAmmoBoxPickup" 64 
  DropItem "LDemonAmmoPickup" 128 
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor 0.6
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  Monster
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +NOFEAR
  +LOOKALLAROUND
  -COUNTKILL
  -FULLVOLACTIVE
  +BRIGHT
  SeeSound "legform/sight"
  PainSound "legform/pain"
  DeathSound "legform/death"
  ActiveSound "legform/Idle"
  Obituary "$CFLegendaryFormicidaeObit"
  Tag "$CFFormic"
  var int user_rush;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States
  {
  Spawn:
	LFRC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	LFRC A 8 A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_Jump(36,"Rush")
	LFRC AABBCCDD 2 A_Chase
	Loop
  Rush:
	TNT1 A 0 A_JumpIf(user_rush == 4,"See")
	TNT1 A 0 A_SpawnItemEx("LegFormGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AA 0 A_Chase
	LFRC A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegFormGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AA 0 A_Chase
	LFRC B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegFormGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AA 0 A_Chase
	LFRC C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegFormGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AA 0 A_Chase
	LFRC D 1 A_Chase
	TNT1 A 0 A_SetUserVar(user_rush,user_rush+1)
	Loop
  Missile:
	TNT1 A 0 A_Jump(104,"10K")
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	LFRC EEEEEE 4 A_FaceTarget
	LFRC F 8 A_CustomMissile("LFormicidaeBall",30,-3)
	LFRC E 11 A_FaceTarget
	LFRC F 8 A_CustomMissile("LFormicidaeBall",30,-3)
	LFRC E 11 A_FaceTarget
	LFRC F 8 A_CustomMissile("LFormicidaeBall",30,-3)
	LFRC E 20 A_FaceTarget
	Goto See
  10K:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	LFRC EEEEEE 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LFRC F 8 A_CustomMissile("TrueLegendary10KProjectile",30,-3,frandom(-12,12))
	LFRC E 14 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LFRC F 8 A_CustomMissile("TrueLegendary10KProjectile",30,-3,frandom(-12,12))
	LFRC E 14 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LFRC F 8 A_CustomMissile("TrueLegendary10KProjectile",30,-3,frandom(-12,12))
	LFRC E 20 A_FaceTarget
	Goto See
  Pain:
	LFRC G 3 A_Pain
	Goto See
  Death:
	TNT1 A 0 A_ChangeFlag(BRIGHT,0)
	LFRC H 4 A_NoBlocking
	LFRC I 4 A_Scream
	LFRC JKL 4
	LFRC M 4 
	LFRC N -1
	Stop
  XDeath:
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
	LFRC G 2
	TNT1 AA 0 A_CustomMissile("LegendaryDRuneFlameSpawner",-20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360)) 
