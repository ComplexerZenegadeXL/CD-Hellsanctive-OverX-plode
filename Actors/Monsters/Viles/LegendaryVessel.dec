Actor LCVGhost1
{
  RenderStyle Translucent
  Alpha 0.0
  Scale 1.2
  Radius 0
  Height 0
  Mass 100000
  Monster
  Speed 0
  Species "Viles"
  DamageType "Legendary"
  -COUNTKILL
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  +NOTIMEFREEZE
  +BRIGHT
  var int user_fade;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("Legcyber/laugh3",6,1,0,ATTN_NONE)
  Charge1:
	TNT1 A 0 A_JumpIf(user_fade == 7,"Charge2")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	LBE3 G 2 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Charge2:
	TNT1 A 0 A_JumpIf(user_fade == 64,"Missile")
	LBE3 G 2 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Missile:
	TNT1 A 0 A_Jump(48,"BFG")
	TNT1 A 0 A_Jump(96,"Homing","15K")
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVRocket", 58, -26, frandom(-6, 6))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVRocket", 58, -26, frandom(-6, 6))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVRocket", 58, -26, frandom(-6, 6))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVRocket", 58, -26, frandom(-6, 6))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVRocket", 58, -26, frandom(-6, 6))
	Goto Death
  Homing:
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVHomingRocket", 58, -26, frandom(-8, 8))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVHomingRocket", 58, -26, frandom(-8, 8))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVHomingRocket", 58, -26, frandom(-8, 8))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVHomingRocket", 58, -26, frandom(-8, 8))
	CYB2 E 5 A_FaceTarget
	CYB2 F 5 A_CustomMissile("LVHomingRocket", 58, -26, frandom(-8, 8))
	Goto Death
  15K:
	CYB2 E 6 A_FaceTarget
	CYB2 F 4 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 4 A_FaceTarget
	CYB2 F 4 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 4 A_FaceTarget
	CYB2 F 3 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 3 A_FaceTarget
	CYB2 F 3 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 3 A_FaceTarget
	CYB2 F 3 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 3 A_FaceTarget
	CYB2 F 3 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 3 A_FaceTarget
	CYB2 F 3 A_CustomMissile("LVBFG15KBall",58,-26,frandom(-4, 4))	
	CYB2 E 3 A_FaceTarget
	Goto Death
  BFG:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	CYB2 EEF 10 Bright A_FaceTarget
	CYB2 F 10 Bright A_CustomMissile("LVBFG9500Ball", 58, -26, 0)
	CYB2 E 10 Bright A_FaceTarget
  Death:
	CYB2 EEEEEEE 1 A_FadeOut(0.1)
	Stop
  }
}

Actor LCVGhost2 : LCVGhost1
{
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(user_fade == 10,"Charge2")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	CYB2 H 1 A_FadeIn(0.07)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Charge2:
	TNT1 A 0 A_JumpIf(user_fade == 75,"Charge3")
	CYB2 H 1 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Charge3:
	TNT1 A 0 A_JumpIf(user_fade == 95,"Charge4")
	CYB2 G 1 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Charge4:
	TNT1 A 0 A_JumpIf(user_fade == 115,"Death")
	LBE3 A 1 A_FaceTarget
	TNT1 A 0 A_Warp(AAPTR_MASTER,-12,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
	TNT1 A 0 A_SetUserVar(user_fade,user_fade+1)
	Loop
  Death:
	TNT1 A 0 Radius_Quake(20,10,0,40,0)
	LBE3 BBBBBBB 1 A_FadeOut(0.1)
	Stop
  }
}
