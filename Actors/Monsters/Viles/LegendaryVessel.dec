Actor LegendaryVessel : Exile
{
  Health 2000
  Radius 20
  Height 80
  Speed 8
  Mass 1000
  PainChance 4
  PainChance "BulwarkDeath", 256
  BloodColor "Blue"
  DamageType "Legendary"
  DropItem "LegendaryAmmoSphere" 88 1
  DropItem "LegendaryPowerShard" 256 1
  DropItem "LDemonAmmoBoxPickup" 200 
  DropItem "LDemonAmmoPickup" 250
  //DropItem "LegendaryPlasmaticRifleGiver" 195
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryUltraSphere" 34
  DropItem "LegendaryPowerSphere" 256
  DropItem "LegendaryRandomSphere" 16
  DamageFactor "LegendaryZombie", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.55
  DamageFactor "Legendary", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "PlayerDBFG10K2", 0.0
  DamageFactor "DBFG2", 0.0
  DamageFactor "PlayerDBFG2", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  Monster 
  +NOTIMEFREEZE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  +NODROPOFF
  +DONTGIB
  +NOTARGET
  +NORADIUSDMG
  +NOFEAR
  +LOOKALLAROUND
  +BRIGHT
  +NOTELEFRAG
  SeeSound "legves/sight"
  PainSound "legves/pain"
  DeathSound "legves/death"
  ActiveSound "legves/Idle"
  Obituary "$CFLegendaryVesselObit"
  Tag "$CFLegVess"
  var int user_music;
  var int user_missile;
  var int user_summon;
  var int user_summontimer;
  var int user_bulwark;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States
  {
 Spawn:
	LVSS E 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",10)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	LVSS E 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LVSS EEE 3 A_VileChase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,416)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar(user_summontimer,user_summontimer+1)
	LVSS EEE 3 A_VileChase
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegendaryVesselGhost")
	LVSS EEEEE 0 A_VileChase
	LVSS E 1 A_VileChase
	Loop
  Missile:
	TNT1 A 0 A_SetUserVar(user_missile, 0)
	TNT1 A 0 A_JumpIfHealthLower(800,"SummonBulwark")
	TNT1 A 0 A_Jump(8,"SummonBulwark")
  BulwarkSkip:
	TNT1 A 0 A_Jump(10,"Rage","IconoclastIsCool")
	TNT1 A 0 A_Jump(20,"Summon")
	TNT1 A 0 A_Jump(128,"SpreadLaser","VileRay","BFG","MagicBullets","HealClones")
	TNT1 A 0 A_Jump(80,"CyberGhost")
	LVSS FG 4 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVFireball",64,6,frandom(-2,2))
	LVSS G 4 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVFireball",64,6,frandom(-2,2))
	LVSS G 4 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVFireball",64,6,frandom(-2,2))
	Goto See
  SpreadLaser:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	LVSS FFFGGG 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("legves/laser",6,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_loop",-9)
  SpreadLaserLoop:
	LVSS H 2 A_CustomMissile("VesselSpreadLaser",64,6,user_loop * 5,CMF_AIMDIRECTION,-4.5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	LVSS H 10
	Goto See
  VileRay:
	LVSS FFGG 4 A_FaceTarget
	TNT1 A 0 A_VileTarget("VesselVileTargeter")
  VileCharge:
	TNT1 A 0 A_JumpIf(user_missile == 15,"RageEnd")
	LVSS H 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  VileAttack:
	TNT1 A 0 A_SetUserVar(user_missile,0)
	LVSS H 6 A_FaceTarget
	LVSS H 1 A_VileAttack
	LVSS HHH 3 A_FaceTarget
	Goto See
  MagicBullets:
	LVSS FG 4 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVMagicBullet",64,6,frandom(-7,7))
	TNT1 A 0 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVMagicBullet",64,6,frandom(-7,7))
	TNT1 A 0 A_FaceTarget
	LVSS HHH 4 A_CustomMissile("LVMagicBullet",64,6,frandom(-7,7))
	Goto See
  Rage:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_CustomMissile("VesselPentagram")
	LVSS FFGG 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
  RageCharge:
	TNT1 A 0 A_JumpIf(user_missile == 27,"RageEnd")
	TNT1 AAA 0 A_SpawnItemEx("VesselRageBallStart",0,0,0,0,0,0,frandom(0,360),SXF_CLIENTSIDE,0)
	LVSS H 4
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  RageEnd:
	LVSS H 20
	Goto Detox
  BFG:
	TNT1 A 0 A_PlaySound("LegVes/Magic",5)
	LVSS FFF 4 A_FaceTarget
	LVSS GGG 4 A_FaceTarget
	TNT1 A 0 A_FaceTarget
	LVSS H 12 A_CustomMissile("LVMagicBFG",64,6)	
	Goto See
  Summon:
	TNT1 A 0 A_JumpIf(user_summontimer <= 5,"See")
	TNT1 A 0 A_JumpIf(user_summon == 4,"See")
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	LVSS FG 8 A_FaceTarget
	TNT1 A 0 A_JumpIf(user_summon == 3,"Summon4")
	TNT1 A 0 A_JumpIf(user_summon == 2,"Summon3")
	TNT1 A 0 A_JumpIf(user_summon == 1,"Summon2")
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",-72,-72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LVSS H 20 A_SpawnItemEx("FormicidaeSpawner",72,72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar(user_summontimer,0)
	TNT1 A 0 A_SetUserVar(user_summon,1)
	Goto See
  Summon2:
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",72,-72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",-72,-72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LVSS H 20 A_SpawnItemEx("FormicidaeSpawner",72,72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar(user_summontimer,0)
	TNT1 A 0 A_SetUserVar(user_summon,2)
	Goto See
  Summon3:
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",-80,-72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",80,72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",80,-72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LVSS H 20 A_SpawnItemEx("FormicidaeSpawner",-80,72,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar(user_summontimer,0)
	TNT1 A 0 A_SetUserVar(user_summon,3)
	Goto See
  Summon4:
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",-95,-74,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",95,74,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",95,-74,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",125,125,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("FormicidaeSpawner",-125,-125,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LVSS H 20 A_SpawnItemEx("FormicidaeSpawner",-95,74,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar(user_summon,4)
	Goto See
  SummonBulwark:
	TNT1 A 0 A_JumpIf(user_bulwark == 1,"BulwarkSkip")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LVSS FG 16 A_FaceTarget
	LVSS H 12 A_SpawnItemEx("LegendaryBulwark",64,64,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_SetUserVar(user_bulwark,1)
  BulwarkLoop:
	TNT1 A 0 A_JumpIfInventory("BulwarkDeath",1,"Pain.Bulwark")
	TNT1 AA 0 A_SpawnItemEX("BHellionSmokeSpawner",frandom(-24,24),frandom(-40,40),0)
	LVSS E 5
	Loop
  Pain.Bulwark:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Pain
	LVSS IIIIII 6 A_FaceTarget
	TNT1 AAAAAAAA 0 A_SpawnItem("BlueKaboom3",frandom(-24,24),frandom(0,80),0)
	TNT1 A 0 A_PlaySound("weapons/rocklx")
	TNT1 AAAAA 0 A_SpawnItemEx("LegendaryVesselHealClone",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto Detox
  CyberGhost:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag(NODAMAGE,1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LCVGhost1",-12,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
  CyberGhostStartLoop1:
	TNT1 A 0 A_JumpIf(user_missile == 32,"CyberGhostStartLoop2")
	TNT1 A 0 A_Explode(2,200)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	LVSS F 2 A_FaceTarget
	Loop
  CyberGhostStartLoop2:
	TNT1 A 0 A_JumpIf(user_missile == 64,"CyberGhostRockets")
	TNT1 A 0 A_Explode(2,200)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	LVSS G 2 A_FaceTarget
	Loop
  CyberGhostRockets:
	TNT1 A 0 A_JumpIf(user_missile == 84,"Detox")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	LVSS H 3 A_CustomMissile("LegNobleBall2",64,6,frandom(-2,2))
	Goto CyberGhostRockets
  CyberRage:
	TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_CustomMissile("VesselPentagram")
	Goto RageCharge
  IconoclastIsCool:
	TNT1 A 0 A_SetUserVar("user_effect_delay",10)
	LVSS FFGG 5 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LVStationaryJunkThrower",0,0,0,0,0,1)
	LVSS HHHHH 4 A_FaceTarget
	Goto See
  Heal:
	TNT1 A 0 A_Jump(96,"HealClones")
	LVSS E 1
	Goto See
  HealClones:
	LVSS EEEEE 3 A_SpawnItemEx("LegendaryVesselHealClone",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto See
  Pain:
	LVSS I 3 A_Pain
	LVSS I 3 
  Detox:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOCLIP,0)
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
	Goto See
  XDeath:
  Death:
	TNT1 A 0 A_SpawnItem("LCVGhost2")
	TNT1 A 0 A_SpawnItemEx("LVDeathEffects",0,0,0,0,0,0,0,SXF_SETMASTER)
	LVSS I 95
	LVSS I 20
	TNT1 AAA 0 A_SpawnItemEx("BlueKaboom",frandom(-20,20),frandom(-20,20),frandom(0,18))
	LVSS I 1 A_SpawnItemEx("LegBlueGibbedGenerator",0,0,4)
	TNT1 AAA 0 A_SpawnItemEx("BlueKaboom",frandom(-20,20),frandom(-20,20),frandom(12,30))
	LVSS I 1 A_SpawnItemEx("LegBlueGibbedGenerator",0,0,16)
	TNT1 AAA 0 A_SpawnItemEx("BlueKaboom3",frandom(-20,20),frandom(-20,20),frandom(24,42))
	LVSS I 1 A_SpawnItemEx("LegBlueGibbedGenerator",0,0,28)
	TNT1 AAA 0 A_SpawnItemEx("BlueKaboom3",frandom(-20,20),frandom(-20,20),frandom(36,54))
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(4,6),256)
	TNT1 A 0 A_Scream
	LVSS I 1 A_ChangeFlag(BRIGHT,0)
	LVSS JKLM 4
	LVSS NO 3
	LVSS P -1
	Stop
  }
}

Actor LVFireball : LegNobleBall2
{
  Speed 32
  FastSpeed 44
  Species "Viles"
  DamageType "Legendary"
}

Actor VesselSpreadLaser : FastProjectile
{
  Radius 6
  Speed 66
  Height 6
  Damage (Random(60,120)) //20
  RenderStyle Add
  Projectile
  Species "Viles"
  DamageType "Legendary"
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  +BRIGHT
  MissileType "VesselLaserTrail"
  MissileHeight 8
  States
  {
  Spawn:
	BRAC A 1
    Loop
  Death:
    TNT1 A 15
	TNT1 A 0 A_Explode(98,124)
	TNT1 AAAA 0 A_SpawnItemEX("LegendaryBlueParticleSpawner")
	TNT1 AAA 0 A_SpawnItemEx("BlueKaboom3")
	TNT1 A 0 A_PlaySound("weapons/rocklx")
    BXPO ABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
    Stop
  }
}

Actor VesselLaserTrail
{
  RenderStyle Add
  YScale 0.02
  XScale 0.05
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  +BRIGHT
  States
  {
  Spawn:
    LDLS A 0
    LDLS A 1 Bright A_FadeOut(0.15)
    Loop
  }
}

Actor VesselVileTargeter : ExileFireFX
{
  Alpha 0.0
  +NOTIMEFREEZE
  +BRIGHT
  Species "Viles"
  DamageType "Legendary"
  SeeSound "thorstrike/load"
  var int user_missile;
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(user_missile >= 6,"Spawn2")
	TNT1 A 0 A_FadeIn(0.15)
	TNT1 A 0 A_PlaySound("thorstrike/load",6,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegImpLineSpawner")
	THOR A 2 A_Fire
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  Spawn2:
	TNT1 A 0 A_JumpIf(user_missile >= 40,"Death")
	TNT1 A 0 A_SpawnItemEx("LegImpLineSpawner")
	THOR A 2 A_Fire
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  Death:
	TNT1 A 1 A_SetScale(1.35,1.35)
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("legsoul/explode2")
	TNT1 A 0 A_Explode(256,96,0,0,8)
	LV32 ABCDEFGHIJKLMNOP 1 Bright 
	Stop
  }
}

Actor VesselRageBallStart
{
  Scale 0.5
  Projectile
  +NOCLIP
  +NOTIMEFREEZE
  +BRIGHT
  Speed 1
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
  SpawnLoop:
	TNT1 A 0 A_Wander
	TNT1 A 0 A_Jump(128,"Death")
	TNT1 A 0 A_SetUserVar(user_loop,user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,"Death")
	TNT1 A 0 A_Jump(256,"SpawnLoop")
  Death:
	TNT1 A 0 A_Jump(128,"Death2")
	TNT1 A 0 A_SpawnItemEx("VesselRageBall",frandom(10,120),0,0,0,0,1,frandom(0,360),SXF_CLIENTSIDE)
	Stop
  Death2:
	TNT1 A 0 A_SpawnItemEx("VesselBRageBall",frandom(10,120),0,0,0,0,1,frandom(0,360),SXF_CLIENTSIDE)
	Stop
  }
}

Actor VesselRageBall
{
  Scale 0.5
  Projectile
  +NOCLIP
  +NOTIMEFREEZE
  Speed 0
  RenderStyle Add
  Alpha 0.0
  States
  {
  Spawn:
	LFS1 ABABABABAB 4 A_FadeIn(0.09)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("Vessel15KBall",0,0,-180,CMF_AIMDIRECTION)
	Stop
  }
}

Actor VesselBRageBall : VesselRageBall
{
  States
 {
  Spawn:
	TBS1 ABABABABAB 4 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("VesselB15KBall",0,0,-180,CMF_AIMDIRECTION)
	Stop
  }
}

Actor Vessel15KBall : LegendaryCyberBFG15KBall
{
  Speed 22
  Damage (Random(100,170)) //30
  Scale 0.4
  States
  {
  Spawn:
	LFS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	LFS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	LFS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	LFS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
    Loop
  }
}

Actor VesselB15KBall : Vessel15KBall
{
  Decal "TLegBFG15K"
  States
  {
  Spawn:
    TBS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	TBS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	TBS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
	TBS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(2.0, 0.0, 9.0, 0.0)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("KaboomBlue2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))      
    TBE1 A 4 Bright A_Explode	
    TBE1 BCDEF 4 Bright
    Stop
  }
}
Actor VesselPentagram : TrueLegPentagram
{
  var int user_turn;
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(user_loop == 36,"Death")
    TNT1 E 0 A_CustomMissile("VPentaFire",28,0,user_turn,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar(user_turn,user_turn+10)
	TNT1 A 0 A_SetUserVar(user_loop,user_loop+1)
	Loop
  Death:
	TNT1 A 0
	Stop
  }
}

