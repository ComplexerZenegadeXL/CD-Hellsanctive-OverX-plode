Actor DeathKnight : Exile  30114 
{ 
  Health 1500
  Radius 24
  Height 72
  Mass 1000 
  Speed 12
  PainChance 20 
  MeleeDamage 20
  MeleeRange 65
  DamageFactor 0.65
  RadiusDamageFactor 0.5
  DamageFactor "PlayerDTRG", 0.65
  DamageFactor "VileFires", 0
  DamageFactor "NobleComet", 0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "CacoComet", 0
  DamageFactor "BeheComet", 0
  DamageFactor "Baby15K", 0
  DamageFactor "Cyber10K", 0
  DamageFactor "Masterminds", 0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "ImpComet", 0.0
  DamageFactor "HellComet", 0.2
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryPlayer", 0.1
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.1
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerLegendary", 0.1
  //DropItem "necronomicon"
  DropItem "BehemothCannonGiver"
  DropItem "HellfireUltrasphere"
  Monster
  +FLOORCLIP 
  +NOTARGET 
  +NORADIUSDMG
  +THRUSPECIES
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +BOSS
  +NOINFIGHTING
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DEFLECT
  Obituary "$CFRMDeathKnightObit"
  HitObituary "$CFRMDeathKnightHitObit"
  MeleeSound "monster/dknhit" 
  SeeSound "monster/dknsit" 
  PainSound "monster/dknpai" 
  DeathSound "monster/dkndth" 
  ActiveSound "monster/dknact" 
  Tag "$CFRevDK"
  var int user_skeldelay;
  var int user_souldelay;
  var int user_ghouldelay;
  var int user_faminedelay;
  var int user_loop;
  States 
  { 
  Spawn: 
    DKNT A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Spawn2:
	TNT1 A 0 A_SetUserVar("user_skeldelay",5)
	TNT1 A 0 A_SetUserVar("user_souldelay",7)
	TNT1 A 0 A_SetUserVar("user_ghouldelay",9)
	TNT1 A 0 A_SetUserVar("user_faminedelay",13)
  Idle:
    DKNT A 10 A_Look 
    Loop 
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DKNT AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    DKNT A 0 A_Jump(32,"ShieldSee")
    DKNT AABB 3 A_VileChase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	DKNT CCDD 3 A_VileChase
	TNT1 A 0 A_RadiusGive("Health",500,RGF_MONSTERS,5)
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    Loop
  ShieldSee:
    TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT PPQQ 3 A_Chase
	TNT1 A 0 A_RadiusGive("Health",500,RGF_MONSTERS,5)
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShieldSeeLoop:
	DKNT RRSS 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	DKNT PPQQ 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Goto ShieldSeeLoop
    DKNT RRSS 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    Goto See
  Melee:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
    DKNT E 5 A_FaceTarget
    DKNT F 1 A_PlaySound ("monster/dknswg")
    DKNT F 4 A_FaceTarget
    DKNT G 5 A_MeleeAttack 
    Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"Souls")
	TNT1 A 0 A_JumpIfHealthLower(500,"Missile2")
	TNT1 A 0 A_Jump(16,"WelcomeToTheBoneZone")
	TNT1 A 0 A_Jump(256,"SpookySkeletons","Souls","Ghouls","Famine")
	Goto See
  Missile2:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_Jump(32,"WelcomeToTheBoneZone")
	TNT1 A 0 A_Jump(32,"RaiseChildren")
    TNT1 A 0 A_Jump(256,"SpookySkeletons","Souls","Ghouls","Famine")
	Goto See
  Defense:
    TNT1 A 0 A_Jump(256,"Defense1","Defense2","Defense3","Defense4")	
  Defense1:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
    DKNT E 6 Bright A_FaceTarget
    DKNT F 6 Bright A_PlaySound ("monster/kntswg")
    DKNT G 0 A_CustomMissile ("DKDart",32,0,-3,0)
    DKNT G 0 A_CustomMissile ("DKDart",32,0,-1,0)
    DKNT G 0 A_CustomMissile ("DKDart",32,0,1,0)
    DKNT G 5 Bright A_CustomMissile ("DKDart",32,0,3,0)
	Goto See
  Defense2:
    TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 3 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 3 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 3 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 3 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 3 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    DKNT T 3 Bright A_FaceTarget      
    DKNT U 2 Bright A_CustomMissile("DKbolt",44,-4,0,0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	Goto See
  Defense3:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT T 6 Bright A_FaceTarget
    DKNT U 1 Bright A_FaceTarget
    DKNT U 0 A_CustomMissile("FHeadShot",44,-4,-12,0)      
    DKNT U 5 Bright A_CustomMissile("FHeadShot",44,-4,12,0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	Goto See
  Defense4:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag(Frightened,1)
    DKNT PPQQ 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	DKNT RRSS 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	DKNT PPQQ 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(75,"Defense4End")
    Loop
  Defense4End:
	TNT1 A 0 A_ChangeFlag(Frightened,0)
	Goto See
  SpookySkeletons:
    TNT1 A 0 A_JumpIf(user_Skeldelay >= 3,"SkelSummon")
	TNT1 A 0 A_SetUserVar("user_Skeldelay",user_Skeldelay+1)
	Goto Defense
  SkelSummon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT E 6 Bright A_FaceTarget 
	TNT1 A 0 A_GiveInventory("Health",20)
	TNT1 A 0 A_UnSetInvulnerable
	DKNT E 8 Bright A_FaceTarget
    DKNT E 0 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,0,SXF_SETMASTER,0)
	DKNT E 0 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,60,SXF_SETMASTER,0)
	DKNT E 0 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,80,SXF_SETMASTER,0)
	TNT1 A 0 A_PlaySound("monster/dknsit")
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 25 Bright 
	TNT1 A 0 A_SetUserVar("user_Skeldelay",0)
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  Souls:
    TNT1 A 0 A_JumpIf(user_souldelay >= 5,"SoulSummon")
	TNT1 A 0 A_SetUserVar("user_souldelay",user_souldelay+1)
	Goto Defense
  SoulSummon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT EE 3 Bright A_FaceTarget 
	TNT1 A 0 A_GiveInventory("Health",20)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	DKNT E 8 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ESoul",0,100,20,0,0,0,0,SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("ESoul",0,100,20,0,0,0,90,SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("ESoul",0,100,20,0,0,0,180,SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("ESoul",0,100,20,0,0,0,300,SXF_SETMASTER,0)
	TNT1 A 0 A_PlaySound("monster/dknsit")
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 25 Bright 
	TNT1 A 0 A_SetUserVar("user_souldelay",0)
	TNT1 A 0 A_Jump(80,"AOEHeal")
	Goto See
  Ghouls:
    TNT1 A 0 A_JumpIf(user_ghouldelay >= 7,"ghoulSummon")
	TNT1 A 0 A_SetUserVar("user_ghouldelay",user_ghouldelay+1)
	Goto Defense
  GhoulSummon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT EE 3 Bright A_FaceTarget 
	TNT1 A 0 A_GiveInventory("Health",20)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	DKNT E 8 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("Ghoul",0,50,0,0,0,0,180,SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("Ghoul",0,50,0,0,0,0,360,SXF_SETMASTER,0)
	TNT1 A 0 A_PlaySound("monster/dknsit")
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 25 Bright 
	TNT1 A 0 A_SetUserVar("user_ghouldelay",0)
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  Famine:
	TNT1 A 0 A_JumpIf(user_faminedelay >= 9,"FamineSummon")
	TNT1 A 0 A_SetUserVar("user_faminedelay",user_faminedelay+1)
	Goto Defense
  FamineSummon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT EE 3 Bright A_FaceTarget 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")  //A_UnSetReflectiveInvulnerable
	DKNT E 8 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DKFamine",0,100,0,0,0,0,180,SXF_SETMASTER,0)
	TNT1 A 0 A_PlaySound("monster/dknsit")
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 25 Bright 
	TNT1 A 0 A_SetUserVar("user_faminedelay",0)
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  WarCry:
    TNT1 A 0 A_RadiusGive("DKMinionsBuff",1024,RGF_MONSTERS,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 30 Bright A_PlaySound("monster/dknsit",0,1000)
	Goto See
  AoeHeal:
    TNT1 A 0 A_RadiusGive("Health",1024,RGF_MONSTERS,200)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 30 Bright A_PlaySound("monster/dknsit",0,1000)
	Goto See
  RaiseChildren:
	DKNT E 20 Bright A_PlaySound("monster/dknsit",0,1000)
	TNT1 A 0 A_RadiusGive("DKBlessing",256,RGF_MONSTERS,1)
	TNT1 A 0 A_PlaySound("legendary/defense")
	TNT1 A 0 A_RaiseChildren
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  Heal:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HealLoop:
	TNT1 A 0 A_CustomMissile("DeathKnightResRadius",10,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,80,0,0,0,0,SXF_NOCHECKPOSITION)
	DKNT E 20 Bright A_PlaySound("monster/dknsit",0,1000)
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  WelcomeToTheBoneZone:
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT E 20 Bright A_PlaySound("monster/dknsit",0,1000)
    DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,0,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,60,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,20,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,80,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,50,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("MeleeRevenant",0,frandom(50,100),0,0,0,0,30,SXF_SETMASTER,0) 
	DKNT E 2 A_SpawnItemEx("DKGuardian",0,frandom(50,100),0,0,0,0,100,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("DKGuardian",0,frandom(50,100),0,0,0,0,170,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("DKGuardian",0,frandom(50,100),0,0,0,0,130,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("DKGuardian",0,frandom(50,100),0,0,0,0,150,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("DKFamine",0,frandom(50,100),0,0,0,0,270,SXF_SETMASTER,0)
	DKNT E 2 A_SpawnItemEx("DKFamine",0,frandom(50,100),0,0,0,0,230,SXF_SETMASTER,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_Jump(8,"Lul")
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  Lul:
	TNT1 A 0 A_SpawnItemEx("DKLegendaryRevenant",0,50,0,0,0,0,360,SXF_SETMASTER,0)
	TNT1 A 0 A_Jump(87,"AOEHeal","WarCry")
	Goto See
  Pain:
    DKNT H 2 
    DKNT H 2 A_Pain
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	DKNT T 105 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetReflectiveInvulnerable
    DKNT P 0 A_Jump (26,1)
    Goto See+7
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    DKNT T 6 Bright A_FaceTarget
    DKNT U 1 Bright A_FaceTarget
    DKNT U 0 A_CustomMissile("FHeadShot",44,-4,-12,0)      
    DKNT U 5 Bright A_CustomMissile("FHeadShot",44,-4,12,0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetReflectiveInvulnerable
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  XDeath:
  Death:
    DKNT I 0 A_CustomMissile("DKSword",44,32,-90,0)
    DKNT I 8 Bright A_CustomMissile("DKShield",44,-32,90,0)
    DKNT J 8 Bright A_Scream 
	TNT1 A 0 A_CustomMissile("SmokeFX",frandom(10,40),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("KaboomRed", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DKNT K 8 Bright A_KillChildren
    DKNT L 8 Bright A_NoBlocking 
    DKNT MN 8 Bright 
    DKNT O -1 
    Stop 
  } 
}

Actor DeathKnightResRadius : VelociratorResRadius
{
  Radius 10
  Speed 50
  States
  {
  Spawn:
	TNT1 AAAAAAAAAA 1 A_VileChase
	Stop
  Heal:
	TNT1 A 1
	Stop
  }
}

Actor DKDart
{
  Radius 3
  Height 12
  Speed 25
  Damage (Random(15,25)) //5
  Species "Viles"
  DamageType "VileFires"
  RenderStyle Add
  Alpha 1.00
  Projectile
  +THRUGHOST
  +THRUSPECIES
  SeeSound "monster/dkndrt"
  DeathSound "weapons/firex2"
  States
  {
  Spawn:
    DKAT ABC 3 Bright
    Loop
  Death:
    DKAT D 0 A_SetTranslucent (0.85,1)
    DKAT D 3 Bright
    DKAT E 3 Bright A_Explode(34,64)
    DKAT FG 3 Bright
    DKAT H 0 A_CustomMissile("DKFire",0,0,45,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,90,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,135,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,180,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,225,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,270,CMF_AIMDIRECTION)
    DKAT H 0 A_CustomMissile("DKFire",0,0,315,CMF_AIMDIRECTION)
    DKAT H 3 Bright A_CustomMissile("DKFire",0,0,0,CMF_AIMDIRECTION)
    DKAT IJKLM 3 Bright
    Stop
  }
}

Actor FHeadShot
{
  Radius 12
  Height 12
  Speed 15
  Damage (Random(30,50)) //10
  RenderStyle Add
  Alpha 1.00
  Projectile
  Species "Viles"
  DamageType "VileFires"
  +SEEKERMISSILE
  +THRUGHOST
  +THRUSPECIES
  SeeSound "monster/dknmsl"
  DeathSound "weapons/boom1"
  States
  {
  Spawn:
    FHED ABCD 3 Bright A_SeekerMissile (5,15)
    Loop
  Death:
    RIP1 DEFGH 5 Bright
    Stop
  }
}

Actor DKBolt
{
  Radius 8
  Height 8
  Speed 15
  Damage (Random(25,40)) //8
  Projectile
  RenderStyle Add
  Alpha 0.80
  Species "Viles"
  DamageType "VileFires"
  +THRUGHOST
  +THRUSPECIES
  SeeSound "Weapons/boltfi"
  DeathSound "weapons/firex4"
  States
  {
  Spawn:
    BOLT A 1 Bright A_BishopMissileWeave
    BOLT A 0 A_SpawnItemEx("RedPuff",0,0)
    Loop
  Death:
    HBAK EFGHI 4 Bright
    Stop
  }
}

Actor DKShield
{   
  Radius 8
  Height 8
  Speed 1
  Projectile
  RenderStyle Normal
  -NOGRAVITY
  +LOWGRAVITY
  States
  {
  Spawn:
    SHLD ABCDEFGHI 3
    Goto Death 
  Death:
    SHLD H -1
  }
}

Actor DKFire
{
  Radius 2
  Height 6
  Speed 4
  Damage 0
  RenderStyle Add
  Species "Viles"
  DamageType "VileFires"
  Alpha 0.95
  Projectile
  +THRUGHOST
  DeathSound "weapons/scorch"
  States
  {
  Spawn:
    DKAT NOPQRSTNOPQRSTNOPQRST 3 Bright A_Explode(4,8)
    Goto Death
  Death:
    DKAT UVW 3 Bright A_Explode(4,8)
    Stop
  }
}

Actor RedPuff
{   
  Radius 0
  Height 1
  Speed 0
  Projectile
  RenderStyle Add
  Alpha 0.85
  States
  {
  Spawn:
    TNT1 A 3
    RPUF ABCDE 3 Bright
    Stop 
  }
}

Actor DKGuardian : Guardian
{
  Species "Viles"
  DamageType "VileFires"
  DamageFactor "VileFires", 0
  DamageFactor "NobleComet", 0
  DamageFactor "CadaverRocket", 0
  DamageFactor "CacoComet", 0
  DamageFactor "BeheComet", 0
  DamageFactor "Baby15K", 0
  DamageFactor "Cyber10K", 0
  DamageFactor "Masterminds", 0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "ImpComet", 0.0
  +MISSILEEVENMORE
  +THRUSPECIES
  +NOINFIGHTING
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
  Tag "Guardian"
  States
  {
  Spawn:
    SKEL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Spawn2:
	SKEL PONML 10
  Idle:
    SKEL A 10 A_Look
    Loop
  Death:
    TNT1 A 0 A_JumpIfInventory("HesDeadJim",1,"Death2")
	SKEL LM 7
    SKEL N 7 A_Scream
    SKEL O 7 A_NoBlocking
    SKEL P 7 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
  Death2:
	SKEL Q -1
    Stop
  XDeath:
	TNT1 A 0 A_JumpIfInventory("HesDeadJim",1,"XDeath2")
	SKEX A 5 A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    SKEX B 4 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SKEX C 4 A_NoBlocking
    SKEX D 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SKEX E 4
  XDeath2:
	SKEX F -1
	Stop
  Raise:
	TNT1 A 0 A_JumpIfMasterCloser(256,4)
	TNT1 A 0 A_GiveInventory("HesDeadJim",1)
	TNT1 A 0 A_ChangeFlag("SOLID",0)
	TNT1 A 0 ACS_NamedExecuteWithResult("CF_SetHealth")
	Goto Death2
	TNT1 A 0 A_TakeInventory("HesDeadJim",1)
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    SKEL PONML 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	SKEX FEDCBA 5
	Goto See
  }
}

