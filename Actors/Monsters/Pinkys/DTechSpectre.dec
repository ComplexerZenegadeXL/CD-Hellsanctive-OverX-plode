Actor DTechSpectre : DTechFiend
{ 
  Health 400
  BloodColor "Red"
  RenderStyle Translucent
  Alpha 0.25
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +SHADOW
  DropItem "LifeEssence", 180, 5
  DropItem "ArmorBonusMax", 180
  DropItem "DemonAmmoPickup", 128, 120
  Obituary "$CFDTechSpectreObit"
  HitObituary "$CFDTechSpectreHitObit"
  Tag "$CFDtSpec"
  States 
  { 
  Spawn: 
	DSPC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DSPC AZ 12 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DSPC AABB 2 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	DSPC AABB 2 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	DSPC CCDD 2 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	TNT1 A 0 A_Jump(87,"Rush")
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC B 1 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTSpectreGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DSPC D 1 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	TNT1 A 0 A_Jump(87,"See")
	Loop
  Missile:
	TNT1 A 0 A_Jump(168,"DTech")
	TNT1 A 0 A_JumpIfCloser(250,"Lunge")
	Goto See
  Melee:	   
  Lunge:
	TNT1 A 0 A_PlaySound("cyberfiend/melee")
	DSPC AAAA 6 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	DSPC B 2 A_Recoil(-28)
	DSPC B 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	DSPC B 6
	DSPC B 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	DSPC B 1 A_ScaleVelocity(0)
	Goto See
  DTech:
	DSPC EEEEE 5 A_FaceTarget(45)
  Refire:
	DSPC E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DTSpectreDemonTechProjectile",36,0,frandom(-150,150)/100.00,0)
	DSPC F 3 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(62,"Pause")
	TNT1 A 0 A_SpidRefire
	Loop
  Pause:
	DSPC E 15 A_PlaySound("weapons/demontechsteam")
	Goto See	   
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	DSPC H 4 A_Pain
	Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(174,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1, 2)
	TNT1 A 0 A_Jump(174,2)
	TNT1 A 0 A_SpawnItem("DemonTechRifleGiver",0,12)
	DSPC I 5 A_ChangeFlag(SLIDESONWALLS,0)
	DSPC J 5 A_Scream   
	TNT1 AA 0 A_CustomMissile("RedBloodCloud", frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSPC K 4 A_SpawnItemEx("DTSpectreArm",10,0,32,0,frandom(6,8),0,0,SXF_CLIENTSIDE,0)
	DSPC L 4 A_NoBlocking     
	DSPC M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DSPC N -1
	Stop
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1, 2)
	TNT1 A 0 A_Jump(174,2)
	TNT1 A 0 A_SpawnItem("DemonTechRifleGiver",0,12)
	DSPC I 3 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	DSPC O 3 A_XScream
	DSPC P 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	DSPC Q 3 A_NoBlocking
	DSPC R 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DSPC ST 3
	DSPC U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	DSPC NMLKJI 5 
	Goto See 
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	DSPC UTSRQPOI 4
  Goto See
  }
}

Actor DTSpectreGhostA
{
  Scale 1.15
  RenderStyle Translucent
  Alpha 0.1
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 1
	DSPC A 2 A_FadeOut(0.01,1)
	Wait
  }
}

Actor DTSpectreGhostB : DTSpectreGhostA
{   
  States
  {
  Spawn:
	TNT1 A 1
	DSPC B 2 A_FadeOut(0.01,1)
	Wait
  }
}

Actor DTSpectreGhostC : DTSpectreGhostA
{   
  States
  {
  Spawn:
	TNT1 A 1
	DSPC C 2 A_FadeOut(0.01,1)
	Wait
  }
}

Actor DTSpectreGhostD : DTSpectreGhostA
{   
  States
  {
  Spawn:
	TNT1 A 1
	DSPC D 2 A_FadeOut(0.01,1)
	Wait
  }
}

Actor DTSpectreDemonTechProjectile
{
  Projectile
  Height 4
  Radius 2
  Speed 40
  Scale 0.06
  Decal "RedDTRScorch"
  Damage (Random(15,30)) //5
  +FORCERADIUSDMG
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Fiends"
  DamageType "DTFiendEx"
  DamageType "RedZombieDemonTech"
  DeathSound "weapons/demontechex"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
	Goto Normal
  Normal:
	TNT1 A 0 A_Jump(128,"NormalFX")
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  NormalFX:
	TNT1 A 0 A_SpawnItemEx("RDTechLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("RDTechLightning2",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Normal
  Spawn2:
	TNT1 A 0 A_Jump(128,"Spawn2FX")
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Spawn2FX:
	TNT1 A 0 A_SpawnItemEx("RDTechLightning",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("RDTechLightning2",frandom(-1,1),frandom(-1,1),frandom(-1,1),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	RDTR A 1 Bright A_SpawnItemEx("RedDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Spawn2
  Death:
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawnerDT",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("RedDemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("RedDTKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1 A_Explode(6,48,0,0)
	Stop
  }
}

Actor DTSpectreArm : DTFiendArm
{
  Alpha 0.25
  +NOBLOCKMAP
  States
  {
  Spawn:
	DSAA ABCDEFGH 3 A_SpawnItemEx("NewFlyingBlood",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  Death:
  Crash:
	DSAA I 150
	DSAA I 5 A_FadeOut(0.1,1)
	Wait
  }
}