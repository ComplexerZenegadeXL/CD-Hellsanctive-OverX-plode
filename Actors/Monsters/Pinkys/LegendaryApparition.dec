Actor LegendaryApparition
{
  Health 1010
  PainChance 30
  Speed 13
  Radius 30
  Height 56
  Mass 1550
  Monster
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE 
  +NOICEDEATH
  +DONTGIB
  +DONTHURTSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NORADIUSDMG
  +NOFEAR
  +BRIGHT
  +NOTELEFRAG
  Species "Fiends"
  DamageType "Legendary"
  SeeSound "LegFiend/Sight"
  PainSound "LegFiend/Pain"
  DeathSound "LegFiend/Death"
  ActiveSound "LegFiend/Active"
  AttackSound "LegFiend/Melee"
  BloodColor "Blue"
  Scale 1.1
  RenderStyle Translucent
  Alpha 0.7
  MeleeDamage 14
  MeleeRange 44
  PainChance 32
  DamageFactor 0.65
  DamageFactor "Legendary", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "PDTBFG", 0.15
  DamageFactor "PDTBFGTracer", 0.15
  DamageFactor "PlayerDevBall", 0.115
  DamageFactor "PlayerDevBall2", 0.115
  DamageFactor "PlayerDevTracer", 0.115
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryArmor" 90
  DropItem "LegendaryPowerSphere" 50
  DropItem "LDemonAmmoBoxPickup" 220
  DropItem "LDemonAmmoPickup" 256
  DropItem "LegendaryTimeFreezeSphere" 55
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticRifleGiver" 40
  DropItem "LegendaryRandomSphere" 16
  DropItem "LegendaryInvisibilitySphere" 16
  Obituary "$CFLegendaryApparitionObit"
  HitObituary "$CFLegendaryApparitionHitObit"
  Tag "$CFLegApp"
  var int user_ragewait;
  var int user_inviswait;
  var int user_invisdone;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LARP A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	LARP AA 12 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LARP AABB 2 A_Chase
	TNT1 A 0 A_PlaySound("humanish2/step")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,413)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetTranslucent(0.75)
	TNT1 A 0 A_Jump(110,"Rush")
	TNT1 A 0 A_PlaySound("humanish2/step")
    LARP AABB 2 A_Chase
    TNT1 A 0 A_PlaySound("humanish2/step")
    LARP CCDD 2 A_Chase
	TNT1 A 0 A_Jump(6,"Teleport")
    Loop
  InvisSee:
    TNT1 A 0 A_JumpIf(user_invisdone >= 4,"InvisRageGo")
    TNT1 A 0 A_JumpIf(user_inviswait >= 4,"InvisPuff")
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	TNT1 A 0 A_SetTranslucent(0.0)
	TNT1 A 0 A_SetUserVar("user_inviswait",user_inviswait+1)
	TNT1 A 0 A_PlaySound("humanish2/step")
	TNT1 A 0 A_CustomMissile("LASplash",1,-21,0,CMF_AIMDIRECTION,-90)
    LARP SSSSTTTT 1 A_Chase("","")
    TNT1 A 0 A_PlaySound("humanish2/step")
	TNT1 A 0 A_CustomMissile("LASplash",1,21,0,CMF_AIMDIRECTION,-90)
    LARP UUUUVVVV 1 A_Wander
    Loop
  InvisPuff:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_inviswait",0)
	TNT1 A 0 A_SetUserVar("user_invisdone",user_invisdone+1)
	LARP AAAA 0 A_SpawnItemEx("LAInvisSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto InvisSee
  Rush:
    TNT1 A 0 A_Jump(48,"InvisRush")
	TNT1 A 0 A_PlaySound("humanish2/step")
	LARP AA 0 A_Chase
	LARP A 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP A 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP B 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP B 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("humanish2/step")
	LARP AA 0 A_Chase
	LARP C 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP C 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP D 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase
	LARP D 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(12,"Teleport")
	TNT1 A 0 A_Jump(87,"See")
	Goto Rush+1
  InvisRush:
    TNT1 A 0 A_JumpIfTargetInLOS(2)
	Goto Rush+1
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	TNT1 A 0 A_PlaySound("humanish2/step")
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.65)
	LARP A 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.55)
	LARP A 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.45)
	LARP B 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.35)
	LARP B 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("humanish2/step")
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.25)
	LARP C 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.15)
	LARP C 1 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARP AA 0 A_Chase("","")
	TNT1 A 0 A_SetTranslucent(0.05)
	LARP D 1 A_SpawnItemEx("FakeLegApparition",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION|SXF_SETMASTER)
	LARP AA 0 A_Chase("","")
	Goto InvisSee
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetAngle(angle+180)
	LARP R 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.65)
	LARP R 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.6)
	LARP Q 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.55)
	LARP Q 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.5)
	LARP P 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.45)
	LARP P 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.4)
	LARP O 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.35)
	LARP O 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.3)
	LARP R 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.25)
	LARP R 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.2)
	LARP Q 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.15)
	LARP Q 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.1)
	LARP P 4 A_Wander
	TNT1 A 0 A_SetTranslucent(0.05)
	LARP P 4 A_Wander
    Goto InvisSee		
  Missile:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,0)
    TNT1 A 0 A_SetTranslucent(0.75)
    TNT1 A 0 A_Jump(48,"Rage","Fake","Swarm","Mark")
    TNT1 A 0 A_JumpIfCloser(250,"Lunge")
  Normal:		
	LARP EF 6 A_FaceTarget
    LARP G 6 A_CustomMissile("LegFiendBall2",32)
    LARP E 2 A_FaceTarget
    Goto See	
  Lunge:
    TNT1 A 0 A_SetUserVar("user_inviswait",0)
	TNT1 A 0 A_SetUserVar("user_invisdone",0)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	LARP E 7 A_FaceTarget
	TNT1 A 0 A_SetTranslucent(0.8)
	LARP F 7 A_FaceTarget
	TNT1 A 0 A_SetTranslucent(0.9)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    LARP F 2 A_Recoil(-26)
	LARP F 3 A_CustomMissile("LFLunge",18,0,0,CMF_AIMDIRECTION)
	LARP G 6 
	TNT1 A 0 A_SetTranslucent(0.8)
	LARP G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_SetTranslucent(0.7)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	LARP G 1 A_ScaleVelocity(0)
	Goto See
  Rage:	
    LARP G 1 A_JumpIfCloser(1500,1)
    Goto Normal
    LARP G 1 A_PlaySound("LegFiend/Active")
	LARP G 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LARP G 1 A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 16,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
    LARP G 0 A_JumpIfTargetInLos(2)
	LARP G 0 A_Jump(256,2)
	LARP G 0 A_FaceTarget
	LARP G 2 A_SpawnItem("LFiendFlameSpawner")
	Loop
  InvisRageGo:
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SetUserVar("user_inviswait",0)
	TNT1 A 0 A_SetUserVar("user_invisdone",0)
    LARP EEEEE 3 A_FadeIn(0.2)
	TNT1 A 0 A_JumpIfCloser(200,"Lunge")
  RageGo:
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	LARP G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
    TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	LARP G 9 
	LARP G 0 A_JumpIfTargetInLos(2)
	LARP G 0 A_Jump(256,2)
	LARP G 0 A_FaceTarget
	LARP G 3 
	TNT1 A 0 ThrustThingZ(0,10,0,1)
    LARP F 2 A_Recoil(-90)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
  RageLoop:
    TNT1 A 0 A_JumpIf(user_ragewait >= 11,"RageEnd")
	LARP G 0 A_SpawnItemEx("LAGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIfCloser(120,"LungeWarp")
	LARP G 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	Loop
  RageEnd:
    TNT1 A 0 A_SetUserVar("user_ragewait",0)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto See
  LungeWarp:
    TNT1 A 0 A_SetUserVar("user_ragewait",0)
	TNT1 A 0 A_ScaleVelocity(0.0)
	TNT1 A 0 A_Explode(200,128)
	TNT1 A 0 A_PlaySoundEx("exile/voidend","Voice")
	TNT1 AAAA 0 A_SpawnItemEx("LAInvisSmokeSpawner")
    TNT1 AAAA 0 A_SpawnItemEx("LAWarpSmoke",frandom(-24,24),frandom(-24,24),frandom(12,40),frandom(-8,8),frandom(-8,8),frandom(2,7))
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	LARP G 1 A_SetTranslucent(0.4)
	LARP G 1 A_SetTranslucent(0.1)
	Goto InvisSee
  Swarm:
    TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	LARP EEEE 5 A_SpawnItemEx("LFiendFlameSpawner")
  SwarmLoop:
	TNT1 A 0 A_VileTarget("LegAppSwarmGhostSpawner")
    LARP EE 4 A_SpawnItemEx("LFiendFlameSpawner")
    LARP EEEEEEE 2 A_FadeOut(0.1)
	TNT1 A 0 A_ChangeFlag(NONSHOOTABLE,1)
	Goto InvisSee
  Fake:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LARP EEEEEEE 2 A_FadeOut(0.1)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	PLAY AABBCCDDA 2 A_FadeIn(0.1)
  FakeLoop:
    PLAY AABB 2 A_GiveInventory("ApparitionStrafing")
	TNT1 A 0 A_Jump(128,"FakeLookRight")
	TNT1 A 0 A_SetAngle(angle+Random(1,3))
	PLAY CCDD 2 A_GiveInventory("ApparitionStrafing")
	TNT1 A 0 A_Jump(25,"FakeBreak")
	Loop
  FakeLookRight:
    TNT1 A 0 A_SetAngle(angle+Random(-1,-3))
	PLAY CCDD 2 A_GiveInventory("ApparitionStrafing")
	TNT1 A 0 A_Jump(25,"FakeBreak")
	Goto FakeLoop
  FakeBreak:
	TNT1 A 0 A_PlaySoundEx("exile/voidend","Voice")
	TNT1 AAAA 0 A_SpawnItemEx("LAInvisSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_SpawnItemEx("LAWarpSmoke",frandom(-24,24),frandom(-24,24),frandom(12,40),frandom(-8,8),frandom(-8,8),frandom(2,7))
	Goto RageGo
  MarkStart:
    LARP EEEEEEE 5 A_SpawnItemEx("LSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIfTargetInLOS("Mark")
	Goto See
  Mark:
	TNT1 A 0 A_GiveToTarget("LegMarkedGiverInception")
	LARP EEEEEEE 2 A_FadeOut(0.1)
	Goto InvisSee
  Melee:
	LARP EF 3 A_FaceTarget
    LARP G 2 A_MeleeAttack
    LARP E 3 A_FaceTarget
    Goto See
  Pain:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_FaceTarget
    LARP H 2  A_Jump(35,"Teleport")
    LARP H 2 A_Pain
	TNT1 A 0 A_Jump(88,"Missile")
    Goto See
  Death:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_ChangeFlag(BRIGHT,0)
	TNT1 A 0 A_KillChildren
    LARP I 8 A_StopSound(6)
    LARP J 0 A_PlaySound("Gore/Splat")
    LARP J 0 A_SpawnItemEx("LFGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    LARP J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
    LARP K 4 A_NoBlocking
    LARP LM 4
    LARP N -1
    Stop
  }
}

Actor LAGhost : LFGhost
{
  Scale 1.1
  Alpha 0.3
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LARP A 2 A_FadeOut(0.09)
	Loop
  Vanilla:
	TNT1 A 0
	Stop
  }
}

Actor FakeLegApparition : LegendaryApparition
{
  -COUNTKILL
  PainChance 256
  var int user_deathtimer;
  States
  {
  Spawn:
  See:
    TNT1 A 0 A_JumpIf(user_deathtimer >= 20,"Death")
	TNT1 A 0 A_SetUserVar(user_deathtimer,user_deathtimer+1)
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("humanish2/step")
    LARP AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySound("humanish2/step")
    LARP CCDD 2 A_Chase
    Loop
  Melee:
  Missile:
    TNT1 A 0 A_JumpIfCloser(250,"Lunge")
	Goto See
  Lunge:
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	LARP E 7 A_FaceTarget
	TNT1 A 0 A_SetTranslucent(0.7)
	LARP F 7 A_FaceTarget
	TNT1 A 0 A_SetTranslucent(0.6)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    LARP F 2 A_Recoil(-26)
	LARP F 3 A_CustomMissile("LFLunge",18,0,0,CMF_AIMDIRECTION)
	LARP G 6
	TNT1 A 0 A_SetTranslucent(0.5)
	LARP G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_SetTranslucent(0.4)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	LARP G 1 A_ScaleVelocity(0)
	LARP GGGG 2 A_FadeOut(0.1)
	Stop
  Pain:
  Death:
    LARP GGGG 2 A_FadeOut(0.1)
	Stop
  }
}

Actor LegAppSwarmGhostSpawner
{
  Height 1
  Radius 1
  +NOTIMEFREEZE
  +MISSILE
  +NOCLIP
  +DONTSPLASH
  +NOTELEPORT
  +NOINTERACTION
  States
  {
  Spawn:
	TNT1 AAAAAAAAAAAAA 8 A_SpawnItemEx("FakeLegApparitionSwarmGhost",frandom(-360,360),frandom(-360,360),16,0,0,0,frandom(0,360),0,64)
	Stop
  }
}

Actor FakeLegApparitionSwarmGhost : FakeLegApparition
{
  Alpha 0.0
  +NODAMAGE
  States
  {
  Spawn:
  See:
    //TNT1 A 0 ACS_NamedExecuteAlways("LAGhostHealthSet")
    TNT1 A 0 A_PlaySound("LegFiend/Melee")
    LARP EEEE 3 A_FadeIn(0.2)
	TNT1 A 0 A_SetTranslucent(0.7)
	LARP EF 7 Bright A_FaceTarget
	TNT1 A 0 A_SetTranslucent(0.6)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    LARP F 2 Bright A_Recoil(-26)
	LARP F 3 Bright A_CustomMissile("LFLunge",18,0,0,CMF_AIMDIRECTION)
	LARP G 6 Bright
	TNT1 A 0 A_SetTranslucent(0.5)
	LARP G 2 Bright A_ScaleVelocity(0.2)
	TNT1 A 0 A_SetTranslucent(0.4)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	LARP G 1 Bright A_ScaleVelocity(0)
	LARP GGGG 2 A_FadeOut(0.1)
	Stop
  }
}

Actor LAInvisSmoke : BHellionSmoke
{
States
{
  Spawn:
    TNT1 A 0
    LMKE ABCDEFGHIJKL 2 Bright A_FadeOut
    Stop
  }
}

Actor LAInvisSmokeSpawner : BHellionSmokeSpawner 
{
  States
  {
  Spawn:
    TNT1 A 0
