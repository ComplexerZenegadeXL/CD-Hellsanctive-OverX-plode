Actor LegendaryMarked : PlayerPawn
{
  Speed 1
  Mass 300
  Radius 20
  Height 56
  Health 100
  Scale 1.1
  Player.MaxHealth 100
  BloodColor "Blue"
  Player.AttackZOffset 0
  Player.DamageScreenColor "Blue", 0.1
  Player.MorphWeapon "ApparitionMorph-Weapons"
  DamageFactor 3.0
  SeeSound "LegFiend/Sight"
  PainSound "LegFiend/Pain"
  DeathSound "LegFiend/Death"
  ActiveSound "LegFiend/Active"
  MeleeSound "LegFiend/Melee"
  Species "LegMarked"
  -THRUSPECIES
  -DONTHARMSPECIES
  -NORADIUSDMG
  +NOSKIN
  -DONTRIP
  +NOPAIN
  +BOSS
  +BOSSDEATH
  +NOTIMEFREEZE
  -PICKUP
  States
  {
  Spawn:
	TNT1 A 0
	LARP A 10 Bright
	Loop
  See:
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("humanish2/step")
    LARP AABB 2 
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_PlaySound("humanish2/step")
    LARP CCDD 2 
	Goto Spawn
  Missile:
	LARP E 1 Bright
	Goto Spawn
  Death:
	TNT1 A 0 A_TakeInventory("HandGrenadeAction",1)
	TNT1 A 0 A_TakeInventory("MineAction",1)
	PLAY H 8
	PLAY I 8 A_PlayerScream
	PLAY J 8 A_NoBlocking
	PLAY K 8
	PLAY L 8 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PLAY M 8
	PLAY N -1
	Stop
  }
}

