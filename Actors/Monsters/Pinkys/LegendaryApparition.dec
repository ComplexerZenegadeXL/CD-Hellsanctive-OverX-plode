Actor ApparitionStrafing : LegZombieStrafingg3
{
  States
  {
  Pickup:
    TNT1 A 1 
	TNT1 A 1 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 1 A_Jump(256,2)
	TNT1 A 1 A_Jump(235,5)
	TNT1 A 1 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 1 A_GiveInventory("LegCommandoStrafeSens",1)
	TNT1 A 1 A_Jump(256,2)	
	TNT1 A 1 A_TakeInventory("LegCommandoStrafeSens",1)
	TNT1 A 1 A_JumpIfInventory("LegCommandoStrafeSens",1,3)
	TNT1 A 1 ThrustThing(angle*256/360+38.7,5,0,0)
	TNT1 A 1 A_Jump(256,2)	
	TNT1 A 1 ThrustThing(angle*256/360+38.7,-5,0,0)
    TNT1 A 1 A_FaceTarget
	TNT1 A 1 A_Jump(24,2)
	TNT1 A 1 A_JumpIfCloser(300,2)
	TNT1 A 1 A_Recoil(-1)
    Stop
	TNT1 A 1 A_Recoil(1)
    Stop	
  }
}

