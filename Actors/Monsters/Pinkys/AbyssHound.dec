Actor AbyssalHound : BullFiend
{
  Monster
  Health 220
  Height 50
  Radius 30  
  Mass 500
  Speed 12
  BloodColor "Purple"
  MeleeDamage 7
  MeleeRange 50
  PainChance 78
  PainChance "Mine", 128
  PainChance "SatanGuard", 0
  PainChance "AbyssalSatyr", 0
  PainChance "Heterodox", 0
  +FLOORCLIP
  +MISSILEMORE
  +DONTHARMSPECIES
  DamageFactor "Acid", 0.5
  DamageFactor "Fire", 0.5
  DamageFactor "SatanGuard", 0.25
  DamageFactor "AbyssalSatyr", 0.25
  DamageFactor "Heterodox", 0.25
  DropItem "LifeEssence", 180, 5
  DropItem "CFArmorBonusMax5", 180
  SeeSound "monster/Abdogsit"
  AttackSound "monster/AbDogatk"
  MeleeSound "monster/AbDogbit" 
  PainSound "monster/AbDogpai" 
  DeathSound "monster/ADogdth" 
  ActiveSound "monster/AbDogact"
  Obituary "$CFAbyssalHoundObit"
  HitObituary "$CFAbyssalHoundHitObit"
  Tag "$CFAbHound"
  var int user_lowlag;
  States
  {
  Spawn:
	HDOG A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HDOG A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HDOG AAAABBBBCCCCDDDDEEEEFFFF 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	HDOG AAAABBBBCCCCDDDDEEEEFFFF 1 A_Chase("Melee","")
	TNT1 A 0 A_Jump(142,"Missile")
	Loop
  Melee:
	HDOG G 5 A_FaceTarget(45)
	HDOG H 3 A_FaceTarget
	HDOG I 1 A_CustomMeleeAttack(7*random(1,4),"monster/AbDogbit","None","SatanGuard")
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfTargetInLos("Missile2",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	GoTo See
  Missile2:
	TNT1 A 0 A_Jump(256,"Lunge","Lunge","DarkFireBalls","Normal")
	Goto Normal
  Normal:
	HDOG G 6 A_FaceTarget
	HDOG H 2 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalHoundBall",28,0,0)
	HDOG I 8
	GoTo See 
  Lunge:
	TNT1 A 0 A_JumpIfCloser(200,1)
	Goto See
	TNT1 A 0 A_PlaySound("monster/Abdogatk")
	HDOG AAB 4 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,18,0,1)
	HDOG CC 1 A_Recoil(-24)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 AA 0 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	HDOG C 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	HDOG D 6
	HDOG EEEE 1 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	HDOG FFFF 1 A_ScaleVelocity(0)
	Goto See
  DarkFireBalls:
	HDOG G 9 A_FaceTarget(45)
	HDOG HH 1 Bright A_CustomMissile("HeterodoxBall",28,0,frandom(-11,11))
	HDOG I 12
	Goto See
  Pain:
	HDOG J 2
	HDOG J 2 A_Pain
	Goto See
  XDeath:
  Death:
	HDOG K 3
	HDOG L 3 A_Scream
	HDOG M 4
	HDOG N 4 A_Fall
	HDOG OP 3
	HDOG Q -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	HDOG QPONMLK 5
	Goto See
  }
}

Actor SummonedAbyssalHound : AbyssalHound { -COUNTKILL }

Actor AbyssalHoundBall : PhaseImpBall
{
  Species "Fiends"
  DamageType "FiendFire"
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
}