  }
}

Actor LFGhost
{
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LFND A 2 A_FadeOut(0.09)
    Loop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor LFGibbedGenerator : GibbedGenerator
{ 
  +NOTIMEFREEZE
  States 
  { 
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Standard:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 AA 0 A_CustomMissile("LegendaryBlueBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("LegendaryNewFlyingBlood5",0,0,frandom(25,50),frandom(6,-6),frandom(6,-6),frandom(4,6),0,SXF_CLIENTSIDE)
	TNT1 AA 1 A_CustomMissile("LegendaryBlueBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("LegendaryNewFlyingBlood5",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(256,"BodyParts1")
	Stop
  Reduced:
	TNT1 A 0 A_CheckSightOrRange(2048,"Reduced")
	TNT1 A 0 A_CheckFloor("BloodPool")
	TNT1 A 0 A_CustomMissile("LegendaryBlueBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryNewFlyingBlood5",0,0,frandom(25,50),frandom(6,-6),frandom(6,-6),frandom(4,6),0,SXF_CLIENTSIDE)
	TNT1 A 1 A_CustomMissile("LegendaryBlueBloodCloud", frandom(25,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 1 A_SpawnItemEx("GibSpray",0,0,frandom(25,50),frandom(-2,2),frandom(-2,2),frandom(1,4))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryNewFlyingBlood5",0,0,frandom(25,50),frandom(-6,6),frandom(-6,6),frandom(4,6),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(256,"BodyParts1")
	Stop
  BodyParts1:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueBodyPart1",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 3 A_SpawnItemEx("LegendaryBlueBodyPart2",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueBodyPart3",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	TNT1 A 1 A_SpawnItemEx("LegendaryBlueBodyPart4",0,0,frandom(25,50),frandom(-10,10),frandom(-10,10),frandom(8,10))
	Stop
  }
}
// Vanilla removed for this, because no alternative is available.  It's used
// for the fiend's charge for a dash attack, and players need to see it.
// Problem: 
Actor LFiendFlameSpawner : LegendaryRedParticleSpawner
{
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("LFiendFlame",frandom(-20,20),frandom(-20,20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  Vanilla:
    TNT1 A 0
    TNT1 AAA 1 A_SpawnItemEx("LFiendFlame",frandom(-20,20),frandom(-20,20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    Stop
  }
}

Actor LFiendFlame
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  RenderStyle Add
  Scale 1.1
  States
  {
  Spawn:
    TNT1 A 0
    YMKE ABCDEFGHIJKL 2 Bright A_FadeOut
    Stop
  }
}