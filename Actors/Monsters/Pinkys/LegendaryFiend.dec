Actor LegendaryFiend 16505
{
  //$Category Monsters/LCA
  //$Sprite LFNDA1
  //$Title "Legendary Fiend"
  Health 1050
  PainChance 55
  Speed 14
  Radius 30
  Height 56
  Mass 550
  Monster
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE 
  +NOICEDEATH
  +DONTGIB
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NORADIUSDMG
  +NOFEAR
  +BRIGHT
  +NOTELEFRAG
  Species "Fiends"
  DamageType "Legendary"
  SeeSound "LegFiend/Sight"
  PainSound "LegFiend/Pain"
  DeathSound "LegFiend/Death"
  ActiveSound "LegFiend/Active"
  AttackSound "LegFiend/Melee"
  BloodColor "Blue"
  Scale 1.2
  MeleeDamage 28
  MeleeRange 84
  DamageFactor 0.60
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "PDTBFG", 0.15
  DamageFactor "PDTBFGTracer", 0.15
  DamageFactor "PlayerDevBall", 0.115
  DamageFactor "PlayerDevBall2", 0.115
  DamageFactor "PlayerDevTracer", 0.115
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryArmor" 90 1
  DropItem "LegendaryPowerSphere" 50 1
  DropItem "LDemonAmmoBoxPickup" 220
  DropItem "LDemonAmmoPickup" 256
  DropItem "LegendaryTimeFreezeSphere" 45
  //DropItem "LegendaryPlasmaticRifleGiver" 64
  DropItem "LegendaryRandomSphere" 16 1
  Obituary "$CFLegendaryFiendObit"
  HitObituary "$CFLegendaryFiendHitObit"
  Tag "$CFLegFiend"
  var int user_ragewait;
  var int user_music;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LFND A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    LFND PQ 12 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LFND AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHeavyFleshStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,10)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(110,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryHeavyFleshStep",0,0,5,0,0,-20)
	LFND AABB 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHeavyFleshStep",0,0,5,0,0,-20)
	LFND CCDD 2 Bright A_Chase
	TNT1 A 0 A_Jump(25,"Teleport")
	Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	LFND AA 0 A_Chase
	LFND A 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND A 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND B 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND B 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	LFND AA 0 A_Chase
	LFND C 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND C 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND D 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND AA 0 A_Chase
	LFND D 1 Bright A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(15,"Teleport")
	TNT1 A 0 A_Jump(87,"See")
	Loop
  Teleport:
    LFND A 1 Bright A_UnSetShootable
	LFND AAAAAAAAAA 1  A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LFND A 2 
	LFND AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LFND A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LFND AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LFND A 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    TNT1 A 0 A_Jump(48,"Rage")
    TNT1 A 0 A_Jump(64,"Ripperr")
    TNT1 A 0 A_JumpIfCloser(250,"Lunge")
  Normal:		
	LFND EF 6 Bright A_FaceTarget
    LFND G 6 Bright A_CustomMissile("LegFiendBall2",32,0,0)
	LFND EF 6 Bright A_FaceTarget
    LFND G 6 Bright A_CustomMissile("LegFiendBall2",32,0,0)	
    LFND E 2 Bright A_FaceTarget
    Goto See	
  Ripperr:		
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND E 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND F 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND F 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBlueKaboom", 8, 0, 36)
	LFND F 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBreatheBlueKaboom", 8, 0, 36)
    LFND GGG 3 Bright A_CustomMissile("LegFiendBall",32,0,frandom(-2,2))
	LFND G 0 A_FaceTarget
	LFND GGG 3 Bright A_CustomMissile("LegFiendBall",32,0,frandom(-2,2))
    LFND G 0 A_FaceTarget
	LFND GGG 3 Bright A_CustomMissile("LegFiendBall",32,0,frandom(-2,2))
    LFND E 2 Bright A_FaceTarget
    Goto See
  Lunge:
    TNT1 A 0 A_Jump(64,"Normal")
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	LFND EF 7 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    LFND F 2 Bright A_Recoil(-26)
	LFND F 3 Bright A_CustomMissile("LFLunge",18,0,0,CMF_AIMDIRECTION)
	LFND G 6 Bright
	LFND G 2 Bright A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	LFND G 1 Bright A_ScaleVelocity(0)
	Goto See
  Rage:	
    LFND G 1 A_JumpIfCloser(1500,1)
    Goto Normal
    LFND G 1 Bright A_PlaySound("LegFiend/Active")
	LFND G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",17)
	LFND G 1 Bright A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 16,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
    LFND G 0 A_JumpIfTargetInLos(2)
	LFND G 0 A_Jump(256,2)
	LFND G 2 Bright A_FaceTarget
	Loop
  RageGo:
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	LFND G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_delay",8)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 ThrustThingZ(0,35,0,1)
    TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	LFND G 9 Bright
	LFND G 0 A_JumpIfTargetInLos(2)
	LFND G 0 A_Jump(256,2)
	LFND G 0 A_FaceTarget
	LFND G 3 Bright
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    LFND F 2 A_Recoil(-100)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RageGoLoop:
	LFND G 0 A_SpawnItemEx("LFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LFND G 0 A_SpawnItemEx("LFiendFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LFND G 0 A_CustomMissile("BigLFLunge",18,0,0,CMF_AIMDIRECTION)
	LFND G 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,1)
	Goto RageGoLoop
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	Goto See
  Melee:
	LFND EF 2 Bright A_FaceTarget
    LFND G 2 Bright A_MeleeAttack
    LFND E 2 Bright A_FaceTarget
    Goto See
  Pain:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_Jump(35,"Teleport")
	TNT1 A 0 A_Jump(88,"PainMissile")
    LFND H 2 Bright
    LFND H 2 Bright A_Pain
    Goto See
  PainMissile:
    LFND H 2 Bright
    LFND H 2 Bright A_Pain
    Goto Missile
  Death:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    LFND I 8 A_StopSound(6)
	LFND J 0 A_PlaySound("Gore/Splat")
    LFND J 0 A_SpawnItemEx("LFGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LFND J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25) //25
	TNT1 A 0 A_DropItem("LegendaryDust",random(2,4),256)
    LFND K 4 
    LFND L 4 A_NoBlocking
    LFND M 4 
    LFND N -1
    Stop
  }
}

Actor LFLunge
{
  Height 16
  Radius 16
  Speed 27
  Damage (Random(60,120))
  Species "Fiends"
  DamageType "Legendary"
  SeeSound ""  
  DeathSound ""
  Projectile
  +DONTHARMSPECIES
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 4
    Stop
  }
}

Actor BigLFLunge : LFLunge
{
  Damage (Random(80,150)) //42
  Speed 0
  +EXTREMEDEATH
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,256,0)
	Stop
  Death:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,256,0)
	Stop
  }
}

Actor LegFiendBall
{
  Radius 4
  Height 6
  Speed 70
  Damage (Random(20,40)) //8
  Renderstyle Add
  Alpha 0.75
  SeeSound "lfball1/shot"
  DeathSound "lfball1/exp" 
  Projectile
  Species "Fiends"
  DamageType "Legendary"
  Decal "PlasmaLightning1"
  +RIPPER
  +HEXENBOUNCE
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  BounceCount 4
  States
  {
  Spawn:
    TNT1 A 0
    LFB1 ABCDEFGHABCDEFGH 2 Bright A_SpawnItemEx("LegFiendBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LFB1 IJK 4 Bright A_FadeOut(0.10)
    Stop
  }
}

Actor LegFiendBallTrail
{       
  Projectile
  +NOCLIP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  Scale 1
  Renderstyle Add
  Alpha 0.6
  Scale 0.8
  States
  {   
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LFB1 ABCDEFGH 1 Bright A_FadeOut(0.05)
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor LegFiendBall2
{
  Radius 8
  Height 8
  Speed 34
  Damage (random(50,100)) //22
  Species "Fiends"
  DamageType "Legendary"
  SpawnID 250
  Scale 1.0
  Projectile
  RenderStyle Add
  Decal "DoomImpScorch"
  Alpha 0.95
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  States
  {
  Spawn: 
   	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    LFB2 A 1 Bright A_SpawnItemEx("LegFiendBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    LFB2 A 1 Bright A_SpawnItemEx("LegFiendBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(32,64,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LFB2 C 5 Bright A_Explode(8,32,0)
    LFB2 DE 5 Bright
    Stop
  }
}

Actor LegFiendBall2Trail
{       
  Projectile
  +NOCLIP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  Scale 1
  Renderstyle Add
  Alpha 0.6
  Scale 0.8
  States
  {   
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
