Actor EnragedLegendaryFiend : LegendaryFiend
{
  Health 1550
  PainChance 25
  Speed 16
  BloodColor "Red"
  DamageFactor 0.55
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.15
  DamageFactor "PDTBFGTracer", 0.15
  DamageFactor "PlayerDevBall", 0.115
  DamageFactor "PlayerDevBall2", 0.115
  DamageFactor "PlayerDevTracer", 0.115
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "EnragedLegendaryArmor" 80 1
  DropItem "LegendaryPowerSphere" 100 1
  DropItem "ILDemonAmmoBoxPickup" 220
  DropItem "ILDemonAmmoPickup" 256
  DropItem "LegendaryTimeFreezeSphere" 70
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 30 1
  DropItem "EnragedLegendaryPowerShard" 65 1
  DropItem "LegendaryRandomSphere" 16 1
  Obituary "$CFEnragedLegendaryFiendObit"
  HitObituary "$CFEnragedLegendaryFiendHitObit"
  Tag "$CFEnrFiend"
  var int user_ragecount;
  States
  {
  Spawn:
    EFND R 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    EFND RQ 12 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EFND AABB 2 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,408)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_ragecount",0)
	TNT1 A 0 A_Jump(110,"Rush")
	TNT1 A 0 A_PlaySound("blooddemon/walk")
    EFND AABB 2 A_Chase
    TNT1 A 0 A_PlaySound("blooddemon/walk")
    EFND CCDD 2 A_Chase
	TNT1 A 0 A_Jump(35,"Teleport")
    Loop
  Rush:
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	EFND AA 0 A_Chase
	EFND A 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND A 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND B 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND B 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	EFND AA 0 A_Chase
	EFND C 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND C 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND D 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND AA 0 A_Chase
	EFND D 1 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(15,"Teleport")
	TNT1 A 0 A_Jump(87,"See")
	Loop
 Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
    EFND A 1 A_UnSetShootable
	EFND AAAAAAAAAA 1  A_FadeOut(0.1,0)
	EFND A 2 
	EFND AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    EFND A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	EFND AAAAAAAAAA 1 A_FadeIn(0.1)
    EFND A 1 A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(58,"Rage")
    TNT1 A 0 A_Jump(24,"Ripperr")
    TNT1 A 0 A_JumpIfCloser(250,"Lunge")
  Normal:		
	EFND EF 4 A_FaceTarget
    EFND G 6 A_CustomMissile("ELegFiendBall2",32)
	EFND EF 4 A_FaceTarget
    EFND G 6 A_CustomMissile("ELegFiendBall2",32)	
	EFND EF 4 A_FaceTarget
    EFND G 6 A_CustomMissile("ELegFiendBall2",32)	
    EFND E 2 A_FaceTarget
    Goto See	
  Ripperr:		
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND E 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND E 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND E 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND F 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND F 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthRedKaboom", 8, 0, 36)
	EFND F 3 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LegRipperrMouthBreatheRedKaboom", 8, 0, 36)
    EFND GGG 2 A_CustomMissile("ELegFiendBall",32,0,frandom(-2,2))
	EFND G 0 A_FaceTarget
	EFND GGG 2 A_CustomMissile("ELegFiendBall",32,0,frandom(-2,2))
    EFND G 0 A_FaceTarget
	EFND GGG 2 A_CustomMissile("ELegFiendBall",32,0,frandom(-2,2))
	EFND G 0 A_FaceTarget
	EFND GGG 2 A_CustomMissile("ELegFiendBall",32,0,frandom(-2,2))
    EFND E 2 A_FaceTarget
    Goto See
  Lunge:
    TNT1 A 0 A_Jump(64,"Normal")
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	EFND EF 6 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
    EFND F 2 A_Recoil(-26)
	EFND F 3 A_CustomMissile("ELFLunge",18,0,0,CMF_AIMDIRECTION)
	EFND G 6
	EFND G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	EFND G 1 A_ScaleVelocity(0)
	Goto See
  Rage:	
    EFND G 1 A_JumpIfCloser(1800,1)
    Goto Normal
    TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	EFND G 1 A_PlaySound("LegFiend/Active")
	EFND G 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EFND G 1 A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 14,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
    EFND G 0 A_JumpIfTargetInLos(2)
	EFND G 0 A_Jump(256,2)
	EFND G 0 A_FaceTarget
	EFND G 2 A_SpawnItemEx("ELFiendFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  RageGo:
	TNT1 A 0 A_Jump(96,"Rage2")
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	TNT1 A 0 A_SetUserVar("user_ragecount",user_ragecount+1)
	EFND G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 ThrustThingZ(0,30,0,1)
    TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	EFND G 9
	EFND G 0 A_JumpIfTargetInLos(2)
	EFND G 0 A_Jump(256,2)
	EFND G 3 A_FaceTarget
	TNT1 A 0 ThrustThingZ(0,25,0,1)
    EFND F 2 A_Recoil(-110)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
  RageLoop:
    TNT1 A 0 A_JumpIf(user_ragewait >= 20,"RageEnd")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	EFND G 0 A_SpawnItemEx("ELFGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EFND G 0 A_SpawnItemEx("ELFiendFlameSpawner")
	EFND G 0 A_CustomMissile("BigELFLunge",18,0,0,CMF_AIMDIRECTION)
	EFND G 2 A_FaceTarget
	Loop
  RageEnd:
    TNT1 A 0 A_SetUserVar("user_ragewait",0)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIf(user_ragecount >= 3,"See")
	TNT1 A 0 A_Jump(148,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragecount",0)
	Goto See
  Rage2:	
    TNT1 A 0 A_JumpIf(user_ragecount >= 2,"RageGo")
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	EFND G 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ELFLungeGhost")
	EFND G 20
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ELFLungeGhost")
	EFND G 20 
	TNT1 A 0 A_SetUserVar("user_ragecount",user_ragecount+1)
	Goto RageGo
  Melee:
    TNT1 A 0 A_Jump(128,"Flamethrower")
	EFND EF 2 A_FaceTarget
    EFND G 2 A_MeleeAttack
    EFND E 2 A_FaceTarget
    Goto See
  Flamethrower:
	EFND EF 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("magma/firebreath")
	TNT1 A 0 A_FaceTarget
	EFND FFF 2 A_CustomMissile("ELegFiendFlameBreath",32,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
    EFND FFF 2 A_CustomMissile("ELegFiendFlameBreath",32,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
    EFND FFF 2 A_CustomMissile("ELegFiendFlameBreath",32,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget		
	EFND FFF 2 A_CustomMissile("ELegFiendFlameBreath",32,0,frandom(-6,6))
    EFND E 5
	Goto See
  Pain:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_Jump(35,"Teleport")
	TNT1 A 0 A_SetUserVar("user_ragecount",0)
	TNT1 A 0 A_SetUserVar("user_ragewait",0)
    EFND H 2 
    EFND H 2 A_Pain
	TNT1 A 0 A_Jump(88,"Missile")
    Goto See
  Death:
  	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
    EFND I 8 A_StopSound(6)
	EFND J 0 A_PlaySound("Gore/Splat")
    EFND J 0 A_SpawnItemEx("EnragedGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    EFND J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
    EFND K 4 
    EFND L 4 A_NoBlocking
    EFND M 4 
    EFND N -1
    Stop
  }
}

Actor ELFLunge
{
  Height 16
  Radius 16
  Speed 27
  Damage (Random(60,120))
  Species "Fiends"
  SeeSound ""  
  DeathSound ""
  Projectile
  DamageType "FiendFire"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 4
    Stop
  }
}

Actor BigELFLunge : BigLFLunge
{
  Damage (Random(80,150))
  Speed 0
  +EXTREMEDEATH
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 A 1 A_Explode(72,282)
	Stop
  Death:
	TNT1 A 2
	TNT1 A 1 A_Explode(72,282)
	Stop
  }
}

Actor ELegFiendBall
{
  Radius 4
  Height 6
  Speed 70
  Damage (Random(20,80))
  Renderstyle Add
  Alpha 0.75
  SeeSound "lfball1/shot"
  DeathSound "lfball1/exp" 
  Projectile
  Damagetype "FiendFire"
  Decal "Cardinal15KLightning1"
  +RIPPER
  +HEXENBOUNCE
  +NOTIMEFREEZE
  BounceCount 4
  States
  {
  Spawn:
    TNT1 A 0
    EFB1 ABCDEFGHABCDEFGH 2 Bright A_SpawnItemEx("ELegFiendBallTrail")
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("EKaboomLNMute", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    EFB1 IJK 4 Bright A_FadeOut(0.10)
    Stop
  }
}

Actor ELegFiendBallTrail
{       
  Projectile
  +NOCLIP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  Scale 1
  Renderstyle Add
  Alpha 0.6
  Scale 0.8
  States
  {   
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	EFB1 ABCDEFGH 1 Bright A_FadeOut(0.05)
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}

Actor ELegFiendBall2
{
   Radius 8
   Height 8
   Speed 34
   Damage (Random(50,150))
   Damagetype "FiendFire"
   SpawnID 250
   Scale 1.0
   Projectile
   RenderStyle Add
   Decal "DoomImpScorch"
   Alpha 0.95
   SeeSound "monsters/newfireshoot"
   DeathSound "monsters/newfireexplode"
   +NOTIMEFREEZE
   States
   {
   Spawn: 
   	  TNT1 A 0 A_Weave(3,0,1.0,0.0)
      EFB2 A 1 Bright A_SpawnItemEx("ELegFiendBall2Trail")
	  TNT1 A 0 A_Weave(3,0,1.0,0.0)
      EFB2 A 1 Bright A_SpawnItemEx("ELegFiendBall2Trail")
      Loop
   Death:
	  TNT1 A 0 A_Explode(32,64)
	  TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	  TNT1 AAA 0 A_CustomMissile("EKaboomLNMute",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	  TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
      EFB2 CDE 5 Bright
      stop
   }
}

Actor ELegFiendBall2Trail
{       
  Projectile
  +NOCLIP
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  Scale 1
  Renderstyle Add
  Alpha 0.6
