Actor EnragedLegendarySuicideBomber : LegendarySuicideBomber
{
  Health 650
  Mass 250
  Speed 23
  BloodColor "Red"
  DamageFactor "LegendaryPlayer", 0.25
  //No Infighting
  DropItem "LegendaryAmmoSphere", 93
  DropItem "LegendarySphere", 64
  DropItem "LegendaryRandomSphere" 16
  DeathSound "ESuicide/death"
  Obituary "$CFEnragedLegendarySuicideBomberObit"
  Tag "$CFEnrBomb"
  var int user_pain;
  var int user_fake;
  States
  {
  Spawn:
	ESBM A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",4) == 1,"Remove")
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 A_SetUserVar(user_fake,0)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
   Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	ESBM AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	ESBM AB 2 Bright A_Wander
	TNT1 A 0 A_Look
	ESBM BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	ESBM CC 2 Bright A_Wander
	TNT1 A 0 A_Look
	ESBM CD 2 Bright A_Wander
	TNT1 A 0 A_Look
	ESBM DD 2 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  Remove:
	TNT1 A 0 A_SpawnItemEx("Demon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	Stop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ESBM AAABBB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,83)
	TNT1 A 0 A_SetUserVar("user_music",1)
	ESBM AAABBBCCCDDD 2 Bright A_Chase
	Loop
  Missile:
	ESBM AAAA 5 Bright A_FaceTarget
	Goto Missile3
  Missile3:
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_PlaySound("ESuicide/Scream",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegSuicideJumping",1)
	TNT1 A 0 A_Recoil(-15)
	ESBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	ESBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	ESBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	TNT1 A 0 A_JumpIf(z - floorz >= 64,"ChargeStop")
	ESBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	Goto Missile2
  Missile2:
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,"Missile3")
	Goto ChargeStop
  ChargeStop:
	ESBM A 1 Bright A_Stop
	TNT1 A 0 A_JumpIfInTargetLOS("Melee",90,JLOSF_DEADNOJUMP,200)
	Goto See
  PainAttack:
  Melee:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_Facetarget
	ESBM A 2 Bright A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_CustomBulletAttack(0,0,1,Random(2000,3000),"LegSBomberAttack",64)
	TNT1 A 0 A_CustomMissile("ELegZombieSuicideBomb",24,0,0,CMF_AIMDIRECTION)
	Goto Kill
  Pain:
	ESBM A 3 Bright
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ESBM A 3 Bright A_Pain
	TNT1 A 0 A_JumpIf(user_pain == 5,"PainAttack")
	TNT1 A 0 A_SetUserVar(user_pain,user_pain+1)
	Goto See
  Death:
	TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("RocketEx",0,24)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("weapons/rocklx",CHAN_BODY)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	TNT1 A 0 A_Jump(98,"ButImNotDoneYet")
	ESBM M 5 Bright
	ESBM N 5 Bright A_Scream
	ESBM O 5 A_NoBlocking
	ESBM PQRST 5
	ESBM U -1
	Stop
  Kill:
	TNT1 A 0 A_Die("Extreme")
	Goto XDeath
  XDeath:
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	TNT1 A 0 A_Jump(48,"ButImNotDoneYet")
	ESBM M 5 Bright
	ESBM N 5 Bright A_XScream
	ESBM O 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	ESBM PQRST 5
	ESBM U -1
	Stop
  XDeath2:
	ESBM M 5 Bright
	ESBM N 5 Bright A_XScream
	ESBM O 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	ESBM PQRST 5
	ESBM U 63000 CanRaise
	Stop
   ButImNotDoneYet:
	TNT1 A 0 A_JumpIf(user_fake == 1,"XDeath2")
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
	TNT1 A 0 A_ChangeFlag("SOLID",0)
	ESBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM O 5
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM P 5 A_SpawnItem("BodyCrash",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM QRST 5
	ESBM U 175
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	TNT1 A 0 A_SpawnItemEx("EBomberBeam")
	TNT1 A 0 A_ChangeFlag("SOLID",1)
	ESBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM TTTTTTTTTTTTTTT 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM OOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOO 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 Bright A_GiveInventory("EBomberEvent",1)
	ESBM MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 2 Bright A_GiveInventory("EBomberEvent",1)
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
	ESBM M 1 Bright
	TNT1 A 0 A_SetUserVar(user_fake,1)
	TNT1 A 0 A_Jump(128,"Death")
	TNT1 A 0 A_SpawnItemEx("EnragedLegendarySuicideBomberNoFake",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Stop
  LegendarySoul:
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM O 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM P 5 A_SpawnItem("BodyCrash",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ESBM QRST 5
	ESBM U 140
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	ESBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("SummonedEnragedLegendarySoul",0,0,16,0,0,0,0,32)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,32)
	ESBM U -1
	Stop
  }
}

Actor EnragedLegendarySuicideBomberNoFake : EnragedLegendarySuicideBomber
{
  States
  {
  Spawn:
	ESBM A 10 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
	ESBI A 10 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
	Loop
  Death:
	TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("RocketEx",0,24)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("weapons/rocklx",CHAN_BODY)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	ESBM M 5 Bright
	ESBM N 5 Bright A_Scream
	ESBM O 5 A_NoBlocking
	ESBM PQRST 5
	ESBM U -1
	Stop
  XDeath:
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	ESBM M 5 Bright
	ESBM N 5 Bright A_XScream
	ESBM O 5 A_NoBlocking
	ESBM PQRST 5
	ESBM U -1
	Stop
  }
}

Actor ELegZombieSuicideBomb
{
  Projectile
  Height 1
  Radius 1
  Speed 0
  +NOCLIP
  -FORCERADIUSDMG
  +FORCEXYBILLBOARD
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Die
  Death:
	TNT1 A 0
	TNT1 A 1 A_StopSound
	TNT1 A 0 A_PlaySoundEx("GoodGame/Mate","Voice",0,2)
	TNT1 A 1 A_Explode(random(8000,10000),1024,0,1,1024)
	TNT1 A 0 A_Explode(random(750,1000),2048,0,0,2048)
	TNT1 A 0 Radius_Quake(7,105,0,140,0)
	TNT1 A 0 A_SpawnItemEx("ELNukeHyperFlare",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 25 A_SpawnItemEx("CFLNukeHyperFloor",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("LNukeHyperSmokeFloor",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ELNukeHyperPillar",0,0,0,0,0,10,0,SXF_CLIENTSIDE,0)
	TNT1 A 105 A_SpawnItemEx("LNukeHyperSmokePillar",0,0,0,0,0,10,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ELNukeHyperMushroom",0,0,1000,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("LNukeHyperSmokeMushroom",0,0,1000,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 1 Bright
	Stop
  }
}

Actor ELNukeHyperFlare : CFNukeFire
{
  Scale 48
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
   {
  Spawn:
	EFLR A 1 Bright A_FadeOut(0.05,1)
	Wait
  }
}

Actor LNukeHyperFloor : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("ELNukeHyperFire",0,0,0,0,frandom(0, 9),frandom(0, 9),0,frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor ELNukeHyperFire : CFNuke
{
Scale 3
RenderStyle Add
+NOINTERACTION
+NOBLOCKMAP
-FORCEYBILLBOARD
+CLIENTSIDEONLY
+NONETID
States
	{
	Spawn:
		TNT1 A 0 Bright
		TNT1 AA 0 Bright A_Jump(256,"Spawn1","Spawn2","Spawn3")
	Spawn1:
		EFL1 A 1 Bright A_FadeOut(0.015,1)
		Wait
	Spawn2:
		EFL2 A 1 Bright A_FadeOut(0.015,1)
		Wait
	Spawn3:
		EFL3 A 1 Bright A_FadeOut(0.015,1)
		Wait
	}
}

Actor ELNukeHyperPillar : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("ELNukeHyperFire",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("LNukeHyperSmokering",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("ELNukeHyperFire",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor ELNukeHyperMushroom : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("ELNukeHyperFire",0,0,0,frandom(0,6),frandom(0,9),frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor EBomberBeam : LegCybThorStrikeBeam
{
  States
  {
  Spawn:
	TNT1 A 0 A_PlayWeaponSound("thorstrike/load")
	EHOR AAAAAAAAAA 20 Bright A_FadeIn(0.1)
	EHOR A 610 
	EHOR AAA 1 A_FadeOut(0.05)
	Wait
  }
}

Actor EBomberEvent : LegSoulEvent
{
  +FORCERADIUSDMG
  States
  {
  Pickup:
    TNT1 A 1 
	TNT1 A 1 A_SpawnItem("EBomberEventSmokeSpawner",0,0,0,0)
	TNT1 A 1 A_Explode(6,128)
    Stop	
  }
}
Actor EBomberEventSmokeSpawner : LegendaryRedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("ELFiendFlame",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}