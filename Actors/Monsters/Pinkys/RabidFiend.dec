Actor RabidFiend : BullFiend
{
  RenderStyle Translucent
  Alpha 0.5
  Health 450
  GibHealth 60
  Speed 17
  PainChance 70
  DamageFactor "Normal", 0.65
  +FLOORCLIP
  +DONTHURTSPECIES
  +FASTMELEE
  +MISSILEMORE
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "DemonAmmoPickup" 128 120
  SeeSound "blooddemon/sight"
  PainSound "blooddemon/pain"
  DeathSound "blooddemon/death"
  ActiveSound "blooddemon/active"
  AttackSound "cyberfiend/melee"
  Obituary "$CFRabidFiendObit"
  HitObituary "$CFRabidFiendHitObit"
  Tag "$CFRabFiend"
  var int user_lowlag;
  States
  {
  Spawn:
	IAR2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	IAR2 A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IAR2 AABB 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailA",frandom(-1,1), frandom(-1,1), 0)
	IAR2 A 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailA",frandom(-1,1), frandom(-1,1), 0)
	IAR2 A 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailB",frandom(-1,1), frandom(-1,1), 0)
	IAR2 B 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailB",frandom(-1,1), frandom(-1,1), 0)
	IAR2 B 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailC",frandom(-1,1), frandom(-1,1), 0)
	IAR2 C 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailC",frandom(-1,1), frandom(-1,1), 0)
	IAR2 C 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailD",frandom(-1,1), frandom(-1,1), 0)
	IAR2 D 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx ("ISpectreTrailD",frandom(-1,1), frandom(-1,1), 0)
	IAR2 D 2 Fast A_Chase
	TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
	Loop
  Melee: 
	IAR2 EF 5 A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	IAR2 G 4 A_MeleeAttack
	IAR2 E 5 A_FaceTarget
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfCloser(250,"Lunge")
	IAR2 OO 7 A_FaceTarget
	IAR2 P 7 A_FaceTarget
	IAR2 P 7 Bright A_CustomMissile("Idemoncomet", 24, 0, 0)
	Goto See
  Lunge:
	TNT1 A 0 A_JumpIfCloser(250,1)
	Goto Missile
	TNT1 A 0 A_PlaySound("demon/melee")
	IAR2 EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	IAR2 F 2 A_Recoil(-24)
	IAR2 F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	IAR2 G 6
	IAR2 G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	IAR2 G 1 A_ScaleVelocity(0)
	Goto See
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	IAR2 H 4 A_Pain
	Goto See
  Death:
  XDeath:
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAR2 I 5 
	IAR2 J 5 A_Scream
	IAR2 K 4
	IAR2 L 4 A_NoBlocking	
	IAR2 M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAR2 N -1 
	Stop
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	IAR2 NMLKJI 5 
    Goto See
  }
}

//Attacks
Actor IDemonComet : RIComet
{
  Speed 20
  FastSpeed 30
  Obituary "$CFIDemonCometObit"
  Species "Fiends"
  DamageType "DTFiendEx"
}

//After images
Actor ISpectreTrailA
{
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  RenderStyle Translucent
  Alpha 0.5
  States
  {
  Spawn:
	IAR2 A 5 A_FadeOut (0.1)
	Loop
  }
}
  
Actor ISpectreTrailB : ISpectreTrailA
{
  States
  {
  Spawn:
	IAR2 B 5 A_FadeOut (0.1)
	Loop
  }
}
  
Actor ISpectreTrailC : ISpectreTrailA
{
  States
  {
  Spawn:
	IAR2 C 5 A_FadeOut (0.1)
	Loop
  }
}
  
Actor ISpectreTrailD : ISpectreTrailA
{
  States
  {
  Spawn:
	IAR2 D 5 A_FadeOut (0.1)
	Loop
  }
}