Actor NemesisSuicideBomber : LegendarySuicideBomber
{
  Health 750
  Speed 6
  BloodColor "Black"
  DamageType "Nemesis"
  DamageFactor 0.6
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Explosion", 0.2
  DamageFactor "PlayerDTRG", 0.4
  DamageFactor "DTRailgun", 0.4
  DamageFactor "PDTPuff", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "T3rm", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "Superweapon", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DropItem "LegendaryAmmoSphere", 93, 3
  DropItem "EnragedLegendarySphere", 64
  DeathSound "NemesisSuicide/Oof"
  Obituary "$CFNemesisSuicideBomberObit"
  Tag "$CFNemBomb"
  var int user_pain;
  States
  {
  Spawn:
	NSBM A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",4) == 1,"Remove")
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	NSBM A 10 Bright A_Look
	NSBI A 10 Bright A_Look
	Loop
  Remove:
	TNT1 A 0 A_SpawnItemEx("Demon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	Stop
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	NSBM AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	NSBM AB 2 Bright A_Wander
	TNT1 A 0 A_Look
	NSBM BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	NSBM CC 2 Bright A_Wander
	TNT1 A 0 A_Look
	NSBM CD 2 Bright A_Wander
	TNT1 A 0 A_Look
	NSBM DD 2 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NSBM AAABBB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,74)
	TNT1 A 0 A_SetUserVar("user_music",1)
	NSBM AAABBBCCCDDD 2 Bright A_Chase
	TNT1 A 0 A_Jump(24,"Teleport")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	NSBM A 1 Bright A_UnSetShootable
	NSBM AAAAAAAAAA 1  A_FadeOut(0.1,0)
	NSBM A 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    NSBM A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NSBM AAAAAAAAAAA 1 A_FadeIn(0.1)
    NSBM A 1 Bright A_SetShootable
    Goto See
  Missile:
	NSBM AA 5 Bright A_FaceTarget
	Goto Missile3
  Missile3:
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_PlaySound("NemesisSuicide/Blyat",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegSuicideJumping",1)
	TNT1 A 0 A_Recoil(-30)
	NSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	NSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	NSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	TNT1 A 0 A_JumpIf(z - floorz >= 64,"ChargeStop")
	NSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	Goto Missile2
  Missile2:
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,"Missile3")
	Goto ChargeStop
  ChargeStop:
	NSBM A 1 Bright A_Stop
	TNT1 A 0 A_JumpIfInTargetLOS("Melee",90,JLOSF_DEADNOJUMP,200)
	Goto See
  PainAttack:
  Melee:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	NSBM A 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Black/Blast",6,1.0,0)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleSpawn",0,0,0,0,0,0,0,SXF_SETMASTER,0) //SXF_TRANSFERPOINTERS|
	TNT1 A 0 A_SpawnItemEx("PBlackHoleSpawnDark",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItem("NemesisDeathBall")
	Goto Kill
  Pain:
	NSBM A 3 Bright
	NSBM A 3 Bright A_Pain
	TNT1 A 0 A_JumpIf(user_pain == 5,"PainAttack")
	TNT1 A 0 A_SetUserVar(user_pain,user_pain+1)
	Goto See
  Death:
	TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("RocketEx",0,24)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("weapons/rocklx",CHAN_BODY)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	TNT1 A 0 A_Jump(98,"BadIdea")
	NSBM M 5 Bright
	NSBM N 5 Bright A_Scream
	NSBM O 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	NSBM PQRST 5
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NSBM U -1
	Stop
  Kill:
	TNT1 A 0 A_Die("Extreme")
	Goto XDeath
  XDeath:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	//TNT1 A 0 A_Jump(48,"BadIdea")  //causes problems because of the black hole succ
	NSBM M 5 Bright
	NSBM N 5 Bright A_XScream
	NSBM O 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	NSBM PQRST 5
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NSBM U -1
	Stop
  MoreStuff:
	NSBM U 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack")
	NSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 1 A_SpawnItem("NemesisZombieItemRandomizer")
	NSBM U 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	NSBM U -1
	Stop
  BadIdea:
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM O 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM P 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM QRST 5
	NSBM U 175
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	NSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM OOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOO 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	NSBM MMMMMMMMMMMMMMM 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	//TNT1 A 0 A_Jump(92,"Death")
	NSBM A 3 Bright
	TNT1 A 0 A_SpawnItemEx("NemesisLightning")
	NSBM AAAAAAAAAAAA 2 Bright A_SpawnItemEx("VexedNemesisFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("VexedNemesisSuicideBomber",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop
  LegendarySoul:
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM O 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM P 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	NSBM QRST 5
	NSBM U 140
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	NSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("SummonedNemesisSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	NSBM U -1
	Stop
  }
}

Actor VexedNemesisSuicideBomber : NemesisSuicideBomber
{
  Speed 6
  DamageFactor 0.5
  DamageFactor "Explosion", 0.0001
  DamageFactor "PlayerDTRG", 0.0001
  DamageFactor "DTRailgun", 0.0001
  DamageFactor "PDTPuff", 0.0001
  DamageFactor "RailG", 0.0001
  PainChance "Explosion", 128
  PainChance "PlayerDTRG", 128
  PainChance "DTRailgun", 128
  PainChance "PDTPuff", 128
  PainChance "RailG", 128
  Obituary "$CFVexedNemesisSuicideBomberObit"
  Tag "$CFVexBomb"
  States
  {
  Spawn:
	VSBM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	VSBM A 10 Bright A_Look
	VSBI A 10 Bright A_Look
	Loop
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	VSBM AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	VSBM AB 2 Bright A_Wander
	TNT1 A 0 A_Look
	VSBM BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	VSBM CC 2 Bright A_Wander
	TNT1 A 0 A_Look
	VSBM CD 2 Bright A_Wander
	TNT1 A 0 A_Look
	VSBM DD 2 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,74)
	TNT1 A 0 A_SetUserVar("user_music",1)
	VSBM AAABBBCCCDDD 2 Bright A_Chase
	TNT1 A 0 A_Jump(24,"Teleport")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	VSBM A 1 Bright A_UnSetShootable
	VSBM AAAAAAAAAA 1  A_FadeOut(0.1,0)
	VSBM A 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    VSBM A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	VSBM AAAAAAAAAAA 1 A_FadeIn(0.1)
    VSBM A 1 Bright A_SetShootable
    Goto See
  Missile:
	VSBM AAAAAAAAAA 1 Bright A_FaceTarget
	Goto Missile3
  Missile3:
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_PlaySound("NemesisSuicide/Blyat",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegSuicideJumping",1)
	TNT1 A 0 A_Recoil(-30)
	VSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	VSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	VSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-30)
	TNT1 A 0 A_JumpIf(z - floorz >= 64,"ChargeStop")
	VSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	Goto Missile2
  Missile2:
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,"Missile3")
	Goto ChargeStop
  ChargeStop:
	VSBM A 1 Bright A_Stop
	TNT1 A 0 A_JumpIfInTargetLOS("Melee",90,JLOSF_DEADNOJUMP,200)
	Goto See
  PainAttack:
  Melee:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	VSBM A 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Black/Blast",6,1.0,0)
	TNT1 A 0 A_SpawnItemEx("BarrelBlackHoleSpawn",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	TNT1 A 0 A_SpawnItemEx("PBlackHoleSpawnDark",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_CustomMissile("NemesisSuicideBomberBurst",32,0,0,2)
	TNT1 A 0 A_SpawnItem("NemesisDeathBall")
	Goto Kill
  Pain:
	VSBM A 3 Bright
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VSBM A 3 Bright A_Pain
	TNT1 A 0 A_JumpIf(user_pain == 5,"PainAttack")
	TNT1 A 0 A_SetUserVar(user_pain,user_pain+1)
	Goto See
  Death:
	TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("RocketEx",0,24)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("weapons/rocklx",CHAN_BODY)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	VSBM M 5 Bright
	VSBM N 5 Bright A_Scream
	VSBM O 5 A_NoBlocking
	VSBM PQRST 5
	TNT1 A 0 A_Jump(100,"MoreStuff")
	VSBM U -1
	Stop
  Kill:
	TNT1 A 0 A_Die("Extreme")
	Goto XDeath
  XDeath:
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	VSBM M 5 Bright
	VSBM N 5 Bright A_XScream
	VSBM O 5 A_NoBlocking
	VSBM PQRST 5
	TNT1 A 0 A_Jump(100,"MoreStuff")
	VSBM U -1
	Stop
  MoreStuff:
	VSBM U 100
	TNT1 A 0 A_SpawnItem("HellionSmokeAttack")
	VSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 1 A_SpawnItem("NemesisZombieItemRandomizer")
	VSBM U 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	VSBM U -1
	Stop
  LegendarySoul:
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VSBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VSBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VSBM O 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VSBM P 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	VSBM QRST 5
	VSBM U 140
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	VSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("SummonedVexedNemesisSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	VSBM U -1
	Stop
  }
}



Actor NemesisSuicideBomberBurst : MiniNemesisBFGBall
{
  Species "Fiends"
  DamageType "Nemesis"
  States
  {
  Spawn:
  Death:
	TNT1 AAAAAAAAAAAAAAAAAAAAAA 4 A_CustomMissile("NemesisCyberBouncyBFG",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-5,30))
    Stop
  }
}