Actor ToxicFiend : BullFiend 16660
{ 
  //$Category Monsters/LCA
  //$Sprite TOXDA1C1
  //$Title "Toxic Fiend"
  Health 350
  PainChance 55
  Speed 16
  Scale 1.1
  MaxTargetRange 790
  SeeSound "magma/sight"
  PainSound "monster/psopain"
  DeathSound "magma/death"
  ActiveSound "magma/active"
  AttackSound "magma/attack"
  DropItem "LifeEssence" 256
  DropItem "ArmorBonusMax" 256
  DropItem "BossLifeEssence" 128
  DropItem "BossArmorBonusMax" 128
  DropItem "DemonAmmoPickup" 132 120
  DropItem "DemonAmmoBoxPickup" 32 200
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "PoisonCloud", 0.0
  Obituary "$CFToxicFiendObit"
  HitObituary "$CFToxicFiendHitObit"
  BloodColor "Green"
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FASTMELEE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Tag "$CFToxicFiend"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States 
  { 
  Spawn: 
	TOXD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TOXD A 12 Bright A_Look
	TAI3 A 12 Bright A_Look
    Loop
  See: 
	TNT1 A 0 A_SetUserVar("user_effect_type",4)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    TOXD AABB 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    TOXD CCDD 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    Loop 
  Melee: 
    TOXD EF 5 Bright A_FaceTarget
    TOXD G 4 Bright A_MeleeAttack
    TOXD E 5 Bright A_FaceTarget
    Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"Lunge","ToxicBreath","ToxicSwirlBall")
  Normal:
	TOXD GE 10 Bright A_FaceTarget		
	TOXD F 8 Bright A_CustomMissile("ToxicComet", 32, 0, 0)
	TOXD E 6 Bright
	Goto See
  ToxicSwirlBall:
	TOXD GE 10 Bright A_FaceTarget		
	TOXD F 8 Bright A_CustomMissile("ToxicSwirlComet", 32, 0, 0)
	TOXD E 8 Bright
	Goto See
  Lunge:
	TNT1 A 0 A_JumpIfCloser(355,1)
	Goto See
	TNT1 A 0 A_PlaySound("magma/attack")
	TOXD EF 7 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	TOXD F 2 Bright A_Recoil(-30)
	TOXD F 3 Bright A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	TOXD G 6 Bright
	TOXD G 2 Bright A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TOXD G 1 Bright A_ScaleVelocity(0)
	Goto See
  ToxicBreath:
	TNT1 A 0 A_JumpIfCloser(300,1)
	Goto See
	TOXD EF 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Daedabus/Chem")
	TOXD FFF 2 Bright A_CustomMissile("ToxicChemSpray", 32, 0, frandom(-6,-6))
	TNT1 A 0 A_FaceTarget
	TOXD FFF 2 Bright A_CustomMissile("ToxicChemSpray", 32, 0, frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	TOXD FFF 2 Bright A_CustomMissile("ToxicChemSpray", 32, 0, frandom(-6,6))
	TNT1 A 0 A_FaceTarget		
	TOXD FFF 2 Bright A_CustomMissile("ToxicChemSpray", 32, 0, frandom(-6,6))
	TOXD E 5 Bright
	Goto See
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    TOXD H 4 Bright A_Pain
    Goto See
  Death: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    TOXD I 5 
    TOXD J 5 A_Scream
    TOXD K 4
    TOXD L 4 A_NoBlocking     
    TOXD M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TOXD N -1 
    Stop
  XDeath:
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	TOXD I 3 A_XScream
    TOXG A 3 A_GiveInventory("XDeathCheck",1)
    TOXG B 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TOXG C 3 A_NoBlocking
    TOXG D 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ToxicFiendPoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))	 
	TOXG EFG 3
    TOXG H -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    TOXD NMLKJI 5 
    Goto See 
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TOXG HGFEDCBA 4
	Goto See
  }
}

Actor SummonedToxicFiend : ToxicFiend { -COUNTKILL }

Actor ToxicFiendPoison : BarbatosPoison
{ 
  Species "Fiends"
  DamageType "DTFiendEx"
  States 
  { 
  Spawn: 
    TNT1 A 0
	TNT1 A Random(3,5)
	TRPS ABCDEFGDFEGDF 3 //A_Explode(2,68)
  Death: 
	TRPS CCBBAA 1 //A_FadeOut(0.15)
    Stop 
  }
}

Actor ToxicComet : BarbatosComet
{
  DamageType "DTFiendEx"
  States
  {
  Spawn:
	BRTB AAABBB 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BRTB C 3 Bright A_Explode(42,102)
	BRTB D 3 Bright A_SetTranslucent(0.75,1)
	TNT1 AAAAA 0 A_SpawnItemEx("ToxicFiendPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4))
	BRTB EFG 3 Bright
	Stop
  }
}

Actor ToxicSwirlComet : ToxicComet
{
  Damage 8
  +SEEKERMISSILE
  +NOBOSSRIP
  +BLOODLESSIMPACT
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(16,0)
	TNT1 A 0 A_BishopMissileWeave
	BRTB A 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_BishopMissileWeave
	BRTB B 1 Bright A_SpawnItemEx("BarbCometTail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	BRTB C 3 Bright A_Explode(45,128)
	BRTB D 3 Bright A_SetTranslucent(0.75,1)
	TNT1 AAAAA 0 A_SpawnItemEx("ToxicFiendPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4))
	BRTB EFG 3 Bright
	Stop
  }
}

Actor ToxicChemSpray : DaedabusChemSpray
{ 
  Species "Fiends"
  DamageType "DTFiendEx"
  States 
  { 
  Spawn:
    TNT1 A 0
	TNT1 A Random(3,5)
	TRPS ABCDEFGDFEG 3 //A_Explode(2,68)
  Death: 
	TRPS CCBBAA 1 //A_FadeOut(0.15)
    Stop 
  } 
}

Actor GHellionSmokeSpawnerFiend : RedParticleSpawner
{
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("GHellionSmokeTx",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor GHellionSmokeTx : GHellionSmoke { Scale 0.3 }