Actor PhaseNightmare 13337
{
  Height 48
  Radius 24
  Health 700
  PainChance 15
  Speed 15
  Mass 20 //kek
  Species "Fiends"
  RenderStyle Normal
  +SHADOW
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOICEDEATH //prevents cheesy freezer rifle from making him un-ressable
  +AVOIDMELEE
  +NOFEAR
  Monster
  BloodColor "51 07 94"
  Scale 1.15
  MaxTargetRange 1250
  MeleeDamage 12
  DamageFactor 0.75
  DamageFactor "PlayerDTRG", 0.8
  DamageFactor "legendary", 0.25
  DamageFactor "NobleComet", 0.0
  DamageFactor "legendaryplayer", 0.25
  DamageFactor "legendaryguru", 0.25
  DamageFactor "legendaryguruplayer", 0.25
  DamageFactor "Ice", 0.4
  DamageFactor "PlayerIce", 0.4
  DamageFactor "PlayerIce", 0.4
  DamageFactor "FreezerBurn", 0.4
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "PlayerLegendary", 0.25
  PainChance "SoulToxic", 5
  PainChance "FatFlamer", 5
  PainChance "legendaryplayer", 128
  PainChance "legendaryguruplayer", 128
  DropItem "BossLifeEssence" 104 25
  DropItem "BossArmorBonusMax" 104 1
  DropItem "DemonAmmoPickup" 256 60
  DropItem "PhaseSphere" 
  SeeSound "LegFiend/Sight"
  PainSound "LegFiend/Pain"
  DeathSound "LegFiend/Death"
  ActiveSound "LegFiend/Active"
  AttackSound "LegFiend/Melee"
  Obituary "$CFPhaseNightmareObit"
  HitObituary "$CFPhaseNightmareHitObit"
  Tag "$CFPhFiend"
  var int user_lowlag;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("PhaseIdleToken", 11)
    TNT1 A 0 A_SpawnItemEx("PhaseNightmareASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 2 A_Look
	TNT1 A 0 A_GiveInventory("PhaseIdleToken", 1)
	TNT1 A 0 A_JumpIfInventory("PhaseIdleToken", 11, "spawn2")
	Goto Idle
  Spawn2:
    TNT1 A 0 A_TakeInventory("PhaseIdleToken", 11)
    TNT1 A 0 A_SpawnItemEx("PhaseNightmareQSpawner")
	TNT1 A 2 A_Look
	TNT1 A 0 A_GiveInventory("PhaseIdleToken", 1)
	TNT1 A 0 A_JumpIfInventory("PhaseIdleToken", 11, "spawn2")
	Goto Idle
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 AAABBB 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIfInventory("PhaseNightmareRageToken", 1, "seerage")
    TNT1 A 1 A_SpawnItemEx("PhaseNightmareASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Chase
	TNT1 A 1 A_SpawnItemEx("PhaseNightmareASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Chase
	TNT1 A 1 A_SpawnItemEx("PhaseNightmareASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Chase
	TNT1 A 1 A_SpawnItemEx("PhaseNightmareASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Chase
	TNT1 B 1 A_SpawnItemEx("PhaseNightmareBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 B 0 A_Chase
	TNT1 B 1 A_SpawnItemEx("PhaseNightmareBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 B 0 A_Chase
	TNT1 B 1 A_SpawnItemEx("PhaseNightmareBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 B 0 A_Chase
	TNT1 B 1 A_SpawnItemEx("PhaseNightmareBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 B 0 A_Chase
	TNT1 C 1 A_SpawnItemEx("PhaseNightmareCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 C 0 A_Chase
	TNT1 C 1 A_SpawnItemEx("PhaseNightmareCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 C 0 A_Chase
	TNT1 C 1 A_SpawnItemEx("PhaseNightmareCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 C 0 A_Chase
	TNT1 C 1 A_SpawnItemEx("PhaseNightmareCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 C 0 A_Chase
	TNT1 D 1 A_SpawnItemEx("PhaseNightmareDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 D 0 A_Chase
	TNT1 D 1 A_SpawnItemEx("PhaseNightmareDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 D 0 A_Chase
	TNT1 D 1 A_SpawnItemEx("PhaseNightmareDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 D 0 A_Chase
	TNT1 D 1 A_SpawnItemEx("PhaseNightmareDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 D 0 A_Chase
	Loop
  SeeRage:
    PSPC A 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC A 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC B 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC B 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC C 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC C 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC D 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	PSPC D 1 A_Chase("", "")
	PSPC A 0 ThrustThing(random(0, 359), random(1, 3))
	PSPC AA 0 A_Wander
	TNT1 A 0 A_TakeInventory("PhaseNightmareRageToken", 1)
	Goto See
  Melee:
    TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	PSPC EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    PSPC E 0 A_FaceTarget
	PSPC FFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PSPC F 0 A_MeleeAttack
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	PSPC FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAA 0  A_Wander
  Missile:
    TNT1 A 0 A_JumpIfCloser(250, "PhaseLunge")
	TNT1 A 0 A_JumpIfCloser(500, "MissileMedium")
	TNT1 A 0 A_JumpIfCloser(750, "PhaseAttack")
	TNT1 A 0 A_JumpIfCloser(1100, "PhaseAttack2")
	Goto PhaseLunge
  MissileMedium:
    TNT1 A 0 A_Jump(96, "PhaseLunge")
	Goto PhaseAttack
  PhaseLunge:
    PSPC A 0 A_JumpIfCloser(250, "PhaseLunge2")
	Goto See
  PhaseLunge2:
    TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	PSPC EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 ThrustThingZ(0,25,0,1)
	PSPC FF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 F 0 A_Recoil(-30)
	PSPC FFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 F 0 A_CustomMissile("PhasePinkyLunge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_GiveInventory("Health",10)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	PSPC FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAA 0  A_Wander
	TNT1 A 0 A_Recoil(0.1)
	Goto See
  PhaseAttack:
    TNT1 AAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 E 0 A_FaceTarget
	TNT1 E 0 A_Wander
	TNT1 FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 F 0 A_FaceTarget
	TNT1 F 0 A_Wander
	TNT1 A 0 A_PlaySound("monsters/newfireshoot")
	TNT1 A 0 A_Jump(96, "PhaseAttack2")
	TNT1 A 0 A_Jump(55, "PhaseAttack3")
	TNT1 A 0 A_Jump(256, 0,1,2,3,4)
	TNT1 AAAAA 0 A_CustomMissile("PhaseNightmareBall", 32, 0, frandom(-6, 6), CMF_OFFSETPITCH, frandom(-6, 6))
	TNT1 GGGGGGGG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GGGG 0 A_Wander
	Goto See
  PhaseAttack2:
    TNT1 A 0 A_CustomMissile("PhaseNightmareBall2", 32, 0, -10)
	TNT1 A 0 A_CustomMissile("PhaseNightmareBall2", 32, 0, 10)
	TNT1 A 0 A_CustomMissile("PhaseNightmareBall2", 32, 0, 0)
	TNT1 GGGGGGGG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GGGG 0 A_Wander
	Goto See
   PhaseAttack3:
    TNT1 AAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 E 0 A_FaceTarget
	TNT1 E 0 A_Wander
	TNT1 FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 F 0 A_FaceTarget
	TNT1 F 0 A_Wander
	TNT1 A 0 A_PlaySound("monsters/newfireshoot")
	TNT1 A 0 A_Jump(256, 0,1,2,3,4)
	TNT1 AAA 0 A_CustomMissile("DarkMatterBallMini", 32, 0, frandom(-6, 6), CMF_OFFSETPITCH, frandom(-6,6))
	TNT1 GGGGGGGG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GGGG 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	Goto See
  Pain:
    TNT1 A 0 A_TakeInventory("PhaseNightmareLungeToken", 4)
    TNT1 A 0 A_Pain
	TNT1 A 0 A_GiveInventory("PhaseNightmareRageToken", frandom(2, 4))
	TNT1 A 10 A_SpawnItemEx("PhaseNightmarePain")
	Goto Seerage
  Pain.Legendary:
  Pain.LegendaryGuru:
    TNT1 A 0 A_TakeInventory("PhaseNightmareLungeToken", 4)
    TNT1 A 0 A_Pain
	TNT1 A 0 A_GiveInventory("PhaseNightmareRageToken", frandom(3, 5))
	TNT1 A 1 A_SpawnItemEx("PhaseNightmarePain")
	Goto SeeRage
  XDeath:
  Death:
    PSPC AAAA 0 A_SpawnItemEx("PhaseNightmareBall3", 0, 0, 16, frandom(-2.5, 2.5), frandom(-2.5, 2.5), frandom(7.3, 10.3))
    PSPC A 0 A_SetTranslucent(0.333, 0)
	PSPC I 8 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PSPC J 8 A_Scream
	PSPC K 4
	PSPC L 4 A_NoBlocking
	PSPC M 4
    PSPC N -1
	Stop
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	PSPC MLKJJII 4
	Goto See
  }
}

Actor CorruptedPhaseNightmare: PhaseNightmare
{
  Species "Nobles"
  DamageFactor "NobleComet", 0.0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CadaverRocket", 0.0
  Tag "Corrupted Phase Exile"
  +DONTHURTSPECIES
  +THRUSPECIES
  -COUNTKILL
  States
  {
  Melee:
    TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	PSPC EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    PSPC E 0 A_FaceTarget
	PSPC FFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	PSPC F 0 A_MeleeAttack
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	PSPC FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAA 0  A_Wander
  Missile:
    TNT1 A 0 A_JumpIfCloser(250, "PhaseLunge")
	TNT1 A 0 A_JumpIfCloser(500, "MissileMedium")
	TNT1 A 0 A_JumpIfCloser(750, "PhaseAttack")
	TNT1 A 0 A_JumpIfCloser(1100, "PhaseAttack2")
	Goto PhaseLunge
  PhaseLunge2:
    TNT1 EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	PSPC EEEE 1 A_SpawnItemEx("PhaseNightmareESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 ThrustThingZ(0,25,0,1)
	PSPC FF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 F 0 A_Recoil(-30)
	PSPC FFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 F 0 A_CustomMissile("PhasePinkyLunge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_GiveInventory("Health",10)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
	PSPC FFFF 1 A_SpawnItemEx("PhaseNightmareFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 GG 1 A_SpawnItemEx("PhaseNightmareGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAA 0  A_Wander
	Goto See
  }
}

Actor PhaseNightmareBall : PhaseImpBall
{
  Species "Fiends"
  DamageType "FiendFire"
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(4,2)
	TNT1 A 0 A_Weave(random(-2, 2), random(-2, 2), random(-2, 2), random(-2, 2))
    DIMB A 1 Bright A_SpawnItemEx("PhaseBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Weave(random(-2, 2), random(-2, 2), random(-2, 2), random(-2, 2))
    DIMB B 1 Bright A_SpawnItemEx("PhaseBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  }
}

Actor PhaseNightmareBall2 : PhaseNightmareBall
{
  Damage (Random(5,10))
  Speed 8
  States
  {
  Spawn:
    TNT1 A 0 A_SeekerMissile(4, 4)
    TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	PFRT A 1 Bright A_SpawnItemEx("PhaseBallTrail2")
	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	PFRT A 1 Bright A_SpawnItemEx("PhaseBallTrail2")
	
	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	PFRT B 1 Bright A_SpawnItemEx("PhaseBallTrail2")
	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	PFRT B 1 Bright A_SpawnItemEx("PhaseBallTrail2")
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    PFRT CDEFG 2 Bright
    Stop
  }
}

Actor PhaseNightmareBall3 : PhaseNightmareBall2 
{ 
  -NOGRAVITY 
  Gravity 0.666
  States
  {
  Spawn:
    TNT1 A 0
	PRFT AABB 1 Bright A_SpawnItemEx("PhaseBallTrail2")
	Loop
  }
}

Actor PhaseBallTrail2 : PhaseBallTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    PFRT AABBAABB 1 A_FadeOut(0.1)
	Stop
  }
}

Actor PhasePinkyLunge
{
  Height 16
  Radius 16
  Speed 30
  Damage (random(36, 64))
  Species "Fiends"
  DamageType "FiendFire"
  SeeSound ""  
  DeathSound ""
  Projectile
  States
  {
  Spawn:
	TNT1 A 4
    Stop
  }
}

Actor PhaseMindfuck : CustomInventory
{
  Inventory.MaxAmount 0
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +NOTIMEFREEZE
  States
  {
  Pickup:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("PhaseCheck") == 1,"Null")
	TNT1 A 0 A_RailWait
	TNT1 A 0 A_SetBlend("790FCB", 0.75, 50)
	TNT1 A 0 A_SetAngle(angle+frandom(-20.0, 20.0))
	TNT1 A 0 A_SetPitch(pitch+frandom(-10.0, 10.0))
	Stop
  }
} 

Actor PhaseNightmareASpawner
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  Scale 1.15
  Renderstyle Translucent
  Alpha 0.5
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PhaseNightmareA", 0, 0, -20, frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(3, 6.5))
	Stop
  }
}

Actor PhaseNightmareBSpawner : PhaseNightmareASpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PhaseNightmareB", 0, 0, -20, frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(3, 6.5))
	Stop
  }
}

Actor PhaseNightmareCSpawner : PhaseNightmareASpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PhaseNightmareC", 0, 0, -20, frandom(-1.5, 1.5), frandom(-1.5, 1.5), frandom(3, 6.5))
	Stop
  }
}

Actor PhaseNightmareDSpawner : PhaseNightmareASpawner
{
  States
  {
