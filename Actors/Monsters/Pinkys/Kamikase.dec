Actor RMSuicideBomber
{
  Obituary "$CFSuicideBomberObit"
  Health 200
  Radius 20
  Height 56
  Mass 150
  Speed 15
  PainChance 20
  Species ""
  DropItem "PortableMedkit" 120
  DropItem "ArmorPlate" 120
  DropItem "AmmoPack" 80
  DropItem "MissilePickup" 256 5
  DropItem "HandGrenadeAmmo" 200 1
  DropItem "MineAmmoRandomizer" 100 1
  SeeSound "suicide/sit"
  AttackSound "shotguy/death"
  PainSound "shotguy/pain"
  DeathSound "shotguy/death"
  Tag "$CFBomb"
  Monster
  +FLOORCLIP
  +MISSILEMORE
  States
  {
  Spawn:
    ZBMB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ZBMB A 10 A_Look
	ZBMI A 10 A_Look
    Loop
  See:
    ZBMB AAABBBCCCDDD 2 A_Chase
    ZBMB A 0 A_PlaySound("suicide/loop")
    Loop
  Missile:
    ZBMB A 1 A_PlayWeaponSound("suicide/run")
    ZBMB AAAA 5 A_FaceTarget
	ZBMB A 1 A_Jump(256,2)
	ZBMB A 0 A_JumpIf(velx != 0 || vely != 0,1)
	Goto ChargeStop
	ZBMB A 0 A_CposRefire
	ZCHW D 0 A_PlayWeaponSound("suicide/loop")
	ZBMB A 0 A_FaceTarget
	ZBMB A 0 A_GiveInventory("SuicideJumping",1)
    ZBMB A 0 A_Recoil(-11)
    ZBMB ABCD 1 A_JumpIfCloser(90,"Melee")
	ZBMB A 0 A_FaceTarget
	ZBMB A 0 A_Recoil(-11)
    ZBMB ABCD 1 A_JumpIfCloser(90,"Melee")
	ZBMB A 0 A_FaceTarget
	ZBMB A 0 A_Recoil(-11)
    ZBMB ABCD 1 A_JumpIfCloser(90,"Melee")
	ZBMB A 0 A_FaceTarget
	ZBMB A 0 A_Recoil(-11)
	ZBMB A 0 A_JumpIf(z - floorz >= 64,"ChargeStop")
    ZBMB ABCD 1 A_JumpIfCloser(90,"Melee")
    Goto Missile+6
  ChargeStop:
    ZBMB A 1 A_Stop
    Goto See		
  Melee:
    ZBMB A 2 A_Die
    Stop
  Pain:
    ZBMB A 3
    ZBMB A 3 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("RocketEx",0,24)
	TNT1 A 0 A_Stop
    ZBMB M 5 Bright A_PlaySound("weapons/rocklx")
    ZBMB N 5 Bright A_XScream
    ZBMB O 5 A_NoBlocking
    ZBMB PQRST 5
    ZBMB U -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    ZBMB TSRQPONM 3
	Goto See	
  }
}

Actor SuicideJumping : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
    TNT1 A 0
    TNT1 A 0 A_CheckFloor(1)
    Stop
	TNT1 A 0 A_Jump(160,2)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
    Stop
	TNT1 A 0
    Stop
  }
}

Actor SuicideBomb
{
  Projectile
  Speed 0
  Damage 0
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0 
	TNT1 A 0 A_Explode(Random(90,120),164)
    Stop
  }
}