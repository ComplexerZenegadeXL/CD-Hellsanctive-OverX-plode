Actor FacelessSpectre : BullFiend
{
  Renderstyle Translucent
  Alpha 0.1
  Radius 25
  Health 450
  Scale 1.1
  MeleeDamage 10
  DropItem "HasteSphere"
  DropItem "ArmorPlate"
  SeeSound "LegFiend/Sight"
  PainSound "LegFiend/Pain"
  DeathSound "LegFiend/Death"
  ActiveSound "LegFiend/Active"
  AttackSound "LegFiend/Melee"
  HitObituary "$CFFacelessSpectreHitObit"
  PainChance 30
  Speed 12
  Tag "$CFFaceless"
  States
  {
  Spawn: 
	PSPE A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle: 
	PSPE E 0 A_SetTranslucent(0.1)
	PSPE A 10 A_Look
	Loop
  See: 
	TNT1 A 0 A_JumpIfInventory("IHaveNeverBeenToSpaceBefore", 1, "Boost")
	PSPE E 0 A_SetTranslucent(0.1)
    PSPE AABBCCDD 2 A_Chase
    Loop 
  Boost:
	PSPE E 0 A_SetTranslucent(0.1)
    PSPE AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_Chase
    Goto See
  Melee: 
	PSPE E 0 A_SetTranslucent(0.3)
	TNT1 A 0 A_Recoil(-3.0) 
    PSPE EF 5 Fast A_FaceTarget
    PSPE G 4 A_CustomMeleeAttack(random(20,30),"LegFiend/Melee")  //A_MeleeAttack
	TNT1 A 0 A_GiveToTarget("FlessSpectreSlow",1)
	TNT1 A 0 A_GiveInventory("Health",10)
	TNT1 A 0 A_GiveInventory("IHaveNeverBeenToSpaceBefore")
    PSPE E 5 A_FaceTarget
    Goto See
  Missile:
	PSPE E 0 A_SetTranslucent(0.1)
	TNT1 A 0 A_JumpIfInventory("ShadowToken",0,"Lunge")
	TNT1 A 0 A_Jump(64,"Shadows")
  Lunge:
	TNT1 A 0 A_JumpIfCloser(450,1)
	Goto See
	PSPE E 0 A_SetTranslucent(0.3)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	PSPE EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	PSPE F 2 A_Recoil(-28)
	PSPE F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	PSPE G 6
	PSPE G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	PSPE G 1 A_ScaleVelocity(0)
	Goto See
  Shadows:
	PSPE A 5 A_SpawnItemEx("FacelessSpectreShadow",0,0,0,0,0,0,0,SXF_SETMASTER)
	Goto See
  Pain: 
	PSPE E 0 A_SetTranslucent(0.11)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    PSPE H 4 A_Pain
    Goto See
  XDeath:
  Death: 
	PSPE E 0
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    PSPE I 5 
    PSPE J 5 A_Scream
    PSPE K 4
    PSPE L 4 A_NoBlocking     
    PSPE M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    PSPE N -1 
    Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    PSPE NMLKJI 5 
    Goto See 
  }
}

Actor FacelessSpectreShadow : FacelessSpectre
{
  Health 450
  DamageFactor 10
  +THRUSPECIES
  -COUNTKILL
  DropItem ""
  States
  {
  Spawn: 
	PSPE A 0
	TNT1 A 0 A_GiveInventory("ShadowToken",1,AAPTR_MASTER)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle: 
	PSPE E 0 A_SetTranslucent(0.1)
	PSPE A 10 A_Look
	Loop
  Melee: 
	PSPE E 0 A_SetTranslucent(0.3)
	TNT1 A 0 A_Recoil(-3.0) 
    PSPE EF 5 Fast A_FaceTarget
    PSPE G 4 A_CustomMeleeAttack(random(10,20),"LegFiend/Melee")  //A_MeleeAttack
	TNT1 A 0 A_GiveToTarget("FlessSpectreSlow",1)
	TNT1 A 0 A_GiveInventory("Health",5)
	TNT1 A 0 A_GiveInventory("IHaveNeverBeenToSpaceBefore")
    PSPE E 5 A_FaceTarget
    Goto See
  Missile:
	PSPE E 0 A_SetTranslucent(0.1)
  Lunge:
	TNT1 A 0 A_JumpIfCloser(450,1)
	Goto See
	PSPE E 0 A_SetTranslucent(0.3)
	TNT1 A 0 A_PlaySound("LegFiend/Melee")
	PSPE EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	PSPE F 2 A_Recoil(-28)
	PSPE F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	PSPE G 6
	PSPE G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	PSPE G 1 A_ScaleVelocity(0)
	Goto See
  XDeath:
  Death: 
	PSPE E 0
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    PSPE I 5 A_TakeInventory("ShadowToken",1,0,AAPTR_MASTER)
    PSPE J 5 A_Scream
    PSPE K 4
    PSPE L 4 A_NoBlocking     
    PSPE M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    PSPE N -1
    Stop
  }
}

Actor FlessSpectreSlow : CustomInventory 
{
  +AUTOACTIVATE
  +ALWAYSPICKUP
  States 
  {
  Use:
	TNT1 A 0 A_SetBlend("128 0 0", 0.9, 70)
	TNT1 A 0 A_GiveInventory("DebuffMS")
	Stop
  }	
}
	
Actor DebuffMS : PowerSpeed
{
  Powerup.Duration -5
  Speed 0.75
  +POWERSPEED.NOTRAIL
}
 
Actor IHaveNeverBeenToSpaceBefore : Inventory {}
Actor ShadowToken : Inventory { Inventory.MaxAmount 10 }