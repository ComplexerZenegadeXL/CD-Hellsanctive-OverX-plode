//=================
// Legendary Barrel
//=================

Actor LegendaryBarrel : ModdedExplosiveBarrel 30335
{
  Scale 1.2
  +FORCERADIUSDMG
  DamageType "Legendary"
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "LegendaryPlayer", 0.0
  Tag "$CFLegendaryBarrel"
  States
  {
  Spawn:
	LB4R ABC 8 Bright A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	Loop
  Death:
	LB4R D 5 A_StopSound
	LB4R EFG 5  //55 total
	TNT1 A 0 A_SetDamageType("Legendary")
	TNT1 A 0 A_UnSetSolid
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_Explode(Random(10000,12000),1536,XF_NOTMISSILE,0,128)
	TNT1 A 0 A_CustomBulletAttack(0,0,1,Random(2000,4000),"LegSBomberAttack",1536,CBAF_NORANDOM)
	TNT1 A 0 Radius_Quake(7,105,0,140,0)
	
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CFBarrelGuruSphereSmoke",frandom(-512,512),frandom(-512,512),frandom(0,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CFBarrelGuruSphereSmoke",frandom(-768,-384),frandom(-768,-384),frandom(0,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CFBarrelGuruSphereSmoke",frandom(384,768),frandom(384,768),frandom(0,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CFGuruChunkSpark",frandom(-768,768),frandom(-768,768),frandom(0,66),0,0,0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("CFGuruChunkSpark",frandom(-768,768),frandom(-768,768),frandom(0,66),0,0,0,0,0,0)
	
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("BlueKaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_PlaySoundEx("legendary/strike","Voice",0,2)
	TNT1 A 35 A_SpawnItemEx("LegendaryBarrelStrike",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor CFBarrelGuruSphereSmoke : CFGuruSphereSmoke
{
