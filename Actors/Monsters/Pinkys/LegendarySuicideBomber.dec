Actor LegendaryBarrelStrike
{
  Scale 11.0
  Renderstyle Add
  Alpha 1.0
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	LFR9 A 1 Bright A_FadeOut(0.05,1)
	Wait
  }
}
