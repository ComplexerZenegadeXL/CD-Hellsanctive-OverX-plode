Actor LegendarySuicideBomber
{
  Monster
  Health 450
  Height 56
  Radius 20
  Mass 150
  Speed 22
  BloodColor "Blue"
  MeleeRange 44
  MeleeThreshold 100
  MaxTargetRange 1200
  MaxStepHeight 64
  MaxDropOffHeight 64
  PainChance 20
  PainChance "Legendary", 0
  PainChance "Legendary1", 0
  +NOFEAR
  +BOSS
  +BOSSDEATH
  +NOICEDEATH
  +NOTIMEFREEZE
  +NOTARGET
  +NORADIUSDMG
  +MISSILEMORE
  +FLOORCLIP
  +DONTHARMSPECIES
  +NOTELEFRAG
  +NOBLOCKMONST
  Species "Fiends"
  DamageType "Legendary"
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.1
  DamageFactor "PlayerIce", 0.2
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor 0.7
  //No Infighting
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LACGrenade", 0.0
  DamageFactor "LSSGGrenade", 0.0
  DropItem "LegendaryAmmoSphere", 93
  DropItem "LegendarySphere", 64
  DropItem "LegendaryRandomSphere" 16
  SeeSound "suicide/sit"
  AttackSound "shotguy/death"
  PainSound "shotguy/pain"
  DeathSound "shotguy/death"
  Obituary "$CFLegendarySuicideBomberObit"
  Tag "$CFLegBomb"
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	LSBM A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",4) == 1,"Remove")
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	LSBM AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	LSBM AB 2 Bright A_Wander
	TNT1 A 0 A_Look
	LSBM BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	LSBM CC 2 Bright A_Wander
	TNT1 A 0 A_Look
	LSBM CD 2 Bright A_Wander
	TNT1 A 0 A_Look
	LSBM DD 2 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  Remove:
	TNT1 A 0 A_SpawnItemEx("Demon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	Stop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LSBM AAABBB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,801)
	TNT1 A 0 A_SetUserVar("user_music",1)
	LSBM AAABBBCCCDDD 2 Bright A_Chase
	Loop
  Missile:
	LSBM AAAA 5 Bright A_FaceTarget
	Goto Missile3
  Missile3:
	TNT1 A 0 A_CposRefire
	TNT1 A 0 A_PlaySound("suicide/scream",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("LegSuicideJumping",1)
	TNT1 A 0 A_Recoil(-15)
	LSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	LSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	LSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-15)
	TNT1 A 0 A_JumpIf(z - floorz >= 64,"ChargeStop")
	LSBM ABCD 1 Bright A_JumpIfTargetInLOS("Melee",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,90,0)
	Goto Missile2
  Missile2:
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,"Missile3")
	Goto ChargeStop
  ChargeStop:
	LSBM A 1 Bright A_Stop
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_JumpIfInTargetLOS("Melee",90,JLOSF_DEADNOJUMP,200)
	Goto See
 Melee:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomBulletAttack(0,0,1,Random(1000,2000),"LegSBomberAttack",64,CBAF_NORANDOM)
	TNT1 A 0 A_CustomMissile("LegZombieSuicideBomb",24,0,0,CMF_AIMDIRECTION)
	Goto Kill
  PainAttack:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomBulletAttack(0,0,1,Random(1000,2000),"LegSBomberAttack",64,CBAF_NORANDOM)
	TNT1 A 0 A_CustomMissile("LegZombieSuicideBomb",24,0,0,CMF_AIMDIRECTION)
	Goto Kill
  Pain:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	LSBM A 3 Bright
	LSBM A 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("Tic",3,"PainAttack")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Goto See
  Death:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_CustomMissile("SuicideBomb",24,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,24,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 2 A_CustomMissile("Kaboom3",24,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA  2 A_CustomMissile("SmokeFX2",24,0,random(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 2 A_SpawnItemEx("Debris",0,0,24,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("RocketEx",0,24)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("weapons/rocklx",CHAN_BODY)
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(36,"LegendarySoul")
	LSBM M 5 Bright
	LSBM N 5 Bright A_Scream
	LSBM O 5 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("LegendaryArmor",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	LSBM PQRST 5
	TNT1 A 0 ACS_NamedExecuteAlways("DropDoll",0,15)
	LSBM U -1
	Stop
  Kill:
	TNT1 A 0 A_Die("Extreme")
	Goto XDeath
  XDeath:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_Stop
	LSBM M 5 Bright
	TNT1 A 0 A_TakeInventory("Tic",999999)
	LSBM N 5 Bright A_XScream
	LSBM O 5 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	LSBM PQRST 5
	TNT1 A 0 ACS_NamedExecuteAlways("DropDoll",0,15)
	LSBM U -1
	Stop
  LegendarySoul:
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LSBM M 5 Bright
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LSBM N 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LSBM O 5 A_Fall
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LSBM P 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LSBM QRST 5
	LSBM U 140
	TNT1 A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	LSBM UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU 2 Bright A_GiveInventory("LegSoulEvent",1)
	TNT1 A 5 A_SpawnItemEx("TeleportFog",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("SummonedLegendarySoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	LSBM U 525
	LSBM U 5 A_FadeOut(0.1,1)
	Wait
	/*
  Raise:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LSBM TSRQPONM 3
	Goto See
	*/
  }
}

Actor LegSBomberAttack : ModdedBulletPuff { Species "Fiends" DamageType "Legendary" }

Actor LegSuicideJumping : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 
	TNT1 A 0 A_CheckFloor(1)
	Stop
	TNT1 A 0 A_Jump(160,2)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	Stop
	TNT1 A 0
	Stop
  }
}

Actor LegZombieSuicideBomb
{
  Projectile
  Height 1
  Radius 1
  Speed 0
  +NOTIMEFREEZE
  +NOCLIP
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  Species "Fiends"
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Die
  Death:
	TNT1 A 1 A_StopSound
	TNT1 A 0 A_PlaySoundEx("GoodGame/Mate","Voice",0,2)
	TNT1 A 1 A_Explode(Random(6000,8000),1024,0,1,1024)
	TNT1 A 0 A_Explode(Random(1000,2000),2048,0,0,2048)
	TNT1 A 0 Radius_Quake(7,105,0,140,0)
	TNT1 A 4 A_SpawnItemEx("LNukeHyperFlare",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 25 A_SpawnItemEx("CFLNukeHyperFloor",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 8 A_SpawnItemEx("LNukeHyperSmokeFloor",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 4 A_SpawnItemEx("LNukeHyperPillar",0,0,0,0,0,10,0,SXF_CLIENTSIDE,0)
	TNT1 A 105 A_SpawnItemEx("LNukeHyperSmokePillar",0,0,0,0,0,10,0,SXF_CLIENTSIDE,0)
	TNT1 A 4 A_SpawnItemEx("LNukeHyperMushroom",0,0,1000,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 8 A_SpawnItemEx("LNukeHyperSmokeMushroom",0,0,1000,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	Stop
  }
}

Actor LNukeHyperFlare : CFNukeFire
{
  Scale 48
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	LFLR A 1 Bright A_FadeOut(0.0375,1)
	Wait
  }
}

Actor CFLNukeHyperFloor : CFNuke
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAA 20 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,9),frandom(0,9),0,frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0, 90),random(0, 9),0,frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor LNukeHyperFire : CFNuke
{
  Scale 3
  RenderStyle Add
  +NOINTERACTION
  +NOBLOCKMAP
  -FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AA 0 A_Jump(256,"Spawn1","Spawn2","Spawn3")
  Spawn1:
	LFL2 A 1 Bright A_FadeOut(0.015,1)
	Wait
  Spawn2:
	LFL2 B 1 Bright A_FadeOut(0.015,1)
	Wait
  Spawn3:
	LFL2 C 1 Bright A_FadeOut(0.015,1)
	Wait
  }
}

Actor LNukeHyperSmokeFloor : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAAAAAA 10 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,frandom(0,9),frandom(0,9),0,frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,0.00001 * Random(0,900000),0.00001 * Random(0,900000),0,Random(0,359),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  Vanilla:
	TNT1 A 1
	Stop	
  }
}

Actor LNukeHyperSmoke : CFNuke
{
  Scale 15
  Alpha 0.5
  +NOINTERACTION
  +NOBLOCKMAP
  -FORCEXYBILLBOARD
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AA 0 A_Jump(256,"Spawn1","Spawn2","Spawn3","Spawn4")
  Spawn1:
	LSM0 A 5 A_FadeOut(0.015,1)
	Wait
  Spawn2:
	LSM0 B 5 A_FadeOut(0.015,1)
	Wait
  Spawn3:
	LSM0 C 5 A_FadeOut(0.015,1)
	Wait
  Spawn4:
	LSM0 D 5 A_FadeOut(0.015,1)
	Wait
  }
}

Actor LNukeHyperPillar : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAA 15 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("LNukeHyperSmokering",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAA 15 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,3), frandom(0,3),frandom(-6,0),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor LNukeHyperSmokering : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
  SpawnLoop:
	TNT1 A 1 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,12,0,0,10 * user_loop,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,1)
	Loop
	TNT1 A 0
	Stop
  }
}

Actor LNukeHyperSmokePillar : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAAAAAAAAA 7 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,frandom(0,3),frandom(0,3),frandom(-6,0),frandom(0,360),SXF_CLIENTSIDE,0)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor LNukeHyperMushroom : CFNuke
{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAAAA 7 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,6),frandom(0,9), frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperFire",0,0,0,frandom(0,6),frandom(0,9),frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE,0)
	Stop
  }
}

