{
  +CLIENTSIDEONLY
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAAAAAAAAA 7 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,frandom(0,6),frandom(0,9),Random(-4,4),frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("LNukeHyperSmoke",0,0,0,frandom(0,6),frandom(0,9),frandom(-4,4),frandom(0,360),SXF_CLIENTSIDE,0)
