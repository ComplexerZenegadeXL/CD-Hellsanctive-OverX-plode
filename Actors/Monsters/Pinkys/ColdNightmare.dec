Actor ColdNightmare : BullFiend 
{ 
  Renderstyle Translucent
  Alpha 0.05
  Health 300
  PainChance 80
  Speed 14
  Scale 1.1
  MaxTargetRange 750
  SeeSound "magma/sight"
  PainSound "monster/psopain"
  DeathSound "magma/death"
  ActiveSound "magma/active"
  AttackSound "magma/attack"
  DropItem "LifeEssence" 120
  DropItem "ArmorBonusMax" 120
  DropItem "NewCellPackPickup" 250
  DropItem "FreezerRifleGiver" 40 1 
  BloodColor "LightBlue"
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  +MISSILEMORE
  +NOICEDEATH
  Obituary "$CFColdNightmareObit"
  HitObituary "$CFColdNightmareHitObit"
  Tag "$CFColdNi"
  States 
  { 
  Spawn: 
	CNSP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	CNSP E 0 A_SetTranslucent(0.05)
  Idle:
	CNSP A 12 A_Look
	CNSI A 12 A_Look
    Loop
  See: 
	CNSP E 0 A_SetTranslucent(0.05)
    CNSP AABB 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    CNSP CCDD 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    Loop 
  Melee: 
	CNSP E 0 A_SetTranslucent(0.05)
    CNSP EF 5 A_FaceTarget
    CNSP G 4 A_MeleeAttack
    CNSP E 5 A_FaceTarget
    Goto See
  Missile:
	CNSP E 0 A_SetTranslucent(0.05)
	TNT1 A 0 A_Jump(128,"Lunge")
  Normal:
	CNSP E 0 A_SetTranslucent(0.10)
    CNSP G 1 A_SetTranslucent(0.25)
    CNSP G 1 A_SetTranslucent(0.45)
	CNSP GE 5 A_FaceTarget		
	CNSP F 6 Bright A_CustomMissile("CNIceBall", 32, 0, 0)
	CNSP E 3
    CNSP E 1 A_SetTranslucent(0.45)
    CNSP E 1 A_SetTranslucent(0.25)
	CNSP E 0 A_SetTranslucent(0.05)
	Goto See
  Lunge:
	TNT1 A 0 A_JumpIfCloser(250,1)
	Goto See
	CNSP E 0 A_SetTranslucent(0.05)
	TNT1 A 0 A_PlaySound("magma/attack")
	CNSP EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	CNSP F 2 A_Recoil(-28)
	CNSP F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	CNSP G 6
	CNSP G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	CNSP G 1 A_ScaleVelocity(0)
	Goto See
  Pain: 
	CNSP E 0 A_SetTranslucent(0.05)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    CNSP H 4 A_Pain
    Goto See
  Death.PlayerIce:
  Death: 
	CNSP E 0 A_SetTranslucent(0.05)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    CNSP I 5 
    CNSP J 5 A_Scream
    CNSP K 4
    CNSP L 4 A_NoBlocking     
    CNSP M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CNSP N -1 
    Stop
  XDeath:
	CNSP E 0 A_SetTranslucent(0.05)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	CNSP I 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    CNSX A 3 A_XScream
    CNSX B 3 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CNSX C 3 A_NoBlocking
    CNSX D 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	CNSX EFG 3
    CNSX H -1 
    Stop
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    CNSP NMLKJI 5 
    Goto See 
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	CNSX HGFEDCBA 4
	Goto See
  }
}

Actor CNIceBall : FRZRBehBomb
{
  Speed 16
  FastSpeed 20
  Damage (Random(30,40)) //8
  Species "Fiends"
  DamageType "DTFiendEx"
  States
  {
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	SHEX DCEFG 3 Bright
	Stop
  }
}