  Actor LegendarySoul 16506
  {
  //$Category Monsters/LCA
  //$Sprite LSOLA1
  //$Title "Legendary Soul"
  Monster
  Health 750
  Radius 16
  Height 56
  Mass 100
  Speed 15
  Damage 11
  PainChance 50
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +NOINFIGHTING
  +BOSS
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +NOTELEFRAG
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NORADIUSDMG
  +EXTREMEDEATH
  +DONTRIP
  +DONTFALL
  +NOFEAR
  BloodColor "Blue"
  Species "PainElemental"
  DamageType "Legendary"
  DamageFactor 0.75
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.110
  DamageFactor "PlayerDevBall2", 0.110
  DamageFactor "PlayerDevTracer", 0.110
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Explosion", 0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendarySphere" 80 1
  DropItem "LegendaryPowerSphere" 75 1
  DropItem "LDemonAmmoBoxPickup" 120
  DropItem "LDemonAmmoPickup" 240
  //DropItem "LegendaryPlasmaticRifleGiver" 8 1
  DropItem "LegendaryRandomSphere" 16 1
  SeeSound "legsoul/see"
  PainSound "legsoul/pain"
  DeathSound "legsoul/death"
  ActiveSound "legsoul/idle"
  AttackSound "legsoul/attack"
  Obituary "$CFLegendarySoulObit"
  Tag "$CFLegSoul"
  Scale 1.2
  var int user_delay;
  var int user_portal;
  var int user_timer;
  var int user_music;
  var int user_ragewait;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LSOL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    LSOL A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LSOL AAA 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,21)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	LSOL A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    LSOL AAA 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    Loop	
  Rush:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LSOL AA 0 A_Chase
    LSOL A 1 Bright A_SpawnItemEx("LegendarySoulGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(12,"See")	
    Loop
  Avoid:
	LSOL B 0
	LSOL B 0 A_SetAngle(angle+random(0,359))
	LSOL B 0 A_Recoil(-50)
	LSOL B 0 A_FaceTarget
	LSOL BBBBBBBBBBBBB 1 Bright A_SpawnItemEx("LegendarySoulGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(127,"See")
	LSOL B 1 Bright A_Stop
    Goto Avoid
  Teleport:
    LSOL A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LSOL AAAAAAAAAA 1 A_FadeOut(0.1,0)
	LSOL AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LSOL A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LSOL AAAAAAAAAA 1 A_FadeIn(0.1)
    LSOL A 1 Bright A_SetShootable
    Goto See
  Missile:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(48,"Super")
	TNT1 A 0 A_Jump(32,"Rage")
	TNT1 A 0 A_Jump(127,"Proj")
  Normal:
	LSOL B 10 Bright A_FaceTarget
	LSOL B 2 Bright A_SkullAttack(50)
	LSOL BB 2 Bright A_CposRefire
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(188,"See")
	TNT1 A 0 A_Jump(16,"See")
	LSOL B 2 Bright A_CposRefire
	Goto Normal+1	
  Proj:
   	LSOL BBB 3 Bright A_FaceTarget
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
	LSOL B 0 A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBall",20,0,frandom(-3,3))
Rage:	
    LSOL B 1 Bright A_JumpIfCloser(1500,1)
    Goto Normal
    LSOL B 1 Bright A_PlaySound("legsoul/see")
	LSOL B 0 ACS_NamedExecuteAlways("TakeResistance") //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LSOL B 1 Bright A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 28,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
    LSOL B 0 A_JumpIfTargetInLos(2)
	LSOL B 0 A_Jump(256,2)
	LSOL B 2 Bright A_FaceTarget
	Loop
  RageGo:
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LSOL G 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("LegendarySoulGhost2")
	LSOL B 2 Bright A_SkullAttack(75)
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("LegendarySoulGhost2")
	LSOL B 2 Bright A_CposRefire
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("LegendarySoulGhost2")
	LSOL B 2 Bright A_CposRefire
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("LegendarySoulGhost2")
	LSOL B 2 Bright A_CposRefire
	Goto RageGo+3
  Super:
  	TNT1 A 0 Bright A_PlaySound("legsoul/see")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_FaceTarget
	LSOL BBBBBBBBBBBBBBBBBB 4 Bright A_FaceTarget
	LSOL B 4 Bright A_CustomMissile("LegSoulBigBall",20,0,0)
	LSOL B 4 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Pain:
	TNT1 A 0 A_KillChildren
    TNT1 A 0 A_Jump(8,"Super")	
  	TNT1 A 0 A_Jump(21,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile")
    LSOL C 2 Bright
    LSOL C 2 Bright A_Pain
    Goto See
  PainMissile: 
    LSOL C 2 Bright
    LSOL C 2 Bright A_Pain
    Goto Missile
  Death:
    TNT1 A 0 A_SetTranslucent(0.75,1)
	LSOL F 0 A_Scream
    LSOL FFFFGGGG 2 Bright A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8),0,SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8),0,SXF_CLIENTSIDE)
    LSOL H 4 Bright
    TNT1 AA 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LSOL I 4 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,12)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
    LSOL JK 4 Bright
    Stop
  }
}

Actor SummonedLegendarySoul : LegendarySoul { -COUNTKILL }

Actor LegSoulBall
{
  Radius 7
  Height 7
  Speed 40
  Damage (Random(20,40)) //8
  Scale 0.75
  Projectile
  Species "PainElemental"
  DamageType "Legendary"
  SeeSound "legsoul/attack1"
  DeathSound "legsoul/explode1" 
  RenderStyle Translucent
  Decal "DoomImpScorch"
  Alpha 0.7
  States
  {
  Spawn:
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LSA1 AB 3 Bright
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LSA1 CD 3 Bright
    Loop
  Death:
    TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LSA1 EFGHIJ 3 Bright
    LSA1 K 1
    Stop
  }
}

Actor LegSoulBigBall
{
  Projectile
  Radius 8
  Height 6
  Speed 55
  Damage (Random(100,200)) //35
  RenderStyle Add
  Scale 3.0
  Alpha 0.67
  Species "PainElemental"
  DamageType "Legendary"
  SeeSound "legsoul/attack2"
  DeathSound "legsoul/explode2"
  Decal "BFG9500LightningGold"
  +FORCERADIUSDMG
  States
  {
  Spawn:
	LSA2 ABCD 2 Bright A_SpawnItemEx("LegSoulBigBallTrail",0,0,2,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
   	TNT1 A 0 A_SpawnItemEx("BFGShockwaveGold", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("KaboomGold", 0, 0,frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_SpawnItemEx("LegendaryGoldParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(Random(256,356),300,0)
	LSA2 EFG 4 Bright
	Stop
  }
}

Actor LegSoulBigBallTrail : BFG9500Trail
{
  Scale 2.9
  Alpha 0.67
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LSA2 ABCDABCD 2 A_FadeOut(0.1)
	Stop
  }
}

Actor LegendarySoulGhost
{
  Scale 1.1
  Radius 31
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LSOL A 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegendarySoulGhost2 : LegendarySoulGhost
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    LSOL B 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor LegSoulCharge : BigLFLunge
{
  Species "PainElemental"
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,412,0)
	Stop
  Death:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,412,0)
	Stop
  }
}

Actor LSoulFlameSpawner : LegendaryRedParticleSpawner
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("LSoulFlameFlame",frandom(-20,20),frandom(-20,20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor LSoulFlameFlame
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  RenderStyle Add
  Scale 1.1
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegSoulEvent : LegZombieStrafing
{
  +FORCERADIUSDMG
  States
  {
  Pickup:
	//TNT1 A 1 A_SpawnItemEx("LegSoulEventSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAA 0 A_SpawnItemEx("LegSoulEventSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 1 A_Explode(Random(5,8),128)
    Stop	
  }
}
Actor LegSoulEventSmokeSpawner : LegendaryRedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("LegSoulEventSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor LegSoulEventSmoke
{
  +MISSILE
  +DONTSPLASH
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NOTIMEFREEZE
  Scale 0.4
  RenderStyle Normal
  States
  {
  Spawn:
	YMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}