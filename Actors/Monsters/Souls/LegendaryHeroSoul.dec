Actor LegendaryHeroSoul : PhaseSoul
{
  Monster
  Health 1000
  Radius 16
  Height 56
  Mass 80
  Scale 1.1
  Speed 32
  FloatSpeed 16
  FastSpeed 32
  RenderStyle Normal
  ReactionTime 17
  Damage (random(45,50))
  Species "PainElemental"
  DamageType "Legendary"
  DeathType "LegendaryHeroSoul"
  PainChance "SatanGuard", 0
  PainChance "Legendary", 0
  PainChance 100
  PainChance "PlayerDBFG2", 10
  PainChance "PlayerDBFG10K2", 10
  PainChance "Player", 10
  PainChance "PlayerNemesisPlasma", 10
  PainChance "PlayerNemesisBFG", 10
  PainChance "NemesisBeam", 10
  PainChance "Ice", 10
  +BOSS
  +NOFEAR
  +BOSSDEATH
  +NOICEDEATH
  +NOTELEFRAG
  +NOTARGET
  +NOINFIGHTING
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +DONTGIB
  +DONTFALL
  +NOBLOODDECALS
  +BRIGHT
  +THRUSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +STRIFEDAMAGE
  -COUNTKILL
  DamageFactor "Acid", 0.01
  DamageFactor "Fire", 0.1
  DamageFactor "Ice", 0.2
  DamageFactor "PlayerIce", 0.2
  DamageFactor "Poison", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.25
  DamageFactor "PlayerPyro", 0.03
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "BFGSplash", 0.5
  DamageFactor "UpBFG9500Ball", 0.5
  DamageFactor "UpBFGSplash", 0.5
  DamageFactor "PDTBFG", 0.1
  DamageFactor "PDTBFGTracer", 0.1
  DamageFactor "PlayerDevBall", 0.05
  DamageFactor "PlayerDevBall2", 0.05
  DamageFactor "PlayerDevTracer", 0.05
  DamageFactor "PlayerDBFG2", 0.35
  DamageFactor "PlayerDBFG10K2", 0.35
  DamageFactor "PlayerDBFGSplash2", 0.35
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.015
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.03
  DamageFactor "HellComet", 0.4
  DamageFactor "Explosion", 0.5
  DamageFactor "Melee", 0.4
  DamageFactor "Extreme", 0.5
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "Player", 0.4
  DamageFactor "PlayerBHole", 0.05
  DamageFactor "PDTPuff", 0.5
  DamageFactor "Lightning", 0.4
  DamageFactor "NemesisBall", 0.1
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor 0.30
  //No Infighting
  DamageFactor "Legendary", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "BabyWatcher", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "Broat", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PyroShot", 0.0
  DamageFactor "EleSouls", 0.0
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DropItem "LegendaryLifeEssence", 256, 10
  DropItem "LegendaryArmorBonusMax", 256, 10
  DropItem "BossArmorBonusMax", 256
  SeeSound "forgotten/sight"
  AttackSound "ImpureSoul/Sight"
  PainSound "ImpureSoul/pain"
  DeathSound "ImpureSoul/death"
  ActiveSound "ImpureSoul/Active"
  Tag "$CFHeroSoul"
  Obituary "$CFLegendaryHeroSoulObit"
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	LELS A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS ABCD 4 A_Look
	Loop
  Idle:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_music",0)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
  IdleLoop:
	TNT1 A 0 A_GiveInventory("InfightingCheck",1)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	//TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	LELS A 4 A_Wander
	TNT1 A 0 A_Look
	LELS B 4 A_Wander
	TNT1 A 0 A_Look
	LELS D 4 A_Wander
	TNT1 A 0 A_Look
	LELS D 4 A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LELS AB 4 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_GiveInventory("InfightingCheck",1)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,806)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS ABCD 4 A_Chase
	TNT1 A 0 A_Jump(46,"Phase")
	Loop
  Phased:
	TNT1 A 0 A_Jump(196,3)
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS ABCDABCDABCDABCDABCDABCDABCDABCD 1 A_Chase("","",CHF_NOPLAYACTIVE)
  PhasedLoop:
	LELS ABCDABCDABCDABCD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase")
	Goto PhasedLoop
  Phase:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	TNT1 A 0 A_PlaySound("phaseimp/teleport",CHAN_BODY)
	LELS E 2 A_FaceTarget
	LELS E 1 A_SetTranslucent(0.75)
	LELS E 1 A_SetTranslucent(0.55)
	LELS E 1 A_SetTranslucent(0.35)
	LELS E 1 A_SetTranslucent(0.15)
	Goto Phased
  UnPhase:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	TNT1 A 0 A_PlaySound("phaseimp/teleport",CHAN_BODY)
	LELS E 1 A_SetTranslucent(0.15)
	LELS E 1 A_SetTranslucent(0.35)
	LELS E 1 A_SetTranslucent(0.55)
	LELS E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	LELS E 2 A_FaceTarget		
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	TNT1 A 0 A_Jump(144,"Fireballs","Fireballs","Laser")
	Goto Normal
  Normal:
	TNT1 A 0 A_Jump(196,3)
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LELS A 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LELS A 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LELS E 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto SkullAttack
  SkullAttack:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS E 2 A_SkullAttack(40)
	LELS FF 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LELS EE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIfInventory("Tic",52,"See")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Fireballs:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS PQ 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("LegSoulRedBall",5,1,0,0,0)
	TNT1 A 0 A_CustomMissile("LegSoulRedBall",5,-1,0,0,0)
	TNT1 A 0 A_CustomMissile("LegSoulRedBall",5,1,0,0,0)
	LELS R 5 A_CustomMissile("LegSoulRedBall",5,-1,0,0,0)
	TNT1 A 0 A_Jump(64,"Laser","SkullAttack")
	TNT1 A 0 A_CposRefire
	Loop
  Laser:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Possession")
	LELS PQ 5 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_FaceTarget
	LELS R 5 A_CustomMissile("LegSoulRedLaser",5,0,0,0,0)
	TNT1 A 0 A_Jump(64,"SkullAttack")
	Goto See
  Possession:
	TNT1 A 0 A_SetTranslucent(1)
	LELS H 4
	LELS I 4 A_Scream
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,0,frandom(-8,-8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	LELS J 4 A_UnSetShootable
	LELS K 4 A_UnSetSolid
	TNT1 AA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LELS LMNO 4
	//TNT1 A 5 A_SpawnItemEx("LegendaryDoomguySummoner",0,0,0,0,0,0,0,0)
	Stop
  Pain:
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_SetTranslucent(1)
	LELS G 3 A_Pain
	LELS G 3
	Goto See
  Death.PlayerIce:
  XDeath:
  Death:
	TNT1 A 0 A_SetTranslucent(1)
	LELS H 8
	LELS I 8 A_Scream
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	LELS J 8
	LELS K 8 A_Fall
	TNT1 A 0 A_ChangeFlag("Bright",0)
	TNT1 AA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",0,0,random(0,360),CMF_AIMDIRECTION,random(0,360))
	LELS LM 8
	TNT1 A 0 A_SpawnItemEx("LegendaryTimeFreezeSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,176)
	TNT1 A 0 A_SpawnItemEx("LegendarySphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,100)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LELS "NO" 8
	TNT1 A 1
	Stop
  }
}

Actor SummonedLegendaryHeroSoul : LegendaryHeroSoul
{
  Tag "$CFSHeroSoul"
  States
  {
  XDeath:
  Death:
	TNT1 A 0 A_SetTranslucent(1)
	LELS H 8
	LELS I 8 A_Scream
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,0,frandom(-8,8),frandom(-8,8),frandom(6,8),frandom(0,360))
	LELS J 8
	LELS K 8 A_Fall
	TNT1 A 0 A_ChangeFlag("Bright",0)
	TNT1 AA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",0,0,random(0,360),2,random(0,360))
	LELS LM 8
	TNT1 A 0 A_SpawnItemEx("LegendaryTimeFreezeSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,200)
	TNT1 A 0 A_SpawnItemEx("LegendarySphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,150)
	LELS "NO" 8
	TNT1 A 1
	Stop
  }
}

Actor LegSoulRedLaser : LegRedLaser
{
  -THRUSPECIES
  +STRIFEDAMAGE
  Species "PainElemental"
  DamageType "Legendary"
  DeathType "LegendaryHeroSoul"
}

Actor LegSoulRedBall : LegRedBall
{
  -THRUSPECIES
  +STRIFEDAMAGE
  Species "PainElemental"
  DamageType "Legendary"
  DeathType "LegendaryHeroSoul"
}

