Actor NemesisSoul : LegendarySoul 28008
{
  Health 1000
  Mass 100
  Speed 25
  Damage 16
  PainChance 25
  BloodColor "Black"
  RenderStyle Translucent
  Alpha 0.8
  Scale 1.2
  DamageType "Nemesis"
  DamageFactor 0.6
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Explosion", 0.2
  DamageFactor "PlayerDTRG", 0.4
  DamageFactor "DTRailgun", 0.4
  DamageFactor "PDTPuff", 0.4
  DamageFactor "RailG", 0.3
  DamageFactor "PlayerPyro", 0.2
  DamageFactor "Ice", 0.2
  DamageFactor "PlayerIce", 0.2
  DamageFactor "VileFires", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "Superweapon", 0.0
  DamageFactor "T3rm", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DropItem "NemesisHealthBonusMax" 256
  DropItem "NemesisArmorBonus32" 256
  DropItem "NemesisHealthBonusMax" 256
  DropItem "NemesisArmorBonus32" 256
  DropItem "EnragedLegendarySphere" 80
  DropItem "EnragedLegendaryPowerShard" 75
  DropItem "NLDemonAmmoBoxPickup" 120
  DropItem "NLDemonAmmoPickup" 240
  //DropItem "NemesisRifleGiver" 30 1
  SeeSound "NemesisSoul/Sight"
  ActiveSound "NemesisSoul/Active"
  PainSound "NemesisSoul/Pain"
  DeathSound "NemesisSoul/Death"
  AttackSound "NemesisSoul/Attack2"
  Obituary "$CFNemesisSoulObit"
  Tag "$CFNemSoul"
  var int user_script;
  var int user_script_type;
  var int user_loop;
  States
  {
  Spawn:
	NSOL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,21)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",20)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,4)
  Idle:
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"GiveToTormentor")
    NSOL ABCD 2 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NSOL ABCD 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,713)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"GiveToTormentor")
	TNT1 A 0 A_SetTranslucent(0.8)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    NSOL ABCD 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    Loop
  GiveToTormentor:
	TNT1 A 0 A_GiveInventory("MarineKilled",1,AAPTR_MASTER)
	TNT1 A 0 A_TakeInventory("MarineKilled")
	Goto See
  Rush:
	NSOL AA 0 A_Chase
    NSOL A 1 Bright A_SpawnItemEx("NemesisSoulGhost")
	TNT1 A 0 A_Jump(12,"See")	
    Loop
  Avoid:
	NSOL E 0 A_SetAngle(angle+random(0,359))
	NSOL E 0 A_Recoil(-50)
	NSOL E 0 A_FaceTarget
	NSOL EEFFEEFFEEFFE 1 Bright A_SpawnItemEx("NemesisSoulGhost2")
	TNT1 A 0 A_Jump(127,"See")
	NSOL E 1 Bright A_Stop
    Goto Avoid
  Teleport:
    NSOL A 1 Bright A_UnSetShootable
	NSOL AAAAAAAAAA 1 A_FadeOut(0.1,0)
	NSOL AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    NSOL A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NSOL AAAAAAAAAA 1 A_FadeIn(0.1)
    NSOL A 1 Bright A_SetShootable
    Goto See
  Missile:
	TNT1 A 0 A_SetTranslucent(0.8)
    TNT1 A 0 A_Jump(48,"SuperAttack")
	TNT1 A 0 A_Jump(32,"Rage")
	TNT1 A 0 A_Jump(127,"Proj","RainProj")
  Normal:
	NSOL EF 3 Bright A_FaceTarget
	NSOL F 2 Bright A_SkullAttack(50)
	NSOL E 2 Bright A_CposRefire
	NSOL F 2 Bright A_CposRefire
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(188,"See")
	NSOL E 2 Bright A_CposRefire
	Goto Normal+5
  Proj:
   	NSOL PQ 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ProjLoop:
	NSOL Q 2 Bright A_FaceTarget
	NSOL R 2 Bright A_CustomMissile("NemesisSoulHellStaffBall",20,0,frandom(-3,3))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,"See")
	Loop
	Goto See
  RainProj:
   	NSOL PQ 6 Bright A_FaceTarget
	NSOL R 2 Bright A_CustomMissile("NemesisSoulRainBall",20,0,frandom(-3,3))
	NSOL RQ 4 Bright A_FaceTarget
	NSOL R 2 Bright A_CustomMissile("NemesisSoulRainBall",20,0,frandom(-3,3))
	NSOL RQ 4 Bright A_FaceTarget
	NSOL R 2 Bright A_CustomMissile("NemesisSoulRainBall",20,0,frandom(-3,3))
	NSOL RQ 4 Bright A_FaceTarget
	NSOL R 2 Bright A_CustomMissile("NemesisSoulRainBall",20,0,frandom(-3,3))
	NSOL RQ 4 Bright A_FaceTarget
	Goto See
  Rage:	
    TNT1 A 0 A_JumpIfHealthLower(300,"Kamikaze")
    NSOL E 1 Bright A_JumpIfCloser(1500,1)
    Goto Normal
    NSOL E 1 Bright A_PlaySound("NemesisSoul/Attack1")
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	NSOL F 2 Bright A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 9,"RageGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
    NSOL E 0 A_JumpIfTargetInLos(2)
	NSOL E 0 A_Jump(256,2)
	NSOL E 0 A_FaceTarget
	NSOL EF 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  RageGo:
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NSOL E 2 Bright A_SkullAttack(75)
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NSOL F 2 Bright A_CposRefire
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NSOL E 2 Bright A_CposRefire
	TNT1 A 0 A_CustomMissile("LegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NSOL F 2 Bright A_CposRefire
	Goto RageGo+3
  SuperAttack:
  	TNT1 A 0 Bright A_PlaySound("NemesisSoul/Attack1")
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_FaceTarget
	NSOL EFEFE 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	NSOL FEFEF 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	NSOL EFEFE 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	NSOL FEFEF 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	NSOL EFEPQ 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	NSOL R 4 Bright A_CustomMissile("NemesisSoulBigBall",20,0,0)
    TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    Goto See
  Kamikaze:
	NSOL E 1 Bright A_PlaySound("NemesisSoul/Sight")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	NSOL E 1 Bright A_FaceTarget
  KamikazeWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 20,"KamikazeGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 Radius_Quake(4,2,0,80,0)
	NSOL EF 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  KamikazeGo:
    TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
    TNT1 A 0 A_CustomMissile("NemesisSoulKamikaze")
	TNT1 A 1 A_ChangeFlag(COUNTKILL,0)
	Stop
  Pain:
	TNT1 A 0 A_KillChildren
    TNT1 A 0 A_Jump(8,"SuperAttack")	
  	TNT1 A 0 A_Jump(21,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile")
    NSOL G 2 Bright
    NSOL G 2 Bright A_Pain
    Goto See
  PainMissile: 
    NSOL G 2 Bright
    NSOL G 2 Bright A_Pain
    Goto Missile
  Death:
	TNT1 A 0 A_Jump(100,"XDeath")
    TNT1 AAAAA 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
    NSOL F 10 Bright A_Scream
    NSOL H 10 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_PlaySound("legsoul/explode2")
	TNT1 A 0 A_SpawnItemEx("BossDeathExplode",0,0,32)
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("2huBossDeathFlame3", frandom(5, 55), 0, frandom(0,360), CMF_OFFSETPITCH, frandom(-40, 70))
	TNT1 A 0 A_Explode(356,300,0)
    NSOL IIJJKKLLMMNNOO 3 Bright A_SpawnItemEx("NemesisWhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    Stop
  XDeath:
    NSOL G 2 Bright
	TNT1 A 0 A_Scream
    NSOL GGGGGGGGGGGGGGGGGGGG 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    NSOL H 3 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("NemesisDust",random(1,3),256)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItem("NemesisZombieItemRandomizer")
	TNT1 A 0 A_SpawnItemEx("NemesisZombieSuperItemRandomizer")
	TNT1 A 0 A_StopSound(2)
	TNT1 A 0 A_SpawnItemEx("MiniNemesisDeathBall")
    NSOL IIJJKKLLMMNNOO 3 Bright A_SpawnItemEx("NemesisWhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	Stop
  }
}

Actor SummonedNemesisSoul : NemesisSoul { Tag "$CFSNemSoul" -COUNTKILL }

Actor NemesisSoulFireSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire")
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_SpawnItemEx("NemesisSoulSmoke",7,frandom(-5,5),frandom(20,30),2,0,frandom(4,7),frandom(90,270),SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor NemesisSoulSmoke : TrueNemesisHellionSmoke
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	2HDT ABCDEFGHIJKL 1 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor NemesisSoulHellStaffBall : CacoHellStaffBall1
{
  Speed 55
  Damage (Random(30,50)) //8
  Species "PainElemental"
  DamageType "Nemesis"
  +NOTIMEFREEZE
  SeeSound "legsoul/attack1"
  States
  {
  Spawn:
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    HPRO DDEEFF 1 Bright A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
    Loop
  Death:
	TNT1 A 0
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
    CLBA D 1 Bright A_FadeOut(0.2)
    Goto Death+1
  }
}

Actor NemesisSoulRainBall : CacoHellStaffBall1
{
  Speed 40
  Damage (Random(60,75)) //15
  Species "PainElemental"
  DamageType "Nemesis"
  SeeSound "Dbish/Atk2"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO D 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO D 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO E 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO E 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO F 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("BFGTrailParticleWhite",frandom(-12,12),Random(-12,12),Random(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360),SXF_CLIENTSIDE)
	HPRO F 1 Bright A_SpawnItemEx("WhiteHellStaffTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 AAAAAAAAAA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(0,12),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("WhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetScale(1)
	PFX1 GH 5 Bright
	PFX1 I 4 Bright
	PFX1 JKL 3 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("NemesisRainDrop",frandom(-64,64),frandom(-64,64),0,0,0,0)
	Stop
  }
}

Actor NemesisRainDrop : DBishRainDrop
{
  Gravity 15
  Species "PainElemental"
  DamageType "Nemesis"
  +NOTIMEFREEZE
}

Actor NemesisSoulBigBall : LegSoulBigball
{
  Speed 60
  Damage (Random(60,120)) //40
  Species "PainElemental"
  DamageType "Nemesis"
  Scale 1
  Decal "Scorch"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 1 A_SpawnItemEx("NemesisSoulBigBallTrail",0,0,0,frandom(-2,2),frandom(-2,2),frandom(0,4))
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BossDeathExplode",0,0,32)
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("2huBossDeathFlame3", frandom(5, 55), 0, frandom(0,360), CMF_OFFSETPITCH, frandom(-40, 70))
	TNT1 A 0 A_Explode(356,300,0)
	TNT1 A 20
	Stop
  }
}

Actor NemesisSoulBigBallTrail
{
  RenderStyle Translucent
  Alpha 1.0
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  States
  {
  Spawn:
	2HDT ABCDEFGHIJKL 2 Bright A_FadeOut(0.08)
	Stop
  }
}

Actor NemesisSoulGhost : LegendarySoulGhost
{
  Scale 1.2
  Alpha 1.0
  Renderstyle Add
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    NSOL E 2 A_FadeOut(0.10)
    Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor NemesisSoulGhost2 : NemesisSoulGhost
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 0
    TNT1 A 1
    NSOL B 2 A_FadeOut(0.10)
    Wait
  }
}
/*
Actor LegSoulCharge : BigLFLunge
{
  Damagetype "SoulToxic"
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,412,0)
	Stop
  Death:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,412,0)
	Stop
  }
}*/

Actor NemesisSoulFlameSpawner : LSoulFlameSpawner
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("NemesisSoulFlame",frandom(20,-20),frandom(20,-20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  Vanilla:
    TNT1 A 0 A_SpawnItemEx("NemesisSoulFlame",frandom(20,-20),frandom(20,-20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
	Stop		
  }
}

Actor NemesisSoulFlame : TrueNemesisHellionSmoke
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  Scale 1.1
}

Actor NemesisSoulEvent : LegZombieStrafing
{
  +FORCERADIUSDMG
  Species "PainElemental"
  DamageType "Nemesis"
  States
  {
  Pickup:
    TNT1 A 1 
	TNT1 A 0 A_PlaySound("vile/firecrkl")
	TNT1 A 1 A_SpawnItem("NemesisSoulEventFireSpawner",0,0,0,0)
	TNT1 A 1 A_Explode(3,128)
    Stop	
  }
}

Actor NemesisSoulEventFireSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("NemesisKaboomNoSound",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(2,4),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("WhiteNemesisKaboomNoSound",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(4,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor NemesisSoulKamikaze
{
  Radius 16
  Height 56
  Health 100
  Damage (Random(150,300)) //50
  Speed 40
  Scale 1.2
  SeeSound "NemesisSoul/Attack2"
  DeathSound "NemesisSoul/Death"
  Species "PainElemental"
  DamageType "Nemesis"
  BloodColor "Black"
  Tag "\c[t6]Nemesis Soul\c-"
  RenderStyle Translucent
  Alpha 0.8
  Decal "Scorch"
  DropItem "NemesisHealthBonusMax" 128
  DropItem "NemesisArmorBonus32" 128
  DropItem "NemesisHealthBonusMax" 128
  DropItem "NemesisArmorBonus32" 128
  DropItem "EnragedLegendarySphere" 64
  DropItem "EnragedLegendaryPowerShard" 64
  DropItem "NLDemonAmmoBoxPickup" 100
  DropItem "NLDemonAmmoPickup" 180
  //DropItem "NemesisRifleGiver" 8 1
  Projectile
  +SOLID
  +SHOOTABLE
  -NOBLOOD
  -NOBLOODDECALS
  +SKYEXPLODE
  +NOTARGETSWITCH
  -NOBLOCKMAP
  +SEEKERMISSILE
  States
  {
  Spawn:
	NSOL EF 2 Bright A_SpawnItemEx("NemesisSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0 A_Die
  Explode:
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 A 0 A_StopSoundEx("Voice")
    NSOL G 2 Bright
	TNT1 A 0 A_PlaySound("NemesisSoul/Death",7,1.0,0,ATTN_NONE)
    NSOL H 3 Bright A_NoBlocking
	TNT1 A 0 A_SpawnItem("MiniNemesisDeathBall")
    NSOL IIJJKKLLMMNNOO 3 Bright A_SpawnItemEx("NemesisWhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    Stop
  }
}