Actor Wicked : TerrorSoul
{
  Monster
  Health 80
  Height 41
  Radius 11
  Scale 0.45
  Mass 200 
  Speed 6
  FloatSpeed 6
  FastSpeed 6
  ReactionTime 23
  PainChance "SatanGuard", 0
  PainChance "BloodElemental", 0
  PainChance "Broat", 0
  PainChance 100
  Damage (Random(7,10))
  +FLOAT
  +NOGRAVITY
  +FLOORCLIP
  +MISSILEMORE
  +DONTHARMSPECIES
  //Species "EleSouls"
  DamageType "EleSouls"
  //No Infighting
  DamageFactor "Wickruel", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "Broat", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "EleSouls", 0.0
  DropItem "LifeEssence", 180
  DropItem "CFArmorBonusMax1", 180
  SeeSound "monster/wiksit"
  ActiveSound "monster/wikact"
  PainSound "monster/wikpai"
  DeathSound "monster/wikdth"
  Obituary "$CFWickedObit"
  HitObituary "$CFWickedHitObit"
  Tag "$CFWick"
  var int user_lowlag;
  States
  {
  Spawn:
	WICK A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	WICK ABCD 5 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	WICK AAABBB 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_GiveInventory("WickedDamagefactors",1)
	TNT1 A 0 A_ChangeFlag(Thruspecies,1)
	WICK AAA 1 A_Chase("","")
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_Jump(42,"Dodge")
	WICK A 1 A_Chase
	WICK BBB 1 A_Chase("","")
	WICK B 1 A_Chase
	WICK CCC 1 A_Chase("","")
	WICK C 1 A_Chase
	WICK DDD 1 A_Chase("","")
	WICK D 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(92,"Dodge")
	TNT1 A 0 A_Jump(20,"Dodge")
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	Loop
  Dodge:
	TNT1 A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	TNT1 A 0 ThrustThing(angle*256/360+64,30,0,0)
	WICK A 5
	Goto See
  Left:
	TNT1 A 0 ThrustThing(angle*256/360+192,30,0,0)
	WICK A 5
	Goto See
  Back:
	TNT1 A 0 ThrustThing(angle*256/360+128,30,0,0)
	WICK A 5
	Goto See
  BackLeftRange:
	TNT1 A 0 ThrustThing(angle*256/360+frandom(133,187),30,0,0)
	WICK A 5
	Goto See
  BackRightRange:
	TNT1 A 0 ThrustThing(angle*256/360+frandom(69,123),30,0,0)
	WICK A 5
	Goto See
  Missile:
	WICK I 1 A_PlaySound("monster/wikatk")
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Missile.Hard")
	TNT1 A 0 A_Jump(138,"Ram")
	TNT1 A 0 A_Jump(80,"Homer")
  Normal:
	WICK I 4 A_FaceTarget
	WICK JK 4 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK L 8
	Goto See
  Homer:
	WICK I 4 A_FaceTarget
	WICK JK 4 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedHomer",28,0,frandom(-2,2))
	WICK L 12
	Goto See
  Ram:
	WICK EFGHEG 3 A_FaceTarget
	WICK G 1 A_SkullAttack(18)
  LoopRam:
	WICK FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF 3 A_SpawnItem("WickedGhost")
	WICK F 1 A_Stop
	Goto See
  Missile.Hard:
	TNT1 A 0 A_Jump(138,"Ram")
	TNT1 A 0 A_Jump(80,"Homer.Hard")
  Hard:
	WICK I 4 A_FaceTarget
	WICK JK 3 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("WickedHomer",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("WickedHomer",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("WickedHomer",28,0,frandom(-2,2))
	WICK K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedShot",28,0,frandom(-2,2))
	WICK L 8
	TNT1 A 0 A_Jump(82,"Ram")
	Goto See
  Homer.Hard:
	WICK I 4 A_FaceTarget
	WICK JK 3 Bright A_FaceTarget  
	TNT1 AAA 0 A_CustomMissile("WickedHomer",28,0,random(-2,2))
	WICK L 12
	TNT1 A 0 A_Jump(82,"Ram")
	Goto See
  Pain:
	WICK M 3 A_Pain
	WICK M 4
	Goto See
  XDeath:
  Death:
	WICK N 5 A_Scream
	WICK OP 5
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,20)
	TNT1 A 0 A_SpawnItemEX("WickedTorso",0,0,41,-7,0,4)
	WICT A 5 A_Fall
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	WICT B 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",12,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)  
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,0)
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	//TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	WICT CDEF 5
	WICT G 525
  Fade:
	WICT G 5 A_FadeOut(0.1,1)
	Loop
  }
}

Actor WickedDamageFactors : PowerProtection { DamageFactor Normal, 0.5 Powerup.Duration -99 }

Actor WickedDamageFactors2 : PowerProtection { DamageFactor Normal, 0.35 Powerup.Duration -99 }

Actor CruelBall : NewDoomImpBall { Damage (Random(6,12)) Damagetype "Wickruel" }

Actor WickedHomer : CruelBall
{
  Species "PainElemental"
  DamageType "EleSouls"
  BounceCount 3
  BounceFactor 1.1
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(120,"Weave","Slither")
	TNT1 A 0 A_Jump(65,"Bounce")
  Normal:
	BAL8 AB 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SeekerMissile(8,10)
	Loop
  Weave:
	BAL8 A 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_BishopMissileWeave
	BAL8 B 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_BishopMissileWeave
	TNT1 A 0 A_SeekerMissile(8,10)
	Loop
  Slither:
	BAL8 A 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_Weave(3,0,1.0,0.0)
	BAL8 B 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_SeekerMissile(8,10)
	Loop
  Bounce:
	BAL8 A 1 Bright A_ChangeFlag(HexenBounce,1)
	TNT1 A 0 A_Jump(128,"Weave","Slither")
	GoTo Normal
  }
}

Actor WickedShot : DoomImpBall
{
  Scale 0.65
  Speed 17
  FastSpeed 21
  Decal "DoomImpScorch"
  Species "PainElemental"
  DamageType "EleSouls"
  Damage (Random(5,8)) //1
  States
  {
  Spawn:
	FDMB A 1 Bright A_SpawnItemEx("WickedFX",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	FDMB BCDE 3 Bright
	Stop
  }
}

Actor WickedFX
{
  Scale 0.65
  RenderStyle Add
  +FORCEXYBILLBOARD
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	FDMB A 1 Bright A_FadeOut(0.1,1)
	Goto Spawn+1
  }
}

Actor WickedGhost
{
  Radius 2
  Height 41
  Scale 0.45
  Alpha 0.7
  RenderStyle Translucent
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	WICK F 2 A_FadeOut(0.1,1)
	Goto Spawn+1
  }
}

Actor WickedTorso
{
  Mass 1000000
  Radius 1
  Height 1
  Scale 0.45
  +ISMONSTER
  -COUNTKILL
  +CORPSE
  +FLOORCLIP
  +THRUACTORS
  +NOBLOCKMAP
  States
  {
  Spawn:
	WICK Q 5 A_PlaySound("monster/tenpn1")
	WICK R 525
  Crash:
	WICK S 1
	WICK S 4 A_PlaySound("monster/tenpn2")
	WICK TUV 5
	TNT1 A 0 A_SpawnItem("BodyCrash",0,0,0,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	WICK W 525
  Fade:
	WICK W 5 A_FadeOut(0.1,1)
	Loop
  }
}

Actor CruelGhost : WickedGhost
{
  Height 48
  Scale 0.6
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 1
	CRUL F 2 A_FadeOut(0.1,1)
	Goto Spawn+1
  }
}

Actor CruelTorso
{
  Mass 1000000
  Radius 1
  Height 1
  Scale 0.6
  +ISMONSTER
  -COUNTKILL
  +CORPSE
  +FLOORCLIP
  +THRUACTORS
  +NOBLOCKMAP
  States
  {
  Spawn:
	CRUL Q 5 A_PlaySound("monster/tenpn1")
	CRUL R 525
  Crash:
	CRUL S 1
	CRUL S 4 A_PlaySound("monster/tenpn2")
	CRUL TUV 5
	TNT1 A 0 A_SpawnItem("BodyCrash",0,0,0,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	CRUL W 525
  Fade:
	CRUL W 5 A_FadeOut(0.1,1)
	Loop
  }
}

Actor Cruel : Wicked
{
  Health 100
  Height 48
  Radius 16
  Mass 300
  Scale 0.6
  BloodColor "Black"
  Damage (random(17,20))
  DropItem "LifeEssence" 195 5
  DropItem "CFArmorBonusMax5" 250
  Obituary "$CFCruelObit"
  HitObituary "$CFCruelHitObit"
  Tag "$CFCruel"
  States
  { 
  Spawn:
	CRUL ABCD 5 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_GiveInventory("WickedDamagefactors2",1)
	TNT1 A 0 A_ChangeFlag(Thruspecies,1)
	CRUL AAAABBBB 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_Jump(42,"Dodge")
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	CRUL CCCCDDDD 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_Jump(42,"Dodge")
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_Jump(20,"Dodge")
	Loop
  Dodge:
	TNT1 A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	GoTo See
  Right:
	CRUL A 5 ThrustThing(angle*256/360+64,30,0,0)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(42,"Missile")
	GoTo See
  Left:
	CRUL A 5 ThrustThing(angle*256/360+192,30,0,0)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(42,"Missile")
	GoTo See
  Back:
	CRUL A 5 ThrustThing(angle*256/360+128,30,0,0)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(42,"Missile")
	GoTo See
  BackLeftRange:
	CRUL A 5 ThrustThing(angle*256/360+random(133,187),30,0,0)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(42,"Missile")
	GoTo See
  BackRightRange:
	CRUL A 5 ThrustThing(angle*256/360+random(69,123),30,0,0)
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(42,"Missile")
	Goto See
  Missile:
	CRUL I 1 A_PlaySound("monster/wikatk")
	TNT1 A 0 A_Jump(138,"Ram")
	TNT1 A 0 A_Jump(80,"Homer")
	Goto Normal
  Normal:
	CRUL I 4 A_FaceTarget
	CRUL JK 3 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("CruelBall",34,0,frandom(-2,2))
	CRUL LK 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("CruelBall",34,0,frandom(-2,2))
	CRUL LK 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("CruelBall",34,0,frandom(-2,2))
	CRUL LK 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("CruelBall",34,0,frandom(-2,2))
	CRUL LK 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("CruelBall",34,0,frandom(-2,2))
	CRUL L 8
	Goto See
  Homer:
	CRUL I 4 A_FaceTarget
	CRUL L 3 A_FaceTarget  
	CRUL K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedHomer",34,0,frandom(-2,2))
	CRUL L 3 A_FaceTarget  
	CRUL K 2 Bright A_FaceTarget  
	TNT1 A 0 A_CustomMissile("WickedHomer",34,0,frandom(-2,2))
	CRUL L 3 A_FaceTarget  
	CRUL L 12
	GoTo See
  Ram:
	CRUL EFGHEG 2 A_FaceTarget
	CRUL G 1 A_SkullAttack(22)
	Goto LoopRam
  LoopRam:
	CRUL FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF 1 A_SpawnItem("CruelGhost")
	CRUL F 1 A_Stop
	GoTo See
  Pain:
    CRUL M 3 A_Pain
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(118,"Dodge")
	CRUL M 4
	GoTo See
  XDeath:
  Death:
	TNT1 A 0
	CRUL N 5 A_Scream
	CRUL OP 5
	TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,20,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("CruelTorso",0,0,48,-7,0,4)
	CRUT A 5 A_Fall
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	Goto Fall
  Fall:
	CRUT B 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",12,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_ChangeFlag(FLOAT,0)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,0)
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	//TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	CRUT CDEF 5
	CRUT G 525
	Goto Fade
  Fade:
	CRUT G 5 A_FadeOut(0.1,1)
	Loop
  }
}