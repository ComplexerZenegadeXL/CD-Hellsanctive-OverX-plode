Actor ChaosSoul : TerrorSoul 17555
{
  //$Category Monsters/CF
  //$Sprite CHOSA1
  //$Title "Chaos Soul"
  Monster
  Health 200
  Height 56
  Radius 16
  Mass 50
  Speed 12
  FloatSpeed 12
  Damage (15)
  PainChance "SoulToxic", 0
  PainChance 100
  BloodColor "Green"
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +DONTHARMCLASS
  +DONTHARMSPECIES
  +DONTFALL
  +NOICEDEATH
  DamageType "EleSouls"
  DamageFactor "CurseComet", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Souls", 0.0
  DropItem "LifeEssence" 128
  DropItem "ArmorBonusMax" 128
  DropItem "CFManaPickup" 70
  SeeSound "ChaosSoul/Sight"
  AttackSound "ChaosSoul/Sight"
  PainSound "ChaosSoul/pain"
  DeathSound "ChaosSoul/death"
  Obituary "$CFChaosSoulObit"
  HitObituary "$CFChaosSoulHitObit"
  Tag "$CFChSoul"
  var int user_phase;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	CHOS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,44)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",44)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	CHOS A 4 Bright A_Look
	Loop
  See:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SetTranslucent(1)
	CHOS A 2 Bright A_Chase
	TNT1 A 0 A_Jump(10,"Phase")
	Loop	
  Phase:
    TNT1 A 0 A_SetUserVar("user_effect_type",43)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
    CHOS A 2 A_FaceTarget
    CHOS A 1 A_SetTranslucent(0.75)
    CHOS A 1 A_SetTranslucent(0.50)
    CHOS A 1 A_SetTranslucent(0.25)
    CHOS A 1 A_SetTranslucent(0)
	TNT1 A 0 A_SetUserVar("user_phase",0)
	Goto Phased
  Phased:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_phase >= 30,"Phased2")
	TNT1 A 0 A_SetUserVar("user_phase",user_phase+1)
	TNT1 A 0 A_ExtChase(0,0)
	CHOS A 1 A_ExtChase(0,0)
	Loop
  Phased2:
	TNT1 A 0 A_Chase(0,0)
	CHOS A 1 A_Chase(0,0)
	TNT1 A 0 A_Jump(30,"Unphase")
	Loop
  UnPhase:
    TNT1 A 0 A_SetUserVar("user_effect_type",43)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
    CHOS A 1 A_SetTranslucent(0)
    CHOS A 1 A_SetTranslucent(0.25)
    CHOS A 1 A_SetTranslucent(0.50)
    CHOS A 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
    CHOS A 2 A_FaceTarget
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
    Goto See
  Missile:
	TNT1 A 0 A_JumpIfHealthLower(50,"Kamikaze")
	TNT1 A 0 A_Jump(80,"Lightning")
  Normal:
    CHOS AAA 2 Bright A_FaceTarget
	CHOS A 1 Bright A_FaceTarget
	CHOS B 1 Bright A_SkullAttack(40)
	CHOS BBBBBBBBBB 5 Bright A_FaceTarget
    CHOS B 0 Thing_Stop(0)
	Goto See
  Lightning:
    CHOS AA 4 Bright A_FaceTarget
    CHOS B 2 Bright A_FaceTarget
	CHOS B 2 Bright A_CustomMissile("ChaosLightning",10,0,0)
    CHOS AA 4 Bright A_FaceTarget
    CHOS B 2 Bright A_FaceTarget
	CHOS B 2 Bright A_CustomMissile("ChaosLightning",10,0,0)
    CHOS A 6 Bright A_FaceTarget
	Goto See
  Kamikaze:
	TNT1 A 0 A_SetUserVar("user_effect_type",43)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    CHOS BBB 4 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("ChaosSoulKamikaze",0)
	TNT1 A 1 A_ChangeFlag(COUNTKILL,0)
	Stop
  Pain:
    TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Stop
	CHOS C 2 Bright
	CHOS C 2 Bright A_Pain
	Goto See
  Death.PlayerIce:
  Death:
    TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("ChaosSoulSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CHOS C 4 Bright A_NoGravity
	CHOS D 4 Bright A_Scream
    TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 15, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_CustomMissile("Chaos10KEx", 15, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,15,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	CHOS E 3 Bright
	CHOS F 2 Bright A_NoBlocking
	CHOS GH 4
    Stop
  }
}

Actor SummonedChaosSoul : ChaosSoul { Tag "$CFSChSoul" -COUNTKILL }

Actor ChaosSoulSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_SpawnItemEx("ChaosSoulSmoke",7,frandom(-5,5),frandom(20,30),2,0,frandom(2,5),frandom(90,270),SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
    }
}

Actor ChaosSoulSmokeSpawner2 : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAA 0 A_SpawnItemEx("ChaosSoulSmoke",frandom(-9,-5),frandom(-3,3),frandom(10,45),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
    }
}

Actor ChaosSoulSmoke : GHellionSmoke
{
  Scale 0.2
  -NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
}

Actor ChaosLightning : NetherLightning
{
  Species "PainElemental"
  DamageType "EleSouls"
  MissileType "ChaosLightningTrailSpawner"
  States
  {
  Spawn:
	TNT1 A Random(4,7)
	CLIG ABCDE 1 Bright
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetScale(0.75)
    NLI2 ABCDEFG 1 Bright
    Stop
  }
}

Actor ChaosLightningTrailSpawner : NetherLightningTrailSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A Random(4,7)
	TNT1 AA 0 A_SpawnItemEx("ChaosLightningTrail", frandom(-5, 5), frandom(-5, 5), frandom(-5, 5), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Stop
  }
}

Actor ChaosLightningTrail : NetherLightningTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A Random(4,7)
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_Jump(256, "Puff1", "Puff2", "Puff3")
  Puff1:
    CLIG F 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    CLIG G 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    CLIG H 1 Bright A_FadeOut(0.1)
    Loop
  }
}


Actor Chaos10KEx : Player10KEx
{
  Damage (Random(120,300))
  +FORCERADIUSDMG
  Species "PainElemental"
  DamageType "EleSouls"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("Kaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE1 A 4 Bright A_Explode(100,100,0)
    BFE1 BCDEF 4 Bright
    Stop
  }
}


Actor ChaosSoulKamikaze
{
  Radius 16
  Height 56
  Health 50
  Damage (Random(30,60)) //10
  Speed 50
  SeeSound "ChaosSoul/Sight"
  DeathSound "ChaosSoul/Death"
  Species "PainElemental"
  DamageType "SoulToxic"
  BloodColor "Green"
  Tag "\c[q9]Chaos Soul\c-"
  Decal "Scorch"
  DropItem "LifeEssence" 128
  DropItem "ArmorBonusMax" 128
  DropItem "CFManaPickup" 70
  Projectile
  +SOLID
  +SHOOTABLE
  -NOBLOOD
  -NOBLOODDECALS
  +SKYEXPLODE
  +NOTARGETSWITCH
  -NOBLOCKMAP
  +SEEKERMISSILE
  States
  {
  Spawn:
	CHOS B 2 Bright A_SpawnItemEx("ChaosSoulSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0 A_Die
  Explode:
    TNT1 A 0
    TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("ChaosSoulSmokeSpawner")
	TNT1 A 0 A_Explode(52,128)
	CHOS C 4 Bright A_NoGravity
	CHOS D 4 Bright A_Scream
    TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 15, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_CustomMissile("Chaos10KEx", 15, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,15,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	CHOS E 3 Bright
	CHOS F 2 Bright A_NoBlocking
	CHOS GH 4
	Stop
  }
}