Actor ImpureSoul : TerrorSoul
{
  Monster
  Health 190
  Height 56
  Radius 16
  Scale 1.25
  Mass 50
  Speed 7
  FloatSpeed 7
  FastSpeed 7
  ReactionTime 17
  Damage (random(14,16))
  BloodColor "Blue"
  PainChance "SatanGuard", 0
  PainChance "BloodElemental", 0
  PainChance "BabyWatcher", 0
  PainChance "Broat", 0
  PainChance 100
  +DONTFALL
  +NOICEDEATH
  +NOBLOODDECALS
  +NODAMAGETHRUST
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  //Species "EleSouls"
  DamageType "EleSouls"
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  //No Infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Wicked", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "Broat", 0.0
  DamageFactor "CurseComet", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "EleSouls", 0.0
  DropItem "BossLifeEssence", 180
  DropItem "CFArmorBonusMax5", 180
  DropItem "CFArmorBonusMax5", 180
  SeeSound "ImpureSoul/Sight"
  ActiveSound "ImpureSoul/Active"
  AttackSound "ImpureSoul/Sight"
  PainSound "ImpureSoul/pain"
  DeathSound "ImpureSoul/death"
  Obituary "$CFImpureSoulObit"
  HitObituary "$CFImpureSoulHitObit"
  Tag "$CFImpSoul"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	ISUL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",25)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	ISUL AAA 4 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ISUL AAA 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	ISUL AAA 1 Bright A_Chase
	TNT1 A 0 HealThing(1)
	Loop
  Missile:
	TNT1 A 0 A_JumpIfTargetInLOS("VeryFarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1500)
	TNT1 A 0 A_JumpIfTargetInLOS("FarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("LongRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,800)
	TNT1 A 0 A_JumpIfTargetInLOS("NearRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,500)
	TNT1 A 0 A_JumpIfTargetInLOS("CloseRange",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	Goto Normal
  Normal:
	ISUL AA 4 Bright A_FaceTarget
	ISUL A 1 Bright A_SkullAttack(39)
	ISUL B 50 Bright
	TNT1 A 0 A_Stop
	Goto See
  VeryFarRange:
	TNT1 A 0 A_Jump(256,"Normal","FireBall","FireBall","MiniComet","MiniComet","MiniComet","MiniComet")
  FarRange:
	TNT1 A 0 A_Jump(256,"Normal","FireBall","MiniComet","MiniComet")
  LongRange:
	TNT1 A 0 A_Jump(256,"Normal","FireBall","MiniComet")
  NearRange:
	TNT1 A 0 A_Jump(256,"Normal","FireBall","FireBall","MiniComet")
  CloseRange:
	TNT1 A 0 A_Jump(256,"Normal","Normal","FireBall","MiniComet")
	Goto See
  FireBall:
	ISUL AA 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",23,0,-11)
	TNT1 A 0 A_CustomMissile("PaladinBall",23,0,11)
	TNT1 A 0 A_CustomMissile("PaladinBall",23,0,0)
	ISUL A 6 Bright A_FaceTarget
	Goto See
  MiniComet:
	ISUL AA 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("MiniComet",23,0,0)
	ISUL AA 5 Bright A_FaceTarget
	Goto See
  Pain:
	TNT1 A 0 A_Stop
	ISUL C 5 Bright A_Pain
	Goto See
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	ISUL C 4 Bright A_NoGravity
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ISUL D 4 Bright A_Scream
	TNT1 A 0 A_Explode(20,92,0)
	TNT1 AA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",15,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("Kaboom23",15,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,15,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ISUL E 3 Bright
	ISUL F 2 Bright A_Fall
	ISUL GH 4
	Stop
  }
}

Actor SummonedImpureSoul : ImpureSoul
{
  +NOFEAR
  +NOTARGET
  +NOINFIGHTING
  +DONTBLAST
  -COUNTKILL
  +DONTDRAIN
  DropItem "NewShellPickup", 16, 12
  DropItem "BulletMagPickup" 16, 12
  DropItem "LifeEssence", 16
  DropItem "ArmorBonusMax", 16
  Tag "$CFSImpSoul"
  States
  {
  Spawn:
	ISUL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",25)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	ISUL A 3 Bright A_Look
	TNT1 A 0 A_JumpIfInventory("Tic",700,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Idle:
	ISUL A 1 Bright A_Wander
	TNT1 A 0 A_Look
	ISUL A 1 Bright A_Wander
	TNT1 A 0 A_Look
	ISUL A 1 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_JumpIfInventory("Tic",700,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  See:
	ISUL A 1 Bright A_Chase
	TNT1 A 0 A_Explode(3,65,0)
	ISUL A 1 Bright A_Chase
	TNT1 A 0 A_Explode(3,65,0)
	ISUL A 1 Bright A_Chase
	TNT1 A 0 A_Explode(3,65,0)
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_JumpIfInventory("Tic",700,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  WrongTarget:
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,4)
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("IsACFOverlord",1,"WrongTarget")
	Goto Super::Missile
  Vanish:
	TNT1 A 0 A_TakeInventory("OverlordSpawnAmount3",1,0,AAPTR_MASTER)
	ISUL A 2 Bright A_FadeOut(0.1,1)
	Wait
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_TakeInventory("OverlordSpawnAmount3",1,0,AAPTR_MASTER)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	ISUL C 4 Bright A_NoGravity
	TNT1 A 0 A_PlaySound("weapons/rocklx",0,1.0,0)
	ISUL D 4 Bright A_Scream
	TNT1 A 0 A_Explode(20,92)
	TNT1 AA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",15,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("Kaboom23",15,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,15,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	ISUL E 3 Bright
	ISUL F 2 Bright A_Fall
	ISUL GH 4
	TNT1 A 1
	Stop
  }
}

Actor MiniComet : CFHomingCometBase
{
  Speed 21
  FastSpeed 25
  Scale 0.6
  ReactionTime 29
  Damage (Random(10,20)) //3
  Species "PainElemental"
  DamageType "EleSouls"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(155,"Homing")
	Goto Normal
  }
}