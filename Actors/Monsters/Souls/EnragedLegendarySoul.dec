Actor SoulDevExplosion
{
  Species "PainElemental"
  DamageType "Legendary"
  +NOTIMEFREEZE
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_Explode(309,256)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 A_SpawnItemEx("EnragedCommandoStarShock",0,0,15)
	TNT1 A 0 A_SpawnItem("EnragedDTBFGEx",0,-10)
  SpawnLoop:
	TNT1 A 0 A_CustomMissile("SoulDevastatorBall2",0,0,user_loop * 18,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"SpawnLoop")
	TNT1 A 0 A_SpawnItem("EnragedDTBFGEx")
    Stop
  }
}

Actor SoulDevastatorBall2 : FusionDevastatorBall2
{
  +NOTIMEFREEZE
  Species "PainElemental"
  DamageType "Legendary"
  States
  {
  Spawn:
    DBA2 AB 4 Bright
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SoulDevKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    DBA2 CDE 3 Bright A_Explode(64,128)
    Stop
  }
}

