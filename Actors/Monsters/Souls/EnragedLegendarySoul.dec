	ESOL E 5 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SetUserVar(user_explode,user_explode+1)
	Loop
  Explode4:
