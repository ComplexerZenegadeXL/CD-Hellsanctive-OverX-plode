Actor EnragedLegendarySoul : LegendarySoul
{
  Health 900
  Damage 14
  +BRIGHT
  BloodColor "Red"
  DamageFactor 0.7
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.2
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.5
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "PlayerNemesisPlasma", 0.4
  DropItem "EnragedLegendarySphere" 70 1
  DropItem "EnragedLegendaryArmor" 90 1
  DropItem "ILDemonAmmoBoxPickup" 120
  DropItem "ILDemonAmmoPickup" 240
  DropItem "ILDemonAmmoPickup" 200
  DropItem "ILDemonAmmoPickup" 90
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 6
  DropItem "LegendaryRandomSphere" 16
  SeeSound "EnragedSoul/See"
  PainSound "EnragedSoul/Pain"
  DeathSound "EnragedSoul/Death"
  ActiveSound "EnragedSoul/Active"
  AttackSound "EnragedSoul/Attack"
  Obituary "$CFEnragedLegendarySoulObit"
  Tag "$CFEnrSoul"
  States
  {
  Spawn:
    ESOL A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",26)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    ESOL AAAA 2 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",26)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ESOL AAA 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,409)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SpawnItem("EnragedHellionSmokeSpawner")
	ESOL A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    ESOL AAA 2 A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Teleport")
    Loop
  Rush:
	ESOL A 0 A_Chase
    ESOL A 1 A_SpawnItemEx("ELegSoulGhost")
	TNT1 A 0 A_Jump(12,"See")	
    Loop
  Avoid:
	ESOL A 0 A_SetAngle(angle+random(-80,80))
	ESOL A 0 A_Recoil(-55)
	ESOL A 0 A_FaceTarget
  AvoidLoop:
    TNT1 A 0 A_JumpIf(user_delay == 12,"AvoidEnd")
	ESOL A 1 A_SpawnItemEx("ELegSoulGhost2")
	TNT1 A 0 A_SpawnItem("ESoulFireSpawner")
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  AvoidEnd:
    TNT1 A 0 A_SetUserVar(user_delay,0)
	TNT1 A 0 A_Jump(186,"See")
	ESOL A 1 A_Stop
    Goto Avoid
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ESOL A 1 Bright A_UnSetShootable
	ESOL AAAAA 1 A_FadeOut(0.2,0)
	ESOL AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    ESOL A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ESOL AAAAA 1 A_FadeIn(0.2)
    ESOL A 1 A_SetShootable
    Goto See
  Missile:
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(16,"Super")
	TNT1 A 0 A_Jump(40,"Rage")
	TNT1 A 0 A_Jump(127,"Proj")
  Normal:
	ESOL B 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ESOL B 2 A_SkullAttack(50)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ESOL B 2 A_CposRefire
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ESOL B 2 A_CposRefire
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(188,"See")
	TNT1 A 0 A_Jump(16,"See")
	ESOL B 2 Bright A_CposRefire
	Goto Normal+1	
  Proj:
   	ESOL BB 5 Bright A_FaceTarget
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	ESOL B 0 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoulBall",20,0,frandom(-3,3))
	Goto See
  Rage:	
    TNT1 A 0 A_SetUserVar("user_effect_type",27)
	TNT1 A 0 A_JumpIfHealthLower(300,"Kamikaze")
    ESOL B 1 A_PlaySound("EnragedSoul/See")
	ESOL B 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ESOL B 1 A_FaceTarget
  RageWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 20,"RageGo")
	TNT1 A 0 A_FaceTarget
	ESOL B 2 A_SpawnItem("ELFiendFlameSpawner")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	Loop
  RageGo:
    TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_CustomMissile("ELegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("ELegSoulGhost2")
	ESOL B 2 A_SkullAttack(85)
	TNT1 A 0 A_CustomMissile("ELegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("ELegSoulGhost2")
	ESOL B 2 A_CposRefire
	TNT1 A 0 A_CustomMissile("ELegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("ELegSoulGhost2")
	ESOL B 2 A_CposRefire
	TNT1 A 0 A_CustomMissile("ELegSoulCharge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("ELegSoulGhost2")
	ESOL B 2 A_CposRefire
	Goto RageGo+3
  Super:
  	TNT1 A 0 A_PlaySound("EnragedSoul/See")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
  SuperWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 22,"SuperGo")
	ESOL B 2 A_SpawnItemEx("LSoulFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	Loop
  SuperGo:
	TNT1 A 0 A_Jump(128,"Super2")
	TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	ESOL B 4 A_CustomMissile("ELegSoulBigBall",20,0,0)
	ESOL B 8 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto RageGo
  Super2:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_ragewait",0) 
	ESOL B 4 A_CustomMissile("ELegSoul15K",20)
	ESOL B 8 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoul15K",20)
	ESOL B 8 A_FaceTarget
	ESOL B 4 A_CustomMissile("ELegSoul15K",20)
    Goto See
  Kamikaze:
	ESOL B 1 A_PlaySound("legsoul/see")
	ESOL B 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ESOL B 1 A_FaceTarget
  KamikazeWait:
    TNT1 A 0 A_JumpIf(user_ragewait >= 38,"KamikazeGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	ESOL B 0 A_FaceTarget
	TNT1 A 0 Radius_Quake(4,2,0,80,0)
	ESOL B 2 A_SpawnItem("ELFiendFlameSpawner")
	Loop
  KamikazeGo:
    TNT1 A 0 A_Jump(64,"KamikazeSuper")
    TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
    TNT1 A 0 A_CustomMissile("ELegSoulKamikaze")
	TNT1 A 1 A_ChangeFlag(COUNTKILL,0)
	Stop
  KamikazeSuper:
    TNT1 A 0 A_JumpIf(user_ragewait >= 76,"KamikazeSuperGo")
	TNT1 A 0 A_SetUserVar("user_ragewait",user_ragewait+1)
	ESOL B 0 A_FaceTarget
	TNT1 A 0 Radius_Quake(8,2,0,80,0)
	TNT1 A 0 A_SpawnItem("LHellionSmokeSpawner")
	TNT1 A 0 A_SpawnItemEx("EnragedSphereLightningSpawner",Random(-1,1),Random(-1,1),9)
	ESOL B 2 A_SpawnItemEx("ELFiendFlameSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Loop
  KamikazeSuperGo:
    TNT1 A 0 A_ChangeFlag(NOINTERACTION,1)
    TNT1 A 0 A_CustomMissile("ELegSoulKamikazeSuper")
	TNT1 A 1 A_ChangeFlag(COUNTKILL,0)
	Stop
  Pain:
	TNT1 A 0 A_KillChildren
    TNT1 A 0 A_Jump(8,"Super")	
  	TNT1 A 0 A_Jump(21,"Teleport")	
    ESOL C 2
    ESOL C 2 A_Pain
	TNT1 A 0 A_Jump(128,"Missile")
    Goto See
  Death:
    TNT1 A 0 A_SetTranslucent(0.75,1)
	ESOL D 0 A_Scream
    ESOL DDDDEEEE 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AA 0 A_SpawnItemEx("ESoulPart1",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 A 0 A_SpawnItemEx("ESoulPart2",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 AA 0 A_SpawnItemEx("ESoulPart3",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
    ESOL F 4
	TNT1 A 0 A_Explode(480,240)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("EnragedCommandoStarShock",0,0,15)
    TNT1 AA 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItem("EnragedDTBFGEx",0,-10)
	TNT1 AAAA 0 A_CustomMissile("LegendarySmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
    ESOL G 4 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(1,3),256)
	TNT1 AAAA 0 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
    ESOL H 4
    Stop
  }
}

Actor SummonedEnragedLegendarySoul : EnragedLegendarySoul { Tag "$CFSEnrSoul" -COUNTKILL }

Actor ESoulFire : CardinalFire
{
  Scale 0.3
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	EMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor ESoulFireEx : Kaboom3
{
  Scale 0.2
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	EXPO AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor ESoulFireSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
  TNT1 A 0	
  TNT1 A 0 A_PlaySound("monster/ambientfire3")
  TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  TNT1 A 0 A_SpawnItemEx("ESoulFireEx",frandom(-8,-4),frandom(-4,4),frandom(7,12),0,0,frandom(2,4),0,SXF_CLIENTSIDE)
  TNT1 AAAA 0 A_SpawnItemEx("ESoulFire",frandom(-8,-4),frandom(-4,4),frandom(7,12),0,0,frandom(2,4),0,SXF_CLIENTSIDE)
  TNT1 A 1
  Stop
  }
}

Actor ELegSoulBall : LegSoulBall
{
  +NOTIMEFREEZE
  Damage (Random(30,45)) //8
  States
  {
  Spawn:
    TNT1 A 0 A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ESA1 AB 3 Bright
	TNT1 A 0 A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ESA1 CD 3 Bright
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner")
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ESA1 EFGHIJ 3 Bright
    Stop
  }
}

Actor ELegSoulBigBall : LegSoulBigBall
{
  +NOTIMEFREEZE
  Damage (Random(50,75)) //damage was already bloated as hell
  States
  {
  Spawn:
	ESA2 ABCD 2 Bright A_SpawnItemEx("ELegSoulBigBallTrail")
	Loop
  Death:
  	TNT1 A 0 A_SpawnItemEx("EnragedBFGShockwave")
    TNT1 AAAAAA 0 A_CustomMissile("EKaboomLNMute",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAA 0 A_SpawnItemEx("EnragedParticleSpawner")
	TNT1 A 0 A_Explode(Random(100,150),320,0) //like jesus christ, it's a soul, Blood
	ESA2 EFG 4 Bright
	Stop
 }
}

Actor ELegSoul15K : BFG15KBall 
{
  Species "PainElemental"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +STRIFEDAMAGE
  Damage (Random(100,200)) //40
  Speed 37
  States
  {
  Spawn:
    EFS1 AB 2 Bright A_SpawnItemEx("EnragedParticleSpawner",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("EnragedBFGShockwave")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAA 0 A_CustomMissile("Kaboom14", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))      
    EFE1 A 4 Bright A_Explode(128,128,0)
    EFE1 BCDEF 4 Bright
    Stop
    }
}

Actor ELegSoulBigBallTrail : BFG9500Trail
{
  Scale 2.9
  Alpha 0.67
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    ESA2 ABCDABCD 2 A_FadeOut(0.1)
	Stop
  }
}

Actor ELegSoulGhost : LegendarySoulGhost
{
  Scale 1.25
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
    ESOL A 2 A_FadeOut(0.10)
    Goto Fade+1
  }
}

Actor ELegSoulGhost2 : ELegSoulGhost
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 0
    TNT1 A 1
    ESOL C 2 A_FadeOut(0.10)
    Goto Fade+2
  }
}

Actor ELegSoulCharge : BigLFLunge
{
  Species "PainElemental"
  DamageType "Legendary"
  States
  {
  Spawn:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,282)
	Stop
  Death:
	TNT1 A 2
	TNT1 A 1 A_Explode(68,282)
	Stop
  }
}

Actor ELSoulFlameSpawner : LegendaryRedParticleSpawner
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAAAA 0 A_SpawnItemEx("ELFiendFlame",random(20,-20),random(20,-20),random(40,80),0,0,random(2,6),0,128,0)
    TNT1 A 1
    Stop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor ELegSoulEventSmokeSpawner : LegendaryRedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("ELegSoulEventSmoke",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor ELegSoulEventSmoke
{
  +MISSILE
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NOTIMEFREEZE
  Scale 0.4
  RenderStyle Add
  States
  {
  Spawn:
	EMKE ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor ESoulPart1 : SoulPart1
{
  SeeSound ""
  +NOTIMEFREEZE
  +NOBLOCKMAP
  States
  {
  Spawn:
	EGI1 ABCDEFGH 4
	Loop
  Death:
  Crash:
	EGI1 E 150
	EGI1 E 5 A_FadeOut(0.10)
	Goto Death+1
  }
}

Actor ESoulPart2 : SoulPart1
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	EGI2 ABCDEFGH 4
	Loop
  Death:
  Crash:
	EGI2 D 150
	EGI2 D 5 A_FadeOut(0.10)
	Goto Death+1
  }
}

Actor ESoulPart3 : SoulPart1
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	EGI3 ABCDEFGH 4
	Loop
  Death:
  Crash:
	EGI3 A 150
	EGI3 A 5 A_FadeOut(0.10)
	Goto Death+1
  }
}

Actor ELegSoulKamikaze
{
  Radius 16
  Height 56
  Health 100
  Damage (Random(150,300)) //50
  Speed 45
  Scale 1.2
  DropItem "EnragedLegendarySphere" 70 1
  DropItem "EnragedLegendaryArmor" 90 1
  DropItem "ILDemonAmmoBoxPickup" 120
  DropItem "ILDemonAmmoPickup" 240
  DropItem "ILDemonAmmoPickup" 200
  DropItem "ILDemonAmmoPickup" 90
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  SeeSound "EnragedSoul/Attack"
  DeathSound "EnragedSoul/Death"
  Species "PainElemental"
  DamageType "Legendary"
  Tag "\c[m6]Enraged\c- \c[z3]Legendary Soul\c-"
  Decal "Scorch"
  Projectile
  +SOLID
  +SHOOTABLE
  +NOBLOOD
  +NOBLOODDECALS
  +SKYEXPLODE
  +NOTARGETSWITCH
  +NOTIMEFREEZE
  -NOBLOCKMAP
  +BRIGHT
  var int user_music;
  States
  {
  Spawn:
	ESOL BB 3 A_SpawnItem("ELFiendFlameSpawner")
    Loop
  Death:
	TNT1 A 0 A_Die
  Explode:
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 AA 0 A_SpawnItemEx("ESoulPart1",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
