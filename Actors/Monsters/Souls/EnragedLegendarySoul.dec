    TNT1 AAA 0 A_SpawnItemEx("EnragedParticleSpawner")
	TNT1 A 0 A_Explode(480,240)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("EnragedCommandoStarShock",0,0,15)
	TNT1 A 0 A_SpawnItem("EnragedDTBFGEx",0,-10)
	ESOL DDDDEEEE 2 A_SpawnItemEx("EKaboomLNMute",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),2,frandom(0,360))
