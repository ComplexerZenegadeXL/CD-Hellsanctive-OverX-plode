Actor TLSRainCometSpawner : RainCometSpawner
{
  XScale 3.5
  YScale 0.56
  var int user_loop;
  States
  {
  Spawn:
	TNT1 AAAAA 1 A_Wander
	MRAI ABCDEFGHIJABCDEFGHIJ 1 Bright A_Wander
  SpawnLoop:
    TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI AAAAAAAA 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI BBBBBBBB 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI CCCCCCCC 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI DDDDDDDD 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI EEEEEEEE 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI FFFFFFFF 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI HHHHHHHH 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI IIIIIIII 1 Bright A_Wander
	TNT1 A 0 A_CustomMissile("MindComet",-18,frandom(0,20),frandom(0,360),CMF_AIMDIRECTION)
	MRAI JJJJJJJJ 1 Bright A_Wander
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 2,1)
	Loop
	TNT1 A 0
  FadeOut:
	MRAI ABCDEFGHIJ 2 Bright A_FadeOut(0.06)
    Goto FadeOut
  }
}

