Actor TrueLegBombTrail : LegBombTrail
{
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 //A_SetScale(ScaleX -0.01, ScaleY -0.01)
	UBAL BFBFB 1 Bright A_FadeOut(0.05)
	Loop
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor TrueLegSentientMassResurrectionEffect : LegSentientMassResurrectionEffect
{
  Speed 15
  States
  {
  Spawn:
	TNT1 A 10
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop:
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LBA3 A 1 Bright A_SpawnItemEx("TSRTTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LBA3 B 1 Bright A_SpawnItemEx("TSRTTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LBA3 C 1 Bright A_SpawnItemEx("TSRTTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 17,1)
	Loop
	TNT1 A 0
	Stop
  }
}

Actor TSRTTrail : LSRTTrail
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LBA3 ABCABCABCABCABCABC 1 Bright A_FadeOut(0.05)
	Stop
  }
}

