	TNT1 A 0 A_Explode(80,256)
	TRD5 A 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(80,256)
	TRD5 B 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(80,256)
	TRD5 C 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(80,256)
	TRD5 D 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(128,1024,0)
	TNT1 A 0 A_Explode(460,640,0)
	TNT1 A 0 A_Explode(618,256)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("TrueLegDevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("TLegCybDTBFGEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetUserVar("user_loop",1)
  DeathLoop2:
	TRD5 D 0 Bright A_CustomMissile("TrueLegSentDevastatorBall2",0,0,user_loop*18,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop2")
	TRD5 AAAAAABBBBBBCCCCCCDDDDDD 1 A_CustomMissile("TrueLegKaboomDevastator22",0,0,random(0,360),2,random(0,360))
    TRD5 EF 6 Bright
    Stop    
  }
}

