	MRAI J 1 A_Wander
	MRAI J 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI A 0 A_SetUserVar(User_Wander, User_Wander+1)
	Goto Spawn+1
  SpawnLeg:
    TNT1 A 0 A_SpawnItemEx("FakeLegendaryZombie",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION)
	MRAI ABCDEFGHIJABCDEFGHIJ 1 A_FadeOut
	Stop
