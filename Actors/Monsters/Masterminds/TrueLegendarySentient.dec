	MRAI F 1 A_Wander
	MRAI F 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI G 1 A_Wander
	MRAI G 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI H 1 A_Wander
	MRAI H 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI I 1 A_Wander
