  PainChance "DBFG2Splash", 256
  PainChance "DBFG2", 256
  PainChance "DBFG", 256
  PainChance "PlayerDBFG", 256
  PainChance "DBFG10K2", 256
  Speed 16
  Radius 65
  Height 100
  FloatSpeed 32
  Obituary "$CFTrueLegendarySentientObit"
  BloodColor "Blue"
  Species "Masterminds"
  +FLOAT
  +NOGRAVITY
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +MISSILEMORE
  +FIRERESIST
  +DONTMORPH
  +BOSSDEATH
  +NOICEDEATH
  +LOOKALLAROUND
  +DONTGIB
  +NOTELEFRAG
  +DONTRIP
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +CANTSEEK
  +NOFEAR
  +AVOIDMELEE //hehe
  -FLOORCLIP
  Monster
  DropItem "LDemonAmmoBoxPickup" 256 
  DropItem "LDemonAmmoPickup" 256
  //DropItem "LegendaryBFGGiver" 256
  DropItem "BossLifeEssence" 256 
  DropItem "BossArmorBonusMax" 256 
  DropItem "SkullOfPowerGiver" 192
  //DropItem "LegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryAmmoSphere" 256
  DropItem "LegendaryDemonRune" 256
  //DropItem "LegendaryAssaultShotgunGiver" 256
  DropItem "LegendaryArmor" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 256 
  DropItem "LegendarySphere" 256
  DropItem "LegendaryTimeFreezeSphere" 256
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 256
  DropItem "LegendaryBulletBoxPickup" 256 
  DropItem "LegendaryLMGBulletMagPickup" 256 1
  //DropItem "LegendaryLightMachineGunGiver" 256
  DropItem "TrueLegendaryBFGUpgrade" 250
  DropItem "LegendaryPowerSphere" 256
  DropItem "LegendaryPowerShard" 256
  //DropItem "LegendaryCoachgunGiver" 256
  //DropItem "LegendarySaberGiver" 256
  DropItem "TrueLegendaryUltraSphere" 256
  //DropItem "LegendaryBFG10KGiver" 256
  DropItem "LegendaryRandomSphere" 32
  DamageFactor 0.55
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Melee", 3.0
  DamageFactor "PDTBFG", 0.05
  DamageFactor "BabySpiders", 0.0
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFGTracer", 0.05
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "BFGSplash", 0.25
  DamageFactor "PlayerBHole", 0.0
  DamageFactor "BFGSpray", 0.25
  DamageFactor "PlayerDevBall", 0.015
  DamageFactor "Railg", 0.5
  DamageFactor "PlayerDevBall2", 0.015
  DamageFactor "PlayerDevTracer", 0.015
  DamageFactor "PlayerDTRG", 0.05
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "Term", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Crush", 0.1
  DamageFactor "Player", 0.015
  DamageFactor "PlayerHellfire", 0.3
  DamageFactor "CDTBFG", 0.0
  DamageFactor "DBFG10K", 0.015
  DamageFactor "NobleComet", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "PlayerDBFG10K", 0.015
  DamageFactor "DBFG", 0.015
  DamageFactor "PlayerBHole", 0.1
  DamageFactor "PlayerDBFG2", 0.015
  DamageFactor "DBFG210K", 0.015
  DamageFactor "PlayerDBFG210K", 0.015
  DamageFactor "PlayerDBFG", 0.015
  DamageFactor "DBFG2Splash", 0.015
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Explosion", 0.1
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Baby15K", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "HFCyber", 0.0
  DamageFactor "DementedTerminator", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Commander", 0.0
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.6
  PainChance "PlayerDBFG2", 256
  PainChance "DBFG2", 256
  PainChance "PlayerDBFG10K2", 256
  SeeSound "TrueLegSent/See"
  PainSound "TrueLegSent/StrongPain"
  DeathSound "TrueLegSent/Death"
  ActiveSound "TrueLegSent/StrongAct"
  Tag "$CFTLegSent"
  var int user_script;
  var int user_script_type;
  var int user_music;
  var int user_tlsdelay; // already included.
  var int user_legportal;
  var int user_legspawns;
  var int user_babies;
  var int user_LegendaryBalance;
  var int user_storm;
  var int user_loop;
  States
  {
  Spawn:
	TLSN A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,4)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",3)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,3)
  Idle:
	TLSN A 0 A_UnsetInvulnerable
	TLSN A 0 A_FadeIn(1.0)
	TLSN A 0 ThrustThingZ(0,10,1,0)
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN AB 2 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,23)
	TNT1 A 0 A_SetUserVar("user_music",1)
	//TLSN A 0 A_JumpIfCloser(350, "GoAway")
	TLSN A 0 A_UnsetInvulnerable
	TLSN A 0 A_FadeIn(1.0) //fail safes
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN AB 2 Bright A_Chase
	//TNT1 A 0 A_Jump(60, "Dodge")
	//TNT1 A 0 A_Jump(48, "Teleport")
	Loop	
  GoAway:
    TLSN A 0 ThrustThing(Angle*256/360,1,0,0)
    TNT1 A 0 A_Recoil(30)
	TLSN A 0 A_JumpIfCloser(350, "Teleport")
	Goto See
  Dodge:
	TNT1 A 0 A_Jump(256, "DodgeLeft", "DodgeRight")
  DodgeLeft:
    TLSN A 5 Bright ThrustThing(Angle*256/360+64, Random(25,45),0,0)
	Goto See
  DodgeRight:
    TLSN A 5 Bright ThrustThing(Angle*256/360-64, Random(25,45),0,0)
	Goto See
  Teleport:
    TLSN A 0 ThrustThing(Angle*256/360,1,0,0)
    TLSN A 0 A_UnSetShootable
	TLSN AAAAA 1 Bright A_FadeOut(0.2,0)
	TLSN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	TLSN A 0 A_Jump(128, "TeleDodge")
  TeleAfter:
    TLSN A 1 A_PlayWeaponSound("boss/teleport")
	TLSN AAAAA 1 Bright A_FadeIn(0.2)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TLSN A 0 A_SetShootable
	//TLSN A 0 A_Jump(96, "MoreTeleports")
    Goto See
  TeleDodge:
    TLSN A 0 A_SetAngle(Random(0,359))
	TLSN A 0 A_Recoil(Random(30,45))
	TLSN A 0 A_FaceTarget
	Goto TeleAfter
  MoreTeleports:
    TLSN A 0 A_JumpIf(user_tlsdelay > 5, "Dodge")
    TLSN A 0 A_UnSetShootable
	TLSN AAAAA 1 Bright A_FadeOut(0.2, 0)
	TLSN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TLSN A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLSN AAAAA 1 Bright A_FadeIn(0.2)
    TLSN A 0 A_SetShootable
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Loop
  Missile:
    TLSN A 0 A_UnsetInvulnerable
	TLSN A 0 A_FadeIn(1.0)
	TLSN A 0 A_SetUserVar(user_tlsdelay,0)
	TNT1 A 0 A_CheckFlag("FRIENDLY","MissileDecide")
	TLSN A 0 A_JumpIfHealthLower(2666,"SpawnLegs2")
	TNT1 A 0 A_JumpIf(user_LegendaryBalance == 1,2)
	TLSN A 0 A_JumpIfHealthLower(3999,"LegendaryBalance")
	TLSN A 0 A_JumpIfHealthLower(5333,"SpawnLegs")
	Goto MissileDecide
  SpawnLegs:
    TNT1 A 0 A_JumpIf(User_Legportal >= 1,"MissileDecide")
	TNT1 A 0 A_SetUserVar(user_tlsdelay,0)
	TNT1 A 0 A_PlaySound("Gateway/Hell",CHAN_AUTO,1.0,True)
	TLSN A 0 A_SetInvulnerable
	TLSN A 0 ThrustThing(Angle*256/360,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLegsLoop:
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TLSN A 0
  SpawnLegs3:
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
  SpawnLegs3Loop:
	TLSN A 0 A_JumpIf(user_tlsdelay >= 9, "SpawnLegFriends")
	TLSN QQQQQQQ 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Loop
  SpawnLegFriends:
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_PlaySound("TrueLegSent/Pain", 8, 1.0, false, ATTN_NONE)
	TLSN A 0 A_JumpIf(User_LegSpawns == 6, "LegFriend7")
	TLSN A 0 A_JumpIf(User_LegSpawns == 5, "LegFriend6")
	TLSN A 0 A_JumpIf(User_LegSpawns == 4, "LegFriend5")
	TLSN A 0 A_JumpIf(User_LegSpawns == 3, "LegFriend4")
	TLSN A 0 A_JumpIf(User_LegSpawns == 2, "LegFriend3")
	TLSN A 0 A_JumpIf(User_LegSpawns == 1, "LegFriend2")
  LegFriend:
    TNT1 AA 0 A_SpawnItemEx("TLSLegZombSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend2:
    TNT1 AA 0 A_SpawnItemEx("TLSLegCaptainSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend3:
    TNT1 A 0 A_SpawnItemEx("TLSLegStealthSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TLSLegCommandoSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend4:
    TNT1 AA 0 A_SpawnItemEx("TLSLegImpSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend5:
    TNT1 A 0 A_SpawnItemEx("TLSLegFiendSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TLSLegSoulSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend6:
    TNT1 A 0 A_SpawnItemEx("TLSLegHKSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("TLSLegRevSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriend7:
    TNT1 A 0 A_SpawnItemEx("TLSLegBabySentSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish
  LegFriendFinish:
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
    TNT1 A 0 A_SetUserVar(User_LegSpawns, User_LegSpawns+1)
	TNT1 A 0 A_JumpIf(User_LegSpawns >= 7, "SpawnLegsFinish")
	TLSN PPPPP 4 Bright A_FaceTarget
	Goto SpawnLegs3
  SpawnLegsFinish:
    TNT1 A 0 A_SetUserVar(User_LegSpawns, 7)
	TNT1 A 0 A_SetUserVar(User_LegPortal, 1)
    TLSN P 60 Bright
	TLSN A 0 A_UnsetInvulnerable
	Goto Dodge
  SpawnLegs2:
    TNT1 A 0 A_JumpIf(User_Legportal >= 2, "MissileDecide")
	TNT1 A 0 A_SetUserVar(User_LegSpawns, 7)
	TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
	TNT1 A 0 A_PlaySound("Gateway/Hell", CHAN_AUTO, 1.0, True)
	TLSN A 0 A_SetInvulnerable
	TLSN A 0 ThrustThing(Angle*256/360, 0, 0, 0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLegs2Loop:
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TLSN A 0
  SpawnLegs4:
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
	TLSN PPPPP 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-320,320), frandom(-320,320), 0, 0, 0, 0, frandom(0,360))
  SpawnLegs4Loop:
	TLSN A 0 A_JumpIf(user_tlsdelay >= 9, "SpawnLegFriends2")
	TLSN QQQQQQQ 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Loop
  SpawnLegFriends2:
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("brain/spit", 8, 1.0, True)
	TLSN RRR 2 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_PlaySound("TrueLegSent/Pain", 8, 1.0, false, ATTN_NONE)
	TLSN A 0 A_JumpIf(User_LegSpawns == 12, "LegFriend13")
	TLSN A 0 A_JumpIf(User_LegSpawns == 11, "LegFriend12")
	TLSN A 0 A_JumpIf(User_LegSpawns == 10, "LegFriend11")
	TLSN A 0 A_JumpIf(User_LegSpawns == 9, "LegFriend10")
	TLSN A 0 A_JumpIf(User_LegSpawns == 8, "LegFriend9")
	TLSN A 0 A_JumpIf(User_LegSpawns == 7, "LegFriend8")
  LegFriend8:
    TNT1 A 0 A_SpawnItemEx("TLSLegCybHKSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriend9:
    TNT1 A 0 A_SpawnItemEx("TLSLegRedSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriend10:
    TNT1 AA 0 A_SpawnItemEx("TLSLegTormSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriend11:
    TNT1 A 0 A_SpawnItemEx("TLSLegBeheSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriend12:
    TNT1 A 0 A_SpawnItemEx("TLSLegBabySentSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriend13:
    TNT1 A 0 A_SpawnItemEx("TLSLegSentSpawner",0,0,64,0,0,0,0,SXF_NOCHECKPOSITION)
	Goto LegFriendFinish2
  LegFriendFinish2:
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
    TNT1 A 0 A_SetUserVar(User_LegSpawns, User_LegSpawns+1)
	TNT1 A 0 A_JumpIf(User_LegSpawns >= 13, "SpawnLegsFinish2")
	TLSN PPPPPPPPPP 2 Bright A_FaceTarget
	Goto SpawnLegs4
  SpawnLegsFinish2:
	TNT1 A 0 A_SetUserVar(User_LegPortal, 2)
    TLSN P 60 Bright
	TLSN A 0 A_UnsetInvulnerable
	Goto Dodge
  MissileDecide:
	TLSN A 0 A_Jump(176, "WeakAttack")
	TLSN A 0 A_Jump(256, "StrongAttack")
  WeakAttack:
    TLSN A 0 A_PlaySound("Truelegsent/StrongAttack")
	TLSN A 0 A_Jump(164, "BFG10KSpam", "RailgunSpam")
	TLSN A 0 A_Jump(156, "LegPlasmaCannon", "DTBFG")
	TLSN A 0 A_Jump(144, "Homing10k", "TruelegDevastator")
	TLSN A 0 A_Jump(136, "LegBombs")
    Goto LegBombs
  BFG10KSpam:
    TNT1 A 0 A_PlaySound("weapons/charge15k")
    TLSN PPPPPPPPPP 2 Bright A_FaceTarget
	TLSN A 0 A_JumpIfCloser(500, "BFG10KSpamTeleport")
  BFG10KSpamming:
    TLSN A 0 A_JumpIf(user_tlsdelay >= 50, "BFG10KSpamStop")
	TLSN A 0 A_GiveInventory("TrueLegSentientStrafe", 1)
	TLSN A 0 A_PlaySound("weapons/bfg15kfire")
	TLSN F 0 A_CustomMissile("TrueLegendarySentient10KProjectile",20,-20,frandom(-3,3))
