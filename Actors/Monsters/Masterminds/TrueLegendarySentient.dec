	CBR6 A 1 Bright A_CustomMissile("TLSTrapProj",0,0,0)
	Stop	
  }
}

Actor TLSTrapProj : LBSTrapProj { Species "Masterminds" DamageType "Legendary" }

Actor TLSPredatorSpawner : TLSTrapSpawner
{
  Radius 16
  Height 40
  States
  {
   Death:
    TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 5 A_SpawnItemEx("TLSPredatorDrone")
	TNT1 A 1 A_Fall
	Stop	
  }
}

Actor TLSPredatorDrone
{
  Health 75
  Speed 19
  Radius 12
  Height 38
  Monster
  +NOBLOOD
  +NOPAIN
  +DONTFALL
  +NOGRAVITY
  +FLOAT
  +FLOATBOB
  +MISSILEMORE
  +MISSILEEVENMORE
  -COUNTKILL
  Species "Masterminds"
  DamageType "Legendary"
  SeeSound "drone/sight"
  ActiveSound "drone/active"
  DeathSound "drone/death"
  Scale 1.0
  DamageFactor "Baby15K", 0.0
  Obituary "$CFTLSPredatorDroneObit"
  var int user_delay;
  States
  {
  Spawn:
    TNT1 A 0 A_JumpIf(user_delay >= 1575,"Done")
    TNT1 A 0 A_SetUserVar("user_delay",user_delay+2)
	CBR7 A 4 Bright A_Look
	Loop
  See:
    TNT1 A 0 A_JumpIf(user_delay >= 1575,"Done")
    TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
    CBR7 A 2 Bright A_Chase   
    Loop
  Done:
    CBR7 A 1 Bright A_Die
    Goto See
  Missile:
    CBR7 B 6 Bright A_FaceTarget
    CBR7 B 0 A_CustomMissile("MiniLBSEnergyBolt",5,10,0)	
    CBR7 B 5 Bright A_CustomMissile("MiniLBSEnergyBolt",5,-10,0)
	CBR7 A 4 Bright A_FaceTarget
    Goto See
  Death:
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0
    Stop
  }
}

Actor TLSTurretSpawner : TLSPredatorSpawner
{
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 5 A_SpawnItemEx("TLSTurret")
	TNT1 A 1 A_Fall
	Stop	
  }
}

Actor TLSTurret : TLSPredatorDrone
{
  Speed 0
  Mass 9999999
  AttackSound "Weapons/LegAutoShotgun"
  +NOTARGET
  +NOINFIGHTING
  +AMBUSH
  DropItem "LegendaryShellPickup" 48 4
  States
  {
  Spawn:
    TNT1 A 0 A_JumpIf(user_delay >= 1575,"Done")
    TNT1 A 0 A_SetUserVar("user_delay",user_delay+2)
	CBR8 A 4 Bright A_LookEx(LOF_NOSIGHTCHECK)
	Loop
  See:
    TNT1 A 0 A_JumpIf(user_delay >= 1575,"Done")
    TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
    CBR8 AAAAAAAAAA 2 Bright A_Chase  
	CBR8 A 2 Bright A_ClearTarget
    Loop
  Done:
    CBR8 A 1 Bright A_Die
    Goto See
  Missile:
    CBR8 A 0 A_PlaySound("drone/alarm")
    CBR8 AA 5 Bright A_FaceTarget
	TNT1 AAAA 0 A_CustomMissile("LegendaryBlueTracer",0,0,frandom(6,-6),0)
    CBR8 B 0 A_SpawnItemEx("BlueShellCasing", -8, 7, 0, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
	CBR8 B 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(15,30),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	CBR8 B 1 Bright A_CposRefire
	Goto Missile+3
  Death:
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), 2, frandom(0,360))   
	TNT1 A 0
    Stop
  }
}

