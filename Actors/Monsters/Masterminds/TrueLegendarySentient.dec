Actor TrueLegendarySentient : SpiderMastermind 16533
{
  //$Category Monsters/LCA
  //$Sprite TLSNA1
  //$Title "True Legendary Sentient"
  Health 7999
  Scale 1.2
  Mass 0x7FFFFFFF
  PainChance 1
  PainChance "PlayerDevBall", 50
  PainChance "BFG10K", 50
  PainChance "PDTBFG", 50
  PainChance "DTBFG10KBall", 50
  PainChance "PDTBFGTracer", 50
  PainChance "PlayerDBFG2", 256
