Actor TLSBomb
{
  Height 20
  Radius 10
  Scale 1.5
  Speed 50
  Projectile
  BounceCount 6
  Gravity 0.4
  WallBounceFactor 0.75
  BounceFactor 0.76
  +SEEKERMISSILE
  +RANDOMIZE
  +DOOMBOUNCE
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +SKYEXPLODE
  +DONTSPLASH
  -NOGRAVITY
  SeeSound "Weapons/GrenadeBounce"
  Species "Masterminds"
  DamageType "Legendary"
  States
  {
  Spawn:
    CBR6 AAAAABBBBB 1 A_SpawnItemEx("TLSBombTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(5, 4)
	Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("DeathBall2")
	Stop
  }
}

Actor TLSBombTrail
{
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NORADIUSDMG
  +NOTELEPORT
  +NOGRAVITY
  Scale 1.5
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	CBR6 AAAAAAAAAAAAAAAAAAAA 1 A_FadeOut
	Stop
  Vanilla:
    TNT1 A 0
	Stop
  }
}
  
