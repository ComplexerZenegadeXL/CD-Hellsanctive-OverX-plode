Actor KaboomBlueSent : KaboomGoldSent
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BXPO AABBCDEFGHIJKLM 2 Bright A_FadeOut(0.05)
	Stop
  }
}

