	TLSN R 1 Bright A_CustomMissile("TrueCommotionBall",40,0,frandom(-180,180),CMF_AIMDIRECTION,frandom(-180,180))
	TLSN R 0 A_FaceTarget
	TLSN R 0 A_CustomMissile("TrueCommotionBall",40,0,frandom(-180,180),CMF_AIMDIRECTION,frandom(-180,180))
	TLSN R 0 A_CustomMissile("TrueCommotionBall",40,0,frandom(-180,180),CMF_AIMDIRECTION,frandom(-180,180))
	TLSN R 1 Bright A_CustomMissile("TrueCommotionBall", 40,0,frandom(-180,180),CMF_AIMDIRECTION,frandom(-180,180))
	TNT1 A 0 A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN R 0 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN R 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
    Loop
  TrueCommotionFinisher:
    TLSN QQQQQ 4 Bright A_FaceTarget
    TNT1 A 0 A_PlaySound("TrueLegSent/MindRape")
	TLSN PPPPP 4 Bright A_FaceTarget
    TNT1 A 0 A_Jump(96, "TrueLegBfgCombo","TrueLegBomb")
	Goto See
  TrueProtonCannon:
    TLSN P 2 Bright A_FaceTarget
    TLSN A 0 A_SetInvulnerable
	TNT1 A 0 Radius_Quake (40,350,0,90,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueProtonCannonLoop:
    TLSN A 0 A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN P 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	TLSN A 0
  TrueProtonCannonCharging:
    TNT1 A 0 A_JumpIf(user_tlsdelay >= 32,"TrueProtonCannonGo")	 
    TNT1 A 0 A_SetUserVar("user_tlsdelay",user_tlsdelay+1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLSN N 2 Bright A_GiveInventory("TrueLegSentientStrafe",1)
    Loop
  TrueProtonCannonGo:
    TLSN A 0 A_SetUserVar("user_tlsdelay",0)
	TNT1 A 0 A_JumpIf(user_tlsdelay >= 12,"TrueProtonCannonFinish")
    TLSN A 0 A_UnSetShootable
	TLSN A 0 ThrustThing(Angle*256/360,1,0,0)
	TLSN NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 0 A_Wander
    TLSN A 0 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLSN A 0 A_FaceTarget
	TLSN AAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner3",0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLSN A 0 A_SetShootable
  Dodge2:
    TNT1 A 0 A_Jump(256, "Dodge2Left", "Dodge2Right")
  Dodge2Left:
    TLSN A 5 Bright ThrustThing(Angle*256/360+64,Random(15,35),0,0)
	Goto ProtonFire
  Dodge2Right:
    TLSN A 5 Bright ThrustThing(Angle*256/360-64,Random(15,35),0,0)
	Goto ProtonFire
  ProtonFire:
	TLSN N 5 Bright A_FaceTarget
	LUPR O 0 A_PlaySound("Petrovec/Fire",1)
    LUPR O 0 A_PlaySound("Petrovec/AddFire",6)
    LUPR O 0 A_PlaySound("Petrovec/Ambient",5)
	TLSN O 6 Bright A_CustomMissile("TrueProtonBall",50,0,frandom(15,-15))
	TNT1 A 0 A_SetUserVar("user_tlsdelay",user_tlsdelay+1)
	Goto TrueProtonCannonGo+1
  TrueProtonCannonFinish:
    TLSN A 0 A_UnsetInvulnerable
    TLSN PPPPPPPPPP 4 Bright A_FaceTarget
	Goto Teleport
  AntiMatterCannon:
    TNT1 A 0
    Goto TrueProtonCannon
  TrueLegendaryStorm:
    TNT1 A 0
    Goto TrueProtonCannon
  LegendaryFlares:
    TNT1 A 0
    Goto TrueProtonCannon
  SpecialAttack:
    TNT1 A 0
    Goto TrueProtonCannon
  Pain:
    TLSN H 3 Bright
	TLSN H 3 Bright A_Pain
	TLSN A 0 A_Jump(8, "PainRage")
	TNT1 A 0 A_CheckFlag("FRIENDLY",4)
	TLSN A 0 A_Jump(18, "LegendaryBalance")
	TNT1 A 0 A_Jump(28, "Minions")
	TLSN A 0 A_Jump(38, "ResurrectWave")
	TLSN A 0 A_Jump(48, "LegBombs", "TrueLegBomb")
	TLSN A 0 A_Jump(188, "Missile")
	Goto See
  PainRage:
    TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_GiveInventory("Health",999)
	TLSN A 0 ACS_NamedExecuteAlways("TrueLegsentRage")
    TLSN HHHH 4 Bright 
	TNT1 A 0 A_SetUserVar("user_storm",0)
    TNT1 A 0 A_PlaySound("sentient/laugh",CHAN_AUTO,1.0,False,ATTN_NONE) 
	TLSN HH 4 Bright A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLSN H 4 Bright A_FaceTarget
	TLSN HHHHHHH 4 Bright A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
  StormLoop:
	TNT1 A 0 A_JumpIf(user_storm >= 40,"StormEnd")	 
    TNT1 A 0 A_SetUserVar("user_storm",user_storm+1)
	TNT1 A 0 A_VileTarget("LegCardinalStormBoltAttack")
	TLSN HHHH 2 Bright A_SpawnItemEx("LegRainCometSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,64)
	TNT1 AAAAAA 0 A_SpawnItemEx("LegCardinalStormBoltSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,64)
	TNT1 AAAAAA 0 A_SpawnItemEx("LegCardinalStormBoltSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,64)
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  StormEnd:
	TLSN H 4 Bright 
	TNT1 A 0 A_UnSetInvulnerable
   	Goto See
  Minions:
	TNT1 A 0 A_PrintBold("Minions")
	TNT1 A 0 A_SetInvulnerable
	TLSN PPPP 6 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",699)
	TNT1 A 0 A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN P 3 Bright A_PlaySound("sentient/laugh",CHAN_AUTO,1.0,False,ATTN_NONE)
	TLSN PP 3 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN PP 3 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MinionsLoop:
	TLSN P 1 Bright A_CustomMissile("TDualachnotron",0,0,user_loop * 120)
	TLSN P 1 Bright A_CustomMissile("TBabyDemolisher",0,0,(user_loop * 120 + 30))
	TLSN P 1 Bright A_CustomMissile("TFusionite",0,0,(user_loop * 120 + 60))
	TLSN P 1 Bright A_CustomMissile("TBabySentient",0,0,(user_loop * 120 + 90))
	//TNT1 A 0 ACS_NamedExecuteWithResult("ShowUserLoop")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 3,1)
	Loop
	TLSN PPPPP 6 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_UnSetInvulnerable
	TLSN P 3 Bright
	Goto See
  ResurrectWave:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TLSN A 3 Bright
	TLSN A 3 Bright A_Pain
	TLSN A 12 Bright 
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 Radius_Quake(20,80,0,600,0)
	TNT1 A 0 A_GiveInventory("Health",850)
	TNT1 A 0 A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLSN P 3 Bright A_PlaySound("sentient/laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ResurrectWaveLoop:
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrectionEffect",10,0,user_loop*30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,2)
	TNT1 A 0 A_Jump(256,"ResurrectWaveLoop")
	TLSN PP 3 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",1)
  ResurrectWaveLoop2:
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrectionEffect",10,0,user_loop*15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,2)
	TNT1 A 0 A_Jump(256,"ResurrectWaveLoop2")
	TLSN PP 3 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",1)
  ResurrectWaveLoop3:
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrection",10,0,user_loop*10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"ResurrectWaveLoop3")
	TLSN PPPPPPPPPP 3 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",1)
  ResurrectWaveLoop4:
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrection",10,0,user_loop*10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"ResurrectWaveLoop4")
	TLSN PPPPPP 6 Bright A_SpawnItemEx("TrueLegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_UnSetInvulnerable
	TLSN A 3 Bright 
	Goto See	
  Pain.PlayerDBFG10K2:
  Pain.DBFG10K2:
  Pain.DBFG:
  Pain.PlayerDBFG:
  Pain.DBFG2:
  Pain.PlayerDBFG210K:
  Pain.DBFG210K:
  Pain.DBFG2Splash:
  Pain.PlayerDBFG2:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	Goto Teleport
  Pain.Melee:
	TNT1 A 0 A_Jump(256,"Pain.Fists")
	Goto See
  Death:
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
    TLSN H 2 Bright A_Scream
	TLSN A 0 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteWithResult("ReturnLoot",0)
	TLSN A 0 A_JumpIf(user_tlsdelay >= 65, "Death2")
	TLSN H 2 Bright A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto Death+4
  Death2:
    TNT1 AAAA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLSN A 0 A_SpawnItemEx("TrueDeathBall")
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
	TLSN A 0 A_JumpIf(user_tlsdelay >= 65, "KamikazeDecide")
	TLSN I 2 A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto Death2+12
  KamikazeDecide:
    TNT1 AAAA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLSN A 0 A_SpawnItemEx("TrueDeathBall")
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
	TLSN A 0 A_JumpIfTargetInLOS(1)
	Goto NoKamikaze4U
  KamikazeCharge:
	TLSN A 0 A_PlaySound("TrueLegSent/See", CHAN_AUTO, 1.0, False, ATTN_NONE)
	TLSN A 0 A_JumpIf(user_tlsdelay >= 40, "KamikazeGo")
    TLSN P 2 Bright A_FaceTarget
	TLSN A 0 A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SpawnItemEx("LegendaryCyberFlameSpawner3",0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SpawnItemEx("TrueLegSentientFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto KamikazeCharge+1
  KamikazeGo:
    TLSN A 0 A_CustomMissile("TrueLegSentKamikaze", 48, 0, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,35)
	TNT1 A 0 A_DropItem("LegendaryDust",random(6,12),256)
	TNT1 A 0 ACS_NamedExecuteAlways("SetDefaultSky",0,3)
	Stop
  NoKamikaze4U:
	TLSN JKLM 10 Bright 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,35)
	TNT1 A 0 A_DropItem("LegendaryDust",random(6,12),256)
	TLSN A 0 A_SpawnItemEx("LegendaryNuke")
	//TLSN A 0 A_Jump(254, 1)
    TNT1 A 0 ACS_NamedExecuteAlways("SetDefaultSky",0,3)
	Stop
  }
}

Actor TLSPlasmaCannonAssistant
{
  Health 7999
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.6
  Speed 12
  FloatSpeed 12
  Obituary "$CFTLSPlasmaCannonAssistantObit"
  Species "Masterminds"
  DamageType "Legendary"
  BloodColor "Blue"
  DamageFactor 20.0
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFGTracer", 0.05
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "BFGSplash", 0.25
  DamageFactor "BFGSpray", 0.25
  DamageFactor "PlayerDevBall", 0.025
  DamageFactor "PlayerDevBall2", 0.025
  DamageFactor "PlayerDevTracer", 0.025
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "CDTBFG", 0.0
  Monster
  +NOPAIN
  +THRUACTORS
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  -COUNTKILL
  +NOGRAVITY
  +FLOAT
  Tag "\c[l5]True\c- \c[z3]Legendary Sentient\c-"
  States
  {
  Spawn:
    TNT1 A 0
    TLSN N 1 A_PlayWeaponSound("boss/teleport")
    TLSN NNNNNNNNNNNNOOO 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_CustomMissile("TrueLegSentientCannonBall",50,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    TLSN NNNNNNNNNNNNOOO 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_CustomMissile("TrueLegSentientCannonBall",50,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    TLSN NNNNNNNNNNNNOOO 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_CustomMissile("TrueLegSentientCannonBall",50,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    TLSN NNNNNNNNNNNNOOO 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_CustomMissile("TrueLegSentientCannonBall",50,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    TLSN NNNNNNNNNNNNOOO 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_CustomMissile("TrueLegSentientCannonBall",50,0,0)
  Death:
    TLSN N 1 A_PlayWeaponSound("boss/teleport")
    TLSN NNNNNNNNNN 2 A_FadeOut
	Stop
  }
}

Actor TLSLegCannonAssistant : TLSPlasmaCannonAssistant
{
  var int user_tlsdelay;
  States
  {
  Spawn:
    TNT1 A 0
    TLSN P 1 A_PlayWeaponSound("boss/teleport")
	TLSN A 0 ThrustThing(Angle+64,15,0,0)
  Firing:
    TLSN A 0 A_JumpIf(user_tlsdelay >= 21,"Firing2")
    TLSN N 2 A_FaceTarget
	TLSN A 0 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN O 0 Bright A_CustomMissile("TruelegCannonBall2",50,0,frandom(-12,12))
	TLSN O 2 Bright A_CustomMissile("TruelegCannonBall2",50,0,frandom(-12,12))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Loop
  Firing2:
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
    TLSN A 0 A_JumpIf(user_tlsdelay >= 16,"Firing2")
    TLSN N 2 A_FaceTarget
	TLSN A 0 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN O 2 Bright A_CustomMissile("TruelegCannonBall",50,0,frandom(-5,5))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
  Death:
    TLSN N 1 A_PlayWeaponSound("boss/teleport")
    TLSN PPPPPPPPPP 2 A_FadeOut
	Stop
  }
}

Actor TLSBlueStarAssistant : TLSPlasmaCannonAssistant
{
  States
  {
  Spawn:
    TNT1 A 0
    TLSN P 1 A_PlayWeaponSound("boss/teleport")
    TLSN NNNNNNNNNN 2 A_GiveInventory("TrueLegSentientStrafe",1)
	TLSN A 0 A_FaceTarget
	TLSN A 0 A_PlayWeaponSound("star/fire")
	TLSN O 7 Bright A_CustomMissile("LegSentBlueStar",50,0,frandom(-12,12))
  Death:
    TLSN N 1 A_PlayWeaponSound("boss/teleport")
    TLSN PPPPPPPPPP 2 A_FadeOut
	Stop
  }
}

Actor TLSLegCannonAssistant2 : TLSLegCannonAssistant
{
  States
  {
  Spawn:
    TNT1 A 0
    TLSN P 1 A_PlayWeaponSound("boss/teleport")
	TLSN A 0 ThrustThing(Angle-64,15,0,0)
	Goto Firing
  }
}

Actor TrueLegSentientFire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  +NOTIMEFREEZE
  RenderStyle Add
  Scale 0.65
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	YMKE ABCDEFGHIJKL 1 Bright A_FadeOut
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor TrueLegSentientFireSpawner : SentientFireSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("TrueLegSentientFire",frandom(55,76),frandom(50,70),85,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("TrueLegSentientFire",frandom(-76,55),frandom(-70,-50),85,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("TrueLegSentientFire",frandom(55,76),frandom(-70,-50),85,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
