Actor TLSTrapSpawner : LBSTrapSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_SetAngle(random(0,360))
	TNT1 A 1 A_Recoil(-40)
	TNT1 A 0 A_JumpIf(user_limit > 3,"Death")
	TNT1 A 0 A_SetUserVar("user_limit",user_limit+1)
	TNT1 A 1 A_Recoil(-4)
	TNT1 A 2 A_Jump(48,"Death")
    Goto Spawn+3
   Death:
    TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 5 A_SpawnItemEx("TLSTrap")
	TNT1 A 1 A_Fall
	Stop	
  }
}

Actor TLSTrap : LBSTrap
{
