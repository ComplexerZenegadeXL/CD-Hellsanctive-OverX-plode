    MRAI A 1 A_Wander
	MRAI A 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI B 1 A_Wander
	MRAI B 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI C 1 A_Wander
	MRAI C 0 A_SpawnItemEx("CommotionTrail2",0,0,0,0,0,3,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MRAI D 1 A_Wander
