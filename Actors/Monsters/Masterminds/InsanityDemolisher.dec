Actor InsanityDemolisher : DarkDemolisher
{
  Health 5500
  DamageFactor "Normal", 0.65
  BloodColor "Red"
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "SkullOfPowerGiver" 64
  DropItem "DemonicChaliceGiver" 64
  DropItem "BFG10KGiver" 100
  DropItem "RailgunGiver" 100
  DropItem "DemonTechBFG10KGiver" 64
  PainSound "monsters/darkmasterpain"
  SeeSound "monsters/darkmastermindsee"
  DeathSound "monsters/darkmasterminddie"
  Obituary "$CFInsanityDemolisherObit"
  Tag "$CFInsDemo"
  States
  {
  Spawn:
	INDM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	INDM A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	INDM AB 2 A_Chase
	TNT1 A 0 A_Metal
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	INDM A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM B 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM B 2 A_Chase
	TNT1 A 0 A_Metal	
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM D 2 A_Chase
	TNT1 A 0 A_Metal	
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM E 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostE",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM E 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM F 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneDemoGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INDM F 2 A_Chase	
	TNT1 A 0 A_Jump(84,"See")	
	Loop
  Missile:
	TNT1 A 0 A_Jump(100,"BFG15k","MiniDTBFG","Railgun")
	TNT1 A 0 A_Jump(50,"BFG10k","DTBFG")
	TNT1 A 0 A_Jump(128,"ExplosiveMinigun")
  DemonTech:
	INDM AA 10 A_FaceTarget
	TNT1 A 0 A_CustomMissile("InsanitySpiderDemontech",20,-16,frandom(-10,10),CMF_OFFSETPITCH,frandom(-1,1))
	TNT1 A 0 A_CustomMissile("InsanitySpiderDemontech",20,16,frandom(-10,10),CMF_OFFSETPITCH,frandom(-1,1))
	INDM G 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("InsanitySpiderDemontech",20,-16,frandom(-10,10),CMF_OFFSETPITCH,frandom(-1,1))
	TNT1 A 0 A_CustomMissile("InsanitySpiderDemontech",20,16,frandom(-10,10),CMF_OFFSETPITCH,frandom(-1,1))
	INDM H 2 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_SpidRefire
	Goto DemonTech+1
  ExplosiveMinigun:
	INDM AA 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",10,-12,20,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",10,12,20,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SentientExplosiveTracer",20,-16,frandom(-8,8))
	TNT1 A 0 A_CustomMissile("SentientExplosiveTracer",20,16,frandom(-8,8))
	INDM G 2 Bright A_PlaySound("sentient/fire")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",10,-12,20,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing",10,12,20,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SentientExplosiveTracer",20,-16,frandom(-8,8))
	TNT1 A 0 A_CustomMissile("SentientExplosiveTracer",20,16,frandom(-8,8))
	INDM H 2 Bright A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpidRefire
	Goto ExplosiveMinigun+1
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	INDM GGGGG 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("InsanitySpider15k",16,-16,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("InsanitySpider15k",16,16,frandom(-7,7))
	INDM HG 4 Bright A_FaceTarget
	TNT1 A 0 A_SpidRefire
	Goto BFG15k+6
  BFG10k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	INDM GGGGGGG 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Sentient10K",20,-16,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("Sentient10K",20,16,frandom(-7,7))
	INDM HG 4 Bright A_FaceTarget
	TNT1 A 0 A_SpidRefire
	Goto BFG10k+8
  MiniDTBFG:
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGCharge")
	INDM TTTTTTT 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MiniDTBFGLoop:
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	INDM U 8 Bright A_CustomMissile("InsaneSpiderMiniDTBFG",30,0,frandom(-8,8))
	INDM T 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0
	Goto See
  Railgun:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
	INDM TTTTTT 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunLoop:
	INDM U 10 Bright A_CustomMissile("CardinalRail",35)
	INDM T 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0
	Goto See
  DTBFG:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTBFGLoop:
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	INDM TTTTT 5 Bright A_FaceTarget
	INDM U 20 Bright A_CustomMissile("SentientDTBFG10KBall",30,0,frandom(-8,8))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0
	Goto See
  Pain:
	INDM I 6 A_Pain
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See
  Death:
	TNT1 A 0 A_Scream
	INDM I 20 A_Fall
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	INDM JJJJJ 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	INDM KKKKK 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	INDM LLLLL 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	INDM MMMMM 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	INDM NNNNN 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	INDM OOOOO 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	INDM PPPPP 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	INDM QR 5
	INDM S -1
	Stop
  }
}

Actor InsaneSpiderMiniDTBFG : LesserCardinalMiniDTBFG
{
  Species "Masterminds"
  DamageType "DarkDemoEx"
  Obituary "$CFInsaneSpiderMiniDTBFGObit"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("LesserCardinal/BFGIdle","Voice",1)
    CRS1 ABCDABCD 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("ClockworkBFGProjectileAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    Loop  
  }
}

Actor InsaneSpiderBFGProjectileAttack : LesserCardinalBFGProjectileAttack
{
  Obituary "%o was overwhelmed by an Insanity Demolisher's artillery."
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 AAAAAAA 1 A_Look
	Loop
  See:
    TNT1 A 0
	TNT1 A 1 A_JumpIfCloser(700,"Attack")
	Stop
  Attack:
    TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomMissile("InsaneSpiderLightningProjectile",-2,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto Death	
  Death:
	TNT1 A 20
	Stop
  }
}

Actor InsaneSpiderLightningProjectile : LesserCardinalLightningProjectile { Species "Masterminds" DamageType "DarkDemoEx" }

Actor InsaneDemoGhostA
{
  Scale 1.05
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    INDM A 2 A_FadeOut(0.18)
    Loop
  }
}

