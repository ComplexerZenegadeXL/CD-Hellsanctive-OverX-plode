	TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 4 A_Explode(100,100,0)
	TNT1 A 20
	Stop
  }
}

Actor BFGMastermind15K : Spider15K { Species "Masterminds" DamageType "DemolisherEx" }

