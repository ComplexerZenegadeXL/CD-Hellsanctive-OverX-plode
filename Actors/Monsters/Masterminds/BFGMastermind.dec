{
  Scale 1.1
  RENDERSTYLE Translucent
  Alpha 0.75
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	BFGD A 2 A_FadeOut(0.18,1)
	Loop
  }
}

