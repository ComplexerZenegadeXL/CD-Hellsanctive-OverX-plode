Actor SpiderRail : FastProjectile
{
  Radius 6
  Height 6
  Speed 300
  Decal "BFG9500Lightning"
  Scale 1.26
  MissileType "SpiderDarkRailTrail"
  Damage (Random(60,80))
  +RIPPER
  +THRUSPECIES
  +EXTREMEDEATH
  +BLOODLESSIMPACT
  Species "Masterminds"
  DamageType "DemolisherEx"
  SeeSound "monsters/darkcyberrail"
  DeathSound "cyberrail/impact"
  States
  {
  Spawn:
	DCRP A 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1 A_SpawnItemEx("RailgunImpactEffectGreen")
	Stop
  }
}

Actor SpiderDarkRailTrail : BFG9500Trail
{
  Scale 1
  States
  {
  Spawn:
	TNT1 A 0
	RGPG ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04,1)
	Stop
  }
}

Actor BMastermindPlasma
{
  PROJECTILE
  Radius 13
  Height 8
  Speed 52
  FastSpeed 66
  Damage (Random(25,50)) //8  
  Scale 0.75  
  Species "Masterminds"
  DamageType "DemolisherEx"
  RENDERSTYLE ADD
  SeeSound "weapons/hrfire"
  DeathSound "weapons/hrballexplode"
  States
  {
  Spawn:
	BMPL AB 1 Bright A_SpawnItemEx("BMasterPlasmaTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BMPL HIJ 3 Bright
	Stop
  }
}

Actor BMasterPlasmaTrail : BFG9500Trail
{
  Scale 0.7
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	BMPL AB 1 A_FadeOut(0.35,1)
	Goto Spawn+4
  }
}

Actor BFGSpiderDTBFGBall : DTBFG10KBall
{
  Projectile
  Alpha 0.85
  +FORCERADIUSDMG
  +THRUSPECIES
  Species "Masterminds"
  DamageType "DemolisherEx"
  Obituary "$CFBFGSpiderDTBFGBallObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	CGS1 ABCD 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("BFGSpiderDTBFGTracerAttack",frandom(-10,10),0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Loop
  DTBFGSFX:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	CGS1 A 1 Bright  A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	CGS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	CGS1 C 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreen2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	CGS1 D 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("BFGSpiderDTBFGTracerAttack",frandom(-10,10),0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto Spawn  
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:	
	TNT1 A 0 A_CustomMissile("BFGSpiderDTBFG10KTracer",0,0,user_loop * 10,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGreenSpawner",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)	
	CGS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwave3",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,240,0,0)
	TNT1 AAA 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave4",0,0,15,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 20 A_SpawnItemEx("PlayerDTBFGEx",0,0,-10,0,0,0,0,SXF_NOCHECKPOSITION,0)//|SXF_CLIENTSIDE)
	Stop
  }
}

Actor BFGSpiderDTBFG10KTracer : FastProjectile
{
  Height 4
  Radius 16
  Speed 60
  Decal None
  Damage (Random(100,250)) //50
  Species "Masterminds"
  DamageType "DemolisherEx"
  States
  {
  Spawn:
	TNT1 A 15
	Stop
  Death:
	TNT1 A 1
	Stop
  XDeath:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("CustomSpray")
	Stop
  }
}

Actor BFGSpiderDTBFGTracerAttack : SentientDTBFGTracerAttack
{
  Species "Masterminds"
  DamageType "DemolisherEx"
  -FRIENDLY
  Obituary "$CFBFGSpiderDTBFGTracerAttackObit"
  States
  {
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(4,10),0,NONE,"Green",RGF_SILENT|RGF_NOPIERCING,1,2,"PlayerRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}