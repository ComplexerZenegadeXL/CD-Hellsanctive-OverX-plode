Actor DemolisherMKII : Demolisher 21141
{
  Radius 65
  PainChance 30
  Mass 2500
  States
  {
  Death:
	TNT1 A 0 A_Scream
	DEMO I 20 Bright
	DEMO IIII 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	DEMO IIII 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_Fall
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 0 A_SpawnItemEx("DemolisherMKIIRevenge",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 AAAA 2 A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile ("CFMastermindLeg", 30, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (40, 90))
	TNT1 AAAA 2 A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 5
	TNT1 A -1
	Stop	
  }
}

Actor DemolisherMKIIRevenge : DemolisherMKII
{
  Obituary "$CFDemolisherMKIIRevengeObit"
  Health 4000 
  Radius 65
  Speed 12
  Scale 1.1
  FloatSpeed 12
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FLOAT
  +BOSS
  +BOSSDEATH
  +NOGRAVITY	
  -FLOORCLIP
  -COUNTKILL
  AttackSound ""
  DropItem "BossLifeEssence" 128 25
  PainSound "monsters/darkmasterpain"
  SeeSound "monsters/darkmastermindsee"
  DeathSound "monsters/darkmasterminddie"
  Species "Masterminds"
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 1.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.7
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  Tag "$CFDemoMKII"
  States 
  {
  Spawn:
	DMK2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",40)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	DMK2 AB 4 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DMK2 AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",40)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	DMK2 AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(26,"Evade")	
	Loop
  Evade:
	TNT1 A 0 A_SetUserVar("user_effect_type",41)
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	DMK2 ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	DMK2 ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K")
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto BFG9K
	DMK2 AAA 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("SentientFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire")
	TNT1 A 0 A_CustomMissile("MonsterTracer3",frandom(24,34),0,frandom(-10,10),0)
	DMK2 C 3 Bright A_SPosAttackUseAtkSound
    TNT1 A 0 A_SpawnItemEx("ShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire")
	TNT1 A 0 A_CustomMissile("MonsterTracer3",frandom(24,34),0,frandom(-10,10),0)
	DMK2 D 4 Bright A_SPosAttackUseAtkSound
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(3,"See","BFG9K","BFG10K")
	TNT1 A 0 A_SpidRefire
	Goto Normal+7
  BFG9K:
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	DMK2 KKKKKKLL 4 Bright A_FaceTarget
	DMK2 L 2 Bright A_CustomMissile("SpiderBFG9500Ball", 34, 0, 0)
	DMK2 KKK 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	DMK2 KKKKKKLL 4 Bright A_FaceTarget
	DMK2 L 2 Bright A_CustomMissile("SpiderBFG9500Ball", 34, 0, 0)
	DMK2 KKK 5 Bright A_FaceTarget
	TNT1 A 0 A_Jump(128,"BFG10K")
	Goto See	
  BFG10K:
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DMK2 KKKK 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	DMK2 L 3 Bright A_CustomMissile("DarkDemo10K", 42, 0, Random(4, -4))
	DMK2 K 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	DMK2 K 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	DMK2 KKK 5 Bright A_FaceTarget
	Goto See
  Pain:
	TNT1 A 0 A_Jump(128,"PainMissile")
	DMK2 A 3 Bright
	DMK2 A 3 Bright A_Pain	
	Goto See
  PainMissile:
	DMK2 A 3 Bright
	DMK2 A 3 Bright A_Pain
	Goto Missile
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(128,2)
	"####" "#" 0 A_SpawnItemEx("BFG10KGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"####" "#" 0 A_KillMaster
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
    TNT1 A 0 A_Jump(128,2)
    TNT1 A 0 A_SpawnItem("BFG10KGiver",0,12)
	TNT1 A 0 A_Scream
	DMK2 E 20 Bright A_Fall
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	DMK2 FFFFF 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    DMK2 GGGGG 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DMK2 HHHHH 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DMK2 IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	DMK2 IJ 5
    Stop
  } 
}


Actor CFMastermindLeg
{
  Radius 8
  Height 8
  Speed 24
  Scale 1.3
  Gravity 0.8
  Mass 1
  +NOBLOCKMAP
  +MISSILE
  +NOTELEPORT
  +MOVEWITHSECTOR
  +THRUACTORS
  +FLOORCLIP
  -NOGRAVITY
  +FORCERADIUSDMG
  +SKYEXPLODE
  Species "Masterminds"
  DamageType "DemolisherEx"
  SeeSound "misc/xdeath4"
  DeathSound "misc/xdeath1"
  Mass 1
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(waterlevel > 1, "Underwater")
    SPP4 ABCDEFGH 5
    Loop
  Death:
	TNT1 A 0 ThrustThingZ(0,50,0,1)
	TNT1 A 0 A_Explode(300, 100)
	EXPL AAAAAAA 0 A_CustomMissile ("SmokeFX3", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	Goto KeepRotating
  KeepRotating:	
    SPP4 AB 2
	SPP4 CDEFGH 2 A_CheckFloor("Rest")
	Loop
  Rest:	
	SPP4 A 1
	TNT1 A 0 A_Explode(150, 100)
	EXPL AAAAAAA 0 A_CustomMissile ("SmokeFX3", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	SPP4 A -1
    Stop
  Underwater:
  Splash:
	SPP4 A 4
    Loop
  }
}
