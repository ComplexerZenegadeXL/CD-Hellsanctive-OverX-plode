Actor SacrosanctPortal
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  Scale 0.4
  Renderstyle Add
  var int user_loop;
  States
  {
  Spawn:
	PRTG ABCDEFGHIJKLMNOP 1 A_SetScale(ScaleX+0.05)
  SpawnLoop:
	TNT1 A 0 A_JumpIf(user_loop >= 8,"Death")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	PRTG ABCDEFGHIJKLMNOP 1 A_SpawnItemEx("OverSeerFire2",frandom(-4,4),frandom(-4,4),frandom(0,4),frandom(-4,4),frandom(-4,4),frandom(3,10),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	PRTG ABCDEFGHIJKLMNOP 1 A_SetScale(ScaleX-0.05)
	Stop
	}
}

