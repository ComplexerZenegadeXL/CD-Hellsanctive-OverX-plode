Actor LegSentDying : LegendarySentient
{
  Mass 0x7FFFFFFF
  PainChance 0
  +NOINTERACTION
  States
  {
  Spawn:
    TNT1 A 0
  Death:
    LUPR H 20 Bright
    TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",Random(10,-10),Random(10,-10),Random(20,60),0,0,0,0,128,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", random(10,80), 0, random(0,360), 2, random(0,360))	
	LUPR IIIIIIIIII 2 Bright A_CustomMissile("PainfulDeathKaboom", random(10,60), random(30,-30), random(0,360), 2, random(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",Random(10,-10),Random(10,-10),Random(20,60),0,0,0,0,128,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", random(10,80), 0, random(0,360), 2, random(0,360))	
    LUPR JJJJJJJJJJ 2 Bright A_CustomMissile("PainfulDeathKaboom", random(10,60), random(30,-30), random(0,360), 2, random(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",Random(10,-10),Random(10,-10),Random(20,60),0,0,0,0,128,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", random(10,80), 0, random(0,360), 2, random(0,360))
    LUPR KKKKKKKKKK 2 Bright A_CustomMissile("PainfulDeathKaboom", random(10,60), random(30,-30), random(0,360), 2, random(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",Random(10,-10),Random(10,-10),Random(20,60),0,0,0,0,128,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", random(10,80), 0, random(0,360), 2, random(0,360))
    LUPR LLLLLLLLLL 2 Bright A_CustomMissile("PainfulDeathKaboom", random(10,60), random(30,-30), random(0,360), 2, random(0,360))
    TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueGibbedGenerator",Random(10,-10),Random(10,-10),Random(20,60),0,0,0,0,128,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("BigBlueBloodCloud", random(10,80), 0, random(0,360), 2, random(0,360))
	TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile("SmokeFX3", random(10,60), random(30,-30), random(0,360), 2, random(0,360))	
    TNT1 A 0 A_SpawnItem("TrueDeathBall")
	TNT1 A 0 A_SpawnItemEx("TrueLegPentagram",0,0,0,0,0,0,0,128)
	LUPR LM 5 Bright
	TNT1 AAAA 50
	TNT1 A 0 A_SpawnItemEx("LegendaryDreadnoughtIllusion", 0, 0, 96)
	TNT1 A 0 A_FadeOut
	Stop
  }
}

Actor LegendaryDreadnoughtIllusion
{
  //Health 666666
  Obituary "$CFLegendaryDreadnoughtIllusionObit"
  RenderStyle Add
  Scale 6
  Radius 1
  Height 1
  Alpha 0
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +DONTSPLASH
  +NORADIUSDMG
  +NOINTERACTION
  +NOCLIP
  +NOTIMEFREEZE
  -COUNTKILL
  var int User_Delay;
  States
  {
  Spawn:
    TNT1 A 0
	DRED A 0 A_PlaySoundEx("brain/spit","Voice",0,2)
	DRED AAAAAAAAAAAAAAAAAAAA 2 A_FadeIn(0.05)
  Spawning1:
	DRED A 0 A_JumpIf(User_Delay == 45, "Spawning2")
	DRED A 0 A_SpawnItemEx("LegendaryDreadnoughtFlames",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DRED A 1 Bright
	DRED A 0 A_SetUserVar(User_Delay, User_Delay+1)
	Loop
  Spawning2:
    DRED A 0 A_PlaySound("Boss/Teleport")
    DRED A 0 A_SetUserVar(User_Delay, 0)
	DRED A 0 A_JumpIf(User_Delay == 50, "Spawning3")
	DRED A 0 A_SpawnItemEx("LegendaryDreadnoughtFlames2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DRED B 1 Bright
	DRED A 0 A_SetUserVar(User_Delay, User_Delay+1)
	Goto Spawning2+2
  Spawning3:
    DRED A 0 A_PlaySound("Boss/Teleport")
    DRED A 0 A_SetUserVar(User_Delay, 0)
	DRED A 0 A_JumpIf(User_Delay == 60, "Spawning4")
	DRED A 0 A_SpawnItemEx("LegendaryDreadnoughtFlames3",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DRED C 1 Bright
	DRED A 0 A_SetUserVar(User_Delay, User_Delay+1)
	Goto Spawning3+2
  Spawning4:
    DRED A 0 A_SetUserVar(User_Delay, 0)
	DRED A 0 A_PlaySound("Dreadnought/Pain")
	DRED A 0 Radius_Quake(10,150,0,24,0)
	DRED A 0 A_SpawnItemEx("DreadnoughtRage")
	DRED A 0 A_JumpIf(User_Delay == 75, "RessingLegSent")
	DRED A 0 A_SpawnItemEx("LegendaryDreadnoughtFlames4",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DRED D 1 Bright
	DRED A 0 A_SetUserVar(User_Delay, User_Delay+1)
	Goto Spawning4+4
  RessingLegSent:
    DRED A 0 A_SetUserVar(User_Delay, 0)
	DRED E 2 Bright A_SpawnItemEx("DreadnoughtShockWaveGenerator", 0, 0, 0)
	DRED A 0 A_JumpIf(User_Delay == 120, "RessingDone")
	DRED A 0 A_SpawnItemEx("LegendaryDreadnoughtFlames5",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DRED E 0 A_SpawnItemEx("KaboomBlueSent",0,0,0,frandom(-14,14),frandom(-15,15),frandom(-15,15),0)
	DRED E 2 Bright A_SpawnItemEx("KaboomBlueSent2",0,0,0,frandom(-9,9),frandom(-10,10),frandom(-10,10),0)
	DRED A 0 A_SetUserVar(User_Delay, User_Delay+1)
	Goto RessingLegSent+2
  RessingDone:
	TNT1 A 0 A_SpawnItem("LegendaryNuke2")
    DRED E 20 Bright //A_SpawnItemEx("TrueLegendarySentient", 0, 0, 32, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
	DRED FGHI 15 Bright A_FadeOut(0.1)
	Stop
  }
}

Actor DreadnoughtRage
{
  +NOTIMEFREEZE
  +DONTSPLASH
  +NORADIUSDMG
  +NOINTERACTION
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 35
    TNT1 AAAAAAAAAAAAAAA 2 A_SpawnItemEx("TLSRainCometSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("TrueLegSent/Mind", 9, 1.0, 0, ATTN_NONE)
	TNT1 A 210 A_SpawnItemEx("LegThunderSpawner",0,0,0,0)
	TNT1 AAAAAAAAAAAAAAA 2 A_SpawnItemEx("TLSRainCometSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("TrueLegSent/Mind", 9, 1.0, 0, ATTN_NONE)
	Stop
  }
}
  

Actor LegendaryDreadnoughtFlames : LHellionSmokeSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("AHellionSmoke",random(64,-64),random(64,-64),random(-96,96),0,0,random(1,3),0,128,0)
    TNT1 A 1
    Stop
  }
}

