Actor DevastatorTrail
{
  +NOBLOCKMAP
  +NOGRAVITY
  +CLIENTSIDEONLY
  Scale 1.45
  RenderStyle Add
  Radius 1
  Height 2
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    RDCR A 4 Bright A_FadeOut(0.1)
    Loop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor LegDevastatorTrail : DevastatorTrail
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LDCR A 4 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor DevastatorBolt
{
  Speed 35
  Radius 6
  Height 6
  Damage (Random(50,150)) //22
  Alpha 0.8
  Projectile
  +SEEKERMISSILE
  +MTHRUSPECIES
  +DONTREFLECT
  +BRIGHT
  ReactionTime 170
  RenderStyle Add
  Species "Masterminds"
  DamageType "DemolisherEx"
  DeathSound "bolt/explode"
  States
  {
  Spawn:
  	DVS1 A 0 A_Seekermissile(5,5,SMF_LOOK)
    DVS1 A 1 A_SpawnItemEx("BoltTrail",0,0,0,0,0,0,0)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("KaboomDevastator15",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    DVS1 LMN 2
    Stop
  }
}

Actor CyberDevastatorBolt : DevastatorBolt { Species "Cybers" DamageType "Cyber10K" }

Actor LegCybDevastatorBolt : DevastatorBolt
{
  Damage (Random(50,100))  //25
  Species "Cybers"
  DamageType "Legendary" 
  +NOTIMEFREEZE
  States
  {
  Spawn:
  	LVS1 A 0 A_Seekermissile(5,5,SMF_LOOK)
    LVS1 A 1 A_SpawnItemEx("LegBoltTrail",0,0,0,0,0,0,0)
    Loop
  Death:
    TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("LegendaryGoldParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AAAA 0 A_CustomMissile("LegKaboomDevastator15",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
  Vanilla:
    LVS1 LMN 2
    Stop
  }
}

