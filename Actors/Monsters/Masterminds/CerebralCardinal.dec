Actor SentientFusionNuke
{
  Radius 13
  Height 8
  Speed 20
  Damage (Random(400,800))  //200
  Species "Masterminds"
  DamageType "DemolisherEx"
  Projectile
  +NOTARGET
  +FULLVOLDEATH
  +THRUGHOST
  +FORCERADIUSDMG
  +THRUSPECIES
  -ROCKETTRAIL
  DeathSound "weapons/nuclearmissileexplode"
  Obituary "$CFSentientFusionNukeObit"
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2)) 
    NKS1 A 2 Bright A_CustomMissile("NuclearMissileTrail",0,0,0)
    Loop
  Death:
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_SpawnItemEx("DarkDesNuke2",0,0,0,0,0,0,0)
	TNT1 A 0 A_Explode(Random(5000,6000),512,0,1)
    Stop
  }
}

