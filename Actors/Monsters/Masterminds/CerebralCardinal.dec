Actor CerebralCardinal : Demolisher 16568
{
//$Category Monsters/LCA
//$Sprite ARCYA1
//$Title "Cerebral Cardinal"
  Speed 10
  Height 100
  Radius 80
  Mass 90000
  Health 6500
  Painchance 20
  PainChance "PDTBFG", 7
  PainChance "SoulToxic", 2
  PainChance "FatFlamer", 2
  PainChance "FiendFire", 2
  PainChance "Explosion", 30
  SeeSound "CerebralCardinal/sight"
  DeathSound "CerebralCardinal/Death"
  PainSound "CerebralCardinal/pain"
  MinMissileChance 1
  Scale 1.0
  Monster
  +FLOAT
  +NOGRAVITY
  +FLOORCLIP
  +NORADIUSDMG
  +QUICKTORETALIATE
  +MISSILEMORE
  +MISSILEEVENMORE
  +BOSS
  +DONTHURTSPECIES
  +BOSSDEATH
  DamageFactor 0.55
  DamageFactor "DemolisherEx", 0.5
  DamageFactor "DarkDemoEx", 0.5
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "PDTBFG", 0.1
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PlayerDevBall", 0.05
  DamageFactor "PlayerDevBall2", 0.05
  DamageFactor "PlayerDevTracer", 0.05
  DropItem "BossLifeEssence" 225 
  DropItem "BossArmorBonusMax" 225 
  DropItem "DemonAmmoBoxPickup" 256
  DropItem "DemonAmmoPickup" 256
  DropItem "DemonicChaliceGiver" 64 1
  DropItem "SkullOfPowerGiver" 64 1
  DropItem "DemonTechDevastatorGiver" 256 1
  DropItem "DemonTechBFG10KGiver" 128 1
  DropItem "ExplosiveMinigunGiver" 64 1
  DropItem "BulletBoxPickup" 64
  Species "Masterminds"
  Obituary "$CFCerebralCardinalObit"
  Tag "$CFCerCard"
  var int user_fusionnuke;
  var int user_script;
  var int user_script_type;
  var int user_lowlag;
  States
  {
  Spawn:
    ARCY A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,36)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    ARCY A 2 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ARCY A 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY A 2 Bright A_Chase
    TNT1 A 0 A_Jump(32,"Evade")	
    Loop
  Evade:
	TNT1 A 0 A_SetUserVar("user_script_type",36)
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	ARCY AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	ARCY AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
    ARCY A 0 A_Jump(128,"Normal","CyberRockets","CyberHomingRockets","BFG95K","BFG10K","Railgun")
    ARCY A 0 A_Jump(64,"SentientCardinalDTCombo")
    ARCY A 0 A_Jump(32,"DTDevastator")
    ARCY A 0 A_Jump(16,"FusionNuke")
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
    Goto CyberRockets
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY A 6 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	ARCY B 3 Bright A_CustomMissile("SentientExplosiveTracer",36,0,frandom(-8,8),0)
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	ARCY C 4 Bright A_CustomMissile("SentientExplosiveTracer",36,0,frandom(-8,80),0)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(3,"See","BFG95K","BFG10K","Railgun","SentientCardinalDTCombo","DTDevastator")
	TNT1 A 0 A_Jump(15,"CyberRockets","CyberHomingRockets")
	TNT1 A 0 A_SpidRefire
	Goto Normal+7
  CyberRockets:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY A 6 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6)) //Mastermind
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientRocket", 55, -24, frandom(-6, 6))
	ARCY G 2 Bright A_FaceTarget
	TNT1 A 0 A_Jump(128,"CyberHomingRockets","BFG95K","BFG10K","Railgun")
	TNT1 A 0 A_Jump(64,"SentientCardinalDTCombo")
	TNT1 A 0 A_Jump(32,"DTDevastator")
	Goto See
  CyberHomingRockets:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY A 6 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6)) //Mastermind
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6))
	ARCY G 2 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6))
	ARCY GF 4 Bright A_FaceTarget
	ARCY G 6 Bright A_CustomMissile("SentientHomingRocket", 55, -24, frandom(-6, 6))
	ARCY G 2 Bright A_FaceTarget
	TNT1 A 0 A_Jump(128,"BFG95K","BFG10K","Railgun")
	TNT1 A 0 A_Jump(52,"SentientCardinalDTCombo")
	TNT1 A 0 A_Jump(26,"DTDevastator")
    Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    ARCY FFFFFFFF 4 Bright A_FaceTarget
    ARCY G 2 Bright A_CustomMissile("SentientRail",55,-24)  //Mastermind
    ARCY GG 4 Bright A_FaceTarget
    ARCY F 14 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","BFG95K")
	Goto See	  
  BFG95K:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY DDDDDD 4 Bright A_FaceTarget
	ARCY EE 4 Bright A_FaceTarget
	ARCY E 2 Bright A_CustomMissile("SentientBFG9500Ball", 34, 0, 0) //MasterMind
	ARCY D 6 Bright
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	ARCY DDDDDDDD 4 Bright A_FaceTarget
	ARCY D 2 Bright A_CustomMissile("SentientBFG9500Ball", 34, 0, 0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ARCY E 12 Bright
    TNT1 A 0 A_Jump(120,"BFG10K")
	TNT1 A 0 A_Jump(50,"SentientCardinalDTCombo")
	TNT1 A 0 A_Jump(25,"DTDevastator")
    Goto See
  SentientCardinalDTCombo:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY DDDDDD 4 Bright A_FaceTarget
	ARCY EE 4 Bright A_FaceTarget
	ARCY E 2 Bright A_CustomMissile("SentientDTBFG10KBall", 34, 0, 0) //MasterMind
	ARCY D 24 Bright
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	ARCY FFFFF 4 Bright A_FaceTarget
	ARCY GG 4 Bright A_FaceTarget
	ARCY G 2 Bright A_CustomMissile("SentientDTBFG10KBall", 55, -24, 0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ARCY F 24 Bright
	TNT1 A 0 A_Jump(100,"DTDevastator")
	Goto See
  DTDevastator:
    TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("devastator/charge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY FFFFFFFFFFFFFFFF 7 Bright A_FaceTarget
	ARCY G 0 A_PlaySound ("devastator/fire")
	ARCY G 2 Bright A_CustomMissile("MasterFusionDevastatorBall", 55, -24, 0) //MasterMind
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ARCY FFFFFF 4 Bright A_SpawnItemEx("SentientFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump (1,"FusionNuke")
	Goto See
  FusionNuke:
    TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_JumpIf(user_fusionnuke == 1, "Missile")
    TNT1 A 0 A_SetUserVar("user_fusionnuke", 1)
	TNT1 A 0 A_PlaySound("weapons/nuclearmissilecharge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY FFFFFFFF 7 Bright A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("Cardihilator/NukeFire", 1, 0, 2)
	ARCY G 6 Bright A_CustomMissile("SentientFusionNuke", 55, -24, 0) //Cyber
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	//TNT1 A 1 A_TakeInventory("FusionNuke",1)
	ARCY F 166 Bright
	Goto See
  BFG10K:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY FFFFF 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	ARCY FFFFFFFF 4 Bright A_FaceTarget
	ARCY E 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,frandom(-4, 4)) //MasterMind
	ARCY DE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,frandom(-4, 4))
	ARCY DE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,frandom(-4, 4))
	ARCY DE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,frandom(-4, 4))
	ARCY DE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,frandom(-4, 4))
	ARCY DE 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY H 0 Bright A_CustomMissile("Sentient10K",34,0,Random(-4, 4))
	ARCY D 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ARCY D 15 Bright
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	ARCY FFFF 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	ARCY FFFFFFFFG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY FG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY FG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY FG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY FG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY FG 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	ARCY G 0 Bright A_CustomMissile("Sentient10K",55,-24,frandom(-4, 4))
	ARCY F 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	ARCY F 15 Bright
	TNT1 A 0 A_Jump(52,"SentientCardinalDTCombo")
	TNT1 A 0 A_Jump(26,"DTDevastator")
    Goto See  
 Pain:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	ARCY A 2 Bright A_Jump(35,"PainResurrect","Meteors")
	ARCY A 2 Bright A_Pain
	Goto See
  PainResurrect:
	ARCY A 3 Bright
	ARCY A 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("SentientToken",3,"See")	
	ARCY A 12 Bright
	TNT1 A 0 A_GiveInventory("SentientToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
    ARCY F 3 Bright A_PlaySound("CerebralCardinal/Laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_CustomMissile("SentientMassResurrectionEffect",10,0,user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop")
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_CustomMissile("SentientMassResurrectionEffect",10,0,(user_loop * 30) - 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop3:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop3")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop4:
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 10,1)
    Goto PainResurrectLoop4
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop5:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop5")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop6:
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0)
	ARCY F 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,1)
	Goto PainResurrectLoop6
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ARCY A 3 Bright
	Goto See
  Meteors:
	TNT1 A 0 A_JumpIfCloser(1000,1)
	Goto Pain+1
   	TNT1 A 0 A_SpawnItemEx("CardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    DACY A 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("CardinalToken",3,"See")	
    DACY A 12 Bright
	TNT1 A 0 A_GiveInventory("CardinalToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
    TNT1 A 0 A_PlaySound("CerebralCardinal/Laugh")	 
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MeteorsLoop:
	TNT1 A 0 A_SpawnItemEx("CardinalRageFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DACY A 2 Bright A_SpawnItemEx("RainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 40,2)
	TNT1 A 0 A_Jump(256,"MeteorsLoop")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
    DACY AA 3 Bright A_SpawnItemEx("CardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  Death:
	TNT1 A 0 A_Scream
	DACY A 20 Bright A_Fall
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	DACY BBBBBBBBBB 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    DACY CCCCCCCCCC 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DACY DDDDDDDDDD 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),Random(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DACY DDDDDDDDDD 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAAAAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	DACY DE 5
	Stop
  }
}

Actor SummonedCerebralCardinal : CerebralCardinal { -COUNTKILL }

Actor ZombieDTBFGTracerAttack : SentientDTBFGTracerAttack
{
  Obituary "$CFZombieDTBFGTracerAttackObit"
  States
  {
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(random(1,4),0,NONE,"Red",RGF_SILENT|RGF_NOPIERCING,1,2,"ZombieRailTargetPuff",0,0,1250,0,0,0,"None")
	Goto Death
  }
}

Actor ZombieDevastatorBall : DevastatorBall
{
  DamageType "ZombieDev"
  Damage (Random(1000,2000))
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("ZombieDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("ZombieLiteShot",0,0,frandom(0,360))
    CRS9 A 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("DevastatorTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TNT1 A 0 A_CustomMissile("ZombieDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("ZombieLiteShot",0,0,frandom(0,360))
    CRS9 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,256,0)
	TNT1 A 0 A_CustomMissile("ZombieDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("ZombieLiteShot",0,0,frandom(0,360))
    CRS9 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("DevastatorTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TNT1 A 0 A_CustomMissile("ZombieDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	CRS9 A 0 A_CustomMissile("ZombieLiteShot",0,0,frandom(0,360))
    CRS9 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleRed",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRed2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	CRS9 A 1 Bright A_CustomMissile("ZombieDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,256,0)
    Goto Spawn
  Death:
    TNT1 A 0
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("DTBFG10KTracerZombie",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningRedSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	TNT1 A 0 A_Explode(50,256)
	CRS9 A 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(50,256)
	CRS9 B 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(50,256)
	CRS9 C 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(50,256)
	CRS9 D 6 Bright A_SpawnItemEx("DevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto DeathLoop2
	TNT1 A 0 A_Explode(128,1024,0)
	TNT1 A 0 A_Explode(256,640,0)
	TNT1 A 0 A_Explode(512,256,0)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RedDTBFGEx",0,0,-10,0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	CRE9 D 0 A_CustomMissile("ZombieDevastatorBall2",0,0,user_loop * 18,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	CRE9 AAABBBCCCDDD 2 A_CustomMissile("KaboomDevastator22",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    CRE9 EF 6 Bright
    Stop    
  }
}

