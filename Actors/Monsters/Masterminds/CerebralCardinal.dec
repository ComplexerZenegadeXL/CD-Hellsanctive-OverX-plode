Actor ProjectileTrailParticleRed
{
  Height 0
  Radius 0
  Mass 0
  +THRUACTORS
  +NOTELEPORT
  +DONTSPLASH
  +HEXENBOUNCE
  +CLIENTSIDEONLY
  +MISSILE
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  RenderStyle Add
  Gravity 0.2
  BounceFactor 0.6
  +NOGRAVITY
  Scale 0.045
  States
  {
