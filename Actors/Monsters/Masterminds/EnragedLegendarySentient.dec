Actor EnragedLegendarySentient : LegendarySentient
{
  Health 9000
  Scale 1.2
  Mass 0x7FFFFFFD
  PainChance 2
  Speed 18
  Height 100
  FloatSpeed 40
  Species "Masterminds"
  Obituary "$CFEnragedLegendarySentientObit"
  BloodColor "Red"
  Tag "$CFEnrSent"
  +MISSILEMORE
  +LOOKALLAROUND
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +FULLVOLACTIVE
  DropItem "ILDemonAmmoBoxPickup" 256
  DropItem "ILDemonAmmoPickup" 256
  DropItem "ILDemonAmmoBoxPickup" 256
  DropItem "ILDemonAmmoPickup" 256
  DropItem "ILDemonAmmoBoxPickup" 256
  DropItem "ILDemonAmmoPickup" 256
  //DropItem "LegendaryBFGGiver" 256
  DropItem "SkullofPowerGiver" 128
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryAmmoSphere" 256
  DropItem "LegendaryDemonRune" 256
  //DropItem "EnragedLegendaryASGGiver" 256
  DropItem "EnragedLegendaryArmor" 256
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 256
  DropItem "LegendaryTimeFreezeSphere" 256
  //DropItem "EnragedLegendaryLightMachineGunGiver" 256
  DropItem "TrueLegendaryBFGUpgrade" 256
  DropItem "LegendaryRandomSphere" 16
  DamageFactor 0.6
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFG", 0.05
  DamageFactor "PDTBFGTracer", 0.05
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "BFGSplash", 0.25
  DamageFactor "PlayerBHole", 0.0
  DamageFactor "BFGSpray", 0.25
  DamageFactor "PlayerDevBall", 0.015
  DamageFactor "Railg", 0.5
  DamageFactor "Explosion", 0.6
  DamageFactor "PlayerDevBall2", 0.015
  DamageFactor "PlayerDevTracer", 0.015
  DamageFactor "PlayerDTRG", 0.05
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "Term", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Crush", 0.1
  DamageFactor "Player", 0.015
  DamageFactor "PlayerHellfire", 0.3
  DamageFactor "CDTBFG", 0.0
  DamageFactor "DBFG10K", 0.015
  DamageFactor "NobleComet", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "PlayerDBFG10K", 0.0
  DamageFactor "DBFG", 0.0
  DamageFactor "C0mm4nder", 0.0
  DamageFactor "PlayerBHole", 0.1
  DamageFactor "PlayerDBFG2", 0.0
  DamageFactor "DBFG210K", 0.0
  DamageFactor "PlayerDBFG210K", 0.0  
  DamageFactor "PlayerDBFG", 0.0
  DamageFactor "DBFG2Splash", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "HFCyber", 0.0
  DamageFactor "DementedTerminator", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Commander", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "PlayerDBFG10K2", 0.0
  DamageFactor "DBFG2", 0.0
  DamageFactor "PlayerDBFG2", 0.0
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "None", 0.45
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.6
  PainChance "PlayerDBFG2", 64
  PainChance "DBFG2", 64
  PainChance "PlayerDBFG10K2", 64
  PainChance "PlayerDevBall", 50
  PainChance "BFG10K", 50
  PainChance "PDTBFG", 50
  PainChance "DTBFG10KBall", 50
  PainChance "PDTBFGTracer", 50
  PainChance "PlayerDBFG10K2", 64
  PainChance "DBFG210K", 64
  PainChance "DBFG2Splash", 64
  PainChance "DBFG2", 64
  PainChance "DBFG", 64
  PainChance "PlayerDBFG", 64
  PainChance "DBFG10K2", 64
  SeeSound "EnragedSentient/Sight"
  PainSound "EnragedSentient/Pain"
  DeathSound "EnragedSentient/Death"
  ActiveSound "EnragedSentient/Active"
  var int user_missile; 
  var int user_missileteleport;
  var int user_LegendaryBalance;
  var int user_resurrectloop;
  States
  {
  Spawn:
	ELSN A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,8)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",7)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
  Idle:
	TNT1 A 0 A_SpawnItem("EnragedBossSmokeSpawner")
	ELSN AB 4 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ELSN AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,418)
	TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,7,1)
	TNT1 A 0 A_SetUserVar("user_music",1)
	ELSN A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ELSN A 0 A_SetTranslucent(1.0) 
	TNT1 A 0 A_SpawnItem("EnragedBossSmokeSpawner")
	ELSN AB 2 A_Chase
	TNT1 A 0 A_Jump(60, "Dodge")
	TNT1 A 0 A_Jump(48, "Teleport")
	Goto MoreSee+5
  Dodge:
	TNT1 A 0 A_Jump(256, "DodgeLeft", "DodgeRight")
  DodgeLeft:
	ELSN A 5 ThrustThing(Angle*256/360+64, frandom(35, 45), 0, 0)
	Goto See
  DodgeRight:
	ELSN A 5 ThrustThing(Angle*256/360-64, frandom(35, 45), 0, 0)
	Goto See
  Teleport:
	ELSN A 0 A_UnSetShootable
	TNT1 A 0 A_PlaySound("EnragedSentient/Teleport",7,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SpawnItemEx("EnragedSentientTeleportFX",0,0,60)
	ELSN AA 1 A_FadeOut(0.5,0)
	ELSN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_PlaySound("EnragedSentient/Teleport",7,1.0,0,ATTN_NONE)
	TNT1 A 0 A_Recoil(0.1)
	TNT1 A 0 A_SpawnItemEx("EnragedSentientTeleportFX",0,0,60)
	ELSN AA 1 A_FadeIn(0.5)
	ELSN A 0 A_SetShootable
	Goto See
  MoreTeleports:
	ELSN A 0 A_JumpIf(user_missile >= Random(8,10), "Detox")
	ELSN A 0 A_UnSetShootable
	ELSN AA 1 A_FadeOut(0.5, 0)
	ELSN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	ELSN A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ELSN AA 1 A_FadeIn(0.5)
	ELSN A 0 A_SetShootable
	ELSN A 0 A_SetUserVar(user_missile, user_missile+1)
	Loop
  Missile:
	TNT1 A 0 ACS_NamedExecuteWithResult("ELSInvulCheck",AAPTR_TARGET)
	TNT1 A 0 A_Jump(20,"ResurrectWave","LegBFGCombo")
	ELSN A 0 A_Jump(164, "BFG10K","LegCannon","LegPlasmaCannon","BFGSpread","DTBFG","Commotion")
  Normal:
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack1",5,1.0,0,ATTN_NONE)
	ELSN ABAB 5  A_FaceTarget
	TNT1 A 0 A_Jump(116,"10KChainguns","LMGChainguns","PlasmaChainguns")
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	TNT1 A 0 A_CustomMissile("EnragedSentientRail",31,-20,frandom(-8,8),0)
	TNT1 A 0 A_CustomMissile("EnragedSentientRail",31,0,frandom(-8,8),0)
	ELSN D 2 A_CustomMissile("EnragedSentientRail",31,20,frandom(-8,8),0)
	ELSN C 3 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(16,"See","Missile")
	TNT1 A 0 A_SpidRefire
	Goto Normal+6
  10KChainguns:
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Enraged10KProjectile",31,-20,frandom(-8,8),0)
	TNT1 A 0 A_CustomMissile("Enraged10KProjectile",31,0,frandom(-8,8),0)
	ELSN D 2 A_CustomMissile("Enraged10KProjectile",31,20,frandom(-8,8),0)
	ELSN C 4 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(3,"See")
	TNT1 A 0 A_SpidRefire
	Loop
  PlasmaChainguns:
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_PlaySound("BlueDTRFire")
	TNT1 A 0 A_CustomMissile("RLegendaryProjectile",31,-20,frandom(-8,8),0)
	TNT1 A 0 A_CustomMissile("RLegendaryProjectile",31,0,frandom(-8,8),0)
	ELSN D 2 A_CustomMissile("RLegendaryProjectile",31,20,frandom(-8,8),0)
	ELSN C 4 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(3,"See")
	TNT1 A 0 A_SpidRefire
	Loop
  LMGChainguns:
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",31,0,frandom(-12,12),0)
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",31,-20,frandom(-12,12),0)
	TNT1 A 0 A_CustomMissile("LegendaryRedTracer",31,20,frandom(-12,12),0)
	TNT1 AAA 0 A_SpawnItemEx("ELegRifleCasing", frandom(-25,25),0,36,frandom(-6, 6),0,frandom(-3, -1))
	TNT1 A 0 A_CustomBulletAttack(42.5,14,3,Random(10,20)*5,"EnragedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySoundEx("weapons/LMGFire","Weapon")
	ELSN DCC 2  
	TNT1 A 0 A_Jump(3,"See")
	TNT1 A 0 A_SpidRefire
	Loop
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	ELSN EEEEE 4  A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_SetUserVar(user_missileteleport,0)
  BFG10KLoop:
	ELSN A 0 A_JumpIf(user_missile >= 50, "10KStop")
	TNT1 A 0 A_SetUserVar(user_missileteleport,0)
	ELSN A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_FaceTarget
	ELSN F 0 A_CustomMissile("Enraged10KProjectile", 20, -20, frandom(-3, 3))
	ELSN F 2 A_CustomMissile("Enraged10KProjectile", 20, 20, frandom(-3, 3))
	ELSN E 2 A_FaceTarget
	ELSN A 0 A_SetUserVar(user_missile,user_missile+1)
  10KTeleport:
	TNT1 A 0 A_JumpIf(user_missileteleport >= Random(5,9),"BFG10KLoop")
	TNT1 AAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	ELSN E 0 A_SpawnItemEx("EnragedSentientTeleportFXSpam",0,0,60)
	TNT1 A 0 A_SetUserVar(user_missileteleport,user_missileteleport+1)
	TNT1 A 0 A_Jump(256,"10KTeleport")
  10KStop:
	ELSN A 0 A_SetUserVar(user_missile, 0)
	ELSN A 0 A_Jump(144,"BFGSpread")
	ELSN A 0 A_Jump(96, "Dodge")
	Goto See
  DTBFG:
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack4",5)
	TNT1 A 0 A_PlaySound("EnragedSentient/DTBFGCharge",6)
  DTBFGCharge:
	TNT1 A 0 A_JumpIf(user_missile >= 5,"DTBFGFire")
	TNT1 A 0 A_SpawnItemEx("EnragedBossSmokeSpawner")
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  DTBFGFire:
	TNT1 A 0 A_JumpIf(user_missile >= 9,"DTBFGStop")
	TNT1 A 0 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN F 4 A_CustomMissile("EnragedSentientDTBFG10KBall",50)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  DTBFGStop:
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam",6)
	ELSN NNN 4 A_FaceTarget
	Goto Detox
  LegPlasmaCannon:
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack4",5,1.0,0,ATTN_NONE)
	ELSN NNNNNNNNNNNNNNNNNNEEE 2  A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Star/Fire",6,1.0,0,ATTN_NONE)
	ELSN A 0 A_CustomMissile("EnragedNukeShot", 50, 0, 0)
	ELSN FFFEEE 2 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Star/Fire",6,1.0,0,ATTN_NONE)
	ELSN A 0 A_CustomMissile("EnragedNukeShot", 50, 0, 0)
	ELSN FFFEEE 2 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Star/Fire",6,1.0,0,ATTN_NONE)
	ELSN A 0 A_CustomMissile("EnragedNukeShot", 50, 0, 0)
	ELSN FFFNNN 2 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_Jump(64, "BFGSpread", "LegBFGCombo")
	ELSN A 0 A_Jump(128, "Dodge")
	Goto See
  BFGSpread:
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack2",5,1.0,0,ATTN_NONE)
	ELSN NNNNNNN 6 A_FaceTarget
	ELSN A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	ELSN EEEEEEEEEEFFF 2  A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_FaceTarget
	ELSN AAAAAAA 0 A_CustomMissile("EnragedBFG9500",50,frandom(-2,2),frandom(-35,35),CMF_AIMDIRECTION,frandom(-35,0))
	ELSN A 0 A_Jump(128, "Dodge")
	Goto See
  LegCannon:
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack2",5,1.0,0,ATTN_NONE)
	ELSN NNNNNNNNNNNNNNNNNNN 2 A_GiveInventory("EnragedSentientStrafe", 1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegCannonLoop:
	TNT1 A 0 A_PlaySound("lrball3/shot")
	ELSN A 0 A_FaceTarget
	TNT1 AAAAA 0 A_CustomMissile("EnragedCYNCannonProj", 50, 0, frandom(-20,20))
	ELSN FFEEE 2 A_GiveInventory("EnragedSentientStrafe", 1)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	ELSN A 0 A_Jump(128, "Dodge")
	Goto See
  LegBFGCombo:
	TNT1 A 0 A_PlaySound("EnragedSentient/Attack5",5,1.0,0,ATTN_NONE)
	ELSN NN 5 A_FaceTarget
	ELSN A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ELSN A 0 A_PlaySound("EnragedDTech/Charge",0,1,0,ATTN_NONE)
	ELSN NN 5 A_FaceTarget
  LegBfgComboCharging:
	ELSN A 0 A_JumpIf(user_missile >= 17, "LegBfgComboGo")
	ELSN N 2 A_GiveInventory("EnragedSentientStrafe", 1)
	ELSN A 0 A_SetUserVar(user_missile, user_missile+1)
	Loop
  LegBfgComboGo:
	ELSN A 0 A_JumpIf(user_missile >= 22, "Detox")
	ELSN A 0 A_FaceTarget
	ELSN N 5 A_Recoil(-35)
	TNT1 A 0 A_PlaySound("EnragedDTech/Fire")
	ELSN O 5 A_CustomMissile("SentientGuruBall", 50, 0, 0, 0)
	ELSN A 0 A_UnSetShootable
	TNT1 A 0 A_PlaySound("EnragedSentient/Teleport",7,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SpawnItemEx("EnragedSentientTeleportFX",0,0,60)
	ELSN AA 1 A_FadeOut(0.5, 0)
	ELSN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_PlaySound("EnragedSentient/Teleport",7,1.0,0,ATTN_NONE)
	TNT1 A 0 A_Recoil(0.1)
	TNT1 A 0 A_SpawnItemEx("EnragedSentientTeleportFX",0,0,60)
	ELSN AA 1 A_FadeIn(0.5)
	ELSN A 0 A_SetShootable
	ELSN A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ELSN A 0 A_SetUserVar(user_missile, user_missile+1)
	Goto LegBfgComboGo
  EnragedD:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("EnragedSentient/DBFG",5,1,0,ATTN_NONE)
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2",6)
  EnragedDCharge:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"EnragedDLoop")
	ELSN NN 4 A_FaceTarget
	TNT1 A 0 A_SpawnItem("EnragedBossSmokeSpawner")
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  EnragedDLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 24,"EnragedDStop")
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2",6)
	ELSN G 4 A_CustomMissile("EnragedD10K",90,74,frandom(-5,5))
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  EnragedDStop:
	TNT1 A 0 A_SpawnItem("EnragedBossSmokeSpawner")
	ELSN EEE 5 A_FaceTarget
	Goto Detox
  Commotion:
	ELSN A 0 A_PlaySound("Truelegsent/StrongAttack")
	ELSN NNNNNNNNNN 2 A_FaceTarget
	ELSN A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ELSN A 0 A_PlaySound("TrueLegSent/See")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion2")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion3")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion4")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion5")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion6")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion7")
	TNT1 A 0 A_SpawnItemEx("EnragedCommotionIllusion8")
	ELSN N 2 A_SpawnItemEx("EnragedCommotionIllusion")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	ELSN N 175
	Goto See
  Pain:
	ELSN H 3
	ELSN H 3 A_Pain
	ELSN A 0 A_Jump(38,"ResurrectWave")
	ELSN A 0 A_Jump(188,"Missile")
	Goto See
  Detox:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar(user_missile,0)
	Goto See
  ResurrectWave:
	ELSN A 18 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(20,80,0,600,0)
	TNT1 A 0 A_SpawnItemEx("EnragedSphereLightningSpawner",0,0,60)
	ELSN N 3 A_PlaySound("EnragedSentient/Attack5")
	TNT1 A 0 A_SetUserVar(user_missile,0)
  ResurrectLoop1:
	TNT1 A 0 A_JumpIf(user_missile >= 12,"ResurrectLoop1End")
	TNT1 A 0 A_SpawnItemEx("EnragedSentientResurrector",frandom(-2048,2048),frandom(-2048,2048))
	//TNT1 A 0 A_SetUserVar(user_resurrectloop,user_resurrectloop+10)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	TNT1 A 0 A_Jump(256,"ResurrectLoop1")
  ResurrectLoop1End:
	ELSN N 3 A_SetUserVar(user_resurrectloop,0)
	ELSN N 3 A_SpawnItemEx("EnragedSphereLightningSpawner",0,0,60)
	TNT1 A 0 A_SetUserVar(user_missile,0)
  ResurrectLoop2:
	TNT1 A 0 A_JumpIf(user_missile >= 36,"ResurrectLoop2End")
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrection",10,0,user_resurrectloop,0)
	TNT1 A 0 A_SetUserVar(user_resurrectloop,user_resurrectloop+10)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	TNT1 A 0 A_Jump(256,"ResurrectLoop2")
  ResurrectLoop2End:
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",-50,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER) 
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",-50,-25,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER) 
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",-50,25,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",50,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER) 
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",50,-25,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER) 
	TNT1 A 0 A_SpawnItemEx("EnragedSentientSurveyor",50,25,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER)
	ELSN NNNNNN 9 A_SpawnItemEx("EnragedSphereLightningSpawner",0,0,60)
	ELSN N 3
	ELSN A 3 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Death:
	ELSN A 0 A_SetUserVar(user_missile, 0)
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EnragedSentientDeathBomb",0,0,60,frandom(-12,12),frandom(-12,12),frandom(2,15))
	TNT1 A 0 A_Scream
  DeathLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 45,"Death2")
	TNT1 AA 0 A_SpawnItemEx("EKaboomLN",frandom(0,70),frandom(0,70),frandom(0,70))
	TNT1 A 0 A_SpawnItemEx("EnragedSphereLightningSpawner",0,0,60)
	ELSN H 4 A_SetUserVar(user_missile,user_missile+1)
	Loop
  Death2:
	ELSN A 0 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(5,10),256)
	TNT1 A 0 A_SpawnItemEx("ELegendaryStrikeN")
	TNT1 A 0 A_SpawnItem("EnragedDeathBallMedium")
	ELSN HIJKLM 2 A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	ELSN A 0 A_SetUserVar(user_missile, user_missile+1)
	//TNT1 A 0 ACS_NamedExecuteAlways("SetDefaultSky",0)
	Stop
  }
}

Actor EnragedSentientStrafe : LegSentientStrafe
{
  +NOTIMEFREEZE
  States
  {
  Pickup:
	TNT1 A 0 A_ChangeVelocity(velx/2,vely/2,velz,CVF_REPLACE)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,10,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-10,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop
  }
}

