Actor EnragedSentientSurveyor : ELBSSurveyor
{
  Species "Masterminds"
  Obituary "$CFEnragedSentientSurveyorObit"
}

Actor EnragedSentientResurrector : EnragedCommotionIllusion
{
  Alpha 0.0
  States
  {
  Spawn:
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,9)
	ELSN NNN 5 A_FadeIn(0.2)
  ResurrectLoop:
	TNT1 A 0 A_JumpIf(user_rotate >= 360,"Death")
	TNT1 A 0 A_CustomMissile("TrueLegSentientMassResurrection",10,0,user_rotate,0)
	TNT1 A 0 A_CustomMissile("EnragedSentientMassResurrectionEffect",10,0,user_rotate,0)
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+10)
	TNT1 A 0 A_Jump(256,"ResurrectLoop")
  Death:
	TNT1 A 0 A_Die
	TNT1 A 0 A_NoGravity
	ELSN NNNNNNNNNN 3 A_SpawnItemEx("EnragedSphereLightningSpawner",0,0,70)
	ELSN NNNNNNNNNN 2 A_FadeOut
	Stop
  }
}

Actor EnragedSentientMassResurrectionEffect : LegSentientMassResurrectionEffect
{
  Speed 15
  +BRIGHT
  States
  {
  Spawn:
	TNT1 A 10
  SpawnLoop:
    TNT1 A 0 A_JumpIf(user_loop >= 17,"Death")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	EBA3 A 1 A_SpawnItemEx("ESRTTrail")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	EBA3 B 1 A_SpawnItemEx("ESRTTrail")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	EBA3 C 1 A_SpawnItemEx("ESRTTrail")
    TNT1 A 0 A_SetUservar(user_loop,user_loop+1)
	Stop
  Death:
    EBA3 ABCABC 1 A_FadeOut
	Stop
  }
}

Actor ESRTTrail : LSRTTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
	EBA3 ABC 1 Bright A_FadeOut(0.02)
	Loop
  }
}

Actor EnragedSentientDeathBomb
{
  Mass 500
  Radius 2
  Height 2
  +NOCLIP
  +ISMONSTER
  -COUNTKILL
  +NOGRAVITY
  +BRIGHT
  RenderStyle Add
  Species "Masterminds"
  DamageType "Legendary"
  var int user_slow;
  States
  {
  Spawn:
	EPSB ABCDEFGHIJK 3 A_ScaleVelocity(0.95)
	EPSB L 3 A_Stop
	EPSB ABCDEFGHIJKLABCDEFGHIJKLABCDEFGHIJKLABCDEFGHIJKLABCDEF 3 A_SpawnItemEx("ESDBTrail",0,0,0,frandom(-3,3),frandom(-3,3),frandom(-2,2))
	TNT1 A 0 A_SpawnItemEx("ELegendaryStrikeN")
	TNT1 A 0 A_Explode(Random(750,1500),512)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("EnragedLightningSpark",0,0,0,frandom(1,10),0,frandom(1,10),frandom(0,360),SXF_CLIENTSIDE) 
	TNT1 AAAAAAA 0 A_CustomMissile("EKaboomLN", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	Stop
  }
}

Actor ESDBTrail
{
  RenderStyle Add
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	EPSS ABCDEFGHIJKLMNOP 1 A_FadeOut
	Stop
  }
}