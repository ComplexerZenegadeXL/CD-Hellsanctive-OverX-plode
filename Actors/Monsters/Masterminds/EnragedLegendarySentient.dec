Actor EnragedCommotionIllusion
{
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.6
  Obituary "$CFEnragedCommotionIllusionObit"
  Monster
  +NODAMAGE
  +THRUACTORS
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  -COUNTKILL
  +NOGRAVITY
  +FLOAT
  +NOCLIP
  +NOINFIGHTING
  +NOTIMEFREEZE
  +BRIGHT
  Tag "$CFEnrSent"
  var int user_rotate;
  var int user_script;
  var int user_script_type;
  States
  {
  Spawn:
    ELSN E 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,8)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",7)
  Spawn2:
	TNT1 A 0 A_LookEx(LOF_NOJUMP)
  ChargeLoop:
    TNT1 A 0 A_JumpIf(user_rotate >= 120,"Fire")
	TNT1 A 0 A_Warp(AAPTR_TARGET,0,500,80,user_rotate,WARPF_WARPINTERPOLATION|WARPF_NOCHECKPOSITION|WARPF_ABSOLUTEANGLE)
	ELSN E 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+4)
	Loop
  Fire:
    TNT1 A 0 A_CustomMissile("EnragedCommotion",50)
  ChargeLoop2:
    TNT1 A 0 A_JumpIf(user_rotate >= 245,"ChargeLoop3")
	TNT1 A 0 A_Warp(AAPTR_TARGET,0,500,80,user_rotate,WARPF_WARPINTERPOLATION|WARPF_NOCHECKPOSITION|WARPF_ABSOLUTEANGLE)
	ELSN F 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+4)
	Loop
  ChargeLoop3:
    TNT1 A 0 A_JumpIf(user_rotate >= 315,"Fire2")
	TNT1 A 0 A_Warp(AAPTR_TARGET,0,500,80,user_rotate,WARPF_WARPINTERPOLATION|WARPF_NOCHECKPOSITION|WARPF_ABSOLUTEANGLE)
	ELSN E 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+4)
	Loop
  Fire2:
    TNT1 A 0 A_CustomMissile("EnragedCommotion",50)
	TNT1 A 0 A_Die
  Death:
    ELSN FFFNNNNNNN 2 A_FadeOut
	Stop
  }
}

