    ERS1 A 1 Bright A_CustomMissile("EnragedSentientDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    ERS1 B 1 Bright A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    ERS1 C 1 Bright A_CustomMissile("EnragedSentientDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    ERS1 D 1 Bright A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),Random(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  DTBFGSFX:
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    ERS1 A 1 Bright A_CustomMissile("EnragedSentientDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    ERS1 B 1 Bright A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    ERS1 C 1 Bright A_CustomMissile("EnragedSentientDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRed2",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    ERS1 D 1 Bright A_SpawnItemEx("EBFGParticle",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn	
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("EnragedBabySentientDTBFG10KTracer",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningRedSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	ERS1 ABCD 6 Bright A_SpawnItemEx("Enraged10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(Random(400,560),340)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("Enraged10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItem("EnragedDTBFGEx",0,-10)
    Stop    
  }
}

