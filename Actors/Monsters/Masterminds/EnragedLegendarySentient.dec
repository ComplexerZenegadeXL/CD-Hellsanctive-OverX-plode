	TNT1 A 0 A_Warp(AAPTR_TARGET,0,500,80,user_rotate-45,WARPF_WARPINTERPOLATION|WARPF_NOCHECKPOSITION|WARPF_ABSOLUTEANGLE)
	ELSN E 1 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_rotate,user_rotate+4)
	Loop
  Fire2:
    TNT1 A 0 A_CustomMissile("EnragedCommotion",50)
	TNT1 A 0 A_Die
  Death:
    ELSN FFFNNNNNNN 2 A_FadeOut
	Stop
  }
}

