Actor SpiderMasterspark : DarkDemolisher 17562 //currently incomplete but he works
{ 
  //$Category Monsters/CF
  //$Sprite SMPRA1
  //$Title "Spider Masterspark"
  BloodColor "Blue"
  Obituary "$CFSpiderMastersparkObit"
  Tag "$CFMSpark"
  var int user_missile;
  States
  {
  Spawn:
	SMPR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    SMPR A 10 A_Look 
    Loop 
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("SpiderMastermind",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  See: 
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    SMPR A 3 A_Metal 
    SMPR ABB 3 A_Chase 
    SMPR C 3 A_Metal 
    SMPR CDD 3 A_Chase 
    SMPR E 3 A_Metal 
    SMPR EFF 3 A_Chase 
    Loop 
  Missile:
	//TNT1 A 0 A_Jump(256,"MasterSpark","SomeOtherAttack")
  MasterSpark:
    SMPR T 20 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
    TNT1 A 0 A_Playsound("Cardinal/9k",1)
    SMPR GGGG 8 Bright A_FaceTarget	
	SMPR G 0 A_Playsound("MasterSpark",0,1,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  SparkLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 5,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMPR H 1 A_CustomMissile("SpiderMasterLaserGreen",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMPR H 1 A_CustomMissile("SpiderMasterLaserGreen",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMPR H 1 A_CustomMissile("SpiderMasterLaserGreen",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 J 1 A_CustomMissile("SpiderMasterLaserCyan",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 J 1 A_CustomMissile("SpiderMasterLaserCyan",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 J 1 A_CustomMissile("SpiderMasterLaserCyan",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 B 1 A_CustomMissile("SpiderMasterLaserBlue",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 B 1 A_CustomMissile("SpiderMasterLaserBlue",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 B 1 A_CustomMissile("SpiderMasterLaserBlue",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 D 1 A_CustomMissile("SpiderMasterLaserPurple",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 D 1 A_CustomMissile("SpiderMasterLaserPurple",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 D 1 A_CustomMissile("SpiderMasterLaserPurple",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 F 1 A_CustomMissile("SpiderMasterLaserRed",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 F 1 A_CustomMissile("SpiderMasterLaserRed",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 F 1 A_CustomMissile("SpiderMasterLaserRed",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 H 1 A_CustomMissile("SpiderMasterLaserYellow",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 H 1 A_CustomMissile("SpiderMasterLaserYellow",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
	TNT1 A 0 A_FaceTarget(0.75,180)
	SMA2 H 1 A_CustomMissile("SpiderMasterLaserYellow",45,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,pitch)
    Loop
  Pain: 
    SMPR I 3 
    SMPR I 3 A_Pain 
    Goto See 
  Death:
	TNT1 A 0 A_Scream
	SMPR I 20 A_Fall
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SMPR JJJJJ 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SMPR KKKKK 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SMPR LLLLL 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,-0), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SMPR MMMMM 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SMPR NNNNN 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SMPR OOOOO 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	SMPR PPPPP 2 Bright A_CustomMissile("RainbowKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
	TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SMPR QR 5
	TNT1 A 0 A_BossDeath
	SMPR S -1
	Stop
  } 
}

Actor SpiderMasterLaserBlue : FastProjectile
{
  Speed 100
  Radius 13
  Height 8
  Damage (Random(5,10))
  RenderStyle Add
  Species "Masterminds"
  DamageType "DarkDemoEx"
  SeeSound ""
  Scale 2.0
  +THRUSPECIES
  -CANNOTPUSH
  -NODAMAGETHRUST
  +NOEXTREMEDEATH
  +FORCERADIUSDMG
  +RIPPER
  +BLOODLESSIMPACT
  MissileType "SpiderMasterTrailSpawnerBlue"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 4 //A_PlaySound("ultimate/laser", CHAN_AUTO|CHAN_NOPAUSE)
	Loop
  Death:
    TNT1 A 0 Radius_Quake(6,6,0,12,0)
	TNT1 A 0 A_Explode(8,64,0,False,60)
	TNT1 A 0 A_SpawnItemEx("SpiderMasterFlareBlue")
    //T3FS ABCDEFGHIJKLMNOP 2 Bright A_FadeOut(0.06)
	TNT1 A 1
    Stop
  }
}

