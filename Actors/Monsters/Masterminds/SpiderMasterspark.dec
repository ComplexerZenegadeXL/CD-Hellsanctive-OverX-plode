Actor SpiderMasterFlareBlue
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  Scale 0.5
  Alpha 1.0
  Renderstyle Add
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    MTSF A 2 Bright
  Continuous:
    MTSF A 1 Bright A_FadeOut(0.05)
    Loop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

