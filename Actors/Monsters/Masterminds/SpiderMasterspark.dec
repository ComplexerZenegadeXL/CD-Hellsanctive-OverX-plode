Actor SpiderMasterTrailBlue
{
  RenderStyle Add
  Scale 3.0
  Alpha 0.75
  +THRUSPECIES
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
    Spawn:
	  TNT1 A 0
	  TNT1 A 0 A_Jump(256, "AltSpawn", "AltSpawn2")
	"AltSpawn":
	  TNT1 A 0
	  MTS1 A 1 A_FadeOut
	  Goto "FadeOut"
	"AltSpawn2":
	  TNT1 A 0
	  MTS1 C 1 A_FadeOut
	  Goto "FadeOut"
	"FadeOut":
	  MTS1 BACBACABA 1 A_FadeOut
      Stop
  }
}

