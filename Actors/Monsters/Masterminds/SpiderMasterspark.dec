Actor SpiderMasterTrailSpawnerBlue
{
  +THRUSPECIES
  +NOGRAVITY
  +NOCLIP
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  Species "Masterminds"
  DamageType "DarkDemoEx"
  States
  {
    Spawn:
      TNT1 A 0
	  TNT1 A 0 A_Explode(2,60,0,False,60)
      TNT1 A 2 A_SpawnItemEx("SpiderMasterTrailBlue", frandom (-3, 3), 0, frandom (-3, 3), 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
      Stop
  }
}

