	DPYT O 3 Bright A_CustomMissile("OverseerPlasma",21,13,frandom(-6,6),0)
	DPYT MMMMMMMMMMMM 3 Bright
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  Death:
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_Scream
	DPYT E 20 Bright A_Fall
    TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	DPYT FFFFF 2 Bright A_CustomMissile("Kaboom5", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,-0),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
