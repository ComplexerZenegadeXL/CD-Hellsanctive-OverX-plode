Actor Overseer : CerebralSentient 17573
{
  //$Category Monsters/CF
  //$Sprite DPYTA1
  //$Title "Overseer"
  Health 6500
  PainChance 30
  DropItem "BossLifeEssence" 204 25
  DropItem "BossArmorBonusMax" 204 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "SkullOfPowerGiver" 96
  DropItem "PlasmaRepeaterGiver" 256
  DropItem "ChaosEssence" 180
  DropItem "DemonTechBFG10KGiver" 230
  DamageFactor "Legendary", 0.7
  DamageFactor "PlayerLegendary", 0.7
  SeeSound "Overseer/sight"
  PainSound "Overseer/pain"
  DeathSound "Overseer/death"
  ActiveSound "Overseer/active"
  +DONTHARMSPECIES
  BloodColor "Green"
  Obituary "$CFOverseerObit"
  Tag "$CFOvers"
  var int user_missile;
  var int user_summon;
  States
  {
  Spawn:
	DPYT A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,17)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",16)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SetUserVar("user_summon",0)
  IdleLoop:
	TNT1 A 0 A_Playsound("Overseer/Loop",7,1,1)
	DPYT AB 4 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DPYT AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_UnsetInvulnerable
	DPYT AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Evade")	
	Loop
  Evade:
 	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	DPYT ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	DPYT ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K","DTBFG10K","Railgun")
	TNT1 A 0 A_Jump(16,"SuperCombo","PainResurrect","PainSummon")
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto BFG9K
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 Bright A_CustomMissile("OverseerPlasma",21,-13,frandom(-6,6),0)
	DPYT C 3 Bright A_CustomMissile("OverseerPlasma",21,13,frandom(-6,6),0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 Bright A_CustomMissile("OverseerPlasma",21,-13,frandom(-6,6),0)
	DPYT D 3 Bright A_CustomMissile("OverseerPlasma",21,13,frandom(-6,6),0)
	TNT1 A 0 A_Jump(3,"See","BFG9K","BFG10K","DTBFG10K")
    TNT1 A 0 A_SpidRefire
	Goto Normal+10
/*  Laser:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto BFG9K
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 Bright A_CustomMissile("OverseerLaser",21,-13,frandom(-6,6),0)
	DPYT C 3 Bright A_CustomMissile("OverseerLaser",21,13,frandom(-6,6),0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 Bright A_CustomMissile("OverseerLaser",21,-13,frandom(-6,6),0)
	DPYT D 3 Bright A_CustomMissile("OverseerLaser",21,13,frandom(-6,6),0)
	TNT1 A 0 A_Jump(3,"See","BFG9K","BFG10K","DTBFG10K")
    TNT1 A 0 A_SpidRefire
	Goto Laser+10 */
  BFG9K:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_JumpIf(user_missile >= 3,"BFG9KEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG9KLoop:
	DPYT K 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	Loop
	DPYT L 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT L 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT L 2 Bright A_CustomMissile("SpiderBFG9500Ball", 34, 0, 0)
	DPYT K 6 Bright
	Goto BFG9K+1	
  BFG9KEnd:
	DPYT K 8 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT K 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop2:
	DPYT L 3 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT K 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop3:
	DPYT L 2 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT K 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop	
    DPYT L 2 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT K 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	DPYT KKKKK 3 Bright A_SpawnItemEx("OverseerFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See
  DTBFG10K:
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	DPYT KKKKK 4 Bright A_FaceTarget
	DPYT LLLL 2 Bright A_FaceTarget
	DPYT L 2 Bright A_CustomMissile("OverseerDTBFG10KBall", 34, 0, 0)
	TNT1 A 0
	DPYT KKKK 5 Bright
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	DPYT KKKK 5 Bright A_FaceTarget
	DPYT LL 4 Bright A_FaceTarget
	DPYT L 2 Bright A_CustomMissile("OverseerDTBFG10KBall", 34, 0, 0)
	DPYT KKKKKKKKKKKK 2 Bright A_SpawnItemEx("OverseerFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  Railgun:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DPYT KKKK 7 Bright A_FaceTarget
	DPYT L 2 Bright A_CustomMissile("OverseerRail", 34, 0, 0)
	DPYT LK 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DPYT KKKK 7 Bright A_FaceTarget
	DPYT L 2 Bright A_CustomMissile("OverseerRail", 34, 0, 0)
	DPYT LK 2 Bright A_FaceTarget
	Goto See
  Pain:
	TNT1 A 0 A_Jump(256,"PainSummon")
	TNT1 A 0 A_Jump(16,"PainResurrect","PainSummon")
	TNT1 A 0 A_Jump(128,"PainMissile")
	DPYT A 3 Bright
	DPYT A 3 Bright A_Pain	
	Goto See
  PainMissile:
	DPYT A 3 Bright
	DPYT A 3 Bright A_Pain
	Goto Missile
  PainResurrect:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	DPYT A 3 Bright
	DPYT A 3 Bright A_Pain
	DPYT AAAA 3 Bright
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 HealThing(750)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    DPYT M 3 Bright A_PlaySound("Overseer/attack")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_CustomMissile("OverseerMassResurrectionEffect",10,0,user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop")
	TNT1 AA 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_CustomMissile("OverseerMassResurrectionEffect",10,0,15 + user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 11,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DPYT M 3 Bright
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DPYT M 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop3:
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop3")
	DPYT MMMMMMMMMM 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop4:
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop4")
	DPYT MMMMMMMMMMMM 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_UnSetInvulnerable
	DPYT M 3 Bright A_SpawnItemEx("OverseerFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See	
  PainSummon:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	DPYT A 3 Bright
	DPYT A 3 Bright A_Pain
	DPYT A 12 Bright
	TNT1 A 0 A_JumpIf(user_summon >= 3,"See")
	TNT1 A 0 A_SetUserVar("user_summon",user_summon+1)
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 HealThing(750)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    DPYT M 3 Bright A_PlaySound("Overseer/attack")
    TNT1 A 0 A_PlaySound("brain/spit",7)
  PainSummonLoop:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIf(user_missile >= 3,"SummonEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainSummonLoop2:
	TNT1 A 0 A_SpawnItemEx("OverseerSummonSmokeSpawner",64,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DPYT M 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,1)
	Loop
	TNT1 A 0 A_SpawnItemEx("OverseerSummonSmokeSpawner",64)
	TNT1 A 0 A_SpawnItemEx("BabyOverseerMinion",64,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	//TNT1 A 0 A_SpawnItemEx("OverseerSpawners",0,0,20,30,0,0,225,0)
	//TNT1 A 0 A_SpawnItemEx("OverseerSpawners",0,0,20,30,0,0,305,0)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto PainSummonLoop
  SummonEnd:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SummonEndLoop:
	DPYT M 3 Bright
	TNT1 A 0 A_SpawnItemEx("OverseerSummonSmokeSpawner",64,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_UnSetInvulnerable
	DPYT MM 3 Bright
	Goto See	
  SuperCombo:
	TNT1 A 0 A_Changeflag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("Overseer/Attack")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SuperComboLoop:
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	DPYT A 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SuperComboLoop2:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("OverseerStrafe",1)
	TNT1 A 0 A_CustomMissile("OverseerPlasma",21,-13,frandom(-6,6),0)
