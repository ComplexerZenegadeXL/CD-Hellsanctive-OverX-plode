Actor SacrosanctOverseer : Overseer 17576
{
  //$Category Monsters/CF
  //$Sprite AOVRA1
  //$Title "Sacrosanct Overseer"
  Health 8000
  PainChance 15
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "SkullOfPowerGiver" 96
  DropItem "DemonicChaliceGiver" 64
  DropItem "PlasmaRepeaterGiver" 256
  DropItem "DemonTechBFG10KGiver" 256
  DropItem "ChaosEssence" 256
  DamageFactor 0.65
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.6
  DamageFactor "LegendaryGuru", 0.01
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "BFGSplash", 0.1
  DamageFactor "BFGSpray", 0.1
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "PlayerDevBall", 0.20
  DamageFactor "PlayerDevBall2", 0.20
  DamageFactor "PlayerDevTracer", 0.20
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.3
  DamageFactor "RailG", 0.8
  DamageFactor "Normal", 0.8
  DamageFactor "DiscoBFG", 1.3
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.3
  SeeSound "SOverseer/sight"
  PainSound "SOverseer/pain"
  DeathSound "SOverseer/death"
  ActiveSound "SOverseer/active"
  Obituary "$CFSacrosanctOverseerObit"
  +NOTIMEFREEZE
  +BRIGHT
  +SEEINVISIBLE
  +DONTRIP
  +CANTSEEK
  +NOTARGET
  +NOICEDEATH
  Tag "$CFSOvers"
  var int user_music;
  var int user_rage;
  States
  {
  Spawn:
	AOVR A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,17)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",16)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_Playsound("SOverseer/Loop",7,1,1)
	AOVR AB 4 Bright A_Look
	Loop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("SpiderMastermind",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	AOVR AB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,305)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	AOVR AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Evade","Teleport")	
	Loop
  Teleport:
    AOVR A 1 Bright A_UnSetShootable
	AOVR AAAAAA 1 A_FadeOut(0.2,0)
	AOVR A 1 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    AOVR A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	AOVR AAAAAA 1 A_FadeIn(0.2)
    AOVR A 1 Bright A_SetShootable
    Goto See
  Evade:
 	TNT1 A 0 A_Jump(128,"Evade2")
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	AOVR ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Evade2:
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	AOVR ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K","DTBFG10K","Railgun")
	TNT1 A 0 A_Jump(64,"Laser","LightningBalls")
	//TNT1 A 0 A_Jump(32,"LightningStorm")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(16,"PainSummon")
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto BFG9K
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR A 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR A 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR A 2 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	TNT1 A 0 A_CustomMissile("OverseerPlasma",21,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("OverseerPlasma",21,-20,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	AOVR E 2 Bright A_CustomMissile("OverseerPlasma",21,20,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	TNT1 A 0 A_CustomMissile("OverseerPlasma",21,0,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("OverseerPlasma",21,-20,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	AOVR F 2 Bright A_CustomMissile("OverseerPlasma",21,20,frandom(-10,10),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_Jump(3,"See","BFG9K","BFG10K","DTBFG10K")
    TNT1 A 0 A_SpidRefire
	Goto Normal+7
  BFG9K:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_JumpIf(user_missile >= 5,"BFG9KEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG9KLoop:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 2 Bright A_CustomMissile("SpiderBFG9500Ball", 34, 0, 0)
	AOVR N 6 Bright A_FaceTarget
	Goto BFG9K+1
  BFG9KEnd:
	AOVR NN 7 Bright A_FaceTarget
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop2:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	AOVR O 3 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop3:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    AOVR O 2 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop	
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    AOVR O 2 Bright A_CustomMissile("DarkDemo10K", 42, 0, frandom(-4,4))
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	AOVR NNNNN 3 Bright A_SpawnItem("OverseerFireSpawner",0,0,0,0)	
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See
  DTBFG10K:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_JumpIf(user_missile >= 3,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTBFG10KLoop:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop	
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_FaceTarget
	AOVR O 2 Bright A_CustomMissile("OverseerDTBFG10KBall", 34, 0, 0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DTBFG10KLoop2:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	TNT1 A 0
	Goto DTBFG10K+1
  Railgun:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunLoop:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunLoop2:
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_CustomMissile("OverseerRail",34,0,frandom(-5,5))
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR O 4 Bright A_CustomMissile("OverseerRail",34,0,frandom(-5,5))
	Goto See
  Laser:
	TNT1 A 0 A_SetUserVar("user_missile",0)
    TNT1 A 0 A_Playsound("MasterSparkCharge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 30,"LaserFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_GiveInventory("SacroOverseerStrafe",1)
	AOVR N 4 Bright A_FaceTarget
	Goto Laser+3
  LaserFire:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_Playsound("MasterSpark",0,1,0,ATTN_NONE)
	TNT1 A 0 A_JumpIf(user_missile >= 90,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	AOVR O 1 Bright A_CustomMissile("SpiderMasterLaserGreen", 34, 0, 0)
	Goto LaserFire+2
  LightningBalls:
	AOVR A 3 Bright
	AOVR A 3 Bright A_Pain
	AOVR A 12 Bright
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 HealThing(500)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_FaceTarget
	AOVR P 20 Bright A_PlaySound("SOverseer/attack20")
	TNT1 A 0 A_SpawnItemEx("GreenLightning",0,0,100)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_FaceTarget
	AOVR QQQQ 4 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	AOVR QQQQ 4 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  LightningBallChargeLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"LightningBallLoop")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,100,0,0)
	AOVR R 4 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  LightningBallLoop:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIf(user_missile >= 20,"LightningBallEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItem("ChaosSuperLightningFX",40,100,0,0)
	AOVR R 4 Bright A_CustomMissile("SacroOverseerLightningBall",100,0,frandom(-15,15),CMF_OFFSETPITCH,frandom(-5,5))
	Goto LightningBallLoop+1
  LightningBallEnd:
	AOVR RRRQQQQPPPP 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Pain:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_Jump(32,"PainSummon")
	TNT1 A 0 A_Jump(128,"PainMissile")
	AOVR A 3 Bright
	AOVR A 3 Bright A_Pain	
	Goto See
  PainMissile:
	AOVR A 3 Bright
	AOVR A 3 Bright A_Pain
	Goto Missile
  PainResurrect:
	AOVR A 6 Bright
	TNT1 A 0  A_PlaySound("SOverseer/attack20")
	AOVR A 12 Bright
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 HealThing(500)
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	AOVR P 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_CustomMissile("OverseerMassResurrectionEffect",10,0,user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop")
	AOVR PP 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_CustomMissile("OverseerMassResurrectionEffect",10,0,15 + user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	AOVR PP 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,0,0)
	AOVR PPPPPPPPPPPP 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,0,0)
	AOVR PPPPPPPPPPPP 3 Bright A_SpawnItemEx("OverseerBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See	
  PainSummon:
	AOVR A 6 Bright
	TNT1 A 0  A_PlaySound("SOverseer/attack20")
	AOVR A 12 Bright
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 HealThing(500)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	AOVR P 3 Bright
	TNT1 A 0 A_PlaySound("brain/spit",7)
  SummonLoop:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIf(user_missile >= 3,"SummonEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	AOVR PPPPPPPPPPPPPPPPPPPPP 3 Bright A_SpawnItemEx("OverseerSummonSmokeSpawner",128,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("BabyOverseerMinion",128,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Loop
  SummonEnd:
	AOVR PPPPPP 3 Bright A_SpawnItemEx("OverseerSummonSmokeSpawner",128,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See	
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_StopSound(7)
	TNT1 A 0 A_Scream
	AOVR H 20 Bright A_Fall
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	AOVR IIIII 2 Bright A_CustomMissile("Kaboom5", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	AOVR JJJJJ 2 Bright A_CustomMissile("Kaboom5", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	AOVR KKKKK 2 Bright A_CustomMissile("Kaboom5", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	AOVR LLLLL 2 Bright A_CustomMissile("Kaboom5", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	AOVR M 5
	Stop	
  }
}

Actor SacroOverseerLightningBall : ChaosSuperLightningProj { Species "Masterminds" DamageType "DarkDemoEx" }

Actor SacroOverseerSummonSmokeSpawner : LHellionSmokeSpawner
{
  -NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("OverseerBrainSFX",-128)
	TNT1 AAA 1 A_SpawnItemEx("OverSeerFire",frandom(-4,4),frandom(-4,4),frandom(0,4),frandom(-4,4),frandom(-4,4),frandom(3,10),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 1
	Stop		
  }
}

Actor SacroOverseerStrafe : OverseerStrafe
{
  States
  {
  Pickup:
	TNT1 A 0 A_ChangeVelocity(velx/2,vely/2,velz,CVF_REPLACE)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,7,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-7,0,0)
