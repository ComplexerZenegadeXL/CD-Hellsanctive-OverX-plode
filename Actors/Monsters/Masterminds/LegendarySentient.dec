  PainChance "DBFG2", 256
  PainChance "PlayerDBFG10K2", 256
  SeeSound "legsentient/sight"
  PainSound "legsentient/pain"
  DeathSound "legsentient/death"
  Species "Masterminds"
  Obituary "$CFLegendarySentientObit"
  Tag "$CFLegSent"
  var int user_loop;
  var int user_loop2;
  var int user_music;
  var int user_script;
  var int user_script_type;
  var int user_wait;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LUPR A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,3)
    TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	LUPR AB 2 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LUPR AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_script_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,8)
	TNT1 A 0 A_SetUserVar("user_music",1)
	LUPR AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Evade")
	TNT1 A 0 A_Jump(15,"Teleport")
	Loop
  Evade:
	TNT1 A 0 A_Jump(128,11)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	LUPR AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	LUPR AAAAAAAA 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Teleport:
    LUPR A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_script_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
    LUPR BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB 0 A_Wander
    LUPR B 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LUPR N 2 
    LUPR AAABBBAABB 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_script_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LUPR A 1 Bright A_SetShootable
	Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_SetUserVar("user_script_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(216,"LegBFG9K","LegBFG10K","LegDTBFG10K","LegBFG15K","PlasmaCannon","ProtonCannon","LegendaryStorm","CerebralCommotion","LegendaryDevastator","LegendaryTech","LegendaryBFG")		
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto ProtonCannon
	LUPR A 6 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LUPR F 1 Bright A_CustomMissile("LegSentientExplosiveTracer",31,0,frandom(-8,8),0)
	LUPR F 2 Bright A_CustomMissile("LegSentientExplosiveTracer",31,0,frandom(-8,8),0)
    TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LUPR E 3 Bright A_CustomMissile("LegSentientExplosiveTracer",31,0,frandom(-8,8),0)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(3,"See","Missile")
    TNT1 A 0 A_SpidRefire
	Goto Normal+7
  ProtonCannon:
    LUPR P 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")	
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    LUPR P 3 Bright A_PlaySound("legsentient/laugh",5)
	TNT1 A 0 Radius_Quake (40, 350, 0, 90, 0)
	TNT1 A 0 A_SetUserVar("user_wait",0)
  ProtonCannonWait:
    TNT1 A 0 A_JumpIf(user_wait >= 28,"ProtonCannonGo")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	TNT1 A 0 A_FaceTarget
    LUPR P 3 Bright A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  ProtonCannonGo:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")	
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ProtonCannonGoLoop:				
	LUPR O 0 A_PlaySound("Petrovec/Fire",1)
    LUPR O 0 A_PlaySound("Petrovec/AddFire",6)
    LUPR O 0 A_PlaySound("Petrovec/Ambient",5)
	LUPR O 6 Bright A_CustomMissile("CFPetrovecBolt", 42, 0, 0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Goto ProtonCannonGoLoop
    TNT1 A 0 A_Jump(192,"Missile")
	Goto See
  CerebralCommotion:
    LUPR P 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",8)
    LUPR P 3 Bright A_PlaySound("legsentient/laugh",5)
	TNT1 A 0 A_SetUserVar("user_wait",0)
  CerebralCommotionWait:
    TNT1 A 0 A_JumpIf(user_wait >= 31,"CerebralCommotionGo")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	LUPR P 3 Bright A_FaceTarget(45)
    Loop
