Actor LegSentientDTBFGBall : LegAnniDTBFGBall
{
  +DONTHURTSPECIES
  Species "Masterminds"
  DamageType "Legendary"
  Obituary "$CFLegSentientDTBFGBallObit"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    LGS1 ABCD 1 Bright  A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LegSentientDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Loop
  DTBFGSFX:
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(6,-6),frandom(6,-6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    LGS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    LGS1 B 1 Bright  A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    LGS1 C 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    LGS1 D 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("LegSentientDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Goto Spawn   
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("LegSentientDTBFGTracer",0,0,user_loop * 36,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGoldSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	LGS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwaveGold", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,240)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwaveGold1", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItemEx("LegAnniDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Stop    
  }
}

