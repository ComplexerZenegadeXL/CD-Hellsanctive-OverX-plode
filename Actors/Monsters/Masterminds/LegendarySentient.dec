	LEMR A 1 Bright A_SpawnItemEx("LSRTTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LEMR B 1 Bright A_SpawnItemEx("LSRTTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LEMR C 1 Bright A_SpawnItemEx("LSRTTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
