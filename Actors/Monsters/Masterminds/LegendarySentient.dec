  LegendaryBFG:
    LUPR NNNNNNNNN 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    LUPR N 3 Bright A_PlaySound("legsentient/laugh",5)
    LUPR N 3 Bright A_PlaySound("Legcyber/BFG",6)
	TNT1 A 0 A_SetUserVar("user_wait",0)	
  LegendaryBFGWait:
    TNT1 A 0 A_JumpIf(user_wait >= 37,"LegendaryBFGGo")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
    LUPR N 3 Bright A_FaceTarget
    Loop	
  LegendaryBFGGo:
	TNT1 A 0 A_JumpIfTargetInLos("LegBFGGo")
    LUPR NNNNNNNNNN 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_script_type",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LUPR N 1 A_PlayWeaponSound("boss/teleport")
    LUPR NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
    TNT1 A 0 A_FaceTarget
    LUPR NNNNNNNN 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LUPR NNNNNNNNNN 1 A_FadeIn(0.1)
  LegBFGGo:	
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_SetUserVar("user_script_type",2)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_PlaySound("Weapons/GuruFire", CHAN_WEAPON)
    TNT1 A 0 A_PlaySound("Weapons/GuruAddFire", CHAN_WEAPON)
    TNT1 A 0 A_CustomMissile("SentientGuruBall", 42, 0, 0, 0)
	LUPR O 1 A_SetShootable
    LUPR NNNNNNNNNNNNNNN 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(192,"Missile")
    Goto See
