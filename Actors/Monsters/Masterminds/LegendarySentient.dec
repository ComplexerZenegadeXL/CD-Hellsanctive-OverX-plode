Actor LegendarySentient : SpiderMastermind 16514
{
  //$Category Monsters/LCA
  //$Sprite LUPRA1
  //$Title "Legendary Sentient"
  Health 5999
  Speed 15
  FloatSpeed 15
  PainChance 10
  Scale 1.1
  Radius 65
  Height 100
  BloodColor "Blue"
  DropItem "LegendaryUltraSphere" 205
  DropItem "LDemonAmmoBoxPickup" 256
  //DropItem "LegendaryBFGGiver" 256 1
  DropItem "LegendaryBossLifeEssence" 256
