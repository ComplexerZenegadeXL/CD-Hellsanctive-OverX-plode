  Pain:
	TNT1 A 0 A_Jump(30,"PainResurrect")
	TNT1 A 0 A_Jump(120,"PainMissile")
	TNT1 A 0 A_Jump(25,"Teleport")
	LUPR A 3 Bright
	LUPR A 3 Bright A_Pain	
	Goto See
  Pain.DBFG10K2:
  Pain.PlayerDBFG10K2:
  Pain.DBFG2:
  Pain.PlayerDBFG2:
    TNT1 A 0 A_Jump(250, "Teleport")
    Goto PainMissile
  PainMissile:
	LUPR A 3 Bright
	LUPR A 3 Bright A_Pain
	Goto Missile
  PainResurrect:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	LUPR A 3 Bright
	LUPR A 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("LegSentientToken",3,"See")	
	LUPR AAAA 3 Bright 
	TNT1 A 0 A_GiveInventory("LegSentientToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",850)
	TNT1 A 0 A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LUPR P 3 Bright A_PlaySound("sentient/laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop1:	
	TNT1 A 0 A_CustomMissile("LegSentientMassResurrectionEffect",10,0,user_loop*30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop1")
	TNT1 A 0 A_SetUserVar("user_loop",0)
	LUPR P 3 Bright A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LUPR P 3 Bright A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_CustomMissile("LegSentientMassResurrectionEffect",10,0,15+user_loop*30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",0)
	LUPR P 3 Bright A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LUPR P 3 Bright A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
	TNT1 A 0 A_SetUserVar("user_loop2",0)
  PainResurrectLoop3:
	TNT1 A 0 A_CustomMissile("LegSentientMassResurrection",10,0,user_loop*10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop3")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop4:
	LUPR P 3 Bright  A_SpawnItemEx("LegSentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 11,1)
	Goto PainResurrectLoop4
	TNT1 A 0 A_SetUserVar("user_loop2",user_loop2+1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
	TNT1 A 0 A_JumpIf(user_loop2 == 2,2)
	Goto PainResurrectLoop3
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	LUPR A 3 Bright 
	Goto See
  Death:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(32,"LegDeath") //32
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_Scream
	LUPR H 20 A_Fall
	TNT1 A 0 A_SpawnItemEx("LegendarySentientDeathEffect",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	//TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	LUPR IJKL 20 Bright
	TNT1 A 0 A_SpawnItemEx("DeathBall2")
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 A_DropItem("LegendaryDust",random(1,3),256)
	LUPR LM 5
	Stop	
  LegDeath:
	LUPR H 20 Bright
	TNT1 A 0 A_SpawnItemEx("LegendarySentientDeathEffect",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LUPR IJKL 20 Bright
	TNT1 A 0 A_SpawnItemEx("TrueDeathBall")
	TNT1 A 0 ACS_NamedExecuteAlways("SetTLCSky",0)
	TNT1 A 0 A_SpawnItemEx("TrueLegPentagram",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LUPR LM 5 Bright
	TNT1 AAAA 50
	TNT1 A 0 A_KillMaster
	TNT1 A 0 A_SpawnItemEx("LegendaryDreadnoughtIllusion", 0, 0, 96)
	TNT1 A 550
	TNT1 A 0 A_SpawnItemEx("TrueLegendarySentient", 0, 0, 32, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FadeOut
	Stop
  }
}

