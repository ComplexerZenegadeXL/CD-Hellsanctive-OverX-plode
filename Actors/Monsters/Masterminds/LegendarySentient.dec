  LegendaryTech:
    LUPR PPPPPPPP 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",8)
    LUPR P 3 Bright A_PlaySound("legsentient/laugh",5)
	TNT1 A 0 A_SetUserVar("user_wait",0)
  LegendaryTechWait:
    TNT1 A 0 A_JumpIf(user_wait >= 31,"LegendaryTechGo")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	TNT1 A 0 A_FaceTarget
    LUPR P 3 Bright A_FaceTarget
    Loop
  LegendaryTechGo:	
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_wait",0)
  LegendaryTechGoo:
    TNT1 A 0 A_JumpIf(user_wait >= 30,"LegendaryTechEnd")	 
    TNT1 A 0 A_SetUserVar("user_wait",user_wait+1)
	TNT1 A 0 A_FaceTarget
    LUPR EF 2 Bright A_CustomMissile("SentientLegendaryProjectile",31,0,frandom(-8,8),0)
    TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    Loop	
  LegendaryTechEnd:
    LUPR PPPPPPPPPPPPPPP 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(192,"Missile")
    Goto See
  LegBFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LUPR NNNNNNOO 4 Bright A_FaceTarget
	LUPR O 2 Bright A_CustomMissile("LegSentientBFG9500Ball",42,0,0)
	LUPR N 6 Bright
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LUPR NNNNNNOO 4 Bright A_FaceTarget
