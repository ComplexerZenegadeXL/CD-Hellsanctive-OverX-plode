Actor EmpoweredBFGArachnophyte : BFGMastermind
{
  Scale 1.1
  Speed 20
  Health 7500
  +FLOAT
  +NOGRAVITY	
  -FLOORCLIP
  +BRIGHT
  Mass 2500
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "NewCellPackPickup" 186 300
  DropItem "SphereOfPower" 200
  DropItem "BFG10KGiver" 128
  DropItem "BFG9500Giver" 128
  Obituary "$CFEmpoweredBFGArachnophyteObit"
  Tag "$CFEbfgArac"
  var int user_script;
  var int user_script_type;
  States
  {
  Spawn:
	BPYT A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,26)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",25)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BPYT AB 4 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BPYT AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	BPYT AB 2 A_Chase
	TNT1 A 0 A_Jump(40,"Evade")
	Loop
  Evade:
	TNT1 A 0 A_Jump(128,3)
	TNT1 A 0 ThrustThing(Angle*256/360+64,30,0,0)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 ThrustThing(Angle*256/360+192,30,0,0)
	BPYT ABABABAB 2 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BFG15k","BFG9K","Railgun")
  DemonTech:
	BPYT A 20 A_FaceTarget
	TNT1 AA 0 A_GiveInventory("OverseerStrafe")
	TNT1 A 0 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("BMasterMindPlasma",39,0,frandom(-5,5),CMF_OFFSETPITCH,frandom(-1,1))
	BPYT C 1
	TNT1 A 0 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("BMasterMindPlasma",39,0,frandom(-5,5),CMF_OFFSETPITCH,frandom(-1,1))
	BPYT D 1
	TNT1 A 0 A_Jump(2,"See","Missile","BFG9K")
	TNT1 A 0 A_SpidRefire
	Goto DemonTech+1
  BFG9k:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	BPYT CCCCC 5 A_FaceTarget
	BPYT D 8 A_FaceTarget
	BPYT D 4 A_CustomMissile("EmpoweredSpiderBFG9500Ball",39)
	BPYT C 6
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	BPYT CCCCC 5 A_FaceTarget
	BPYT D 8 A_FaceTarget
	BPYT D 4 A_CustomMissile("EmpoweredSpiderBFG9500Ball",39)
	BPYT C 6
	TNT1 A 0 A_Jump(128,"BFG15K")
	Goto See
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	BPYT CCCC 6 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("EmpoweredSpiderBFG15KBall",39,0,frandom(-8,8))
	TNT1 AA 0 A_GiveInventory("OverseerStrafe")
	BPYT D 4 A_FaceTarget
	TNT1 AA 0 A_GiveInventory("OverseerStrafe")
	BPYT C 4 A_FaceTarget
	TNT1 A 0 A_SpidRefire
	Goto BFG15k+5
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	BPYT CCC 5 A_FaceTarget
	BPYT D 10 A_CustomMissile("EmpoweredSpiderRail",39)
	BPYT C 5 A_FaceTarget
	BPYT D 10 A_CustomMissile("EmpoweredSpiderRail",39)
	Goto See
  Pain:
	BPYT E 6 A_Pain
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See
  Death:	
	TNT1 A 0 A_Scream
	BPYT E 20 A_Fall
    TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	BPYT FFFFF 2 A_CustomMissile("EmpoweredKaboomSpawner", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    BPYT GGGGG 2 A_CustomMissile("EmpoweredKaboomSpawner", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BPYT HHHHH 2 A_CustomMissile("EmpoweredKaboomSpawner", frandom(10,60), random(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BPYT IIIII 2 A_CustomMissile("EmpoweredKaboomSpawner", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	BPYT J 5
	Stop
  }
}

Actor EmpoweredSpiderBFG9500Ball : EmpoweredCacoBFG9500Ball
{
  Species "Masterminds"
  DamageType "DarkDemoEx"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("PoweredBFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("KaboomBlue",0,0,random(0,360),CMF_AIMDIRECTION,frandom(0,360))
	PFE3 AB 4 Bright A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PFE3 CC 2 Bright A_BFGSpray("EmpoweredSpiderSpray",15,15)
	PFE3 DEF 4 Bright
	Stop	
    }
}

Actor EmpoweredSpiderSpray : PoweredCustomSpray
{
  Species "Masterminds"
  Species "DarkDemoEx"
  +MTHRUSPECIES
  +DONTHARMSPECIES
}

Actor EmpoweredSpiderBFG15KBall : EmpoweredCacoBFG15KBall { DamageType "DarkDemoEx" }

Actor EmpoweredSpiderRail : EmpoweredDarkCyberRail { DamageType "DarkDemoEx" }

Actor EmpoweredSentientFireSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("OverSeerFire",frandom(50,70),frandom(50,70),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("OverSeerFire",frandom(-70,-50),frandom(-70,-50),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("OverSeerFire",frandom(50,70),frandom(-70,-50),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("OverSeerFire",frandom(-70,-50),frandom(50,70),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("BlueSentientFire",frandom(50,70),frandom(50,70),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueSentientFire",frandom(-70,-50),frandom(-70,-50),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueSentientFire",frandom(50,70),frandom(-70,-50),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueSentientFire",frandom(-70,-50),frandom(50,70),74,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

