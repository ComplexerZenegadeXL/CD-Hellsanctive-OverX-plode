	Goto See
  Pain:
	IWRQ F 4 
	IWRQ F 4 Bright
	TNT1 A 0 A_Jump(100,"Missile","Teleport","Nova")
	TNT1 A 0 A_Jump(30,"Hahahavefun")
	Goto See 
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_Scream
	IWRQ F 20 A_Fall
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", 80, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	IWRQ FF 5
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", 80, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,CMF_AIMDIRECTION,frandom(0,360),0,128)
	TNT1 A 0 A_Playsound("BFlan/LightningExp",7)
	TNT1 AAAAAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, frandom(30,100), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAA 0 A_CustomMissile("Kaboom18",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("RedDTBFGEx",0,0,50)
	TNT1 A 0 Radius_Quake(20,8,0,12,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-40,40),frandom(-40,40),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	IWRQ GHIJ 12
	IWRQ J -1
	Stop
  }
}

