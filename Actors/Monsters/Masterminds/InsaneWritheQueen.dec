	TNT1 A 0 A_CustomMissile("InsanityWRsummoner",20,0,64,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("InsanityWRsummoner",20,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
