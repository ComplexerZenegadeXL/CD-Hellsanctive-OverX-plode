Actor InsaneWritheQueen : Demolisher
{
  Scale 1.5
  Health 10000
  Height 100
  Radius 65
  PainChance 90
  +FLOORCLIP 
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +BOSS
  +NOTIMEFREEZE
  +NOFEAR
  +NOICEDEATH
  +FLOAT
  +NOGRAVITY
  Species "Masterminds"
  MeleeDamage 25
