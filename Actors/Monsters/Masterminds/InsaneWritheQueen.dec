	TNT1 A 0 A_FaceTarget
	IWRQ E 5 Bright A_DualPainAttack("HS")
	TNT1 A 0 A_FaceTarget
	IWRQ E 5 Bright A_DualPainAttack("HS")
	IWRD DBCA 2
	Goto See
