	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_JumpIf(user_loop > 17,8)
	CEMR A 1 Bright A_SpawnItemEx("CMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	CEMR B 1 Bright A_SpawnItemEx("CMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	CEMR C 1 Bright A_SpawnItemEx("CMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
	Loop
	TNT1 A 0
	Stop
  }
}

