Actor Curse
{
  Radius 1
  Height 1
  Speed 15
  RenderStyle Add
  +NOGRAVITY
  +NOBLOCKMAP
  +DONTSPLASH
  +FORCEXYBILLBOARD
  +FLOORHUGGER
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_SpawnItemEx("CurseSphere",0,0,0,0,0,0,0,0)
	BONE B 1 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 15,"Death")
	Loop
  Death:
	TNT1 A 0
	Stop
  }
}

Actor PowerSlowCurse : PowerSpeed { Speed 0.10 }

