  Freeze:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY A 3 Bright A_PlaySound("sentient/laugh")
    TNT1 A 0 A_SpawnItemEx("EWAVE",35,0,0,0)
    SLAY AA 3 Bright A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("EWAVE",35,0,0,0)
	SLAY AA 3 Bright A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("EWAVE",35,0,0,0)
	SLAY AA 3 Bright A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY A 2 A_GiveToTarget("CommanderCurse")
	SLAY A 18
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto Normal
  Pain:
	//TNT1 A 0 A_Jump(20,"PainResurrect")
	TNT1 A 0 A_Jump(10,"Freeze")
	TNT1 A 0 A_Jump(128,"PainMissile")
	COMM A 3 Bright
	COMM A 3 Bright A_Pain	
	Goto See
  PainMissile:
	COMM A 3 Bright
	COMM A 3 Bright A_Pain
	Goto Missile
  PainResurrect:
	COMM A 3 Bright
	COMM A 3 Bright A_Pain	
	COMM A 12 Bright 
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",1000)
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    SLAY A 3 Bright A_PlaySound("Commander/Laugh")
    TNT1 A 0 A_GiveInventory("SmallCommanderMassResurrectionItem")
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY A 3 Bright 
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY A 3 Bright 
    TNT1 A 0 A_GiveInventory("SmallCommanderMassResurrectionItem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY A 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 12,1)
	Goto PainResurrectLoop
    TNT1 A 0 A_GiveInventory("CommanderMassResurrectionItem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
	PainResurrectLoop2:
	SLAY A 3 Bright A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 12,1)
	Goto PainResurrectLoop2
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	COMM A 3 Bright 
	Goto See	
  Pain.PlayerDBFG10K2:
  Pain.DBFG10K2:
  Pain.DBFG:
  Pain.PlayerDBFG:
  Pain.DBFG2:
  Pain.PlayerDBFG210K:
  Pain.DBFG210K:
  Pain.DBFG2Splash:
