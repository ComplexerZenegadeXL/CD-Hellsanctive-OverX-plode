    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
