  var int user_loop;
  var int user_music;
  Tag "$CFManip"
  States
  {
  Spawn:
	MANP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,15)
	TNT1 A 0 A_SetUserVar("user_script",1)
  Idle:
	MANP AB 4 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIfInventory("RunesCheck",1,2)
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	MANP AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(35,"Evade")
	TNT1 A 0 A_Jump(25,"Teleport")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	MANP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	MANP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Pause:
	MANP ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_SetShootable
	TNT1 A 0 A_Jump(130,"BFG10K","BFG9K","DTBFG10K","ShockWaves","DevastatorCannon")
	TNT1 A 0 A_Jump(80,"Minions","Illusion")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    MANP ABA 2 Bright A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    MANP K 1 A_CustomMissile("ManipulatorExplosiveTracer",16,-10,frandom(-8,8),0)
    MANP K 1 Bright A_CustomMissile("ManipulatorExplosiveTracer",16,10,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    MANP K 1 A_CustomMissile("ManipulatorExplosiveTracer",16,-10,frandom(-8,8),0)
    MANP K 1 Bright A_CustomMissile("ManipulatorExplosiveTracer",16,10,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_Jump(16,"Pause","BFG10K","ShockWaves")
    TNT1 A 0 A_SpidRefire
    Goto Normal+4
  BFG10K:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    MANP CCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile", 0)
  BFG10KLoop:
    TNT1 A 0 A_JumpIf(user_missile >= 20,"BFG10KEnd")	 
    TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    MANP D 0 A_CustomMissile("Manipulator10K",20,0,frandom(-4,4)) 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	MANP D 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	MANP C 2 Bright A_FaceTarget
	Loop
  BFG10KEnd:
    MANP C 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	MANP C 18 Bright 
	TNT1 A 0 A_Jump(80,"Shockwaves")
    Goto See
  BFG9K:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
    MANP C 28 Bright A_FaceTarget
    MANP D 2 Bright A_FaceTarget
    MANP D 2 Bright A_CustomMissile("CommanderBFG9500Ball",20,0,0) 
	TNT1 A 0 A_PlaySound("weapons/bfgf")
    MANP C 28 Bright A_FaceTarget
    MANP D 2 Bright A_FaceTarget
    MANP D 2 Bright A_CustomMissile("CommanderBFG9500Ball",20,0,0) 
	MANP C 18 Bright 
	TNT1 A 0 A_Jump(80,"Shockwaves")
    Goto See
  DTBFG10K:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    MANP CCCCCCC 4 Bright A_FaceTarget
    MANP D 2 Bright A_FaceTarget
    MANP D 2 Bright A_CustomMissile("CommanderPurpleDTBFG10KBall",20,0,0) 
	MANP C 18 Bright 
	TNT1 A 0 A_Jump(32,"Shockwaves")
    Goto See
  Illusion:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_PlaySound("Manipulator/laugh")
	MANP VVVVVVVVVVV 4 Bright A_FaceTarget
	MANP VVV 4 A_SpawnItemex("ManipulatorIllusion",0,0,0,0,0,0,0,SXF_SETMASTER)
	Goto See
  Shockwaves:
    TNT1 A 0 A_FadeIn(1.0)
	MANP VVVVV 4 Bright A_FaceTarget
	MANP VVVVVVVVVVVVVVVVVVVV 1 Bright A_CustomMissile("MBrainwave",35,0,frandom(-20,20),0)
	MANP V 8
	Goto See
  DevastatorCannon:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_PlaySound("weapons/charge15k")
    MANP CC 4 Bright A_FaceTarget
	MANP CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDC 1 A_CustomMissile("ManipulatorDevastatorBall2",20,0,frandom(-10,10),1)
    Goto See
  Minions:
    TNT1 A 0 A_FadeIn(1.0)
    MANP V 1 Bright A_ChangeFlag(Invulnerable,1)
	TNT1 A 0 A_PlaySound("Manipulator/laugh")
	MANP VVVVVVVVVVVVVVVVV 2 Bright A_CustomMissile("MWave",35,0,0,0)
	TNT1 A 0 A_ChangeFlag(Reflective,1)
	TNT1 A 0 A_SpawnItemEx("BabySentientSummoner",0,0,0,10,0,0,180,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BabysentientSummoner",0,0,0,10,0,0,305,SXF_SETMASTER)
	MANP V 25 Bright 
	TNT1 A 0 A_ChangeFlag(Invulnerable,0)
	TNT1 A 0 A_ChangeFlag(Reflective,0)
	Goto See
  Pain:
    TNT1 A 0 A_FadeIn(1.0)
    //TNT1 A 0 A_Jump(30,"PainResurrect")
    TNT1 A 0 A_Jump(120,"PainMissile")
    MANP A 3 Bright A_Pain
	MANP A 3 Bright
    Goto See
  Teleport:
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    MANP V 14 Bright
	MANP V 3 Bright
	TNT1 A 0 A_FadeTo(0.05,1.0)
	//TNT1 A 0 A_PlaySound("BH/Fire",0)
	TNT1 A 0 A_SpawnItemEx("ManpTeleportFXSpawner",0,0,62)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	MANP V 4 Bright
	//TNT1 A 0 A_PlaySound("DMBall/Impact",0)
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SpawnItemEx("ManpTeleportFXSpawner",0,0,62)
	MANP V 10
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  PainMissile:
    MANP A 3 Bright A_Pain
	MANP A 3 Bright
    Goto Missile
  PainResurrect:
	MANP A 3 Bright
	MANP A 3 Bright A_Pain	
	MANP AAAA 3 Bright 
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",500)
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    MANP V 3 Bright A_PlaySound("Manipulator/Laugh")
    TNT1 A 0 A_GiveInventory("SmallCommanderMassResurrectionItem")
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright 
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright 
    TNT1 A 0 A_GiveInventory("SmallCommanderMassResurrectionItem")
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright 
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright 	
    TNT1 A 0 A_GiveInventory("CommanderMassResurrectionItem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto PainResurrectLoop
    TNT1 A 0 A_GiveInventory("CommanderMassResurrectionItem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_SpawnItemEx("ManipulatorBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	MANP V 3 Bright
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 12,1)
	Goto PainResurrectLoop2
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	MANP A 3 Bright 
	Goto See
  Death:
    MANP A 20 Bright A_Scream
    MANP E 6 Bright A_Fall
	TNT1 AA 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MANP FFFFFFFFF 2 Bright A_CustomMissile("CommKaboom", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("PurpleSmokeFX1", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("PurpleDBFGBoltExp",0,0,40)
	MANP GGGGGGGGG 2 Bright A_CustomMissile("CommKaboom", frandom(20,40), frandom(-10,-10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("PurpleSmokeFX1", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MANP HHHHHHHHH 2 Bright A_CustomMissile("CommKaboom", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("PurpleSmokeFX1", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    MANP I 4
	MANP J 2
    Stop
  }
}

Actor ManipulatorIllusion : RMManipulator
{
  Health 3000
  Alpha 0.65
  DamageFactor 4.28
  RenderStyle Translucent
  SeeSound "barachnophyte/sight"
  PainSound "barachnophyte/pain"
  DeathSound "barachnophyte/death"
  Obituary "$CFManipulatorIllusionObit"
  -BOSS
  +THRUSPECIES
  -COUNTKILL
  DropItem "BossLifeEssence" 100 25
  DropItem "BossArmorBonusMax" 100 1
  States
  {
  Spawn:
	MANP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,15)
	TNT1 A 0 A_SetUserVar("user_script",1)
  SpawnLoop:
	MANP AB 2 Bright A_Look
    Loop
  See:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	MANP AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Evade")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	MANP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	MANP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Pause:
	MANP ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_Jump(100,"ShockWave")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    MANP ABA 2 Bright A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    MANP K 2 Bright A_CustomMissile("ManipulatorExplosiveTracer",16,0,frandom(-8,8),0)
    MANP K 2 Bright 
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    MANP L 2 Bright A_CustomMissile("ManipulatorExplosiveTracer",16,0,frandom(-8,8),0)
	MANP L 2 Bright 
	TNT1 A 0 A_Jump(16,"Pause","Shockwave")
    TNT1 A 0 A_SpidRefire
    Goto Normal+6
   Shockwave:
	MANP VVVV 4 Bright A_FaceTarget
	MANP VV 1 Bright A_CustomMissile("MBrainwave",35,0,frandom(-5,5),0)
	MANP V 8
	Goto See
  Pain:
    MANP A 3 Bright A_Pain
	MANP A 3 Bright
    Goto See
  Death:
    MANP A 20 Bright A_Scream
    MANP E 6 Bright A_Fall
	MANP F 6 Bright
	MANP G 2 Bright
    MANP H 6 Bright
    MANP I 4
	MANP J 2
    Stop
  }
}

Actor ManipulatorSmokeSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire2")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("ManipulatorSmoke",frandom(32,42),frandom(32,42),48,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("ManipulatorSmoke",frandom(-32,-42),frandom(-32,-42),48,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("ManipulatorSmoke",frandom(32,42),frandom(-32,-42),48,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("ManipulatorSmoke",frandom(-32,-42),frandom(32,42),48,0,0,frandom(-6,-4),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

