Actor CommanderMassResurrectionEffect
{
  Height 6
  Radius 6
  Damage 0
  RenderStyle Add
  Alpha 0.5
  Scale 0.5
  Projectile
  +FLOORHUGGER
  +NOTIMEFREEZE
  +NOCLIP
  Speed 25
