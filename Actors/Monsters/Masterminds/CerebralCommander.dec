Actor MBrainWave
{
  Radius 12
  Height 12
  Speed 55
  Damage (Random(20,50))
  Scale 0.8
  +EXTREMEDEATH
  +DONTREFLECT
  +NOTIMEFREEZE
  Projectile
  Species "Masterminds"
  DamageType "DemolisherEx"
  Renderstyle Add
  SeeSound "Commander/fire"
  DeathSound "weapons/bfg95explode"
  Obituary "$CFMBrainWaveObit"
