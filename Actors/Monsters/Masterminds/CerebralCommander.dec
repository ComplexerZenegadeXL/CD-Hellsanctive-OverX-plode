Actor CommanderPlasmaBlast
{
  Radius 13
  Height 13
  Speed 35
  FastSpeed 45
  Damage (Random(25,55)) //9
  Projectile
  Species "Masterminds"
  DamageType "DemolisherEx"
  Scale 0.9
  +RANDOMIZE
  +BLOODLESSIMPACT
  +SEEKERMISSILE
  +NOEXTREMEDEATH
  RenderStyle Add
  Alpha 0.75
  SeeSound "electricplasma/shoot"
  DeathSound "electricplasma/hit"
  Decal ImpFireBall
  States
  {
  Spawn:
    CBLT GH 0 A_CustomMissile("CommanderPlasmaBlastTrail",0,0,0)
    CBLT GH 2 Bright A_SeekerMissile(20,20)
    Loop
  Death:
  	TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    CBLT IJK 3 Bright
    Stop
  }
}

Actor CommanderPlasmaBlastTrail
{
  Radius 13
  Height 8
  Speed 0
  Damage 0
  Projectile
  +RANDOMIZE
  +CLIENTSIDEONLY
  RenderStyle Add
  Alpha 0.75
  States
  {
  Spawn:
    TNT1 A 0
    CBLT ABC 3 Bright A_BishopMissileWeave
    Goto Death
  Death:
    CBLT DEF 4 Bright A_FadeOut(0.25)
    Loop
  }
}

Actor CommanderHomingPlasmaBlast
{
  +SEEKERMISSILE
  States
  {
  Spawn:
    CBLT GH 0 A_CustomMissile("CommanderPlasmaBlastTrail",0,0,0)
	TNT1 A 0 a_SeekerMissile(10, 10)
    CBLT GH 2 Bright A_BishopMissileWeave
    Loop
  }
}

Actor CommanderAntiMatterMissile : FastProjectile 
{
  Radius 3
  Height 3
  Speed 90
  FastSpeed 105
  Renderstyle Add
  Scale 1.2
  Damage (Random(300,450))//90
  Projectile
  SeeSound "coantimatter/fire"
  DeathSound "coantimatter/boom"
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +FOILINVUL
  +NOTIMEFREEZE
  +DONTREFLECT
  Species "Masterminds"
  DamageType "DemolisherEx"
  MissileType "CommanderAntiMatterTrailSpawner"
  MissileHeight 8
  States
  {
  Spawn:
	C3PP ABCDEF 1 Bright
	Loop
  Death:
	TNT1 A 0 A_Explode(208,400,0)
	TNT1 A 0 A_SpawnItemEx("CommanderAntiMatterBoomFlash",0,0,0, 0,0,0) 
	TNT1 AAAAAA 0 A_SpawnItemEx("CommanderAntiMatterBoom1",0,0,30, frandom(-5,5),frandom(-8,8),frandom(0,7)) 
	TNT1 AA 0 A_SpawnItemEx("CommanderAntiMatterBoom2",0,0,0, 0,0,0)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("CommanderAntiMatterBoomSmoke",0,0,0, frandom(-4,4),frandom(-4,4), frandom(-4,4), frandom(180,360), 0)
	TNT1 A 20
	Stop
  }
}

Actor CommanderAntiMatterTrailSpawner
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0 
	TNT1 A 0 A_SpawnItemEx("CommanderAntiMatterTrailCore",-3,0,0, 0,0,0) 
	TNT1 A 0 A_SpawnItemEx("CommanderAntiMatterTrail1",-7,0,0, 0,frandom(-0.5,0.5),frandom(-0.5,0.5)) 
	TNT1 A 0 A_SpawnItemEx("CommanderAntiMatterTrail2",-7,0,0, 0,frandom(-2.5,2.5),frandom(-2.5,2.5)) 
	Stop
  }
}

