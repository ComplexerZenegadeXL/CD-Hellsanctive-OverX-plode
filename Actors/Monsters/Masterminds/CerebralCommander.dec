	TNT1 A 0
	L2NP A 6 Bright
	L2NP AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_FadeOut(0.04)
	Stop
  }
}


Actor CebComStrafe : CustomInventory
{
  +INVENTORY.QUIET
  +INVENTORY.UNDROPPABLE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.AUTOACTIVATE       
  +COUNTITEM
  +NOTIMEFREEZE
  Inventory.MaxAmount 0
  States
  {
  Pickup:
	TNT1 A 0 A_ChangeVelocity(velx/2,vely/2,velz,CVF_REPLACE)
	TNT1 A 0 A_JumpIf(velx != 0 || vely != 0,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(235,5)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 A_GiveInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 A_TakeInventory("LegSentientStrafeSens",1)
	TNT1 A 0 A_JumpIfInventory("LegSentientStrafeSens",1,3)
	TNT1 A 0 ThrustThing(angle*256/360+38.7,10,0,0)
	TNT1 A 0 A_Jump(256,2)	
	TNT1 A 0 ThrustThing(angle*256/360+38.7,-10,0,0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(24,2)
	TNT1 A 0 A_Recoil(-1)
    Stop
	TNT1 A 0 A_Recoil(1)
    Stop
  }
}

Actor CommanderSlowball : PhaseImpBall
{
  Damage (Random(40,70))//15
  Species "Masterminds"
  DamageType "DemolisherEx"
  Speed 8
  States
  {
  Spawn:
    TNT1 A 0 A_SeekerMissile(20, 20)
	PFRT AA 1 Bright A_SpawnItemEx("phaseballtrail2")
	TNT1 A 0 A_Weave(1.0, 1.0, 5.0, 1.0)
	PFRT BB 1 Bright A_SpawnItemEx("phaseballtrail2")
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom8", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_Jump(192,2)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck", 96, RGF_PLAYERS)
    PFRT CDEFG 2 Bright
    Stop
  }
}

