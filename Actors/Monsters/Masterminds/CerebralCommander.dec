  States
  {
  Spawn:
    CBTS ABCDEFGHIJ 2 Bright A_SpawnItemEx("MWAVE")
    Loop
  Death:
	CBTS LMNOPQRSTUVW 2 Bright A_SpawnItemEx("MWAVE2")
	Stop
  }
}

