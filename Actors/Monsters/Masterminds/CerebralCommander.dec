	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CPS1 B 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(3,5)
    CPS1 C 1 Bright A_CustomMissile("CebComDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurple2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE)
    CPS1 D 1 Bright A_SpawnItemEx("ProjectileTrailParticlePurple2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Goto SpawnLoop  
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("DTBFG10KTracerPurple",0,0,10 * user_loop,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningPurpleSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	CPS1 ABCD 6 Bright A_SpawnItemEx("PurpleDTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
