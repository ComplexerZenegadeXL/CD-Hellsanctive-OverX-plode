Actor EmpoweredBrainwave
{
  Radius 20
  Height 20
  Speed 80
  Damage (Random(300,500)) //100
  Scale 1.6
  +EXTREMEDEATH
  +DONTREFLECT
  +SEEKERMISSILE
  +FOILINVUL
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Projectile
  Species "Masterminds"
  DamageType "DemolisherEx"
  Renderstyle Add
  SeeSound "Commander/fire"
  DeathSound "weapons/bfg95explode"
  Obituary "$CFEmpoweredBrainwaveObit"
  Decal "BFG9500LightningPurple"
  var int user_loop;
  States
  {
  Spawn:
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS A 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS B 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS C 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS D 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS E 2 Bright A_SpawnItemEx("EWAVE")	
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS F 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS G 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS H 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS I 2 Bright A_SpawnItemEx("EWAVE")
	CBTS A 0 A_SeekerMissile(15,0)
    CBTS J 2 Bright A_SpawnItemEx("EWAVE")
    Loop
  Death:
	CBTS K 0 Radius_Quake(15,15,0,40,0)
	CBTS K 2 Bright A_Explode(600,600)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
  DeathLoop:
    TNT1 A 0 A_CustomMissile("DTBFG10KTracerPurple",0,0,0, 10 * user_loop,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 35,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DevastatorLightningPurpleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	TNT1 A 0 A_Explode(80,256)
	CBTS A 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CBTS B 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CBTS C 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	CBTS D 6 Bright A_SpawnItemEx("PurpleDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 3,1)
	Loop
	TNT1 A 0 A_Explode(128,1024,0)
	TNT1 A 0 A_Explode(460,640,0)
	TNT1 A 0 A_Explode(618,256)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("PurpleDevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PurpleDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 AAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("CommanderBouncyBrainwave",0,0,frandom(0,360),0,frandom(-5,30))
    TNT1 A 0 A_SpawnItemEx("PurpleDTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, 128)
    TNT1 A 20 A_SpawnItemEx("PurpleDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    CBTS LMNOPQRSTUVW 2 Bright
    Stop
  }
}

