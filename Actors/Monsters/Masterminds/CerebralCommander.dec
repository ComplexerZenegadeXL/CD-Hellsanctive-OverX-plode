Actor CerebralCommanderIllusion 
{
  Obituary "$CFCerebralCommanderIllusionObit"
  Tag "$CFCerComm"
  Alpha 0.65
  RenderStyle Translucent
  Health 500
  Monster
  Species "Masterminds"
  Speed 18
  FloatSpeed 18
  PainChance 20
  Scale 1.1
  Radius 65
  Height 100
  DamageFactor "C0mm4nder", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Mass 99999
  +NOPAIN
  +THRUACTORS
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  -COUNTKILL
  +NOGRAVITY
  +FLOAT
  var int user_script;
  var int user_missile;
  States
  {
  Spawn:
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,11)
	TNT1 A 0 A_SetUserVar("user_script",1)
  MissileLoop:
    TNT1 A 0 A_JumpIf(user_missile >= 15,"MissileEnd")	 
    TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	COM2 D 3 Bright A_CustomMissile("Commander10K", 42, 0, frandom(-2,2))
	TNT1 A 0 
    Loop
  MissileEnd:
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	COM2 D 3 Bright A_CustomMissile("Commander10K", 42, 0, frandom(-2,2))
  Death:
    SLAY AAAAAAA 2 A_Fadeout
	Stop	
  }
}

