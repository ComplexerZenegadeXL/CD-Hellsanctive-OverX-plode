	TNT1 A 0 A_SpawnItemEx("PyroCannonGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BlackHoleGeneratorGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechShotgunGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("CommanderDevUpgrade",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("SkullOfPowerGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("DemonicChaliceGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,128)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,40)
	TNT1 A 0 A_Scream
	TNT1 A 0 A_Fall
	TNT1 A 0 A_KillChildren
	TNT1 A 0 A_ChangeFlag(Nogravity,1)
	TNT1 A 0 A_ChangeFlag(float,1)
    SLAY A 40 A_FaceTarget
	SLAY AAA 4 A_SpawnItemEx("CerebralCommanderIllusion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_HideThing
	TNT1 A 0 A_PlaySound("DMBall/Impact",0,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SpawnItemEx("CommTeleportFXSpawner",0,0,62)	
