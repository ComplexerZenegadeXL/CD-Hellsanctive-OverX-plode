Actor CommanderPulse
{
  Radius 12
  Height 12
  Speed 0
  Scale 5.2
  Projectile
  RenderStyle Add
  +SEEKERMISSILE
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +DONTREFLECT
  +FOILINVUL
  +BRIGHT
  Species "Masterminds"
  DamageType "DemolisherEx"
  Alpha 0.8
  SeeSound "star/explode"
  Obituary "$CFCommanderPulseObit"
  States
  {
  Spawn:
	TNT1 A 0 A_Explode(656,656,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("PurpleDTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItemEx("PurpleDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ZZTR ABCD 3 Bright
	ZZTR E 3 Bright A_BFGSpray("PurpleSpray",15,20)
    ZZTR FGHIJKLMNO 3 Bright
    Stop
  }
}

