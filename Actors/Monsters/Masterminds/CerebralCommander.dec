Actor CerebralCommander : Demolisher 21306
{
  Health 15000
  Speed 24
  FloatSpeed 24
  PainChance 20
  Scale 1.1
  Radius 65
  Height 100
  BloodColor "Purple"
  DropItem "BossLifeEssence" 256
  DropItem "BossArmorBonusMax" 256
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "HellfireUltrasphere" 128
  DropItem "PhaseSphere"
  DropItem "BigGasPickup" 256 100
  DropItem "HSBFGupgrade" 256
  Mass 99999
  +QUICKTORETALIATE
  +LOOKALLAROUND
  +FLOAT
  +BOSS
  +NOEXTREMEDEATH
  +BOSSDEATH
  +NOGRAVITY	
  -FLOORCLIP
  +DONTHARMSPECIES
  +NORADIUSDMG
  +NOICEDEATH
  +NOTARGET
  +CANTSEEK
  +NOFEAR
  +DONTSPLASH
  +NOTIMEFREEZE
  +NOTELEFRAG
  +DONTGIB
  +DONTMORPH
  +DONTRIP
  +THRUSPECIES
  AttackSound ""
  DamageFactor 0.5
  DamageFactor "PlayerFireSword", 1.1
  DamageFactor "PlayerDTRG", 0.01
  DamageFactor "DTRailgun", 0.01
  DamageFactor "PDTPuff", 0.01
  DamageFactor "RailG", 0.01
  DamageFactor "PlayerBHole", 0.25
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.2
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "CustomSpray", 0.0
  DamageFactor "BFG9500Ball", 0.0
  DamageFactor "PlayerPyro", 0.15
  DamageFactor "C0mm4nder", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.0
  DamageFactor "BFG10K", 0.65
  DamageFactor "BFGSplash", 0.0
  DamageFactor "BFGSpray", 0.0
  DamageFactor "PlayerDevBall", 0.020
  DamageFactor "PlayerDevBall2", 0.020
  DamageFactor "PlayerDevTracer", 0.020
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Railg", 0.5
  DamageFactor "DiscoBFG", 0.55
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  // no infight 4 u
  DamageFactor "Baby15K", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "T3rm", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  SeeSound "Commander/sight"
  PainSound "Commander/pain"
  DeathSound "Commander/Laugh"
  PainChance "BFG9500Ball", 40
  PainChance "PlayerDevBall", 100
  PainChance "BFG10K", 100
  PainChance  "PDTBFG", 100
  PainChance "PlayerDBFG10K2", 100
  PainChance "Legendary", 100 // 100
  PainChance "LegendaryPlayer", 100 // 100
  PainChance "LegendaryGuru", 256
  PainChance "LegendaryGuruPlayer", 256
  PainChance "PlayerDBFG2", 256
  DamageFactor "DBFG10K2", 0.2
  DamageFactor "PlayerDBFG10K2", 0.2
  DamageFactor "DBFG2", 0.2
  DamageFactor "PlayerDBFG2", 0.2
  DamageFactor "HellComet", 0.4
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "Explosion", 0.1
  MinMissileChance 200
  Species "Masterminds"
  Obituary "$CFCerebralCommanderObit"
  Tag "$CFCerComm"
  var int user_manipulator;
  var int user_Illusion;
  var int user_Illusion2;
  var int user_summon;
  var int user_bfg10k;
  var int user_missile;
  var int user_music;
  var int user_script;
  var int user_script_type;
  var int user_dbfg;
  var int user_devcharge;
  var int user_lowlag;
  States
  {
  Spawn:
    COMM A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,11)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",10)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	COMM AB 4 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	COMM AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_dbfg == 1, "see2")
    TNT1 A 0 A_JumpIfHealthLower(7500,"DBFGUpgrade")
	TNT1 A 0 ACS_NamedExecuteWithResult("CFRuneCheck",1)
	TNT1 A 0 A_JumpIf(user_music == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,605)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,2,1)
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	COMM AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(35,"Evade")	
	TNT1 A 0 A_Jump(20,"Teleport")
	Loop
  See2:
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,605)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,2,1)
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	COMM AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(45,"Evade")	
	TNT1 A 0 A_Jump(20,"Teleport")
	Loop
  Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	COMM ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	COMM ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
    TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnSetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(130,"BFG9K","BFG10K","DTBFG10K","DTDevastator","CommanderPlasmaBlast","MiniBrainwaves","PyroCannon","MiniIllusion","DarkMatter","SlowDeath","BrainWave","AntiMatter")
	TNT1 A 0 A_Jump(60,"Illusion","Illusion2","Freeze")
	TNT1 A 0 A_Jump(40,"SummonManipulator")
	//TNT1 A 0 A_Jump(10,"VoidFrenzy")
  Normal:
	COMM ABA 1 Bright A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	COMM D 0 A_CustomMissile("CommanderExplosiveTracer",36,0,frandom(-8,8),0)
	COMM D 1 Bright A_CustomMissile("CommanderExplosiveTracer",36,0,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
    TNT1 A 0 A_SpawnItemEx("PurpleShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COMM C 0 A_CustomMissile("CommanderExplosiveTracer",36,0,frandom(-8,8),0)
	COMM C 1 Bright A_CustomMissile("CommanderExplosiveTracer",36,0,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(16,"CommanderPlasmaBlast","DarkMatter","MiniBrainwaves","SlowDeath","BFG9K","BFG10K","DTBFG10K")
    TNT1 A 0 A_SpidRefire
	Goto Normal+4
  DarkMatter:
	TNT1 A 0 
	COMM ABA 2 Bright A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	COMM D 0 A_CustomMissile("CommanderDarkMatterball",36,0,frandom(-8,8),0)
	COMM D 3 Bright A_CustomMissile("CommanderDarkMatterball2",36,0,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	COMM C 0 Bright A_CustomMissile("CommanderDarkMatterball",36,0,frandom(-8,8),0)
	COMM C 3 Bright A_CustomMissile("CommanderDarkMatterball2",36,0,frandom(-8,8),0)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(4,"DTBFG10K","DTDevastator","MiniBrainwaves","Brainwave","AntiMatter")
    TNT1 A 0 A_SpidRefire
	Goto DarkMatter+4
  DBFGUpgrade:
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    TNT1 A 0 A_PlaySound("Commander/Laugh")
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	TNT1 A 0 A_SetUserVar("user_dbfg",1)
	TNT1 A 0 A_GiveInventory("CommanderDBFGUpgrade",1)
	TNT1 A 0 A_ChangeFlag(ALWAYSFAST,1)
	COMM A 30 Bright A_FaceTarget	
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("DMBall/Impact",0,1.0,0,ATTN_NONE)
    SLAY A 25 Bright A_SpawnItemEx("BlackDeathSequence",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  SlowDeath:
	COMM A 3 Bright
	COMM A 3 Bright A_FaceTarget	
	COMM AAAA 3 Bright 
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 Bright A_CustomMissile("CommanderSlowball",120,0,frandom(0,360))
	SLAY A 15 Bright
	Goto See
  MiniIllusion:
    TNT1 A 0 A_PlaySound("Commander/Laugh")
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY AAAAAAAAAAAAA 4 Bright A_FaceTarget
	SLAY AAA 4 A_SpawnItemEx("CerebralCommanderIllusion",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Illusion:
    TNT1 A 0 A_PlaySound("Commander/Laugh")
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY AAAAAAAAAAAAA 4 Bright A_FaceTarget
	SLAY AAAAAA 1 A_SpawnItemEx("CerebralCommanderIllusion",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Illusion2:
    TNT1 A 0 A_PlaySound("Commander/Laugh")
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY AAAAAAAAAAAAA 4 Bright A_FaceTarget
	SLAY AAAAAAAAA 1 A_SpawnItemEx("CerebralCommanderIllusion",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  SummonManipulator:
    TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_PlaySound("Commander/Laugh")
    TNT1 A 0 A_JumpIf(user_manipulator >= 10,"Illusion2")	 
    TNT1 A 0 A_SetUserVar("user_manipulator",user_manipulator+1)
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY AAAAAAAAAAAAA 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CommanderPulse")
	SLAY A 4 A_SpawnItemEx("RMManipulator",0,0,0,0,0,0,frandom(-300,300),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  BFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CC 1 Bright A_FaceTarget
	COM2 DDD 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, frandom(-10,10))
	COM2 D 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, 0)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	COM2 CC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCC 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 4 Bright A_FaceTarget
	COM2 C 2 Bright A_FaceTarget
	COM2 DDD 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, frandom(-10,10))
	COM2 D 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, 0)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 2 Bright A_FaceTarget
	COM2 DDD 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, frandom(-10,10))
	COM2 D 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, 0)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCC 4 Bright A_FaceTarget
	COM2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 2 Bright A_FaceTarget
	COM2 DDD 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, frandom(-10,10))
	COM2 D 1 Bright A_CustomMissile("CommanderBFG9500Ball", 34, 0, 0)
	COM2 C 14 Bright 
	TNT1 A 0 A_Jump(128,"DarkMatter","SlowDeath","BFG10K","DTBFG10K","PyroCannon","MiniBrainwaves")
	Goto See
  BFG10K:
	TNT1 A 0 A_JumpIfInventory("CommanderDBFGUpgrade",1,"UpgradedBFG10K")
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_bfg10k", 0)
	COM2 C 6 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 3 Bright A_FaceTarget
	TNT1 A 0 
  BFG10KLoop:
    TNT1 A 0 A_JumpIf(user_bfg10k >= 30,"BFG10KEnd")	 
    TNT1 A 0 A_SetUserVar("user_bfg10k",user_bfg10k+1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 1 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	COM2 D 1 Bright A_CustomMissile("Commander10K", 42, 0, frandom(-2,2))
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
    Loop
  BFG10KEnd:
	COM2 C 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	COM2 C 15 Bright 	
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See
  MiniBrainwaves:
	SLAY AAAAABB 2 Bright A_FaceTarget
	SLAY CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDC 1 Bright A_CustomMissile("MiniBrainwave",75,0,frandom(-30,30),0)
	SLAY BBB 2 
	goto See
  UpgradedBFG10K:
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_PlaySound("Commander/Laugh")
	TNT1 A 0 A_SetUserVar("user_bfg10k", 0)
	COM2 C 6 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 3 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 3 Bright A_FaceTarget
	TNT1 A 0 
  UpgradedBFG10KLoop:
    TNT1 A 0 A_JumpIf(user_bfg10k >= 80,"UpgradedBFG10KEnd")	 
    TNT1 A 0 A_SetUserVar("user_bfg10k",user_bfg10k+1)
    TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 1 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Commander10K", 42, 0, frandom(-8,8))
	COM2 D 1 Bright A_CustomMissile("Commander10K", 42, 0, frandom(-3,3))
	TNT1 A 0 A_CheckSight(3)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
    Loop
  UpgradedBFG10KEnd:
	COM2 C 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	COM2 C 15 Bright 	
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See
  CommanderPlasmaBlast:
	SLAY AAAAAA 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile", 0)
  PlasmaBlastLoop:
    TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 A 0 A_JumpIf(user_missile > 20,"PlasmaBlastStop")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
    SLAY A 0 A_FaceTarget
    SLAY A 0 A_CustomMissile("CommanderPlasmaBlast", 100, 0, 90)
    SLAY A 3 Bright A_CustomMissile("CommanderPlasmaBlast", 100, 0, -90)
	Loop
  PlasmaBlastStop:
    SLAY A 6
    SLAY A 6 A_FaceTarget
    SLAY A 24 A_Jump(60,"AntiMatter","DarkMatter","SlowDeath","MiniBrainwaves","BFG9K","BFG10K","DTBFG10K")
    Goto See
  DTBFG10K:
	TNT1 A 0 A_JumpIfInventory("CommanderDBFGUpgrade",1,"UpgradedDTBFG10K")
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 C 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 4 Bright A_FaceTarget
	COM2 DD 4 Bright A_FaceTarget
	COM2 D 2 Bright A_CustomMissile("CommanderPurpleDTBFG10KBall", 34, 0, 0)
	COM2 D 4 Bright 
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 AA 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 AAA 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 BB 4 Bright A_FaceTarget
	COM2 B 2 Bright A_CustomMissile("CommanderPurpleDTBFG10KBall", 34, 0, 0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 AA 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 AAA 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 BB 4 Bright A_FaceTarget
	COM2 B 2 Bright A_CustomMissile("CommanderPurpleDTBFG10KBall", 34, 0, 0)
	COM2 B 2 Bright 
	TNT1 A 0 A_Jump(32,"DTDevastator","AntiMatter")
	Goto See
  UpgradedDTBFG10K:
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 CC 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 4 Bright A_FaceTarget
	COM2 DD 4 Bright A_FaceTarget
	COM2 D 2 Bright A_CustomMissile("UpCommanderPurpleDTBFG10KBall", 34, 0, 0)
	COM2 D 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 AA 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 AAA 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 BB 4 Bright A_FaceTarget
	COM2 B 2 Bright A_CustomMissile("UpCommanderPurpleDTBFG10KBall", 34, 0, 0)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 AA 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 AAA 4 Bright A_FaceTarget	
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 BB 4 Bright A_FaceTarget
	COM2 B 2 Bright A_CustomMissile("UpCommanderPurpleDTBFG10KBall", 34, 0, 0)
	COM2 B 2 Bright 
	TNT1 A 0 A_Jump(32,"DTDevastator","AntiMatter")
	Goto See
  PyroCannon:
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 CC 4 Bright A_FaceTarget
	COM2 D 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 D 4 Bright A_FaceTarget
	COM2 D 2 Bright A_CustomMissile("CommanderPyroShot", 34, 0, 0)
	COM2 D 24 Bright 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_Jump(50,"DTDevastator","BrainWave","AntiMatter")
	Goto See
  DTDevastator:
    TNT1 A 0 A_JumpIfInventory("CommanderDBFGUpgrade",1,"DBFG")
    TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	TNT1 A 0 A_PlaySound("devastator/charge")
	TNT1 A 0 A_SetUserVar("user_devcharge", 0)
	DevCharge:
    TNT1 A 0 A_JumpIf(user_devcharge > 55,"DevFire")
	TNT1 A 0 A_SetUserVar("user_devcharge",user_devcharge+1)
	SLAY A 0 A_CustomMissile("CommanderPlasmaBlast", 100, 0, 90)
    SLAY A 0 A_CustomMissile("CommanderPlasmaBlast", 100, 0, -90)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 
	Loop
  DevFire:
	TNT1 A 0 A_PlaySound("devastator/fire")
	TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	COM2 D 2 Bright A_CustomMissile("CommanderDevastatorBall",34,0,0)
	COM2 C 12 Bright 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	COM2 D 2 Bright A_CustomMissile("CommanderDevastatorBall",34,0,0)
	COM2 C 12 Bright 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 ThrustThing(Angle*256/360+128,15,0,0)
	COM2 D 2 Bright A_CustomMissile("CommanderDevastatorBall",34,0,0)
	COM2 C 12 Bright 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_Jump(110,"BrainWave")
	Goto See
  DBFG:
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge")
	SLAY A 0 A_PlaySound("Commander/laugh")
	TNT1 A 0 A_SetUserVar("user_devcharge", 0)
  DBFGCharge:
    TNT1 A 0 A_JumpIf(user_devcharge > 85,"DBFGFire")
	TNT1 A 0 A_SetUserVar("user_devcharge",user_devcharge+1)
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY A 0 A_CustomMissile("CommanderPlasmaBlast", 90, 0, 90)
    SLAY A 0 A_CustomMissile("CommanderPlasmaBlast", 90, 0, -90)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	Loop
  DBFGFire:
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	COM2 C 1 A_Facetarget
	COM2 D 4 Bright A_CustomMissile("PurpleDBFGBall",34,0,0)
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	COM2 C 1 A_Facetarget
	COM2 D 4 Bright A_CustomMissile("PurpleDBFGBall",34,0,0)
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	COM2 C 1 A_Facetarget
	COM2 D 4 Bright A_CustomMissile("PurpleDBFGBall",34,0,0)
	COM2 C 12 Bright 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_Jump(30,"Overload")
	TNT1 A 0 A_Jump(110,"BrainWave","AntiMatter")
	Goto See
  Overload:
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge")
	SLAY A 0 A_PlaySound("Commander/laugh")
	TNT1 A 0 A_SetUserVar("user_missile", 0)
  OverCharge:
    TNT1 A 0 A_JumpIf(user_missile > 35,"DBFGFire")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	COM2 C 2 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	Loop
  OverFire:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  OverFireLoop:	
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	COM2 D 2 Bright A_CustomMissile("PurpleDBFGBall",34,0,0)
	COM2 CCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto OverFireLoop
	COM2 C 40 Bright 
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	Goto See
  Brainwave:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("Commander/Laugh")
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BrainwaveLoop:
	SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY B 4 Bright A_FaceTarget	
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	SLAY B 4 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("CebComStrafe",1)
	TNT1 A 0 A_SpawnItemEx("CommanderBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
