    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	COM2 A 3 Bright
	TNT1 A 0 A_FadeTo(0.05,1.0)
	TNT1 A 0 A_SpawnItemEx("CommTeleportFXSpawner",0,0,62)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	COM2 A 3 Bright 
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SpawnItemEx("CommTeleportFXSpawner",0,0,62)
