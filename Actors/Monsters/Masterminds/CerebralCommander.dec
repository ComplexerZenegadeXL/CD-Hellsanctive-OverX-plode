Actor CommanderCurse : PowerupGiver
{
  Inventory.MaxAmount 0
  Powerup.Colormap 0.5, 0.0, 0.5
  Powerup.Type "PowerCommanderSuperMindFuck"
  Powerup.Duration -10
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
}