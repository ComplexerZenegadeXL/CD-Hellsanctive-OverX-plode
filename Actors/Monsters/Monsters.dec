Actor SentientMassResurrectionEffect
{
  Height 6
  Radius 6
  Damage 0
  RenderStyle Add
  Alpha 0.5
  Scale 0.5
  Projectile
  +FLOORHUGGER
  +NOCLIP
  Speed 25
  var int user_loop;
  States
 {
  Spawn:
	TNT1 A 10
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop:
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	SEMR A 1 Bright A_SpawnItemEx("SMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	SEMR B 1 Bright A_SpawnItemEx("SMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	SEMR C 1 Bright A_SpawnItemEx("SMRETrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,1)
	Goto SpawnLoop
	TNT1 A 0
	Stop
  }
}

