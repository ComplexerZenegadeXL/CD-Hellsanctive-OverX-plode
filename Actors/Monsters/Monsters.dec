	HFRX B 5 A_GiveInventory("XDeathCheck",1)
	HFRX C 4 A_XScream
	HFRX D 4 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFRX E 3 A_Fall
	HFRX F 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HFRX GH 3
	HFRX I -1 A_KillMaster
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	HFRY TSRQPO 6
	Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	HFRX IHGFEDCBA 5
	Goto See
  }
}

Actor SummonedBaronOfHell : CFBaronOfHell { -COUNTKILL }

Actor BruiserDemon : CFBaronOfHell 21041
{ 
  Health 1250
  PainChance 80
  BloodColor "ff 5f 00"
  DamageFactor "NobleComet", 0.0
  DropItem "LifeEssence" 130
  DropItem "ArmorBonusMax" 130
  MeleeDamage 8
  SeeSound "superbaron/scream"
  PainSound "superbaron/pain"
  ActiveSound "superbaron/act"
  DeathSound "superbaron/death"
  MeleeSound "baron/melee"
  Species "Nobles"
  Scale 1.05
  +DONTHURTSPECIES
  +FASTMELEE
  Obituary "$CFBruiserDemonObit"
  HitObituary "$CFBruiserDemonHitObit"
  Tag "$CFBruiser"
  States
  {
  Spawn:
	FRIT A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	FRIT AA 7 Bright A_Look
	FRII AA 7 Bright A_Look
	Loop
  See:
    FRIT AABB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    FRIT CCDD 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    Loop
  Missile:
	TNT1 A 0 A_Jump(128,"GiantBalls","Comet")
  Normal:
    FRIT EF 6 Bright A_FaceTarget
	FRIT G 1 Bright A_CustomMissile("BBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("BBall", 32, 0, -5)
	FRIT G 5 Bright A_CustomMissile("BBall", 32, 0, 5)
    FRIT HI 6 Bright A_FaceTarget
	FRIT G 1 Bright A_CustomMissile("BBall", 32, 0, 0)
	TNT1 A 0 A_CustomMissile("BBall", 32, 0, -5)
	FRIT G 5 Bright A_CustomMissile("BBall", 32, 0, 5)
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  GiantBalls:
    FRIT EF 6 Bright A_FaceTarget
	FRIT G 5 Bright A_CustomMissile("BBall2", 32, 0, 0)
    FRIT HI 6 Bright A_FaceTarget
	FRIT J 5 Bright A_CustomMissile("BBall2", 32, 0, 0)
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    FRIT KL 7 Bright A_FaceTarget	
	FRIT M 2 Bright A_CustomMissile("Comet", 32, 0, 0)
    TNT1 A 0 A_CustomMissile("Comet", 32, 0, 10)
    FRIT M 4 Bright A_CustomMissile("Comet", 32, 0, -10)
    Goto See
  Melee:
	FRIT EF 8 Bright A_FaceTarget
	FRIT G 7 Bright A_MeleeAttack
	Goto See
  Pain:
	TNT1 A 0 A_Jump(61,"MissilePain")
	FRIT N 4 Bright A_Pain
	Goto See
  MissilePain:
    FRIT N 4 Bright A_Pain
    Goto Missile
  XDeath:
  Death: 
    FRID A 7 Bright
    FRID B 6 Bright A_Scream 
    FRID D 5 Bright A_Fall 
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    FRID EFGHIJKL 4 Bright A_SpawnItemEx("OrangeParticleSpawner", frandom(-10,10), frandom(-10,10), frandom(30,60), 0, 0, 0, 0, SXF_CLIENTSIDE)	
    FRID MNOP 4
	FRID QRST 3
    FRID V 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FRID W -1
    Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	FRID VUTSRQP 2
	FRID ONMLKJIHGFEDCBA 2 Bright
	Goto See
  }
}

