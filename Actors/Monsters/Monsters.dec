	TNT1 A 0 A_Jump(64,"See")
	PHNT AAC 2 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 A_PlaySound("monster/psoattack",CHAN_VOICE,1.0,0)
	PHNT C 2 Bright A_Recoil(-24) //A_SkullAttack(24)
	TNT1 A 0 A_CustomMissile("PinkyLunge",0,0,0,CMF_AIMDIRECTION)
    PHNT CDDD 2 Bright A_SpawnItemEx("PoisonSoulCloud",frandom(-8,8),frandom(-8,8),frandom(2,16),frandom(-4,-2),0,frandom(-1,1),frandom(-20,20),0)
	PHNT D 2 Bright A_ScaleVelocity(0.2)
	PHNT C 2 A_ChangeFlag(SLIDESONWALLS,0)
	PHNT C 2 Bright A_ScaleVelocity(0)
	PHNT C 2 Bright
    Goto See //Goto Missile + 4
  Pain:
	PHNT E 3 Bright A_Pain
	PHNT E 3 Bright
	Goto See
  Death:
	PHNT F 4 Bright A_NoGravity
	PHNT G 4 Bright A_Scream
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	PHNT H 4 Bright
	PHNT I 4 Bright A_Fall
    TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAA 0 A_SpawnItemEx("PSoulDeathCloud",0,0,4,frandom(-2,2),frandom(-2,2),frandom(-4,4),0,SXF_SETMASTER)	
	PHNT JK 4
    Stop
  }
}

