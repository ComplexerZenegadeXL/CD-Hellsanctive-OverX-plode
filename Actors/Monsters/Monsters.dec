  Idle:
	RICT A 2 Bright A_Look
	Loop
  See:
	RICT A 2 Bright A_Chase
	Loop
  Missile:
	RICT A 4 Bright A_FaceTarget
	RICT B 2 Bright A_CustomMissile("RictusBall",0,0,0)
    RICT BA 2 Bright
    Goto See
  Normal:
	RICT A 4 Bright A_FaceTarget
	RICT B 2 Bright A_CustomMissile("RictusBall",0,0,0)
    RICT BA 2 Bright
    Goto See
  Kamikaze:
	TNT1 A 0 A_JumpIfCloser(450,1)
	Goto Normal
	TNT1 A 0
	Goto PainSuicide+2
