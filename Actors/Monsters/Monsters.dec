Actor DTechFiend : BullFiend 29789
{ 
  Health 300
  Speed 12
  PainChance 60
  Damage (Random(15,25)) //5
  +MISSILEMORE
  +QUICKTORETALIATE
  -FASTMELEE
  Scale 1.15
  BloodColor "Green"
  SeeSound "blooddemon/sight"
  PainSound "blooddemon/pain"
  DeathSound "blooddemon/death"
  ActiveSound "blooddemon/active"
  AttackSound "cyberfiend/melee"
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "DemonAmmoPickup" 128 120
  Obituary "$CFDTechFiendObit"
  HitObituary "$CFDTechFiendHitObit"
  Tag "$CFDtFiend"
  var int user_lowlag;
  States 
  { 
  Spawn: 
    DPNK A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DPNK A 12 A_Look
	DPII A 12 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DPNK AABB 2 A_Chase
	TNT1 A 0 A_PlaySound("blooddemon/walk")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(87,"Rush")
	TNT1 A 0 A_PlaySound("blooddemon/walk")
    DPNK AABB 2 A_Chase
    TNT1 A 0 A_PlaySound("blooddemon/walk")
    DPNK CCDD 2 A_Chase
    Loop
  Rush:
    TNT1 A 0 A_PlaySound("blooddemon/walk")
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK B 1 A_Chase
    TNT1 A 0 A_PlaySound("blooddemon/walk")
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DTFiendGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	DPNK D 1 A_Chase
	TNT1 A 0 A_Jump(87,"See")
    Loop
  Missile:
	TNT1 A 0 A_Jump(168,"DTech")
	TNT1 A 0 A_JumpIfCloser(250,"Lunge")
	Goto See
  Melee:	   
  Lunge:
	TNT1 A 0 A_PlaySound("cyberfiend/melee")
	DPNK AA 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	DPNK B 2 A_Recoil(-28)
	DPNK B 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	DPNK B 6
	DPNK B 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	DPNK B 1 A_ScaleVelocity(0)
	Goto See
  DTech:
	DPNK E 15 A_FaceTarget
	DPNK E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DTFDemonTechProjectile",36,0,frandom(-1.5,1.5),0)
	DPNK F 3 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(62,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto DTech+1
  Pause:
	DPNK E 15 A_PlaySound("weapons/demontechsteam")
	Goto See	   
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    DPNK H 4 A_Pain
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(174,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(174,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
    DPNK I 5 A_ChangeFlag(SLIDESONWALLS,0)
    DPNK J 5 A_Scream   
	TNT1 AA 0 A_CustomMissile("GreenBloodCloud", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DPNK K 4 A_SpawnItemEx("DTFiendArm",10,0,32,0,frandom(6,8),0,0,SXF_CLIENTSIDE)
    DPNK L 4 A_NoBlocking     
    DPNK M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    DPNK N -1 
    Stop
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(174,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
	DPNK I 3 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    DPNX A 3 A_XScream
    DPNX B 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    DPNX C 3 A_NoBlocking
    DPNX D 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	DPNX EF 3
    DPNX G -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    DPNK NMLKJI 5 
    Goto See 
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	DPNX GFEDCBA 4
	DPNK I 4
	Goto See
  }
}

