	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	PHNT A 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("PoisonSoulCloud",frandom(-8,8),frandom(-8,8),frandom(2,16),frandom(-4,-2),0,frandom(-1,1),frandom(-20,20),0)	
	PHNT ABB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See		
