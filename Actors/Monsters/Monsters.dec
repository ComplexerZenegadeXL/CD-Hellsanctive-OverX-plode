	DEMO G 4 Bright A_SPosAttackUseAtkSound
    TNT1 A 0 A_SpawnItemEx("ShellCasing", 10, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire")
	TNT1 A 0 A_CustomMissile("MonsterTracer3",frandom(24,34),0,frandom(-10,10),0)
	DEMO H 4 Bright A_SPosAttackUseAtkSound
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")		
	TNT1 A 0 A_Jump(3,"Pause","BFG15K","BFG9K")		
    TNT1 A 0 A_SpidRefire
    Goto Normal+3
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DEMO T 18 Bright A_FaceTarget
	DEMO T 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15KLoop:
