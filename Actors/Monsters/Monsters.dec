Actor Exile : ArchVile 21043
{
  GibHealth 90
  Species "Viles"
  DropItem "LifeEssence" 100
  DropItem "ArmorBonusMax" 100
  DamageFactor "VileFires", 0.0
  PainChance "Mine", 128
  PainChance "SoulToxic", 1
  PainChance "FatFlamer", 1
  PainChance "FiendFire", 1
  Obituary "$CFExileObit"
  DeathSound "avile/death"
  Scale 0.9
  Tag "$CFExile"
  var int user_lowlag;
  States
  {
  Spawn:
    VILE A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	VILE A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	VILE AABBCC 2 A_VileChase
    VILE D 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)						  
	TNT1 A 0 A_Jump(64,"Rush")
    VILE A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    VILE AABBCC 2 A_VileChase
    VILE D 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    VILE DDEEFF 2 A_VileChase
    Loop
  Rush:
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    VILE F 1 A_VileChase
    TNT1 A 0 A_Jump(182,"See")
	Loop
  Missile:
    TNT1 A 0 A_FaceTarget
    VILE G 10 Bright A_PlaySound("exile/voidstart")
    VILE H 8 Bright A_VileTarget
    VILE IJKLMN 8 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
    VILE O 8 Bright A_VileAttack
    VILE P 20 Bright
    Goto See	
  Heal:
    VILZ A 10 Bright
    Goto See
  Pain:
    VILE Q 10 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    VILE Q 6
    VILE R 5 A_Scream
    VILE S 5 A_Fall
    VILE TUV 5
	VILE W 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    VILE XY 4
    VILE Z -1
    Stop
  XDeath:
	VILX A 4
	VILX B 3 A_XScream
	VILX C 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VILX D 3 A_Fall
	VILX E 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VILX FG 3
	VILX H -1
	Stop
  }
}

