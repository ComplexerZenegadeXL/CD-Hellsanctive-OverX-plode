	TNT1 AAAA 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, frandom(20,40), 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("Kaboom4", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("PoisonEleBreath",0,0,10,frandom(-10,10),frandom(-10,10),frandom(-6,6))		
	INFR J 5 Bright A_PainDie("SummonedPoisonSoul")
	INFR K 5 Bright
	Stop
  } 
}

