Actor CFCacodemon 21032
{
  Health 400
  GibHealth 75
  Speed 8
  Radius 30
  Height 56
  Species "Cacodemon"
  PainChance 120
  PainChance "SoulToxic", 40
  PainChance "FatFlamer", 40
  PainChance "FiendFire", 40
  Mass 500
  MeleeDamage 5
  DamageFactor "CacoComet", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "Cacolich", 0.0
  DamageFactor "TouHou", 0.0
  DamageFactor "BombBreath", 0.0
  SeeSound "caco/sight"
  PainSound "monsters/cacopain"
  ActiveSound "caco/active"
  MeleeSound "caco/melee"
  DeathSound "cacos/death"
  Obituary "$CFCacodemonObit"
  HitObituary "$CFCacodemonHitObit"
  DropItem "LifeEssence" 60
  DropItem "ArmorBonusMax" 60
  BloodColor "Blue"
  Monster
  +NOGRAVITY
  +FLOAT
  +MISSILEMORE
  Tag "$CFCaco"
  var int user_lowlag;
  States
  {
  Spawn:
    CALI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CALI A 1 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CALI A 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)  
    CALI A 3 A_Chase
	TNT1 A 0 A_Jump(4,"Evade")		 
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
	CALI AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
	CALI AAAA 3 A_Chase
	TNT1 A 0 A_Stop		 
	Goto See
  Missile:
    CALI BC 6 A_FaceTarget
    CALI D 2 Bright A_FaceTarget
	CALI D 1 Bright A_CustomMissile("ABBall",24,0,0,0,0)
    TNT1 A 0 A_CustomMissile("ABBall",24,0,6,0,0)
    CALI D 1 Bright A_CustomMissile("ABBall",24,0,-6,0,0)
    CALI CB 4 A_FaceTarget
    Goto See
  Melee:
    CALI BC 5 A_FaceTarget
    CALI D 5 A_MeleeAttack
	CALI CB 5 A_FaceTarget
    Goto See
  Pain:
	CALI E 6 A_Pain
	CALI F 6
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    CALI G 7
    CALI H 7 A_ScreamAndUnblock
	CALI I 6
	CALI J 5
	CALI K 4
	CALI L -1
	Stop
  XDeath:
	CAXD A 4
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	CAXD B 3 A_PlaySound("Gore/Splat")
	CAXD C 3 A_SpawnItemEx("CacoGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	CAXD D 3 A_NoBlocking
	CAXD EFGHI 3
	CAXD J -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	CALI KJIHG 4
	Goto See         
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	CAXD JIHGFEDCBA 3
	Goto See
  }
}

