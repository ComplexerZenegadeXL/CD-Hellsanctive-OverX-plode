Actor HellDuke : CFHellKnight 28524
{ 
  Health 1250
  PainChance 40
  PainChance "Explosion", 60
  Scale 1.15
  BloodColor "Green"
  MeleeDamage 8
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DamageFactor "NobleComet", 0.0
  Species "Nobles"
  +MISSILEEVENMORE
  +FASTMELEE
  +QUICKTORETALIATE
  Obituary "$CFHellDukeObit"
  HitObituary "$CFHellDukeHitObit"
  SeeSound "duke/see" 
  ActiveSound "duke/idle"
  PainSound "duke/pain"
  DeathSound "duke/death"
  MeleeSound "baron/melee"
  Tag "$CFDuke"
  var int user_lowlag;	  
  States 
  { 
  Spawn: 
    HDUK A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HDUK AA 7 Bright A_Look
	HDUI AA 7 Bright A_Look
    Loop 
  See:
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HDUK AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("DukeWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HDUK AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("DukeWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HDUK BB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("DukeWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    HDUK CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("DukeWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HDUK DD 3 Bright A_Chase
    Loop
  Missile:  
    TNT1 A 0 A_Jump(128,"GiantBalls","BurstComet","FloorHugger")
  Normal:
    HDUK EF 6 Bright A_FaceTarget 
	HDUK G 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, -5)
	HDUK G 4 Bright A_CustomMissile("CyNobleBall", 32, 0, 5)
    HDUK IJ 6 Bright A_FaceTarget 
	HDUK K 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, -5)
	HDUK K 4 Bright A_CustomMissile("CyNobleBall", 32, 0, 5)		
	TNT1 A 0 A_Jump(87,"GiantBalls","BurstComet","FloorHugger")
    Goto See
  GiantBalls:
	HDUK EF 7 Bright A_FaceTarget
	HDUK G 6 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	HDUK IJ 7 Bright A_FaceTarget
	HDUK K 6 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
	TNT1 A 0 A_Jump(87,"BurstComet","FloorHugger")
	Goto See
  BurstComet:
    HDUK MN 8 Bright A_FaceTarget
    HDUK O 2 Bright A_CustomMissile("HDComet",32,0,0)
	TNT1 A 0 A_CustomMissile("HDComet",32,0,-10)
	HDUK O 5 Bright A_CustomMissile("HDComet",32,0,10)
	TNT1 A 0 A_Jump(87,"FloorHugger")
    Goto See
  FloorHugger:
    HDUK ON 8 Bright A_FaceTarget
	HDUK M 2 Bright A_CustomMissile("DukeFireSpawner",16,0,0)
	TNT1 A 0 A_CustomMissile("DukeFireSpawner",16,0,-18)
    HDUK M 8 Bright A_CustomMissile("DukeFireSpawner",16,0,18)	
	Goto See
  Melee:
    HDUK EF 7 Bright A_FaceTarget 
    HDUK G 6 Bright A_MeleeAttack 	
    Goto See
  Pain:
	TNT1 A 0 A_JumpIfInventory("DukeToken",3,2)
	TNT1 A 0 A_Jump(28,"PainHeal")
	TNT1 A 0 A_Jump(104,"PainMissile","PainRage")
    HDUK Q 4 Bright A_Pain
    Goto See
  PainHeal:
	HDUK Q 4 Bright A_Pain
	HDUK ON 6 Bright A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_GiveInventory("DukeToken",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("duke/see")
	TNT1 A 0 A_GiveInventory("Health",400)
	HDUK MMMMMM 2 Bright A_SpawnItemEx("DukeHealFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	HDUK MMMMMM 2 Bright A_SpawnItemEx("DukeHealFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	HDUK N 6 Bright A_UnSetInvulnerable
	TNT1 A 0 A_Jump(87,1)
	Goto See
	TNT1 A 0 A_FaceTarget
	Goto BurstComet+2
  PainMissile:
	HDUK Q 10 Bright A_Pain
    Goto Missile
  PainRage:
	HDUK Q 10 Bright A_Pain
	TNT1 A 0 A_JumpIfCloser(400,1)
	Goto See
	TNT1 A 0 A_PlaySound("brain/spit")
	HDUK ON 5 Bright
	HDUK MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 1 Bright A_SpawnItemEx("DukeSpike",frandom(-400,-00),frandom(-400,400),0,0,0,0,SXF_NOCHECKPOSITION)
	HDUK N 5 Bright
    Goto See 
  XDeath:
  Death:
    HDUK R 10 Bright A_Scream
	TNT1 A 0 A_TakeInventory("DukeToken",3)
	HDUK RRRRSSSSTTTTUUUUVVVV 2 Bright A_CustomMissile("Kaboom4", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(40,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    HDUK W 8 A_Fall
    HDUK XY 6
    HDUK Z -1
	Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    HDUK YXW 3
    HDUK VUTSR 3 Bright
    Goto See 
  } 
}

