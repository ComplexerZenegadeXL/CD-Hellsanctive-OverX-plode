//==========
// Monsters
//==========

Actor PlasmaGunner 21022
{
  Health 30
  Radius 20
  Height 56
  Speed 8
  Mass 100
  PainChance 160
  Species ""
  DropItem "HealthFlask" 35
  DropItem "ArmorCharge" 35
  DropItem "AmmoPack" 20
  DropItem "HandGrenadeAmmo" 50 1
  DropItem "MineAmmoRandomizer" 25 1
  DropItem "NewCellPickup" 50 20
  DropItem "Flare" 32
  Monster 
  +FLOORCLIP
  +MISSILEMORE
  SeeSound "fem/sight"
  PainSound "fem/pain"
  DeathSound "fem/death"
  ActiveSound "fem/active"
  Obituary "$CFPlasmaGunnerObit"
  Tag "$CFPlZom" 
  States
  {
  Spawn:
    ZMAY A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ZMAY A 10 A_Look
	ZMAI A 10 A_Look
    Loop
  See:
	ZMAY AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    ZMAY CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Pause:
	ZMAY E 20
	Goto See
  Missile:
    ZMAY E 15 A_FaceTarget
    ZMAY F 2 Bright A_CustomMissile("ZombiePlasmaBall", 30, 4, 0)
    ZMAY E 3 A_FaceTarget
    TNT1 A 0 A_Jump(102,"Pause")
    TNT1 A 0 A_SpidRefire
    Goto Missile+1
  Pain:
    ZMAY G 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	ZMAY H 5  
    ZMAY I 5 A_Scream
    ZMAY J 5 A_Fall
    ZMAY K 5
    ZMAY L 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ZMAY L -1
    Stop
  XDeath:
	ZMAY O 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    ZMAY P 3 A_XScream
    ZMAY Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ZMAY R 3 A_Fall
    ZMAY STU 3
    ZMAY V -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    ZMAY KJIH 5
    Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ZMAY VUTSRQPO 4
	Goto See
  }
}

Actor ZombiePlasmaBall : NewPlasmaBall
{
  Speed 20
  FastSpeed 25
  Damage (Random(10,20)) //3
  SeeSound "weapons/hrfire"
  +FORCERADIUSDMG
  +NODAMAGETHRUST
  -THRUSPECIES
  //-NOBLOCKMAP
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_Explode(12,15,0)
    TNT1 A 1 A_SpawnItemEx("PlasmaEx",0,0,0,0,0,0,0)   
    Stop
  }
}

Actor RailGunner 21023
{
  Health 30
  Radius 20 
  Height 56 
  Speed 8
  Mass 100
  PainChance 140
  Species ""
  DropItem "HealthFlask" 55
  DropItem "ArmorCharge" 55
  DropItem "AmmoPack" 40
  DropItem "HandGrenadeAmmo" 100 1 
  DropItem "MineAmmoRandomizer" 50 1
  DropItem "NewCellPickup" 100 20
  DropItem "Flare" 32
  Monster 
  +FLOORCLIP 
  +MISSILEMORE
  Obituary "$CFRailGunnerObit"
  SeeSound "grunt/sight"
  PainSound "grunt/pain"
  DeathSound "grunt/death"
  ActiveSound "grunt/active"
  Tag "$CFRailZom" 
  States 
  { 
  Spawn: 
    RPOS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	RPOS A 10 A_Look
	RPOI A 10 A_Look
    Loop 
  See: 
    RPOS AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    RPOS CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Missile: 
	RPOS E 18 A_FaceTarget
	RPOS E 2
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",2) == 1, "Missile2")
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("RailgunImpactRed",30)
	RPOS F 5 Bright A_CustomRailgun(Random(15, 25), 0, "Red", None, RGF_NOPIERCING, 1)
	RPOS E 40
	Goto See
  Missile2: 
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	TNT1 A 0 A_FaceTarget
	RPOS F 5 Bright A_CustomMissile("SpecOpsLaser",30,0,0)
	RPOS E 40
	Goto See
  Pain: 
    RPOS G 6 A_Pain 
    Goto See 
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
    RPOS H 5
    RPOS I 5 A_Scream 
    RPOS J 5 A_Fall 
    RPOS K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    RPOS LM 5 
    RPOS N -1
    Stop 
  XDeath:
    ZMAY O 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    ZMAY P 3 A_XScream
    ZMAY Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ZMAY R 3 A_Fall
    ZMAY STU 3
    ZMAY V -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    RPOS NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ZMAY VUTSRQPO 4
	Goto See
  }
}

Actor DemonTechZombie 28983
{ 
  Health 60
  Radius 20
  Height 56
  Speed 8
  Mass 100
  PainChance 120
  Species ""
  PainChance "ZombieDemonTech", 0
  DropItem "StimKit" 80
  DropItem "ArmorBooster" 80
  DropItem "AmmoPack" 65
  DropItem "HandGrenadeAmmo" 150 1
  DropItem "MineAmmoRandomizer" 75 1
  DropItem "DemonAmmoPickup" 162 80
  DropItem "Flare" 32
  DamageFactor "ZombieDemonTech", 0
  Monster 
  +FLOORCLIP
  +MISSILEMORE
  SeeSound "grunt/sight"
  AttackSound "Null"
  PainSound "grunt/pain"
  DeathSound "grunt/death"
  ActiveSound "grunt/active"
  Obituary "$CFDemonTechZombieObit"
  Tag "$CFDtZom"
  States
  {
  Spawn:
    ZSP3 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ZSP3 A 10 A_Look
	ZSII A 10 A_Look
    Loop
  See:
    ZSP3 AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    ZSP3 CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Pause:
	ZSP3 E 20 A_PlaySound("weapons/demontechsteam")
	Goto See
  Missile:
	ZSP3 E 15 A_FaceTarget
    ZSP3 E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ZDemonTechProjectile",32,0,Random(125,-125)/125.25,0)
	ZSP3 F 3 Bright A_PlaySoundEx("weapons/demontechfire","Weapon")
	TNT1 A 0 A_Jump(72,"Pause")
	TNT1 A 0 A_SpidRefire
	Goto Missile+1
  Pain:
    ZSP3 G 6 A_Pain
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(224,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(224,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
    ZSP3 H 5 A_Scream
    ZSP3 I 5 A_Fall
    ZSP3 J 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ZSP3 K 5
    ZSP3 L -1
    Stop
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(224,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,0,0,0,0)
	ZMAY O 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    ZMAY P 3 A_XScream
    ZMAY Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ZMAY R 3 A_Fall
    ZMAY STU 3
    ZMAY V -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    ZSP3 LKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ZMAY VUTSRQPO 4
	Goto See
  }
}

Actor ZDemonTechProjectile
{
  Height 4
  Radius 4
  Speed 40
  Damage (Random(15,32))
  Scale 0.06
  Projectile
  +FORCERADIUSDMG
  DamageType "ZombieDemonTech"
  DeathSound "weapons/demontechex"
  Decal "DTRScorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
  Normal:
    TNT1 A 0 A_Jump(128,"NormalFX")
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  NormalFX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Normal
  Spawn2:
	TNT1 A 0 A_Jump(128,"Spawn2FX")
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Spawn2FX:
	TNT1 A 0 A_SpawnItemEx("DTechLightning",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTechLightning2",frandom(1,-1),frandom(1,-1),frandom(1,-1),0,0,0,0,SXF_CLIENTSIDE)
    DTPR A 1 Bright A_SpawnItemEx("DemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Goto Spawn2  
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ZDemonTechEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_Explode(6,48)
    Stop
  }
}

Actor ZDemonTechEx
{
  RenderStyle Add
  Alpha 0.75
  Scale 0.45
  Projectile
  +NOCLIP
  States
  {
  Spawn:
	FRPG ABCDEFGH 2 Bright A_FadeOut(0.1)
	Stop
  }
}

Actor ZDemonTechTrail : BFG9500Trail
{
  Scale 0.04
  Alpha 0.65
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    DTRI AAAAAABBBBBBBB 1 Bright A_FadeOut(0.05)
    Stop
  }
}

Actor ZDemonTechTrail2 : ZDemonTechTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 2 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    DTRI AAAAAACCCCCCCC 1 Bright A_FadeOut(0.05)
    Stop
  }
}

Actor RocketZombie 20105
