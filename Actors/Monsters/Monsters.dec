    Loop
  Homing:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))		
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(64,128,0)
	TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor Famine : Guardian 21690
{
  PainChance 70
  Health 750
  Speed 12
  SeeSound "famine/sight"
  PainSound "guardian/pain"
  DeathSound "famine/death"
  ActiveSound "famine/active"
  DropItem "LifeEssence" 128
  DropItem "ArmorBonusMax" 128
  Obituary "$CFFamineObit"
  HitObituary "$CFFamineHitObit"
  BloodColor "30 30 30"
  MeleeThreshold 60
  +QUICKTORETALIATE
  -LONGMELEERANGE
  Tag "$CFFamine"
  States
  {
  Spawn:
    NREV A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    NREV A 10 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    NREV AABBCC 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    NREV DDEEFF 2 A_Chase
    Loop
  Melee:
    TNT1 A 0 A_JumpIfInventory("FamineMeleeToken",1,"Melee2")
    TNT1 A 0 A_FaceTarget
    NREV G 5 A_SkelWhoosh
    NREV H 5 A_FaceTarget
	TNT1 A 0 A_GiveInventory("FamineMeleeToken",1)	
    NREV I 5 A_SkelFist
    Goto See
  Melee2:
    TNT1 A 0 A_FaceTarget
    NREV R 5 A_SkelWhoosh
    NREV S 5 A_FaceTarget
	TNT1 A 0 A_TakeInventory("FamineMeleeToken",1)	
    NREV T 5 A_SkelFist
    Goto See
  Missile:
    TNT1 A 0 A_JumpIfCloser(275,"DashPunch")
  Normal:		
    NREV J 14 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("FamineTracer", 40, -14, 0)
    NREV K 10 A_CustomMissile("FamineTracer", 40, 14, 0) 
	NREV K 10
    Goto See
  DashPunch:
    TNT1 A 0 A_Jump(32,"Normal")
    TNT1 A 0 A_JumpIfInventory("FamineMeleeToken",1,"DashPunch2")
	TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-40)
    TNT1 A 0 A_SkelWhoosh	
	NREV GGGGG 1 A_SpawnItemEx("FamineDashGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_GiveInventory("FamineMeleeToken",1)
	NREV HHHHH 1 A_SpawnItemEx("FamineDashGhostA2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("FamineDashPunch",32,0,0,CMF_AIMDIRECTION)
	NREV III 1 A_SpawnItemEx("FamineDashGhostA3",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	NREV T 2 A_Stop	
    Goto See
  DashPunch2:
    TNT1 A 0 A_Jump(32,"Normal")
	TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-40)
    TNT1 A 0 A_SkelWhoosh	
	NREV RRRRR 1 A_SpawnItemEx("FamineDashGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 0 A_TakeInventory("FamineMeleeToken",1)
	NREV SSSSS 1 A_SpawnItemEx("FamineDashGhostB2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("FamineDashPunch",32,0,0,CMF_AIMDIRECTION)
	NREV TTT 1 A_SpawnItemEx("FamineDashGhostB3",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	NREV T 2 A_Stop
    Goto See	
  Pain:
    TNT1 A 0 A_Jump(42,"PainEvade","PainEvade2")
    TNT1 A 0 A_Jump(104,"MissilePain")
    NREV L 10 A_Pain
    Goto See
  PainEvade:
	TNT1 A 0 A_Pain
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
    NREV AAAAAAAA 1 A_SpawnItemEx("FamineGhost",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(62,"Missile")
	Goto See
  PainEvade2:
	TNT1 A 0 A_Pain
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
    NREV AAAAAAAA 1 A_SpawnItemEx("FamineGhost",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(62,"Missile")
	Goto See
  MissilePain:
	NREV L 10 A_Pain
    Goto Missile
  Death.PlayerIce:
    "####" "#" 0 A_Jump(128,2,3,4)
	"####" "#" 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,12,0,0,0,0)
	"####" "#" 0 A_SpawnItemEx("BossLifeEssence",0,0,12,0,0,0,0)
	"####" "#" 0 A_SpawnItemEx("BossArmorBonusMax",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"####" "#" 0 A_TakeInventory("FamineDeathToken",1)
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
  XDeath:
    TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIfInventory("FamineDeathToken",1,"TrueDeath")
	TNT1 A 0 A_Jump(84,"FakeDeath") //84
  TrueDeath:
	TNT1 A 0 A_Die
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,12,0,0,0,0,0,128)
	TNT1 A 0 A_SpawnItemEx("BossLifeEssence",0,0,12,0,0,0,0,0,128)
	TNT1 A 0 A_SpawnItemEx("BossArmorBonusMax",0,0,12,0,0,0,0,0,128)
    NREX A 5 Bright
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
    NREX B 5 Bright A_Scream
    NREX C 5 Bright
	NREX D 5 Bright A_CustomMissile("FamineSoul",72,0,0,2,90)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	NREX EFGH 4 Bright
	NREX I 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NREX J 4 A_TakeInventory("FamineDeathToken",1)
    NREX K -1
    Stop
  FakeDeath:
	NREV L 7 A_GiveInventory("FamineDeathToken",1)
	NREV MNO 7
    NREV P 7 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Jump(128,2,3,4,5)
    NREV QQQQQ 100
	TNT1 A 0 A_CustomMissile("FamineResurrection",0,0,0)
	NREV Q -1
	Stop
  XRaise:
  Raise:
 	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    NREV PONML 5
    Goto See
  }
}

