  DamageFactor "EleSouls", 0.0
  Scale 0.6
  Monster
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +DONTFALL
  +NOBLOOD
  +NOBLOODDECALS
  AttackSound "skull/melee"
  PainSound "monsters/terrorsoulpain"
  DeathSound "skull/death"
  ActiveSound "skull/active"
  Obituary "$CFTerrorSoulObit"
  Tag "$CFSoul"
  var int user_script;
  var int user_script_type;
  States
  {
  Spawn:
    TERR A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,30)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",29)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
