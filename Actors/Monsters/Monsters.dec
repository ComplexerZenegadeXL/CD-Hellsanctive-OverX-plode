    TNT1 A 0 A_SpawnItemEx("RifleCasing", 12, 6, 30, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    CPS2 F 3 Bright A_CPosAttack
	TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_CPosRefire
    Goto Missile+2
  Pain:
    CPS2 G 6 A_Pain
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(178,2)
	"####" "#" 0 A_SpawnItemEx("MinigunGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
  	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(178,2)
	TNT1 A 0 A_SpawnItemEx("MinigunGiver",0,0,12,0,0,0,0)
    CPS2 H 5
    CPS2 I 5 A_Scream 
    CPS2 J 5 A_Fall
    CPS2 K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CPS2 LM 5
    CPS2 N -1
    Stop
  XDeath:
  	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(178,2)
	TNT1 A 0 A_SpawnItemEx("MinigunGiver",0,0,12,0,0,0,0)
    CPS2 O 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    CPS2 P 3 A_XScream
    CPS2 Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CPS2 R 3 A_Fall 
    CPS2 STUV 3
	CPS2 W -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    CPS2 NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	CPS2 WVUTSRQPO 4
	Goto See
  }
}

