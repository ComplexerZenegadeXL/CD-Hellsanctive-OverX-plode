	TNT1 A 0 A_PlaySoundEx("MP40/Fire","Weapon")
    TNT1 A 0 A_SpawnItemEx("BulletCasing", 8, 8, 26, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    SSWJ G 3 Bright A_CustomBulletAttack(7.0,0.0,1,Random(9,15),"BulletPuff",0,CBAF_NORANDOM)
    SSWJ F 2 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("MP40/Fire","Weapon")
    TNT1 A 0 A_SpawnItemEx("BulletCasing", 8, 8, 26, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    SSWJ G 3 Bright A_CustomBulletAttack(7.0,0.0,1,Random(9,15),"BulletPuff",0,CBAF_NORANDOM)	
    SSWJ F 3 A_CPosRefire
    Goto See
  Pain:
    SSWJ H 6 A_Pain
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(188,2)
	"####" "#" 0 A_SpawnItemEx("MP40Giver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_SpawnItemEx("MP40Giver",0,0,12,0,0,0,0)
    SSWJ I 5
    SSWJ J 5 A_Scream
    SSWJ K 5 A_Fall
    SSWJ L 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SSWJ M -1
    Stop
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(188,2)
	TNT1 A 0 A_SpawnItemEx("MP40Giver",0,0,12,0,0,0,0)
    SSWJ N 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    SSWJ O 3 A_XScream
    SSWJ P 3 A_Fall
    SSWJ QRSTU 3
    SSWJ V -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    SSWJ MLKJI 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	SSWJ UTSRQPON 5
	Goto See
  }
}

