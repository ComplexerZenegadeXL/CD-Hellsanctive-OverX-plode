Actor Guard 22195
{
  Health 40
  Radius 20
  Height 56
  Speed 5
  Scale 1.1
  Monster
  Species "SS"
  DamageFactor "SS", 0.0
  +FLOORCLIP
  +MISSILEMORE
  DropItem "BulletMagPickup" 255 10
  DropItem "HealthFlask" 50
  DropItem "ArmorCharge" 50
  DropItem "AmmoPack" 25
  DropItem "HandGrenadeAmmo" 50 1
  DropItem "MineAmmoRandomizer" 25 1
  PainChance 120
  SeeSound "guard/sight"
  DeathSound "guard/death"
  PainSound "monsters/nazipain"
  Obituary "$CFGuardObit"
  Tag "$CFSSGuard"
  States
  {
  Spawn:
	NGRI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	NGRI A 10 A_Look
    Loop
  See:
   	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
   	NGRD AAAABBBB 1 A_Chase
   	TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)	
   	NGRD CCCCDDDD 1 A_Chase
	Loop
  Missile:
    NGRD E 10 A_FaceTarget
	NGRD F 5 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("monsters/nazipistol","Weapon")
    TNT1 A 0 A_SpawnItemEx("BulletCasing", 8, 8, 38, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    NGRD G 5 Bright A_CustomBulletAttack(7.0,0.0,1,Random(9,15),"BulletPuff",0,CBAF_NORANDOM)
    Goto See
  Pain:
    NGRD H 6 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    NGRD I 5
    NGRD J 5 A_Scream
    NGRD K 5 A_Fall
  	NGRD L 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NGRD M -1
    Stop
  XDeath:
	SSWJ N 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    SSWJ O 3 A_XScream
    SSWJ P 3 A_Fall
    SSWJ QRSTU 3
    SSWJ V -1
  	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    NGRD MLKJI 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	SSWJ UTSRQPON 5
	Goto See
  }
}

