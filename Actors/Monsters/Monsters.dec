Actor PhaseImp : Imp 24105
{
  Health 100
  Speed 10
  PainChance 80
  +QUICKTORETALIATE
  BloodColor "cf 00 b0"
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "DemonAmmoPickup" 128 60
  SeeSound "phaseimp/sight"
  PainSound "phaseimp/pain"
  DeathSound "phaseimp/death"
  ActiveSound "phaseimp/active"
  Obituary "$CFPhaseImpObit"
  HitObituary "$CFPhaseImpHitObit"
  Tag "$CFPhImp"
  var int user_lowlag;	
  States
  {
  Spawn:
    DIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DIMP A 10 A_Look
	DIMI A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)		 
	TNT1 A 0 A_Jump(46,"Evade")
	DIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	DIMP CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(46,"Phase")		
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	DIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	DIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Phased:
    DIMP AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
  PhasedLoop:
	DIMP AABBCCDDAABBCCDD 1 A_Chase
    TNT1 A 0 A_Jump(24,"UnPhase")
    Goto PhasedLoop
  Melee:
    TNT1 A 0 A_FadeTo(1.0,1.0)
    DIMP EF 5 A_FaceTarget
    DIMP G 5 A_MeleeAttack
    DIMP FE 5 A_FaceTarget		
    Goto See
  Missile:
    TNT1 A 0 A_FadeTo(1.0,1.0)
    DIMP EF 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
    DIMP G 5 Bright A_CustomMissile("PhaseImpBall", 32, 0, 0)
	DIMP FE 4
    Goto See
  Phase:
    TNT1 A 0 A_PlaySound("phaseimp/teleport")
    DIMP E 2 A_FaceTarget
	DIMP EEE 1 A_FadeOut(0.25,0)
	DIMP E 1 A_FadeOut(0.1,0)
    Goto Phased
  UnPhase:
    TNT1 A 0 A_PlaySound("phaseimp/teleport")
	DIMP E 1 A_FadeIn(0.1)//,0)
	DIMP EEE 1 A_FadeIn(0.25)//,0)
    DIMP E 2 A_FaceTarget		
    Goto See
  Pain:
    DIMP H 2 A_FadeTo(1.0,1.0)
    DIMP H 2 A_Pain
    Goto See
  Death:
    DIMP I 8
    DIMP J 8 A_Scream
    DIMP K 6
    DIMP L 6 A_Fall
    DIMP M -1
    Stop
  XDeath:
	PIKI N 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	PIKI O 3 A_XScream
	PIKI P 3 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PIKI Q 3 A_Fall
	PIKI RST 3
	PIKI U -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    PIKI MLKJI 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	PIKI UTSRQPO 4
	Goto See
  }
}

