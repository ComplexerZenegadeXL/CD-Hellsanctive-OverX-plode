	TERR C 3 Bright
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TERR F 4 Bright A_NoGravity
	TERR G 4 Bright A_Scream
	TNT1 AA 0 A_SpawnItemEx("SoulPart1",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 A 0 A_SpawnItemEx("SoulPart2",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))
	TNT1 AA 0 A_SpawnItemEx("SoulPart3",0,0,frandom(10,20),frandom(-8,8),frandom(-8,8),frandom(6,8))	
	TERR H 4 Bright
	TERR I 4 Bright A_Fall
    TNT1 AA 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TERR JK 4
    Stop
  }
}
