Actor Cardinal : CFAnnihilator 3120
{ 
  Health 6000
  Speed 10
  FloatSpeed 8
  PainChance 30
  PainChance "PDTBFG", 15
  PainChance "SoulToxic", 5
  PainChance "FatFlamer", 5
  PainChance "FiendFire", 5
  PainChance "Explosion", 60
  Species "Cybers"
  DamageFactor "PDTBFG", 0.2
  DamageFactor "PDTBFGTracer", 0.6
  DamageFactor "DBFG2", 0.0
  DropItem "BossLifeEssence" 204 25
  DropItem "BossArmorBonusMax" 204 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonicChaliceGiver" 64
  SeeSound "Cardinal/Sight"
  PainSound "Cardinal/Pain"
  DeathSound "Cardinal/Death"
  ActiveSound "Cardinal/Active"
  Scale 1.1
  Mass 2500
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY	
  -FLOORCLIP
  Obituary "$CFCardinalObit"
  Tag "$CFCardi"
  var int user_loop;
  var int user_script;
  var int user_script_type;
  States 
  { 
  Spawn:
	CARD A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,35)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",34)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    CARD AB 2 Bright A_Look
    Loop
  See:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	CARD AB 2 Bright A_Chase
    Loop	  
  Missile:
    TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K")
  Normal:
    CARD C 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
    CARD D 6 Bright A_CustomMissile("CardinalRocket", 52, -25, frandom(-6, 6))
	CARD D 2 Bright  
    CARD C 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    CARD D 6 Bright A_CustomMissile("CardinalRocket", 52, -25, frandom(-6, 6))
	CARD DC 4 Bright
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K")
    Goto See
  Seekers:
    CARD C 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekersLoop:
    CARD D 6 Bright A_CustomMissile("CardinalHomingRocket", 52, -25, frandom(-8, 8))
	CARD D 2 Bright
    CARD C 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	CARD DC 4 Bright
	TNT1 A 0 A_Jump(128,"Railgun","BFG10K","DTBFG10K")
    Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunLoop:
    CARD C 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,1)
	Goto RailgunLoop
    CARD D 2 Bright A_CustomMissile("CardinalRail",52,-25)
    CARD DD 4 Bright A_FaceTarget
    CARD C 14 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See	  
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	CARD CCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    CARD D 3 Bright A_CustomMissile("Cardinal10K", 52, -25, frandom(-4, 4))
    CARD C 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    CARD D 3 Bright A_CustomMissile("Cardinal10K", 52, -25, frandom(4, -4))  
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	CARD C 20 Bright
	TNT1 A 0 A_Jump(128,"DTBFG10K")
    Goto See	  
  DTBFG10K:
    TNT1 A 0 A_PlaySound("Cardinal/9k")
	CARD CCCCCDD 4 Bright A_FaceTarget
    CARD D 4 Bright A_CustomMissile("CardinalDTBFG10KBall", 52, -25, 0)
	CARD DCC 4 Bright
    Goto See
  Pain:
	TNT1 A 0 A_Jump(16,"PainRage")
	TNT1 A 0 A_Jump(128,"PainMissile")
    CARD E 3 Bright A_Pain
    CARD E 6 Bright
    Goto See
  PainMissile:
    CARD E 3 Bright A_Pain
    CARD E 6 Bright
    Goto Missile
  PainRage:
	TNT1 A 0 A_JumpIfCloser(1000,1)
	Goto Pain+1
    CARD E 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("CardinalToken",3,"See")	
    CARD E 12 Bright
	TNT1 A 0 A_GiveInventory("CardinalToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",200)
    TNT1 A 0 A_PlaySound("Cardinal/Laugh")	 
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainRageLoop:
	TNT1 A 0 A_SpawnItemEx("CardinalRageFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CARD E 2 Bright A_SpawnItemEx("RainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 40,1)
	Goto PainRageLoop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    CARD EE 3 Bright
	Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(52,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
   	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(52,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,12,0,0,0,0)
	CARD E 10 A_Scream
	CARD F 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARD GGGGG 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARD HHHHH 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    CARD IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARD JJJJJ 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARD KKKKK 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CARD L 5
    Stop
