Actor BombElemental : SoulKeeper 25852
{
  Health 850
  PainChance 60
  SeeSound "bomb/sight"
  DeathSound "Pain/Death"
  PainSound "bomb/pain"
  ActiveSound "bomb/lava"
  DamageType "SoulToxic"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  Obituary "$CFBombElementalObit"
  HitObituary "$CFBombElementalHitObit"
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  Tag "$CFBombPain"
  var int user_loop;
  States
  {
  Spawn:
	INFP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_LoopActiveSound
  IdleLoop:
	INFP AABBCCDD 3 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_LoopActiveSound
  SeeLoop:
	INFP AABBCCDD 3 Bright A_Chase
	Loop
  Missile:
	TNT1 A 0 A_LoopActiveSound
	TNT1 A 0 A_Jump(102,"Seeker","FireBreath")
  Normal:
    INFP HI 6 Bright A_FaceTarget
    INFP J 5 Bright A_SpawnItemEx("SummonedRictus",62,0,14,0,0,0,0,SXF_SETMASTER)
	INFP FE 4 Bright
	Goto See
  Seeker:
    INFP EF 5 Bright A_FaceTarget 
    INFP G 4 Bright A_CustomMissile("BombBall", 20, 0, 0)
	INFP FE 3 Bright
    Goto See
  FireBreath:
	TNT1 A 0 A_JumpIfCloser(300,1)
	Goto Missile+2
	INFP EF 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("magma/firebreath")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FireBreathLoop:
	INFP G 2 Bright A_CustomMissile("BombBreath", 24, 0, frandom(8,-8))
	TNT1 A 0 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	INFP FE 3 Bright
	Goto See
  Melee:
	TNT1 A 0 A_LoopActiveSound
    INFP EF 5 Bright A_FaceTarget 
    INFP G 4 Bright A_MeleeAttack
	INFP FE 3 Bright A_FaceTarget
    Goto See		
  Pain:
	TNT1 A 0 A_LoopActiveSound
	TNT1 A 0 A_JumpIfHealthLower(250,"PainSuicide")
	TNT1 A 0 A_Jump(128,"PainMissile")
	INFP K 12 Bright A_Pain
	Goto See
  PainSuicide:
	TNT1 A 0 A_JumpIfCloser(1250,1)
	Goto Pain+2
	TNT1 A 0 A_Jump(18,"See")
	TNT1 A 0 A_StopSound
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOTARGET,1)
	TNT1 A 0 A_PlaySound("bomb/anger")
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0)
	INFP H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0)
	INFP H 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0)
	INFP I 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0)
	INFP I 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0)
	TNT1 A 0 A_CustomMissile("BombSuicide",0,0,0,0) 
	INFP J 2 Bright A_Die("Suicide")
	Stop		
  PainMissile:
	INFP K 12 Bright A_Pain
	Goto Missile		
  Death:
	TNT1 A 0 A_PlaySound("bomb/explode")
	INFP L 5 Bright A_Explode(82,128)
	TNT1 A 0 A_SpawnItemEx("BombGoreGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)		
	INFP M 5 Bright A_Scream
	INFP N 5 Bright A_NoBlocking
	TNT1 AAAA 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, frandom(20,40), 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("Kaboom3", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("SummonedRictus",0,40,14)
	TNT1 A 0 A_SpawnItemEx("SummonedRictus",0,-40,14)
	INFP O 5 Bright A_SpawnItemEx("SummonedRictus",-40,0,14)
	INFP PQ 5 Bright
	Stop
  Death.Suicide:
	TNT1 A 100 A_NoBlocking
	Stop
  } 
}

