    HELN F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN F 1 A_VileChase
    TNT1 A 0 A_Jump(164,"See")
    Loop
  Missile:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("hellion/smokestart")	
    HELN GG 5 A_FaceTarget
    HELN H 5 A_VileTarget("HellionSmokeAttack")
	HELN HH 5 A_FaceTarget
    HELN IIJJJJJJJK 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
	HELN K 4 A_VileAttack
	HELN L 20
    Goto See
  Pain: 
	TNT1 A 0 A_SpawnItemEx("HellionSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN M 10 A_Pain 
	Goto See
  Heal:
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 A_SetUserVar("user_loop",1)
  HealLoop:
	TNT1 A 0 A_CustomMissile("HellionResRadius",10,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"HealLoop")
    HELH ABA 16 Bright
    HELH A 4 Bright
    Goto See	
  Death:
    HELD N 6 A_Scream
    HELD O 5 A_Fall
    HELD PQ 5
    HELD R 4 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HELD S 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HELD T -1
    Stop
  XDeath:
	HELX A 4
	HELX B 3 A_XScream
	HELX C 3 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HELX D 3 A_Fall
	HELX E 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HELX FG 3
	HELX H -1
	Stop
  }
}

