    TNT1 A 0
    TNT1 A 0 A_Jump(144,"Homing")
  Normal:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),frandom(-2,2))
    Loop	
  Homing:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),Random(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 2 Bright A_CustomMissile("ProjectileTrailParticleGreen2",frandom(0,2),frandom(-2,2))
	Goto StartSeek
  StartSeek:
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave	
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIG A 1 Bright A_CustomMissile("ProjectileTrailParticleGreen",frandom(0,2),frandom(-2,2))	
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom4", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    MIS3 B 6 Bright A_Explode(64,128,0)
    MIS3 CDEF 4 Bright A_SetTranslucent(0.75,1)
    Stop	
  }
}

