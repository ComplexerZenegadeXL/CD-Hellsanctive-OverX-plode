Actor Cacomental : CFCacodemon 21034
{
  Obituary "$CFCacomentalObit"
  HitObituary "$CFCacomentalHitObit"
  Health 800
  PainChance 80
  DamageFactor "CacoComet", 0.0
  SeeSound "monsters/cacomsit"
  PainSound "monsters/cacompai"
  DeathSound "monsters/cacomdet"
  MeleeSound "caco/melee"
  DropItem "LifeEssence" 120
  DropItem "ArmorBonusMax" 120
  BloodColor "Red"
  Tag "$CFCacomental"
  States
  {
  Spawn:
    INFC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	INFC A 10 A_Look
    Loop
  See:
    INFC A 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
	INFC A 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
    INFC B 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
	INFC B 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
    INFC C 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
	INFC C 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
    INFC B 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")
	INFC B 3 A_Chase
	TNT1 A 0 A_Jump(8,"Evade")	
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
	INFC AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
	INFC CCCC 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See	
  Missile:
    TNT1 A 0 A_Jump(128,"Seeking","Comet")
  Normal:
    INFC DE 6 A_FaceTarget
	INFC F 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HadesBall",24,0,-2,0,0)
    INFC F 1 Bright A_CustomMissile("HadesBall",24,0,2,0,0)
	TNT1 A 0 A_CustomMissile("HadesBall",24,0,-6,0,0)
    INFC F 2 Bright A_CustomMissile("HadesBall",24,0,6,0,0)
	INFC ED 4
	TNT1 A 0 A_Jump(87,"Seeking","Comet")
    Goto See
  Seeking:
    INFC DE 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeleBall",24,0,16,0,0)
	INFC F 4 Bright A_CustomMissile("HeleBall",24,0,-16,0,0)
    INFC ED 4	
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    INFC DE 6 A_FaceTarget
	INFC F 5 Bright A_CustomMissile("CacoMComet",24,0,0,0,0)
    INFC ED 4
	Goto See
  Melee:
    INFC DE 4 A_FaceTarget
    INFC F 4 A_MeleeAttack
    INFC ED 4 A_FaceTarget	
    Goto See
  Pain:
    TNT1 A 0 A_Jump(87,"PainMissile")
    INFC G 6 A_Pain
	INFC H 6
    Goto See
  PainMissile:
    INFC G 6 A_Pain
	INFC H 6
    Goto Missile
  Death:
  XDeath:
    INFC I 5 A_Scream
    INFC J 5 A_NoBlocking	
	INFC J -1
	Stop
  Crash:
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	INFC K 4 A_PlaySound("Gore/Splat")
	INFC L 4 A_NoBlocking
	INFC M 4
	INFC N -1 A_SetFloorClip
	Stop
  XRaise:
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    INFC MLKJI 5 Bright
	Goto See
  }
}

