Actor CyberNoble : CFHellKnight 21133
{ 
  Health 1000
  PainChance 60
  MeleeDamage 8
  Scale 1.1
  Obituary "$CFCyberNobleObit"
  HitObituary "$CFCyberNobleHitObit"
  SeeSound "monster/brusit" 
  PainSound "cbaron/pain"
  DeathSound "cbaron/death"
  MeleeSound "baron/melee"
  ActiveSound "cbaron/active"
  DamageFactor "NobleComet", 0.0
  DropItem "LifeEssence" 150
  DropItem "ArmorBonusMax" 150
  Species "Nobles"
  BloodColor "Green"
  +MISSILEMORE
  +DONTHURTSPECIES
  +FASTMELEE
  Tag "$CFNoble"
  States 
  { 
  Spawn: 
    CBOS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CBOS AA 7 A_Look
	CBOI AA 7 A_Look
    Loop 
  See:
    CBOS AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    CBOS CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Pause:
	CBOS E 10
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"BurstBall","LargeBall","Rocket")
  Normal:
    CBOS E 8 A_FaceTarget
	CBOS E 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("ProjectileBullet",40,0,frandom(-10,10),0)
	TNT1 A 0 A_CustomBulletAttack(22.5, 18.3, 4, Random(9,15),"CyNoblePuff",0,CBAF_NORANDOM)
	CBOS F 2 Bright A_PlaySoundEx("AShotgun/Fire","Weapon")
    TNT1 A 0 A_Jump(64,"Pause")
    TNT1 A 0 A_SpidRefire
	Goto Normal+1
  BurstBall:
	CBOS PQ 7 A_FaceTarget 
	CBOS R 1 Bright A_CustomMissile("CyNobleBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("CyNobleBall", 32, 0, 6)
	CBOS R 5 Bright A_CustomMissile("CyNobleBall", 32, 0, -6)
	TNT1 A 0 A_Jump(87,"LargeBall","Rocket")
	Goto See
  LargeBall:
  	CBOS PQ 7 A_FaceTarget
	CBOS R 6 Bright A_CustomMissile("DukeBall2", 32, 0, 0)
  Rocket:
    CBOS E 14 A_FaceTarget
    CBOS F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    CBOS E 10
    Goto See
  Melee:
    CBOS PQ 7 A_FaceTarget
    CBOS R 7 A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"PainMissile")
    CBOS H 4 A_Pain
    Goto See
  PainMissile:
    CBOS H 4 A_Pain
    Goto Missile	
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(98,2)
	"####" "#" 0 A_SpawnItemEx("AssaultShotgunGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  XDeath:
  Death:
  	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(98,2)
	TNT1 A 0 A_SpawnItemEx("AssaultShotgunGiver",0,0,12,0,0,0,0)
    CBOD I 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)	
	CBOD JJJKKK 2 Bright A_CustomMissile ("Kaboom5", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CBOD L 4 Bright A_NoBlocking
    CBOD MN 3 Bright
    CBOS O -1
    Stop
  XRaise:
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    CBOD N 5 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	CBOD MLKJI 5
	Goto See
  } 
}

