    PYRO G 7 Bright A_MeleeAttack 		
    Goto See
  Pain: 
	TNT1 A 0 A_Jump(61,"PainMissile")
    PYRO Q 4 Bright A_Pain
    Goto See 
  PainMissile:
	PYRO Q 4 Bright A_Pain
    Goto Missile 
  XDeath:
  Death: 
    PYRO R 8 Bright
    PYRO S 7 Bright A_Scream 
	TNT1 AAA 0 A_SpawnItemEx("OrangeParticleSpawner", frandom(-10,10), frandom(-10,10), frandom(30,60), 0, 0, 0, 0, SXF_CLIENTSIDE) 
    PYRO U 5 Bright A_Fall 
    PYRO VW 5 Bright
    TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))			
    PYRO X 4 Bright A_CustomMissile("PyroSoul",86,0,0,2,90)
    PYRO Z 4 Bright
    TNT1 A -1
	Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    PYRO ZYXWVUTSR 5 Bright
    Goto See 
  } 
}

