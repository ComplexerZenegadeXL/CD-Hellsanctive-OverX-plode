    HECT H 4 Bright A_CustomMissile("DaedabusBall", 30, -26, frandom(7, 12))  
    HECT IG 10 A_FaceTarget 
    TNT1 A 0 A_CustomMissile("DaedabusBall", 30, -26, frandom(0, 6))
    HECT H 2 Bright A_CustomMissile("DaedabusBall", 30, 26, frandom(-6, -0))	   
    TNT1 A 0 A_CustomMissile("DaedabusBall", 30, 26, frandom(-12, -7))
    HECT H 4 Bright A_CustomMissile("DaedabusBall", 30, -26, frandom(7, 12))
    HECT IG 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("DaedabusBall", 30, -26, frandom(0, 6))
    HECT H 2 Bright A_CustomMissile("DaedabusBall", 30, 26, frandom(6, -0))	   
    TNT1 A 0 A_CustomMissile("DaedabusBall", 30, 26, frandom(-12, -7))
    HECT H 4 Bright A_CustomMissile("DaedabusBall", 30, -26, frandom(7, 12))
	HECT IG 12
    Goto See
  ChemSpray:
    TNT1 A 0 A_Jump(94,"Normal")
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	HECT GG 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("Daedabus/Chem")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ChemSparyLoop:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DaedabusChemSpray", 30, 30, frandom(-12, 12), CMF_AIMOFFSET)
    HECT H 2 Bright A_CustomMissile("DaedabusChemSpray", 30, -30, frandom(-12, 12), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,1)
	Goto ChemSparyLoop
	HECT IG 12
	Goto See	   
  Pain:
    TNT1 A 0 A_Jump(61,"PainMissile")
    HECT J 6 A_Pain
    Goto See
  PainMissile:
    HECT J 6 A_Pain
    Goto Missile	   
  Death:
    HECT K 6 
    HECT L 6 A_Scream
    HECT L 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HECT M 6 A_NoBlocking
    HECT M 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HECT NOPQRS 6
    HECT T -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    HECT SRQPONMLK 6
    Goto See
  }
}

