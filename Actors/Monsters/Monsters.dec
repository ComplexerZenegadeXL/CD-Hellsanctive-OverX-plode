Actor Hectebus : Fatso 21036
{
  Health 600
  Speed 6
  PainChance 120
  PainChance "SoulToxic", 30
  PainChance "FiendFire", 30
  DropItem "LifeEssence" 80
  DropItem "ArmorBonusMax" 80
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  BloodColor "30 30 30"
  Species "Fatsos"
  +MISSILEMORE
  ActiveSound "manc/idle"
  Obituary "$CFHectebusObit"
  Tag "$CFFatso"
  var int user_loop;
  States
  {
  Spawn:
    TABU A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TABU CC 8 A_Look
	TABI CC 8 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    TABU AABBCCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("BeefyStep",0,0,5,0,0,-20)
    TABU EEFF 3 A_Chase
    Loop
  Missile:
	TNT1 A 0 A_JumpIfCloser(260,"Flamethrowers")
  Normal:
    TNT1 A 0 A_PlaySound("fatso/raiseguns")     
    TABU G 15 A_FaceTarget
	TNT1 A 0 A_CustomMissile("HectebusBall", 30, 30, 0)
    TABU H 6 Bright A_CustomMissile("HectebusBall", 30, -30, 12)
    TABU IG 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("HectebusBall", 30, 30, -12)
    TABU H 6 Bright A_CustomMissile("HectebusBall", 30, -30, 0)
	TABU IG 12 A_FaceTarget
    TNT1 A 0 A_CustomMissile("HectebusBall", 30, 30, -6)
	TABU H 2 Bright A_CustomMissile("HectebusBall", 30, -30, 6)
	TNT1 A 0 A_CustomMissile("HectebusBall", 30, 30, -12)
    TABU H 4 Bright A_CustomMissile("HectebusBall", 30, -30, 12)	   
	TABU IG 12
    Goto See
  Flamethrowers:
    TNT1 A 0 A_Jump(82,"Normal")
	TNT1 A 0 A_PlaySound("hectebus/flameready")
	TABU GG 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fatsofire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FlamethrowersLoop:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("HectebusFlamethrower", 30, 30, frandom(-6, 6), CMF_AIMOFFSET)
    TABU H 1 Bright A_CustomMissile("HectebusFlamethrower", 30, -30, frandom(-6, 6), CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 21,1)
	Goto FlamethrowersLoop
	TABU IG 12
	Goto See
  Pain:
    TABU J 6 A_Pain
    Goto See  
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    TABU K 6
    TABU L 6 A_Scream
    TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TABU M 6 A_NoBlocking
    TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    TABU NOPQRS 6
    TABU T -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    TABU SRQPONMLK 6
    Goto See
  }
}

