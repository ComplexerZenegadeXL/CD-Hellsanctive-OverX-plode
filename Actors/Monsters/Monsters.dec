  PainChance "SoulToxic", 15
  PainChance "FatFlamer", 15
  PainChance "FiendFire", 15
  PainChance "Explosion", 80
  Species "Cybers"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "MissileBoxPickup" 128 20
  DropItem "HomingRocketLauncherGiver" 100
  Obituary "$CFAnnihilatorObit"
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.5
  DamageFactor "PDTBFGTracer", 0.8
  DamageFactor "DBFG2", 0.0
  DamageFactor "CyberRocket", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "HFCyb3r", 0.0
  SeeSound "monsters/clsee"
  PainSound "monsters/cyberlordpain"
  DeathSound "monsters/cldie"
  Tag "$CFAnni"
  States 
  {    
  Spawn: 
    ANNI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ANNI AA 10 A_Look
	ANII AA 10 A_Look
    Loop 
  See: 
    ANNI A 3 A_PlaySound("monsters/clhoof")
    ANNI ABB 3 A_Chase		
    ANNI C 3 A_PlaySound("monsters/clhoof") 
    ANNI CDD 3 A_Chase 		 
    Loop 
  Missile:
	TNT1 A 0 A_JumpIfCloser(400,"Grenadier")
  Normal:
    TNT1 A 0 A_Jump(128,"Seekers")
    ANNI E 12 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordRocket", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordRocket", 56, -26, 0)
    ANNI E 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordRocket", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordRocket", 56, -26, 0)
    ANNI E 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordRocket", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordRocket", 56, -26, 0)
	ANNI E 12
	TNT1 A 0 A_Jump(128,"Seekers")
    Goto See
  Seekers:
	ANNI E 12 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordHomer", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordHomer", 56, -26, 0)
    ANNI E 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordHomer", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordHomer", 56, -26, 0)
    ANNI E 10 A_FaceTarget
    TNT1 A 0 A_CustomMissile("CyberLordHomer", 56, 26, 0)
    ANNI F 10 Bright A_CustomMissile("CyberLordHomer", 56, -26, 0)
	ANNI E 12
	Goto See
  Grenadier:
	TNT1 A 0 A_Jump(178,"Normal")
    ANNI E 12 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    TNT1 A 0 A_CustomMissile("CyberLordGrenade", 56, 26, 0, CMF_AIMOFFSET, 4.328125)
    ANNI F 10 Bright A_CustomMissile("CyberLordGrenade", 56, -26, 0, CMF_AIMOFFSET, 4.328125)
	ANNI E 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    TNT1 A 0 A_CustomMissile("CyberLordGrenade", 56, 26, 0, CMF_AIMOFFSET, 4.328125)
    ANNI F 10 Bright A_CustomMissile("CyberLordGrenade", 56, -26, 0, CMF_AIMOFFSET, 4.328125)
	ANNI E 12
	Goto See
  Pain:
	TNT1 A 0 A_Jump(61,"PainMissile")
    ANNI G 10 A_Pain
    Goto See
  PainMissile:
	ANNI G 10 A_Pain
    Goto Missile
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(128,2)
	"####" "#" 0 A_SpawnItemEx("GrenadeLauncherGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("GrenadeLauncherGiver",0,0,12,0,0,0,0)
	ANNI G 10 A_Scream
	ANNI H 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ANNI IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ANNI JJJJJ 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    ANNI KKKKK 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), 2, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ANNI LLLLL 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ANNI MMMMM 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    ANNI NO 5
    ANNI P -1
    Stop	
  Crush:
	BOCR A -1 A_PlaySound("gib/squish")
	Stop
  }
}	

Actor CyberLordRocket : CFZombieRocket
{
  Radius 11
  Height 8
  Speed 20
  FastSpeed 24
  Species "Cybers"
  -THRUSPECIES
  +DONTHARMSPECIES
}

Actor CyberLordHomer : CadaverRocket
{
  Radius 9
  Height 8
  Speed 20
  FastSpeed 24
  Species "Cybers"
  Damage (Random(20,50))
  DamageType "Cyber10K"
  +DONTHARMSPECIES
  SeeSound "monster/homingrockfire"
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpawnLoop:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	HMIS A 3 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto SpawnLoop
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), 2, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(64,128,0)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

