Actor DiabFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("Kaboom3",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(2,4),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("DiabFire",frandom(-16,16),frandom(-16,16),frandom(6,12),0,0,frandom(4,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor DarkHellion : Exile 21584 
{
  Health 1000
  GibHealth 90
  DropItem "LifeEssence" 160
  DropItem "ArmorBonusMax" 160
  DropItem "HellionRegen" 166 1
  Obituary "$CFDarkHellionObit"
  Scale 1.1
  PainChance "Mine", 128
  PainChance "SoulToxic", 1
  PainChance "FatFlamer", 1
  PainChance "FiendFire", 1  
  SeeSound "monster/hlnsit" 
  ActiveSound "monster/hlnact" 
  PainSound "monster/hlnpai"
  DeathSound "monster/hlndeth"
  BloodColor "Black"
  Tag "$CFDhellion"
  var int user_loop;
  var int user_script;
  var int user_script_type;
  States 
  { 
  Spawn: 
  	HELN A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,34)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",33)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    HELN AA 4 A_Look 
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HELN AABBCCDD 2 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(64,"Rush")
    TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    HELN AABBCCDD 2 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    HELN EEFF 2 A_VileChase
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
