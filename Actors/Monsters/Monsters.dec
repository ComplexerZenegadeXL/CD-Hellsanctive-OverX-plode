Actor BabySentient : Dualachnotron 23333
{
  Health 1250
  PainChance 60
  Scale 1.25
  Speed 12
  Radius 52
  Mass 2500
  FloatSpeed 8
  SeeSound "barachnophyte/sight"
  PainSound "barachnophyte/pain"
  DeathSound "barachnophyte/death"
  AttackSound ""
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "ExplosiveMinigunGiver" 64
  DamageFactor "Baby15K", 0.0
  Species "BabySpiders"
  +MISSILEMORE
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY	
  -FLOORCLIP
  Obituary "$CFBabySentientObit"
  Tag "$CFBabyS"
  var int user_script;
  var int user_script_type;
  var int user_lowlag;	
  States
  {
  Spawn:
	MARP A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,16)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",15)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	MARP AB 2 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	MARP AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_script_type",15)
	MARP AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(12,"Evade")
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,"Evade2")
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	MARP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Evade2:
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	MARP ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Pause:
	MARP ABAB 2 Bright
	Goto See
  Missile:
    TNT1 A 0 A_Jump(84,"BFG10K")
  Normal:
    TNT1 A 0 A_PlaySound("monsters/darkmasterwind")
    MARP ABABABA 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkmasterwind2")
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 8, 8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
    MARP K 2 Bright A_CustomMissile("BabySentientExplosiveTracer",20,0,frandom(-8,8),0)
    MARP K 2 Bright
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 8, -8, 18, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)	
    MARP L 2 Bright A_CustomMissile("BabySentientExplosiveTracer",20,0,frandom(-8,8),0)
	MARP L 2 Bright
	TNT1 A 0 A_Jump(3,"Pause","BFG10K")
    TNT1 A 0 A_SpidRefire
    Goto Normal+15
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    MARP CCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    MARP D 2 Bright A_CustomMissile("BabySent10K",20,0,frandom(-4,4)) 
	MARP DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    MARP D 2 Bright A_CustomMissile("BabySent10K",20,0,frandom(-4,4)) 
	MARP DC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    MARP D 2 Bright A_CustomMissile("BabySent10K",20,0,frandom(-4,4)) 
	MARP D 2 Bright A_FaceTarget
    MARP C 2 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	MARP C 18 Bright
    Goto See
  Pain:
    TNT1 A 0 A_Jump(104,"PainMissile")
    MARP A 3 Bright A_Pain
	MARP A 3 Bright
    Goto See
  PainMissile:
    MARP A 3 Bright A_Pain
	MARP A 3 Bright
    Goto Missile
  Death:
    MARP A 20 Bright A_Scream
    MARP E 6 Bright A_Fall
	MARP F 6 Bright
	TNT1 AAA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MARP GGGGG 2 Bright A_CustomMissile("CFKaboom2", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    MARP H 6 Bright
    MARP I 4
	MARP J 2
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    MARP JIHGFE 5
    Goto See
  }
}

