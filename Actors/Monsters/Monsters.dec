	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("GhostFire",frandom(-10,-20),frandom(-6,6),frandom(56,66),0,0,frandom(1,2),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

