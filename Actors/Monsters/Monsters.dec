  Idle:
	HTL1 A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_SpawnItemEx("HitlerSuitStep",0,0,5,0,0,-20)
    HTL1 AAAAAAABBBBBBB 1 A_Chase
