Actor PainInTheAssImp : Imp
{
  States
  {
  Death.PlayerLegendary:
	TNT1 A 0
	Goto RealDeath
  Death:
	TROO I 8
    TROO J 8 A_Scream
    TROO K 6
    TROO L 6 //A_NoBlocking
    TROO M 35
	TROO M 0 A_SpawnItemEx("ResRadius",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,0)  //A_GiveInventory("MonsterResurrector",1)
	TROO M -1
	Stop
  RealDeath:
	TROO I 8
    TROO J 8 A_Scream
    TROO K 6
    TROO L 6 A_NoBlocking
    TROO M -1
    Stop
  XDeath.PlayerLegendary:
	TNT1 A 0
	Goto RealXDeath
  XDeath:
    TROO N 5
    TROO O 5 A_XScream
    TROO P 5
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    TROO Q 5 //A_NoBlocking
    TROO RST 5
    TROO U 35
	TROO U 0 A_SpawnItemEx("ResRadius",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_SETMASTER,0)  //A_GiveInventory("MonsterResurrector",1)
	TROO U -1
	Wait
  RealXDeath:
	TROO N 5
    TROO O 5 A_XScream
    TROO P 5
    TROO Q 5 A_NoBlocking
    TROO RST 5
    TROO U -1
    Stop
  Heal:
  Raise:
	TNT1 A 0 A_ChangeFlag("COUNTKILL",0)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	TROO ML 8
    TROO KJI 6
    Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TROO UTSRPON 5
    Goto See
  }
}

Actor ResRadius
{
  Radius 4
  Height 4
  //Projectile
  //Speed 0
  +NORADIUSDMG
  +ISMONSTER
  +INVULNERABLE
  +THRUACTORS
  +NOCLIP
  -COUNTKILL
  States
  {
  Spawn:
	TNT1 AAAAA 2 A_VileChase
	Stop
  Heal:
	TNT1 A 1
	Stop
  }
}

Actor MonsterResurrector : CustomInventory
{
  States
  {
  Spawn:
	TNT1 A 0
	Stop
  Pickup:
	TNT1 AAAAA 2 A_VileChase
	Stop
  }
}

/*
//===============
// Darksyde Phil
//===============

Actor DSP : CommanderKeen replaces CommanderKeen
{
  Scale 0.6
  Height 62
  PainSound "DSP/Pain"
  DeathSound "DSP/Death"
  +DONTFALL
  Tag "Darksyde Phil"
  States
  {
  Spawn:
    KEEN A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	KEEN A 10 A_Jump(20,"BloodDrip")
    Loop
  BloodDrip:
    TNT1 A 0
    KEEN A 1 A_SpawnItemEx("DSPBloodDrop",frandom(-6,6),frandom(-6,6),frandom(-2,-8),0,0,0,0,SXF_CLIENTSIDE)
	Goto Spawn
  Pain:
    KEEN B 4 A_Pain
	KEEN CDBCDBCDBCDBCD 4
    Goto Spawn
  Death: 
	KEEN B 4 A_Scream
    KEEN CDBCDBCDBCDBCDBCDBCDBCDBCDBCDBCDBCD 4
	TNT1 A 0 A_KeenDie
	TNT1 A 0 A_PlaySound("DSP/ForcedLaugh")
	KEEN EFGHIEFGHI 2 A_SpawnItemEx("DSPBloodDrop",frandom(-6,6),frandom(-6,6),frandom(2,8),0,0,0,0,SXF_CLIENTSIDE)
	KEEN EFGHIEFGHIEFGHIEFGHIEFGHI 1 A_SpawnItemEx("DSPBloodDrop",frandom(-6,6),frandom(-6,6),frandom(2,8),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("misc/gibbed")
	TNT1 A 0 A_SpawnItemEx("DSPGoreGenerator",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION,0)	
    TNT1 A 0 A_NoBlocking
	KEEN J 25
    KEEN JJJJ 50 A_SpawnItemEx("DSPBloodDrop",frandom(-2,2),frandom(-2,2),frandom(2,8),0,0,0,0,SXF_CLIENTSIDE)
	KEEN J -1
    Stop
  }
}
