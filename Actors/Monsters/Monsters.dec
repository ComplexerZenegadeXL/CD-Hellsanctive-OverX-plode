Actor BruiserMissile : CadaverRocket
{
  Radius 11
  Height 8
  Scale 1
  Damage (Random(20,50))
  Speed 20
  FastSpeed 24
  DamageType "NobleComet"
  SeeSound "monster/homingrockfire"
  var int user_loop;
  States
  {
  Spawn:
  Homing:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HomingLoop:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto HomingLoop
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(64,128,0)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

