  PainChance "FatFlamer", 50
  PainChance "FiendFire", 50
  MeleeDamage 4
  Species "Fiends"
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DropItem "LifeEssence" 60
  DropItem "ArmorBonusMax" 60
  Monster
  +FLOORCLIP
  +DONTHURTSPECIES
  +FASTMELEE
  +FASTER
  MaxTargetRange 200
  SeeSound "demon/sight"
  PainSound "demons/pain"
  DeathSound "demon/death"
  ActiveSound "demon/active"
  AttackSound "demon/melee"
  Obituary "$CFBullFiendObit"
  HitObituary "$CFBullFiendHitObit"
  Tag "$CFFiend"
  States 
  { 
  Spawn:
    SAI2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	SAR2 A 12 A_Look
	SAI2 A 12 A_Look
    Loop
  See: 
    SAR2 AABB 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    SAR2 CCDD 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("HeavyFleshStep",0,0,5,0,0,-20)
    Loop 
  Melee: 
    SAR2 EF 5 A_FaceTarget
    SAR2 G 4 A_MeleeAttack
    SAR2 E 5 A_FaceTarget
    Goto See
  Missile:
	TNT1 A 0 A_JumpIfCloser(200,1)
	Goto See
	TNT1 A 0 A_PlaySound("demon/melee")
	SAR2 EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	SAR2 F 2 A_Recoil(-24)
	SAR2 F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	SAR2 G 6
	SAR2 G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	SAR2 G 1 A_ScaleVelocity(0)
	Goto See
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    SAR2 H 4 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
    SAR2 I 5  A_ChangeFlag(SLIDESONWALLS,0)
    SAR2 J 5 A_Scream
    SAR2 K 4
    SAR2 L 4 A_NoBlocking     
    SAR2 M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SAR2 N -1 
    Stop
  XDeath:
	SAR2 I 3 A_ChangeFlag(SLIDESONWALLS,0)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    SA2X A 3 A_XScream
    SA2X B 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SA2X C 3 A_NoBlocking
    SA2X D 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	SA2X EFG 3
    SA2X H -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    SAR2 NMLKJI 5 
    Goto See 
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	SA2X HGFEDCBA 4
	Goto See
  }
}

