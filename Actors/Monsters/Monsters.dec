	TNT1 A 0 A_PlaySound("dualach/plasma")
    TNT1 A 0 A_CustomMissile("DualaPlasma",30,-12,0,CMF_AIMOFFSET)
    CSPI E 3 Bright A_CustomMissile("DualaPlasma",30,12,0,CMF_AIMOFFSET)
	CSPI M 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("dualach/plasma")
    TNT1 A 0 A_CustomMissile("DualaPlasma",30,-12,0,CMF_AIMOFFSET)
    CSPI E 3 Bright A_CustomMissile("DualaPlasma",30,12,0,CMF_AIMOFFSET)
    TNT1 A 0 A_SpidRefire
	CSPI M 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("dualach/plasma")
    TNT1 A 0 A_CustomMissile("DualaPlasma",30,-12,0,CMF_AIMOFFSET)
    CSPI E 3 Bright A_CustomMissile("DualaPlasma",30,12,0,CMF_AIMOFFSET)
	CSPI M 3 A_FaceTarget
