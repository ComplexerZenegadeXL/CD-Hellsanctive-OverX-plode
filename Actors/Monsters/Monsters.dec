  {
  Spawn:
    HED4 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HED4 A 1 A_Look
	Loop
  See:
    HED4 A 3 A_Chase
	TNT1 A 0 A_Jump(6,"Evade")		 
     Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
	HED4 AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
	HED4 AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See		 
  Missile:
    TNT1 A 0 A_Jump(128,"Seeking")
  Normal:
    HED4 BC 6 A_FaceTarget
    HED4 D 2 Bright A_FaceTarget
	HED4 D 1 Bright A_CustomMissile("WatcherBall",24,0,0,0,0)
    TNT1 A 0 A_CustomMissile("WatcherBall",24,0,6,0,0)
    HED4 D 1 Bright A_CustomMissile("WatcherBall",24,0,-6,0,0)
	HED4 CB 4
	TNT1 A 0 A_Jump(87,"Seeking")
	Goto See
  Seeking:
    HED4 BC 6 A_FaceTarget
    HED4 D 4 Bright A_CustomMissile("WatcherTracer",24,0,0,0,0)
    HED4 CB 4
    Goto See
  Pain:
