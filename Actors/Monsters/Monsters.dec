	TNT1 AA 0 A_CustomBulletAttack(10.5,0,1,Random(12,20),"SSBulletPuff",0,CBAF_NORANDOM)
    HTL1 G 3 Bright A_PlaySoundEx("hitler/fire","Weapon")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto ChaingunLoop
	HTL1 E 15
    Goto See
  Rockets:
    HTL1 EE 10 A_FaceTarget
	HTL1 F 3 Bright A_PlaySoundEx("hitler/fire","Weapon")
	TNT1 A 0 A_CustomMissile("HitlerRocket",30,-15,0)
	TNT1 A 0 A_CustomMissile("HitlerRocket",30,15,0)
