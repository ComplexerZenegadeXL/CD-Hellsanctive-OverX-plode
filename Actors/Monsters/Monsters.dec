Actor DarkCyberdemon : CFAnnihilator 26456
{
  Health 5000
  PainChance 40
  PainChance "PDTBFG", 20
  PainChance "SoulToxic", 10
  PainChance "FatFlamer", 10
  PainChance "FiendFire", 10
  PainChance "Explosion", 70
  Speed 18
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.35
  DamageFactor "PDTBFGTracer", 0.7
  DamageFactor "Cyber10K", 0.0
  Species "Cybers"
  DropItem "BossLifeEssence" 162 25
  DropItem "BossArmorBonusMax" 162 1
  DropItem "NewCellPackPickup" 186 300
  Obituary "$CFDarkCyberdemonObit"
  +MISSILEEVENMORE
  SeeSound "monsters/darkcybersee"
  PainSound "monster/psopain"
  DeathSound "monsters/darkcyberdie"
  BloodColor "Green"
  Tag "$CFDCyb"
  var int user_lowlag;
  var int user_loop;
  States 
  {    
  Spawn: 
    CBEP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CBEP AA 10 A_Look
	CBEI AA 10 A_Look
    Loop 
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CBEP ABBCC 3 A_Chase
	CBEP D 3 A_Metal
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)	
	TNT1 A 0 A_Jump(87,"Rush")
	CBEP A 3 A_Hoof
	CBEP ABBCC 3 A_Chase
	CBEP D 3 A_Metal
	CBEP D 3 A_Chase
	Loop	
  Rush:
	TNT1 A 0 A_Hoof
	CBEP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP B 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP C 2 A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	CBEP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("DarkCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(87,"See")		
	Loop
  Missile:
    TNT1 A 0 A_Jump(128,"HomingRockets","FloorStomp","Railgun","BFG15K")
  Rockets:
	CBEP E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RocketsLoop:
    CBEP F 6 Bright A_CustomMissile("DarkCyberRocket", 52, -25, frandom(-6, 6))
    CBEP E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    CBEP F 6 Bright A_CustomMissile("DarkCyberRocket", 52, -25, Random(-6, 6))
	CBEP E 10
	TNT1 A 0 A_Jump(128,"HomingRockets","FloorStomp","Railgun","BFG15K")
	Goto See
  HomingRockets:
	CBEP E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HomingRocketsLoop:
    CBEP F 6 Bright A_CustomMissile("DarkCyberHomer", 52, -25, frandom(-8, 8))
    CBEP E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    CBEP F 6 Bright A_CustomMissile("DarkCyberHomer", 52, -25, frandom(-8, 8))
	CBEP E 10
	TNT1 A 0 A_Jump(128,"FloorStomp","Railgun","BFG15K")
	Goto See		
  FloorStomp:
    CBEP G 10 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("DarkCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CBE3 G 3 Bright A_PlaySoundEx("DarkCyber/Laugh","Voice")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FloorStompLoop:
	TNT1 A 0 A_FaceTarget
	CBE3 G 3 Bright A_SpawnItemEx("DarkCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_UnsetInvulnerable
	CBEP G 7 A_FaceTarget
	CBE3 A 5 A_FaceTarget
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	CBE3 B 6 A_PlaySound("monsters/darkcyberstomp")
	CBE3 B 2 A_CustomMissile("DarkCyberFireSpawner",0,0,0,0)
	TNT1 A 0 A_CustomMissile("DarkCyberFireSpawner",0,0,15,0)
	CBE3 B 2 A_CustomMissile("DarkCyberFireSpawner",0,0,-15,0)
	TNT1 A 0 A_CustomMissile("DarkCyberFireSpawner",0,0,30,0)
	CBE3 B 2 A_CustomMissile("DarkCyberFireSpawner",0,0,-30,0)
	TNT1 A 0 A_CustomMissile("DarkCyberFireSpawner",0,0,45,0)
	CBE3 B 2 A_CustomMissile("DarkCyberFireSpawner",0,0,-45,0)	
	CBE3 B 20
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_Jump(128,"Railgun","BFG15K")
    Goto See		
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    CBEP EE 10 A_FaceTarget
	CBEP E 10 Bright A_FaceTarget
    CBEP F 10 Bright A_CustomMissile("DarkCyberRail",52,-25)
	CBEP E 15
	TNT1 A 0 A_Jump(128,"BFG15K")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	CBEP E 18 Bright A_FaceTarget
	CBEP E 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15KRocketsLoop:
	CBEP F 4 Bright A_CustomMissile("DarkCyber15K",52,-25,frandom(-4, 4))	
	CBEP E 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	CBEP F 4 Bright A_CustomMissile("DarkCyber15K",52,-25,frandom(-4, 4))
	CBEP E 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)	
	Goto See		
  Pain:
	TNT1 A 0 A_Jump(87,"PainMissile")
    CBEP G 10 A_Pain
    Goto See
  PainMissile:
	CBEP G 10 A_Pain
    Goto Missile
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(128,2)
	"####" "#" 0 A_SpawnItemEx("BFG10KGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,0,12,0,0,0,0)
	CBEP G 10 A_Scream
