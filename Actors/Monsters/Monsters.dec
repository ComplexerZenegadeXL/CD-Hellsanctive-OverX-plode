	SUPR A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,36)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	SUPR AB 2 Bright A_Look
	Loop
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	SUPR AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)				  
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	SUPR AB 2 Bright A_Chase
	TNT1 A 0 A_Jump(26,"Evade")	
	Loop
  Evade:
	TNT1 A 0 A_SetUserVar("user_script_type",36)
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	SUPR ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	SUPR ABABABAB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K","DTBFG10K")
  Normal:
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto BFG9K
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	SUPR AAA 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, 12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	SUPR F 3 Bright A_CustomMissile("SentientExplosiveTracer",36,0,frandom(-8,8),0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	SUPR E 4 Bright A_CustomMissile("SentientExplosiveTracer",36,0,frandom(-8,8),0)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(3,"See","BFG9K","BFG10K","DTBFG10K")
    TNT1 A 0 A_SpidRefire
	Goto Normal+7
  BFG9K:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	SUPR NNNNNNOO 4 Bright A_FaceTarget
	SUPR O 2 Bright A_CustomMissile("SentientBFG9500Ball", 34, 0, 0)
	SUPR NNN 2 Bright
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	SUPR NNNNNNOO 4 Bright A_FaceTarget
	SUPR O 2 Bright A_CustomMissile("SentientBFG9500Ball", 34, 0, 0)
	SUPR N 14 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See	
  BFG10K:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	SUPR NNNN 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 4 Bright A_FaceTarget	
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 4 Bright A_FaceTarget	
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    SUPR O 3 Bright A_CustomMissile("Sentient10K", 42, 0, frandom(-4, 4))
	SUPR N 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	SUPR N 15 Bright
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See
  DTBFG10K:
	TNT1 A 0 A_SetUserVar("user_script_type",35)
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	SUPR NNNNNOO 4 Bright A_FaceTarget
	SUPR O 2 Bright A_CustomMissile("SentientDTBFG10KBall", 34, 0, 0)
	SUPR N 24 Bright
	Goto See	
  Pain:
	TNT1 A 0 A_Jump(16,"PainResurrect")
	TNT1 A 0 A_Jump(128,"PainMissile")
	SUPR A 3 Bright A_SetUserVar("user_script_type",35)
	SUPR A 3 Bright A_Pain	
	Goto See
  PainMissile:
	SUPR A 3 Bright A_SetUserVar("user_script_type",35)
	SUPR A 3 Bright A_Pain
	Goto Missile
  PainResurrect:
	SUPR A 3 Bright A_SetUserVar("user_script_type",35)
	SUPR A 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("SentientToken",3,"See")	
	SUPR A 12 Bright
	TNT1 A 0 A_GiveInventory("SentientToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
	TNT1 A 0 A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    SUPR P 3 Bright A_PlaySound("sentient/laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrectionEffect",10,0,user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop")
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrectionEffect",10,0,(user_loop * 30) - 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop3:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop3")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop4:
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 10,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop4")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop5:
	TNT1 A 0 Bright A_CustomMissile("SentientMassResurrection",10,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop5")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop6:
	SUPR P 3 Bright A_SpawnItemEx("SentientBrainSFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 11,1)
	Goto PainResurrectLoop6
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	SUPR A 3 Bright
	Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(238,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"####" "#" 0 A_KillMaster
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(52,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechBFG10KGiver",0,0,12,0,0,0,0)
	TNT1 A 0 A_Scream
	SUPR H 20 Bright A_Fall
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SUPR IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    SUPR JJJJJ 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SUPR KKKKK 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SUPR LLLLL 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	SUPR LM 5
	Stop
  }
}

