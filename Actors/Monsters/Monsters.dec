	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(36,44),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",10,24,40,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE)
