    HELN C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("HellionFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    HELN E 1 A_VileChase
