    TNT1 A 0 A_Jump(87,"PainMissile")
    MSPI I 12 A_Pain
    Goto See
  PainMissile:
	MSPI I 12 A_Pain
    Goto Missile
  Death:
    MSPI I 20 A_Scream
	MSPI J 6
	TNT1 AAA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	MSP2 KKKKK 2 Bright A_CustomMissile("CFKaboom2", frandom(20,40), frandom(-10,10), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    MSPI L 6 A_NoBlocking
    MSPI MN 6
    MSPI O 6
    MSPI P -1 A_KillMaster
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    MSPI PONMLKJ 5
    Goto See
  }
}

