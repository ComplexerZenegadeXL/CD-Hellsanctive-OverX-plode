	TNT1 A 0 A_JumpIfCloser(350,1)
	Goto See
	TNT1 A 0 A_PlaySound("magma/attack")
	SAR4 EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	SAR4 F 2 A_Recoil(-28)
	SAR4 F 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	SAR4 G 6
	SAR4 G 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	SAR4 G 1 A_ScaleVelocity(0)
	Goto See
  Pain: 
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
    SAR4 H 4 A_Pain
    Goto See
  Death:
  XDeath:
    SAR4 I 5 A_ChangeFlag(SLIDESONWALLS,0)
    SAR4 J 5 A_Scream
    SAR4 K 4
    SAR4 L 4 A_NoBlocking     
    SAR4 M 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    SAR4 N -1 
    Stop
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    SAR4 NMLKJI 5 
    Goto See  
  }
}
