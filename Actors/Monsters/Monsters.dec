	HED4 CB 4 A_FaceTarget
    Goto See
  Death:
    HED4 G 7 A_Scream
    HED4 H 7 A_NoBlocking
	HED4 I 6
	HED4 J 5
	HED4 K 4
	HED4 L -1
	Stop
  XDeath:
	H4XD A 4
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	H4XD B 3 A_PlaySound("Gore/Splat")
	H4XD C 3 A_SpawnItemEx("WatcherGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	H4XD D 3 A_NoBlocking
	H4XD EFGHI 3
	H4XD J -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	HED4 LKJIHG 5
	Goto See         
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	H4XD JIHGFEDCBA 4
	Goto See
  }
}

