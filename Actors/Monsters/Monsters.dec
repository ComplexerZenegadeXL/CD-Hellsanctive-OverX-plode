  Projectile:
	TERR AAA 4 Bright A_FaceTarget
	TERR B 2 Bright A_CustomMissile("SoulBall", 10, 0, 0, 1)
	TERR BBA 2 Bright
	Goto See
  Charge:
	TERR AAA 4 Bright A_FaceTarget
	TERR B 2 Bright A_SkullAttack(15)
    TERR B 2 Bright
    Goto Charge+4
  Pain:
