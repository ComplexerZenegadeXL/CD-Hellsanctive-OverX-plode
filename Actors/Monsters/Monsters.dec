    ASGZ AABB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    ASGZ CCDD 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("Footstep",0,0,5,0,0,-20)
    Loop
  Pause:
    ASGZ E 20
	Goto See
  Missile:
    ASGZ E 15 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ShellCasing", -8, 7, 30, 4, 0, frandom(3, 4), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(28,34),0,frandom(-6,6),0)
    ASGZ F 4 Bright A_CustomBulletAttack(22.5,18.3,4,Random(9,15),"BulletPuff",0,CBAF_NORANDOM)
    ASGZ E 8 A_FaceTarget
	TNT1 A 0 A_Jump(80,"Pause")	
	TNT1 A 0 A_CPosRefire
    Goto Missile+1
  Pain:
    ASGZ G 6 A_Pain
    Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(238,2)
	"####" "#" 0 A_SpawnItemEx("AssaultShotgunGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(238,2)
	TNT1 A 0 A_SpawnItemEx("AssaultShotgunGiver",0,0,12,0,0,0,0)
    ASGZ H 5
    ASGZ I 5 A_Scream
    ASGZ J 5 A_Fall
    ASGZ K 5 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ASGZ L 5
	ASGZ M 5
	ASGZ N -1
    Stop
  XDeath:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(242,2)
	TNT1 A 0 A_SpawnItemEx("AssaultShotgunGiver",0,0,12,0,0,0,0)
    ASGZ O 3 A_GiveInventory("XDeathCheck",1)
    ASGZ P 3 A_XScream
    ASGZ Q 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    ASGZ R 3 A_Fall
    ASGZ STUV 3
    ASGZ W -1 
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    ASGZ NMLKJIH 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	ASGZ WVUTSRQPO 4
	Goto See  
  }
}

