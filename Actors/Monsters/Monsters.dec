Actor Cybruiser : CFBaronOfHell 21152
{ 
  Health 1500
  PainChance 70
  MeleeDamage 8
  Scale 1.1
  Species "Nobles"
  Obituary "$CFCybruiserObit"
  HitObituary "$CFCybruiserHitObit"
  SeeSound "cbaron/sight" 
  PainSound "blooddemon/pain"
  DeathSound "monster/brudth"
  MeleeSound "baron/melee"
  ActiveSound "cbaron/active"
  DamageFactor "NobleComet", 0.0
  DropItem "LifeEssence" 160
  DropItem "ArmorBonusMax" 160
  +MISSILEMORE
  +DONTHURTSPECIES
  +FASTMELEE
  Tag "$CFCybruiser"
  States 
  { 
  Spawn: 
    BRUS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BRUS AA 7 A_Look
	BRUI AA 7 A_Look	
    Loop 
  See:
    BRUS AABB 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    BRUS CCDD 3 A_Chase
    TNT1 A 0 A_Playsound("monster/bruwlk")
    Loop
  Missile:
    TNT1 A 0 A_Jump(128,"Rockets","HomingRockets","BFG15K")
  Normal:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    BRUS EE 10 A_FaceTarget
	BRUS E 2 A_FaceTarget
	BRUS E 1
	TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("RailgunImpact",30)
    BRUR A 5 Bright A_CustomRailgun(Random(40, 60), 0, "00 85 FF", None, 1, 1, 0, "BruiserRailPuff")
    BRUS E 20
	TNT1 A 0 A_Jump(87,"Rockets","HomingRockets","BFG15K")
	Goto See
  Rockets:
    BRUS E 10 A_FaceTarget 
    BRUS F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    BRUS E 10 A_FaceTarget
    BRUS F 8 Bright A_CustomMissile("CyNobleRocket",32,0,0,0)
    BRUS E 10
	TNT1 A 0 A_Jump(87,"HomingRockets","BFG15K")
    Goto See
  HomingRockets:
    BRUS E 10 A_FaceTarget 
    BRUS F 8 Bright A_CustomMissile("BruiserMissile",32,0,0,0)
    BRUS E 10 A_FaceTarget
    BRUS F 8 Bright A_CustomMissile("BruiserMissile",32,0,0,0)
    BRUS E 10
	TNT1 A 0 A_Jump(87,"BFG15K")
    Goto See	
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    BRUS E 18 A_FaceTarget
	BRUS E 6 A_FaceTarget
    BRUS F 4 Bright A_CustomMissile("Cybruiser15K",32,0,frandom(-4,4))	
	BRUS E 4 A_FaceTarget
    BRUS F 4 Bright A_CustomMissile("Cybruiser15K",32,0,frandom(-4,4))
	BRUS E 4 A_FaceTarget
    BRUS F 4 Bright A_CustomMissile("Cybruiser15K",32,0,frandom(-4,4))
	BRUS E 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	Goto See
  Melee:
    BRUS GH 7 A_FaceTarget
    BRUS I 7 A_MeleeAttack
    Goto See
  Pain: 
    TNT1 A 0 A_Jump(87,"MissilePain")
    BRUS J 4 A_Pain
    Goto See
  MissilePain:
    BRUS J 4 A_Pain
    Goto Missile	
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(54,2)
	"####" "#" 0 A_SpawnItemEx("RailgunGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  XDeath:
  Death: 
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(54,2)
	TNT1 A 0 A_SpawnItemEx("RailgunGiver",0,0,12,0,0,0,0)
    BRUD K 20 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	BRUD KKKLLL 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	BRUD MMMNNN 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	BRUD OOOPPP 2 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRUD Q 4 Bright A_NoBlocking
    BRUD R 3 Bright 
	BRUS S 3
    BRUS T -1 
    Stop
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
    BRUS S 4 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	BRUD RQPONMLK 4
	Goto See
  } 
}

