Actor CFZombieRocket : NewRocket
{
  Damage (Random(20,50))
  DamageType "ZombieRocket"
  -THRUSPECIES
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("RocketSpawnerExplodeFX", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 A 0 A_Explode(64,128,0)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor RocketSpawnerExplodeFX : CFSpawnerFXBase
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
