  Actor LegendaryRedeemer 16507
  {
  //$Category Monsters/LCA
  //$Sprite LREDA1
  //$Title "Legendary Redeemer"
  Monster
  Health 1400
  Radius 31
  Height 56
  Mass 400
  Speed 12
  PainChance 28
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +BOSS
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +NOTELEFRAG
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NORADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  BloodColor "Blue"
  Species "Cacodemon"
  DamageFactor 0.65
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.110
  DamageFactor "PlayerDevBall2", 0.110
  DamageFactor "PlayerDevTracer", 0.110
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LDemonAmmoPickup" 250
  DropItem "LDemonAmmoBoxPickup" 250
  DropItem "LegendaryPowerSphere" 65
  DropItem "LegendaryTimeFreezeSphere" 70
  DropItem "LegendarySphere" 140
  //DropItem "LegendaryPlasmaticRifleGiver" 180
  DropItem "LegendaryRandomSphere" 16
  SeeSound "redeemer/see"
  PainSound "redeemer/pain"
  DeathSound "redeemer/death"
  ActiveSound "redeemer/idle"
  Obituary "$CFLegendaryRedeemerObit"
  Tag "$CFLegRedeem"
  var int user_loop;
  var int user_delay;
  var int user_portal;
  var int user_suicide;
  var int user_timer;
  var int user_music;
  var int user_clone;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LRED A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    LRED A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LRED AAA 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,15)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
    LRED AAA 2 Bright A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Trap","Teleport")
    Loop
  SeeSuicide:
	TNT1 A 0 A_SetUserVar("user_effect_type",18)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LRED A 0 A_JumpIf(user_timer >= 390,"Explode")
	LRED A 0 A_SetUserVar("user_timer",user_timer+1)
    LRED A 3 Bright A_Chase("","Kamikaze")
    Loop	
  Rush:
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	LRED AA 0 A_Chase
    LRED A 1 Bright A_SpawnItemEx("LegendaryRedeemerGhost")
	TNT1 A 0 A_Jump(12,"See")
    Loop
  Avoid:
	LRED G 0
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	LRED G 0 A_SetAngle(angle+random(0,359))
	LRED G 0 A_Recoil(-50)
	LRED G 0 A_FaceTarget
	LRED GGGGGGGGGGGGG 1 A_SpawnItemEx("LegendaryRedeemerGhost2")
	TNT1 A 0 A_Jump(145,"See")
	LRED G 1 A_Stop
    Goto Avoid
  Teleport:
    LRED A 1 A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LRED AAAAAAAAAAA 1 A_FadeOut(0.1,0)
	LRED AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	LRED A 8
	LRED A 0 A_JumpIf(user_clone >= 3,9)
	LRED A 0 A_JumpIfCloser(2500,2)
	LRED A 0 A_Jump(256,7)
	LRED A 0 A_SpawnItemEx("FakeLegendaryRedeemer",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS,192)
	LRED A 0 A_SetUserVar("user_clone",user_clone+1)
	LRED A 8
	LRED AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LRED A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LRED AAA 0 A_SpawnItem("LRedeYSmokeSpawner",0,0,0,0)
	LRED AAAAAAAAAAA 1 A_FadeIn(0.1)
    LRED A 1 A_SetShootable
    Goto See		
  Trap:
    LRED B 0
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
    LRED B 0 A_SetAngle(random(0,359))
	LRED B 0 A_JumpIfCloser(2,2)
	LRED B 0 A_Jump(256,"See")
    LRED BC 5 Bright
	LRED D 0 A_PlaySound("reedemer/trap")
    LRED D 5 Bright A_SpawnItemEx("LegRedTrap",45,0,16,15)
    Goto See
  Melee:
  Missile:
	TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
    TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	TNT1 A 0 A_Jump(127,2)
	TNT1 A 0 A_JumpIfHealthLower(400,"Suicide")
	TNT1 A 0 A_JumpIfHealthLower(200,"Suicide")
    TNT1 A 0 A_Jump(127,"FastBall","Laser","Void","TrapAttack")
	TNT1 A 0 A_Jump(64,"Thunder","Storm")
	TNT1 A 0 A_Jump(48,"Portal")
  Normal:
    LRED BC 5 Bright A_FaceTarget
	LRED D 0 A_CustomMissile("LegRedBall",30,10,0,0,0)
    LRED D 0 A_CustomMissile("LegRedBall",30,-10,0,0,0)
	LRED D 0 A_CustomMissile("LegRedBall",20,10,0,0,0)
    LRED D 5 Bright A_CustomMissile("LegRedBall",20,-10,0,0,0)
	LRED D 0 A_Jump(127,"See","Avoid","Laser")
	LRED D 0 A_CposRefire
	LRED D 0 A_Jump(256,"Normal","FastBall")
    Goto Normal
  FastBall:
    LRED BC 5 Bright A_FaceTarget
    LRED D 5 Bright A_CustomMissile("LegRedFastBall",25,0,0,0,0)
	LRED D 0 A_Jump(127,"See","Avoid","Laser")
	LRED D 0 A_CposRefire
	LRED D 0 A_Jump(256,"Normal","FastBall")
    Goto FastBall
  Laser:
    LRED BC 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LaserLoop:
	LRED D 3 Bright A_CustomMissile("LegRedLaser",25,0,0,0,0)
	LRED D 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,1)
	Loop
	LRED D 0 A_Jump(127,"Void","Teleport")
    Goto See
  Void:
    TNT1 A 0 A_FaceTarget
    LRED B 10 Bright A_PlaySound("exile/voidstart")
    LRED C 8 Bright A_VileTarget("LegRedVoid")
    LRED DDDDDD 8 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
    LRED G 8 Bright
    LRED DCB 5 Bright
	LRED D 0 A_Jump(127,"TrapAttack","Avoid")
    Goto See
  TrapAttack:
    LRED BC 5 Bright A_FaceTarget
	LRED D 0 A_SpawnItemEx("LegRedTrap",45,0,16,15,-4)
	LRED D 0 A_SpawnItemEx("LegRedTrap",45,0,16,15,4)
    LRED D 5 Bright A_SpawnItemEx("LegRedTrap",45,0,16,15)
	LRED D 0 A_Jump(127,"Teleport")
	LRED D 0 A_Jump(64,"Storm","Thunder")
	LRED D 0 A_CposRefire
    Goto See
  Storm:
	LRED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LRED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("redeemer/see")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
	LRED EFFG 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  StormLoop:
	TNT1 A 0 A_VileTarget("LegRedStormBoltAttack")
	TNT1 AA 0 A_SpawnItemEx("LegRedStormBoltSpawner",frandom(-512,512),frandom(-512,512),0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	LRED G 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto StormLoop
	LRED G 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LRED G 0 A_Jump(127,"Avoid")
	Goto See
  Thunder:
    LRED E 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",15)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
	LRED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("redeemer/see")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
    LRED EF 6 Bright A_FaceTarget
	LRED G 0 A_SetUserVar("user_delay",0)
	LRED G 0 A_Stop
	LRED G 3 Bright A_SpawnItemEx("LegRedThunderCharge",64,0,0)
  ThunderCharge:
	LRED G 0 A_JumpIf(user_delay >= 57,"ThunderDone")
	LRED G 0 A_SetUserVar("user_delay",user_delay+1)
	LRED G 3 Bright A_Stop
	Loop
  ThunderDone:
	LRED G 3 Bright A_FaceTarget
	LRED G 3 Bright A_CustomMissile("LegRedThunderBall",5,0,0)
	LRED G 1 Bright ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LRED G 0 A_Jump(127,"Avoid")
	Goto See
  Portal:
    LRED E 1 Bright A_JumpIf(user_portal > 0,"Thunder")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",16)
	LRED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("brain/spit")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
    LRED EF 6 Bright A_FaceTarget
	LRED G 0 A_SetUserVar("user_delay",0)
	LRED G 0 A_Stop
	LRED G 3 Bright A_SpawnItemEx("LegRedPortal",64,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
  PortalCharge:
  	LRED GGG 0 A_SpawnItemEx("LRedeGSmokeSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LRED G 0 A_JumpIf(user_delay >= 315,"PortalDone")
	LRED G 0 A_SetUserVar("user_delay",user_delay+1)
	//LRED G 0 HealThing(10)
	LRED G 3 Bright A_Stop
	Loop
  PortalDone:
	TNT1 A 0 A_SetUserVar("user_effect_type",14)
	LRED G 3 Bright A_FaceTarget
	LRED G 0 A_SetUserVar("user_portal",1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LRED G 0 A_Jump(127,"Teleport")
	Goto See
  Suicide:
  	LRED A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	LRED G 0 A_SetUserVar("user_suicide",1)
	LRED E 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",18)
	TNT1 A 0 A_SetUserVar("user_effect_delay",3)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	LRED E 0 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOBLOCKMONST",TRUE)
	TNT1 A 0 A_PlaySound("redeemer/see")
	TNT1 A 0 Radius_Quake(8,120,0,20,0)
	Goto SeeSuicide
  Kamikaze:
	LRED GGGG 5 Bright A_FaceTarget
	LRED G 0 A_JumpIfTargetInLos(1)
	Goto SeeSuicide
	LRED G 0 A_JumpIfCloser(128,"Explode") //350
    LRED G 3 Bright A_SkullAttack(35)
    Goto Kamikaze+4  
  Explode:
	TNT1 A 0 A_CustomMissile("LegSuicideBomb",0,0,0,0)
    TNT1 A 0 A_SpawnItemEx("LegendaryStrike",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    LRD4 G 3 Bright A_Die
    Goto SeeSuicide	
  Pain:
	TNT1 A 0 A_KillChildren
    TNT1 A 0 A_Jump(8,"Thunder")	
  	TNT1 A 0 A_Jump(21,"Teleport")	
	TNT1 A 0 A_Jump(128,"PainMissile")
    LRED H 2 Bright
    LRED H 2 Bright A_Pain
    Goto See
  PainMissile: 
    LRED H 2 Bright
    LRED H 2 Bright A_Pain
    Goto Missile	
  Death:
    LRED I 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LRED JJKKLL 2 Bright A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LRED M 0 A_NoBlocking
	LRED M 0 A_KillChildren
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,18)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
    LRED MMNNOOPP 2 Bright A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    LRED QQRRSSTTUU 2 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS) 
	LRED V 50
	LRED VVVVVVVVVVVVVVVVVVVVVVVV 3 A_SpawnItemEx("LegTrapSpawners",0,0,0,0,0,0,0,32,SXF_CLIENTSIDE)
    LRED V -1 A_BossDeath
    Stop
  }
}

Actor LegRedBall
{
  Radius 8
  Height 6
  Speed 16
  Damage (Random(30,45)) //10
  Species "Cacodemon"
  DamageType "Legendary"
  Scale 0.85
  Projectile
  RenderStyle Add
  Speed 28
  FastSpeed 36
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  Decal "DoomImpScorch"
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	LRD1 AB 1 Bright A_SpawnItemEx("LegRedBallTrail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LRD1 CDEFG 3 Bright
	Stop
  }
}

Actor FakeLegRedBall : LegRedBall { Damage 2 }

Actor LegRedBallTrail : BFG9500Trail
{
  Scale 0.85
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LRD1 HIJKLM 2 A_FadeOut(0.15)
	Stop
  }
}

Actor LegRedFastBall
{
  Speed 58
  Scale 1.2
  Radius 8
  Height 8
  Damage (Random(60,90)) //18
  Species "Cacodemon"
  DamageType "Legendary"
  Renderstyle Add
  Seesound "skeleton/attack"
  Deathsound "skeleton/tracex"
  Projectile
  Scale 1.5
  +NOTIMEFREEZE
  Decal "RevenantScorch"
  States
  {
  Spawn:
    LDR7 AB 1 Bright A_CustomMissile("LegRedFastBallTrail",frandom(-2,2),frandom(-2,2))
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    LDR7 CD 5 Bright
    LDR7 EF 4 Bright
    LDR7 GH 3 Bright
    Stop
  }
}

Actor FakeLegRedFastBall : LegRedFastBall { Damage (Random(15,25)) }

Actor LegRedFastBallTrail : BFG9500Trail
{
  Scale 1.28
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 1
    LDR8 DEFGHIJKLMNO 1 A_FadeOut(0.025)
    Stop
  }
}

Actor LegRedLaser : FastProjectile
{
  Height 6
  Radius 6
  Damage (Random(15,25)) //5
  Species "Cacodemon"
  DamageType "Legendary"
  SeeSound "baron/attack"
  DeathSound "baron/shotx"
  -RIPPER
  +EXTREMEDEATH
  +NOTIMEFREEZE
  Speed 100
  Scale 0.75
  MissileType "LegRedLaserTrail"
  Renderstyle Add
  Decal "DoomImpScorch"
  States
  {
  Spawn:
	LRD2 ABCB 1 Bright
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	LRD2 DDFFGGGGG 2 Bright A_FadeOut
	Stop
  }
}

Actor LegRedLaserTrail
{
  Scale 0.1
  Renderstyle Add
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +CANNOTPUSH
  +NODAMAGETHRUST
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1 Bright A_SpawnItemEx("LegRedLaserTrail2",0,0,8)
	Stop
  Vanilla:
    TNT1 A 0
	Stop  
  }
}

Actor LegRedLaserTrail2
{
  Scale 0.75
  +NOGRAVITY
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  Alpha 0.85
  Renderstyle Add
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	LRD2 A 9 Bright 
	LRD2 DDFFGGGGG 1 Bright A_FadeOut
	Wait
  Vanilla:
    TNT1 A 0
	Stop 
  }
}

Actor LegRedVoid : ArchVileFire
{
  RenderStyle Add
  Scale 2.1
  Alpha 0.5
  +DONTSPLASH
  +EXTREMEDEATH
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Species "Cacodemon"
  DamageType "Legendary"
  States
  {
  Spawn:
    TNT1 A 0
    LRD3 H 1 Bright A_PlaySoundEx("exile/voidsuck","Voice")
	TNT1 A 0 A_Explode(6,128,0)
	TNT1 AAAAA 0 A_SpawnItemEx("BHellionSmoke",frandom(-32,32),frandom(-32,32),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    LRD3 HGGHH 1 Bright A_Fire
	TNT1 A 0 A_Explode(6,128,0)
	TNT1 AAAAA 0 A_SpawnItemEx("BHellionSmoke",frandom(-32,32),frandom(-32,32),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
	LRD3 GGHHG 1 Bright A_Fire
	//TNT1 A 0 A_Explode(6,128,0)
