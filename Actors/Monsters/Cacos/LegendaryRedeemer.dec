Actor LegRedTrap
{ 
  Health 25
  Radius 16 
  Height 32 
  Mass 3000 
  Speed 0
  Monster
  +LOOKALLAROUND
  +AMBUSH
  +DONTGIB
  +NOTARGET
  +NOINFIGHTING
  +NOGRAVITY 
  +FLOAT
  +DONTFALL
  +NOPAIN
  +DONTHARMSPECIES
  +NOBLOCKMONST
  +NOTIMEFREEZE
  +FORCERADIUSDMG
  -COUNTKILL
  -SOLID
  SeeSound "reedemer/trap"
  DeathSound "weapons/rocklx"
  BloodColor "Blue"
  Species "Redeemer"
  Species "Cacodemon"
  DamageType "Legendary"
  DamageFactor "CacoComet", 0.0
  DamageFactor "Legendary", 0.0
  Scale 1.15
  Obituary "$CFLegRedTrapObit"
  var int user_delay;
  States 
  { 
  Spawn:
    LRD4 A 20 Bright
	LRD4 A 1 Bright A_Stop
	LRD4 A 0 A_JumpIf(user_delay >= 260,"Suicide")
	LRD4 A 0 A_SetUserVar("user_delay",user_delay+1)
	LRD4 ABCD 1 Bright A_Look
    Goto Spawn+2
  See:
    LRD4 ABCD 2 Bright A_Chase
    Goto Missile
  Missile:
	LRD4 A 0
	LRD4 A 0 A_JumpIfTargetInLos(1)
	Goto Clear
	LRD4 A 0 A_JumpIfCloser(100,"Suicide")
    LRD4 ABCD 4 Bright A_SkullAttack(18)
    Loop  
  Clear:
    LRD4 A 4 Bright A_ClearTarget
    Goto Spawn+2 
  Suicide:
    LRD4 A 2 Bright A_Die
    Goto Spawn+2    
  Death:
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))   
	TNT1 A 0 A_Explode(128,156,XF_NOTMISSILE)
	TNT1 A 0 A_Explode(128,128,XF_NOTMISSILE)
	Stop
  } 
}

Actor LegRedTrapBomb
{
  Projectile
  Speed 0
  Damage 0
  Species "Cacodemon"
  DamageType "Legendary"
  +NOCLIP
  +EXTREMEDEATH
