	BFL8 CC 0 A_CustomMissile("BFlanAcidSmall",30,0,frandom(-3,3),CMF_OFFSETPITCH,frandom(-1,1))
	BFL8 G 1 A_CustomMissile("BFlanAcidSmall",30,0,frandom(-3,3),CMF_OFFSETPITCH,frandom(-1,1))
	Loop
  Death:
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_ChangeFlag("LOWGRAVITY",1)
	TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
	TNT1 A 0 A_ChangeFlag("FLOAT",0)
    BFLD A 3 A_Scream
	BFLD BCDEFGHI 5 A_SpawnItemEx ("Edgy2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	BFLD HIHIHI 5 A_SpawnItemEx ("Edgy2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), 2, random(0,360))
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("Edgy2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("Edgy2huBossDeathFlame3", frandom(5, 55), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(-40, 70))
    Stop
  }
}

