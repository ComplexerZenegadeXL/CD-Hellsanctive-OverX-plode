	TNT1 A 0 A_SpawnItemEx("BFlanShadowG")
	BFL9 H 1 A_Chase("","")
	TNT1 AA 0 A_SpawnItemEx("BFlanSmoke",0,0,32,frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(0, 360))
	TNT1 A 0 A_SpawnItemEx("BFlanShadowH")
	BFL9 H 1 A_Chase("","")
	TNT1 AA 0 A_SpawnItemEx("BFlanSmoke",0,0,32,frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(0, 360))
	TNT1 A 0 A_SpawnItemEx("BFlanShadowH")
	BFL9 H 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("BFlanShadowH")
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("BFlanSmoke",0,0,32,frandom(-3,3),frandom(-3,3),frandom(-3,3),frandom(0, 360))
	TNT1 A 0 A_ChangeFlag("FRIGHTENED", FALSE)
