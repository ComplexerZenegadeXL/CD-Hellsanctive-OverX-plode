Actor DBishRain : CacoHellStaffBall1
{
  Damage (Random(25,50)) //12
  SeeSound "Dbish/Atk2"
  States
  {
  Spawn:
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO D 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO D 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO E 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO E 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO F 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 AA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	HPRO F 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	Loop
  Death:
	TNT1 AAAAAAAAAA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-8,8),frandom(-8,8),frandom(0,12),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("WhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SetScale(1)
	PFX1 GH 5 Bright
	PFX1 I 4 Bright
	PFX1 JKL 3 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItemEx("DBishRainDrop",random(-64,64),random(-64,64),0,0,0,0)
	Stop
  }
}

Actor DBishRainDrop
{
  Radius 3
  Height 4
  Speed 12
  Damage (Random(16,24))
  Gravity 12
  +MISSILE
  +BRIGHT
  +CEILINGHUGGER
  +DONTSPLASH  
  +EXPLODEONWATER
  -CANBOUNCEWATER
  RenderStyle Add
  Species "Cacodemon"
  DamageType "CacoComet"
  Mass 10
  States
  {
  Spawn:
	TNT1 A 2
  Spawn2:
	PFX3 A 1 A_JumpIf(momz >= 0,"Death")
	PFX3 A 1
	Loop
  Death:
	PFX3 BCDEF 3
	Stop
  }
}

Actor DBishHornRodFX : CacoHellStaffBall2
{
  Speed 25
  Damage (Random(12,24)) //6
  States
  {
  Spawn:
	HPRO DDEEFF 1 Bright A_SpawnItem("WhiteHellStaffTrail")
	TNT1 A 0 A_SeekerMissile(15, 30)
	Loop
  Death:
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("WhiteHellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),frandom(0,360))
	CLBA D 1 Bright A_FadeOut(0.2)
	Goto Death
  }
}

