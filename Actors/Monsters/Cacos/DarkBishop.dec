Actor DarkBishFX2 : ImpballTrail
{  
  Radius 2
  Height 2
  Speed 0
  Projectile
  RenderStyle Translucent
  Alpha 0.90
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 3
	DPTR AAAAAAAAAA 5 A_FadeOut(0.10)
	Stop
  }
}

Actor DBishShot
{
  Radius 8
  Height 16
  Speed 25
  Damage (Random(10,20)) //3
  RenderStyle Add
  Alpha 0.67
  Species "Cacodemon"
  DamageType "CacoComet"
  Projectile
  +THRUGHOST
  +SEEKERMISSILE
  SeeSound "DBish/Atk1"
  DeathSound "monster/acohit"
  Decal "BishopScorch"
  States
  {
  Spawn:
	PFX2 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("WhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("WhiteKaboom2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	PFX2 CDEFGH 3 Bright
	Stop
  }
}

Actor DBishShot2 : DBishShot
{
  States
  {
  Spawn:
	PFX2 A 1 Bright A_Weave(3, 3, -2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 A 1 Bright A_Weave(3, 3, -2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 B 1 Bright A_Weave(3, 3, -2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	PFX2 B 1 Bright A_Weave(3, 3, -2.0, 1.0)
	PFX2 A 0 A_CustomMissile("DBishShotFX",0,0,0,0)
	PFX2 B 0 A_SeekerMissile(1,1)
	Loop
  }
}

