Actor DarkBishop : CFCacodemon 17560
{ 
  //$Category Monsters/CF
  //$Sprite DPTRA1
  //$Title "Dark Bishop"
  Health 800
  PainChance 70
  Speed 12
  Scale 1
  Radius 20 
  Height 56 
  Mass 150 
  BloodColor "Black"
  Monster
  +MISSILEMORE
  +FLOORCLIP
  +DONTHURTSPECIES
  +NOGRAVITY
  +FLOAT
  Obituary "$CFDarkBishopObit"
  HitObituary "$CFDarkBishopHitObit"
  DamageFactor "Glaucoma", 0.0
  DropItem "BossLifeEssence" 160
  DropItem "BossArmorBonusMax" 160
  DropItem "HellStaffGiver" 50
  DropItem "CFManaPickup" 200 30
  DropItem "CFManaPickup" 200 30
  SeeSound "DarkBishop/Sight" 
  PainSound "DarkBishop/Pain" 
  DeathSound "DarkBishop/Death" 
  ActiveSound "DarkBishop/Active"
  Tag "$CFDBishop"
  States 
  { 
  Spawn: 
	DPTR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DPTR A 10 A_Look 
	Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DPTR AAABBB 4 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	DPTR AAABBB 4 A_Chase
	DPTR A 0 A_Jump(96,1)
	Loop
	DPTR A 0 A_Chase
	DPTR A 1 A_Playsound("monster/blur")
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR A 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR A 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 1 A_Chase
	DPTR B 0 A_SpawnItemEx("DarkBishFX2",0,0)
	DPTR B 0 A_Jump(96,1)
	Goto MoreSee+8
	DPTR B 0
	Goto MoreSee
  Melee:
  Missile:
	TNT1 A 0 A_Jump(256,"HomingChargeBalls","RainProjectile","EvenMoreHoming","LetsBalanceTheHoming")
  HomingChargeBalls:
	DPTR D 8 Bright A_FaceTarget
	DPTR E 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("DBishShot2",36,28,0,0)
	DPTR F 9 Bright A_CustomMissile("DBishShot",36,-28,0,0)
	DPTR ED 6 Bright
	Goto See
  RainProjectile:
	DPTR D 8 Bright
	DPTR E 5 Bright A_FaceTarget
	DPTR F 8 Bright A_CustomMissile("DBishRain",36,0,0,0)
	DPTR ED 6 Bright
	Goto See
  EvenMoreHoming:
	DPTR D 8 Bright
	DPTR E 5 Bright A_FaceTarget
	DPTR D 0 A_PlaySound("dbish/atk3")
	DPTR D 0 A_CustomMissile("DBishHornRodFX",36,0,-20,0)
	DPTR D 0 A_CustomMissile("DBishHornRodFX",36,0,20,0)
	DPTR F 8 Bright A_CustomMissile("DBishHornRodFX",36,0,0,0)
	DPTR ED 6 Bright
	Goto See
  LetsBalanceTheHoming:
	DPTR D 8 Bright
	DPTR E 5 Bright A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	TNT1 A 0 A_FaceTarget
	DPTR F 7 Bright A_CustomMissile("DBishHornRodFXNotHoming",36,0,frandom(-6,6))
	DPTR ED 6 Bright
	Goto See
  Pain: 
	DPTR C 2 
	DPTR C 2 A_Pain 
	Goto See 
  XDeath:
  Death: 
	DPTR G 8 Bright A_Scream 
	DPTR HI 5 Bright
	DPTR J 5 Bright A_NoBlocking 
	DPTR KLM 5 Bright
	DPTR NO 5
	DPTR P -1 
	Stop 
  XRaise:
  Raise: 
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DPTR PONMLKJIHG 5 
	Goto See 
  } 
}

