Actor EnragedLegendaryNecromancer : LegendaryNecromancer
{ 
  Health 2000 
  PainChance 20
  BloodColor "Red"
  Obituary "$CFEnragedLegendaryNecromancerObit"
  DamageFactor 0.55
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 144
  DropItem "LegendaryBossArmorBonusMax" 144
  DropItem "ILDemonAmmoPickup" 250
  DropItem "ILDemonAmmoBoxPickup" 250
  DropItem "LegendaryPowerSphere" 105
  DropItem "LegendaryTimeFreezeSphere" 100
  DropItem "EnragedLegendarySphere" 120
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 150
  DropItem "EnragedLegendaryPowerShard" 85
  DropItem "OccultSpellbookGiver" 256
  DropItem "BigCFManaPickup" 256 100
  DropItem "BigCFManaPickup" 128 100
  DropItem "LegendaryRandomSphere" 16
  SeeSound "EnragedNecromancer/Sight" 
  PainSound "EnragedNecromancer/Pain" 
  Tag "$CFEnrNecro"
  var int user_missile;
  var int user_hollowsummons;
  States 
  { 
  Spawn: 
    EMGE A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Taunt")
  Idle2:
	EMGE A 10 Bright A_Look 
	Loop 
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Cacodemon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  Taunt:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	EMGE A 4 Bright
	TNT1 A 0 A_PlaySound("EnragedNecromancer/Taunt",2,1.0,0,ATTN_NONE)
	TNT1 A 0 A_TakeInventory("MarineKilled",1)
	EMGE AAAAAAAAAA 10 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto Idle2
  See: 
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EMGE AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,740)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	EMGE AABB 3 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(96,"Rush")
	TNT1 A 0 A_Jump(60,"Dodge")
	Loop
  Teleport:
	EMGE A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	EMGE AAAAAAAAAA 1 A_FadeOut(0.1,0)
	EMGE A 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	EMGE A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	EMGE AAAAAAAAAA 1 A_FadeIn(0.1)
	EMGE A 1 Bright A_SetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	Goto See	
  Dodge:
	TNT1 A 0 ThrustThing(angle*256/360+frandom(0,360),30,0,0)
	EMGE A 5 Bright 
	Goto See
  Rush:
	TNT1 A 0 A_Chase
	EMGE A 1 Bright A_Playsound("monster/blur")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RushLoop:
	TNT1 A 0 A_SpawnItemEx("ELegNecromancerFX")
	EMGE A 1 Bright A_Chase
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 24,"See")
	Loop
	Goto See
  Melee:
  Missile:
	TNT1 A 0 A_Jump(100,"SpreadShots","NecroShots")
	TNT1 A 0 A_Jump(90,"VoidLightning","BigLightningBall","LightningBolts","RageLightning")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(70,"SummonHollows")
  Normal:
    EMGE D 8 Bright
    EMGE E 5 Bright A_FaceTarget
    TNT1 A 0 A_PlaySound("dbish/atk3")
    TNT1 A 0 A_CustomMissile("ELegNecroHellStaffBall",36,0,-20,0)
    TNT1 A 0 A_CustomMissile("ELegNecroHellStaffBall",36,0,20,0)
    EMGE F 8 Bright A_CustomMissile("ELegNecroHellStaffBall",36,0,0,0)
	TNT1 A 0 A_Jump(40,"SpreadShots","NecroShots")
	Goto See
  NecroShots:
	EMGE D 8 Bright A_FaceTarget
	EMGE E 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NecroShotsLoop:
	TNT1 A 0 A_CustomMissile("ELegNecromancerShot2",65,35,0,0)
	EMGE F 6 Bright A_CustomMissile("ELegNecromancerShot",65,-35,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(40,"SpreadShots","Normal")
	Goto See
  SpreadShots:
	EMGE D 8 Bright A_FaceTarget
	EMGE E 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpreadShotsLoop:
	TNT1 A 0 A_CustomMissile("ELegSoulBall",41,0,random(-24,24))
	EMGE F 5 Bright A_CustomMissile("ELegSoulBall",41,0,random(-24,24))
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,1)
	Loop
	TNT1 A 0 A_Jump(40,"NecroShots","Normal")
	TNT1 A 0 A_Jump(30,"LightningBolts")
	Goto See
  VoidLightning:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	EMGE DE 5
	EMGE F 10 A_PlaySound("exile/voidstart")
	EMGE F 8 A_VileTarget("ELegNecromancerVileFire")
	EMGE FFFFFFFFFFFFFF 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
	EMGE D 8
	EMGE E 20
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  LightningBolts:
	EMGE DE 12 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile",-40)
  LightningBoltsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 40,"LightningBoltsEnd")
	TNT1 A 0 A_FaceTarget
	EMGE F 4 Bright A_CustomMissile("ERedStrikeBolt",41,0,user_missile)
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+10)
	Loop
  LightningBoltsEnd:
	TNT1 A 0 A_Jump(64,"Normal")
    Goto See
  BigLightningBall:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("EnragedNecromancer/Attack",2)
	TNT1 A 0 A_PlaySound("LegMage/Attack2")
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE E 4 Bright A_FaceTarget
    EMGE F 20 Bright A_CustomMissile("ELegendarySuperLightningProj",41,0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  BigLightningBallLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 2,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("ELegendarySuperLightningFX",41,43,0,0)
    EMGE F 4 Bright A_FaceTarget
    EMGE F 20 Bright A_CustomMissile("ELegendarySuperLightningProj",41,0,0,0,0)
    Loop
  RageLightning:
	TNT1 A 0 A_PlaySound("EnragedNecromancer/Attack",2)
	EMGE DDDDDEEEEE 5 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	EMGE F 15 Bright A_CustomMissile("EnragedNecromancerRageBolt",0,0,frandom(-15,15))
	TNT1 A 0 A_FaceTarget
	EMGE F 15 Bright A_CustomMissile("EnragedNecromancerRageBolt",0,0,frandom(-15,15))
	TNT1 A 0 A_FaceTarget
	EMGE F 15 Bright A_CustomMissile("EnragedNecromancerRageBolt",0,0,frandom(-15,15))
	TNT1 A 0 A_FaceTarget
	EMGE F 15 Bright A_CustomMissile("EnragedNecromancerRageBolt",0,0,frandom(-15,15))
	Goto See
  SummonHollows:
    TNT1 A 0 A_JumpIf(user_hollowsummons >= 10,"RageLightning")
	TNT1 A 0 A_PlaySound("LegMage/Active")
    TNT1 A 0 A_FaceTarget
    EMGE FFFFF 5 Bright A_SpawnItemEx("EnragedLegendaryHollow",frandom(35,140),0,0,0,0,0,frandom(0,360))
	TNT1 A 0 A_SetUserVar(user_hollowsummons,user_hollowsummons+1)
	Goto See
  Pain: 
	TNT1 A 0 A_Jump(35,"Teleport")
	EMGE C 4 Bright A_Pain 
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See 
  Death: 
	EMGE C 2 Bright
	EMGE C 2 Bright A_Scream 
	EMGE CCCCCCCCCCCCCCCCCCCCCC 6 A_SpawnItemEx("MadKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),random(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItemEx("RedLightning")
	TNT1 A 0 A_Explode(100,200,1)
	TNT1 A 0 Radius_Quake(5,15,0,20,0)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	EMGE G 8 Bright A_PlaySound("LegMage/Death2",7,1.0,0,ATTN_NONE) 
	EMGE HI 5 Bright
	EMGE J 5 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
	EMGE KLM 5 Bright
	EMGE NO 5
	EMGE P 60
	TNT1 A 0 A_CheckFlag("FRIENDLY","Death2")
	EMGE PPPPPPPPPPP 5 A_SpawnItemEx("EnragedLegendaryHollow",frandom(35,140),0,0,0,0,0,frandom(0,360))
  Death2:
	EMGE P -1 
	Stop 
   } 
}

Actor ELegendarySuperLightningFX : LegendarySuperLightningFX
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    BFLI ABCDE 1 Bright
    Stop
  }
}

Actor ELegendarySuperLightningProj : BFlanLightningProj { +NOTIMEFREEZE Species "Cacodemon" DamageType "Legendary" }

Actor ELegNecroHellStaffBall : CacoHellStaffBall2
{
  Speed 40
  Damage (Random(25,50)) //9
  Species "Cacodemon"
  DamageType "Legendary"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    HPRO AABBCC 1 Bright A_SpawnItemEx("HellStaffTrail")
	TNT1 A 0 A_SeekerMissile(20,45)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(40,48)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("HellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),random(0,360))
    CLBA B 1 Bright A_FadeOut(0.2)
    Goto Death+2
  }
}

Actor ELegNecromancerShot : LegNecromancerShot
{
   Speed 50
   Damage (Random(20,40))  //8
   Species "Cacodemon"
   DamageType "Legendary"
   States
   {
   Spawn:
	EMF0 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
	TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
	TNT1 A 0 A_SeekerMissile(1,3)
	EMF0 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
	TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
	TNT1 A 0 A_SeekerMissile(1,3)
	EMF0 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
	TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
	TNT1 A 0 A_SeekerMissile(1,3)
	EMF0 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
	TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
	TNT1 A 0 A_SeekerMissile(1,3)
	loop
   Death:
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	EMF0 CDEFGH 3 Bright
	Stop
   }
}

Actor ELegNecromancerShot2 : ELegNecromancerShot
{
   States
   {
   Spawn:
      EMF0 A 1 Bright A_Weave(3, 3, -2.0, 1.0)
      TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
      TNT1 A 0 A_SeekerMissile(1,3)
      EMF0 A 1 Bright A_Weave(3, 3, -2.0, 1.0)
      TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
      TNT1 A 0 A_SeekerMissile(1,3)
      EMF0 B 1 Bright A_Weave(3, 3, -2.0, 1.0)
      TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
      TNT1 A 0 A_SeekerMissile(1,3)
      EMF0 B 1 Bright A_Weave(3, 3, -2.0, 1.0)
      TNT1 A 0 A_SpawnItemEx("ELegNecromancerShotFX")
      TNT1 A 0 A_SeekerMissile(1,3)
      Loop
   }
}

Actor ELegNecromancerShotFX : LegNecromancerShotFX
{   
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 2
    EMF0 AABBAABBAABB 1 Bright A_FadeOut(0.08)
    Stop
  }
}

Actor ELegNecromancerVileFire : LegNecromancerVileFire
{
  States
  {
  Spawn:
    TNT1 A 0
    BFVI A 1 Bright A_PlaySoundEx("BFlan/Vile","Voice",1)
    BFVI ABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_Fire
    BFV0 AABBCCDD 1 Bright A_Fire
    BFVI ABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_Fire
    BFV0 AABBCCDD 1 Bright A_Fire
	BFVI A 1 Bright A_StopSoundEx("Voice")
	BFVI A 1 Bright A_PlaySoundEx("exile/voidend","Voice")
	TNT1 A 0 A_SpawnItemEx("RedLightning")
	TNT1 A 0 A_Explode(100,200,1)
	TNT1 A 0 Radius_Quake(5,15,0,20,0)
    TNT1 AAAAAAAAAAA 0 A_SpawnItemEx ("Edgy2huBossDeathFlame", 0, 0, 0, frandom(-3,3), frandom(-3,3), frandom(-3,3), frandom (0, 360))
	TNT1 AAAAAAAAAAA 0 A_CustomMissile("Edgy2huBossDeathFlame3", frandom(5, 55), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(-40, 70))
	BFVI BBCCDDEE 1 Bright
	TNT1 A 20
	TNT1 A 0 A_StopSoundEx("Voice")
    Stop
  }
}

Actor EnragedNecromancerRageBolt : HellRageBolt { DamageType "Legendary" }

Actor ELegNecromancerFX : LegNecromancerFX
{   
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 3
    EGME AAAAAAAAAA 5 A_FadeOut(0.10)
    Stop
  }
}

Actor MadKaboom : CFKaboom
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	EXPO A 1 Bright A_PlaySound("weapons/rocklx")
	EXPO ABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor EnragedLegendaryHollow : Imp
{
  Health 450
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "CacoComet", 0.0
  DamageFactor "PlayerLegendary", 0.0
  Species "Cacodemon"
  +DONTHARMSPECIES
  +THRUSPECIES
  -COUNTKILL
  SeeSound "devil/Sight"
  ActiveSound "superimp/Active"
  PainSound "voidimp/Pain"
  DeathSound "devil/Death"
  Obituary "$CFEnragedLegendaryHollowObit"
  Tag "$CFEnragedLegendaryHollow"
  States
  {
  Spawn:
	EHOL WVUTSRQPO 3
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner")
	EHOL AA 10 A_Look
	Loop
  See:
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner")
	EHOL AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("EnragedHellionSmokeSpawner")
	EHOL CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  Melee:
  Missile:
	EHOL EFG 2 A_FaceTarget
	EHOL HIJK 3 Bright A_FaceTarget
	EHOL L 6 Bright A_CustomMissile("EnragedHollowBall")
	EHOL M 8
	Goto See
  Pain:
	EHOL N 3
	EHOL N 3 A_Pain
	Goto See
  XDeath:
  Death:
	EHOL O 7 A_Scream
	EHOL PQR 7 
	EHOL S 6 A_SpawnItemEx("EnragedHollowGhost",0,0,32)
	EHOL T 5 A_Fall
	EHOL UV 5
	EHOL W -1
	Stop
  Raise:
	Stop
  }
}

Actor EnragedHollowBall : BFlanSoulWeak
{
  Speed 25
  Damage (Random(30,60)) //9
  Scale 0.5
  BounceCount 3
  +NOTIMEFREEZE
  +MTHRUSPECIES
  SeeSound "Soul/Fire"
  DeathSound "Soul/Hit"
  Species "Cacodemon"
  Damagetype "Legendary"
  States
  {
  Spawn:
	PSM0 AABB 2 Bright A_SpawnItemEx("EnragedHollowBallTrail")
	Loop
  Death:
	PSM0 CCDDEEFFGGHHIIJJKKLL 2 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor EnragedHollowBallTrail : BFlanSoulStrongTrail
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
}

Actor EnragedHollowGhost
{
  Renderstyle Add
  Alpha 0.7
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	EHGH ABCDEFG 4 Bright
	Stop
  }
}