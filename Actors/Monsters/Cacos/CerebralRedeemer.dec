Actor CerebralRedeemer : CFCacodemon 17568
{
  //$Category Monsters/CF
  //$Sprite HELEA1
  //$Title "Cerebral Redeemer"
  Obituary "$CFCerebralRedeemerObit"
  HitObituary "$CFCerebralRedeemerHitObit"
  Health 1300
  Radius 31
  Height 56
  Mass 800
  Speed 10
  PainChance 30
  MeleeDamage 12
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "SoapOpera" , 0.0
  DamageFactor "Glaucoma", 0.0
  SeeSound "CBElem/Sight"
  PainSound "CBElem/Pain"
  DeathSound "CBElem/Death"
  ActiveSound "CBElem/Active"
  MeleeSound "caco/melee"
  Species "Cacodemon"
  DropItem "HellStaffGiver" 128
  DropItem "BossLifeEssence" 190
  DropItem "BossArmorBonusMax" 190
  DropItem "DemonAmmoBoxPickup" 256 
  DropItem "BigCFManaPickup" 128 100
  DropItem "CFManaPickup" 256 30
  DropItem "DemonTechBFG10KGiver" 60
  Tag "$CFCerRedeem"
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +NOTARGET
  +DONTHARMSPECIES
  +NORADIUSDMG
  States
  {
  Spawn:
    HELE A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HELE A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HELE AAAAAA 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    HELE A 0 A_SetShootable
    HELE AAAAAA 3 A_Chase
    HELE A 0 A_Jump(32,"Teleport")
    Goto MoreSee+1
  Teleport:
    HELE A 0 A_UnSetshootable
    HELE A 1
	HELE AAAAAAAAA 1 A_FadeOut(0.1)
    TNT1 A 0 A_Jump(128,26)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
    TNT1 A 0 A_Jump(128,26)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_ExtChase(0,0,1,1)
	TNT1 A 0 A_Recoil(0.1)
    HELE A 1 A_PlaySound("Boss/Teleport")
	HELE AAAAAAAAA 1 A_FadeIn(0.1)
    HELE A 0 A_SetShootable
    Goto See
  Missile:
    HELE A 0 A_Jump(180,"HadesSpheres","HellStaffNormal","HellStaffHoming","BFG","15k","Demontech10k")
  Normal:
    HELE BC 5 Bright A_FaceTarget
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,0)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-5)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,5)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-10)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,10)
    HELE BC 5 Bright A_FaceTarget
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,0)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-5)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,5)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-10)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,10)
    HELE BC 5 Bright A_FaceTarget
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,0)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-5)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,5)
    HELE D 0 A_CustomMissile("CBElemBall",24,0,-10)
    HELE D 2 Bright A_CustomMissile("CBElemBall",24,0,10)
    Goto See
  HadesSpheres:
    HELE BC 5 Bright A_FaceTarget
    HELE D 5 Bright A_DualPainAttack("HS")
    Goto See
  HellStaffNormal:
    HELE BC 7 Bright A_FaceTarget
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,-10,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,-5,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,0,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,5,0,0)
    HELE D 7 Bright A_CustomMissile("CBElemHellStaffBall1",24,0,10,0,0)
    HELE BC 7 Bright A_FaceTarget
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,-10,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,-5,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,0,0,0)
    HELE D 0 A_CustomMissile("CBElemHellStaffBall1",24,0,5,0,0)
    HELE D 7 Bright A_CustomMissile("CBElemHellStaffBall1",24,0,10,0,0)
	Goto See
  HellStaffHoming:
	HELE EF 7 A_FaceTarget
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,-20)
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,20)
	HELE G 7 Bright A_CustomMissile("CBElemHellStaffBall2",24)
	HELE EF 7 A_FaceTarget
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,-20)
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,20)
	HELE G 7 Bright A_CustomMissile("CBElemHellStaffBall2",24)
	HELE EF 7 A_FaceTarget
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,-20)
	HELE D 0 A_CustomMissile("CBElemHellStaffBall2",24,0,20)
	HELE G 7 Bright A_CustomMissile("CBElemHellStaffBall2",24)
	Goto See
  15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	HELE EEF 6 Bright A_FaceTarget
	HELE G 8 Bright A_CustomMissile("CBElemBFG15k", 15, 0, frandom(-4,4))
	HELE F 4 Bright A_FaceTarget
	HELE G 8 Bright A_CustomMissile("CBElemBFG15k", 15, 0, frandom(-4,4))
	HELE F 4 Bright A_FaceTarget
	HELE G 8 Bright A_CustomMissile("CBElemBFG15k", 15, 0, frandom(-4,4))
	HELE F 4 Bright A_FaceTarget
	HELE G 8 Bright A_CustomMissile("CBElemBFG15k", 15, 0, frandom(-4,4))
	HELE F 4 Bright A_FaceTarget
	Goto See
  BFG:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	HELE E 15 A_FaceTarget
	HELE F 10 Bright A_FaceTarget
	HELE G 10 Bright A_CustomMissile("CBElemRedBFGBall",24)
	HELE FE 15 A_FaceTarget
	Goto See
  Demontech10k:
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	HELE E 20 A_FaceTarget
	HELE F 15 Bright A_FaceTarget
	HELE G 10 Bright A_CustomMissile("CBElemDTBFG10kBall",15)
	HELE FE 15 A_FaceTarget
	Goto See
  Melee:
    HELE ABD 5 Bright A_FaceTarget
    HELE C 5 Bright A_MeleeAttack
    Goto See
  Pain:
	TNT1 A 0 A_JumpIfHealthLower(250,"PainSuicide")
    HELE H 3
    HELE H 3 A_Pain
    HELE H 6
	TNT1 A 0 A_Jump(128,"Missile")
    Goto See
  PainSuicide:
	TNT1 A 0 A_JumpIfCloser(1250,1)
	Goto Pain+2
	TNT1 A 0 A_Jump(18,"See")
	TNT1 A 0 A_StopSound
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOTARGET,1)
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HELE E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HELE E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HELE F 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HELE F 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("CBElemSuicide",0,0,0,0) 
	TNT1 A 1 A_ChangeFlag(COUNTKILL,0)
	Stop
  XDeath:
  Death:
    HELE I 5 Bright A_Scream
	TNT1 AAAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, frandom(20,40), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAA 0 A_CustomMissile("Kaboom18", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    HELE JKL 5 Bright
    HELE M 5 Bright A_NoBlocking
    HELE M 0 A_SpawnItemEx("HS",36,36)
    HELE M 0 A_SpawnItemEx("HS",-36,36)
    HELE M 0 A_SpawnItemEx("HS",-36,-36)
    HELE M 0 A_SpawnItemEx("HS",36,-36)
    HELE NOP 5 Bright
    HELE QRSTU 5
    HELE V -1 A_SetFloorClip
    Stop
  Death.Suicide:
	TNT1 A 100 A_NoBlocking
	Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor RedCerebralRedeemer : CerebralRedeemer
{
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Species "UltimateLegendary"
  Dropitem ""
  +NOTELEFRAG
  +THRUSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
}

Actor CBElemSuicide : BombSuicide
{
  Speed 35
  DeathSound "CBElem/Death"
  DropItem "HellStaffGiver" 128
  DropItem "BossLifeEssence" 190
  DropItem "BossArmorBonusMax" 190
  DropItem "DemonAmmoBoxPickup" 256 
  DropItem "BigCFManaPickup" 128 100
  DropItem "CFManaPickup" 256 30
  DropItem "DemonTechBFG10KGiver" 60
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("CBElem/Charge",7)
	TNT1 A 0 A_SeekerMissile(10,0)
	HELE GG 1 Bright A_SpawnItemEx("BombFireSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySoundEx("bomb/suiciderush","Voice",1)	
    Goto Spawn+2
  Death:
	TNT1 A 0 A_Die
  Explode:
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 A 0 A_Explode(168,168)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 A_PlaySound("bomb/explode")
	HELE I 5 Bright A_Scream
	TNT1 AAAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, frandom(20,40), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAA 0 A_CustomMissile("Kaboom18", frandom(20,40), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    HELE JKL 5 Bright
	TNT1 A 0 A_NoBlocking
    HELE M 5 Bright A_Gravity
    HELE M 0 A_SpawnItemEx("HS",36,36)
    HELE M 0 A_SpawnItemEx("HS",-36,36)
    HELE M 0 A_SpawnItemEx("HS",-36,-36)
    HELE M 0 A_SpawnItemEx("HS",36,-36)
    HELE NOP 5 Bright
    HELE QRSTU 5
    HELE V -1 A_SetFloorClip
	Stop
    } 
}

Actor CBElemRedBFGBall : SentientBFG9500Ball
{
  DamageType "BombBreath"
  Species "EleSouls"
  Obituary "$CFCBElemRedBFGBallObit"
}

Actor CBElemBFG15k : CBCacoBFG15K { Damagetype "BombBreath" Species "EleSouls" }

Actor CBElemDTBFG10kBall : ZombieDTBFG10KBall { Species "EleSouls" Obituary "$CFCBElemDTBFG10kBallObit" }

Actor CBElemHellStaffBall1 : CacoHellStaffBall1 { Species "EleSouls" DamageType "BombBreath" }

Actor CBElemHellStaffBall2 : CacoHellStaffBall2 { Species "EleSouls" DamageType "BombBreath" }

Actor CBElemBall : CacodemonBall
{
  Damage (Random(20,35)) //6
  Speed 25
  Alpha 0.80
  DamageType "BombBreath"
  +THRUGHOST
  +FORCEXYBILLBOARD
  SeeSound "HSphere/Tele"
  DeathSound "HSphere/Sight"
  Decal "CacoScorch"
  States
  {
  Spawn:
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
    HEF0 A 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 A 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 A 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 A 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 B 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 B 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 B 1 Bright
	HEF0 AAA 0 A_SpawnItemEx("CBElemBallTrail", frandom(-6, 6), 0, frandom(-6, 6), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEF0 B 1 Bright
    Loop
  Death:
    HEF0 CDEEFGH 3 Bright
    Stop
  }
}

Actor CBElemBallTrail : ImpballTrail
{
  Radius 2
  Height 2
  Scale 0.4
  Renderstyle Add
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    ZAP9 C 0 A_Jump(255, "Puff1", "Puff2", "Puff3", "Puff4")
  Puff1:
    ZAP9 C 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    ZAP9 D 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    ZAP9 E 1 Bright A_FadeOut(0.1)
    Loop
  Puff4:
    ZAP9 F 1 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor HS
{
  Health 35
  Radius 24
  Height 48
  Mass 3000
  Speed 20
  Obituary "$CFHSObit"
  Monster
  SeeSound "HSphere/Sight"
  DeathSound "HSphere/Explode"
  Species "EleSouls"
  DamageType "BombBreath"
  MeleeRange 80
  +LOOKALLAROUND
  +DONTHURTSPECIES
  +NOTARGET
  +NOGRAVITY
  +FLOAT
  +DONTFALL
  +NOICEDEATH
  +THRUSPECIES
  -COUNTKILL
  Tag "Hades Sphere"
  States
  {
  Spawn:
    HADE AAAAA 4 A_Look
    Loop
  See:
    HADE EFGH 4 Bright
  SeeLoop:
	TNT1 A 0 A_Playsound("HSphere/Active")
    HADE AABBCCDD 2 Bright A_Chase
    //TNT1 A 0 A_Jump(16,"TeleportOut")
    Loop
  TeleportOut:
    TNT1 A 0 A_UnSetShootable
    HADE H 3 Bright A_Playsound("HSphere/Tele")
    HADE GFEIJKL 2 Bright
  SeeTeleport:
    TNT1 AAAAAAAAAAA 1 A_Chase(0)
    TNT1 A 0 A_Jump(96,"TeleportIn")
    Loop
  TeleportIn:
    HADE L 2 Bright A_Playsound("HSphere/Tele")
    HADE KJIEFG 2 Bright
    TNT1 A 0 A_SetShootable
    Goto SeeLoop
  Melee:
    TNT1 A 0 A_Die
    Stop
  Death:
    TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_SetTranslucent(0.9, 1)
	TNT1 A 0 A_Scream
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, frandom(15,35), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAA 0 A_CustomMissile("SmokeFX", frandom(15,35), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom18",frandom(15,35),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	HADE M 4 Bright A_Explode(112, 128)
    HADE NOPQ 5 Bright
    Stop
  }
}