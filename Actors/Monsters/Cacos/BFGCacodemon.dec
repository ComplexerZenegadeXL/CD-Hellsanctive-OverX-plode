Actor BFGCacodemon : CFCacodemon 16563
{
  //$Category Monsters/LCA
  //$Sprite BFCDA1
  //$Title "BFG Cacodemon"
  Health 700
  Radius 24
  Height 44
  Mass 400
  MeleeDamage 8
  Speed 10
  PainChance 128
  Monster
  +FLOAT
  +NOGRAVITY
  +MISSILEEVENMORE
  +MISSILEMORE
  +QUICKTORETALIATE
  SeeSound "caco/sight"
  PainSound "caco/pain"
  DeathSound "caco/death"
  ActiveSound "caco/active"
  MeleeSound "caco/melee"
  Obituary "$CFBFGCacodemonHitObit"
  HitObituary "$CFBFGCacodemonHitObit"
  DropItem "BFG9500Giver" 90 1
  DropItem "BossLifeEssence" 150
  DropItem "BossArmorBonusMax" 150
  DropItem "NewCellPackPickup" 255 
  DamageFactor "CacoComet" , 0.0
  DamageFactor "Glaucoma", 0.0
  BloodColor "Purple"
  Species "Cacodemon"
  Tag "$CFBfgCaco"
  States
  {
  Spawn:
	BFCD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	BFCD A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BFCD AA 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(20,"FastChase")
	BFCD A 3 A_Chase
	TNT1 A 0 A_Jump(62,"Rush")
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("BFGCacodemonGhostA")	
	BFCD A 1 A_Chase
	TNT1 A 0 A_Jump(87,"See")
	Loop
  FastChase:
	BFCD A 3 A_FastChase
	BFCD A 3 A_FastChase
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"Missile2")
	TNT1 A 0 A_Jump(64,"Missile3")
	Goto See
  Missile2:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	BFCD B 15 A_FaceTarget
	BFCD C 10 Bright A_FaceTarget
	BFCD D 10 Bright A_CustomMissile("CacoBFG9500Ball", 15)
	BFCD CB 15 A_FaceTarget
	Goto See
  Missile3:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	BFCD B 18 A_FaceTarget
	BFCD C 10 Bright A_FaceTarget
	BFCD D 6 Bright A_CustomMissile("Caco15K", 15)
	BFCD C 6 Bright A_FaceTarget
	BFCD D 6 Bright A_CustomMissile("Caco15K", 15)
	BFCD C 6 Bright A_FaceTarget
	BFCD D 6 Bright A_CustomMissile("Caco15K", 15)
	BFCD CB 20 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	Goto See
  Melee:
    BFCD BC 5 A_FaceTarget
	BFCD D 5 A_MeleeAttack
	BFCD CB 5 A_FaceTarget
	Goto See
  Pain:
	BFCD E 3
	BFCD E 3 A_Pain
	BFCD F 6
	Goto See
  XDeath:
  Death:
	BFCD G 8
	TNT1 A 0 A_SpawnItemEx("MutantGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	BFCD H 8 A_Scream
	BFCD IJ 8
	BFCD K 8 A_NoBlocking
	BFCD L -1 A_SetFloorClip
	Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor RedBFGCacodemon : BFGCacodemon
{
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Species "UltimateLegendary"
  Dropitem ""
  +NOTELEFRAG
  +THRUSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
}

Actor BFGCacodemonGhostA
{
  Radius 2
  Height 2
  Speed 0
  Alpha 0.85
  Scale 1.0
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Fade:
    TNT1 A 1
	BFCD A 2 A_FadeOut(0.15)
	Goto Fade+1
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor CacoBFG9500Ball : BFG9500Ball
{
  Species "Cacodemon"
  DamageType "CacoComet"
  Damage (Random(200,500))
  Decal "BFG9500Lightning"
  -THRUSPECIES
  States
  {
  Spawn:
    BFS3 AAABBB 1 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom11", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BFE3 AB 8 Bright A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BFE3 C 8 Bright A_BFGSpray("CacoSpray",15,15)
    BFE3 DEF 8 Bright
    Stop    
  }
}

Actor CacoSpray : CustomSpray
{
  Species "Cacodemon"
  DamageType "CacoComet"
  +MTHRUSPECIES
  +DONTHARMSPECIES
  States
  {
  Spawn:
   TNT1 A 0
   BFE2 A 6 Bright A_SpawnItemEx("GreenParticleSpawnerDT", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
   BFE2 BCD 6 Bright 
   Stop
  }
}

Actor Caco15K : BFG15KBall
{
  FastSpeed 50
  -THRUSPECIES
  Species "Cacodemon"
  DamageType "CacoComet"
}