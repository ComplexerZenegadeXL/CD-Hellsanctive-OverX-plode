Actor Lamia : GenericBoss
{
  FloatSpeed 8
  Speed 8
  Health 3500
  +NORADIUSDMG
  +NOTIMEFREEZE
  PainSound "Lamia/pain"
  SeeSound "Lamia/Laugh"
  PainChance 15
  DamageFactor "PlayerLegendary", 0.5
  DropItem "BossLifeEssence" 255 25
  DropItem "BossArmorBonusMax" 255 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonicChaliceGiver" 96
  DropItem "SkullOfPowerGiver" 128
  DropItem "OccultSpellbookGiver" 200
  DropItem "LegendaryTimeFreezeSphere" 128 3
  DropItem "PlasmaHandgunUpgrade" 64
  DropItem "SalvationSphere" 100
  Obituary "$CFLamiaObit"
  Tag "$CFLamia"
  var int user_music;
  States
  {
  Spawn:
	LAMI A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",11) == 1, "Remove")
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
    LAMI ABCDEF 4 A_Look
    Loop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Cacodemon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	Stop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LAMI AAAABBBBCCCCDDDDEEEEFFFF 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,710)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LAMI GHIJKLMNOP 5
    Goto See2
  See2:
	TNT1 A 0 A_JumpIfHealthLower(500,"FinalSpell")
    LAMI AAAABBBBCCCCDDDDEEEEFFFF 1 A_Chase
    Loop
  Pain:
    LAMI I 0 A_Pain
    LAMI Q 10
    Goto Missile
  Melee:
  Missile:
    LAMI A 0 A_FaceTarget
	//LAMI A 0 A_JumpIfCloser(250, "Pusher")
	LAMI A 0 A_Jump(80,"StatusEffect")
    LAMI A 0 A_Jump(256,"TrailKnife","MoreKnives","KnifeLoop","KnifeIntensifies")
    Goto See2
  StatusEffect:
    LAMI A 0 A_Jump(256,"YellowCard","RedCard")
    Goto See2
/*  Pusher:
	TNT1 A 0 A_Playsound("Lamia/Pusher")
    LAA1 QRS 6
	TNT1 A 0 A_Playsound("PusherOrb/Thrown", 0)
	TNT1 A 0 A_RadiusThrust(8000, 500)
	LAA1 TUVWX 5
	Goto Missile */
  YellowCard:
	TNT1 A 0 A_PlaySound("Lamia/YellowCard")
    
	LAA1 ABC 5
	//LAA1 D 0 A_GiveInventory("TimeFreezeLamia")
	LAA1 D 0 A_CustomMissile("TFreezeEffect",30,0,0)
	LAA1 D 4 A_CustomMissile("LamiaTimeFreezer")
	LAA1 E 6 A_FaceTarget
	
	//LAA5 ABCDEFGHIJ 4
	//TNT1 A 0 A_CustomMissile("TFreezeEffect",30,0,0)
	//TNT1 A 0 A_PlaySound("Lamia/TimeFreeze",7,1,0,ATTN_NONE)
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	Goto Missile
  RedCard:
	TNT1 A 0 A_PlaySound("Lamia/RedCard")
    LAA1 AFG 5
	LAA1 H 4 A_CustomMissile("LamiaWeakener")
	LAA1 I 6
	LAA1 HGFA 4
	Goto TrailKnife
  TrailKnife:
	TNT1 A 0 A_PlaySound("Lamia/TrailKnife")
	LAA2 IJKLM 6
	LAA2 N 0 A_CustomMissile("LamiaTrailKnife",30,0,20)
	LAA2 N 0 A_CustomMissile("LamiaTrailKnife",30,0,-20)
	LAA2 N 0 A_CustomMissile("LamiaTrailKnife",30,0,0)
	LAA2 N 0 A_CustomMissile("LamiaTrailKnife",30,0,10,CMF_OFFSETPITCH,2)
	LAA2 N 0 A_CustomMissile("LamiaTrailKnife",30,0,-10,CMF_OFFSETPITCH,2)
	LAA2 N 5 A_CustomMissile("LamiaTrailKnife",30,0,0,CMF_OFFSETPITCH,2)
	LAA2 OPQR 5
	Goto See2
  MoreKnives:
	TNT1 A 0 A_PlaySound("Lamia/MKoKI")
    LAA3 KLMN 7
	LAA3 O 5
	TNT1 A 0 A_SetUserVar("user_loop",-10)
  MoreKnivesLoop:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 11,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop")
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  MoreKnivesLoop2:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 6,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  MoreKnivesLoop3:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 6,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop3")
	TNT1 A 0 A_SetUserVar("user_loop",-2)
  MoreKnivesLoop4:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,-3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 3,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop4")
	TNT1 A 0 A_SetUserVar("user_loop",-2)
  MoreKnivesLoop5:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,3,CMF_OFFSETPITCH,3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 3,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop5")
	LAA3 P 3
	TNT1 A 0 A_SetUserVar("user_loop",-10)
  MoreKnivesLoop6:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 11,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop6")
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  MoreKnivesLoop7:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 6,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop7")
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  MoreKnivesLoop8:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 6,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop8")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  MoreKnivesLoop9:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,-3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop9")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  MoreKnivesLoop10:
	LAA3 P 0 A_CustomMissile("LamiaBlueKnifeWeak",30,0,user_loop * 3,CMF_OFFSETPITCH,3)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"MoreKnivesLoop10")
	LAA3 PQ 3
	Goto See2
  KnifeLoop:
	TNT1 A 0 Thing_Stop(0)
	TNT1 A 0 A_PlaySound("Lamia/DKoKL")
	LAA3 ABCDE 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeLoop1:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop1")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop2:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop3:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop3")
	LAA3 F 3 ThrustThing(angle*256/360+64, 31, 1, 0)
	LAA3 GH 3
	TNT1 A 0 Thing_Stop(0)
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeLoop4:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop4")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop5:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop5")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop6:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop6")
	LAA3 F 3 ThrustThing(angle*256/360+192, 60, 1, 0)
	LAA3 GH 3
	TNT1 A 0 Thing_Stop(0)
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeLoop7:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop7")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop8:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop8")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeLoop9:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeLoop9")
	LAA3 GHI 6
	Goto See2
  KnifeIntensifies:
	TNT1 A 0 A_Playsound("Lamia/MKoKI")
	LAA3 ABCDE 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop1:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop1")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop2:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop3:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop3")
	LAA3 F 3 ThrustThing(angle*256/360+64, 31, 1, 0)
	LAA3 GH 3
	TNT1 A 0 Thing_Stop(0)
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop4:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeStrong",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop4")
	LAA3 GH 3
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop5:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop5")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop6:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop6")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop7:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop7")
	LAA3 F 3 ThrustThing(angle*256/360+192, 60, 1, 0)
	LAA3 GH 3
	TNT1 A 0 Thing_Stop(0)
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop8:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeStrong",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop8")
	LAA3 FGH 3
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop9:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop9")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop10:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak2",30,0,0,CMF_OFFSETPITCH,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop10")
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  KnifeIntensifiesLoop11:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeWeak3",30,0,0,CMF_OFFSETPITCH,-2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 4,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop11")
	LAA3 F 3 ThrustThing(angle*256/360+64, 31, 1, 0)
	LAA3 GH 3
	TNT1 A 0 Thing_Stop(0)
	LAA3 ABE 4
	TNT1 A 0 A_SetUserVar("user_loop",-4)
  KnifeIntensifiesLoop12:
	LAA3 F 0 A_CustomMissile("LamiaRedKnifeStrong",30,0,user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 5,2)
	TNT1 A 0 A_Jump(256,"KnifeIntensifiesLoop12")
	LAA3 GHI 6
	Goto See2
  FinalSpell:
	TNT1 A 0 A_ChangeFlag("NOPAIN",true)
	TNT1 A 0 A_SetMass(100000000)
	TNT1 A 0 A_PlaySound("Lamia/YellowCard")
    //LAA5 ABCDEFGHIJ 4
    LAA1 ABC 5
	//LAA1 D 0 A_GiveInventory("TimeFreezeLamia")
	LAA1 D 0 A_CustomMissile("TFreezeEffect",30,0,0)
	LAA1 D 4 A_CustomMissile("LamiaTimeFreezer")
	LAA1 E 6 A_FaceTarget
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	//LAA2 A 2 A_CustomMissile("LamiaTrailKnife",30,0,random(-10,10))
	LAA1 DCBA 4
	LAA4 ABCDABCDABCDABCDEFGHIJ 6
	LAA4 KLMNO 4
	LAA4 P 0 A_PlaySound("Lamia/Laugh", 0, 1, 0, ATTN_NONE)
  FinalSpellLoop:
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 P 4 A_CustomMissile("LamiaTrailKnife",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 Q 4 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 R 4 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 S 4 A_CustomMissile("LamiaTrailKnife",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 T 4 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaRedKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 PPPP 0 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	LAA4 U 4 A_CustomMissile("LamiaBlueKnifeWeak",frandom(20,40),0,frandom(-45, 45),CMF_OFFSETPITCH,frandom(-2,10))
	Loop
  Death:
	TNT1 A 0 A_ChangeFlag("LOWGRAVITY",1)
	TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
	TNT1 A 0 A_ChangeFlag("FLOAT",0)
    LAMI QRS 15
	TNT1 A 0 A_NoBlocking
    TNT1 A 0 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), 2, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("RedBossDeathExplode",0,0,32)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("Red2huBossDeathFlame",0,0,20,frandom(-3,3),frandom(-3,3),frandom(-3,3))
	TNT1 AAAAAAAAAAA 1 A_SpawnItemEx("Red2huBossDeathFlame3",0,0,frandom(5,55),frandom(-15,15),frandom(-15,15),frandom(-15,30))
    Stop
  }
}


