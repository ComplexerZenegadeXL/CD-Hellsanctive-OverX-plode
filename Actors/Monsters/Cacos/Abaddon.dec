Actor RMAbaddon : CFCacodemon
{
  Health 650
  PainChance 80
  DamageFactor "CacoComet", 0.0
  BloodColor "Red"
  ActiveSound "caco/active"
  MeleeSound "caco/melee"
  Obituary "$CFAbaddonObit"
  HitObituary "$CFAbaddonHitObit"
  DropItem "LifeEssence" 90
  DropItem "ArmorBonusMax" 90
  +MISSILEMORE
  Tag "$CFAbaddon"
  States
  {
  Spawn:
    ABDD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	ABDD A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ABDD A 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    ABDD A 3 A_Chase
	TNT1 A 0 A_Jump(13,"Evade")		 
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
	ABDD AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
	ABDD AAAA 3 A_Chase
	TNT1 A 0 A_Stop		 
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"Seeking")
  Normal:
    ABDD BC 6 A_FaceTarget
    ABDD D 2 Bright A_FaceTarget
	ABDD D 1 Bright A_CustomMissile("ABDBall",24,0,0,0,0)
    TNT1 A 0 A_CustomMissile("ABDBall",24,0,6,0,0)
    ABDD D 1 Bright A_CustomMissile("ABDBall",24,0,-6,0,0)
	ABDD CB 4 A_FaceTarget
	ABDD D 2 Bright A_FaceTarget
	ABDD D 1 Bright A_CustomMissile("ABDBall",24,0,0,0,0)
    TNT1 A 0 A_CustomMissile("ABDBall",24,0,6,0,0)
    ABDD D 1 Bright A_CustomMissile("ABDBall",24,0,-6,0,0)
    ABDD CB 4 A_FaceTarget
	TNT1 A 0 A_Jump(87,"Seeking")
    Goto See
  Seeking:
    ABDD BC 6 A_FaceTarget
	ABDD D 4 Bright A_CustomMissile("HeleBall",24,0,0,0,0)
	ABDD BC 6 A_FaceTarget
	ABDD D 4 Bright A_CustomMissile("HeleBall",24,0,0,0,0)
    ABDD CB 4	
	Goto See
  Melee:
    ABDD BC 5 A_FaceTarget
    ABDD D 5 A_MeleeAttack
	ABDD CB 5 A_FaceTarget
    Goto See
  Pain:
	ABDD E 3
	ABDD F 6 A_Pain
    Goto See
  XDeath:
  Death:
    ABDD G 8
    ABDD H 8 A_ScreamAndUnblock
	ABDD H -1
	Stop
  Crash:
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	ABDD I 4 A_PlaySound("Gore/Splat")
	ABDD J 4 A_NoBlocking
	ABDD K 4
	ABDD L -1 A_SetFloorClip
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_UnSetFloorClip
	ABDD KJIHG 5
	Goto See         
  }
}

Actor RedRMAbaddon : RMAbaddon
{
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Species "UltimateLegendary"
  Dropitem ""
  +NOTELEFRAG
  +THRUSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
}

Actor ABDBall : BaronBall
{
  Speed 16
  Damage 6
  Species "Cacodemon"
  DamageType "CacoComet"
  FastSpeed 20
  States
  {
  Spawn:
    ABD2 AB 1 Bright A_SpawnItemEx("ABDBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
    TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom10", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    ABB2 ABC 3 Bright
    Stop
  }
}

Actor ABDBall2Trail : BFG9500Trail
{
  Scale 0.85
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    ABD2 AB 1 A_FadeOut(0.25)
	Goto Spawn+3
  }
}