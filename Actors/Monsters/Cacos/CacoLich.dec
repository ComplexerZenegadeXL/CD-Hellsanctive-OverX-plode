Actor CacoLich : CFCacodemon
{
  Health 700
  Speed 12
  Radius 31
  Height 56
  PainChance 96
  Mass 500
  PainChance "SoulToxic", 40
  PainChance "FatFlamer", 40
  PainChance "FiendFire", 40
  DamageFactor "CacoComet", 0.0
  BloodColor "DarkGreen"
  DropItem "LifeEssence" 120
  DropItem "ArmorBonusMax" 120
  SeeSound "CacoLich/Sight"
  ActiveSound "CacoLich/Active"
  PainSound "CacoLich/Pain"
  DeathSound "CacoLich/Death"
  Obituary "$CFCacoLichObit"
  HitObituary "$CFCacoLichHitObit"
  Tag "$CFCacolich"
  Monster
  +NOGRAVITY
  +MISSILEMORE
  +QUICKTORETALIATE
  +FLOAT
  States
  {
  Spawn:
    CLIH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CLIH A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CLIH AA 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	CLIH A 3 A_Chase
	TNT1 A 0 A_Jump(6,"Evade")		 
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,14,0,0)
	CLIH AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,14,0,0)		 
	CLIH AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See	
  Missile:
	TNT1 A 0 A_Jump(128,"Comet","Seeking")
    CLIH EF 6 A_FaceTarget
	CLIH G 0 A_CustomMissile("WatcherBall", 24, 0, 0)
	CLIH G 0 A_CustomMissile("WatcherBall", 24, 0, 4)
    CLIH G 6 Bright A_CustomMissile("WatcherBall", 24, 0, -4)
    CLIH G 6 A_FaceTarget
    CLIH G 0
    Goto See	
  Seeking:
    CLIH B 6 A_Facetarget
	TNT1 A 0 A_CustomMissile("CacoLichBall",35,0,16,0,0)
	CLIH C 4 Bright A_CustomMissile("CacoLichBall",35,0,-16,0,0)
    CLIH CD 4	
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Comet:
    CLIH EF 6 A_Facetarget
	CLIH G 5 Bright A_CustomMissile("LichComet",24,0,0,0,0)
    CLIH GG 4
	Goto See
  Melee:
	CLIH EF 4 Bright A_FaceTarget 
	TNT1 A 0 A_PlaySound("monster/psoattack")
	CLIH G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIH F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	CLIH FG 3
	Goto See
  Pain:
    CLIH H 3 A_Jump(70,"PainMissile")
    CLIH I 6 A_Pain
    Goto See
  PainMissile:
    CLIH H 3
    CLIH I 6 A_Pain
    Goto Missile
  XDeath:
  Death:
    CLIH J 0 A_SetFloorClip
    CLIH J 6 A_Scream
    CLIH KLMN 6
    Wait
  Crash:
    CLIH OP 6 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    CLIH Q 6 A_NoBlocking
    CLIH R 6 
    CLIH S -1
    Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor RedCacoLich : CacoLich
{
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Species "UltimateLegendary"
  Dropitem ""
  +NOTELEFRAG
  +THRUSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
}

Actor CacoLichBall
{
  Radius 8
  Height 6
  Speed 20
  Damage (Random(25,40)) //7
  Species "Cacodemon"
  DamageType "CacoComet"
  Projectile
  +SEEKERMISSILE
  RenderStyle Add
  Alpha 0.8
  SeeSound "Imp/attack"
  DeathSound "Imp/shotx"
  Decal "CacoScorch"
  States
  {
  Spawn:
	CB4L AB 4 Bright A_SeekerMissile(5,15)
	TNT1 A 0 A_SpawnItemEx("WatcherBallTrail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	CB4L CDEFG 6 Bright
	Stop
  }
}

Actor LichBreath : PoisonSoulCloud
{ 
  Scale 0.85
  Speed 12
  Species "Cacodemon"
  DamageType "CacoComet"
  +MISSILE
 +THRUSPECIES
 +HEXENBOUNCE
  -NOGRAVITY
  Gravity 0.06
  States 
  { 
  Spawn: 
    TRPS AABBCDEFGDFEG 3 //A_Explode(2,68)
  Death: 
	TRPS CCBBAA 1 //A_FadeOut(0.15)
    Stop 
  } 
}
Actor LichComet : Comet
{
  Species "Cacodemon"
  DamageType "CacoComet"
  Scale 0.85
  States
  {
  Spawn:
    HCMT AAAABBBBCCCC 1 Bright A_SpawnItemEx("HDCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_Explode(64,102)
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    HCMT DE 3 Bright
    TNT1 A 0 A_SpawnItemEx("HDCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Stop
  }
}