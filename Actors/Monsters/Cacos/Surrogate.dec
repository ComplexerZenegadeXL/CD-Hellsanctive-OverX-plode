Actor SurrogatePortalProjectile : MainyuPortalProjectile { Species "Cacodemon" DamageType "CacoComet" }

Actor SurrogatePortalProjectileBig : MainyuPortalProjectileBig { Species "Cacodemon" DamageType "CacoComet" }

