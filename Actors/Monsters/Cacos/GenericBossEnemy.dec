Actor GenericBoss
{
  Monster
  Radius 20
  Height 62
  Scale 0.7
  Mass 1000
  MeleeThreshold 35
  MeleeRange 80
  PainChance 20
  Species "Touhou"
  DamageFactor "Touhou", 0.0 //RIP 2hu vs. 2hu
  DamageFactor "Uroboros", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "Cacolich", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.5
  DamageFactor "DBFG2", 0.0
  DamageFactor "HFCyb3r", 0.0
  +DONTHURTSPECIES
  +LOOKALLAROUND
  +FLOORCLIP
  +NOGRAVITY
  +FLOAT
  +BOSS
  +DONTMORPH
  +NOICEDEATH
  +NOTELEFRAG
  Seesound "Remsee"
  PainSound "remihurt"
  Deathsound "Realdead"
  var int user_lowlag;
  var int user_loop;
}

Actor 2huBossDeathFlame
{
  Speed 2
  RenderStyle Translucent
  Alpha 0.3
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 2
    2HDT ABCDEFGHIJKL 2 Bright A_SpawnItemEx("2huBossDeathFlame2",0,0,0,frandom(-4,4),frandom(-4,4),frandom(0,8))
    Stop
  }
}

Actor 2huBossDeathFlame2 : 2huBossDeathFlame
{
  States
  {
  Spawn:
    TNT1 A 2
    2HDT ABCDEFGHIJKL 2 Bright A_ChangeVelocity(0,0,1)
    Stop
  }
}

Actor 2huBossDeathFlame3 : 2huBossDeathFlame
{
  Speed 15
  Scale 0.35
  States
  {
  Spawn:
    TNT1 A 2
    2HDT ABCDEFGHIJKL 2 Bright A_SpawnItemEx("2huBossDeathFlame4",0,0,0,frandom(-2,0),frandom(-1,1),frandom(-1,1),0,0,0)
    Stop
  }
}

Actor 2huBossDeathFlame4 : 2huBossDeathFlame
{
  Scale 0.35
  States
  {
  Spawn:
    TNT1 A 2
    2HDT ABCDEFGHIJKL 2 Bright A_ChangeVelocity(0,0,1)
    Stop
  }
}

Actor BossDeathExplode : BaseProjectileEffect
{   
  Scale 0.5
  +NOTIMEFREEZE
  States
  {
  Spawn:
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(0.6)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(0.7)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(0.8)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(0.9)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.0)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.1)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.2)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.3)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.4)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.5)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.6)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.7)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.8)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(1.9)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(2.0)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(2.1)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(2.2)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(2.3)
	CLBC D 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_SetScale(2.4)
	CLBC D 2 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor 2huBossDeath
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("BossDeathExplode",0,0,32)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("2huBossDeathFlame",0,0,20,frandom(-3,3),frandom(-3,3),frandom(-3,3))
	TNT1 AAAAAAAAAAA 1 A_SpawnItemEx("2huBossDeathFlame3",0,0,frandom(5,55),frandom(-15,15),frandom(-15,15),frandom(-15,30))
	Stop
  }
}

