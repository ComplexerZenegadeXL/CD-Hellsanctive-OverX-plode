Actor MoonbitchSpawn
{
  +ISMONSTER
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",11) == 1, "Remove")
	TNT1 A 0 A_SpawnItemEx("Yorihime",-20,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("Toyohime",20,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
  Idle:
	TNT1 A 1 A_JumpIfInventory("VexedNemesisExileDeathToken",2,"Death")
    Loop
  Death:
	TNT1 A 0
	Stop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Cacodemon",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,0,tid)
	Stop
  No2HuLoop:
    TNT1 A 1 A_JumpIfInventory("VexedNemesisExileDeathToken",1,"Death")
	Loop
  }
}

Actor Toyohime : GenericBoss 31538
{
  //$Category "Touhou Characters"
  FloatSpeed 4
  Speed 4
  Health 2800
  +THRUSPECIES
  +MTHRUSPECIES
  DropItem "BossLifeEssence" 255 25
  DropItem "BossArmorBonusMax" 255 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "SkullOfPowerUpgrade", 32
  DropItem "DemonicChaliceUpgrade", 32
  Obituary "$CFToyohimeObit"
  HitObituary "$CFToyohimeHitObit"
  Tag "$CFToyo"
  States
  {
  Spawn:
    TOYO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	TOYO ABCDEFG 4 A_Look
    Loop
  See:
    TOYO AAAABBBBCCCCDDDDEEEEFFFFGGGG 1 A_Chase
    Loop
  Pain:
    TOYO H 0 A_PlaySound("remihurt")
    TOYO H 10
    Goto See
  Missile:
    TOYO A 0 A_FaceTarget
    TOYO A 0 A_Jump(256, "Orbs1", "Orbs2")
    Goto See
  Orbs1:
    TOYA A 2 A_FaceTarget
	TOYA BCDE 4
	TOYA FFFF 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA F 4 A_CustomMissile("ExplosivePinkOrb",30,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Orbs1Loop:
	TOYA FFFF 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA F 4 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TOYA FFFF 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA F 4 A_CustomMissile("ExplosivePinkOrb",30,0,0)
  TNT1 A 0 A_SetUserVar("user_loop",0)
  Orbs1Loop2:
	TOYA FFFF 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA F 4 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TOYA FFFF 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(-45, 45), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA F 4 A_CustomMissile("ExplosivePinkOrb",30,0,0)
	Goto See
  Orbs2:
    TOYA M 2 A_FaceTarget
	TOYA NOP 4
	TOYA Q 1 A_CustomMissile("ExplosivePinkOrb",30,0,0)
	TOYA Q 0 A_CustomMissile("ExplosivePinkOrb",30,0,45)
	TOYA Q 1 A_CustomMissile("ExplosivePinkOrb",30,0,90)
	TOYA Q 0 A_CustomMissile("ExplosivePinkOrb",30,0,135)
	TOYA Q 1 A_CustomMissile("ExplosivePinkOrb",30,0,180)
	TOYA Q 0 A_CustomMissile("ExplosivePinkOrb",30,0,225)
	TOYA Q 1 A_CustomMissile("ExplosivePinkOrb",30,0,270)
	TOYA Q 6 A_CustomMissile("ExplosivePinkOrb",30,0,315)
	TOYA PO 4
	TOYA RRRRRR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 3 A_CustomMissile("ExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Orbs2Loop:
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 11,1)
	Loop
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Orbs2Loop2:
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 10,1)
	Loop	
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Orbs2Loop3:
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA RR 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 0 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TOYA R 1 A_CustomMissile("SmallExplosivePinkOrb", 30, 0, frandom(0, 360), CMF_OFFSETPITCH, frandom(-5, 5))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop >= 11,"See")
	Loop
	Goto See
  Death:
	TOYO H 3
    TOYO I 30 A_GiveInventory("VexedNemesisExileDeathToken",1,AAPTR_MASTER)
	TOYO K 0 A_NoBlocking
    TOYO K 0 A_Scream
	TNT1 A 0 A_SpawnItemEx("BossDeathExplode",0,0,32)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("2huBossDeathFlame",0,0,20,frandom(-3,3),frandom(-3,3),frandom(-3,3))
	TNT1 AAAAAAAAAAA 1 A_SpawnItemEx("2huBossDeathFlame3",0,0,frandom(5,55),frandom(-15,15),frandom(-15,15),frandom(-15,30))
	Stop
  }
}