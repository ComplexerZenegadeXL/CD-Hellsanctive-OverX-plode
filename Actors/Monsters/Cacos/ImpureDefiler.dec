Actor ImpureDefiler : ImpureElemental
{
  Health 2000
  DamageFactor "Glaucoma", 0.0
  DropItem "BossLifeEssence", 200, 30
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "BossLifeEssence", 200, 30
  DropItem "CFBossArmorBonusMax25", 200
  DropItem "CFArmorBonusMax5", 200
  DropItem "ModdedSoulSphere", 64
  SeeSound "ImpRed/sight"
  PainSound "ImpRed/pain"
  ActiveSound "ImpRed/active"
  DeathSound "ImpRed/death"
  Obituary "$CFImpureDefilerObit"
  HitObituary "$CFImpureDefilerHitObit"
  Tag "$CFImpDef"
  var int user_loopm;
  States
  {
  Spawn:
	IMRE A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SetSolid
	IMRE A 10 Bright A_Look
	TNT1 A 0 HealThing(2)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	Loop
  See:
	TNT1 A 0 A_SetSolid
	IMRE AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Chase
	TNT1 A 0 HealThing(random(1,2))
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	Loop
  Melee:
	TNT1 A 0 A_SetSolid
	TNT1 A 0
	TNT1 A 0 A_Stop
	IMRE EFG 4 Bright A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	IMRE FE 4 Bright
	Goto See
  Missile:
	TNT1 A 0 A_SetSolid
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIfInTargetInventory("DFWeaken",1,7)
	TNT1 A 0 A_JumpIfCloser(860,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_JumpIfCloser(670,2)
	TNT1 A 0 A_Jump(99,2)
	TNT1 A 0 A_Jump(141,"Debuff")
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(100,"Debuff2")
	TNT1 A 0 A_JumpIfInTargetInventory("DFWeaken",1,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_Jump(128,"RapidFire")
	TNT1 A 0 A_Jump(75,"Comet")
	TNT1 A 0 A_JumpIfInTargetInventory("DFWeaken",1,2)
	TNT1 A 0 A_Jump(128,"HomingComets")
	TNT1 A 0 A_Jump(72,"HomingComets","Souls")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth",0)*0.13),"Dual")
	IMRE EFG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,5,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,10,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,-5,0)
	TNT1 A 0 A_CustomMissile("PaladinBall",24,-10,0)
	IMRE FE 3 Bright
	Goto See
  RapidFire:
	IMRE EFG 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinBall",24,0,frandom(-2,2))
	IMRE FE 3 Bright
	Goto See
  Debuff2:
  Debuff:
	TNT1 A 0 A_Stop
	"####" "#" 0 A_TakeInventory("WhirlTic",999)
	"####" "#" 0 A_TakeInventory("WhirlTic2",999)
	TNT1 A 0 A_CustomMissile("OnibiCharge",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("OnibiCharge",0,0,72,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("OnibiCharge",0,0,144,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("OnibiCharge",0,0,216,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("OnibiCharge",0,0,288,CMF_AIMDIRECTION)
	"####" "#" 0 A_GiveInventory("WhirlTic2",10)
	TNT1 A 0 A_SetUserVar("user_loopm", 0)
  DLoop:
	IMRE F 0 A_FaceTarget
	IMRE F 0 A_SetUserVar("user_loopm", user_loopm + 1)
	IMRE FFF 1 Bright A_GiveInventory("OnibiCharging",1)
	IMRE F 0 A_JumpIf(USER_LOOPM > 20, 1)
	Loop
  FDebuff:
	IMRE F 0 A_JumpIfInTargetInventory("DFWeaken",1,"FDebuff2")
	"####" "#" 0 A_JumpIfTargetInLOS(2,128,JLOSF_DEADNOJUMP,860)
	"####" "#" 0 A_Jump(256,2)
	"####" "#" 0 A_GiveToTarget("DefilersMark",1)
	"####" "#" 0 A_RadiusGive("DefilersMarkWeak",512,RGF_PLAYERS,1)
	"####" "#" 0 A_TakeInventory("WhirlTic",999)
	"####" "#" 0 A_TakeInventory("WhirlTic2",999)
	TNT1 A 0 A_SpawnItemEx("OnibiShock", 0, 0, 38, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("DefilerMark",0,1.0,0,ATTN_NORM)
	IMRE FEE 3 Bright A_RadiusGive("DefilersMarkWeak",512,RGF_PLAYERS,1)
	IMRE G 28 Bright
	IMRE DCB 4
	Goto See
  FDebuff2:
	"####" "#" 0 A_GiveToTarget("SlayersOmen",1)
	"####" "#" 0 A_RadiusGive("DefilersMarkWeak",512,RGF_PLAYERS,1)
	"####" "#" 0 A_TakeInventory("WhirlTic",999)
	"####" "#" 0 A_TakeInventory("WhirlTic2",999)
	TNT1 A 0 A_SpawnItemEx("OnibiShock", 0, 0, 38, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("DefilerMark",0,1.0,0,ATTN_NORM)
	IMRE FEE 3 Bright A_RadiusGive("DefilersMarkWeak",512,RGF_PLAYERS,1)
	IMRE G 28 Bright
	IMRE DCB 4
	Goto See
  Comet:
	IMRE EF 4 Bright A_FaceTarget
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PaladinComet",24,0,0)
	TNT1 A 0 A_CustomMissile("PaladinComet",24,0,-5)
	TNT1 A 0 A_CustomMissile("PaladinComet",24,0,5)
	IMRE GFE 3 Bright
	Goto See
  HomingComets:
	IMRE EF 4 Bright A_FaceTarget
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,5)
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,-5)
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,-15)
	TNT1 A 0 A_CustomMissile("HomingComet",24,0,15)
	IMRE GFE 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_ChangeFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(89,"Souls")
	Goto See
  Souls:
	IMRE EF 5 Bright
	IMRE G 3 Bright A_FaceTarget
	//TNT1 A 0 A_Jump(32,"LegLostSoul")
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMRE EF 3 Bright
	Goto See
  LegLostSoul:
	TNT1 A 0 A_PainAttack("LegendaryHeroSoul")
	IMRE EF 3 Bright
	Goto See
  Dual:
	IMRE EF 5 Bright
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_DualPainAttack("SummonedImpureSoul")
	IMRE EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_Jump(89,"Rapid")
	Goto See
  Rapid:
	IMRE EF 5 Bright
	IMRE G 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMRE G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMRE G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMRE G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMRE EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	Goto See
  Pain:
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	IMRE H 3 Bright A_Pain
	TNT1 A 0 A_Jump(40,"Missile")
	Goto See
  XDeath:
  Death:
	IMRE I 6 Bright A_Scream
	IMRE J 3 Bright A_Fall
	TNT1 A 0 A_PlaySound("comet/explosion",CHAN_BODY,1.0,0)
	TNT1 AAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(70,198)
	TNT1 AAAAAA 0 A_SpawnItemEx("Debris",0,0,32,frandom(-8,8),frandom(-8,8),frandom(8,12),0,SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom27",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_PainDie("SummonedImpureSoul")
	IMRE KL 3 Bright
	IMRE MNOP 2 Bright
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	IMRE Q 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	IMRE RSTU 3
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	IMRE V -1
	Stop
  }
}

Actor BaseFXCF17
{
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +NOBLOCKMAP
  +NOINTERACTION
  +NOGRAVITY
  +DONTSPLASH
  +EXPLODEONWATER
  +NOTELESTOMP
  Radius 2
  Height 2
  States
  {
  Vanilla:
	TNT1 A 0
   Stop
  }
}

Actor OnibiShock : BaseFXCF17
{
  Reactiontime 4
  Renderstyle Add
  Scale 1.15
  +Missile
  States
  { 
  Spawn:
	IMOS A 1 Bright A_SetTranslucent(0.9,1)
	IMOS C 1 Bright A_SetTranslucent(0.8,1)
	IMOS E 1 Bright A_SetTranslucent(0.7,1)
	IMOS G 1 Bright A_SetTranslucent(0.6,1)
	IMOS I 1 Bright A_SetTranslucent(0.5,1)
	IMOS K 1 Bright A_SetTranslucent(0.4,1)
	IMOS M 1 Bright A_SetTranslucent(0.3,1)
	IMOS N 1 Bright A_SetTranslucent(0.2,1)
	IMOS O 1 Bright A_SetTranslucent(0.1,1)
	IMOS P 1 Bright A_SetTranslucent(0.045,1)
	TNT1 A 0 A_CountDown
	Loop
  Death:
	TNT1 A 1
  Stop
  }
}

Actor DFMarkFX : BaseFXCF17
{
  States
  {
   Spawn:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("AracknightVileFireB",0,0,34)
	Stop
  }
}
Actor DFMarkFXEx : BaseFXCF17
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 AA 0 A_SpawnItemEx("AracknightVileFireB",0,0,34)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 34, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BlueCometDeathGlow",0,34,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("BlueCometDeath",0,0,0,34,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor PowerDamageUp : PowerDamage { Inventory.Icon "DAMGU0" }
Actor PowerDamageDown : PowerDamage { Inventory.Icon "DAMGD0" }
Actor PowerProtectDown : PowerProtection { Inventory.Icon "DEFSDWN" }
Actor PowerSpeedDown : PowerSpeed { Inventory.Icon "SPEDD0" }

Actor DFWeaken : PowerDamageDown
{
  DamageFactor "Normal", 0.7
  DamageFactor "Legendary", 0.2
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "Legendary1", 0.2 
  Powerup.Duration -8
}
Actor DFEnfeeble : PowerProtectDown { DamageFactor "Normal", 1.35 Powerup.Duration -7 }
Actor DFFatigue : PowerSpeedDown { Speed 0.75 Powerup.Duration -6 }
Actor DFDisplace : PowerSpeed { Speed 20.0 Powerup.Duration 7 }

Actor DefilersMark  : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
   PickUp:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") != 0,"Null")
	TNT1 A 0 A_JumpIfInventory("LeggingsofNormalcyEquipped",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("Defiler's Mark", 0, 5)
	Stop
  }
}
Actor SlayersOmen  : CustomInventory
{
 +INVENTORY.ALWAYSPICKUP
 States
  {
   PickUp:
   	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") != 0,"Null")
	TNT1 A 0 A_JumpIfInventory("LeggingsofNormalcyEquipped",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("Slayer's Omen", 0, 875)
	Stop
  }
}
Actor DefilersMarkWeak  : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
   	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") != 0,"Null")
	TNT1 A 0 A_JumpIfInventory("LeggingsofNormalcyEquipped",1,"Null")
	TNT1 A 0 ACS_NamedExecuteAlways("Defiler's Mark", 0, 5, 1)
	Stop
  }
}
Actor OnibiCharging  : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
    TNT1 A 0 A_GiveInventory("WhirlTic",1)
	TNT1 A 0 A_GiveInventory("OnibiChargeCheck",1)
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("Whirls") == 1, "PickUp.Sound")
	Stop
  PickUp.Sound:
    TNT1 A 0 A_TakeInventory("WhirlTic2",1)
    TNT1 A 0 A_TakeInventory("WhirlTic",999)
	TNT1 A 0 A_PlaySound("FireWhirl",0,1.0,0)
	Stop
  }
}

Actor OnibiChargeCheck : PowerSpeed { Powerup.Duration 3 Speed 1 }

Actor OnibiCharge
{
  Projectile
  Renderstyle Add
  Scale 1.85
  Health 200
  Height 22
  Radius 22
   //BloodColor None
  Species "Cacodemon"
  +SEEKERMISSILE
  +SHOOTABLE
  +SOLID
  -NOBLOCKMAP
  +NOBLOOD
  +THRUSPECIES
  +MTHRUSPECIES
  var int user_onspeed;
  var int user_ondist;
  Speed 0
  States
  {
  Spawn:
	IMSB N 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,1)
	Goto Death
	IMSB O 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,1)
	Goto Death
	IMSB P 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	IMSB A 1 Bright A_SetUserVar ("user_ondist", user_ondist + 1)
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,1)
	Goto Death
	IMSB Q 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	IMSB A 1 Bright A_SetUserVar ("user_ondist", user_ondist + 1)
	IMSB A 1 Bright A_SetUserVar ("user_onspeed", user_onspeed + 1)
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,1)
	Goto Death
	IMSB R 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	IMSB A 1 Bright A_SetUserVar ("user_ondist", user_ondist + 1)
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,1)
	Goto Death
	IMSB S 1 Bright A_Warp(AAPTR_TARGET,50 - user_ondist,0,32,user_onspeed,WARPF_USECALLERANGLE|WARPF_NOCHECKPOSITION  )
	IMSB A 1 Bright A_SetUserVar ("user_onspeed", user_onspeed + 1)
	IMSB A 1 Bright A_SetUserVar ("user_ondist", user_ondist + 1)
	TNT1 A 0 A_JumpIfInTargetInventory("OnibiChargeCheck",1,"Spawn")
	Goto Death
  Death:
	IMSB TUVW 3 Bright A_FadeOut
	Wait
  }
}
//replace with some dummy actor please
Actor DummyCFUP : Inventory { +INVENTORY.PERSISTENTPOWER }

Actor WhirlTic : DummyCFUP { Inventory.MaxAmount 99999 }
Actor WhirlTic2 : DummyCFUP { Inventory.MaxAmount 99999 }