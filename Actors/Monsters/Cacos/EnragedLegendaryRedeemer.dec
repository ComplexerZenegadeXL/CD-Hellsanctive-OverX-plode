Actor ELegRedThunderCharge
{
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  RenderStyle Add
  Alpha 0.0
  Scale 0.25
  var int user_delay;
  var int user_alpha;
  States
  {
  Spawn:
	TNT1 AAAAA 7 A_SpawnItemEx("EnragedSphereLightning",0,0,32,0,0,0,0,0,172)
  SpawnLoop:
    TNT1 A 0 A_JumpIf(user_alpha >= 8,"Doing")
	TNT1 A 0 A_SetTranslucent(Alpha+0.1,1)
	TNT1 A 0 A_PlaySound("reedemer/charge")
	ERD5 ABCDCB 1 bright A_SpawnItem("LegRedThunderMistSpawner",0,32)
	TNT1 A 0 A_SetUserVar(user_alpha,user_alpha+1)
	Loop
  Doing:
    TNT1 A 0 A_PlaySound("reedemer/thunder",5,1,1)
    TNT1 A 0 A_JumpIf(user_delay > 15,"Death")
	TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
	ERD5 ABCDCB 1 bright A_SpawnItem("LegRedThunderMistSpawner",0,32)
	LRD5 AAA 0 A_SpawnItemEx("EnragedSphereLightning",0,0,32,0,0,0,0,0,160)
	Loop
  Death:
	TNT1 A 1 A_StopSound(5)
	TNT1 A 1
	Stop	
  }
}


