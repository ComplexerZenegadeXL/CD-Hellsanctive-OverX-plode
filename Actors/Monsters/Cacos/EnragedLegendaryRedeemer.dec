Actor EnragedLegendaryRedeemer 
{
  Monster
  Health 1900
  Radius 31
  Height 56
  Mass 400
  Speed 16
  PainChance 22
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +BOSS
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NORADIUSDMG
  +NOFEAR
  +BRIGHT
  +NOTELEFRAG
  BloodColor "Red"
  Species "Cacodemon"
  Species "Redeemer"
  DamageFactor 0.55
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.2
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.110
  DamageFactor "PlayerDevBall2", 0.110
  DamageFactor "PlayerDevTracer", 0.110
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "DTRailgun", 0.2
  DamageFactor "PlayerNemesisPlasma", 0.4
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 144
  DropItem "LegendaryBossArmorBonusMax" 144
  DropItem "ILDemonAmmoPickup" 250
  DropItem "ILDemonAmmoBoxPickup" 250
  DropItem "LegendaryPowerSphere" 105
  DropItem "LegendaryTimeFreezeSphere" 100
  DropItem "EnragedLegendarySphere" 120
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 150
  DropItem "EnragedLegendaryPowerShard" 85
  DropItem "LegendaryRandomSphere" 16
  SeeSound "EnragedRedeemer/See"
  PainSound "EnragedRedeemer/Pain"
  DeathSound "EnragedRedeemer/Death"
  ActiveSound "redeemer/idle"
  Obituary "$CFEnragedLegendaryRedeemerObit"
  Tag "$CFEnrRedeem"
  var int user_delay;
  var int user_portal;
  var int user_suicide;
  var int user_timer;
  var int user_music;
  var int user_clone;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    ERED A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",31)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle2:
	ERED A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",31)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ERED AAA 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,410)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_delay",0)
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
    ERED AAA 2 A_Chase
	TNT1 A 0 A_Jump(68,"Avoid","Rush","Trap","Teleport")
    Loop
  Rush:
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	ERED AA 0 A_Chase
    ERED A 1 A_SpawnItemEx("ELegendaryRedeemerGhost")
	TNT1 A 0 A_Jump(12,"See")
    Loop
  Avoid:
	ERED G 0
	TNT1 A 0 A_JumpIf(user_suicide == 1,"SeeSuicide")
	ERED G 0 A_SetAngle(angle+random(-90,90))
	ERED G 0 A_Recoil(-50)
	ERED G 0 A_FaceTarget
	ERED GGGGGGGGGGGGG 1 A_SpawnItemEx("ELegendaryRedeemerGhost2")
	TNT1 A 0 A_Jump(145,"See")
	ERED G 1 A_Stop
    Goto Avoid
  Teleport:
    ERED A 1 A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	ERED AAAAA 1 A_FadeOut(0.2,0)
	ERED AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	ERED A 8
	ERED A 0 A_JumpIf(user_clone >= 3,9)
	ERED A 0 A_JumpIfCloser(2500,2)
	ERED A 0 A_Jump(256,7)
	ERED A 0 A_SpawnItemEx("FakeELegendaryRedeemer",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS,192)
	ERED A 0 A_SetUserVar("user_clone",user_clone+1)
	ERED A 8
	ERED AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    ERED A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ERED AAAAA 1 A_FadeIn(0.2)
    ERED A 1 A_SetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",31)
    Goto See		
  Trap:
    ERED B 0
	TNT1 A 0 A_JumpIf(user_suicide >= 1,"SeeSuicide")
    ERED B 0 A_SetAngle(random(0,359))
	ERED B 0 A_JumpIfCloser(2,2)
	ERED B 0 A_Jump(256,"See")
    ERED BC 5
	ERED D 0 A_PlaySound("reedemer/trap")
    ERED D 5 A_SpawnItemEx("LegRedTrap",45,0,16,15)
    Goto See
  Melee:
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_JumpIf(user_suicide >= 1,"MissileSuicide")
	TNT1 A 0 A_JumpIfHealthLower(200,"Suicide")
    TNT1 A 0 A_Jump(127,"Laser","TrapAttack","StrikeBolts","BFG")
	TNT1 A 0 A_Jump(64,"Thunder","StormBall","StrikeBoltStorm")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(48,"Portal")
  Normal:
    ERED BC 5 A_FaceTarget
	ERED D 0 A_CustomMissile("ELegRedBall",30,10)
    ERED D 0 A_CustomMissile("ELegRedBall",30,-10)
	ERED D 0 A_CustomMissile("ELegRedBall",30)
	ERED D 0 A_CustomMissile("ELegRedBall",20,10)
    ERED D 0 A_CustomMissile("ELegRedBall",20,-10)
	ERED D 0 A_CustomMissile("ELegRedBall",20)
    ERED D 0 A_CustomMissile("ELegRedBall",15,-10)
    ERED D 0 A_CustomMissile("ELegRedBall",15,10)
	ERED D 5 A_CustomMissile("ELegRedBall",15)
	ERED D 0 A_Jump(127,"Laser","See","Avoid")
	ERED D 0 A_CposRefire
    Goto Normal
  Laser:
    ERED BC 5 A_FaceTarget
  LaserLoop:
    TNT1 A 0 A_JumpIf(user_delay >= 15,"See")
    ERED D 3 A_CustomMissile("ELegRedLaser",25)
	ERED D 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
    Loop
  TrapAttack:
    ERED BC 5 A_FaceTarget
	ERED D 0 A_SpawnItemEx("ELegRedTrap",45,0,16,15,-4)
	ERED D 0 A_SpawnItemEx("ELegRedTrap",45,0,16,15,4)
    ERED D 5 A_SpawnItemEx("ELegRedTrap",45,0,16,15)
	ERED D 0 A_Jump(127,"Teleport")
	ERED D 0 A_Jump(64,"Thunder")
	ERED D 0 A_CposRefire
    Goto See
  StormBall:
    ERED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("redeemer/see")
	ERED EFG 6 A_FaceTarget
  StormBallCharge:
    TNT1 A 0 A_JumpIf(user_delay >= 20,"StormBallDone")
	TNT1 A 0 A_SpawnItemEx("StormBallCharge",64,0,18)
	ERED G 4
	TNT1 A 0 A_SetUserVar(user_delay,user_delay+1)
	Loop
  StormBallDone:
    ERED G 0 A_SetUserVar("user_delay",0)
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ERED G 3 A_CustomMissile("EnragedStormBall",18)
    ERED GFE 8 A_FaceTarget
	Goto See
  Thunder:
    ERED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("redeemer/see")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
    ERED EF 6 A_FaceTarget
	ERED G 0 A_Stop
	ERED G 3 A_SpawnItemEx("ELegRedThunderCharge",64)
  ThunderCharge:
	ERED G 0 A_JumpIf(user_delay >= 57,"ThunderDone")
	ERED G 0 A_SetUserVar("user_delay",user_delay+1)
	ERED G 3 A_Stop
	Loop
  ThunderDone:
	ERED G 0 A_SetUserVar(user_delay,0)
	ERED G 3 A_FaceTarget
	ERED G 3 A_CustomMissile("ELegRedThunderBall",5)
	ERED G 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ERED G 0 A_SetAngle(angle+random(-90,90))
	ERED G 0 A_Recoil(-50)
	ERED G 0 A_FaceTarget
	ERED GGGGGGGGGGGGGGG 1 A_SpawnItemEx("ELegendaryRedeemerGhost2")
	ERED G 3 A_FaceTarget
	ERED G 3 A_CustomMissile("ELegRedThunderBall",5)
	ERED GG 4 A_FaceTarget
	TNT1 A 0 A_Stop
	ERED G 0 A_Jump(127,"Avoid")
	Goto See
  StrikeBolts:
	ERED EF 12 A_FaceTarget
	ERED FF 0 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	ERED G 10 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	ERED FF 0 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	ERED G 10 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	ERED FF 0 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	ERED G 10 A_CustomMissile("ERedStrikeBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_Jump(64,"StormBall")
    Goto See
  StrikeBoltStorm:
	ERED EF 12 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,-24)
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,24)
	ERED G 10 A_CustomMissile("ERedStrikeStormBolt",41)
	ERED GGFFEE 8 A_FaceTarget
	TNT1 A 0 A_Jump(64,"StormBall")
    Goto See
  BFG:
    TNT1 A 0 A_PlaySound("weapons/bfgf")
    ERED EF 9 A_FaceTarget
	TNT1 A 0 A_CustomMissile("EnragedBFG9500R",41)
	ERED GGG 4 A_FaceTarget
	Goto See
  Portal:
    TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    ERED EEEEFFFF 8 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SuicideClonePortal",frandom(-256,256),frandom(-256,256),frandom(-24,24))
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ERED GGGGGGGG 8 A_FaceTarget
	Goto See
  Suicide:
	TNT1 A 0 A_JumpIf(user_suicide == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,6,1)
	TNT1 A 0 A_SetUserVar("user_suicide",1)
	ERED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERED E 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_suicide,1)
	TNT1 A 0 A_ChangeFlag("NOBLOCKMONST",TRUE)
	TNT1 A 0 A_SpawnItemEx("ELRedFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("redeemer/see")
	TNT1 A 0 Radius_Quake(8,120,0,20,0)
    ERED EEEEEEEEEEEEEFFFFFFFFFFFFFFFGGGGGGGGGGGGGGGGG 3 A_SpawnItemEx("ELRedFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto SeeSuicide
  SeeSuicide:
    ERED A 0 A_JumpIf(user_timer >= 600,"Explode")
	ERED A 0 A_SetUserVar("user_timer",user_timer+1)
	TNT1 A 0 A_SpawnItem("ELRedFlameSpawner")
	TNT1 A 0 A_Jump(4,"MissileSuicide")
	ERED AAAAAA 1 A_Chase
    Loop
  MissileSuicide:
    TNT1 A 0 A_SetTranslucent(1)
	ERED A 0 A_JumpIf(user_timer >= 390,"Kamikaze")
	TNT1 A 0 A_ChangeFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(48,"SuicidePortals")
    TNT1 A 0 A_Jump(96,"SuicideStrikeBoltStorm")
  SuicideStormBall:
    ERED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERED E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("redeemer/see")
	ERED EFG 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("EnragedStormBall",5,0,-25)
	TNT1 A 0 A_CustomMissile("EnragedStormBall",5,0,25)
	ERED G 3 A_CustomMissile("EnragedStormBall",5)
    ERED GGFFEE 8 A_FaceTarget
	ERED A 0 A_SetUserVar(user_timer,user_timer+30)
	Goto See
  SuicideStrikeBoltStorm:
	ERED EF 12 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,-24)
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,24)
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,-156)
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,156)
	TNT1 A 0 A_CustomMissile("ERedStrikeStormBolt",41,0,180)
	ERED G 10 A_CustomMissile("ERedStrikeStormBolt",41)
	ERED GGFFEE 6 A_FaceTarget
	ERED A 0 A_SetUserVar(user_timer,user_timer+45)
    Goto See
  SuicidePortals:
    ERED E 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	ERED EEEEFFFF 8 A_FaceTarget
	ERED FFFF 8 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SuicideClonePortal",frandom(-256,256),frandom(-256,256),frandom(-24,24))
    ERED GGGGGGGG 8 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SuicideClonePortal",frandom(-512,512),frandom(-512,512),frandom(-24,24))
    ERED GGGGGGGG 8 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SuicideClonePortal",frandom(-896,896),frandom(-896,896),frandom(-24,24))
    ERED GGGGGGGG 8 A_FaceTarget
	ERED GGFFEE 6 A_FaceTarget
	ERED A 0 A_SetUserVar(user_timer,user_timer+90)
    Goto See
  Kamikaze:
    TNT1 A 0
	ERED GGGG 5 A_FaceTarget
	ERED G 0 A_JumpIfTargetInLos(1)
	Goto SeeSuicide
	ERED G 0 A_JumpIfCloser(200,"Explode")
	TNT1 A 0 A_SpawnItemEx("ELRedFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ERED G 3 A_SkullAttack(45)
    Goto Kamikaze+4  
  Explode:
	TNT1 A 0 A_CustomMissile("LegSuicideBomb")
    TNT1 A 0 A_SpawnItemEx("ELegendaryStrike")
    ERED J 3 A_Die
    Goto Death
  Pain:
	TNT1 A 0 A_KillChildren	
  	TNT1 A 0 A_Jump(21,"Teleport")	
    ERED H 2
    ERED H 2 A_Pain
	TNT1 A 0 A_Jump(128,"Missile")
    Goto See	
  Death:
    ERED I 5 Bright A_Scream
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
    ERED JJJJKKKKLL 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator")
	TNT1 A 0 A_SpawnItemEx("EnragedDeathBallMedium")
    ERED M 0 A_NoBlocking
	ERED M 0 A_KillChildren
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
    ERED MNOPQRSTU 2 
	ERED V 50
	ERED VVVVVVVVVVVVVVVVVVVVVVVV 3 A_SpawnItemEx("ELegTrapSpawners",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,128)
	ERED V 150
	ERED VVVVVVVVVVVVVVVVVVVV 2 A_SpawnItemEX("LegRedStormBoltSpawner",frandom(-180,180),frandom(-180,180))
    ERED V -1 A_BossDeath
    Stop
  }
}

Actor ELegRedBall
{
  Radius 8
  Height 6
  Speed 16
  Damage (Random(20,50)) //10
  Scale 0.85
  Projectile
  RenderStyle Add
  Speed 28
  FastSpeed 36
  SeeSound "monsters/newfireshoot"
  DeathSound "monsters/newfireexplode"
  Decal "DoomImpScorch"
  Species "Cacodemon"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +BRIGHT
  States
  {
  Spawn:
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	ERD1 AB 1 A_SpawnItemEx("ELegRedBallTrail")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	Loop
  Death:
	TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	ERD1 CDEFG 3
	Stop
  }
}

Actor FakeELegRedBall : ELegRedBall { Damage 3 }

Actor ELegRedBallTrail : LegRedBallTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    ERD1 HIJKLM 2 A_FadeOut(0.15)
	Stop
  }
}

Actor ELegRedLaser : LegRedLaser
{
  Height 6
  Radius 6
  Damage (Random(20,35)) //8
  SeeSound "baron/attack"
  DeathSound "baron/shotx"
  -RIPPER
  +EXTREMEDEATH
  +NOTIMEFREEZE
  +BRIGHT
  Speed 130
  Scale 0.75
  MissileType "ELegRedLaserTrail"
  MissileHeight 8
  RenderStyle Add
  Decal "DoomImpScorch"
  States
  {
  Spawn:
	ERD1 ABCB 1
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAA 0 A_CustomMissile("EKaboomLN2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	ERD1 DDFFGGGGG 2 A_FadeOut
	Stop
  }
}
Actor ELegRedLaserTrail
{
  Scale 0.75
  +NOGRAVITY
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +BRIGHT
  Alpha 0.85
  Renderstyle Add
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	ERD1 AAA 3 
	ERD1 DDFFGGGGG 1 A_FadeOut
	Wait
  Vanilla:
    TNT1 A 0
	Stop 
  }
}

Actor ELegRedTrap
{ 
  Health 25
  Radius 16 
  Height 32 
  Mass 3000 
  Speed 0
  Monster
  +LOOKALLAROUND
  +AMBUSH
  +DONTGIB
  +NOTARGET
  +NOINFIGHTING
  +NOGRAVITY 
  +FLOAT
  +DONTFALL
  +NOPAIN
  +DONTHARMSPECIES
  +NOBLOCKMONST
  +NOTIMEFREEZE
  -COUNTKILL
  -SOLID
  +BRIGHT
  SeeSound "reedemer/trap"
  DeathSound "weapons/rocklx"
  BloodColor "Red"
  Species "Redeemer"
  Species "Cacodemon"
  DamageType "Legendary"
  DamageFactor "CacoComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.0
  Scale 1.15
  Obituary "$CFELegRedTrapObit"
  var int user_delay;
  States 
  { 
  Spawn:
    ERD4 A 20
	ERD4 A 1 A_Stop
	ERD4 A 0 A_JumpIf(user_delay >= 260,"Suicide")
	ERD4 A 0 A_SetUserVar("user_delay",user_delay+1)
	ERD4 ABCD 1 A_Look
    Goto Spawn+2
  See:
    ERD4 ABCD 2 A_Chase
    Goto Missile
  Missile:
	ERD4 A 0 A_JumpIfTargetInLos(1)
	Goto Clear
	ERD4 A 0 A_JumpIfCloser(100,"Suicide")
    ERD4 ABCD 4 A_SkullAttack(18)
    Loop  
  Clear:
    ERD4 A 4 A_ClearTarget
    Goto Spawn+2 
  Suicide:
    ERD4 A 2 A_Die
    Goto Spawn+2    
  Death:
	TNT1 A 0 A_PlayWeaponSound("weapons/rocklx")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(8,16),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), 2, frandom(0,360))   
	TNT1 A 0 A_Explode(188,128,XF_NOTMISSILE)
	Stop
  } 
}

Actor FakeELegendaryRedeemer
{
  Monster
  Health 400
  Radius 31
  Height 56
  Speed 12
  Alpha 0.6
  RenderStyle Translucent
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +NOINFIGHTING
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +NOPAIN
  -COUNTKILL
  -SOLID
  +BRIGHT
  BloodColor "Red"
  DamageFactor 0.85
  DamageFactor "CacoComet", 0.0
  Species "Redeemer"
  Scale 1.15
  SeeSound "redeemer/see"
  PainSound "redeemer/pain"
  DeathSound "redeemer/death"
  ActiveSound "redeemer/idle"
  Obituary "$CFFakeELegendaryRedeemerObit"
  Tag "$CFFakeELegendaryRedeemer"
  States
  {
  Spawn:
    ERED AAA 0 A_SpawnItem("ELRedeYSmokeSpawner")
    ERED A 10 A_Look
    Loop
  See:
	TNT1 AAA 0 A_SpawnItem("ELRedeYSmokeSpawner")
    ERED AAA 2 A_Chase
	TNT1 A 0 A_Jump(48,"Rush")
    Loop
  Rush:
	TNT1 AAA 0 A_SpawnItem("ELRedeYSmokeSpawner")	
	ERED AA 0 A_Chase
    ERED A 1 A_SpawnItemEx("ELegendaryRedeemerGhost")
	TNT1 A 0 A_Jump(12,"See")
    Loop
  Missile:
    TNT1 A 0 A_Jump(32,"Kamikaze")
    ERED BC 5 A_FaceTarget
	ERED D 0 A_CustomMissile("FakeELegRedBall",30,10)
    ERED D 0 A_CustomMissile("FakeELegRedBall",30,-10)
	ERED D 0 A_CustomMissile("FakeELegRedBall",20,10)
    ERED D 5 A_CustomMissile("FakeELegRedBall",20,-10)
    Goto See	
  Over:	
	TNT1 A 0 A_Stop
	ERED A 1 A_Die	 
	Goto See
  Kamikaze:
    TNT1 A 0
	ERED GGGG 5 A_FaceTarget
	ERED G 0 A_JumpIfTargetInLos(1)
	Goto See
	ERED G 0 A_JumpIfCloser(200,"Explode")
	TNT1 A 0 A_SpawnItem("ELRedFlameSpawner")
    ERED G 3 A_SkullAttack(45)
    Goto Kamikaze+6  
  Explode:
    ERED J 3 A_Die("Explode")
    Goto Death.Explode
  Death:
	ERED EF 5 A_FaceTarget
    ERED G 4 A_ScreamAndUnblock
	ERED GGGGGGGGGG 4 A_FadeOut(0.1)
	ERED G 1
	Stop
  Death.Explode:
	ERED I 5 A_Scream
    ERED JJJJKKKKLL 2 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
    ERED M 0 A_NoBlocking
	ERED M 0 A_KillChildren
	TNT1 A 0 A_Explode(480,326)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave",0,0,15,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 AA 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItem("RedDTBFGEx",0,-10)
    ERED MNOPQRSTUV 4 
	ERED VVVVVVV 3 A_FadeOut(0.1)
    Stop
  }
}

