Actor LegNecromancerShot
{
  Radius 8
  Height 16
  Speed 45
  Damage (Random(25,35)) //7
  Species "Cacodemon"
  DamageType "Legendary"
  RenderStyle Add
  Alpha 0.67
  Projectile
  +SEEKERMISSILE
  +NOTIMEFREEZE
  +EXTREMEDEATH
  SeeSound "DBish/Atk1"
  DeathSound "monster/acohit"
  Decal "DoomImpScorch"
  States
  {
  Spawn:
    LMF0 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
    LMF0 A 0 A_CustomMissile("LegNecromancerShotFX",0,0,0,0)
    LMF0 B 0 A_SeekerMissile(1,3)
    LMF0 A 1 Bright A_Weave(3, 3, 2.0, 1.0)
    LMF0 A 0 A_CustomMissile("LegNecromancerShotFX",0,0,0,0)
    LMF0 B 0 A_SeekerMissile(1,3)
    LMF0 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
    LMF0 A 0 A_CustomMissile("LegNecromancerShotFX",0,0,0,0)
    LMF0 B 0 A_SeekerMissile(1,3)
    LMF0 B 1 Bright A_Weave(3, 3, 2.0, 1.0)
    LMF0 A 0 A_CustomMissile("LegNecromancerShotFX",0,0,0,0)
    LMF0 B 0 Bright A_SeekerMissile(1,3)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LMF0 CDEFGH 3 Bright
    Stop
  }
}

