Actor LegendaryNecromancer 17502
{ 
  //$Category Monsters/CF
  //$Sprite LMGEA1
  //$Title "Legendary Necromancer"
  Health 1400 
  PainChance 40
  Speed 24
  Scale 1.15
  Radius 20 
  Height 56 
  Mass 200 
  BloodColor "Blue"
  Monster
  +FLOAT
  +NOGRAVITY
  +NOTARGET
  +BOSS
  +AVOIDMELEE
  +NOTIMEFREEZE
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOICEDEATH
  +DONTGIB
  +NOTELEFRAG
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +NORADIUSDMG
  Species "Cacodemon"
  //Species "LegMage"
  Obituary "$CFLegendaryNecromancerObit"
  DamageFactor 0.6
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.10
  DamageFactor "PDTBFGTracer", 0.10
  DamageFactor "PlayerDevBall", 0.110
  DamageFactor "PlayerDevBall2", 0.110
  DamageFactor "PlayerDevTracer", 0.110
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "BossLifeEssence" 256
  DropItem "BossArmorBonusMax" 256
  DropItem "LegendaryPowerSphere" 65
  DropItem "LegendaryTimeFreezeSphere" 80
  DropItem "LegendarySphere" 150
  DropItem "OccultSpellbookGiver" 256
  DropItem "LDemonAmmoBoxPickup" 256
  DropItem "LDemonAmmoPickup" 256
  DropItem "BigCFManaPickup" 256 100
  DropItem "BigCFManaPickup" 128 100
  //DropItem "LegendaryPlasmaticCannonGiver" 100
  Tag "$CFLegNecro"
  SeeSound "LegMage/Sight" 
  PainSound "LegMage/Pain" 
  DeathSound "LegMage/Death" 
  ActiveSound "LegMage/Active" 
  var int user_music;
  var int user_lowlag;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States 
  { 
  Spawn: 
	LMGE A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle2:
	LMGE A 10 Bright A_Look 
	Loop 
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Cacodemon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  See: 
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LMGE AB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1) 
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,303)
	TNT1 A 0 A_SetUserVar("user_music",1)
	LMGE AAABBB 3 Bright A_Chase
	LMGE A 0 A_Jump(30,"Teleport")
	LMGE A 0 A_Jump(96,"Rush")
	LMGE A 0 A_Jump(60,"Dodge")
	Loop
  Teleport:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	LMGE A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LMGE AAAAAAAAAA 1  A_FadeOut(0.1,0)
	LMGE A 2 
	LMGE AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	LMGE A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LMGE AAAAAAAAAA 1 A_FadeIn(0.1)
	LMGE A 1 Bright A_SetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See	
  Dodge:
	LMGE A 0
	LMGE A 0 ThrustThing(angle*256/360+random(0,360),30,0,0)
	LMGE A 5 Bright 
	Goto See
  Rush:
	LMGE A 0 A_Chase
	LMGE A 1 Bright A_Playsound("monster/blur")
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE A 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE A 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 1 Bright A_Chase
	LMGE B 0 A_SpawnItem("LegNecromancerFX",0,0)
	LMGE B 0 A_Jump(96,1)
	Goto MoreSee
	LMGE B 0
	Goto See
  Melee:
  Missile:
	TNT1 A 0 A_Jump(120,"Laser","SpreadShots")
	TNT1 A 0 A_Jump(70,"VoidLightning","MeteorStorm","BigLightningBall","LightningBolts")
	//TNT1 A 0 A_Jump(30,"SuperStorm")
  Normal:
    LMGE D 8 Bright
    LMGE E 5 Bright A_FaceTarget
    LMGE D 0 A_PlaySound("dbish/atk3")
    LMGE D 0 A_CustomMissile("LegNecroHellStaffBall",36,0,-20,0)
    LMGE D 0 A_CustomMissile("LegNecroHellStaffBall",36,0,20,0)
    LMGE F 8 Bright A_CustomMissile("LegNecroHellStaffBall",36,0,0,0)
	TNT1 A 0 A_Jump(40,"SpreadShots","Laser","NecroShots")
	Goto See
  NecroShots:
	LMGE D 8 Bright A_FaceTarget
	LMGE E 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NecroShotsLoop:
	TNT1 A 0 A_CustomMissile("LegNecromancerShot2",65,35,0,0)
	LMGE F 8 Bright A_CustomMissile("LegNecromancerShot",65,-35,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 11,1)
	Loop
	TNT1 A 0 A_Jump(40,"SpreadShots","Laser","Normal")
	Goto See
  SpreadShots:
	LMGE D 8 Bright A_FaceTarget
	LMGE E 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SpreadShotsLoop:
	LMGE F 0 A_CustomMissile("LegSoulBall",41,0,frandom(-24,24))
	LMGE F 5 Bright A_CustomMissile("LegSoulBall",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,1)
	Loop
	TNT1 A 0 A_Jump(40,"Laser","NecroShots","Normal")
	TNT1 A 0 A_Jump(30,"LightningBolts")
	Goto See
  Laser:
	LMGE D 8 Bright A_FaceTarget
	LMGE E 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LaserLoop:
	LMGE F 3 Bright A_CustomMissile("LegRedLaser",41,0,0,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 12,1)
	Loop
	TNT1 A 0 A_Jump(40,"SpreadShots","NecroShots","Normal")
	TNT1 A 0 A_Jump(30,"BigLightningBall")
	Goto See
  VoidLightning:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	LMGE DE 5
	LMGE F 10 A_PlaySound("exile/voidstart")
	LMGE F 8 A_VileTarget("LegNecromancerVileFire")
	LMGE FFFFFFFFFFFFFF 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
	LMGE D 8
	LMGE E 20
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  MeteorStorm:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LMGE D 2 Bright A_FaceTarget
	LMGE DEEFF 4 Bright A_FaceTarget
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,180)
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,90)
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,-90)
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,45)	
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,-45)
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,135)	
	LMGE F 0 A_CustomMissile("BlueRainCometNull",32,0,-135)
	LMGE F 8 Bright A_CustomMissile("BlueRainCometNull",32,0,0)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LMGE FFFFFFFFF 4 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  LightningBolts:
	LMGE DE 12 Bright A_FaceTarget
	LMGE FF 0 A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	LMGE F 10 Bright A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	LMGE FF 0 A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	LMGE F 10 Bright A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	LMGE FF 0 A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	LMGE F 10 Bright A_CustomMissile("LegendaryNecroBolt",41,0,frandom(-24,24))
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(64,"Laser","Normal")
    Goto See
  BigLightningBall:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("LegMage/Attack2")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BigLightningBallLoop:
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegendarySuperLightningFX",41,43,0,0)
    LMGE D 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BigLightningBallLoop2:
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("LegendarySuperLightningFX",41,43,0,0)
    LMGE E 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_SpawnItemEx("BHellionSmokeSpawner",0,0,0,0)
    LMGE F 8 Bright A_CustomMissile("LegendarySuperLightningProj",41,0,0,0,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    Goto See
  SuperStorm:
    LMGE E 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LMGE E 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Legmage/Attack")
	TNT1 A 0 Radius_Quake(8,60,0,20,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
    LMGE D 2 Bright A_FaceTarget
    LMGE DEFFFFFF 4 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SuperStormLoop:
	TNT1 A 0 A_VileTarget("LegRedStormBoltAttack")
	TNT1 AA 0 A_SpawnItemEx("LegRedStormBoltSpawner",frandom(-512,512),frandom(-512,512),0,0,0,0,SXF_NOCHECKPOSITION,64)
    LMGE F 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	LMGE FFFFFFFFF 6 Bright A_FaceTarget
	LMGE F 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LMGE F 0 A_Jump(127,"Dodge","Teleport")
	Goto See
  Pain: 
	TNT1 A 0 A_Jump(35,"Teleport")
	LMGE C 2 Bright 
	LMGE C 2 Bright A_Pain 
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See 
  Death: 
	LMGE C 2 Bright
	LMGE C 2 Bright A_Scream 
	LMGE CCCCCCCCCCCCCCCCCCCCCC 6 A_SpawnItemEx("BlueKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_SpawnItem("BlueLightning")
	TNT1 A 0 A_Explode(100,200,1)
	TNT1 A 0 Radius_Quake(5,15,0,20,0)
	TNT1 A 0 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LMGE G 8 Bright A_PlaySound("LegMage/Death2",7,1.0,0,ATTN_NONE) 
	LMGE HI 5 Bright
	LMGE J 5 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,21)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	LMGE KLM 5 Bright
	LMGE NO 5
	LMGE P -1 
	Stop 
  } 
}

Actor LegendaryNecroBolt : CacodemonBall
{
  Damage (Random(15,30)) //5
  Speed 10
  Radius 8
  Height 8
  Species "Cacodemon"
  DamageType "Legendary"
  SeeSound "Null"
  DeathSound "LegArchon/BallHit"
  YScale 4.0
  XScale 2.0
  ReactionTime 35
  +FLOORHUGGER
  +HEXENBOUNCE
  +RIPPER
  -NOGRAVITY
  -STRIFEDAMAGE
  +NOTIMEFREEZE
  +FORCERADIUSDMG
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(64,"Homing")
    LFX2 F 1 Bright A_Explode(16,100,0)
    LFX2 F 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 ThrustThing(frandom(0,255),1,0,0)
    LFX2 G 1 Bright A_Explode(16,100,0)
    LFX2 G 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 H 1 Bright A_Explode(16,100,0)
    LFX2 H 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 I 1 Bright A_Explode(16,100,0)
    LFX2 I 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 J 1 Bright A_Explode(16,100,0)
    LFX2 J 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 J 0 A_CountDown
    Goto Spawn+2
  Homing:
    LFX2 F 1 Bright A_Explode(16,100,0)
    LFX2 F 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 A_SeekerMissile(2,2)
    LFX2 G 1 Bright A_Explode(16,100,0)
    LFX2 G 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 A_SeekerMissile(2,2)
    LFX2 H 1 Bright A_Explode(16,100,0)
    LFX2 H 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 A_SeekerMissile(2,2)
    LFX2 I 1 Bright A_Explode(16,100,0)
    LFX2 I 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 A_SeekerMissile(2,2)
    LFX2 J 1 Bright A_Explode(16,100,0)
    LFX2 J 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,90)
    LFX2 F 0 A_SeekerMissile(2,2)
    LFX2 J 0 A_CountDown
    Loop
  Death:
	TNT1 A 0 A_FadeOut(0.2)
    LFX2 F 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX2 G 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX2 H 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX2 I 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX2 J 2 Bright A_Explode(32,128,0)
    Stop
  }
}

Actor LegendaryNecroBolt2 : CacodemonBall
{
  Damage 0
  Speed 184
  Species "Cacodemon"
  DamageType "Legendary"
  RenderStyle None
  +RIPPER
  +NOTIMEFREEZE
