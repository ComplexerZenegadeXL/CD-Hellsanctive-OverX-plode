}

Actor LegendarySuperLightningFX : ImpballTrail
{
  Scale 1
  Renderstyle Add
  Alpha 1
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTIMEFREEZE
  States
  {
  Spawn:
    BLPJ ABCDE 1 Bright
    Stop
  }
}

Actor LegendarySuperLightningProj : BFlanLightningProj
{
  +NOTIMEFREEZE
  Species "Cacodemon"
  DamageType "Legendary"
  MissileType "LegendarySuperLightningTrailSpawner"
  States
  {
  Spawn:
    BLPJ ABCDE 1 Bright
    Loop
  Death:
    TNT1 AAAAAA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, frandom(15,35), 0, 0, 0, 0, SXF_CLIENTSIDE)  
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX", frandom(15,35), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAA 0 A_CustomMissile("BlueKaboom3",frandom(15,35),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItem("BlueDTBFGEx",0,-10)
	TNT1 A 0 Radius_Quake(20,8,0,12,0)
    LTB1 AB 4 Bright A_Explode(260,200)
	LTB1 CDEF 5 Bright
    Stop
  }
}

Actor LegendarySuperLightningTrailSpawner : BFlanLightningTrailSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 AA 0 A_SpawnItemEx("LegendarySuperLightningTrail", frandom(-20, 20), frandom(-20, 20), frandom(-20, 20), 0, 0, 0, 0, SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor LegendarySuperLightningTrail : BFlanLightningTrail
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    TNT1 A 0 A_Jump(255, "Puff1", "Puff2", "Puff3")
  Puff1:
    BLPJ F 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    BLPJ G 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    BLPJ H 1 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor LegNecroHellStaffBall : CacoHellStaffBall2
{
  Speed 35
  Damage (Random(30,60)) //10
  +NOTIMEFREEZE
  States
  {
  Spawn:
    HPRO JJKKLL 1 Bright A_SpawnItem("LegendaryHellStaffTrail")
	TNT1 A 0 A_SeekerMissile(20, 45)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(40,48)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("LegendaryHellStaffParticle",0,0,0,frandom(-4,4),frandom(-4,4),frandom(-4,4),random(0,360))
    CLBA Z 1 Bright A_FadeOut(0.2)
    Goto Death+2
  }
}

