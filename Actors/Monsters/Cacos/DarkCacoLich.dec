Actor DarkCacoLich : CFCacodemon
{
  Health 850
  Height 56
  Radius 30
  Mass 1200
  Speed 5
  FloatSpeed 5
  BloodColor "Green"
  MeleeDamage 8
  PainChance "Mine", 128
  PainChance "SatanGuard", 0
  PainChance 25
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  DamageType "CacoLich"
  DamageFactor "Acid", 0.25
  //No Infighting
  DamageFactor "CacoLich", 0.0
  DamageFactor "PhazoDemon", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "Glaucoma", 0.0
  DamageFactor "HelementalComet", 0.0
  DamageFactor "BloodSkull", 0.0
  DamageFactor "BloodElemental", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "EleSouls", 0.0
  DropItem "BossLifeEssence", 180, 10
  DropItem "CFArmorBonusMax5", 180
  DropItem "CFArmorBonusMax5", 180
  SeeSound "Lich/sight"
  ActiveSound "Lich/active"
  MeleeSound "caco/melee"
  PainSound "Lich/pain"
  DeathSound "Lich/death"
  Obituary "$CFDarkCacoLichObit"
  HitObituary "$CFDarkCacoLichHitObit"
  Tag "$CFDCacolich"
  States
  {
  Spawn:
	CLIC A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	Idle:
	CLIC A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CLIC AAAAAAAAA 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetSolid
	CLIC AAAAAAAAA 1 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",30,JLOSF_DEADNOJUMP,500)
	CLIC A 0 A_Jump(68,"Dodge")
	Loop
  Dodge:
	CLIC A 0 A_Jump(256,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	CLIC A 0 ThrustThing(angle*256/360+64,30,0,0)
	CLIC A 5
	Goto See
  Left:
	CLIC A 0 ThrustThing(angle*256/360+192,30,0,0)
	CLIC A 5
	GoTo See
  Back:
	CLIC A 0 ThrustThing(angle*256/360+128,30,0,0)
	CLIC A 5
	Goto See
  BackLeftRange:
	CLIC A 0 ThrustThing(angle*256/360+frandom(133,187),30,0,0)
	CLIC A 5
	Goto See
  BackRightRange:
	CLIC A 0 ThrustThing(angle*256/360+frandom(69,123),30,0,0)
	CLIC A 5
	Goto See
  Melee:
	CLIC EF 4 Bright A_FaceTarget 
	TNT1 A 0 A_PlaySound("monster/psoattack")
	CLIC G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC G 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	TNT1 A 0 A_FaceTarget
	CLIC F 3 Bright A_CustomMissile("LichBreath", 10, 0, frandom(-18,18))
	CLIC FG 3
	Goto See
  Missile:
	TNT1 A 0 A_SetSolid
	TNT1 A 0 A_Stop
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_JumpIfCloser(300,"Melee")
	TNT1 A 0 A_Jump(128,"Comet","Tracers","Seekers")
	TNT1 A 0 A_Jump(128,"Rush")
  Normal:
	CLIC EF 4 A_FaceTarget
	CLIC G 2 A_FaceTarget
	CLIC G 0 A_CustomMissile("WatcherBall", 24, 0, 0)
	CLIC G 0 A_CustomMissile("WatcherBall", 24, 0, 4)
	CLIC G 0 A_CustomMissile("WatcherBall", 24, 0, -4)
	CLIC G 0 A_CustomMissile("WatcherBall", 24, 0, 8)
	CLIC G 6 Bright A_CustomMissile("WatcherBall", 24, 0, -8)
	CLIC FE 4 A_FaceTarget
	Goto See
  Comet:
	CLIC EFG 4 A_FaceTarget
	CLIC G 1 Bright A_CustomMissile("CacoLichComet",24,0,0)
	CLIC FE 4
	Goto See
  Tracers:
	CLIC EF 4 A_FaceTarget
	CLIC G 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CacoLichTracer",24,0,0)
	CLIC G 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CacoLichTracer",24,0,0)
	CLIC G 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CacoLichTracer",24,0,0)
	CLIC FE 4 A_FaceTarget
	Goto See
  Seekers:
	CLIC B 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CacoLichBall",35,0,0,0,0)
	TNT1 A 0 A_CustomMissile("CacoLichBall",35,0,16,0,0)
	CLIC C 4 Bright A_CustomMissile("CacoLichBall",35,0,-16,0,0)
	CLIC CD 4	
	TNT1 A 0 A_Jump(87,"Comet")
	Goto See
  Rush:
	CLIC A 1 A_Chase("","")
	TNT1 AA 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("CacoLichTrail")
	TNT1 A 0 A_SpawnItemEx("GreenRushPulse")
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",30,JLOSF_DEADNOJUMP,500)
	CLIC A 1 A_Chase("","")
	TNT1 AA 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("CacoLichTrail")
	TNT1 A 0 A_SpawnItemEx("GreenRushPulse")
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",30,JLOSF_DEADNOJUMP,500)
	CLIC A 1 A_Chase("","")
	TNT1 AA 0 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("CacoLichTrail")
	TNT1 A 0 A_SpawnItemEx("GreenRushPulse")
	TNT1 A 0 A_JumpIfInTargetLOS("Dodge",30,JLOSF_DEADNOJUMP,500)
	TNT1 A 0 A_Jump(5,"See")
	Loop
  Pain.Cacobribe:
	TNT1 A 0 HealThing(1)
	TNT1 A 0
	Goto Missile
  Pain.CacoBribe2:
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 HealThing(8)
	Goto Dodge
  Pain:
	TNT1 A 0 A_Jump(24,"Missile")
	CLIC H 5 A_Pain
	TNT1 A 0 A_Jump(128,"Dodge")
	Goto See
  Melee:
	TNT1 A 0 A_SetSolid
	CLIC EFG 4 A_FaceTarget
	TNT1 A 0 A_MeleeAttack
	CLIC FE 4 A_FaceTarget
	Goto See
  XDeath:
  Death:
	CLIC J 8 A_Scream
	TNT1 AAAAAAAA 0 A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	TNT1 A 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	CLIC K 8 A_Fall
	CLIC LM 4
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
  Fall:
	CLIC N 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	CLIC OPQR 3
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	CLIC S -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,0)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	CLIC SRQPONMLKJI 4
	Goto See         
  }
}

Actor RedDarkCacoLich : DarkCacoLich
{
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  Species "UltimateLegendary"
  Dropitem ""
  +NOTELEFRAG
  +THRUSPECIES
  +DONTHARMSPECIES
  -COUNTKILL
}

Actor CacoLichLaser : FastProjectile
{
  Height 6
  Radius 3
  Renderstyle Add
  Speed 100
  Scale 0.75
  Damage (Random(5,12))
  +NODAMAGETHRUST
  +NOEXPLODEFLOOR
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +RANDOMIZE
  +CANNOTPUSH
  +SPAWNSOUNDSOURCE
  MissileType "CacoLichLaserTrail"
  MissileHeight 8
  SeeSound "baron/attack"
  Species "Cacodemon"
  DamageType "CacoLich"
  DeathSound "baron/shotx"
  States
  {
  Spawn:
	CLBL ABCB 1 Bright A_Weave(0,4,0,2)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	CLBL DDFFGGGGGGG 2 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor CacoLichPoison : BarbatosPoison
{
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Cacodemon"
  DamageType "CacoLich"
}

Actor CacoLichLaserTrail
{
  Scale 0.1
  Renderstyle Add
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("CacoLichLaserTrail2",0,0,8)
	Stop
	}
}

Actor CacoLichLaserTrail2
{
  Scale 0.75
  Alpha 0.85
  Renderstyle Add
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	CLBL AAA 3 Bright 
	CLBL DDFFGGGGGGG 1 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor MiniLichLaser : CacoLichLaser
{
  Scale 0.375
  Height 3
  Radius 3
  Species "Cacodemon"
  DamageType "CurseComet"
  MissileType "MiniLichLaserTrail"
  States
  {
  Spawn:
	CLBL ABCB 1 Bright A_Weave(0,4,0,2)
	Loop
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, 4)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	CLBL DDFFGGGGGGG 2 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor PestilenceLaser : MiniLichLaser { Damage (Random(20,35)) }

Actor MiniLichLaserTrail
{
  Height 0
