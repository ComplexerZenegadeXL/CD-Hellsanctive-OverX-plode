Actor MinesRev
{
  Radius 12
  Height 12
  Speed 24
  Damage (Random(10,40))
  RenderStyle SoulTrans
  Alpha 0.95
  Projectile
  DamageType "Void"
  -NOGRAVITY
  +BOUNCEONWALLS
  +THRUGHOST
  +DONTHURTSPECIES
  +THRUSPECIES
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  Gravity 0.9
  BounceType Doom
  BounceCount 999
  BounceFactor 0.85
  WallBounceFactor 1.3
  Seesound "monster/dknmsl"
  Bouncesound "fire/fire3"
  DeathSound "weapons/boom1"
  var int user_loop;
  States
  {
  Spawn:
    RIP1 ABC 4 Bright	  
	RIP1 C 0 A_Jump(12,"Death")
	RIP1 C 0 A_Jump(32,"Bounce")
	RIP1 C 0
    Loop
  Bounce:
    RIP1 A 2 Bright ThrustThing(angle*256/(random(1,360)), 12, 0, 0)
	Goto Spawn
  Death:
    RIP1 D 0 A_NoBlocking 
    RIP1 DEFGH 5 Bright A_Explode(random(5,15),88)
  DeathLoop:	  
    RIP1 H 0 A_CustomMissile("RevNail", 0, 0, 10 * user_loop)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0
    Stop
  }
}

