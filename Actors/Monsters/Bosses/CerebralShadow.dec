Actor CSShadeMissile : CacodemonBall
{
  Damage (Random(4,10))
  Damagetype "Void"
  Species "Shadows"
  Speed 15
  Alpha 1.0
  +THRUSPECIES
  +STRIFEDAMAGE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NOTIMEFREEZE
  +SEEKERMISSILE
  +FORCEXYBILLBOARD
  SeeSound "Shadow/attack"
  DeathSound "imp/shotx"
  States
  {
  Spawn:
    NBAL AA 1 Bright A_SpawnItemEx("CSShadePuff",0,0,0,0,0,0)
    NBAL A 0 A_Seekermissile(5,7)
	NBAL AA 1 Bright A_SpawnItemEx("CSShadePuff",0,0,0,0,0,0)
    NBAL A 0 A_Seekermissile(5,7)
	NBAL BB 1 Bright A_SpawnItemEx("CSShadePuff",0,0,0,0,0,0)
    NBAL A 0 A_Seekermissile(5,7)
    NBAL BB 1 Bright A_SpawnItemEx("CSShadePuff",0,0,0,0,0,0)
    NBAL B 0 A_Seekermissile(5,7)  
    Loop
  Death:
    TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom10", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    NBAL HIJKLM 3 Bright A_FadeOut
    stop
  }
}

