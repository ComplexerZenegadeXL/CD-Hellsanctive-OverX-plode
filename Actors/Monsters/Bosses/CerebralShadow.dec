Actor CerebralShadowBoss
{
  Health 4000
  Radius 20
  Height 56
  Mass 100
  RenderStyle "Translucent"
  Alpha 0.7
  Speed 32
  FloatSpeed 32
  PainChance 50
  //$Title "Cerebral Shadow"
  Monster
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +NOGRAVITY
  +FLOAT
  +DONTRIP
  +NOTIMEFREEZE
  +NORADIUSDMG
  +NOFEAR
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTMORPH
  +THRUSPECIES
  +ALWAYSFAST
  +BOSS
  +BOSSDEATH
  +NOICEDEATH
  +DONTGIB
  +NOBLOCKMONST
  +DONTDRAIN
  +NOTELEFRAG
  PainSound "CShadow/hurt"
  SeeSound "CShadow/searching"
  DeathSound "CShadow/death"
  ActiveSound "CShadow/active"
  Obituary "$CFCerebralShadowBossObit"
  Species "CFBoss"
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Void", 0.0
  DamageFactor "BruiserFire", 0.0
  DamageFactor "Sharp", 0.0
  DamageFactor 0.6
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Melee", 0.05
  DamageFactor "Crush", 0.1
  DamageFactor "Acid", 0.05
  DamageFactor "Fire", 0.0
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.01
  DamageFactor "DrainLife", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "Player", 0.0
  DamageFactor "Players", 0.02
  DamageFactor "PyroShot", 0.20
  DamageFactor "PlayerPyro", 0.20
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Explosion", 0.2
  DamageFactor "NuclearFire", 0.01
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "BFGSplash", 0.5
  DamageFactor "UpBFG9500Ball", 0.25
  DamageFactor "UpBFGSplash", 0.25
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "RailG", 1.1
  DamageFactor "PlayerDTRG", 1.1
  DamageFactor "DTRailgun", 1.1
  DamageFactor "PlayerDevBall", 0.1
  DamageFactor "PlayerDevBall2", 0.1
  DamageFactor "PlayerDevTracer", 0.15
  DamageFactor "PlayerDBFG2", 0.3
  DamageFactor "PlayerDBFG10K2", 0.3
  DamageFactor "PlayerDBFGSplash2", 0.3
  DamageFactor "PlayerBHole", 0.15
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.05
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.05
  DamageFactor "Players", 0.75
  DamageFactor "Marine", 0.75
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBeam", 0.5
  DamageFactor "NemesisBall", 0.1
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "EnragedLegendarySphere", 128
  DropItem "FullBackpack", 256
  DropItem "CapacityCombatpack", 128
  DropItem "ModdedBlursphere", 150
  DropItem "HasteSphere", 150
  DropItem "ShadowSlaveOrb", 128
  DropItem "ElusiveSphere", 128
  DropItem "LegendaryInvisibilitySphere" 32
  BloodColor "Black"
  Tag "$CFShBoss"	
  var int user_music;
  var int user_lowlag;
  States
  {
  Spawn:
	CSHD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
	TNT1 A 0 ACS_NamedExecuteAlways("BossAI",0,0)
  Idle:
	CSHD A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CSHD AAABBB 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,62)
	TNT1 A 0 A_SetUserVar("user_music",1)
	Goto Chase
  Chase:
	CSHD AAA 1 A_Chase
	CSHD A 0 A_SpawnItemEx("CSShadowGhostA", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD BBB 1 A_Chase
	CSHD B 0 A_SpawnItemEx("CSShadowGhostB", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD CCC 1 A_Chase
	CSHD C 0 A_SpawnItemEx("CSShadowGhostC", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD DDD 1 A_Chase
	CSHD D 0 A_SpawnItemEx("CSShadowGhostD", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD AAA 1 A_Chase
	CSHD A 0 A_SpawnItemEx("CSShadowGhostA", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD BBB 1 A_Chase
	CSHD B 0 A_SpawnItemEx("CSShadowGhostB", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD CCC 1 A_Chase
	CSHD C 0 A_SpawnItemEx("CSShadowGhostC", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD DDD 1 A_Chase
	CSHD D 0 A_SpawnItemEx("CSShadowGhostD", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	CSHD EEE 1 A_Chase
	CSHD E 0 A_SpawnItemEx("CSShadowGhostE", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	Loop
  Missile:
	CSHD AAAAA 5 A_FaceTarget
	CSHD F 1 A_FaceTarget
	CSHD G 1 Bright A_CustomMissile("ShadowBall", 37, 10, 0, 0, 0)
	CSHD F 1 A_FaceTarget
	CSHD AAAAA 4 A_FaceTarget
	CSHD E 0 A_Jump(128,"OneShot")
	Goto See
  OneShot:
    CSHD EF 12 A_FaceTarget
    CSHD G 6 A_CustomMissile("AgauresBall1", 37, 0, 0, 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall1", 37, 0, frandom(-15,15), 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall1", 37, 0, frandom(-25,25), 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall1", 37, 0, frandom(-15,15), 0, 0)
	CSHD G 0 A_Jump(128,"OneShot","SpamShots","Explosions","Mines","DartCleave")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	CSHD G 0 A_Jump(128,"ShadowCall")
	//CSHD G 0 A_Jump(128,"Ravens")
    Goto See
  SpamShots:
    CSHD AF 8 A_FaceTarget
    CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, -5, 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, 5, 0, 0)
    CSHD G 0 A_CheckSight("See")
    CSHD AF 5 A_FaceTarget
    CSHD G 4 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
	CSHD G 0 A_CheckSight("See")
    CSHD AF 4 A_FaceTarget
    CSHD G 3 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
	CSHD G 0 A_CheckSight("See")
    CSHD AF 2 A_FaceTarget
    CSHD G 1 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
	CSHD G 0 A_CheckSight("See")
	CSHD AF 6 A_FaceTarget
	CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, -10, 0, 0)
	CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
    CSHD G 0 A_CustomMissile("AgauresBall2",37,0,10,0,0)
	CSHD G 0 A_CheckSight("See")
	CSHD AF 5 A_FaceTarget
	CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, -15, 0, 0)
	CSHD G 0 A_CustomMissile("AgauresBall2", 37, 0, 0, 0, 0)
    CSHD G 6 A_CustomMissile("AgauresBall2", 37, 0, 15, 0, 0)
	CSHD G 0 A_Jump(128,"OneShot")
	Goto See
  ShadowCall:
	TNT1 A 0 HealThing(35) //hopefully no one finds this out kek
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowminionCount") > 16,"See")
	CSHD A 35
  	TNT1 A 0 A_SpawnItemEx("CSShadowMinion",20,20,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowminionCount") > 16,"See")
	TNT1 A 0 A_SpawnItemEx("CSShadowMinion",40,40,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowminionCount") > 16,"See")
	TNT1 A 0 A_SpawnItemEx("CSShadowMinion",-20,-20,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowminionCount") > 16,"See")
	TNT1 A 0 A_SpawnItemEx("CSShadowMinion",-40,-40,0,0,0,0,0,SXF_SETMASTER)
	Goto See
  Explosions:
	CSHD FG 6 Bright A_FaceTarget
	CSHD G 2 Bright A_CustomMissile("BruiserFireSpawner",16,0,-15,0)
	CSHD G 2 Bright A_CustomMissile("BruiserFireSpawner",16,0,0,0)
	CSHD G 2 Bright A_CustomMissile("BruiserFireSpawner",16,0,15,0)
	CSHD G 1 A_Jump(128,"ShadowCall")
	Goto See
  DartCleave:
    CSHD E 1 Bright A_UnSetReflectiveInvulnerable
    CSHD A 6 Bright A_FaceTarget
    CSHD F 6 Bright A_Playsound ("monster/kntswg")
    CSHD G 0 A_CustomMissile ("CSDKDart",32,0,frandom(-6,-2),0)
    CSHD G 0 A_CustomMissile ("CSDKDart",32,0,frandom(-12,-7),0)
	CSHD G 0 A_CustomMissile ("CSDKDart",32,0,0,0)    
    CSHD G 0 A_CustomMissile ("CSDKDart",32,0,frandom(7,12),0)
    CSHD G 0 A_CustomMissile ("CSDKDart",32,0,frandom(2,6),0) 
	CSHD G 5 Bright A_Jump(128,"ShadowCall")
    Goto See
  Mines:
    CSHD A 6 Bright A_FaceTarget
    CSHD A 1 Bright A_FaceTarget
    CSHD F 0 A_CustomMissile("MinesRev",44,-4,-12,0)      
    CSHD F 5 Bright A_CustomMissile("MinesRev",44,-4,12,0)
    CSHD F 0 A_Jump(128,"ShadowCall")     
    Goto See
   //Ravens:
	//CSHD A 8 Bright A_FaceTarget
	//CSHD F 4 Bright A_CustomMissile("RavenMissile",0,-2)
    //CSHD F 0 A_CustomMissile("RavenMissile", 0, -1)
    //CSHD F 0 A_CustomMissile("RavenMissile", 0, 0)
    //CSHD F 0 A_CustomMissile("RavenMissile", 0, 1)
	//CSHD F 0 A_CustomMissile("RavenMissile", 0, 2)
	//CSHD Z 0 A_Jump(128,"ShadowCall")
	//Goto See
  Teleport:
    CSHD A 1 Bright A_UnSetShootable
	CSHD AAAAAAAAAA 1  A_FadeOut(0.1,0)
	CSHD A 2 
	CSHD AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	CSHD A 0 HealThing (50)
    CSHD A 1 A_PlayWeaponSound("Shadow/teleport")
	TNT1 A 0 A_Recoil(0.1)
	CSHD AAAAAAAAAA 1 A_FadeIn(0.1)
    CSHD A 1 Bright A_SetShootable
	CSHD Z 0 A_Jump(128,"ShadowCall")
    Goto See		
  Pain:
	TNT1 A 0 A_Jump(50,"Teleport")
	CSHD H 4
	CSHD H 4 A_Pain
	Goto See+1
  Death:
	CSHD I 6 A_Scream
	CSHD J 5 A_KillChildren
	CSHD K 5
	CSHD L 5 A_Fall
	TNT1 A 0 A_DropItem("TerminatorItem",1,32 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	CSHD MN 6 A_SpawnItemEx("CSItemRandomizer")
	CSHD O 6 A_SpawnItemEx("CSItemRandomizer2")
	TNT1 A 0 ACS_NamedExecuteAlways("DropAnkh",0,50) //50
	//TNT1 A 0 A_CustomMissile ("MediumBloodSpot", 4, 0, random (0, 360), 2, random (0, 160))
	CSHD P -1
	Stop
  }
}

Actor CSItemRandomizer
{
  States
  {
  Spawn:
    TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisHealthBonusMax",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
    TNT1 AAAAAAAA 1 A_SpawnItemEx("NemesisHealthBonusMax",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
	TNT1 AAAAAAAA 0 A_SpawnItemEx("NemesisArmorBonus16",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
    TNT1 AAAAAAAA 1 A_SpawnItemEx("NemesisArmorBonus16",0,0,32,frandom(-5,5),frandom(-5,5),frandom(0,3),frandom(0,360))
	Stop
  }
}

