Actor CSShadowMinion
{
  Health 250
  Monster
  Radius 17
  Height 56
  DropItem "LifeEssence" 180 8
  DropItem "LifeEssence" 180 8
  DropItem "LifeEssence" 180 8
  DropItem "CFManaPickup" 48
  DropItem "ArmorBonusMax" 135
  DamageFactor 0.5
  DamageFactor "Shadow", 0
  DamageFactor "Void", 0
  DamageFactor "BruiserFire", 0
  DamageFactor "Sharp", 0
  Mass 100
  RenderStyle "Translucent"
  Alpha 0.7
  Speed 5
  PainChance 200
  +FLOORCLIP
  +THRUSPECIES
 +DONTHURTSPECIES
 +DONTHARMSPECIES
 +ALWAYSFAST
 +NOTIMEFREEZE
 +MISSILEMORE
 +NOFEAR
 +MISSILEEVENMORE
 -COUNTKILL
 -NOINFIGHTING
  PainSound "Shadow/pain"
  DeathSound "Shadow/death"
  ActiveSound "Shadow/active"
  Obituary "$CFCSShadowMinionObit"
  BloodColor "Black"
  Species "CFBoss"
  //Species "Shadows"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	SHDW E 5 A_Look
	Loop
  See:
	SHDW A 1 A_Chase
	SHDW A 0 A_CustomMissile("CSShadowGhostA2", 0, 0, 0)
	SHDW A 1 A_Chase
	SHDW A 0 A_CustomMissile("CSShadowGhostA2", 0, 0, 0)
	SHDW A 1 A_Chase
	SHDW A 0 A_CustomMissile("CSShadowGhostA2", 0, 0, 0)
	SHDW B 1 A_Chase
	SHDW B 0 A_CustomMissile("CSShadowGhostB2", 0, 0, 0)
	SHDW B 1 A_Chase
	SHDW B 0 A_CustomMissile("CSShadowGhostB2", 0, 0, 0)
	SHDW B 1 A_Chase
	SHDW B 0 A_CustomMissile("CSShadowGhostB2", 0, 0, 0)
	SHDW C 1 A_Chase
	SHDW C 0 A_CustomMissile("CSShadowGhostC2", 0, 0, 0)
	SHDW C 1 A_Chase
	SHDW C 0 A_CustomMissile("CSShadowGhostC2", 0, 0, 0)
	SHDW C 1 A_Chase
	SHDW C 0 A_CustomMissile("CSShadowGhostC2", 0, 0, 0)
	SHDW D 1 A_Chase
	SHDW D 0 A_CustomMissile("CSShadowGhostD2", 0, 0, 0)
	SHDW D 1 A_Chase
	SHDW D 0 A_CustomMissile("CSShadowGhostD2", 0, 0, 0)
	SHDW D 1 A_Chase
	SHDW D 0 A_CustomMissile("CSShadowGhostD2", 0, 0, 0)
	Loop
  Missile:
	SHDW E 30 A_FaceTarget
	SHDW F 5 
	SHDW G 5 Bright A_CustomMissile("ShadeMissile",0,0,0,CMF_AIMDIRECTION,CMF_TRACKOWNER)
	SHDW F 5
	SHDW E 20
	SHDW E 1 A_SpidRefire
	Goto Missile+1      
  Pain:
	SHDW H 4
	TNT1 A 0 HealThing (10)
	SHDW H 4 A_Pain
	Goto See
  Death:
	SHDW I 6 A_Scream
	SHDW J 5
	SHDW K 5 A_CustomMissile("CSShadowtorso", 0, 0, 0)
	SHDW L 5 A_Fall
	SHDW MNO 6 
	SHDW P -1
	Stop
  XDeath:
	SHDX A 8
	SHDX B 6 A_XScream
	SHDX C 6 
	SHDX D 6 A_Fall
 	SHDX EF 6
	SHDX G -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	SHDW MKLJI 8
	Goto See
  }
}

