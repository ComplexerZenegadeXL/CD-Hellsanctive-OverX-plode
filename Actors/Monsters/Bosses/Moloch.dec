Actor HellStormBombBase
{
  Health 1
  Height 8
  Radius 11
  Speed 25
  Decal "RocketScorch"
  Damage (Random(80,120)) //24
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +MISSILE
  +DROPOFF
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +ACTIVATEIMPACT
  +ACTIVATEPCROSS
  +DONTREFLECT
  +FORCERADIUSDMG
  +SKYEXPLODE
  -RIPPER
  -THRUACTORS
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHARMSPECIES
  DamageType "Moloch"
  DeathSound "weapons/rocklx"
  Tag "Hellstorm Bomb"
  var int user_counter;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("rpg/fly",6,1.0,1)
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
	Goto SpawnLoop
  MonsterFly:
	TNT1 A 0 A_PlaySound("rpg/fly",6,1.0,1)
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 2 Bright
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 2 Bright
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 2 Bright
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 2 Bright A_PlaySound("monster/homingrockbeep",7)
	Goto SpawnLoop
  SpawnLoop:
	TNT1 A 0 A_JumpIf(user_counter > 24,"Separate")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION) 
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 1 Bright
	MIS8 A 1 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,64,500,500,220,"Separate")
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 1 Bright
	MIS8 A 1 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,64,500,500,220,"Separate")
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 1 Bright
	MIS8 A 1 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,64,500,500,220,"Separate") 
	TNT1 A 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 AAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_BishopMissileWeave
	MIS8 A 1 Bright
	MIS8 A 1 Bright A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,64,500,500,220,"Separate")
	TNT1 A 0 A_PlaySound("monster/homingrockbeep",7)
	Loop
  Separate:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 AAA 0 A_StopSound(6)
	TNT1 AAAAAA 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("HellStormBomb1Base",0,0,frandom(-11,11),CMF_AIMDIRECTION|CMF_SAVEPITCH|CMF_OFFSETPITCH,frandom(-2.0,2.0))
	TNT1 A 1 A_Stop
	Stop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 AAA 0 A_StopSound(6)
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("CFKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 1 A_SpawnItemEx("PlayerFlamethrowerShot",0,0,0,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	MISL B 4 Bright A_Explode(128,128,1,1)
	MISL CD 4 Bright
	Stop
  }
}

Actor HellStormBomb1Base
{
  Height 8
  Radius 11
  Speed 25
  Scale 0.5
  Decal "RevenantScorch"
  Damage (Random(30,60)) //10
  +MISSILE
  +DROPOFF
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +ACTIVATEIMPACT
  +ACTIVATEPCROSS
  +SEEKERMISSILE
  +SCREENSEEKER
  +DONTREFLECT
  -RIPPER
  -THRUACTORS
  +THRUSPECIES
  +MTHRUSPECIES
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  DamageType "Moloch"
  DeathSound "HellStorm/Hit"
  var int user_counter;
  States
  {
  Spawn:
    //TNT1 A 0 Bright
    //TNT1 A 0 Bright A_SetSpeed(random(22,25))
    //SpawnLoop:
	TNT1 A 0 A_CustomMissile("EFGRockeParticleTrail",frandom(-4,0),frandom(-2,2))
	TNT1 A 0 A_JumpIf(user_counter > 175,"Fall")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	HSBM A 1 Bright A_SeekerMissile(25,35,SMF_LOOK|SMF_PRECISE,45,7)
	TNT1 A 0 A_JumpIf(sqrt((velx*velx)+(vely*vely)*(velz*velz)) < 6,"Fall")
	Loop
  MonsterFly:
	HSBM AAAAAAAAAA 1 Bright A_CustomMissile("EFGRockeParticleTrail",frandom(-4,0),frandom(-2,2))
	Goto Spawn
  Fall:
	TNT1 A 0 A_SetGravity(frandom(0.3,0.24))
	HSBM A 525 A_Gravity
	HSBM A 5 A_FadeOut(0.1,1)
	Wait
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_SetTranslucent(0.75,1)
	MISL B 8 Bright A_Explode(64,64,1,1)
	TNT1 A 0 A_SpawnItemEx("WelderFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	MISL C 6 Bright
	MISL D 4 Bright
	Stop
  }
}

