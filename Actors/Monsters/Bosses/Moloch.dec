Actor AltMolochBFG2704 : 2704Ball3
{
  Damage (Random(200,400))
  +DONTREFLECT
  +NOTIMEFREEZE
  Species "CFBoss"
  DamageType "Moloch"
  Obituary "$CFAltMolochBFG2704Obit"
  States
  {
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("BFG2704Ex",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("PlayerDTBFGEx",0,0,-10,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(176,176,0,0)
  DeathLoop:
	TNT1 A 6
	TNT1 A 0 A_SetUserVar("user_loop2",0)
  DeathLoop2:
	TNT1 A 0 A_CustomMissile("Molo2704Ball",0,0,(user_loop2 * 36) + user_loop,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_CustomMissile("Molo2704Ball2",0,0,(user_loop2 * 36) + user_loop+1,CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop2", user_loop2 + 1)
	TNT1 A 0 A_JumpIf(user_loop2 == 10,2)
	TNT1 A 0 A_Jump(256,"DeathLoop2")
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 2)
	TNT1 A 0 A_JumpIf(user_loop > 4,1)
	Goto DeathLoop
	TNT1 A 6
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	TNT1 A 0 A_CustomMissile("Molo2704Ball",0,0,(user_loop * 36) + random(-10,10),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-90,90))
	TNT1 A 0 A_CustomMissile("Molo2704Ball2",0,0,(user_loop * 36) + random(-10,10),CMF_AIMDIRECTION|CMF_TRACKOWNER,random(-90,90))
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop == 10,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	TNT1 AA 6
	Stop
  }
}

