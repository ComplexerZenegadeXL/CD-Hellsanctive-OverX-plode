Actor MolFallingDRocket : DraugrMissile
{
  DamageType "Moloch"
  Speed 1
  +NOCLIP
  -MISSILE
  +SPAWNCEILING
   States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(6,8),frandom(-2,2)) 
