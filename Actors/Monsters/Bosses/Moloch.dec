    TNT1 A 0 A_SpawnItemEx("FireSpawnerTail",-3,0,8)
	SKYZ A 2 Bright
	TNT1 A 0 A_Gravity
    TNT1 A 0 A_SetGravity(1.0)
    TNT1 A 0 A_ChangeFlag(Noclip,0)
    TNT1 A 0 A_ChangeFlag(Missile,1)
  Looped:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(6,8),frandom(-2,2)) 
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(6,8),frandom(-2,2)) 
    TNT1 A 0 A_SpawnItemEx("FireSpawnerTail",-3,0,8)
	SKYZ A 1 Bright
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), 2, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(130,300,0,0,280)
	TNT1 A 0 A_SpawnItemEx("MolochFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AAAAAAA 0 A_SpawnItemEx("MolochFlare",0,0,0,frandom(2,4),frandom(2,4),2,frandom(0,360),SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,128)
    TNT1 A 1 A_SpawnItem("RocketEx")
    Stop
  }
}

