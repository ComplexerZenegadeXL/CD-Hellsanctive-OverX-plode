Actor FreezedCyberDemon //My favorite grammar
{
  //$Category Monsters/CF
  //$Sprite KYBRA1
  //$Title "Freezed Cyberdemon"
  Monster
  Health 5666
  Height 110
  Radius 40
  Speed 18
  FastSpeed 22
  Mass 2500
  Scale 1.05
  BloodColor "DarkBlue"
  MinMissileChance 100//160
  PainChance 32
  PainChance "PDTBFG", 20
  PainChance "SoulToxic", 15
  PainChance "FatFlamer", 15
  PainChance "FiendFire", 15
  PainChance "Explosion", 80
  PainChance "Mine", 80
  PainChance "Crush", 256
  +BOSS
  +NOFEAR
  +BOSSDEATH
  +NOICEDEATH
  +NOTIMEFREEZE
  +DONTBLAST
  +NOTELEFRAG
  +NOINFIGHTING
  -FULLVOLACTIVE
  +NEVERRESPAWN
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NORADIUSDMG
  +NODAMAGETHRUST
  +DONTMORPH
  +NOTARGET
  //+TELESTOMP
  +DONTHARMSPECIES
  +DONTDRAIN
  Species "CFBoss"
  DamageType "Ice"
  DamageFactor "Acid", 0.01
  DamageFactor "Fire", 0.1
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.001
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "BFGSplash", 0.5
  DamageFactor "Poison", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Explosion", 0.3
  DamageFactor "Mine", 0.3
  DamageFactor "Extreme", 0.0
  DamageFactor "Player", 0.01
  DamageFactor "PDTPuff", 0.0
  DamageFactor "PyroShot", 0.001
  DamageFactor "PlayerPyro", 0.01
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "Players", 0.02
  DamageFactor "PlayerDevBall", 0.02
  DamageFactor "PlayerDevBall2", 0.02
  DamageFactor "PlayerDevTracer", 0.02
  DamageFactor "PlayerBHole", 0.025
  DamageFactor "DBFG2", 0.015
  DamageFactor "DBFG10K2", 0.015
  DamageFactor "DBFGSplash2", 0.015
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.015
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.015
  DamageFactor "PlayerLegendary", 0.015
  DamageFactor 0.35
  //No Infighting
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Nobles", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "DarkBruiserBFG10K", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Commander", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "UBDTR", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "HellComet", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "HFCyber", 0.0
  DropItem "BossLifeEssence", 256, 150
  DropItem "CFBossArmorBonusMax25", 256
  DropItem "CFArmorBonusMax5", 256
  DropItem "CFArmorBonusMax5", 256
  DropItem "CFArmorBonusMax5", 256
  DropItem "CFArmorBonusMax5", 256
  DropItem "DemonAmmoBoxPickup", 196, 200
  DropItem "DemonicChaliceGiver", 90, 1
  DropItem "SkullOfPowerGiver", 90, 1
  DropItem "ArmorSphere", 96
  SeeSound "FreezedCyberDemon/See"
  ActiveSound "cyber/active"
  PainSound "monsters/cyberlordpain"
  DeathSound "monsters/darkcyberdie"
  Obituary "$CFFreezedCyberDemonObit"
  Tag "$CFFreezeCyb"
  var int user_music;
  var int user_currenthp;
  var int user_taunt;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States
  {
  Spawn:
	KYBR A 0
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",50)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Spawnloop:
	KYBR AAZZ 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	Loop
  Idle:
	TNT1 A 0 A_UnHideThing
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
  IdleLoop:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR A 3 A_Hoof
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR A 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR BB 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR CC 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR D 3 A_Metal
	TNT1 A 0 A_Explode(50,120,0,0,100)
	KYBR D 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_Explode(50,120,0,0,100)
	Loop
  See:
	TNT1 A 0 A_UnHideThing
	TNT1 A 0 A_SetUserVar("user_effect_type",50)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,803)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_JumpIf(user_taunt == 0,"Seeloop")
	TNT1 A 0 A_PlaySound("FreezedCyberDemon/Active",CHAN_VOICE,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_taunt",0)
  SeeLoop:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Jump(87,"Rush")
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR A 3 A_Hoof
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR A 3 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR BB 3 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR CC 3 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR D 3 A_Metal
	TNT1 A 0 A_Explode(100,120,0,0,100)
	KYBR D 3 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	Loop
  Rush:
	TNT1 A 0 A_Hoof
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR A 2 A_SpawnItemEx("BlueCyberGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR A 2 A_SpawnItemEx("BlueCyberGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR B 2 A_SpawnItemEx("BlueCyberGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR B 2 A_SpawnItemEx("BlueCyberGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR C 2 A_SpawnItemEx("BlueCyberGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR C 2 A_SpawnItemEx("BlueCyberGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 A 0 A_Metal
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR D 2 A_SpawnItemEx("BlueCyberGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 AA 0 A_Chase("Missile","Missile",CHF_NOPLAYACTIVE)
    KYBR D 2 A_SpawnItemEx("BlueCyberGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(100,120,0,0,100)
	TNT1 A 0 A_Jump(87,"See")
	Loop
  Missile:
	TNT1 A 0 A_UnHideThing
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_Jump(256,"Missile2")
	Goto Missile3
  Missile2:
	TNT1 A 0 A_JumpIfTargetInLOS("Railgun",90.0,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	Goto Missile3
  Missile3:
	TNT1 A 0 A_Jump(192,1)
	TNT1 A 0 A_JumpIfTargetInLOS("Normal",90.0,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto Rush
  Normal:
	TNT1 A 0 A_Jump(128,"CryoRockets","BFG15K")
	KYBR EE 4 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	KYBR F 6 Bright A_CustomMissile("FreezedCyberRocket",56,-26,0,CMF_TRACKOWNER)
	KYBR E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	KYBR F 6 Bright A_CustomMissile("FreezedCyberRocket",56,-26,0,CMF_TRACKOWNER)
	KYBR E 8
	TNT1 A 0 A_JumpIfTargetInLOS("Railgun",90.0,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	TNT1 A 0 A_Jump(128,"Seekers","FloorStomp")
	Goto See
  Seekers:
	KYBR EE 4 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekersLoop:
    KYBR F 6 Bright A_CustomMissile("FreezedCyberHomer",56,-26,0,CMF_TRACKOWNER)
    KYBR E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
    KYBR F 6 Bright A_CustomMissile("FreezedCyberHomer",56,-26,0,CMF_TRACKOWNER)
	KYBR E 8
	TNT1 A 0 A_Jump(128,"FloorStomp","Railgun","BFG15K","CryoRockets")
	Goto See
  FloorStomp:
    TNT1 A 0 A_SetUserVar("user_effect_type",51)
	KYBR GG 5 A_FaceTarget(45)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItem("FreezedCyberInvilFlameSpawner",0,0,0,0)
	KYBS A 3 Bright A_PlaySound("monsters/clsee",CHAN_VOICE,1.0,0)
	KYBS AAAAA 3 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	KYBS A 7 A_FaceTarget
	KYBS A 5 A_FaceTarget
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	KYBS B 6 A_PlaySound("monsters/Darkcyberstomp",CHAN_AUTO,1.0,0)
	KYBS B 2 Bright A_VileTarget("IceSpikeSpawner")
	KYBS B 20
	TNT1 A 0 A_SetUserVar("user_taunt",1)
	TNT1 A 0 A_Jump(128,"Railgun","BFG15K","CryoRockets")
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge",CHAN_WEAPON,1.0,0)
    KYBR EEEEE 4 A_FaceTarget(45)
	KYBR EE 5 Bright A_FaceTarget
	KYBR F 10 Bright A_CustomRailgun(Random(60,80), 26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	KYBR EE 5 Bright A_FaceTarget
    KYBR F 10 Bright A_CustomRailgun(Random(60,80), -26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	KYBR E 15
	TNT1 A 0 A_Jump(128,"BFG15K","CryoRockets")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON,1.0,0)
	KYBR EEE 6 Bright A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15KLoop:
	KYBR E 4 Bright A_FaceTarget
	KYBR F 4 Bright A_CustomMissile("FreezedCyber15K",56,-26,frandom(-4,4),CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	KYBR E 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(87,"CryoRockets")
	Goto See
  CryoRockets:
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CryoRocketsLoop:
	KYBR EE 5 A_FaceTarget(45)
    KYBR F 6 Bright A_CustomMissile("FreezedCyberCryoRocket",56,-26,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
    KYBR E 8 A_FaceTarget
	Goto see
  Pain.Crush:
  Pain.Mine:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_JumpIfTargetInLOS("Rush",0,JLOSF_TARGETLOS)
	Goto Idle
  Pain:
	"####" "#" 0
	"####" "#" 0 A_ChangeFlag(NOPAIN,1)
	"####" "#" 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	"####" "#" 1 HealThing(((user_currenthp - Health)*0.75)+1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Jump(128,"PainMissile")
	KYBR G 10 A_Pain
	TNT1 A 0 A_JumpIfCloser(1500,"CryoSummoner")
	TNT1 A 0 A_Jump(128,"FloorStomp")
	Goto See
  PainMissile:
	KYBR G 1 A_Pain
	KYBR GGGGGGGGGG 1 Bright A_CustomMissile("PaladinTrail",0,0,frandom(0,360),CMF_AIMDIRECTION)
	TNT1 A 0 A_JumpIfTargetInLOS("Missile",90.0,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
    Goto Rush
  CryoSummoner:
	TNT1 A 0 A_Jump(128,"CryoDemons")
	TNT1 A 0 A_Jump(64,"Behemoths")
  CryoImps:
	KYBR E 1 A_GiveInventory("SetMonsterReflectInvul",1)
	TNT1 A 0 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	KYBR EEE 4 A_FaceTarget(45)
	KYBR G 1 Bright A_CustomMissile("CryoImpSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoImpSummoner",58,-26,-22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoImpSummoner",58,-26,22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoImpSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	Goto See
  CryoDemons:
	KYBR E 1 A_GiveInventory("SetMonsterReflectInvul",1)
	TNT1 A 0 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	KYBR EEE 4 A_FaceTarget(45)
	KYBR G 1 Bright A_CustomMissile("CryoDemonSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoDemonSummoner",58,-26,-22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoDemonSummoner",58,-26,22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("CryoDemonSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	Goto See
  Behemoths:
	KYBR E 1 A_GiveInventory("SetMonsterReflectInvul",1)
	TNT1 A 0 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	KYBR EEE 4 A_FaceTarget(45)
	KYBR G 1 Bright A_CustomMissile("FreezerBehemothSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 3 A_FaceTarget
	KYBR G 1 Bright A_CustomMissile("FreezerBehemothSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	KYBR G 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	Goto See
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_SpawnItemEx("FreezerRifleGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	Goto Death1
  AlwaysDrop:
	TNT1 A 0 A_SpawnItemEx("FreezerRifleGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	Goto Death1
  Death1:
	KYBR G 10 A_Scream
	KYBR H 10 A_Fall
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    KYBR IIIII 2 Bright A_CustomMissile("BlueKaboom",frandom(20,80),frandom(-20,20),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    KYBR JJJJJ 2 Bright A_CustomMissile("BlueKaboom",frandom(20,80),frandom(-20,20),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    KYBR KKKKK 2 Bright A_CustomMissile("BlueKaboom",frandom(20,80),frandom(-20,20),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_Jump(96,"Death2")
	Goto Death3
  Death2:
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CyberIceSpike",frandom(-256,256),frandom(-256,256),0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION,0)
  Death3:
    KYBR LLLLL 1 Bright A_CustomMissile("BlueKaboom",frandom(20,80),frandom(-20,20),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	KYBR MMMMM 1 Bright A_CustomMissile("BlueKaboom",frandom(20,80),frandom(-20,20),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3",frandom(20,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	KYBR N 5 A_RemoveChildren
	KYBR O 5 A_KillChildren
	TNT1 A 0 A_BossDeath
	KYBR P -1
	Stop
  }
}

