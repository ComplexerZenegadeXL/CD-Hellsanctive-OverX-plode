Actor BarricadeSummoner : OverseerShoot
{
  States
  {
  Spawn:
	TNT1 A 1
  Death:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("FleshSpike",12,0,0,0,0,0,0,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
	TNT1 A 0 A_SpawnItemEx("FleshSpike",12,0,0,0,0,0,45,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
	TNT1 A 0 A_SpawnItemEx("FleshSpike",12,0,0,0,0,0,90,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
	TNT1 A 0 A_SpawnItemEx("FleshSpike",12,0,0,0,0,0,135,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
	TNT1 A 0 A_SpawnItemEx("FleshSpike",12,0,0,0,0,0,180,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
