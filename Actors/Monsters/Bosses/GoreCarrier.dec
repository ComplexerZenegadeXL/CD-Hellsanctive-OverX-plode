Actor GoreCarrier : Glaucoma
{
  Painchance "Mine", 128
  Species "CFBoss"
  //Species "Ghoul"
  DamageFactor 0.5
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Acid", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1  
  DamageFactor "PlayerDevBall", 0.2
  DamageFactor "PlayerDBFG10K2",0.3
  DamageFactor "UpBFG9500Ball", 0.5
  DamageFactor "UpBFGSplash", 0.5
  DamageFactor "DBFG2", 0.25
  DamageFactor "DBFGSplash2", 0.25
  DamageFactor "PlayerDBFGSplash2", 0.3
  DamageFactor "PlayerPyro", 0.05
  DamageFactor "PlayerBHole", 0.1
  DamageFactor "LegendaryPlayer", 0.4
  DamageFactor "Player", 0.6
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerNemesisBFG", 0.05
  DamageFactor "Normal", 0.6
  DamageFactor "None", 0.4
  DamageFactor "Explosion", 0.5
  DamageFactor "Players", 0.75
  DamageFactor "Marine", 0.75
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBeam", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.5
  DamageFactor "HellComet", 0.4
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  PainChance "Goreling", 0
  DamageFactor "Goreling", 0
  Damagetype "Acid"
  Health 6000
  Speed 5.25
  FloatSpeed 5.25
  Radius 85
  Height 100
  Scale 2.25
  PainChance 18
  Tag "$CFGCarrier"
  Mass 1590
  BloodColor "Red"
  SeeSound "gcarr/sight"
  PainSound "gcarr/pain"
  ActiveSound "gcarr/sight"
  DeathSound "gcarr/death"
  Obituary "$CFGoreCarrierObit"
  DropItem "PartialKakuhou", 256
  Monster
  +BOSS
  +NOGRAVITY
  +FLOAT
  +MISSILEMORE
  +LOOKALLAROUND
  +NOBLOCKMONST
  +SEEINVISIBLE
  +NOFEAR
  +NOTIMEFREEZE
  +NOICEDEATH
  +DONTDRAIN
  +NOTELEFRAG
  var int user_gorecount;
  States
  {
  Spawn:
	 GLCA A 0
	 TNT1 A 0 A_GiveInventory("NoControl",1)
	 TNT1 A 0 A_GiveInventory("GHOULS",1)
	 TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
	 TNT1 A 0 ACS_NamedExecuteAlways("BossAI",0,-2)
  Idle:
	//TNT1 A 0 A_GiveInventory("Tic",1)
	//TNT1 A 0 A_JumpIfInventory("Tic",175,"Overseer")
    GLCA A 10 A_Look
	//TNT1 A 0 A_GiveInventory("Tic",1)
	//TNT1 A 0 A_JumpIfInventory("Tic",175,"Overseer")
	Loop
  See:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA A 1 A_Chase
	GLCA AAA 1 A_Chase("","")
	//TNT1 A 0 HealThing(4)
	TNT1 A 0 A_JumpIfInventory("Overseers",8,2)
    TNT1 A 0 A_Jump(35,"Overseer2")
	Loop
  Missile:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	TNT1 A 0 A_Jump(22,"SummonGlaucoma")
	TNT1 A 0 A_JumpIfInventory("Overseers",8,2)
    TNT1 A 0 A_Jump(100,"Overseer2")
	TNT1 A 0 A_Jump(100,"ConsumeRejections","SummonCorpses")
    GLCA BBCC 3 A_FaceTarget(60,27)
	GLCA D 3 Bright
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(4)
	GLCA DD 1 Bright A_CustomMissile("GlaucomaGas",42,0,angle+RANDOM(-3,3),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
    TNT1 A 0 A_ChangeFlag(NoPain,0)
	GLCA D 3 Bright
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(4)
	GLCA DDD 1 Bright A_CustomMissile("GlaucomaGas",42,0,angle+RANDOM(-3,3),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
    TNT1 A 0 A_ChangeFlag(NoPain,0)
	GLCA D 3 Bright
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(4)
	GLCA DDD 1 Bright A_CustomMissile("GlaucomaGas",42,0,angle+RANDOM(-3,3),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
    TNT1 A 0 A_ChangeFlag(NoPain,0)
	End:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA D 4 Bright
    GLCA CBA 3 A_FaceTarget(60,27)
    Goto See
  SummonCorpses:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA BBBBBBBCCCCCC 1 A_FaceTarget(60,27)
	GLCA D 3
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(60)
	TNT1 A 0 A_ChangeFlag(NoPain,0)
	TNT1 AAAA 0 A_CustomMissile("CorpseSummonerGC",55,0,frandom(-60,60))
    GLCA D 6
    GLCA CBA 3 A_FaceTarget(60,27)
    Goto See
  Nope:
	TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	TNT1 A 0 A_TakeInventory("Tic",9999)
	Goto Idle
   Overseer:
	TNT1 A 0 A_JumpIfInventory("Overseers",8,"Nope")
	GLCA BC 6
	GLCA D 4
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(20)
	//TNT1 A 0 A_SpawnItemEx("GoreOverseer",0,0,0,0,0,0,0,SXF_SETMASTER,0,0)
	TNT1 A 0 A_CustomMissile("GoreOverseer",0,0,0,2)
	TNT1 A 0 A_GiveInventory("Overseers",1)
	TNT1 A 0 A_TakeInventory("Tic",9999)
	TNT1 A 0 A_ChangeFlag(NoPain,0)
	GLCA D 6
	GLCA CBA 4
	Goto Idle
   Overseer2:
	TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA BC 6
	GLCA D 4
    TNT1 A 0 A_ChangeFlag(NoPain,1)
	//TNT1 A 0 DamageThing(20)
	//TNT1 A 0 A_SpawnItemEx("GoreOverseer",0,0,0,0,0,0,0,SXF_SETMASTER,0,0)
	TNT1 A 0 A_CustomMissile("GoreOverseer",0,0,0,2)
	TNT1 A 0 A_GiveInventory("Overseers",1)
	TNT1 A 0 A_ChangeFlag(NoPain,0)
	GLCA D 6
	GLCA CBA 4
	Goto See
  SummonGlaucoma:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA BBCC 3 A_FaceTarget(60,27)
	GLCA D 3 Bright
	TNT1 A 0 A_PainAttack("SummonedGlaucoma")
	Goto End
  ConsumeRejections:
	TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA BC 8
	GLCA D 6 //Bright A_SpawnItemEx("CarrierHealFX",0,0,44)
	TNT1 A 0 A_RadiusGive("ConsumeRejections",1000,RGF_MONSTERS)
	GLCA D 4 //Bright A_SpawnItemEx("CarrierHealFX",0,0,44)
	GLCA CBA 4
	Goto See
  Melee:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA BC 5 A_FaceTarget
    GLCA D 5 A_MeleeAttack
    GLCA CB 5 A_FaceTarget
    Goto See
  Pain:
    TNT1 A 0 ACS_NamedExecuteAlways("OverseersCount",0)
	GLCA E 3
    GLCA E 6 A_Pain
    Goto See
  Death.PlayerIce:
  Death:
  XDeath:
    TNT1 A 0 A_NoGravity
	TNT1 A 0 ThrustThingZ(0,3,0,0)
    GLCA EEEEE 4 A_CustomMissile("GhoulWingFX",54,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-60,60))
	GLCA EEE 2 A_CustomMissile("GhoulWingFX",54,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-60,60))
	TNT1 A 0 A_CustomMissile("GhoulWingFX",54,0,0,2,90)
	GLCA EEEEEE 2 A_CustomMissile("GhoulWingFX",54,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-60,60))
	GLCA EEEEEE 2 A_CustomMissile("GhoulWingFX",54,0,0,2,90)
	TNT1 A 0 A_KillMaster
  Goreloop:
	TNT1 A 0 A_SetUserVar("user_gorecount",user_gorecount + 1)
	GLCA E 2 A_CustomMissile("GhoulWingFX",54,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-60,60))
	GLCA E 1 A_CustomMissile("GhoulWingFX",54,0,0,2,-90)
	GLCA E 1 A_CustomMissile("GhoulWingFX",54,0,0,2,90)
	TNT1 A 0 A_JumpIf(user_gorecount >= 16, 1)
	Loop
	//TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("GhoulWingFX",54,0,random(0,360),CMF_AIMDIRECTION,random(-60,60))
	GLCA E 1 A_CustomMissile("GhoulWingFX",54,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-60,60))
	GLCA EEEE 2 A_CustomMissile("KaguneShard2",frandom(10,86),frandom(-14,14),frandom(0,360),CMF_AIMDIRECTION,frandom(90,15))
	GLCA EEEEE 2 A_CustomMissile("BloodGas",49,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-25,25))
	TNT1 A 0 A_Gravity
	TNT1 A 0 ThrustThingZ(0,random(-50,50),0,0)
	//TNT1 A 0 A_Recoil(random(-50,50))
	TNT1 A 0 A_Explode(128,600,0,0,350)
	GLCA G 2 A_NoBlocking
	TNT1 A 0 A_DropItem("TerminatorItem",1,16 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItem("CSItemRandomizer")
    TNT1 A 0 ACS_NamedExecuteAlways("DropAnkh",0,50)
    GLCX GAAB 1 A_SpawnItemEx("GibbedGenerator",frandom(-80,80),frandom(-80,80),frandom(-80,80),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",frandom(-80,80),frandom(-80,80),frandom(-80,80),0,0,0,0,SXF_CLIENTSIDE,0)
    GLCX B 1 A_PlaySound("Gore/Splat")
	GLCX BBBBCCCCDDDD 2 A_SpawnItemEx("GibbedGenerator",frandom(-80,80),frandom(-80,80),frandom(-80,80),0,0,0,0,SXF_CLIENTSIDE,0)
    GLCX D 1 A_PlaySound("Gore/Splat")
    GLCX DE 3
    GLCX F -1
    Stop	
  Raise:
  XRaise:
    TNT1 A 0
	Stop
  }
}

Actor Overseers : Inventory { Inventory.MaxAmount 8 }

Actor OverseerShoot
{
  Radius 1
  Height 1
  Speed 0
  Damage 0
  +DONTBLAST
  +THRUACTORS
  +NOCLIP
  Projectile
  RenderStyle Normal
  Alpha 1.0
  States
  {
  Spawn:
  TNT1 A 1
  Death:
  TNT1 A 1
   TNT1 A 0 A_SpawnItemEx("OverseerAttacker",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
   Stop
  }
}

Actor GorelingSummoner : OverseerShoot
{
  States
  {
  Spawn:
    TNT1 A 1
  Death:
    TNT1 A 1
    TNT1 A 0 A_SpawnItemEx("Goreling",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
    Stop
  }
}

Actor GorelingSummoner2 : OverseerShoot
{
  Speed 12
  -NOGRAVITY
  States
  {
  Spawn:
    GLIN A 1 A_Jump(40,"Death")
    TNT1 A 0 A_Recoil(random(-1,-4))
    GLIN A 1 A_Jump(40,"Death")
    TNT1 A 0 A_Recoil(random(-1,-4))
    GLIN A 1 A_Jump(40,"Death")
    TNT1 A 0 A_Recoil(random(-1,-4))
  Death:
    GLIN A 1
    GLIN A 0 A_SpawnItemEx(Goreling,0,0,0,velx,vely,velz,0,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
    Stop
  }
}

Actor CorpseSummonerGC : OverseerShoot
{
  Speed 40
  -NOCLIP
  +THRUACTORS
  -NOGRAVITY
  States
  {
  Spawn:
	RJET M 1
	Loop
  Death:
	RJET M 1
	GLIN A 0 A_SpawnItemEx(DeadRejected,0,0,0,velx,vely,velz,0,SXF_SETMASTER|SXF_ABSOLUTEVELOCITY,0)
	Stop
  }
}

Actor OverseerAttacker
{
  -NOCLIP
  +THRUACTORS
  -NOGRAVITY
  +LOOKALLAROUND
  +DONTDRAIN
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 AA 1 A_Look
	Stop
  See:
	TNT1 A 1
	TNT1 A 0 A_Jump(210,"Shot")
	 //TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"SuperSpawn")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GorelingCount") > 11,"NoSpawn")
	TNT1 A 0 A_CustomMissile("GorelingSummoner",0,0,0,CMF_TRACKOWNER)
	Stop
  Shot:
	TNT1 A 0
	TNT1 A 0 A_CustomMissile("GlaucomaGas",0,0,0,2|CMF_TRACKOWNER,frandom(-12,12))
	TNT1 A 0 A_CustomMissile("GlaucomaGas",0,0,0,CMF_TRACKOWNER)
	Stop
  NoSpawn:
	TNT1 A 0
	Stop
  }
}
Actor SummonedGlaucoma : Glaucoma
{
  -COUNTKILL
  +NOINFIGHTING
  +DONTDRAIN
  Tag "Summoned Glaucoma"
}
Actor Goreling
{
  Monster
  Obituary "$CFGorelingObit"
  Health 125
  Radius 28
  Height 24
  Scale 1.1
  Mass 100
  Speed 2.85
  PainChance 85
  SeeSound "blob/sight"
  PainSound "blob/pain"
  ActiveSound "blob/active"
  DamageType Goreling
  Species "CFBoss"
  //Species "Ghoul"
  DamageFactor 0.5
  DamageFactor "Acid", 1.35
  DamageFactor "Goreling", 0
  DamageFactor "Glaucoma", 0
  DamageFactor "GlaucomaGas", 0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "Cacolich", 0.0
  Tag "Goreling"
  +FLOORCLIP
  +THRUSPECIES
  +LOOKALLAROUND
  +NODROPOFF
  -COUNTKILL
  +DONTDRAIN
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_GiveInventory("GHOULS",1)
	GLIN A 8
	Goto Idle
  Idle:
	TNT1 A 0
	GLIN GG 1 A_Look
	GLIN G 1 A_Wander
	GLIN BB 1 A_Look
	GLIN B 1 A_Wander
	GLIN CC 1 A_Look
	GLIN C 1 A_Wander
	GLIN BB 1 A_Look
	GLIN B 1 A_Wander
	TNT1 A 0 A_PlaySound("Blob/Walk")
	TNT1 A 0 A_Chase("","",CHF_DONTMOVE|CHF_RESURRECT)
	Loop
  See:
	GLIN GG 1 A_Chase("","",CHF_RESURRECT)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	GLIN BB 1 A_Chase("","",CHF_RESURRECT)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	GLIN CC 1 A_Chase("","",CHF_RESURRECT)
	TNT1 A 0 A_Chase("","",CHF_FASTCHASE)
	GLIN BB 1 A_Chase("","",CHF_RESURRECT)
	TNT1 A 0 A_PlaySound("Blob/Walk")
	TNT1 A 0 A_Chase
	Loop
  Heal:
	TNT1 A 0 A_Changeflag(NoDamage,1)
	TNT1 A 0 A_Changeflag(NoPain,1)
	TNT1 A 0 A_RadiusGive("ConsumeCorpse",30,RGF_MONSTERS,1)
	TNT1 A 0 A_SpawnItemEx("GoreBuild",0,0,0,0,0,0,0)
	TNT1 A 15
	TNT1 A 0 A_Explode(2,41,0,0,41)
	TNT1 A 0 A_SpawnItemEx("GoreBuild2",0,0,0,0,0,0,0)
	TNT1 A 35
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,12,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_PlaySound("Gore/Splat")
	TNT1 A 0 A_Jump(128,"Ghoul") //128
	TNT1 A 0 A_Jump(71,"Spore","Barricade")  //71
	TNT1 A 0 A_Jump(61,"Gorhul","FleshImp")  //61
	TNT1 A 0 A_CustomMissile("RejectedSummoner",0,0,0,CMF_TRACKOWNER)
	Stop
  Ghoul:
	TNT1 A 0 A_CustomMissile("Ghoul2Summoner",0,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Die
	Stop
  Gorhul:
	TNT1 A 0 A_CustomMissile("GhorulSummoner",0,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Die
	Stop
  FleshImp:
	TNT1 A 0 A_CustomMissile("FleshimpSummoner",0,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Die
	Stop
  Spore:
	TNT1 A 0 A_CustomMissile("SporeSummoner",0,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Die
	Stop
  Barricade:
	TNT1 A 0 A_CustomMissile("BarricadeSummoner",0,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Die
	Stop
  Melee:
	TNT1 AAAAA 0 A_CustomMissile("GorelingGas",24,0,frandom(0,360),CMF_AIMDIRECTION,-80)
	TNT1 A 0 A_Die
	Goto Death
  XDeath:
  Death:
	"####" "#" 1 A_SpawnItemEx("GibbedGenerator",0,0,12,0,0,0,0,SXF_CLIENTSIDE,0)
    "####" "#" 1 A_PlaySound("Gore/Splat")
	"####" "#" 2 A_Scream
  DeathLoop:	
	"####" "#" 1 A_FadeOut(0.05)
	Loop
  }
}

Actor GorelingGas : GlaucomaGas
{
  States
  {
  Spawn:
	"####" "#" 0
	"####" "#" 0 A_PlaySound("GlaucoIdle",1,0.75,0)
	"####" "#" 0 A_Jump(256,"Flight")
  Flight:
	FGO2 AAABBBCCCDDDEEEFFF 1 Bright A_SpawnItem("GlaucomaGasTrace")
	Loop
  Death:
	FGO2 G 3 Bright
	//TNT1 A 0 A_SpawnItemEx("GlaucomaDFX",0,0,0)
	TNT1 A 0 A_Explode(10,180,0,0,70)
	TNT1 A 0 A_SetDamageType("GlaucomaGas")
	TNT1 A 0 A_RadiusGive("GorelingDebuff",128,RGF_PLAYERS,1)
	TNT1 A 0 A_Jump(230,2)
	TNT1 A 0 A_RadiusGive("GorelingDebuff2",400,RGF_PLAYERS,1)
	//TNT1 A 0 A_RadiusGive("GlaucomaBuff",165,RGF_MONSTERS,1)
	FGO2 HIJKL 3 Bright
	FGO2 L 1 Bright A_FadeOut
	Wait
  }
}
Actor GorelingDebuff : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
	"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") != 0,"Null")
	"####" "#" 0 A_JumpIfInventory("LeggingsofNormalcyEquipped",1,"Null")
	"####" "#" 0 A_GiveInventory("GlaucomaDamageDown")
	"####" "#" 0 A_JumpIfInventory("MeltCount",1,2)
	"####" "#" 0 ACS_NamedExecuteAlways("Melt")
	"####" "#" 0 A_GiveInventory("MeltCount",1)
	Stop
  }
}
Actor GorelingDebuff2 : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
	"####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("IsPlayerAlive") != 0,"Null")
	"####" "#" 0 A_JumpIfInventory("LeggingsofNormalcyEquipped",1,"Null")
	"####" "#" 0 A_GiveInventory("GlaucomaDamageDown2")
	"####" "#" 0 A_JumpIfInventory("MeltCount",1,2)
	"####" "#" 0 ACS_NamedExecuteAlways("Melt")
	"####" "#" 0 A_GiveInventory("MeltCount",1)
	Stop
  }
}
