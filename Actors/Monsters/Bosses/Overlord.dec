}

Actor FakeOverlord : CFOverlord
{
  Health 8666
  RenderStyle Translucent
  Alpha 0.8
  -BOSS
  -AMBUSH
  -BOSSDEATH
  -COUNTKILL
  DamageFactor 8.666
  DamageFactor "NemesisBeam", 0.75
  DamageFactor "NemesisBall", 0.3
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "SuperWeapon", 0.2
  DamageFactor "LegendaryGuruPlayer", 0.2
  DamageFactor "PlayerNemesisPlasma", 0.4
  DamageFactor "PlayerNemesisBFG", 0.3
  DropItem ""
  DropItem "BossLifeEssence", 196
  DropItem "BossLifeEssence", 196
  DropItem "BossLifeEssence", 196
  DropItem "BossArmorBonusMax", 196
  DropItem "BossArmorBonusMax", 196
  DropItem "BossArmorBonusMax", 196
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_GiveInventory("IsACFFake",1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
  SpawnLoop:
	OVER A 10 A_Look
	TNT1 A 0 A_JumpIfHealthLower(ACS_NamedExecuteWithResult("CF_SpawnHealth"),"Idle")
	Loop
  Idle:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 //A_GiveInventory("ResetMonsterInvul",1)
  IdleLoop:
	TNT1 A 0 HealThing(7)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OVER AAAABBBBCCC 2 A_Wander
	OVER C 2 A_Look
	OVER AAAABBBBCCC 2 A_Wander
	OVER C 2 A_Look
	OVER AAAABBBBCCC 2 A_Wander
	OVER C 2 A_Look
	OVER AAAABBBBCC 2 A_Wander
	OVER CC 2 A_Look
	OVER A 2 A_Look
	OVER B 3 A_Look
	OVER C 30 A_Look
	TNT1 A 0 A_Jump(250,2)
	TNT1 A 0 A_PlaySound("Corruptor/Active")
	TNT1 A 0 A_SetAngle(Angle-30)
	OVER A 60 A_Look
	TNT1 A 0 A_SetAngle(Angle+30)
	OVER C 5 A_Look
	TNT1 A 0 A_SetAngle(Angle+30)
	OVER C 60 A_Look
	TNT1 A 0 A_SetAngle(Angle-30)
	OVER C 10 A_Look
	Loop
  See:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 //A_GiveInventory("ResetMonsterInvul",1)
  SeeLoop:
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OVER AAAABBBBCCCC 1 A_Chase
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 50,"PainAvoid")
	OVER AAAABBBBCCCC 1 A_Chase
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 50,"PainAvoid")
	Loop
  WrongTarget:
	TNT1 A 0
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,4)
	Goto See
  Missile:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInTargetInventory("IsACFOverlord",1,"WrongTarget")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 //A_GiveInventory("ResetMonsterInvul",1)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIfTargetInLOS("FarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("LongRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,800)
	TNT1 A 0 A_JumpIfTargetInLOS("NearRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,500)
	TNT1 A 0 A_JumpIfTargetInLOS("CloseRange",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	TNT1 A 0 A_Jump(256,"SummonSoul","Normal")
	Goto Normal
  Normal:
	OVER DE 4 Bright A_FaceTarget
  NormalLoop:	
	OVER F 2 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HeresiarchBlueBall",67,0,frandom(-8,8),CMF_TRACKOWNER|CMF_OFFSETPITCH,frandom(-2.0,2.0))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto NormalLoop
	OVER ED 10
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Pain.Crush")
	TNT1 A 0 //A_GiveInventory("MonsterAvoid",1)
	GoTo See
  Pain:
	TNT1 A 0 A_SetTranslucent(0.8,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 //ACS_NamedExecuteAlways("CF_SetSpecies",0,4)
	OVER L 7 A_Pain
	Goto See
  PainAvoid:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	OVER J 7 A_Pain
	Goto Pain.Crush
  Pain.Crush:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 //A_GiveInventory("MonsterAvoid",1)
	Goto See
  Death:
	TNT1 A 0 A_TakeInventory("OverlordSpawnAmount1",1,0,AAPTR_MASTER)
	TNT1 A 0 A_SetTranslucent(0.8,0)
	OVER M 6 Bright A_Scream
	OVER N 3 Bright
	TNT1 A 0 A_PlaySound("comet/explosion",CHAN_BODY,1.0,0)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,67,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX3",67,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAAAA 0 A_CustomMissile("Kaboom27",67,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	OVER O 3 Bright A_Fall
	OVER PQRSTU 3 Bright
	OVER V 1 Bright A_FadeOut(0.1,1)
	Wait
  }
}

Actor ImpureSoulSpawner : ExileCaster
{
  Height 56
  Radius 16
  +THRUACTORS
  +SERVERSIDEONLY
  States
  {
  Spawn:
	TNT1 AAA 5
  Death:
	TNT1 A 1
	TNT1 A 1 A_SpawnItemEx("ShadowSmokeGen3",0,0,5,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 A 1 A_SpawnItemEx("SummonedImpureSoul",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	Stop
  }
}

Actor OverlordImpureElemental : ImpureElemental
{
  +NOFEAR
  +NOTARGET
  +NOINFIGHTING
  +DONTBLAST
  -COUNTKILL
  +DONTDRAIN
  DropItem "NewShellPickup", 96, 12
  DropItem "BulletMagPickup" 96, 12
  DropItem "BossLifeEssence", 96
  DropItem "CFBossArmorBonusMax25", 96
  DropItem "CFArmorBonusMax5", 96
  DropItem "CFArmorBonusMax5", 96
  DropItem "CFArmorBonusMax1", 96
  DropItem "CFArmorBonusMax1", 96
  var int user_lcounter;
  States
  {
  Spawn:
	IMCC A 10 Bright A_Look
	TNT1 A 0 A_JumpIfInventory("Tic",210,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Idle:
	IMCC A 10 Bright A_Look
	TNT1 A 0 HealThing(2)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_JumpIfInventory("Tic",210,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  See:
	IMCC AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 Bright A_Chase
	TNT1 A 0 HealThing(random(1,2))
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_JumpIfInventory("Tic",210,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  WrongTarget:
	TNT1 A 0
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,4)
	Goto See
  Missile:
	TNT1 A 0
	TNT1 A 0 A_JumpIfInTargetInventory("IsACFOverlord",1,"WrongTarget")
	Goto Super::Missile
  Souls:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	GoTo See
  Dual:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_DualPainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
	TNT1 A 0 A_Jump(89,"Rapid")
	GoTo See
  Rapid:
	IMCC EF 5 Bright
	IMCC G 3 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC G 5 Bright A_FaceTarget
	TNT1 A 0 A_PainAttack("SummonedImpureSoul")
	IMCC EF 3 Bright
	TNT1 A 0 A_Jump(128,"RapidFire","Comet")
    GoTo See
  Vanish:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("OverlordSpawnAmount2",1,0,AAPTR_MASTER)
	IMCC A 2 Bright A_FadeOut(0.1,1)
	Wait
  XDeath:
  Death:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("OverlordSpawnAmount2",1,0,AAPTR_MASTER)
	IMCC I 6 Bright A_Scream
	IMCC J 3 Bright A_Fall
	TNT1 A 0 A_PlaySound("comet/explosion",CHAN_BODY,1.0,0)
	TNT1 AAAA 0 A_SpawnItemEx("BlueParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(70,198)
	TNT1 AAAAAA 0 A_SpawnItemEx("Debris",0,0,32,frandom(-8,8),frandom(-8,8),frandom(8,12),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom27",32,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	IMCC KL 3 Bright
	IMCC MNOP 2 Bright
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	Goto Fall
  Fall:
	IMCC Q 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	IMCC RSTU 3
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	IMCC V 525
	Goto Fade
  Fade:
	IMCC V 5 A_FadeOut(0.1,1)
	Loop
  }
}

Actor OverlordSpawnAmount1 : Inventory { Inventory.MaxAmount 2 }
Actor OverlordSpawnAmount2 : Inventory { Inventory.MaxAmount 20 }
Actor OverlordSpawnAmount3 : Inventory { Inventory.MaxAmount 40 }

Actor SummonedLegendaryRedeemer : LegendaryRedeemer { DamageFactor 0.75 -COUNTKILL }

Actor SummonedLegendaryTormentor : LegendaryTormentor { DamageFactor 0.75 -COUNTKILL }

Actor OverlordDeathEnemySpawner : RandomSpawner
{
  DropItem "SummonedImpureElemental" 256 10
  DropItem "SummonedLegendaryRedeemer" 256 5
  DropItem "SummonedLegendaryTormentor" 256 2
}