Actor SuppressedBroly : Broly// 3333
{
  //$Category Monsters
  Health 5000
  Radius 20
  Height 54
  Mass 1500
  Speed 14
  DamageFactor 0.65
  //SeeSound "superbaron/scream"
  DeathSound ""
  //ActiveSound "superbaron/act"
  Scale 0.64
  +COUNTKILL
  Tag "$CFBrolySup"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_GiveInventory("CFArmorToken",2500)
	TNT1 A 0 A_GiveInventory("KiShield2",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,9)
  Idle:
  SpawnLoop:
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,2)
	TNT1 A 0 A_Jump(256,2)
    BRLX A 10 Bright A_Look 
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLX A 10 Bright A_Look 
    Loop
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,998)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,"See2")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_GiveInventory("KiShieldCharge3",1)  //5
	BRLX G 2
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	BRLX GGLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLM 2
	TNT1 A 0 A_GiveInventory("SawPlayer",1)
  See2:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_TakeInventory("OverflowCounter", 36)
	TNT1 A 0 A_TakeInventory("PowerUpCounter", 48)
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLX BBBBBB 1 Bright A_Chase
	//TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(84,"InstantMove")
	TNT1 A 0 A_JumpIfTargetInLOS("See2",0)
  ForgetTarget:
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See2
  CheckFriend:
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_JumpIfInventory("BerserkSwitch", 1, "FriendOff")
	TNT1 A 0 A_GiveInventory("BerserkSwitch", 1)
	//TNT1 A 0 A_ChangeFlag(FRIENDLY, True)
	Goto See
  FriendOff:
	TNT1 A 0 A_TakeInventory("BerserkSwitch", 1)
	TNT1 A 0 A_ChangeFlag(FRIENDLY, False)
	Goto See
  CheckFly:
	TNT1 A 0 A_JumpIfInventory("IsFlying", 1, "FlyOff")
	TNT1 A 0 A_GiveInventory("IsFlying", 1)
	TNT1 A 0 A_ChangeFlag(FLOAT, True)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY, True)
	Goto See
  FlyOff:
	TNT1 A 0 A_TakeInventory("IsFlying", 1)
	TNT1 A 0 A_ChangeFlag(FLOAT, False)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY, False)
	Goto See
  InstantMove:
	TNT1 A 0 A_PlaySound("BROLYFST",CHAN_AUTO)
	BRLX AABBCCAABBCCAABBCCAABBCC 0 Bright A_Chase
	TNT1 A 0 A_Recoil(0.1)
	Goto See
  Melee:
	BRLX E 0 A_Jump(32, "Melee2")
	BRLX E 0 A_Jump(16, "KiBlast", "KiBlast3")
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHM",CHAN_AUTO)
	BRLX KKK 1 Bright A_CustomComboAttack("KiBall",64,Random(25,35),"","BrolyAttack",1)
    Goto See
  Melee2:
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLX K 1 Bright A_CustomComboAttack("KiBall",64,Random(110,125),"","BrolyAttack",1)
    Goto See
  Missile:
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	//BRLX E 0 Bright A_Jump(256, "Charge")
	//BRLX E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLX E 0 A_Jump(64, "Charge")
	BRLX E 0 A_Jump(64, "KiBlast2","KiBlast3")
	//BRLX E 0 A_JumpIfInventory("KiOverflow",100,"Overflowing")
	//TNT1 A 0 A_Jump(36,"CheckFly")
	//BRLX E 0 A_Jump(256,2)
	BRLX E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLX E 0 A_Jump(256,2)
	BRLX E 0 A_CheckFloor(2)
	BRLX E 0 A_Jump(32, "Overflowing")
	BRLX E 0 A_Jump(32, "OmegaBlaster")
	//Charge
  KiBlast:
	TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLX E 0 A_Jump(72, 2)
	BRLX K 3 A_CustomMissile ("KiBall",64)//A_CustomMissile ("KiBall",64)
	Goto See
	BRLX K 3 A_CustomMissile ("KiBall2",64) //A_CustomMissile ("KiBall2",64)
    Goto See
  KiBlast3:
	TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLX K 3 A_CustomMissile ("KiBall3",64)
    Goto See
  KiBlast2:
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  KiBlast2Loop:
	TNT1 A 0 A_CustomMissile("KiBlast",64)
	TNT1 A 0 A_PlaySound("KIBLAST",CHAN_AUTO)
    BRLX J 3
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TNT1 A 0
	Goto See
  OmegaBlaster:
	TNT1 A 0 A_PlaySound("BROLAUGH",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCA",CHAN_AUTO)
	TNT1 A 0 A_GiveInventory("KiShieldCharge3",1)  //5
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLX GGGLMLMLMLML 2 Bright
	TNT1 A 0 A_CustomMissile("ChargeFX",48)
	BRLX MLMLMLMLMLMLMLMLMLM 2 Bright A_SpawnItemEx("BrolyLightningFX",frandom(-6,6),frandom(-6,6),frandom(40,56),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 AA 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLX K 3 Bright A_CustomMissile ("OmegaBlast2",48)
    TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  Overflowing:
	TNT1 A 0 A_PlaySound("BROLYOVFW",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCB",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	TNT1 A 0 A_GiveInventory("KiShieldCharge3",1)  //5
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	BRLX GGG 2 Bright //A_CustomMissile("OverFlowFX",32)
	BRLX LMLMLMLMLMLML 2 Bright A_CustomMissile("SphereAuraFX",48)
	TNT1 A 0 A_CustomMissile("OverFlowFX",48)
	BRLX MLMLMLMLMLMLMLMLMLML 2 Bright A_CustomMissile("SphereAuraFX",48)
	TNT1 A 0 A_CustomMissile("OverFlowFX",48)
	BRLX MLMLMLMLMLMLMLM 2 Bright A_CustomMissile("SphereAuraFX",48)
	Goto OverflowCont2
  OverflowCont2:
	TNT1 A 0 A_PlaySound("OVERFLOW",CHAN_AUTO,2.0)//,FALSE,ATTN_NONE)
	TNT1 AA 0 A_CustomMissile ("KiBlast", 16, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 32, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 48, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 64, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	BRLX L 1 Bright A_CustomMissile("SphereAuraFX",32)
	//TNT1 A 0 A_PlaySound("OVERFLOW",CHAN_AUTO,2.0)//,FALSE,ATTN_NONE)
	TNT1 AA 0 A_CustomMissile ("KiBlast", 16, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 32, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 48, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast", 64, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	BRLX M 1 Bright //A_CustomMissile("SphereAuraFX",32)
	TNT1 A 0 A_GiveInventory("OverflowCounter", 1)
	TNT1 A 0 A_JumpIfInventory("OverflowCounter", 36, "OverflowOff")
	Goto OverflowCont2
	//KiBlast2
  OverflowOff:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  Charge:
	BRLX HI 3 Bright A_FaceTarget
	//Goto See
	BRLX J 0 A_SetUserVar(user_accelerator,3)
	BRLX J 0 A_SetUserVar(user_chargecooldown,5)
	BRLX J 0 A_Recoil(-user_accelerator-2)
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 A 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	TNT1 B 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 C 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	TNT1 C 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	TNT1 B 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 A 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 I 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 C 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	BRLX I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLX A 0 A_FaceTarget
	BRLX I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 A 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLX I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 I 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLX I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 C 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLX I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 B 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLX IH 4 Bright 
	TNT1 A 0 A_Jump(72,"CheckFriend")
	//BRLX J 20 //chance to hit when it slows down
	Goto See
  CrashedSomewhere:
	//BRLX J 0 A_PlaySound("Doom4/Monsters/PinkyCrash",7,0.8,0,2.0)
	BRLX J 0 A_SpawnItemEx("ChargeDustCloud",20,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	//BRLX J 0 A_SetDamageType("PinkieRam")
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLX JJJ 0 A_MeleeAttack
	BRLX J 1 A_Explode(500,50,0,0,50)
	BRLX J 0 A_RadiusThrust(100, 10,RTF_NOTMISSILE)//|RTF_THRUSTZ)
	BRLX J 0 A_SetDamageType("Normal")
	BRLX K 4 Bright A_Quake(sqrt(user_accelerator),user_accelerator/2,0,256) // chance to hit the back
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  PoweringUp:
	TNT1 A 0 A_PlaySound("BROLROAR",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCD",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	BRLX GGG 1 
  PowerUpCont:
	TNT1 A 0 A_GiveInventory("Health",5)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	BRLX L 1 Bright A_SpawnItemEx("BrolyLightningFX2",frandom(-6,6),frandom(-6,6),frandom(32,64),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	BRLX M 1 Bright A_GiveInventory("KiShieldCharge4",1)
	TNT1 A 0 A_SpawnItemEx("BrolyLightningFX2",frandom(-6,6),frandom(-6,6),frandom(32,64),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("PowerUpCounter", 1)
	TNT1 A 0 A_JumpIfInventory("PowerUpCounter", 48, "SeeSoundCancel")
	Goto PowerUpCont
	SeeSoundCancel:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	Goto See
  Pain:
    BRLX Q 5 Bright A_Pain
	//BRLX E 0 Bright A_Jump(72, "Overflowing")
	BRLX E 0 A_CheckFloor(2)
	TNT1 A 0 A_Jump(16,"PoweringUp")
	BRLX E 0 A_Jump(32, "Overflowing")
    Goto See2
  XDeath:
  Death:
	BRLX Q 5 Bright //5
	TNT1 A 0 A_PlaySound("BROLYCC",CHAN_AUTO,ATTN_None)
	TNT1 A 0 A_PlaySound("BROLYCC",CHAN_AUTO)
	TNT1 A 1 A_Jump(128,"TFVoice1")
	TNT1 A 0 A_PlaySound("BROLYTF0",CHAN_AUTO,2.0,false,ATTN_None)
	TNT1 A 1 A_Jump(256,"TFAnim")
  TFVoice1:
	TNT1 A 0 A_PlaySound("BROLYTF1",CHAN_AUTO,2.0,false,ATTN_None)
  TFAnim:
	BROL CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD 1 Bright 
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO,2.0,false,ATTN_None)
	BRLX C 1 //A_Scream
	BRLX D 1 A_Fall
	BRLX C 1 A_CustomMissile ("BrolyDeathExplosion",32)
	TNT1 A 0 A_Explode(random(500,1000),512)
	OMBB B 1 Bright A_SpawnItemEx("Broly",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	OMBB CDEFHIJKLLLLLLLLLLL 1 Bright A_SetScale(ScaleX + 0.1)
	Stop
  }
}

Actor FriendlySuppressedBroly : SuppressedBroly
{
  +FRIENDLY
  +MTHRUSPECIES
  +THRUSPECIES
  +DONTHURTSPECIES 
  Species "Marines"
  Tag "Allied Broly (Suppressed)"
  States
  {
  Spawn:
	BRLX AB 0 A_ChangeFlag(FRIENDLY, True)
	BRLX A 10 Bright A_Look 
	Loop
  See2:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_TakeInventory("OverflowCounter", 36)
	TNT1 A 0 A_TakeInventory("PowerUpCounter", 48)
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLX BBBBBB 1 Bright A_Chase
	//TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(84,"InstantMove")
	TNT1 A 0 A_JumpIfTargetInLOS("See2",0)
  ForgetTarget:
	TNT1 A 0 A_ClearTarget
	Goto See2
  CheckFriend:
	TNT1 A 0 A_ChangeFlag(FRIENDLY, True)
	Goto See
  Melee:
	TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "See2")
	BRLX E 0 A_Jump(32, "Melee2")
	BRLX E 0 A_Jump(16, "KiBlast", "KiBlast3")
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHM",CHAN_AUTO)
	BRLX KKK 1 Bright A_CustomComboAttack("KiBall",64,25,"","Player",1)
    Goto See
  Melee2:
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLX HIJ 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLX K 1 Bright A_CustomComboAttack("KiBall",64,100,"","Player",1)
    Goto See
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "See2")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	//BRLX E 0 Bright A_Jump(256, "Charge")
	//BRLX E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLX E 0 A_Jump(64, "Charge")
	BRLX E 0 A_Jump(64, "KiBlast2", "KiBlast3")
	//BRLX E 0 A_JumpIfInventory("KiOverflow",100,"Overflowing")
	//TNT1 A 0 A_Jump(36,"CheckFly")
	//BRLX E 0 A_Jump(256,2)
	BRLX E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLX E 0 A_Jump(256,2)
	BRLX E 0 A_CheckFloor(2)
	BRLX E 0 A_Jump(32, "Overflowing")
	BRLX E 0 A_Jump(32, "OmegaBlaster")
	Goto KiBlast
  XDeath:
  Death:
	BRLX Q 5 Bright 
	TNT1 A 0 A_PlaySound("BROLYCC",CHAN_AUTO,ATTN_None)
	TNT1 A 0 A_PlaySound("BROLYCC",CHAN_AUTO)
	TNT1 A 1 A_Jump(128,"TFVoice1")
	TNT1 A 0 A_PlaySound("BROLYTF0",CHAN_AUTO,2.0,false,ATTN_None)
	TNT1 A 1 A_Jump(256,"TFAnim")
  TFVoice1:
	TNT1 A 0 A_PlaySound("BROLYTF1",CHAN_AUTO,2.0,false,ATTN_None)
  TFAnim:
	BROL CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD 1 Bright 
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO,2.0,false,ATTN_None)
	BRLX C 1 //A_Scream
	BRLX D 1 A_Fall
	BRLX C 1 A_CustomMissile("BrolyDeathExplosion",32)
	TNT1 A 0 A_Explode(random(500,1000),512)
    OMBB B 1 Bright A_SpawnItemEx("FriendlyBroly",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	OMBB CDEFHIJKLLLLLLLLLLL 1 Bright A_SetScale(ScaleX + 0.1)
	Stop
  }
}

Actor OmegaBlast2 : OmegaBlast
{
  Damage (Random(500,1000))
  States
  {
  Death:
  XDeath:
	TNT1 A 0 A_Explode(Random(1500,2500),256,0)
    OMBB BCDEFHIJKL 1 Bright 
	Stop
  }
}

Actor KiShield2 : KiShield { Armor.SaveAmount 2500 Armor.MaxSaveAmount 2500 }  //Used for Broly only

Actor KiShieldCharge3 : KiShield2 { Armor.SaveAmount 125 }  //Used for Broly only

Actor KiShieldCharge4 : KiShield2 { Armor.SaveAmount 25 }  //Used for Broly only