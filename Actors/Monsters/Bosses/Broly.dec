Actor Broly  // 3333
{
  //$Category Monsters
  Health 10000
  Radius 24
  Height 64
  Mass 2000
  Speed 19
  Monster
  PainChance 24
  DamageFactor 0.6
  DamageFactor "Exos", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SatanGaurd", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "BrolyAttack", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "PlayerLegendary", 0.4
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "Superweapon", 0.2
  DamageFactor "None", 0.6
  DamageFactor "Hitscan", 1.2
  DamageFactor "HellComet", 1.5
  DamageFactor "Explosion", 0.8
  DamageFactor "Normal", 0.9
  DamageFactor "PlayerIce", 0.5
  DamageFactor "Player", 0.7
  DamageFactor "Players", 0.4
  DamageFactor "PlayerPyro", 0.4
  DamageFactor "PlayerBHole", 0.4
  DamageFactor "PlayerDevBall", 0.6
  DamageFactor "PlayerDevBall2", 0.6
  DamageFactor "PlayerDevTracer", 0.6
  DamageFactor "Player2hu", 0.6
  DamageFactor "RailG", 0.8
  DamageFactor "DTRailgun", 0.8
  DamageFactor "PlayerNemesisPlasma", 0.6
  DamageFactor "PlayerNemesisBFG", 0.3
  DamageFactor "NemesisBall", 0.25
  DamageType "BrolyAttack"
  +BOSS
  +JUMPDOWN
  //+FORCEINFIGHTING
  +LOOKALLAROUND
  +MISSILEEVENMORE
  +FLOORCLIP
  +DONTMORPH
  +NOFEAR
  +QUICKTORETALIATE
  +NOBLOCKMONST
  -COUNTKILL
  +NOTELEFRAG
  +NOICEDEATH
  +NOTIMEFREEZE
  MissileType "KiBallA"
  //SeeSound "superbaron/scream"
  PainSound "BROLPAIN"
  DeathSound "BROLDETH"
  //ActiveSound "superbaron/act"
  MeleeSound "BROLPCH"
  Obituary "$CFBrolyObit"
  HitObituary "$CFBrolyHitObit"
  MeleeRange 64
  Scale 0.8
  Tag "$CFBrolyFP"
  var int user_accelerator;
  var int user_chargecooldown;
  var int user_armorup;
  var int user_music;
  var int user_loop;
  States
  {
  Spawn:
	BRLY A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_GiveInventory("CFArmorToken",5000)
	TNT1 A 0 A_GiveInventory("KiShield",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,10)
  Idle:
  SpawnLoop:
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,2)
	TNT1 A 0 A_Jump(256,2)
    BRLY A 10 Bright A_Look 
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLY A 10 Bright A_Look 
    Loop
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,999)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfInventory("SawPlayer",1,"See2")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("KAKAROT",CHAN_AUTO,1.0,false,ATTN_NONE)
	TNT1 A 0 A_GiveInventory("KiShieldCharge",1)
	BRLY G 2
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	BRLY GG 2
	BRLY LMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLMLM 2 Bright A_SpawnItemEx("BrolyLightningFX2",frandom(-6,6),frandom(-6,6),frandom(32,64),0,0,0,0,SXF_CLIENTSIDE)//A_SpawnItemEx("FakeLegCardinalThunder", Random(190,-144), Random(144,-144), 0, 0, 0, 0, Random(0,359))
	TNT1 A 0 A_GiveInventory("SawPlayer",1)
  See2:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_TakeInventory("OverflowCounter", 36)
	TNT1 A 0 A_TakeInventory("PowerUpCounter", 48)
    TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLY BBBBBB 1 Bright A_Chase
	//TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(84,"InstantMove")
	TNT1 A 0 A_JumpIfTargetInLOS("See2",0)
  ForgetTarget:
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See2
  CheckFriend:
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_JumpIfInventory("BerserkSwitch", 1, "FriendOff")
	TNT1 A 0 A_GiveInventory("BerserkSwitch", 1)
	//TNT1 A 0 A_ChangeFlag(FRIENDLY, True)
	Goto See
  FriendOff:
	TNT1 A 0 A_TakeInventory("BerserkSwitch", 1)
	TNT1 A 0 A_ChangeFlag(FRIENDLY, False)
	Goto See
  CheckFly:
	TNT1 A 0 A_JumpIfInventory("IsFlying", 1, "FlyOff")
	TNT1 A 0 A_GiveInventory("IsFlying", 1)
	TNT1 A 0 A_ChangeFlag(FLOAT, True)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY, True)
	Goto See
  FlyOff:
	TNT1 A 0 A_TakeInventory("IsFlying", 1)
	TNT1 A 0 A_ChangeFlag(FLOAT, False)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY, False)
	Goto See
  InstantMove:
	TNT1 A 0 A_PlaySound("BROLYFST",CHAN_AUTO)
	BRLY AABBCCAABBCCAABBCCAABBCC 0 Bright A_Chase
	TNT1 A 0 A_Recoil(0.1)
	Goto See
  Melee:
	BRLY E 0 A_Jump(32, "Melee2")
	BRLY E 0 A_Jump(16, "KiBlast", "KiBlast3")
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHM",CHAN_AUTO)
	BRLY KKK 1 Bright A_CustomComboAttack("KiBallA",64,Random(40,50),"","BrolyAttack",1)
    Goto See
  Melee2:
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLY K 1 Bright A_CustomComboAttack("KiBallA",64,Random(150,175),"","BrolyAttack",1)
    Goto See
  Missile:
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	//BRLY E 0 Bright A_Jump(256, "Charge")
	//BRLY E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLY E 0 A_Jump(64, "Charge")
	BRLY E 0 A_Jump(64, "KiBlast2", "KiBlast3")
	//BRLY E 0 A_JumpIfInventory("KiOverflow",100,"Overflowing")
	//TNT1 A 0 A_Jump(36,"CheckFly")
	//BRLY E 0 A_Jump(256,2)
	BRLY E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLY E 0 A_Jump(256,2)
	BRLY E 0 A_CheckFloor(2)
	BRLY E 0 A_Jump(32, "Overflowing")
	BRLY E 0 A_Jump(32, "OmegaBlaster")
	//Charge
  KiBlast:
	TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLY E 0 A_Jump(72, 2)
	BRLY K 3 A_CustomMissile ("KiBallA",64)//A_CustomMissile ("KiBall",64)
	Goto See
	BRLY K 3 A_CustomMissile ("KiBall2A",64) //A_CustomMissile ("KiBall2",64)
    Goto See
  KiBlast3:
	TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLY K 3 A_CustomMissile ("KiBall3A",64)
    Goto See
  KiBlast2:
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  KiBlast2Loop:
	TNT1 A 0 A_CustomMissile("KiBlast",64)
	TNT1 A 0 A_PlaySound("KIBLAST",CHAN_AUTO)
    BRLY J 3
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	TNT1 A 0
	Goto See
  OmegaBlaster:
	TNT1 A 0 A_PlaySound("BROLAUGH",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCA",CHAN_AUTO)
	TNT1 A 0 A_GiveInventory("KiShieldCharge",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLY GGGLMLMLMLML 2 Bright
	TNT1 A 0 A_CustomMissile("ChargeFX",48)
	BRLY MLMLMLMLMLMLMLMLMLM 2 Bright A_SpawnItemEx("BrolyLightningFX",frandom(-6,6),frandom(-6,6),frandom(40,56),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 AA 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
    BRLY K 3 Bright A_CustomMissile ("OmegaBlast",48)
    TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  Overflowing:
	TNT1 A 0 A_PlaySound("BROLYOVFW",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCB",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	TNT1 A 0 A_GiveInventory("KiShieldCharge",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	BRLY GGG 2 Bright //A_CustomMissile("OverFlowFX",32)
	BRLY LMLMLMLMLMLML 2 Bright A_CustomMissile("SphereAuraFX",48)
	TNT1 A 0 A_CustomMissile("OverFlowFX",48)
	BRLY MLMLMLMLMLMLMLMLMLML 2 Bright A_CustomMissile("SphereAuraFX",48)
	TNT1 A 0 A_CustomMissile("OverFlowFX",48)
	BRLY MLMLMLMLMLMLMLM 2 Bright A_CustomMissile("SphereAuraFX",48)
	Goto OverflowCont2
  OverflowCont2:
	TNT1 A 0 A_PlaySound("OVERFLOW",CHAN_AUTO,2.0)//,FALSE,ATTN_NONE)
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 16, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 32, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 48, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 64, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	BRLY L 1 Bright A_CustomMissile("SphereAuraFX",32)
	//TNT1 AAA 0 A_PlaySound("OVERFLOW",CHAN_AUTO,2.0)//,FALSE,ATTN_NONE)
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 16, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 32, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 48, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	TNT1 AA 0 A_CustomMissile ("KiBlast2", 64, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 360))
	BRLY M 1 Bright //A_CustomMissile("SphereAuraFX",32)
	TNT1 A 0 A_GiveInventory("OverflowCounter", 1)
	TNT1 A 0 A_JumpIfInventory("OverflowCounter", 36, "OverflowOff")
	Goto OverflowCont2
	//KiBlast2
  OverflowOff:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  Charge:
	BRLY HI 3 Bright A_FaceTarget
	//Goto See
	BRLY J 0 A_SetUserVar(user_accelerator,3)
	BRLY J 0 A_SetUserVar(user_chargecooldown,5)
	BRLY J 0 A_Recoil(-user_accelerator-2)
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 A 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	TNT1 B 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 C 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	TNT1 C 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	TNT1 B 0 A_SetUserVar(user_accelerator,user_accelerator+2)
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 A 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 I 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 C 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	BRLY I 4 A_Recoil(-user_accelerator)
	TNT1 B 0 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	BRLY A 0 A_FaceTarget
	BRLY I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 A 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLY I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 I 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLY I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 C 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLY I 4 A_JumpIf(velx==0 && vely==0,"CrashedSomewhere")
	TNT1 B 0 A_ChangeVelocity(velx*0.8,vely*0.8,velz*0.8,CVF_REPLACE)
	BRLY IH 4 Bright 
	TNT1 A 0 A_Jump(72,"CheckFriend")
	//BRLY J 20 //chance to hit when it slows down
	Goto See
  CrashedSomewhere:
	//BRLY J 0 A_PlaySound("Doom4/Monsters/PinkyCrash",7,0.8,0,2.0)
	BRLY J 0 A_SpawnItemEx("ChargeDustCloud",20,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	//BRLY J 0 A_SetDamageType("PinkieRam")
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLY JJJ 0 A_MeleeAttack
	BRLY J 1 A_Explode(random(500,750),64,0,0,64)
	BRLY J 0 A_RadiusThrust(100, 10,RTF_NOTMISSILE) //|RTF_THRUSTZ)
	BRLY J 0 A_SetDamageType("Normal")
	BRLY K 4 Bright A_Quake(sqrt(user_accelerator),user_accelerator/2,0,256) // chance to hit the back
	TNT1 A 0 A_Jump(72,"CheckFriend")
	Goto See
  PoweringUp:
	TNT1 A 0 A_PlaySound("BROLROAR",CHAN_AUTO,2.0,FALSE,ATTN_NONE)
	TNT1 A 0 A_PlaySound("BROLYCD",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("AURELEA2",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("LSSJAURA",CHAN_BODY,1,TRUE)
	BRLY G 3
  PowerUpCont:
	TNT1 A 0 A_GiveInventory("Health",5)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	BRLY L 1 Bright A_SpawnItemEx("BrolyLightningFX2",frandom(-6,6),frandom(-6,6),frandom(32,64),0,0,0,0,SXF_CLIENTSIDE)
	BRLY M 1 Bright A_GiveInventory("KiShieldCharge2",1)
	TNT1 A 0 A_SpawnItemEx("BrolyLightningFX2",frandom(-6,6),frandom(-6,6),frandom(32,64),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("PowerUpCounter", 1)
	TNT1 A 0 A_JumpIfInventory("PowerUpCounter", 48, "SeeSoundCancel")
	Goto PowerUpCont
  SeeSoundCancel:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_StopSound(CHAN_BODY)
	Goto See
  Pain:
    BRLY Q 5 Bright A_Pain
	//BRLY E 0 Bright A_Jump(72, "Overflowing")
	BRLY E 0 A_CheckFloor(2)
	TNT1 A 0 A_Jump(16,"PoweringUp")
	BRLY E 0 A_Jump(32,"Overflowing")
    Goto See
  XDeath:
  Death:
	TNT1 A 0 A_ChangeFlag("FLOORCLIP",0)
	BRLY Q 5 Bright 
	TNT1 A 0 A_PlaySound("BROLYCC",CHAN_AUTO)
	TNT1 A 0 A_PlaySound("BROLDETH",CHAN_AUTO,2.0,false,ATTN_None)
	BROL ABABABABABABABABABABABABABABABABABABABABABABABABABABABABABAB 1 
	BRLY QRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQR 1 Bright 
	TNT1 A 0 A_PlaySound("BROLYFIR",CHAN_AUTO)
	BRLY R 1 //A_Scream
	BRLY R 1 A_Fall
	BRLY R 1 A_CustomMissile ("BrolyDeathExplosion",32)
	TNT1 A 0 A_Explode(Random(1000,1500),1024,0)
	TNT1 AAAAA 0 A_SpawnItemEx("LegendaryLifeEssence",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryBossLifeEssence",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 AAAAA 0 A_SpawnItemEx("LegendaryArmorBonusMax",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryBossArmorBonusMax",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryArmor",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,35)
	TNT1 A 0 A_DropItem("SpreadRuneGiver",1,192)
	TNT1 A 0 A_DropItem("SpreadRuneUpgrade",1,96)
    OMBB B 1 Bright 
	OMBB CDEFHIJKLLLLLLLLLLL 1 Bright A_SetScale(ScaleX + 0.1)
	Stop
  }
}

Actor FriendlyBroly : Broly
{
  +FRIENDLY
  +MTHRUSPECIES
  +THRUSPECIES
  +DONTHURTSPECIES 
  Species "Marines"
  Tag "Allied Broly (Full Power)"
  States
  {
  Spawn:
	BRLY AB 0 A_ChangeFlag(FRIENDLY, True)
	BRLY AA 10 Bright A_Look
	Loop
  See2:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_TakeInventory("OverflowCounter", 36)
	TNT1 A 0 A_TakeInventory("PowerUpCounter", 48)
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	BRLY BBBBBB 1 Bright A_Chase
	//TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(36,"CheckFly")
	TNT1 A 0 A_Jump(84,"InstantMove")
	TNT1 A 0 A_JumpIfTargetInLOS("See2",0)
  ForgetTarget:
	TNT1 A 0 A_ClearTarget
	Goto See2
  CheckFriend:
	TNT1 A 0 A_ChangeFlag(FRIENDLY, True)
	Goto See
  Melee:
	TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "See2")
	BRLY E 0 A_Jump(32, "Melee2")
	BRLY E 0 A_Jump(16, "KiBlast", "KiBlast3")
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHM",CHAN_AUTO)
	BRLY KKK 1 Bright A_CustomComboAttack("KiBallA",64,30,"","Player",1)
    Goto See
  Melee2:
    TNT1 A 0 A_PlaySound("BROLATTK",CHAN_AUTO)
	BRLY HIJ 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BROLPCHL",CHAN_AUTO)
	BRLY K 1 Bright A_CustomComboAttack("KiBallA",64,Random(150,175),"","Player",1)
    Goto See
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACFMarine", 1, "See2")
	TNT1 A 0 A_AlertMonsters(0,AMF_TARGETEMITTER)
	//BRLY E 0 A_Jump(256, "Charge")
	//BRLY E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLY E 0 A_Jump(64, "Charge")
	BRLY E 0 A_Jump(64, "KiBlast2", "KiBlast3")
	//BRLY E 0 A_JumpIfInventory("KiOverflow",100,"Overflowing")
	//TNT1 A 0 A_Jump(36,"CheckFly")
	//BRLY E 0 A_Jump(256,2)
	BRLY E 0 A_JumpIfInventory("IsFlying",1,2)
	BRLY E 0 A_Jump(256,2)
	BRLY E 0 A_CheckFloor(2)
	BRLY E 0 A_Jump(32, "Overflowing")
	BRLY E 0 A_Jump(32, "OmegaBlaster")
	Goto KiBlast
	//Charge
  /*
  FriendOff:
	TNT1 A 0 A_TakeInventory("BerserkSwitch", 1)
	TNT1 A 0 A_ChangeFlag(FRIENDLY, False)
	Goto See
  */
  }
}

Actor PowerUpCounter : Inventory { Inventory.MaxAmount 48 }
Actor IsFlying : Inventory {}
Actor BerserkSwitch : Inventory {}
Actor SawPlayer : Inventory {}
Actor OverflowCounter : Inventory { Inventory.MaxAmount 36 }
Actor KiOverflow : Inventory { Inventory.MaxAmount 100 }

Actor ChargeDustCloud
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
