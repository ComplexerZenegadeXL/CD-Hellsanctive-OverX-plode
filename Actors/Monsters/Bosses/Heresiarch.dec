	DMGB A 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB A 1 Bright
	TNT1 A 0 A_SeekerMissile(5,5)
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
	TNT1 AAA 0 A_SpawnItemEx("DarkMatterSpark",0,0,0,frandom(-3,0),frandom(-2,2),frandom(-2,2))
	DMGB B 1 Bright
