Actor LegendaryDoomguyGhostA
{
  Renderstyle Translucent
  Alpha 0.7
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1,"Null")
	TNT1 A 0 A_CheckSight("Null")
	TNT1 A 1
	Goto Fade
  Fade:
	NLD0 A 2 A_FadeOut(0.1)
	Loop
  }
}

