	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1 A_SpawnItemEx("LegDoomguySmoke",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Stop
  Vanilla:
	TNT1 A 1 A_SpawnItemEx("LegDoomguySmoke",frandom(-20,20),frandom(-20,20),frandom(20,40),0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,160)
	Stop	
  }
}

