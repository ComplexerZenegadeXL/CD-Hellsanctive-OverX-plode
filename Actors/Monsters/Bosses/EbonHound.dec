{
  Height 17
  Radius 17
  Speed 19
  Damage (Random(6,8))
  Species "CFBoss"
  //Species "Fiends"
  SeeSound ""  
  DeathSound ""
  +HITTRACER
  Projectile
  States
  {
  Spawn:
	TNT1 A 2
    Stop
  Death:
