Actor GroundShadowRift
{ 
  Projectile
  Height 8
  Radius 13
  Speed 25
  FastSpeed 31
  BounceType "Hexen"
  BounceCount 8
  BounceFactor 1.5
  WallBounceFactor 1.5
  MinMissileChance 1
  Damage (0)
  +ALWAYSFAST
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +DONTBLAST
  +THRUACTORS
  +FLOORHUGGER
  +HEXENBOUNCE
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  Species "CFBoss"
  DamageType "AbyssalSatyr"
  var int user_counter;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
	TNT1 A 0 A_SetUserVar("user_counter",67)
	TNT1 A 0 A_PlaySound("hellion/smokeloop",CHAN_VOICE,1.0,1) 
  SpawnLoop:
	HESK A 1 Bright A_SpawnItem("ShadowRiftFX")
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,128,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(Random(3,5),256)
	HESK B 1 Bright A_SpawnItem("ShadowRiftFX")
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,128,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(Random(3,5),256)
	HESK C 1 Bright A_SpawnItem("ShadowRiftFX")
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,128,0,360,2)
	TNT1 A 0 A_Jump(256,3)
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(Random(3,5),256)
	TNT1 A 0 A_JumpIf(user_counter < 1,"Death")
	TNT1 A 0 A_SetUserVar("user_counter",user_counter - 1)
	Loop
  Death:
	HESK A 1 Bright
	TNT1 AAAAAAAAA 0 A_SpawnItem("ShadowRiftFX")
	TNT1 A 1 A_PlaySound("HellionTracerFire",CHAN_VOICE,1.0,0)
	Stop
	/*
  XDeath:
	TNT1 A 0
	HESK A 1 Bright A_Explode(Random(20,45),128)
	TNT1 AAAAAAAAA 0 A_SpawnItem("ShadowRiftFX")
	TNT1 A 1 A_PlaySound("HellionTracerFire",CHAN_VOICE,1.0,0)
	Stop
	*/
  }
}

