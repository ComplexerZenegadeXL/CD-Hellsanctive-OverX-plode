	SBS4 ABCD 1 Bright A_SpawnItemEx("AdvisorBallTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
  SpawnLoop:
	SBS4 E 1 A_SpawnItemEx("AdvisorBallTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(15,3)
	TNT1 A 0 A_Countdown
	Loop
