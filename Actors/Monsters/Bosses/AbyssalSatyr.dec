	Stop
  XDeath:
	SBS4 FGHIJKL 3 Bright
	TNT1 A 0 A_Explode(18,58,0)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,1,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom8",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1
	Stop
  }
}

