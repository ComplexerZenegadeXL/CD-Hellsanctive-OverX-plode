  SeeSound "ASatyr/see"
  PainSound "ASatyr/pain"
  DeathSound "ASatyr/death"
  ActiveSound "ASatyr/active"
  Obituary "$CFAbyssalSatyrObit"
  HitObituary "$CFAbyssalSatyrHitObit"
  Tag "$CFAbyssalSatyr"
  var int user_music;
  var int user_lightlevel;
  var int user_currenthp;
  var int user_lcounter;
  var int user_Scounter;
  var int user_Icounter;
  var int user_Dcounter;
  var int user_ammodh;
  var int user_gotoshield;
  var int user_lowlag;
  var int user_loop;
  States
  {
  Spawn:
	OSST A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_ammodh",0)
	TNT1 A 0 A_SetUserVar("user_Scounter",0)
	TNT1 A 0 A_SetUserVar("user_Icounter",0)
	TNT1 A 0 A_SetUserVar("user_Dcounter",0)
	TNT1 A 0 A_SetUserVar("user_gotoshield",0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_GiveInventory("IsAnAbyssalSatyr",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
  SpawnLoop:
	OSST A 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	Loop
  Idle:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,0)
	TNT1 A 0 A_SetUserVar("user_ammodh",0)
	TNT1 A 0 A_SetUserVar("user_Scounter",0)
	TNT1 A 0 A_SetUserVar("user_Icounter",0)
	TNT1 A 0 A_SetUserVar("user_Dcounter",0)
	TNT1 A 0 A_GiveInventory("ResetMonsterInvul",1)
  IdleLoop:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OSST AAA 2 A_Wander
	TNT1 A 0 A_Look
	OSST BBB 2 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	OSST CCC 2 A_Wander
	TNT1 A 0 A_Look
	OSST DDD 2 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	OSST AAABBB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 ACS_NamedExecuteAlways("GogglesCheckTarget")
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_LightOnMap",0,1,192)
	TNT1 A 0 A_GiveInventory("ResetMonsterInvul",1)
	TNT1 A 0 A_SetUserVar("user_lcounter",0)
  SeeLoop:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_JumpIf(user_music == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,811)
	TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,8,1)
	TNT1 A 0 A_SetUserVar("user_music",1)
	OSST AAA 2 A_Chase
	TNT1 A 0 A_Chase
	OSST BBB 2 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	OSST CCC 2 A_Chase
	TNT1 A 0 A_Chase
	OSST DDD 2 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"RandomSpawnHighChance2")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter > 25,"Chase")
	Loop
  Chase:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
	TNT1 A 0 A_GiveInventory("ReturnToChase",1)
	TNT1 A 0 A_Jump(256,"AbyssalImps","Advisors")
  ChaseReturn:
	TNT1 A 0 A_TakeInventory("ReturnToChase",1)
  ChaseLoop1:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OSST AAA 2 A_Chase("Melee","")
	TNT1 AA 0 A_Chase("Melee","")
	OSST BBB 2 A_Chase("Melee","")
	TNT1 AA 0 A_Chase("Melee","")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"ObsidianTurrets")
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	OSST CCC 2 A_Chase("Melee","")
	TNT1 AA 0 A_Chase("Melee","")
	OSST DDD 2 A_Chase("Melee","")
	TNT1 AA 0 A_Chase("Melee","")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"ObsidianTurrets")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter < 25,"ChaseLoop1")
  Chase2:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
  ChaseLoop2:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OSST AAA 2 A_Chase
	TNT1 AAA 0 A_Chase
	OSST BBB 2 A_Chase
	TNT1 AAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"RandomSpawnHighChance2")
	OSST CCC 2 A_Chase
	TNT1 AAA 0 A_Chase
	OSST DDD 2 A_Chase
	TNT1 AAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("BigHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"RandomSpawnHighChance2")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter < 25,"ChaseLoop2")
	Goto See
  Melee:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	OSST EFG 4 A_FaceTarget
	OSST G 1 A_CustomMeleeAttack(random(100,500),"stoneimp/hit","None","Stun")
	TNT1 A 0 A_JumpIfInTargetLOS("Pullout",90,JLOSF_DEADNOJUMP,90)
	Goto NoPullout
  Pullout:
	TNT1 A 0 A_GiveToTarget("SlowDownMode",1)
	TNT1 A 0 A_GiveToTarget("CFHideweapon2",1)
	TNT1 A 0 A_GiveToTarget("CFTakeAmmo",1)
  NoPullout:
	OSST GFE 4
	TNT1 A 0 A_Jump(128,"ShadowRift")
	Goto See
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,0)
	TNT1 A 0 A_GiveInventory("ResetMonsterInvul",1)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.13),"Rage")
	TNT1 A 0 A_GiveInventory("ReturnToMissile",1)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.33),"RandomSpawnHighChance")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.66),"RandomSpawn")
  Missile2:
	TNT1 A 0 A_TakeInventory("ReturnToMissile",1)
	TNT1 A 0 A_JumpIfTargetInLOS("VeryFarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1500)
	TNT1 A 0 A_JumpIfTargetInLOS("FarRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,1000)
	TNT1 A 0 A_JumpIfTargetInLOS("LongRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,800)
	TNT1 A 0 A_JumpIfTargetInLOS("NearRange",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,500)
	TNT1 A 0 A_JumpIfTargetInLOS("Normal",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
  Missile3:
	TNT1 A 0 A_Jump(128,"ObsidianTurrets","RandomSpawnHighChance2")
  Missile4:
	TNT1 A 0 A_MonsterRefire(0,"Chase")
  Normal:
	TNT1 A 0 A_SetUserVar("user_lcounter",0)
  NormalLoop:
	OSST EF 4 A_FaceTarget(45)
	OSST G 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("ObsidianPurpleFireball",82,0,frandom(6,12),CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 5 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("ObsidianPurpleFireball",82,0,frandom(-12,-6),CMF_TRACKOWNER)
	OSST GFE 5
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter > 2,"NormalCA")
	TNT1 A 0 A_JumpIfTargetInLOS("NormalLoop",360,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,80)
	TNT1 A 0 A_JumpIfTargetInLOS("Melee",360,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,100,0)
	TNT1 A 0 A_JumpIfTargetInLOS("NormalCA",360,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,1000,0)
	TNT1 A 0 A_Jump(160,"See")
  NormalCA:
	TNT1 A 0 A_Jump(60,"DarkFireballsCA")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalCALoop:
	OSST E 4 A_FaceTarget
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	OSST G 3 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(0,"NormalNV")
  NormalNV:
	TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("ObsidianPurpleFireball",82,0,frandom(-4,4),CMF_TRACKOWNER|CMF_OFFSETPITCH,frandom(-1.0,1.0))
	OSST RQP 4
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	Goto See
  NearRange:
	TNT1 A 0 A_Jump(256,"Comets","ObsidianTracers")
	Goto Normal
  LongRange:
	TNT1 A 0 A_Jump(256,"DarkFireBalls","Comets")
	Goto Normal
  FarRange:
	TNT1 A 0 A_Jump(256,"ShadowRiftSpread","DarkFireBalls")
	Goto Normal
  VeryFarRange:
	TNT1 A 0 A_Jump(256,"ObsidianStakesLongRange","ObsidianTurrets")
	Goto Normal
  Rage:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_Jump(256,"DarkFireBalls","Comets","ShadowRiftSpread","ObsidianTracers","ObsidianTurrets","ObsidianStakesLongRange","AbyssalImps","Advisors")
	Goto See
  RandomSpawn:
	TNT1 A 0 A_Jump(64,"AbyssalImps","Advisors")
	Goto Missile2
  RandomSpawnHighChance:
	TNT1 A 0 A_Jump(128,"AbyssalImps","Advisors")
	Goto Missile2
  RandomSpawnHighChance2:
	TNT1 A 0 A_Jump(128,"AbyssalImps","Advisors")
	Goto Missile4
  ObsidianStakes:
	OSST E 1 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,1)
	OSST EEEEE 4 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 Radius_Quake(50,200,0,24,0)	
	OSST GGGGG 2 Bright A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ObsidianStakesSpawn",frandom(-256,256),frandom(-256,256),0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION,128)
	OSST RRRRQQQQPPPP 2 Bright A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ObsidianStakesSpawn",frandom(-360,360),frandom(-360,360),0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION,128)
	OSST FFFFFFFFFFF 2 Bright A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ObsidianStakesSpawn",frandom(-480,480),frandom(-480,480),0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_ABSOLUTEPOSITION|SXF_SETMASTER,128)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	OSST FR 4 Bright A_FaceTarget
	OSST RRQQPP 2 Bright A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	Goto See
  DarkFireballs:
	OSST EF 4 A_FaceTarget
	OSST G 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("AbyssalSatyrDarkFireball",82,0,frandom(6,12),CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 5 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("AbyssalSatyrDarkFireball",82,0,frandom(-12,-6),CMF_TRACKOWNER)
	OSST GFE 5
	TNT1 A 0 A_Jump(160,"See")
  DarkFireballsCA:
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DarkFireballsCALoop:
	OSST E 4 A_FaceTarget
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	OSST GGG 1 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(0,"DarkFireballsNV")
  DarkFireballsNV:
	TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("AbyssalSatyrDarkFireball",82,0,frandom(-4,4),CMF_TRACKOWNER|CMF_OFFSETPITCH,frandom(-2.0,2.0))
	OSST RQP 4
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	Goto See
  Comets:
	OSST EF 4 A_FaceTarget(45)
	OSST G 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("ASComet",82,0,frandom(0,6),CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 4 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("ASComet",82,0,frandom(-6,0),CMF_TRACKOWNER)
	OSST GFE 5
	TNT1 A 0 A_Jump(160,"See")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CometsLoop:
	OSST E 4 A_FaceTarget
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	OSST GGG 1 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(0,"CometsNV")
  CometsNV:
	TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("ASComet",82,0,frandom(-3,3),CMF_TRACKOWNER|CMF_OFFSETPITCH,frandom(-1.0,1.0))
	OSST RQP 4
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  ObsidianTracers:
	OSST EF 4 A_FaceTarget(45)
	OSST G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ObsidianTracer",82,0,-8,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 5 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ObsidianTracer",82,0,8,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST GFE 5
	TNT1 A 0 A_Jump(160,"See")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ObsidianTracersLoop:
	OSST E 4 A_FaceTarget
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	OSST G 3 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(0,"ObsidianTracersNV")
  ObsidianTracersNV:
	TNT1 AAAAAA 0 A_CustomMissile("ObsidianTracer",82,0,frandom(-16,16),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST RQP 4
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	GoTo See
  ShadowRift:
	OSST EF 4 A_FaceTarget(45)
	OSST GGG 1 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GroundShadowRift",82,0,frandom(4,15),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 5 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GroundShadowRift",82,0,frandom(-15,-4),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST GFE 5
	Goto See
  ShadowRiftSpread:
	OSST EF 4 A_FaceTarget(45)
	OSST G 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GroundShadowRift",82,0,frandom(4,15),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST RQP 4
	OSST Q 5 A_FaceTarget
	OSST R 3 Bright A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GroundShadowRift",82,0,frandom(-15,-4),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST GFE 5
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShadowRiftSpreadLoop:
	OSST E 4 A_FaceTarget
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	OSST E 4 A_FaceTarget
	OSST G 3 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(0,"ShadowRiftSpreadNV")
  ShadowRiftSpreadNV:
	TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("GroundShadowRift",82,0,frandom(-22,22),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST RQP 4
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  ObsidianTurrets:
	OSST GF 5 A_FaceTarget(45)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
  ObsidianTurretsCharge:
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST E 1 A_FaceTarget
	TNT1 A 0 A_VileTarget("ObsidianQuaker")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter < 90,"ObsidianTurretsCharge")
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST EE 4 A_FaceTarget
	OSST E 7 A_VileTarget("ObsidianTurretSpawn")
	OSST E 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	Goto See
  ObsidianStakesLongRange:
	OSST GF 5 A_FaceTarget(45)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_Scounter",0)
	TNT1 A 0 A_SetUserVar("user_lcounter",1)
  ObsidianStakesLongRangeCharge:
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST E 1 A_FaceTarget
	TNT1 A 0 A_VileTarget("ObsidianQuaker")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter < 90,"ObsidianStakesLongRangeCharge")
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST E 6 A_FaceTarget
	OSST E 1 A_MonsterRefire(8,"ObsidianStakesLongRangeEnd")
	OSST E 1 A_VileTarget("ObsidianStakesRangeSpawn")
  ObsidianStakesLongRangeEnd:
	OSST E 6
	OSST E 1 A_SetUserVar("user_currenthp",Health)
	OSST E 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	Goto See
  Advisors:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	OSST GF 7 A_FaceTarget(45)
	OSST E 1 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST E 1 A_FaceTarget
	TNT1 A 0 A_Recoil(15)
	OSST E 6 A_FaceTarget
	OSST E 1 Bright A_CustomMissile("AdvisorSummoner",82,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST E 4 Bright
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST FG 4
	OSST RQ 5
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST P 6
	TNT1 A 0 A_Facetarget
	OSST P 1 Bright A_CustomMissile("AdvisorSummoner",82,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST P 4 Bright
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST Q 5
	OSST R 4 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	OSST R 1 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	TNT1 A 0 A_JumpIfInventory("ReturnToChase",1,"ChaseReturn")
	TNT1 A 0 A_JumpIfInventory("ReturnToMissile",1,"Missile2")
	Goto See
  AbyssalImps:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	OSST GF 7 A_FaceTarget(45)
	OSST E 1 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST E 1 A_Facetarget
	TNT1 A 0 A_Recoil(15)
	OSST E 6 A_Facetarget
	OSST E 1 Bright A_CustomMissile("AbyssalImpSummoner",82,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST E 4 Bright
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST FG 4
	OSST RQ 5
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST P 6
	TNT1 A 0 A_Facetarget
	OSST P 1 Bright A_CustomMissile("AbyssalImpSummoner",82,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	OSST P 4 Bright
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST Q 5
	OSST R 4 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	OSST R 1 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"Teleport1")
	TNT1 A 0 A_JumpIfInventory("ReturnToChase",1,"ChaseReturn")
	TNT1 A 0 A_JumpIfInventory("ReturnToMissile",1,"Missile2")
	Goto See
  Pain.Crush:
	TNT1 A 0
	Goto Teleport1
  Pain.LegendaryGuruPlayer:
  Pain.Legendary:
	//TNT1 A 0 A_GiveInventory("MonsterInvulnerable",1)
	TNT1 A 0 A_GiveInventory("InfightingCheck",1)
	TNT1 A 0 A_CheckFlag(NOINFIGHTING,2)
	TNT1 A 0 A_Jump(200,"Rage")
  /*Pain.BFG9500Ball:
  Pain.BFGSplash:
  Pain.UpBFG9500Ball:
  Pain.UpBFGSplash:
  Pain.PlayerDevBall:
  Pain.PlayerDevBall2:
  Pain.BFG10K:
  Pain.PDTBFG:
  Pain.DTBFG10KBall:
	TNT1 A 0
	Goto Teleport1
  Pain.NuclearFire:
  Pain.Explosion:
  Pain.Mine:
	TNT1 A 0 A_SetUserVar("user_gotoshield",1)
	Goto Teleport1*/
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	OSST H 7 A_Pain
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 300,"Shield")
	TNT1 A 0 A_JumpIfCloser(800,"ObsidianStakesRandom")
	TNT1 A 0 A_Jump(64,"ObsidianTurrets")
	Goto Teleport2
  ObsidianStakesRandom:
	TNT1 A 0 A_JumpIfTargetInLOS("ObsidianTurretsRandom",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	TNT1 A 0 A_Jump(138,"ObsidianStakes","ShadowRiftSpread")
	Goto Teleport2
  ObsidianTurretsRandom:
	TNT1 A 0 A_Jump(138,"ObsidianTurrets","ShadowRiftSpread")
	Goto Teleport2
  Teleport2:
	TNT1 A 0 A_JumpIfHealthLower((Health*0.25),"Teleport1")
	TNT1 A 0 A_Jump(128,"See")
	TNT1 A 0 A_JumpIfHealthLower((Health*0.50),"Teleport1")
	Goto See
  PainSummon:
	TNT1 A 0 A_SetUserVar("user_Icounter",0)
	TNT1 A 0 A_Jump(128,"Advisors","AbyssalImps")
	TNT1 A 0 A_JumpIfHealthLower((Health*0.25),"Teleport1")
	Goto See
  Teleport1:
	TNT1 A 0 A_Jump(85,"See")
	OSST H 1 A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,1)
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	OSST HHHHHHHHHH 1 A_FadeOut(0.1,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAA 0 A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_Facetarget
	OSST DDDDDDDDDD 1 A_FadeIn(0.1)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,0)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	OSST D 1 A_SetShootable
	TNT1 A 0 A_JumpIf(user_gotoshield != 0,"Shield")
	Goto See
  Shield:
	TNT1 A 0 A_SetUserVar("user_gotoshield",0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_JumpIf(user_Scounter > 1,"ObsidianStakesLongRange")
	TNT1 A 0 A_SetUserVar("user_Scounter",user_Scounter+1)
	TNT1 A 0 A_SetUserVar("user_lcounter",525)
  DowntoFloor:
	TNT1 A 0 A_ChangeFlag(Thruactors,1)
	OSST H 1 Bright A_SpawnItem("AbyssalSatyrFlameSpawner",0,0,0,0)
	TNT1 A 0 A_CheckFloor("Shield2")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter-1)
	TNT1 A 0 A_JumpIf(user_lcounter < 1,"Shield2")
	Loop
  Shield2:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag(Thruactors,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Shield2Loop:
	TNT1 A 0 A_CustomMissile("AbyssalShieldSpawner",30,0,user_loop*25,CMF_AIMDIRECTION | CMF_TRACKOWNER | CMF_CHECKTARGETDEAD)
	TNT1 A 0 A_CustomMissile("AbyssalShieldSpawner2",30,0,user_loop*25,CMF_AIMDIRECTION | CMF_TRACKOWNER | CMF_CHECKTARGETDEAD,25)
	TNT1 A 0 A_CustomMissile("AbyssalShieldSpawner3",30,0,user_loop*25,CMF_AIMDIRECTION | CMF_TRACKOWNER | CMF_CHECKTARGETDEAD,35)
	TNT1 A 0 A_CustomMissile("AbyssalShieldSpawner4",30,0,user_loop*25,CMF_AIMDIRECTION | CMF_TRACKOWNER | CMF_CHECKTARGETDEAD,45)
	TNT1 A 0 A_CustomMissile("AbyssalShieldSpawner5",30,0,user_loop*25,CMF_AIMDIRECTION | CMF_TRACKOWNER | CMF_CHECKTARGETDEAD,55)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop < 15,"Shield2Loop")
	OSST G 149 Bright
	TNT1 A 0 A_Blast(BF_DONTWARN|BF_NOIMPACTDAMAGE,255,255,30)
	"####" "#" 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	"####" "#" 0
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_Icounter > 1,"PainSummon")
	TNT1 A 0 A_SetUserVar("user_Icounter",user_Icounter+1)
	Goto Missile
  Death:
	OSST H 5 A_Scream
	TNT1 A 0 A_KillChildren
	OSST HHHHHHHHHHHH 1 Bright A_CustomMissile("Kaboom26",frandom(20,100),frandom(-30,30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	OSST IJKLMN 4
	TNT1 A 0 ACS_NamedExecuteAlways("CF_LightOnMap",0,2,192)
	TNT1 A 0 A_Fall
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("UltraSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_DropItem("DemonicChaliceGiver",1,128)
	TNT1 A 0 A_SpawnItemEx("SkullOfPowerGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("NemesisUltraSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("NemesisArmorSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_RemoveChildren
	TNT1 A 0 ACS_NamedExecuteAlways("DropDoll",0,60)
	TNT1 A 0 A_KillMaster
	OSST O -1
	Stop
  XDeath:
	OSST H 5 A_Scream
	DSTX ABC 4 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX DEF 3 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX GHI 2 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX J 1 A_KillChildren
	TNT1 AAAAA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX J 1
	TNT1 AAAA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX J 1 ACS_NamedExecuteAlways("CF_LightOnMap",0,2,192)
	TNT1 AAA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX J 1 A_Fall
	TNT1 AA 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DSTX J 1 A_SpawnItemEx("NemesisUltraSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("NemesisArmorSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_CustomMissile("BigPurpleBloodCloud",frandom(10,100),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("FearOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("AbyssalSlaveOrb",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_SpawnItemEx("UltraSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_DropItem("DemonicChaliceGiver",1,64)
	TNT1 A 0 A_SpawnItemEx("SkullOfPowerGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("NemesisUltraSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("NemesisArmorSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	DSTX J 1 A_RemoveChildren
	TNT1 A 0 ACS_NamedExecuteAlways("DropDoll",0,60)
	TNT1 A 0 A_KillMaster
	DSTX J -1
	Stop
  }
}

Actor CursedSatyr: AbyssalSatyr { -COUNTKILL Tag "\c[s9]Abyssal Satyr (CURSED)\c-" }

Actor IsAnAbyssalSatyr : Inventory { }
Actor ReturnToMissile : Inventory { }
Actor ReturnToChase : Inventory { }

Actor AbyssalSatyrFlameSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("AbyssalSatyrFlame",frandom(-40,40),frandom(-40,40),frandom(60,100),0,0,frandom(4,6),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor AbyssalSatyrFlame
{
  RenderStyle Add
  Scale 0.8
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(256,1,2,3,4)
	TNT1 AAA 1
	TNT1 A 0
	PMKE ABCDEFGHIJKL 2 Bright A_FadeOut(0.1,1)
	Wait
  }
}

Actor ObsidianQuaker : RedParticleSpawner
{
  -CLIENTSIDEONLY
  +NOTIMEFREEZE
  +FLOORHUGGER
  +NOEXPLODEFLOOR
  +NOINTERACTION
  +NOBLOCKMAP
  +NONSHOOTABLE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Quake(4,2,0,68)
	TNT1 A 0 A_SpawnItemEx("CFPurpleParticleSpawner",0,0,1,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 10 A_SpawnItemEx("SmokeFX4",frandom(-8,8),frandom(-8,8),0,frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	Stop
  }
}

Actor ObsidianTurretSpawn : RedParticleSpawner
{
  -CLIENTSIDEONLY
  -NOGRAVITY
  -NOINTERACTION
  +NOTIMEFREEZE
  +FLOORHUGGER
  +FORCERADIUSDMG
  +NONSHOOTABLE
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "CFBoss"
  DamageType "AbyssalSatyr"
  Obituary "$CFObsidianTurretSpawnObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 12
	TNT1 A 0 A_Quake(9,8,0,128,"None")
	TNT1 A 0 A_Explode(random(100,250),96,0)
	TNT1 A 0 A_PlaySound("StoneArmor/Destroy",CHAN_AUTO,1.5,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("StoneBitsSpawner2",0,0,35,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 15
	TNT1 A 1 A_JumpIfInventory("MarineKilled",1,"BloodySpawn")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckCelling_Z") == 1,"SpawnLow")
	TNT1 A 1 A_SpawnItemEx("ObsidianTurret",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  SpawnLow:
	TNT1 A 1 A_SpawnItemEx("ObsidianTurretLow",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  BloodySpawn:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckCelling_Z") == 1,"BloodySpawnLow")
	TNT1 A 1 A_SpawnItemEx("ObsidianTurretBloody",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  BloodySpawnLow:
	TNT1 A 1 A_SpawnItemEx("ObsidianTurretBloodyLow",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor ObsidianStakesSpawn: RedParticleSpawner
{
  -CLIENTSIDEONLY
  -NOGRAVITY
  -NOINTERACTION
  +NOTIMEFREEZE
  +FLOORHUGGER
  +FORCERADIUSDMG
  +NONSHOOTABLE
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "CFBoss"
  DamageType "AbyssalSatyr"
  Obituary "$CFObsidianStakesSpawnObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1
	TNT1 A 0 A_Jump(256,1,2,3,4,5,6)
	TNT1 AAAAA 1
	TNT1 A 12
	TNT1 A 0 A_Quake(9,8,0,128,"None")
	TNT1 A 0 A_Explode(random(100,250),96,0)
	TNT1 A 0 A_PlaySound("StoneArmor/Destroy",CHAN_AUTO,1.5,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("StoneBitsSpawner2",0,0,35,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,128)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 15
	TNT1 A 1 A_JumpIfInventory("MarineKilled",1,"BloodySpawn")
	TNT1 A 1 A_SpawnItemEx("ObsidianStake",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  BloodySpawn:
	TNT1 A 1 A_SpawnItemEx("ObsidianStakeBloody",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION)
	Stop
  }
}

