Actor ObsidianTurret
{
  Health 100
  Height 128
  Radius 10
  Speed 0
  FastSpeed 0
  Mass 0x7FFFFFFF
  +ISMONSTER
  -COUNTKILL
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +FORCERADIUSDMG
  +FLOORCLIP
  +SOLID
  +NOTARGET
  +NOBLOOD
  +SHOOTABLE
  +FLOORHUGGER
  +MOVEWITHSECTOR
  -INVULNERABLE
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "CFBoss"
  DamageType "AbyssalSatyr"
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Acid", 0.0
  DamageFactor "Fire", 0.001
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.001
  DamageFactor "Disintegrate", 0.001
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "Rocket", 0.01
  DamageFactor 0.15
 Obituary "$CFCFObsidianTurretObit"
  var int user_tsc;
  var int user_loop;
  var int user_loop2;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TSPK V 4 A_SetUserVar("user_tsc",22)
	TSPK UTSRQPONMLKJIHGFEDCBA 4 A_SetUserVar("user_tsc",user_tsc - 1)
	TSPK AAAAAAAA 1 A_Look
	Goto See
  See:
	TSPK A 18
	Goto Missile
  Missile:
	TSPK A 1 Bright A_SpawnItemEx("ObsidianFlare2",0,0,128,0,0,0,0,SXF_CLIENTSIDE,0)
	TSPK A 17 Bright
	TNT1 A 0 A_CustomMissile("AdvisorBall",128,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",-150)
	TNT1 A 0 A_SetUserVar("user_loop2",0)
  MissileLoop1:
	TNT1 A 0 A_CustomMissile("TurretBouncers",128,0,user_loop)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+30)
	TNT1 A 0 A_JumpIf(user_loop <= 180,"MissileLoop1")
	TSPK A 1 Bright A_SpawnItemEx("ObsidianFlare2",0,0,128,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetUserVar("user_loop",-150)
  MissileLoop2:
	TSPK A 5 Bright
	TNT1 A 0 A_CustomMissile("AdvisorBall",128,0,0)
	TNT1 A 0 A_CustomMissile("TurretBouncers",128,0,user_loop)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+30)
	TNT1 A 0 A_JumpIf(user_loop > 180,1)
	Goto MissileLoop2+2
	TNT1 A 0 A_SetUserVar("user_loop",-150)
  MissileLoop3:
	TSPK A 6 Bright
	TNT1 A 0 A_CustomMissile("AdvisorBall",128,0,0)
	TNT1 A 0 A_CustomMissile("TurretBouncers",128,0,user_loop)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+30)
	TNT1 A 0 A_JumpIf(user_loop > 180,1)
	Goto MissileLoop3+2
	TNT1 A 0 A_SetUserVar("user_loop",-150)
	TSPK A 1 Bright A_SpawnItemEx("ObsidianFlare2",0,0,128,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetUserVar("user_loop2",user_loop2+1)
	TNT1 A 0 A_JumpIf(user_loop2 > 3,1)
	Goto MissileLoop2
	TSPK A 14
	TSPK A 1 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TSPK ABCDEFGHIJKLMNOPQRSTUV 4
	TNT1 A 1 A_Noblocking
	Stop
  Death:
	TNT1 A 0 ACS_NamedExecuteWithResult("ObsidianDeath",user_tsc)
  Frame1:
	TSPK A 1
  Frame2:
	TSPK B 1
  Frame3:
	TSPK C 1
  Frame4:
	TSPK D 1
  Frame5:
	TSPK E 1
  Frame6:
	TSPK F 1
  Frame7:
	TSPK G 1
  Frame8:
	TSPK H 1
  Frame9:
	TSPK I 1
  Frame10:
	TSPK J 1
  Frame11:
	TSPK K 1
  Frame12:
	TSPK L 1
  Frame13:
	TSPK M 1
  Frame14:
	TSPK N 1
  Frame15:
	TSPK O 1
  Frame16:
	TSPK P 1
  Frame17:
	TSPK Q 1
  Frame18:
	TSPK R 1
  Frame19:
	TSPK S 1
  Frame20:
	TSPK T 1
  Frame21:
	TSPK U 1
  Frame22:
	TSPK V 1
	TNT1 A 0 A_Quake(9,8,0,128,"None")
	TNT1 A 0 A_Explode(random(100,250),96,0)
	TNT1 A 0 A_Blast(BF_DONTWARN|BF_NOIMPACTDAMAGE,225,200,30)
	TNT1 A 0 A_PlaySound("StoneArmor/Destroy",0,1.5,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("StoneBitsSpawner2",0,frandom(-10,10),0,0,0,0,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 10 A_NoBlocking
	Stop
  }
}

