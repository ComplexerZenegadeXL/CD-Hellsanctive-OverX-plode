Actor RocketDoge
{
  Monster
  Health 80
  Height 36
  Radius 14
  Speed 11
  Mass 100
  Scale 1.1
  PainChance "Mine", 256
  PainChance "Crush", 256
  PainChance 128
  +FLOORCLIP
  +FASTER
  +MISSILEMORE
  +FASTMELEE
  +LONGMELEERANGE
  -CANUSEWALLS
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  DamageFactor "SS", 0.0
  DamageFactor "Rocket", 0.0
  DamageFactor 0.7
  DropItem "LifeEssence", 200, 8
  DropItem "ArmorBonusMax", 200, 8
  DropItem "MissilePickup", 128, 1
  DropItem "MissilePickup", 128, 1
  DropItem "MissilePickup", 128, 1
  SeeSound "dog/sight"
  DeathSound "dog/death"
  Obituary "$CFRocketDogeObit"
  Tag "$CFRockDoggo"
  var int user_currenthp;
  States
  {
  Spawn:
	PERR E 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PERR Z 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"See")
	Loop
  See:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
  SeeLoop:
	PERR AAAABBBBCCCCDDDD 1 A_Chase
	Loop
  Missile:
  Melee:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIfHealthLower(100,"Avoid")
	TNT1 A 0 A_JumpIfCloser(150,"Avoid2")
	TNT1 A 0 A_JumpIfCloser(500,"Normal")
	TNT1 A 0 A_JumpIfCloser(700,"rawcket")
	TNT1 A 0 A_JumpIfCloser(900,"TripleR")
	PERR E 4 A_FaceTarget
	PERR NO 4
	TNT1 A 0 A_Recoil(-20)
  Normal:
	TNT1 A 0 A_CheckFlag(FRIENDLY,5)
	TNT1 A 0 A_TakeInventory("ProjHitCheck",1)
	TNT1 A 0 A_TakeInventory("ProjMissCheck",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ss-hit-testing",29,0,0,CMF_TRACKOWNER|CMF_CHECKTARGETDEAD)
	PERR EE 4 A_FaceTarget
	TNT1 A 0 A_CheckFlag(FRIENDLY,4)
	TNT1 A 0 A_JumpIfInventory("ProjHitCheck",1,3)
	TNT1 A 0 A_JumpIfInventory("ProjMissCheck",1,"MissileMiss")
	TNT1 A 0 A_Jump(256,"MissileMiss")
	PERR E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DogeMiniRocket",29,0)
	TNT1 A 0 A_Recoil(3)
	PERR E 4 Bright A_FaceTarget
	PERR E 5
	Goto See
  Avoid:
	PERR E 4 A_FaceTarget
	PERR E 8 A_Recoil(15)
	Goto TripleR
  Avoid2:
	PERR E 4 A_FaceTarget
	PERR E 8 A_Recoil(20)
	Goto Normal
  Rawcket:
	TNT1 A 0 A_CheckFlag(FRIENDLY,5)
	TNT1 A 0 A_TakeInventory("ProjHitCheck",1)
	TNT1 A 0 A_TakeInventory("ProjMissCheck",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ss-hit-testing",29,0,0,CMF_TRACKOWNER|CMF_CHECKTARGETDEAD)
	PERR EE 4 A_FaceTarget
	TNT1 A 0 A_CheckFlag(FRIENDLY,4)
	TNT1 A 0 A_JumpIfInventory("ProjHitCheck",1,3)
	TNT1 A 0 A_JumpIfInventory("ProjMissCheck",1,"MissileMiss")
	TNT1 A 0 A_Jump(256,"MissileMiss")
	PERR E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PerroMisil",29,0)
	TNT1 A 0 A_Recoil(5)
	PERR E 4 Bright A_FaceTarget
	PERR E 5
	Goto See
  TripleR:
	TNT1 A 0 A_CheckFlag(FRIENDLY,5)
	TNT1 A 0 A_TakeInventory("ProjHitCheck",1)
	TNT1 A 0 A_TakeInventory("ProjMissCheck",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ss-hit-testing",32,0,0,CMF_TRACKOWNER|CMF_CHECKTARGETDEAD)
	PERR EE 6 A_FaceTarget
	TNT1 A 0 A_CheckFlag(FRIENDLY,4)
	TNT1 A 0 A_JumpIfInventory("ProjHitCheck",1,3)
	TNT1 A 0 A_JumpIfInventory("ProjMissCheck",1,"MissileMiss")
	TNT1 A 0 A_Jump(256,"MissileMiss")
	PERR E 4 Bright A_FaceTarget
	PERR E 1 A_Recoil(5)
	PERR E 2 Bright A_CustomMissile("PerroMisil",29,0)
	PERR E 3 A_Recoil(5)
	PERR E 4
	PERR E 5 A_Recoil(5)
	PERR E 9
	Goto See
  MissileMiss:
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_Recoil(3)
	PERR EEEE 4 A_FaceTarget
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	PERR A 2
	PERR A 2 A_Pain
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"TripleR")
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	Goto See
  Pain.Crush:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_GiveInventory("MonsterAvoid",1)
	PERR A 2
	PERR A 2 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	PERR F 8
	PERR G 8 A_Scream
	PERR H 6 A_Fall
	PERR I -1
	Stop
  XDeath:
	PERR J 8
	PERR K 8 A_Scream
	PERR L 6 A_Fall
	PERR M -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	PERR IHGF 8
	Goto See
  }
}

Actor PerroMisil : Rocket
{
  Projectile
  Speed 26
  Damage (Random(16,32))
  -ROCKETTRAIL
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHARMSPECIES
  DamageType "SS"
  SeeSound "rocket/fire"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckFlag(FRIENDLY,"AltDamage",AAPTR_TARGET)
	TNT1 A 1 A_Jump(256,"Normal")
	Loop
  AltDamage:
	TNT1 A 0 A_SetDamageType("Explosion")
  Normal:
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2)) 
	MIS2 A 1 Bright
	Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(128,128,0)
	TNT1 A 1 A_SpawnItem("RocketEx")
	Stop
  }
}

Actor DogeMiniRocket : ZMiniRocket { DamageType "SS" }