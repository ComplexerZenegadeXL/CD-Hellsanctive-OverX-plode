Actor LegendaryKrieger
{
  Monster
  Scale 1.25
  Health 3000
  Height 80
  Radius 30
  Mass 5000
  Speed 8
  MaxStepHeight 64
  MaxDropOffHeight 64
  Reactiontime 24
  PainChance 64
  PainChance "Crush", 256
  PainChance "Explosion", 100
  PainChance "Mine", 100
  PainChance "NuclearFire", 100
  MeleeRange 150
  +BOSS
  +BOSSDEATH
  +NOICEDEATH
  +NOTIMEFREEZE
  +DONTMORPH
  +DONTRIP
  +NORADIUSDMG
  -NOINFIGHTING
  -NOPAIN
  +NOFEAR
  +NOBLOOD
  +FLOORCLIP
  +NOTARGET
  +LOOKALLAROUND
  //+ALWAYSFAST
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +DONTDRAIN
  +NOTELEFRAG
  Species "SS"
  DamageType "Legendary"
  DamageFactor "SS", 0.0
  DamageFactor 0.5
  DamageFactor "Void", 0
  DamageFactor "BruiserFire", 0
  DamageFactor "Sharp", 0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Ice", 0.2
  DamageFactor "PlayerIce", 0.2
  DamageFactor "Melee", 0.5
  DamageFactor "Crush", 0.1
  DamageFactor "Acid", 0.1
  DamageFactor "Fire", 0.1
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.1
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.01
  DamageFactor "DrainLife", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "Player", 0.3
  DamageFactor "Players", 0.02
  DamageFactor "PyroShot", 0.5
  DamageFactor "PlayerPyro", 0.18
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Explosion", 0.2
  DamageFactor "NuclearFire", 0.01
  DamageFactor "BFG9500Ball", 0.4
  DamageFactor "UpBFG9500Ball", 0.3
  DamageFactor "UpBFGSplash", 0.3
  DamageFactor "PDTBFG", 0.15
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.1
  DamageFactor "PlayerDevBall2", 0.1
  DamageFactor "PlayerDevTracer", 0.30
  DamageFactor "PlayerDBFG2", 0.2
  DamageFactor "PlayerDBFG10K2", 0.2
  DamageFactor "PlayerDBFGSplash2", 0.2
  DamageFactor "PlayerBHole", 0.2
  DamageFactor "PlayerNemesisPlasma", 0.20
  DamageFactor "PlayerNemesisBFG", 0.10
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.1
  DamageFactor "NemesisBeam", 0.2
  DamageFactor "NemesisBall", 0.08
  DamageFactor "Melee", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.05
  DamageFactor "Lightning", 0.3
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  //No Infighting
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LACGrenade", 0.0
  DamageFactor "LSSGGrenade", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "FatFlamer", 0.0
  DropItem "LegendaryBulletBoxPickup", 125
  DropItem "LegendaryArmor", 200
  DropItem "LegendaryAmmoSphere", 93	//infinite ammo #1
  DropItem "SpringMine", 50
  DropItem "PortableMedCell", 256
  DropItem "PortableMedCellPack", 256
  DropItem "ArmorPlate" 256
  DropItem "ArmorPlate" 256
  DropItem "ArmorPlate" 256
  DropItem "AmmoPack", 256
  DropItem "ArmorCharge", 256
  DropItem "Backpack", 256		//infinite ammo #2
  DropItem "LegendaryRandomSphere" 16
  DropItem "LegendaryInvisibilitySphere" 32
  SeeSound "LegKrieger/sight"
  ActiveSound "LegKrieger/Active"
  PainSound "LegKrieger/pain"
  DeathSound "LegKrieger/death"
  Tag "$CFKrieg"
  Obituary "$CFLegendaryKriegerObit"
  HitObituary "$CFLegendaryKriegerHitObit"
  var int user_counter;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
	HIML A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,6)
	TNT1 A 0 ACS_NamedExecuteAlways("BossAI",0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	HIML A 10 Bright A_Look
	Loop
  Idle:
	TNT1 A 0 A_GiveInventory("ResetMonsterInvul",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	HIML AAAA 3 Bright A_Wander
	TNT1 A 0 A_Look
	HIML BBBB 3 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	HIML CCCC 3 Bright A_Wander
	TNT1 A 0 A_Look
	HIML DDDD 3 Bright A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 A_GiveInventory("ResetMonsterInvul",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,808)
	TNT1 A 0 A_SetUserVar("user_music",1)
	HIML AAAABBBB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	HIML CCCCDDDD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	Loop
  Melee:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HIML F 4 Bright A_FaceTarget
	HIML G 1 Bright A_PlaySound("weapons/hsgfire",CHAN_WEAPON,1.0,0)
	HIML G 4 Bright A_PlaySound("weapons/hsgfire",7,1.0,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),24,frandom(-6,6),0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),-24,frandom(-6,6),0)
	TNT1 A 0 A_CustomBulletAttack(15.4,10.6,15,Random(12,14),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	HIML I 4 Bright A_CustomBulletAttack(15.4,10.6,15,Random(5,7),"SSBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_CustomBulletAttack(15.4,10.6,15,Random(12,14),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	HIML I 4 Bright A_CustomBulletAttack(15.4,10.6,15,Random(5,7),"SSBulletPuff",0,CBAF_NORANDOM)
	HIML FF 5 Bright A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,-24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	HIML F 5 A_FaceTarget
	Goto See
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON)
	HIML FFFFF 7 Bright A_FaceTarget
  Refire:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",5)
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON,1.0,0)
	HIML H 1 A_CustomMissile("Legendary10KProjectile",62,-18,frandom(-8,4),CMF_TRACKOWNER)
	HIML H 1 A_CustomMissile("MonsterExplosiveTracer2",frandom(36,44),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",10,24,40,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	HIML H 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",6)
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON,1.0,0)
	HIML H 1 A_CustomMissile("Legendary10KProjectile",62,18,frandom(-8,-4),CMF_TRACKOWNER)
	HIML H 1 A_CustomMissile("MonsterExplosiveTracer2",frandom(36,44),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing",10,-24,40,frandom(2,6),0,frandom(1,3),frandom(-80,-90),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	HIML J 1 Bright A_FaceTarget
	TNT1 A 0 A_MonsterRefire(230,"MissileEnd")
	TNT1 A 0 A_JumpIfCloser(400,"Melee")
	Loop
  MissileEnd:
	HIML FFFF 5 Bright A_Facetarget
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_Pain
	HIML E 6 Bright
	Goto See
  Death:
	HIML A 35 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_PlaySound("DeathKnight/step",5,1.0,0)
	HIML E 105 A_Scream
	HIML E 4 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HIML K 4 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_PlaySound("DeathKnight/step",6,1.0,0)
	HIML L 4 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HIML M 4 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	TNT1 A 0 A_SpawnItemEx("HFItemRandomizer",0,0,12,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	TNT1 A 0 A_DropItem("LegendaryDust",random(5,10),256)
	TNT1 A 0 A_BossDeath
	TNT1 A 0 A_RemoveChildren
	TNT1 A 0 A_SpawnItemEx("PowerStimpack",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,32)
	TNT1 A 0 A_SpawnItemEx("AmmoSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,32)
	HIML N -1
	Stop
  }
}