Actor SSSuperSoldierPyroCannon 30330
{
  Monster
  Health 1500
  Height 64
  Radius 24
  Scale 1.25
  Mass 5000
  Speed 8
  PainChance 20
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  DamageFactor "SS", 0.0
  DamageFactor "PlayerPyro", 0.05
  RadiusDamageFactor 0.25
  DropItem "PortableMedCell", 200, 1
  DropItem "PortableMedkit", 200
  DropItem "ArmorPlate", 200
  DropItem "HandGrenadeAmmo", 200, 1
  DropItem "MineAmmoRandomizer", 200, 1
  DropItem "AmmoPack", 150
  DropItem "ExtraArmor" 256 1
  DropItem "PyroCannon", 32
  DropItem "BigGasPickup", 200
  SeeSound "supersoldier/see"
  PainSound "supersoldier/pain"
  DeathSound "supersoldier/death"
  ActiveSound "supersoldier/idle"
  Obituary "$CFSSSuperSoldierPyroCannonObit"
  Tag "$CFSuperSold"
  States
  {
  Spawn:
	HNS2 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HNS2 A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	HNS2 AAAABBBB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	HNS2 CCCCDDDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
	Loop
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_CheckFlag(FRIENDLY,6)
	TNT1 A 0 A_TakeInventory("ProjHitCheck",1)
	TNT1 A 0 A_TakeInventory("ProjMissCheck",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ss-hit-testing",40,20,0,CMF_TRACKOWNER|CMF_CHECKTARGETDEAD)
	TNT1 A 0 A_CustomMissile("ss-hit-testing",40,-20,0,CMF_TRACKOWNER|CMF_CHECKTARGETDEAD)
	HNS2 EEEE 5 A_FaceTarget
	TNT1 A 0 A_CheckFlag(FRIENDLY,"PyroCannon")
	TNT1 A 0 A_JumpIfInventory("ProjHitCheck",1,"PyroCannon")
	TNT1 A 0 A_JumpIfInventory("ProjMissCheck",1,"See")
	TNT1 A 0 A_Jump(256,"See")
  PyroCannon:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HNS2 EEEEEEEF 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/PCNNF",CHAN_WEAPON)
	HNS2 G 4 Bright A_CustomMissile("SSPyroShot",40,20,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSPyroShot",40,-20,0,CMF_TRACKOWNER)
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam",6)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	HNS2 E 20 Bright A_SpawnItemEx("LegendaryCannonSmoke",40,20,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryCannonSmoke",40,-20,0)
	HNS2 E 20 Bright A_SpawnItemEx("LegendaryCannonSmoke",40,20,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryCannonSmoke",40,-20,0)
	HNS2 E 20 Bright A_SpawnItemEx("LegendaryCannonSmoke",40,20,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryCannonSmoke",40,-20,0)
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	HNS2 E 6 A_Pain
	TNT1 A 0 A_Jump(48,"PainAttack")
	Goto See
  PainAttack:
	TNT1 A 0 A_JumpIfTargetInLos("PyroCannon",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	HNS2 P 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HNS2 Q 5 A_ScreamAndUnblock
	HNS2 R 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HNS2 S 5 A_BossDeath
	HNS2 TU 5
	HNS2 V -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	HNS2 VUTSRQP 5
	Goto See
  }
}

Actor SSPyroShot : RSTPyroShot
{
  Species "SS"
  DamageType "SS"
  States
  {
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,135,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,225,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SSFuelExplosion01",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_Mushroom("SSMushroomFireballs",8,MSF_STANDARD|MSF_DONTHURT)
	TNT1 A 0 A_Explode(1500,486,0,1)
	HFBA DEFGHIJKLMN 1 Bright
	TNT1 A 25 A_SpawnItemEx("PyroShotEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor SSFuelExplosion01 : RSTFuelExplosion01
{
  Species "SS"
  DamageType "SS"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAA 4 A_SpawnItemEx("SSFuelExplosion02",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	Stop
  }
}

Actor SSFuelExplosion02 : RSTFuelExplosion02 { Species "SS" DamageType "SS" }

Actor SSMushroomFireballs : RSTMushroomFireballs
{
  Species "SS"
  DamageType "SS"
  States
  {
  Death:
	TNT1 A 0 A_Explode(160,192,0)
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch",0,0,0,0,0,0,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("OrangeParticleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,random(0,360))
	TNT1 A 0 A_SpawnItemEx("SSSuperMeteor_m_Explosion",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	EXPL A 0 Radius_Quake(15,20,0,20,0)
	TNT1 AAAA 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke",0,0,0,frandom(-1.25,1.25), frandom(-1.25,1.25),frandom(0.25,2.45),0,SXF_CLIENTSIDE,0)
	BOOM ABCDEFGHIJKLMNOP 2 Bright
	Stop
  }
}

Actor SSSuperMeteor_m_Explosion : SuperMeteor_m_Explosion
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +NONETID
}