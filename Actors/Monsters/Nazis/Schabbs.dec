  DamageFactor "Legendary1", 0.0
  DamageFactor "HFCyber", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PlayerHellfire", 0.05
  DamageFactor "LegendaryPlayer", 0.15
  DamageFactor "LegendaryGuruPlayer", 0.05
  DamageFactor "PlayerNemesis", 0.30
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "PlayerNemesisBFG", 0.15
  DamageFactor "Fire", 0.1
  DamageFactor "Ice", 0.1
  DamageFactor "PlayerIce", 0.2
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.1
  DamageFactor "PoisonCloud", 0.1
  DamageFactor "Crush", 0.1
  DamageFactor "Electric", 0.1
  DamageFactor "Disintegrate", 0.1
  DamageFactor "NuclearFire", 0.5
  DamageFactor "Explosion", 0.5
  DamageFactor "Mine", 0.25
  DamageFactor "Extreme", 0.1
  DamageFactor "PDTPuff", 0.4
  DamageFactor "Player", 0.1
  DamageFactor "PyroShot", 0.1
  DamageFactor "PlayerBHole", 0.10
  DamageFactor "PlayerDBFG", 0.15
  DamageFactor "PlayerDBFG2", 0.15
  DamageFactor "PlayerDBFG10K2", 0.15
  DamageFactor "PlayerDBFGSplash2", 0.15
  DamageFactor "PDTBFG", 0.2
  DamageFactor "PDTBFGTracer", 0.1
  DamageFactor "PlayerDevBall", 0.1
  DamageFactor "PlayerDevBall2", 0.10
  DamageFactor "Players", 0.2
  DamageFactor "PlayerDevTracer", 0.1
  DamageFactor "DBFG2", 0.015
  DamageFactor "DBFG10K2", 0.015
  DamageFactor "DBFGSplash2", 0.015
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "SuperWeapon", 0.05
  DamageFactor "DiscoBFG", 0.4
  DamageFactor "RailG", 0.9
  DamageFactor "Normal", 0.8
  DamageFactor "None", 0.5
  DamageFactor "Marine", 0.75
  DamageFactor "NemesisBeam", 0.25
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Lightning", 0.5
  DamageFactor 0.75
  RadiusDamageFactor 0.5
  DropItem "PortableMedCell", 256
  DropItem "PortableMedkit", 256
  DropItem "ArmorBooster", 256
  DropItem "ArmorBooster", 256
  DropItem "ArmorBooster", 256
  DropItem "ArmorBooster", 256
  DropItem "ArmorPlate", 256
  DropItem "ArmorPlate", 256
  DropItem "BossLifeEssence", 256
  DropItem "BossLifeEssence", 256
  DropItem "BossLifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "LifeEssence", 256
  DropItem "PowerStimpack", 256
  DropItem "ShieldSphere", 256
  SeeSound "Schabbs/See"
  ActiveSound "Schabbs/Active"
  PainSound "Schabbs/Pain"
  DeathSound "Schabbs/Death"
  Obituary "$CFSchabbsObit"
  Tag "$CFSchabbs"
  var int user_music;
  var int user_heal;
  var int user_loop;
  var int user_loop2;
  States
  {
  Spawn:
	SBBS A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_GiveInventory("SchabbsSpawnAmount",2)
  SpawnLoop:
	SBBS A 10 A_Look
	Loop
  Idle:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_SetUserVar("user_music",0)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS AA 6 A_Wander
	TNT1 A 0 A_Look
	SBBS BB 6 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS CC 6 A_Wander
	TNT1 A 0 A_Look
	SBBS DD 6 A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,800)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_CheckFlag(FRIGHTENED,"See2Loop")
	//TNT1 A 0 A_JumpIfTargetInLOS(2,90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	//TNT1 A 0 A_Jump(256,2)
	SBBS AABB 3 A_Chase("","Missile")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS CCDD 3 A_Chase("","Missile")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfInTargetInventory("D-BFG",1,"See2")
	TNT1 A 0 A_JumpIfInTargetInventory("Nemesis",1,"See2")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.30),"See2")
	TNT1 A 0 A_JumpIfInventory("Tic",88,"PainSummon")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  See2:
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,1)
  See2Loop:
	//TNT1 A 0 A_JumpIfInTargetLOS(3,45,JLOSF_DEADNOJUMP,500)
	//TNT1 A 0 A_JumpIfTargetInLOS(2,90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,600,0)
	//TNT1 A 0 A_Jump(256,2)
	SBBS AABB 3 A_Chase("","Missile")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS CCDD 3 A_Chase("","Missile")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	TNT1 A 0 A_JumpIfInventory("Tic",88,"PainSummon")
	TNT1 A 0 A_GiveInventory("Tic",2)
	Loop
  Missile:
	SBBS E 1 A_ChangeFlag(NOPAIN,0)
	SBBS EE 5 A_FaceTarget
	// I don't like the ss-hit-testing behaviour 
	TNT1 A 0 A_JumpIfInventory("SchabbsSpawnAmount",1,2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_Jump(64,"Summon")
	TNT1 A 0 A_PlaySound("Schabbs/Attack",CHAN_WEAPON)
	SBBS F 6 A_CustomMissile("PoisonSyringe",32,12,frandom(-1,1),CMF_TRACKOWNER)
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("Schabbs/Attack",CHAN_WEAPON)
	SBBS F 6 A_CustomMissile("PoisonSyringe",32,12,frandom(-1,1),CMF_TRACKOWNER)
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("Schabbs/Attack",CHAN_WEAPON)
	SBBS F 6 A_CustomMissile("PoisonSyringe",32,12,frandom(-1,1),CMF_TRACKOWNER)
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("Schabbs/Attack",CHAN_WEAPON)
	SBBS F 6 A_CustomMissile("PoisonSyringe",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See //why the fuck no Goto See at the end of the states??
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(64,"NoPainShield")
	TNT1 A 0 A_Jump(64,"PainMissile")
	TNT1 A 0 A_Jump(256,"See")
  PainShield:
	TNT1 A 0 A_GiveInventory("SuperZombieShieldSphere",1)
  NoPainShield:
	SBBS P 6 A_Pain
	TNT1 A 0 A_Jump(128,"PainMissile")
	TNT1 A 0 A_CheckFlag(FRIGHTENED,"PainSummon")
	TNT1 A 0 A_JumpIfInventory("SchabbsSpawnAmount",1,2)
	TNT1 A 0 A_Jump(256,"See")
	TNT1 A 0 A_Jump(256,"Summon")
	Goto See
  PainMissile:
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("Schabbs/Attack",CHAN_WEAPON)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainMissileLoop:
	SBBS F 6
	TNT1 A 0 A_CustomMissile("PoisonSyringe",32,12,-16,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PoisonSyringe",32,12,-8,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PoisonSyringe",32,12,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PoisonSyringe",32,12,8,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PoisonSyringe",32,12,16,CMF_TRACKOWNER)
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto PainMissileLoop
	TNT1 A 0 A_Jump(26,"PainSummon")
	Goto See
  Summon:
	SBBS E 4 A_FaceTarget
	TNT1 A 0 A_JumpIfInventory("SchabbsSpawnAmount",1,1)
	Goto See
	TNT1 A 0 A_Jump(256,"Summon1","Summon1","Summon2")
	Goto See
  PainSummon:
	TNT1 A 0 A_JumpIfInventory("Tic",100,2)
	TNT1 A 0 A_JumpIfInventory("SchabbsSpawnAmount",2,2)
	Goto See
	TNT1 A 0 A_TakeInventory("Tic",100)
	TNT1 A 0 A_Jump(256,"Summon3","Summon3","Summon4","Summon5")
	Goto See
  Summon1:
	TNT1 A 0 A_TakeInventory("SchabbsSpawnAmount",1)
	TNT1 A 0 A_CustomMissile("SchabbsMutantSpawner",32,12,frandom(-1,1),CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SchabbsMutantSpawner",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See
  Summon2:
	TNT1 A 0 A_TakeInventory("SchabbsSpawnAmount",1)
	TNT1 A 0 A_CustomMissile("SchabbsRocketDogeSpawner",32,12,frandom(-1,1),CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("SchabbsRocketDogeSpawner",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See
  Summon3:
	TNT1 A 0 A_TakeInventory("SchabbsSpawnAmount",2)
	TNT1 A 0 A_CustomMissile("SSSuperSoldierSpawner",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See
  Summon4:
	TNT1 A 0 A_TakeInventory("SchabbsSpawnAmount",2)
	TNT1 A 0 A_CustomMissile("SSSuperSoldierPCSpawnerSH",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See
  Summon5:
	TNT1 A 0 A_TakeInventory("SchabbsSpawnAmount",2)
	TNT1 A 0 A_CustomMissile("SSUberSoldatSpawnerSH",32,12,frandom(-1,1),CMF_TRACKOWNER)
	Goto See
  Death:
	"####" "#" 53 A_Scream
	SBBS GH 6
	SBBS I 6 A_NoBlocking
	SBBS A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BossDeath
	SBBS J -1
	Stop
  XDeath:
	SBBS G 6 A_XScream
	SBBS H 6 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	SBBS I 6 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BossDeath
	SBBS J -1
	Stop
  }
}

Actor PoisonSyringe
{
  Projectile
  Height 4
  Radius 2
  Speed 30
  FastSpeed 33
  Mass 1
  Gravity 0.01
  ReactionTime 44
  BounceType "Doom"
  BounceCount 2
  Damage (Random(30,90))
  PoisonDamage 5, 10, 10
  +ADDITIVEPOISONDAMAGE
  +ADDITIVEPOISONDURATION
  +NOTIMEFREEZE
  -NOGRAVITY
  +SEEKERMISSILE
  +DOOMBOUNCE
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +HITMASTER
  Species "SS"
  DamageType "SS"
  BounceSound "syringe/bounce"
  States
  {
  Spawn:
	PSYR ABCDEF 1
	TNT1 A 0 A_Countdown
	Loop
  Crash:
	TNT1 A 0 A_PlaySound("syringe/crash")
	TNT1 AAAAA 0 A_SpawnItemEx("SchabbsPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 ACS_NamedExecuteWithResult("SchabbsStuff")
	PSYR A 1 A_GiveInventory("SchabbsTaunt1",1,AAPTR_TARGET)
	Stop
  Death:
	TNT1 A 0 A_PlaySound("None")
	TNT1 AAAAA 0 A_SpawnItemEx("SchabbsPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 ACS_NamedExecuteWithResult("SchabbsStuff")
	PSYR A 1 A_GiveInventory("SchabbsTaunt2",1,AAPTR_TARGET)
	Stop
  XDeath:
	TNT1 A 0 A_PlaySound("None")
	TNT1 AAAAA 0 A_SpawnItemEx("SchabbsPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 ACS_NamedExecuteWithResult("SchabbsStuff")
	PSYR A 1 A_GiveInventory("SchabbsTaunt3",1,AAPTR_TARGET)
	Stop
  }
}

