Actor Schabbs 30366
{
  Monster
  Health 5000
  GibHealth 4000
  Height 60
  Radius 20
  Mass 200
  Speed 8
  PainChance 190
  MinMissileChance 64
  +BOSS
  +BOSSDEATH
  +DONTMORPH
  +NOTIMEFREEZE
  +FLOORCLIP
  +LOOKALLAROUND
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +AVOIDMELEE
  +NEVERRESPAWN
  +CANTSEEK
  +THRUSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +NOTELEFRAG
  +NOICEDEATH
  Species "SS"
  DamageType "SS"
  DamageFactor "SS", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
