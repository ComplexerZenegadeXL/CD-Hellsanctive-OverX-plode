Actor SSUberSoldat
{
  Monster
  Health 2000
  Height 82
  Radius 24
  Scale 1.25
  Mass 5000
  Speed 8
  MeleeRange 150
  PainChance 20
  PainChance "Crush", 256
  ReactionTime 24
  +NOBLOOD
  +NOTARGET
  +DONTRIP
  +ALWAYSFAST
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  DamageFactor "SS", 0.0
  DamageFactor "PlayerPyro", 0.05
  DamageFactor "ModdedBulletPuff", 0.05
  RadiusDamageFactor 0.2
  DropItem "PortableMedCell", 200, 1
  DropItem "PortableMedkit", 200
  DropItem "ArmorPlate", 200
  DropItem "HandGrenadeAmmo", 200, 1
  DropItem "MineAmmoRandomizer", 200, 1
  DropItem "AmmoPack", 150
  DropItem "ExtraArmor" 256 1
  DropItem "NewShellBoxPickup", 200, 50
  DropItem "NewShellBoxPickup", 200, 50
  DropItem "NewShellPickup", 256, 8
  SeeSound ""
  PainSound "UberSoldat/Pain"
  DeathSound "supersoldier/death"
  ActiveSound "supersoldier/idle"
  Obituary "$CFSSUberSoldatObit"
  Tag "$CFUberS"
  var int user_attack;
  States
  {
  Spawn:
	HNS3 A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  SpawnLoop:
	HNS3 A 10 A_Look
	Loop
  Idle:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 HealThing(1)
	HNS3 AAAA 3 A_Wander
	TNT1 A 0 A_Look
	HNS3 BBBB 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	HNS3 CCCC 3 A_Wander
	TNT1 A 0 A_Look
	HNS3 DDDD 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	Loop
  See:
	HNS3 H 10 A_PlaySound("UberSoldat/See",CHAN_VOICE,1.0,0,ATTN_IDLE)
	TNT1 A 0 A_Jump(128,2)
	HNS3 H 10
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	Goto SeeLoop
  SeeLoop:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	HNS3 AAAABBBB 3 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	HNS3 CCCCDDDD 3 A_Chase
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	Loop
  See2:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_JumpIf(user_attack < 1,"SeeLoop2")
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	Goto SeeLoop2
  SeeLoop2:
	HNS3 AAAA 2 A_Chase("Melee","",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_JumpIfTargetInLOS("Missile",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,1000,200)
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	HNS3 BBBB 2 A_Chase("Melee","",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_JumpIfTargetInLOS("Missile",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,1000,200)
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	HNS3 CCCC 2 A_Chase("Melee","",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_JumpIfTargetInLOS("Missile",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,1000,200)
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	HNS3 DDDD 2 A_Chase("Melee","",CHF_NOPLAYACTIVE)
	TNT1 A 0 A_JumpIfTargetInLOS("Missile",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,1000,200)
	TNT1 A 0 A_JumpIfInTargetLOS("Avoid",360,JLOSF_DEADNOJUMP,1000)
	TNT1 A 0 A_SpawnItemEx("DeathKnightStep",0,0,5,0,0,-20)
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_JumpIfInventory("Tic",10,"SeeLoop")
	Loop
  Melee:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_attack",1)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",6,1.0,0)
	HNS3 E 5 A_FaceTarget(45)
	TNT1 AAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),0,frandom(-6,6),0)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",CHAN_BODY,1.0,0)
	TNT1 A 0 A_PlaySound("weapons/sshotf",5,1.0,0)
	TNT1 AAAA 0 A_CustomBulletAttack(22.5,18.3,4,Random(10,20),"SSBulletPuff",2048,CBAF_NORANDOM)
	TNT1 AAAA 0 A_CustomBulletAttack(11.25,9,3,Random(10,26),"SSBulletPuff",2048,CBAF_NORANDOM)
	HNS3 F 4 Bright A_FaceTarget
	TNT1 AAAA 0 A_SpawnItemEx("ShellCasing",10,24,40,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_SpawnItemEx("ShellCasing",10,-24,40,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HNS3 G 4 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	HNS3 EE 3 A_FaceTarget
	Goto SeeLoop
  Missile:
	TNT1 AAA 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_SetUserVar("user_attack",1)
	TNT1 A 0 A_PlaySound("csgun/windup",CHAN_WEAPON,1.0,0)
	HNS3 EEEE 5 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	//TNT1 A 0 A_CheckFlag("FRIENDLY","Refire")
	//TNT1 A 0 A_CheckLOF("Refire",CLOFF_JUMPENEMY|CLOFF_MUSTBESHOOTABLE,8192)//Causes out-of-sync on-line. Bow and congratulations to the nitwit zandronum's developers!
	//TNT1 A 0 A_CheckLOF("Pause",CLOFF_JUMP_ON_MISS|CLOFF_SKIPNONHOSTILE,8192)//Causes out-of-sync on-line. Bow and congratulations to the nitwit zandronum's developers!
	//Goto See2
  Refire:
	TNT1 A 0 A_PlaySound("HeavyChaingun/Loop",CHAN_WEAPON,1.0,1)
	TNT1 A 0 A_FaceTarget
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),0,frandom(-6,6),0)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",10,24,40,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",CHAN_BODY,1.0,0)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(10,20),"SSBulletPuff",2048,CBAF_NORANDOM)
	HNS3 F 4 Bright A_CustomBulletAttack(11.25,9,3,Random(10,26),"SSBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_FaceTarget
	TNT1 AAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),0,frandom(-6,6),0)
	TNT1 A 0 A_SpawnItemEx("ShellCasing",10,-24,40,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",CHAN_BODY,1.0,0)
	TNT1 A 0 A_CustomBulletAttack(22.5,18.3,4,Random(10,20),"SSBulletPuff",2048,CBAF_NORANDOM)
	HNS3 G 4 Bright A_CustomBulletAttack(11.25,9,3,Random(10,26),"SSBulletPuff",2048,CBAF_NORANDOM)
	TNT1 A 0 A_MonsterRefire(0,"MissileEnd")
	TNT1 A 0 A_Jump(1,"Pause")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_JumpIfInventory("Tic",50,"Pause")
	Loop
  MissileEnd:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_Jump(64,2)
	TNT1 A 0 A_PlaySound("UberSoldat/Taunt",6,1.0,0,ATTN_IDLE)
	HNS3 EE 3 A_FaceTarget
	Goto SeeLoop
  Pause:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	TNT1 A 0 A_Jump(256,1,2,3,4,5)
	HNS3 EEEEE 6 A_FaceTarget(45)
	Goto See2
  Avoid:
	TNT1 A 0 A_Jump(256,"AvoidLeft","AvoidRight")
	Goto AvoidLeft
  AvoidLeft:
	HNS3 E 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	TNT1 A 0 ThrustThing(angle*256/360+192,15,0,0)
	HNS3 E 5 A_FaceTarget
	TNT1 A 0 A_CheckSight("SeeLoop2")
	TNT1 A 0 A_JumpIfTargetInLos("Missile",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	TNT1 A 0 A_Jump(128,"SeeLoop")
	Goto Missile
  AvoidRight:
	HNS3 E 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	TNT1 A 0 ThrustThing(angle*256/360+64,15,0,0)
	HNS3 E 5 A_FaceTarget
	TNT1 A 0 A_CheckSight("SeeLoop2")
	TNT1 A 0 A_JumpIfTargetInLos("Missile",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	TNT1 A 0 A_Jump(128,"SeeLoop")
	Goto Missile
  Pain:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_attack > 0,"WeapodDown")
	HNS3 I 6 A_Pain
	Goto Avoid
  WeapodDown:
	TNT1 A 0 A_SetUserVar("user_attack",0)
	TNT1 A 0 A_PlaySound("HeavyChaingun/Down",CHAN_WEAPON,1.0,0)
	HNS3 I 6 A_Pain
	Goto SeeLoop
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	TNT1 A 0 A_StopSound(CHAN_WEAPON)
	HNS3 J 5 A_ScreamAndUnblock
	HNS3 K 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HNS3 L 5 A_PlaySound("DeathKnight/step",5,1.0,0)
	TNT1 A 0 A_BossDeath
	HNS3 M -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	HNS3 MLKJ 5
	Goto See
  }
}