	TNT1 A 0 A_SetUserVar("user_loop",0)
  DoubleHexaLoop:	
	TNT1 A 0 A_JumpIf(user_loop >= random(4,6),"See") //See
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DTKN E 5 A_FaceTarget
	DTKN E 1 A_PlaySound("weapons/hsgfire",CHAN_WEAPON,1.0,0)
	DTKN E 4 A_PlaySound("weapons/hsgfire",7,1.0,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),24,frandom(-6,6),0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),-24,frandom(-6,6),0)
	DTKN H 1 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff",8192,CBAF_NORANDOM)
	DTKN H 4 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff",8192,CBAF_NORANDOM)
	DTKN EE 5 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,-24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTKN E 5 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Jump(192,3)
	TNT1 A 0 A_PlaySound("DeathKnight/taunt1",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_SetUserVar("user_taunt",0)
	TNT1 A 0 A_SetUserVar("user_loop", user_loop + 1)
	Goto DoubleHexaLoop //See
  DoubleHexa2:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DTKN E 5 A_FaceTarget
	DTKN E 1 A_PlaySound("weapons/hsgfire",CHAN_WEAPON,1.0,0)
	DTKN E 4 A_PlaySound("weapons/hsgfire",7,1.0,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),24,frandom(-6,6),0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),-24,frandom(-6,6),0)
	DTKN H 1 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN H 4 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN E 10 A_FaceTarget	
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,-24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	DTKN E 5
	Goto See
  DoubleHexaTaunt:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DTKN E 5 A_FaceTarget
	DTKN E 1 A_PlaySound("weapons/hsgfire",CHAN_WEAPON,1.0,0)
	DTKN E 4 A_PlaySound("weapons/hsgfire",7,1.0,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),24,frandom(-6,6),0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),-24,frandom(-6,6),0)
	DTKN H 1 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN H 4 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN E 10 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,24,40,frandom(2,4),frandom(-3,-6),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,-24,40,frandom(2,4),frandom(-3,-6),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTKN E 5 A_FaceTarget
	DTKN E 1 A_PlaySound("weapons/hsgfire",CHAN_WEAPON,1.0,0)
	DTKN E 4 A_PlaySound("weapons/hsgfire",CHAN_AUTO,1.0,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),24,frandom(-6,6),0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",frandom(36,44),-24,frandom(-6,6),0)
	DTKN H 1 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN H 4 Bright A_CustomBulletAttack(15.4,10.6,30,Random(10,20),"SSBulletPuff")
	DTKN E 10 A_FaceTarget
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("SSGShellCasing",10,-24,40,frandom(2,4),frandom(-6,-3),frandom(3,6),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	DTKN E 5 A_FaceTarget
	TNT1 A 0 A_JumpIfInventory("MarineKilled",1,"Rekt")
	TNT1 A 0 A_Jump(100,3)
	TNT1 A 0 A_PlaySound("DeathKnight/taunt2",CHAN_VOICE,1.0,0)
	TNT1 A 0 A_SetUserVar("user_taunt",0)
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	Goto See
  Rekt:
	DTKN E 1 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_TakeInventory("MarineKilled",1)
	DTKN E 6 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/taunt",CHAN_VOICE,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_taunt",0)
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	TNT1 A 0 A_JumpIf((user_currenthp - Health) > 100,"PainAttack")
	DTKN E 7 A_FaceTarget
	Goto See
  GoBack:
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	DTKN P 10 A_Recoil(20)
	Goto DoubleHexaTaunt
  PainAttack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	DTKN P 10 A_Recoil(-20)
	TNT1 A 0 A_SetUserVar("user_taunt",1)
	Goto DoubleHexa
  PainAttack2:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	DTKN P 10 A_Recoil(-20)
	Goto DoubleHexa
  Avoid:
	TNT1 A 0 A_Jump(192,"AvoidLeft","AvoidRight")
	DTKN P 20 A_Recoil(-40)
	TNT1 A 0 A_Jump(192,"AvoidLeft","AvoidRight")
	TNT1 A 0 A_SetUserVar("user_taunt",1)
	Goto DoubleHexa
  AvoidLeft:
	DTKN E 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	TNT1 A 0 ThrustThing(angle*256/360+192,8,0,0)
	DTKN E 5 A_FaceTarget
	TNT1 A 0 A_Jump(48,"DoubleHexa","FireDeathKnight15KLoop")
	Goto Missile
  AvoidRight:
	DTKN E 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("DeathKnight/jump",CHAN_BODY,1.0,0)
	TNT1 A 0 ThrustThing(angle*256/360+64,8,0,0)
	DTKN E 5 A_FaceTarget
	TNT1 A 0 A_Jump(48,"DoubleHexa","FireDeathKnight15KLoop")
	Goto Missile
  Pain.Crush:
	TNT1 A 0 A_Recoil(-20)
	DTKN Q 8 A_Pain
	TNT1 A 0 A_SetUserVar("user_taunt",0)
	Goto See
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DTKN Q 8 A_Pain
	TNT1 A 0 A_SetUserVar("user_taunt",0)
	Goto Avoid
  Death:
	DTKN I 35 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_PlaySound("DeathKnight/step",5,1.0,0)
	DTKN J 105 A_Scream
	DTKN K 4 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	DTKN L 4 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_PlaySound("DeathKnight/step",6,1.0,0)
	DTKN M 4 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	DTKN N 4 A_Fall
	TNT1 A 0 A_BossDeath
	TNT1 A 0 A_RemoveChildren
	TNT1 A 0 A_SpawnItemEx("AmmoSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,32)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	TNT1 A 0 ACS_NamedExecuteAlways("DropDeathNote",0)
	DTKN O -1
	Stop
  }
}

Actor SSCustomSpray : CustomSpray
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  Species "SS"
  DamageType "SS"
}

Actor DeathKnight15k
{
  Projectile
  Height 15
  Radius 15
  Speed 35
  Scale 0.5
  RenderStyle Add
  Alpha 0.75
  Damage (Random(50,80)) //20
  +RANDOMIZE
  +FORCERADIUSDMG
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
	BFS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE1 A 4 Bright A_Explode(100,162)
	BFE1 BCDEF 4 Bright
	Stop
  }
}

Actor DeathKnight10K : FastProjectile
{
  Projectile
  Height 1
  Radius 1
  Speed 100
  Scale 0.15
  RenderStyle Add
  Alpha 0.85
  +NOEXTREMEDEATH
  +THRUSPECIES
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  DeathSound "weapons/bfg95explode"
  Obituary "$CFDeathKnight10KObit"
  States
  {
  Spawn:
	TRA2 A 10 Bright
	Loop
  Death:
  XDeath:
	TNT1 A 1 A_SpawnItemEx("DeathKnight10KEx",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	Stop
  }
}

Actor DeathKnight10KEx
{
  Height 8
