	TNT1 AAAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE1 A 4 Bright A_Explode(64,64)
	BFE1 BCDEF 4 Bright
	Stop
  }
}

Actor BaseHMissile : Rocket
{
  Speed 18
  Damage (Random(30,60))
  ReactionTime 210
  -ROCKETTRAIL
  +THRUSPECIES
  +SEEKERMISSILE
  +DONTHARMSPECIES
  Species "SS"
  DamageType "SS"
  SeeSound "rocket/fire"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2))
	MIS2 A 1 Bright A_SeekerMissile(25,35,SMF_PRECISE,0)
	TNT1 A 0 A_JumpIfTargetInLOS("SeekFly",360,JLOSF_PROJECTILE)
	Goto NoSeekFly
  SeekFly:
	TNT1 A 0 A_JumpIfTracerCloser(250,"Precise")
	Goto Spawn
  Precise:
	TNT1 A 0 A_FaceTracer
	Goto Spawn
  NoSeekFly:
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2))
	MIS2 A 1 Bright
	TNT1 A 0 A_JumpIfTargetInLOS("Spawn",360,JLOSF_PROJECTILE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(Damage*random(2,3),Damage*4,0)
	TNT1 A 1 A_SpawnItemEx("RocketEx")
	Stop
  }
}

Actor SSMissile : BaseHMissile
{
  DeathType "Extreme"
  Obituary "$CFSSMissileObit"
}

Actor "ss-hit-testing" : FastProjectile
{
  Height 1
  Radius 1
  Speed 1000
  Renderstyle None
  Damage (0)
  +PAINLESS
  +THRUGHOST
  +NODAMAGETHRUST
  +BLOODLESSIMPACT
  +DONTREFLECT
  +THRUSPECIES
  +MTHRUSPECIES
  Species "SS"
  DamageType "SS"
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 1 A_GiveToTarget("ProjMissCheck",1)
	Stop
  Crash:
  XDeath:
	TNT1 A 1 A_GiveToTarget("ProjHitCheck",1)
	Stop
  }
}