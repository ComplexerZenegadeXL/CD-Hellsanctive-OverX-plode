Actor SSRocketMan
{
  Health 400
  Radius 20
  Height 64
  Mass 200
  Speed 8
  PainChance 190
  Monster
  +FLOORCLIP
  +LOOKALLAROUND
  +DONTHARMSPECIES
  DropItem "PortableMedkit" 120
  DropItem "ArmorPlate" 120
  DropItem "AmmoPack" 80
  DropItem "MissilePickup" 128 5
  DropItem "HandGrenadeAmmo" 196 1
  DropItem "MineAmmoRandomizer" 100 1
  Species "SS"
  DamageFactor "SS", 0.0 
  SeeSound "guard/sight"
  DeathSound "guard/death"
  PainSound "monsters/nazipain"
  Obituary "$CFSSRocketManObit"
  Tag "$CFSSRock"
  States
  {
  Spawn:
    OTTO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	OTTO A 10 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    OTTO AAAABBBB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    OTTO CCCCDDDD 3 A_Chase
    Loop
  Missile:
    OTTO E 10 A_FaceTarget
    OTTO F 6 Bright A_CustomMissile("SSRocket",32,12,frandom(-1,1))
    OTTO E 4 A_FaceTarget
	OTTO F 6 Bright A_CustomMissile("SSRocket",32,12,frandom(-1,1))
    OTTO E 4 A_FaceTarget
	OTTO F 6 Bright A_CustomMissile("SSRocket",32,12,frandom(-1,1))
    OTTO E 4 A_FaceTarget
	OTTO F 6 Bright A_CustomMissile("SSRocket",32,12,frandom(-1,1))
    OTTO E 4 A_FaceTarget
	OTTO F 6 Bright A_CustomMissile("SSRocket",32,12,frandom(-1,1))
    OTTO E 4 A_FaceTarget
    Goto See
  Pain:
    OTTO G 3
    OTTO G 3 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    OTTO H 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    OTTO I 5 A_Scream
    OTTO J 5 A_NoBlocking
    OTTO K -1 
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    OTTO JIHG 5
    Goto See
  }
}

Actor SSRocket : CadaverRocket
{
  Damage (Random(15,25)) //5
  Speed 24
  FastSpeed 32
  -SEEKERMISSILE
  DamageType "SS"
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(18,128)
    TNT1 A 1 A_SpawnItemEx("RocketEx")
    Stop
  }
}

Actor SSBulletPuff : ModdedBulletPuff { Species "SS" DamageType "SS" }

Actor SSSuperSoldier
{
  Scale 1.25
  Health 1100
  Radius 24
  Height 82
  Mass 5000
  Speed 8
  PainChance 20
  Monster
  +FLOORCLIP
  +LOOKALLAROUND
  +DONTHARMSPECIES
  +MISSILEMORE
  +MISSILEEVENMORE
  Species "SS"
  DamageFactor "SS", 0.0
  RadiusDamageFactor 0.5
  DropItem "BulletBoxPickup" 256 50
  DropItem "PortableMedkit" 200
  DropItem "ArmorPlate" 200
  DropItem "HandGrenadeAmmo" 200 1
  DropItem "MineAmmoRandomizer" 200 1
  DropItem "AmmoPack" 150
  DropItem "ExtraArmor" 256 1
  SeeSound "supersoldier/see"
  PainSound "supersoldier/pain"
  DeathSound "supersoldier/death"
  ActiveSound "supersoldier/idle"
  Obituary "$CFSSSuperSoldierObit"
  Tag "$CFSSSold"
  var int user_loop;
  States
  {
  Spawn:
    HANS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	HANS A 10 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)
    HANS AAAABBBB 3 A_Chase
    TNT1 A 0 A_SpawnItemEx("FootStep",0,0,5,0,0,-20)	
    HANS CCCCDDDD 3 A_Chase  
    Loop
  Missile:
    HANS EE 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MissileLoop:	
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(36,44),0,frandom(-5,5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 10, 24, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 10, -24, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomBulletAttack(22.5,0,1,random(5,25),"SSBulletPuff",0,CBAF_NORANDOM)		
    HANS F 3 Bright A_PlaySoundEx("hitler/fire","Weapon")
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(36,44),0,frandom(5,-5),0)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 10, 24, 40, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("RifleCasing", 10, -24, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 AA 0 A_CustomBulletAttack(22.5,0,1,random(5,25),"SSBulletPuff",0,CBAF_NORANDOM)	
    HANS G 3 Bright A_PlaySoundEx("hitler/fire","Weapon")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto MissileLoop
	HANS E 15
    Goto See
  Pain:
    HANS H 2
    HANS H 2 A_Pain
    Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    HANS I 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    HANS J 5 A_Scream
    HANS K 5 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	HANS K 0 A_NoBlocking
	TNT1 A 0 A_BossDeath
    HANS L -1
    Stop
  Raise:
  	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    HANS LKJI 5
    Goto See
  }
}
