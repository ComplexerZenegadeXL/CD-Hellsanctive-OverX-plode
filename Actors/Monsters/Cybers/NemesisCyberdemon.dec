	DV10 ABCBCAB 3 Bright
	Stop
  }     
}

Actor WhiteLightningSpark : LegCardiThunderSpark
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
   Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(80,4)
    SWPK ABC 2 Bright
	Loop
	SWPK DEF 4 Bright A_FadeOut(0.25)
	Stop
   Death:
	SWPK DEF 4 Bright A_FadeOut(0.25)
	Stop	
  }
}

Actor NemesisLightningBolt : LegendaryNecroBolt
{
  ReactionTime 35
  Species "Cybers"
  DamageType "Nemesis"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(64,"Homing")
    LFX3 F 1 Bright A_Explode(16,100,0)
    LFX3 F 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 ThrustThing(random(0,255),1,0,0)
    LFX3 G 1 Bright A_Explode(16,100,0)
    LFX3 G 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 H 1 Bright A_Explode(16,100,0)
    LFX3 H 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 I 1 Bright A_Explode(16,100,0)
    LFX3 I 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 J 1 Bright A_Explode(16,100,0)
    LFX3 J 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 J 0 A_CountDown
    Goto Spawn+2
  Homing:
    LFX3 F 1 Bright A_Explode(16,100,0)
    LFX3 F 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 A_SeekerMissile(2,2)
    LFX3 G 1 Bright A_Explode(16,100,0)
    LFX3 G 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 A_SeekerMissile(2,2)
    LFX3 H 1 Bright A_Explode(16,100,0)
    LFX3 H 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 A_SeekerMissile(2,2)
    LFX3 I 1 Bright A_Explode(16,100,0)
    LFX3 I 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 A_SeekerMissile(2,2)
    LFX3 J 1 Bright A_Explode(16,100,0)
    LFX3 J 0 A_CustomMissile("LegendaryNecroBolt2",0,0,0,CMF_AIMDIRECTION,90)
    LFX3 F 0 A_SeekerMissile(2,2)
    LFX3 J 0 A_CountDown
    Loop
  Death:
	TNT1 A 0 A_FadeOut(0.2)
    LFX3 F 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX3 G 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX3 H 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
    LFX3 I 2 Bright A_Explode(32,128,0)
	TNT1 A 0 A_FadeOut(0.2)
