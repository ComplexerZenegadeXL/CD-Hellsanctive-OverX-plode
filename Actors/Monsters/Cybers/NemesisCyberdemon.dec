  Stomp:
    NCYB G 10 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("NemesisCyber/attack",2)
	NCYB GGGGGGGGGGGGGGG 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_missile",0)
  StompLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 3,"See")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	NCY2 CCC 5 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(40,80,0,40,0)	
	NCY2 D 2 Bright A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  StompLoop2:
    NCY2 D 0 A_CustomMissile("LegCyberQuake", 0, -48, user_loop * 10)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"StompLoop2")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  StompLoop3:
    NCY2 D 1 Bright A_CustomMissile("NemesisCyberNobleBall3",0,0,user_loop * 20,0)
    TNT1 A 0 A_CustomMissile("NemesisCyberNobleBall3",0,0,(user_loop * 20) - (user_loop * 40),0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,1)
	Loop
	NCY2 D 20 Bright
	TNT1 A 0 A_MonsterRefire(64,"See")
    Goto StompLoop
