  LegendaryCombo:
    LANI G 30 Bright A_FaceTarget
    TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",8)
    LANI G 3 Bright A_PlaySoundEx("monster/laugh","TBBCSPT1")
	LANI GGGGGGGGGGGGGGGGGG 3 Bright A_FaceTarget
	LANI EEEEEEEEEEEEEEEEEEEE 3 Bright A_FaceTarget
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20
    TNT1 A 0 A_FaceTarget
    LANI EEEEEEEEEEE 1 A_FadeIn(0.1)
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_FaceTarget
	LANI F 0 A_CustomMissile("LegCyberBFG9500Ball",60,-22,0)	
	LANI F 4 Bright A_CustomMissile("LegCyberBFG9500Ball",60,22,0)
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20
    TNT1 A 0 A_FaceTarget
    LANI EEEEEEEEEEE 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    TNT1 A 0 A_SetShootable
	TNT1 A 0 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("CyberLegendaryProjectile",60,22,frandom(-1,1),0)
	LANI F 3 A_CustomMissile("CyberLegendaryProjectile",60,-22,frandom(-1,1),0)
	TNT1 A 0 Bright A_PlayWeaponSound("BlueDTRFire")
	LANI E 3 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("CyberLegendaryProjectile",60,22,frandom(-1,1),0)
	LANI F 3 A_CustomMissile("CyberLegendaryProjectile",60,-22,frandom(-1,1),0)
	TNT1 A 0 Bright A_PlayWeaponSound("BlueDTRFire")
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20
    TNT1 A 0 A_FaceTarget
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LANI EEEEEEEEEEE 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryComboLoop3:
	LANI F 0 Bright A_CustomMissile("LegendaryCyberBFG15KBall",60,-22,frandom(-4, 4))
	LANI F 4 Bright A_CustomMissile("LegendaryCyberBFG15KBall",60,22,frandom(-4, 4))	
	LANI E 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
    TNT1 A 0 A_JumpIf(user_loop == 3,1)
    Goto LegendaryComboLoop3
