	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
