	YRL2 ABCDEFGHIJKLMNOPQR 0 Bright A_Jump(256,"Death")
	YRL3 ABCDEFGHIJKLMNOPQR 0 Bright A_Jump(256,"Death")
	YRL4 ABCDEFGHIJKLMNOPQR 0 Bright A_Jump(256,"Death")
