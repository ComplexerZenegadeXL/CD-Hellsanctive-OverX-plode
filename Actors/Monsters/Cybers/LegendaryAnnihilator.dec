Actor LegendaryAnnihilator : Cyberdemon 16516
{
  //$Category Monsters/LCA
  //$Sprite LNIIA1C1
  //$Title "Legendary Annihilator"
  Health 7999
  Scale 1.2
  Speed 20
  Radius 40
  Height 110
  Mass 0x7FFFFFFF
  PainChance 5
  BloodColor "Blue"
  Species "Cybers"
  Obituary "$CFLegendaryAnnihilatorObit"
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
