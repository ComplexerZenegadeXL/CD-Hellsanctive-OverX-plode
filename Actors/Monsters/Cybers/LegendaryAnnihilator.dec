  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "Explosion", 0.3
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.6
  DamageFactor 0.40
  PainChance "PlayerDBFG2", 256
  PainChance "DBFG2", 256
  PainChance "PlayerDBFG10K2", 256
  DropItem "LegendaryAmmoSphere" 150 1
  DropItem "LegendaryDemonRune" 135 1
  DropItem "LegendarySphere" 128 1
  DropItem "LegendaryArmor" 128 1
  DropItem "LegendaryUltraSphere" 233
  DropItem "LDemonAmmoBoxPickup" 256 
  //DropItem "LegendaryBFGGiver" 256 1
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "DemonicChaliceGiver" 128
  //DropItem "LegendaryPlasmaticRifleGiver" 188 1
  DropItem "TrueLegendaryUltraSphere" 60 1
  //DropItem "LegendaryBFG10KGiver" 200 1
  DropItem "LegendaryRandomSphere" 16 1
  DropItem "LegendaryInvisibilitySphere" 32
  SeeSound "Legannihi/see"
  PainSound "Legcyber/pain"
  DeathSound "Legcyber/death"
  ActiveSound "Legcyber/laugh3"
  +NORADIUSDMG
  +QUICKTORETALIATE
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +MISSILEMORE
  +FLOORCLIP
  +DONTMORPH
  +BOSSDEATH
  +NOICEDEATH
  +DONTGIB
  +NOTIMEFREEZE
  +CANTSEEK
  +DONTRIP
  +NOFEAR
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NOTELEFRAG
  Tag "$CFLegAnni"
  var int user_music;
  var int user_loop;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States 
  {    
  Spawn: 
    LANI A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    LANI AA 10 Bright A_Look
	LNII AA 10 Bright A_Look
    Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LANI ABB 3 Bright A_Chase		
    LANI C 3 Bright A_Playsound("monsters/clhoof") 
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1) 
    TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,5)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(90,"Rush")
	TNT1 A 0 A_Jump(40,"Teleport")
	LANI A 3 Bright A_Playsound("monsters/clhoof")
    LANI ABB 3 Bright A_Chase		
    LANI C 3 Bright A_Playsound("monsters/clhoof") 
    LANI CDD 3 Bright A_Chase 		 
    Loop
  Rush:
	TNT1 A 0 A_Hoof
	LANI A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI B 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI C 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI C 2 Bright A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LANI D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryAnnihiGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(80,"See")		
	Loop	
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI A 1 Bright A_UnSetShootable
	LANI AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner")
	LANI AAAAAAAAAA 1 A_FadeOut(0.1,0)
	LANI A 2
	LANI AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LANI A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner")
	LANI AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    LANI A 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_JumpIfCloser(290,"LegendaryNades")
	TNT1 A 0 A_Jump(195,"LegendaryRailguns","LegendaryBFG95ks","LegSeekers","LegendaryBFG10Ks","AkimboRif","LegendaryBFG15Ks","LegendaryStomp","LegendaryDTBFG","LegendaryDevastator")
	TNT1 A 0 A_Jump(30,"LegendaryLaserBeam")
	TNT1 A 0 A_Jump(25,"LegendaryBFGs","LegendaryCombo")
	TNT1 A 0 A_Jump(10,"LegendaryPlasmaticBomb")
  Normal:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	LANI E 5 Bright A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("LegendaryRocket", 60, 26, 0)
    LANI F 5 Bright A_CustomMissile("LegendaryRocket", 60, -26, 0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto NormalLoop
	LANI E 12 Bright
	TNT1 A 0 Bright A_Jump(128,"LegSeekers")
    Goto See
  LegSeekers:
	LANI E 12 Bright A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("LegendaryHomingRocket", 60, 26, 0)
    LANI F 5 Bright A_CustomMissile("LegendaryHomingRocket", 60, -26, 0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegSeekersLoop:
    LANI E 5 Bright A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("LegendaryHomingRocket", 60, 26, 0)
    LANI F 5 Bright A_CustomMissile("LegendaryHomingRocket", 60, -26, 0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Goto LegSeekersLoop
	LANI E 12 Bright
	TNT1 A 0 A_Jump(129,"LegendaryRailguns")
	Goto See
  LegendaryNades:
    LANI E 12 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    TNT1 A 0 Bright A_CustomMissile("LegendaryAnnihiGrenade", 60, 26, 0, CMF_AIMOFFSET, 4.328125)
    LANI F 5 Bright A_CustomMissile("LegendaryAnnihiGrenade", 60, -26, 0, CMF_AIMOFFSET, 4.328125)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryNadesLoop:
	LANI E 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    TNT1 A 0 Bright A_CustomMissile("LegendaryAnnihiGrenade", 60, 26, 0, CMF_AIMOFFSET, 4.328125)
    LANI F 5 Bright A_CustomMissile("LegendaryAnnihiGrenade", 60, -26, 0, CMF_AIMOFFSET, 4.328125)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Goto LegendaryNadesLoop
	LANI E 12 Bright
	TNT1 A 0 A_Jump(178,"Normal")
	Goto See
  LegendaryStomp:
	LANI G 10 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",7)
	LANI G 3 Bright A_PlaySoundEx("Legcyber/laugh4","LAUGH3")
	LANI GGGGGGGGGGGGGGG 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
	LNIS A 7 Bright A_FaceTarget
	LNIS A 5 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(40,80,0,40,0)	
	LNIS B 6 Bright A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryStompLoop1:
	LNIS B 0 A_CustomMissile("LegCyberQuake", 0, -48, user_loop * 10)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"LegendaryStompLoop1")
	TNT1 A 0 A_SetUserVar("user_loop",-17)
  LegendaryStompLoop2:
	LNIS B 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 17,2)
    TNT1 A 0 A_Jump(256,"LegendaryStompLoop2")
	LNIS BBB 20 Bright A_FaceTarget
	LNIS A 15 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(10,80,0,24,0)	
	LNIS B 6 Bright A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 A_SetUserVar("user_loop",-17)
  LegendaryStompLoop3:
	LNIS B 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 17,2)
    TNT1 A 0 A_Jump(256,"LegendaryStompLoop3")
	LNIS B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-360,0)
	LNIS A 15 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(10,80,0,24,0)	
	LNIS B 6 Bright A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 A_SetUserVar("user_loop",-17)
  LegendaryStompLoop4:
	LNIS B 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,user_loop * 20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 17,2)
    TNT1 A 0 A_Jump(256,"LegendaryStompLoop4")
	LNIS B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-360,0)
	LNIS B 70 Bright
	TNT1 A 0 A_Jump(130,"LegSeekers","AkimboRif","LegendaryBFGs","LegendaryRailguns","LegendaryBFG10Ks","LegendaryBFG95ks","LegendaryBFG15Ks","LegendaryDTBFG")
	TNT1 A 0 A_Jump(52,"LegendaryLaserBeam")
    Goto See
  LegendaryLaserBeam:
	TNT1 A 0 A_PlaySound("Legcyber/laugh4", CHAN_AUTO, 1.0, False, ATTN_NONE)
	LANI G 30 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",7)
	TNT1 A 0 A_SetUserVar("user_loop",0)
	LANI GGGGGGGGGGGGGGGGGGGGGGGG 6 Bright A_FaceTarget
	TNT1 A 0 Bright A_FaceTarget
	LALB G 4 Bright
	TNT1 A 0 A_PlaySound("ultimate/fire", CHAN_AUTO, 1.0, False, ATTN_NONE)
	TNT1 A 0 Bright A_FaceTarget
	LALF GGGGGGGGGGGGGGGGGGGGG 4 Bright A_CustomMissile("LegCyberLaserBeam",90,0,0,0)
	TNT1 A 0 Bright A_FaceTarget
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	LALF G 10 Bright A_FaceTarget
	LALB G 90 Bright A_FaceTarget
	LANI G 20 Bright A_FaceTarget
	Goto See
  LegendaryRailguns:
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    LANI EE 3 Bright A_FaceTarget
	LANI E 7 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,-22,0)
    LANI F 5 Bright A_CustomMissile("LegendaryCyberRail",60,22,0)
	LANI EEE 5 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
    LANI F 5 Bright A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI EEE 4 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
    LANI F 4 Bright A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI E 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
	LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20 
	TNT1 A 0 A_FaceTarget
	LANI EEEEEEEEEEE 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 10 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 Bright A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 3 Bright A_FaceTarget
	LANI E 2 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 2 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 2 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI EE 2 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 2 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 2 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI F 1 Bright A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
	LANI E 1 Bright A_FaceTarget
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20
	TNT1 A 0 A_FaceTarget
	LANI EEEEEEEEEEEEE 0 A_SpawnItemEx("LegendaryCyberFlameSpawner")
	LANI EEEEEEEEEEE 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetShootable
	LANI F 0 A_CustomMissile("LegendaryCyberRail",60,-22,frandom(-6,6))
    LANI F 10 Bright A_CustomMissile("LegendaryCyberRail",60,22,frandom(-6,6))
	LANI E 15 Bright
	TNT1 A 0 A_Jump(125,"LegendaryBFG95Ks")
	TNT1 A 0 A_Jump(30,"LegendaryCombo")
	Goto See
  LegendaryBFGs:
    LANI E 30 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LANI E 3 Bright A_PlaySoundEx("monster/laugh","TBBCSPT1")
	LANI E 3 Bright A_PlaySoundEx("Legcyber/BFG","GURUCHRG")	
	TNT1 A 0 Bright A_FaceTarget
    LANI E 3 Bright A_PlaySoundEx("Legcyber/BFG","GURUCHRG")	
	LANI EEEEEEEEEEEEEEEEEEE 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnsetInvulnerable
	TNT1 A 0 A_PlayWeaponSound("Weapons/GuruFire")
  	TNT1 A 0 A_PlayWeaponSound("Weapons/GuruAddFire")
	LANI F 0 A_CustomMissile("CyberGuruball",60,-26,0)
	LANI F 5 A_CustomMissile("CyberGuruball",60,26,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LANI EEEEEEEEEEE 1 A_FadeOut(0.1,0)
	LANI EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    LANI E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LANI E 20
	TNT1 A 0 A_FaceTarget
	LANI EEEEEEEEEEE 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlayWeaponSound("Weapons/GuruFire")
    TNT1 A 0 A_PlayWeaponSound("Weapons/GuruAddFire")
	LANI F 0 A_CustomMissile("CyberGuruball",60,-26,0)
	LANI F 5 Bright A_CustomMissile("CyberGuruball",60,26,0)
