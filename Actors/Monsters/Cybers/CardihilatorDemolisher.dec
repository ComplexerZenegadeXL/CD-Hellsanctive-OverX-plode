  Pain:
    SDMO K 4 A_Jump(35,"PainResurrect","Meteors")
    SDMO K 4 A_Pain
    Goto See
  PainResurrect:
	SDMO A 4
	SDMO A 4 A_Pain
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIfInventory("SentientToken",3,"See")	
	TNT1 A 0 A_GiveInventory("SentientToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
	TNT1 A 0 A_SpawnItem("SentientBrainSFX",0,0,0,0)
    SDMO K 3 Bright A_PlaySound("CardDemo/Laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop:
	TNT1 A 0 A_CustomMissile("SentientMassResurrectionEffect",10,0,user_loop * 30,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop")
	SDMO KK 3 Bright A_SpawnItem("SentientBrainSFX",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop2:
	TNT1 A 0 A_CustomMissile("SentientMassResurrectionEffect",10,0,(user_loop * 30) - 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 13,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop2")
	SDMO KK 3 Bright A_SpawnItem("SentientBrainSFX",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop3:
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop3")
	SDMO KKKKKKKKKK 3 Bright A_SpawnItem("SentientBrainSFX",0,0,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainResurrectLoop4:
	TNT1 A 0 A_CustomMissile("SentientMassResurrection",10,0,user_loop * 10,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 37,2)
	TNT1 A 0 A_Jump(256,"PainResurrectLoop4")
	SDMO KKKKKKKKKK 3 Bright A_SpawnItem("SentientBrainSFX",0,0,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  Meteors:
	TNT1 A 0 A_JumpIfCloser(1400,1)
	Goto Pain+1
	SDMO A 4
	SDMO A 4 A_Pain
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
    SDMO K 3 A_PlaySound("CardDemo/Laugh")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MeteorsLoop:
	TNT1 A 0 A_SpawnItem("CardinalRageFlameSpawner",0,0,0,0)
	SDMO K 2 Bright A_SpawnItemEx("RainCometSpawner",frandom(-1500,1500),frandom(-1500,1500),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 40,1)
	Goto MeteorsLoop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
    SDMO L 8
	TNT1 A 0 A_Scream
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO MMMMMMMM 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO NNNNNNNN 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO OOOOOOOO 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_NoBlocking
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO PPPPPPPP 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO QQQQQQQQ 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    SDMO RST 10 Bright
	SDMO U 30
    SDMO U -1
    Stop
  }
}

Actor CyberExplosiveRailgunTrail : ExplosiveRailgunTrail
{
  -CLIENTSIDEONLY
  Scale 0.8
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("CyberExplosiveRailgunTrailExplode",frandom(0,4),0,0,frandom(0,4),0,frandom(-4,4),frandom(0,360),0,SXF_CLIENTSIDE)
	RGPR ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04)
	Stop
  }
}

Actor CyberExplosiveRailgunTrailExplode : ExplosiveRailgunTrailExplode
{
  Species "Cybers"
  DamageType "Cyber10k"
  Obituary "$CFCyberExplosiveRailgunTrailExplodeObit"
  States
  {
  Spawn:
	TNT1 A 0
	FXPO AB 2 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(30,128,0,0,40)
	FXPO CD 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(30,128,0,0,40)
	FXPO EF 1 Bright A_FadeOut(0.05)
	TNT1 A 0 A_Explode(30,128,0,0,40)
	FXPO GHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor CardihilatorDemolisherGhostA
{
  Scale 1.1
  RenderStyle Translucent
  Alpha 0.75
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1
	Goto Fade
  Fade:
	SDMO A 2 A_FadeOut(0.18,1)
	Loop
  }
}

