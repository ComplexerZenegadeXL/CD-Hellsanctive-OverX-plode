	TNT1 A 0 A_CustomMissile("Sentient10K", 50, -26,frandom(-4, 4))
	TNT1 A 0 A_CustomMissile("Sentient10K", 50, 26,frandom(-4, 4))
	SDMO I 4 Bright A_CustomMissile("SentientExplosiveTracer",20,0,frandom(-8,8),0)
	Goto BFG10KLoop2+1
  BFG10KEnd:
