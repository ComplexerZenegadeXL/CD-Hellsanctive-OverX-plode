    TNT1 A 0 A_Jump(128,"CyberRockets","CyberHomingRockets","BFG95K","BFG10K","Railgun","ExpRailgun")
    TNT1 A 0 A_Jump(64,"DTBFG","DTDevastator")
	TNT1 A 0 A_Jump(16,"Nuke")
  Normal:
	TNT1 A 0 A_JumpIfCloser(1500,2)
