	SDMO F 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("CardihilatorDemolisherGhostF",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	SDMO F 1 A_Chase	
	TNT1 A 0 A_Jump(84,"See")		
	Loop
  Missile:
