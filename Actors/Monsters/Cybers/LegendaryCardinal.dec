    LARD D 140 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner", 50, 0, 120)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  LegendaryPortal2:
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    TNT1 A 0 A_SetUserVar("user_LegendaryPortal2",1)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LARD C 152 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner", 45, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
	LARD DC 15 Bright A_SpawnItemEx("FakeLegCardinalThunder", frandom(-96,96), frandom(-96,96),0, 0, 0, 0, frandom(0,360))
	LARD D 45 Bright A_SpawnItemEx("LegendaryGateSpawner2", 120, 0, 120)
	TNT1 A 0 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-128,128), frandom(-128,128), 0, 0, 0, 0, frandom(0,360))
	LARD C 52 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner", 50, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
    LARD D 47 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner2", 50, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
	LARD DCDC 20 Bright A_SpawnItemEx("FakeLegCardinalThunder", frandom(-192,192), frandom(-192,192), 0, 0, 0, 0, frandom(0,360))
    LARD D 30 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner3", 50, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
	LARD CDCD 15 Bright A_SpawnItemEx("FakeLegCardinalThunder", frandom(-192,192), frandom(-192,192), 0, 0, 0, 0, frandom(0,360))
    LARD C 47 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner2", 50, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
	LARD DCDC 25 Bright A_SpawnItemEx("FakeLegCardinalThunder", frandom(-144,144), frandom(-144,144), 0, 0, 0, 0, frandom(0,360))
    LARD D 52 Bright A_SpawnItemEx("LegendaryPortalParticleSpawner", 50, 0, 120,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Illusion:
	LARD E 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Rage", CHAN_VOICE, 1.0, False, ATTN_NONE)
	LARD EEEE 4 A_SpawnItemEx("ReinforcementLegCardi",96,96,0,0,0,0,0,0,0,user_tid)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(30,"PainRage")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckReinforcements") >= 5,2)
	TNT1 A 0 A_Jump(40,"Illusion")
	TNT1 A 0 A_Jump(128,"PainMissile")
    LARD E 3 Bright A_Pain
    LARD EE 3 Bright
    Goto See
  Pain.PlayerDBFG10K2:
  Pain.DBFG10K2:
  Pain.DBFG:
  Pain.PlayerDBFG:
  Pain.DBFG2:
  Pain.PlayerDBFG210K:
  Pain.DBFG210K:
  Pain.DBFG2Splash:
  Pain.PlayerDBFG2:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
    Goto Teleport
  PainMissile:
    LARD E 3 Bright A_Pain
    LARD E 6 Bright 
    Goto Missile
  PainRage:
	TNT1 A 0 A_JumpIfCloser(1000,1)
	Goto Pain+1
    LARD E 3 Bright A_Pain
    LARD E 12 Bright
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
    TNT1 A 0 A_PlaySound("Cardinal/Laugh")	  
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainRageLoop:
	TNT1 A 0 A_SpawnItem("LegCardinalRageFlameSpawner",0,0,0,0)
	LARD E 2 Bright A_SpawnItemEx("LegRainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto PainRageLoop
	TNT1 A 0 A_UnSetInvulnerable
    LARD E 6 Bright
	Goto See
  Death: 
	TNT1 A 0 A_ChangeFlag(FLOAT,1)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,1)
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 Radius_Quake(7, 105, 0, 50, 0)
	TNT1 A 0 A_ChangeFlag(NOGRAVITY,1)
	TNT1 A 0 A_ChangeFlag(FLOAT,1)
	LARD A 5 Bright A_PlaySound("LegCardi/Death", CHAN_AUTO|CHAN_NOPAUSE, 1.0, False, ATTN_NONE)
	LARD E 100 Bright
	TNT1 A 0 A_CheckFlag("FRIENDLY","Death2")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckSpawnScore") < 140,"Death2")
	TNT1 A 0 ACS_NamedExecuteAlways("SetBlueScreen",0)
	LARD E 5 Bright A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 AAAA 25 A_SpawnItemEx("FakeLegCardinalThunder", frandom(-144,144), frandom(-144,144), 0, 0, 0, 0, frandom(0,360))
	TNT1 A 0 ACS_NamedExecuteAlways("SetTLCSky",0)
	TNT1 A 0 A_SpawnItemEx("TrueForm",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItem("DeathBall2")
	Stop
  Death2:
    TNT1 A 0 A_DropItem("LegendaryDust",Random(5,10),256)
	LARD E 5 Bright A_NoBlocking
	LARD FGHIKL 5
	Stop
  } 
}

