{
  +SEEKERMISSILE
  States
  {
  Spawn:
    LFS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
  Fly:
    TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    LFS1 AAAAA 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    LFS1 BBBBB 1 Bright A_SpawnItemEx("BFGTrailParticleGold",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0
    TNT1 A 0 A_SpawnItemEx("BFGShockwaveGold", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("GoldParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("KaboomGold2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))      
    LFE1 A 4 Bright A_Explode(110,165)
    LFE1 BCDEF 4 Bright
    Stop
  }
}

Actor CardinalLegendaryProjectile : LegendaryProjectile
{
  +SEEKERMISSILE
  Speed 60
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Spawn2")
  Normal:
    TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    BTPR ABCDEF 1 Bright A_SpawnItemEx("LDemonTechTrail",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    Loop
  Spawn2:
    TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    BTPR ABCDEF 1 Bright A_SpawnItemEx("LDemonTechTrail2",frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    Loop	 
  }
}

Actor LegRedPortal
{
  Monster
  +NOINTERACTION
  +NOBLOCKMAP
  +NOGRAVITY
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  -SOLID
  -COUNTKILL
  Health 99999999
  RenderStyle Add
  Alpha 0.8
  Scale 1.5
  var int user_delay;
  var int user_loop;
  States
  {
  Spawn:
	TNT1 AAAAA 7 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION|SXF_ABSOLUTEVELOCITY|SXF_ABSOLUTEANGLE)
	TNT1 A 0 A_SetTranslucent(0.1,1)
	TNT1 A 0 A_PlaySound("reedemer/charge")
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.2,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.3,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.4,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.5,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.6,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.7,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD5 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(0.8,1)
	TNT1 A 0 A_PlaySound("reedemer/thunder",5,1,1)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_delay",0)
	Goto Doing
  Doing:
    TNT1 A 0 A_JumpIf(user_delay > 14,"Over")
	TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DoingLoop:
	LRD6 AAAAA 1 Bright A_SpawnItemEx("LegRedThunderMistSpawner",0,0,32,0,0,0,0,SXF_CLIENTSIDE,0)
	LRD6 A 0 A_SpawnItemEx("LegRedPortalLightningWaveSpawner",0,0,32,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto DoingLoop
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,16)
	TNT1 A 0 A_SpawnItemEx("LegRedMinion",0,0,16,5,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(256,"Doing")
	Stop
  Over:
	TNT1 A 0 A_Die
	Goto Death
  Death:
	TNT1 AAA 1 A_StopSound(5)
	Stop	
  }
}

