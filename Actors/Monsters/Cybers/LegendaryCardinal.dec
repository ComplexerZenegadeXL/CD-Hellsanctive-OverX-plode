	TLRD D 60 Bright A_SpawnItemEx("SuperLegendaryGateSpawner", 120, 0, 120,0,0,0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("FakeLegCardinalThunder",frandom(24,320),0, 0, 0, 0, 0,frandom(0,360),SXF_NOCHECKPOSITION,0)
