	  TNT1 A 0 A_PlayWeaponSound("Weapons/GuruFire")
  	  TNT1 A 0 A_PlayWeaponSound("Weapons/GuruAddFire")
      TLRD CCCCCCC 2 Bright A_FaceTarget
	  TLRD D 0 A_CustomMissile("FakeCyberGuruBall", 58, 26, 0, 0)
