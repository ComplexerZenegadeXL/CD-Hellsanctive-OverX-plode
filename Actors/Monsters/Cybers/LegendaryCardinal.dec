	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_JumpIf(user_script == 1,3)
