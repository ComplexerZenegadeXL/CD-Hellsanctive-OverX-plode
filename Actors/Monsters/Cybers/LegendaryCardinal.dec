  Devastator:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_PlaySound("devastator/charge")
	TLRD CCCCCCCCCCCCCCCCCCCC 4 Bright A_FaceTarget
	TLRD DDDD 4 Bright A_FaceTarget
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLRD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLRD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    TLRD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLRD C 5 A_FaceTarget
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLRD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TLRD D 0 A_PlaySound ("devastator/fire")
	TLRD D 0 A_CustomMissile("LegCybDevastatorBall", 58, 26, 0)
	TLRD D 8 Bright A_CustomMissile("LegCybDevastatorBall", 58, -26, 0)
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLRD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	TLRD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    TLRD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLRD C 5 A_FaceTarget
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLRD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",7)
	TLRD D 0 A_PlaySound ("devastator/fire")
	TLRD D 0 A_CustomMissile("LegCybDevastatorBall", 58, 26, 0)
	TLRD D 8 Bright A_CustomMissile("LegCybDevastatorBall", 58, -26, 0)
	TLRD C 50 Bright A_SpawnItem("TrueLegCardinalFireSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(60,"CardinalLegendaryBfg")
	Goto See	
  CardinalLegendaryBFG:
    TNT1 A 0 A_FadeIn(1.0)
    TLRD CCCCCC 5 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",9)
	TLRD C 3 Bright A_PlaySoundEx("laugh2","DSTCLAU2")
	TLRD C 3 Bright A_PlaySoundEx("Legcyber/BFG","GURUCHRG")	
	TNT1 A 0 A_FaceTarget
    TLRD C 3 Bright A_PlaySoundEx("Legcyber/BFG","GURUCHRG")	
	TLRD CCCCCCCCCCCCCCCCCCC 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
