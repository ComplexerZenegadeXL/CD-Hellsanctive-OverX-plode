  CardinalLegendaryStorm:
    TLER AAAA 4 Bright 
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_storm",0)
    TNT1 A 0 A_PlaySound("laugh2",5)  
	TLER AAAAAAAAAAAAAAAAA 4 Bright A_FaceTarget
  StormLoop:
	TNT1 A 0 A_JumpIf(user_storm >= 40,"StormEnd")	 
    TNT1 A 0 A_SetUserVar("user_storm",user_storm+1)
	TNT1 A 0 A_VileTarget("LegCardinalStormBoltAttack")
	TLER AAAA 2 Bright A_SpawnItemEx("LegRainCometSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,0,SXF_NOCHECKPOSITION,64)
	TNT1 AAAAAAAA 0 A_SpawnItemEx("LegCardinalStormBoltSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION,64)
	Loop
  StormEnd:
	TLER C 4 Bright 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
   	Goto See
  ThunderZone:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
