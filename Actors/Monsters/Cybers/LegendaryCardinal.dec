  BloodColor "Blue"
  SeeSound "LegCardi/Hi"
  PainSound "RAGE"
  DeathSound ""
  ActiveSound "LegCardi/active"
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +FIRERESIST
  +MISSILEMORE
  -FLOORCLIP
  +DONTMORPH
  +DONTRIP
  +BOSSDEATH
  +NOICEDEATH
  +DONTGIB
  +CANTSEEK
  +NOTIMEFREEZE
  +LOOKALLAROUND
  +NOFEAR
  +NOTELEFRAG
  MinMissileChance 160
  Obituary "$CFLegendaryCardinalObit"
  Tag "$CFLegCard"
  var int user_LegendaryPortal;
  var int user_LegendaryPortal2;
  var int user_music;
  var int user_script;
  var int user_loop;
  var int user_tid;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LARD A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 ACS_NamedExecuteAlways("GetTID")
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,2)
	TNT1 A 0 A_SetUserVar("user_script",1)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    TNT1 A 0 A_FadeIn(1.0)
    LARD AB 2 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_UnsetReflectiveInvulnerable
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LARD AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,12)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(87,"Rush")
	LARD AB 2 Bright A_Chase
	Loop
  Rush:
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SpawnItemEx("LegendaryCardinalGhost")
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RushLoop:
	LARD A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCardinalGhost")
	LARD B 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCardinalGhost")
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto RushLoop
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckReinforcements") >= 5,"See")
	TNT1 A 0 A_Jump(40,"Illusion")
	Goto See
  RandomIllusion:
	LARD E 5 Bright A_FaceTarget
	LARD E 4 A_SpawnItemEx("ReinforcementLegCardiSummoner",96,96,0,0,0,0,0,0,0,user_tid)
	LARD E 5 Bright
	Goto See
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnsetReflectiveInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckReinforcements") >= 5,2)
	TNT1 A 0 A_Jump(40,"RandomIllusion")  //40
	TNT1 A 0 A_CheckFlag("FRIENDLY",5)
    TNT1 A 0 A_JumpIf(user_LegendaryPortal == 1,2)
    TNT1 A 0 A_JumpIfHealthLower(3499,"LegendaryPortal")
	TNT1 A 0 A_JumpIf(user_LegendaryPortal2 == 1,2)
    TNT1 A 0 A_JumpIfHealthLower(2299,"LegendaryPortal2")
    TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","LegendaryTech","DTBFG10K","LegRevAttack","Devastator","LegendaryBFG","LegendaryThunder","LegendarySlash")
	TNT1 A 0 A_Jump(87,"UltimateCombo","ComboLegendaryBFG","ComboDevastator")
	TNT1 A 0 A_Jump(16,"FinalAttack")
  Normal:
    TNT1 A 0 A_FadeIn(1.0)
    LARD CC 2 Bright A_FaceTarget   
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD C 2 Bright A_FaceTarget	  
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD C 2 Bright A_FaceTarget	  
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
    LARD DCC 2 Bright A_FaceTarget  
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
    LARD DCCC 2 Bright A_FaceTarget 
    LARD D 2 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	LARD DCCC 2 Bright
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","LegendaryTech","DTBFG10K","LegRevAttack","LegendaryBFG","LegendaryThunder","LegendarySlash")
    Goto See
  Teleport:
	LARD AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD AAAAAAAAAAA 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LARD AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LARD A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD A 5 A_FaceTarget
	LARD AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD AAAAAAAAAAA 1 A_FadeIn(0.1)	
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SetShootable
	Goto See 
  Seekers:
    TNT1 A 0 A_FadeIn(1.0)
    LARD CC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
	LARD C 2 Bright A_FaceTarget	  
    LARD D 2 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD DCC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
    LARD CC 2 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryHomingRocket", 56, -26, frandom(-8, 8))
	LARD DCCC 2 Bright
	TNT1 A 0 A_Jump(128,"Railgun","BFG10K","LegendaryTech","LegRevAttack","DTBFG10K","LegendaryBFG","LegendaryThunder","LegendarySlash")
    Goto See
  Railgun:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    LARD CCCCCCCC 4 Bright A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	LARD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    LARD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD C 5 A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
    LARD D 2 Bright A_CustomMissile("LegendaryCyberRail", 56, -26, 0)
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	LARD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    LARD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD C 5 A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	LARD CCC 4 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryCyberRail", 56, -26, 0)
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	LARD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    LARD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD C 5 A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	LARD CCC 4 Bright A_FaceTarget
    LARD D 2 Bright A_CustomMissile("LegendaryCyberRail", 56, -26, 0)
    LARD DD 4 Bright A_FaceTarget
    LARD C 14 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","LegendaryTech","DTBFG10K","LegRevAttack","LegendaryBFG","LegendaryThunder","LegendarySlash")
	Goto See	  
  BFG10K:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	LARD CCCCCC 4 Bright A_FaceTarget
    LARD C 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LARD D 3 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(4, -4))
    LARD C 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LARD D 3 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
    LARD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	LARD D 2 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto BFG10KLoop
	LARD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LARD D 1 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop2:
    LARD C 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    LARD D 1 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 15,1)
	Goto BFG10KLoop2
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	LARD CCCCC 4 Bright A_SpawnItem("LegCardinalFireSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(128,"LegendaryTech","LegRevAttack","DTBFG10K","LegendaryBFG","LegendaryThunder","LegendarySlash")
    Goto See	  
  DTBFG10K:
    TNT1 A 0 A_FadeIn(1.0)
   	TNT1 A 0 A_PlaySound("Cardinal/9k")
	LARD CCCD 6 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	LARD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    LARD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD C 3 A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	LARD CCCD 6 Bright A_FaceTarget
    LARD D 3 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)	
	LARD DCC 3 Bright A_SpawnItem("LegCardinalFireSpawner",0,0,0,0) 
	LARD CCCCCCCCCCCCC 0 Bright A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    LARD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	LARD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    LARD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LARD C 3 A_FaceTarget
	LARD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	LARD CCCD 6 Bright A_FaceTarget
    LARD D 1 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)	
	LARD DCC 1 Bright A_SpawnItem("LegCardinalFireSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(87,"LegendaryBFG","LegendaryThunder","LegendarySlash")
    Goto See
  LegendaryTech:
    TNT1 A 0 A_FadeIn(1.0)
    LARD CCCCCC 5 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_delay",9)
    LARD C 3 Bright A_PlaySoundEx("laugh1","lcarlaug")
	LARD CCCCC 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 Bright A_PlayWeaponSound("BlueDTRFire")
     LARD D 2 Bright A_CustomMissile("CyberLegendaryProjectile", 64, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryTechLoop2:
    LARD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
    LARD D 2 Bright A_CustomMissile("CyberLegendaryProjectile", 64, -26, frandom(4, -4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 19,1)
	Goto LegendaryTechLoop2
	TNT1 A 0 A_PlaySoundEx("Legcyber/amhalt","DECHST")
	LARD C 20 Bright
	TNT1 A 0 A_Jump(128,"LegRevAttack","DTBFG10K","LegendaryBFG","LegendaryThunder","LegendarySlash")
    Goto See
  LegRevAttack:
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_delay",9)
	LARD C 0 A_FaceTarget
	LARD C 3 Bright A_PlaySoundEx("laugh1","lcarlaug")
	LARD CC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load1")
	LARD CC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load2")
	LARD CCC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load3")
	LARD CC 5 Bright A_FaceTarget 
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegRevAttackLoop:
	LARD C 8 A_FaceTarget
	LARD C 0 A_PlayWeaponSound("lrball3/shot")
	LARD D 3 Bright A_CustomMissile("LegRevBall3", 58, -26)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
