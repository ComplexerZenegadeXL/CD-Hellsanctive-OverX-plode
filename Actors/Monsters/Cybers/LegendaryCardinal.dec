    // Gold
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegCardiBombTrail",5,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryUltraBombFluxShockwave",0,0,0,10,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,224)
