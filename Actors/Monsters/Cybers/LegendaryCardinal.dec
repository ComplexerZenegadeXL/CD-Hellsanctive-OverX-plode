	TLRD CCCCCCCCCCCCCCCCCCCCCCCC 5 Bright A_FaceTarget
    Goto See 
  Whirl:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
    TNT1 A 0 A_PlaySound("RAGE2", CHAN_VOICE|CHAN_NOPAUSE)
    TLR2 ABCD 4 Bright A_FaceTarget
    TLR2 ABCD 3 Bright A_FaceTarget
    TLR3 ABCDABCD 2 Bright A_FaceTarget
    TNT1 A 0 A_PlaySound("player/spawn")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  WhirlLoop1:
	TNT1 A 0 A_CustomMissile("SeekerLegendaryBFG15KBall",62,0,user_loop * 20,2,(user_loop - 8) * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
