Actor LegendaryNuke : CFNuke
{
  Projectile
  ReactionTime 1
  Species "Cybers"
  DamageType "Legendary"
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TNT1 AAA 0 A_Countdown
  Death:
    TNT1 A 0
