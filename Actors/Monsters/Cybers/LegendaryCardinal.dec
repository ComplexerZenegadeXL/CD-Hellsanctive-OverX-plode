    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE,16)
    UBAL DD 1 Bright A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    // Blue
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegCardiBombTrail",5,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryUltraBombFluxShockwave",0,0,0,10,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,224)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE,16)
    UBAL BB 1 Bright A_SpawnItemEx("LCABFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),Random(-20,20),SXF_CLIENTSIDE)
    // Gold
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegCardiBombTrail",5,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryUltraBombFluxShockwave",0,0,0,10,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,224)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE,16)
    UBAL DD 1 Bright A_SpawnItemEx("LCABFGTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
     // Blue
	//TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	TNT1 A 0 A_SpawnItemEx("LegCardiBombTrail",5,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryUltraBombFluxShockwave",0,0,0,10,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,224)
    TNT1 A 0 A_SpawnItemEx("ArcBallLightningBolt4",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE,16)
    TNT1 A 0 A_SpawnItemEx("LCABFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
