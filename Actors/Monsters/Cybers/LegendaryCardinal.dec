  BFG10K:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TLRD CCCCCC 4 Bright A_FaceTarget
    TLRD C 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0  A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 3 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
    TLRD C 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0  A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 3 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
    TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0 A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 2 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
    TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0  A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 2 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
	TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0  A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 2 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
    TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0 A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 2 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))  
	TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TLRD D 0 A_CustomMissile("Legendary10KProjectile", 56, 26, frandom(-4, 4))
    TLRD D 1 Bright A_CustomMissile("Legendary10KProjectile", 56, -26, frandom(-4, 4))
    TLRD C 1 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 16,1)
	Goto BFG10KLoop
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TLRD CCCCC 4 Bright A_SpawnItem("TrueLegCardinalFireSpawner",0,0,0,0)
	TNT1 A 0 A_Jump(128,"LegendaryTech","CardinalLegendaryStorm","ThunderZone","LegRevAttack","Whirl","DTBFG10K")
    Goto See	  
  DTBFG10K:
    TNT1 A 0 A_FadeIn(1.0)
   	TNT1 A 0 A_PlaySound("Cardinal/9k")
	TLRD CCCCC 3 Bright A_FaceTarget
	TLRD DD 2 Bright A_FaceTarget
	TLRD D 0 A_CustomMissile("LegAnniDTBFGBall", 56, 26, 0)
    TLRD D 2 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLRD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLRD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    TLRD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLRD C 3 A_FaceTarget
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLRD CCCCCCCCCCC 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	TLRD CCCCC 3 Bright A_FaceTarget
	TLRD DD 2 Bright A_FaceTarget
	TLRD D 0 A_CustomMissile("LegAnniDTBFGBall", 56, 26, 0)
    TLRD D 2 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)
	TLRD DCC 2 Bright A_SpawnItemEx("TrueLegCardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION) 
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TLRD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLRD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
    TLRD C 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLRD C 3 A_FaceTarget
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLRD CCCCCCCCCCC 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	TLRD CC 5 Bright A_FaceTarget
	TLRD D 2 Bright A_FaceTarget
	TLRD D 0 A_CustomMissile("LegAnniDTBFGBall", 56, 26, 0)
    TLRD D 1 Bright A_CustomMissile("LegAnniDTBFGBall", 56, -26, 0)
	TLRD DCC 1 Bright A_SpawnItemEx("TrueLegCardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Jump(87,"Devastator","LegendaryBFG")
	TNT1 A 0 A_Jump(60,"CardinalLegendaryBFG")
    Goto See
  LegendaryTech:
    TNT1 A 0 A_FadeIn(1.0)
    TLRD CCCCCC 5 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",9)
    TLRD C 3 Bright A_PlaySoundEx("laugh1","lcarlaug")
	TLRD CCCCCCCCCCCCCCCCC 6 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryTechLoop2:
	TNT1 A 0 A_PlayWeaponSound("BlueDTRFire")
	TLRD D 0 A_CustomMissile("CyberLegendaryProjectile", 64, 26, frandom(-4, 4))
    TLRD D 2 Bright A_CustomMissile("CyberLegendaryProjectile", 64, -26, frandom(-4, 4))
    TLRD C 2 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto LegendaryTechLoop2
	TNT1 A 0 A_PlaySoundEx("Legcyber/amhalt","DECHST")
	TLRD CCCCC 4 Bright
	TNT1 A 0 A_Jump(128,"LegRevAttack","CardinalLegendaryStorm","ThunderZone","Whirl","DTBFG10K","LegendaryBFG")
	TNT1 A 0 A_Jump(60,"CardinalLegendaryBFG")
    Goto See
  LegRevAttack:
    TNT1 A 0 A_FadeIn(1.0)
	TLRD C 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",9)
	TLRD C 3 Bright A_PlaySoundEx("laugh1","lcarlaug")
	TLRD CC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load1")
	TLRD CC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load2")
	TLRD CCC 5 Bright A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("legcardi/load3")
	TLRD CC 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegRevAttackLoop:
	TLRD C 8 A_FaceTarget
	TLRD C 0 A_PlayWeaponSound("lrball3/shot")
	TLRD D 0 A_CustomMissile("LegRevBall3", 58, 26, frandom(-4, 4))
	TLRD D 3 Bright A_CustomMissile("LegRevBall3", 58, -26, frandom(-4, 4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto LegRevAttackLoop
	TLRD C 7 A_FaceTarget
	TNT1 A 0 A_Jump(128,"CardinalLegendaryStorm","ThunderZone","Whirl","DTBFG10K","LegendaryBFG")
	TNT1 A 0 A_Jump(60,"CardinalLegendaryBFG")
	Goto See
  LegendaryBFG:
    TNT1 A 0 A_FadeIn(1.0)
    TLRD CCCCCC 5 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
