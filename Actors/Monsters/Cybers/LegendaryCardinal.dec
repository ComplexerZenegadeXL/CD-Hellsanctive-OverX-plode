  Height 10
  Speed 15
  Species "Cybers"
  DamageType "Legendary"
  Damage (Random(3500,5500))
  Projectile
  RenderStyle Add
  +FORCERADIUSDMG
  +SKYEXPLODE
  +FOILINVUL
  +EXTREMEDEATH
  +RIPPER
  +BLOODLESSIMPACT
  -RANDOMIZE
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  Scale 5.50
  Alpha 1.0
  SeeSound "Arcradimus/BFGFire"
  States
  {
  Spawn:
    // Gold
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegCardiBombTrail",5,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
