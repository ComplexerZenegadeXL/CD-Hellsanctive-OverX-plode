	TLRD B 2 Bright A_Look	  
	Loop
  See:
    TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,6)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,13)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_Jump(87,"Rush")
	TLRD AB 2 Bright A_Chase
	Loop
  Rush:
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RushLoop:	
	TNT1 A 0 A_SpawnItemEx("TrueLegCardinalGhost")
    TLRD A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TrueLegCardinalGhost")
    TLRD B 1 Bright A_Chase
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Goto RushLoop
	TNT1 A 0 A_Jump(70,"See")
	TNT1 A 0 A_Jump(40,"Teleport")
    Loop
  Teleport:
	TLRD CCCCCCCCCCCCC 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TLRD CCCCCCCCCCC 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLRD CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 0 A_Wander
