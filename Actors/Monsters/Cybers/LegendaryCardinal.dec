Actor LegendaryRazorWind
{
  RenderStyle Add
  Alpha 0.95
  Radius 2
  Height 1
  Speed 60
  ReactionTime 7
  Species "Cybers"
  DamageType "Legendary"
  Damage (0) //(30)
  DeathSound "Claw/Hit"
  Scale 0.85
  Projectile
  Obituary "$CFLegendaryRazorWindObit"
  +THRUACTORS
  +NOEXTREMEDEATH
  +DONTREFLECT
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
  SpawnLoop:
	TNT1 A 0 A_SpawnItemEx("RazorWindExplosion",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    TNT1 A 1 A_SpawnItemEx("RazorWindTrail", 0,0,2,0,0,0,0,SXF_ABSOLUTEANGLE|SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SetUserVar("user_loop",1)
    TNT1 A 0 A_SpawnItemEx("RazorWindTrail", (user_loop * 2 *velx)/-30.0, -(user_loop * 2 *vely)/-30.0, 2+(user_loop * 2 *velz)/-30.0, 0,0,0, 0, SXF_ABSOLUTEANGLE|SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,2)
	TNT1 A 0 A_Jump(256,"SpawnLoop")
    TNT1 A 0
	Loop
  Death:
    TNT1 A 1
    Stop
  }
}

