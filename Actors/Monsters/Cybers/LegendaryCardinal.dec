}
Actor LegendaryUtraBombShockwave : LegendaryBombShockwave { Scale 7.0 }

Actor LegendaryUltraBombFluxShockwave : LegendaryUtraBombShockwave { Scale 6.75 Alpha 1.0 Projectile }

Actor LegCardiBombTrail : LCABaseEffect
{
  Alpha 0.50
  Renderstyle Add
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  Scale 5.0
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	UBAL BDBDB 1 Bright A_FadeOut(0.05)
	Loop
  }
}

Actor ELegCardiFinalAttack : LegCardiFinalAttack
{
  States
  {
  Spawn:
    UBAL BD 5 Bright A_SpawnItemEx("LegendaryUltraBombFluxShockwave",0,0,0,10,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_SetScale(1.25,1.25)
	TNT1 A 0 ACS_NamedExecuteAlways("SetAlpha",0,22937)
