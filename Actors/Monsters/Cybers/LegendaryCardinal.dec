Actor Reinforcements : Inventory { Inventory.MaxAmount 5 }

Actor ReinforcementLegCardi : LegendaryCardinal
{
  Renderstyle Translucent
  Alpha 0.45
  PainChance 10
  DamageFactor 9.999
  Obituary "$CFReinforcementLegCardiObit"
  SeeSound "Cardinal/Sight"
  PainSound "Cardinal/Pain"
  DeathSound "Cardinal/Death"
  ActiveSound "Cardinal/Active"
  -COUNTKILL
  -BOSS
  +THRUSPECIES
  +DONTHARMSPECIES
  -BOSSDEATH
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_GiveInventory("Reinforcements",1,AAPTR_MASTER)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
    TNT1 A 0 A_PlayWeaponSound("boss/teleport")
  SpawnLoop:
    LARD EE 3 A_Look
	Loop
  See:
    TNT1 A 0 A_FadeIn(1.0)
    LARD AB 2 Bright A_Chase
    Loop
  Missile:
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MissileLoop:
    LARD DCC 2 Bright A_FaceTarget   
    LARD D 3 Bright A_CustomMissile("LegendaryRocket", 56, -26, frandom(-6, 6))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Loop
	LARD DCCC 2 Bright A_FaceTarget
	Goto See
	Pain:
    LARD E 3 Bright
    LARD E 3 Bright A_Pain 
    Goto See
  Death:
    LARD E 1 A_Stop
    LARD E 4
    LARD EEEEEEEEEEEEE 0 A_SpawnItemEx("LegCardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LARD EEEEEEEEEEE 1 A_FadeIn(0.1)
	TNT1 A 0 A_TakeInventory("Reinforcements",1,0,AAPTR_MASTER)
	Stop
  }
}

