	MRA4 EF 6 Bright A_FadeOut(0.05,0)
	TNT1 AA 0 A_SpawnItemEx("LegendaryAmmoSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
