Actor NemSphereRandomizer : RandomSpawner
{
  DropItem "NemesisSphere", 256, 14
  DropItem "NemesisUltraSphere", 256, 5
  DropItem "NemesisOmegaSphere", 256, 1
}

Actor MReimuSummonSmokeSpawner : LHellionSmokeSpawner
{
  States
  {
