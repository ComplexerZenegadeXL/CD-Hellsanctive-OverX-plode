  Distortion:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	MRA1 LMN 6
	TNT1 A 0 A_VileTarget("MReimuDistortion")
	MRA1 N 20
	TNT1 A 0 A_PlaySound("MReimu/Attack1",2,1.0,0,ATTN_NONE)
	MRA1 N 30
	MRA1 OP 5
	TNT1 A 0 A_VileAttack("exile/voidend",300,50,200,4.0,"MagaReimu")
	MRA1 QRS 8
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto MoreSee
  Death:
	TNT1 A 0 A_Quake(5,296,0,3000,0)
	TNT1 A 0 ThrustThingZ(0,2,0,1)
	TNT1 A 0 A_ChangeFlag("NOGRAVITY",1)
	TNT1 A 0 A_PlaySound("uroboros/death",6,1.0,0,ATTN_NONE)
	TNT1 A 0 A_RemoveChildren(1)
	MRA3 ABCDEFGHIJ 6
	TNT1 A 0 A_Scream
	TNT1 A 0 A_Stop
	MRA4 ABABABABABAB 6 Bright A_SpawnItemEx("MReimuLightning",frandom(-1250,1250),frandom(-1250,1250),-1000,0,0,0,SXF_NOCHECKPOSITION,0,180)
	MRA4 CD 10 Bright
	MRA4 EFEF 6 Bright
	TNT1 A 0 A_UnsetSolid
	TNT1 A 0 A_Playsound("brain/spit",6,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	MRA4 EF 6 Bright A_FadeOut(0.05,0)
	TNT1 AAA 0 A_SpawnItemEx("Red2huBossDeathFlame",0,0,20,frandom(-4,4),frandom(-4,4),frandom(0,3))
	TNT1 AAA 0 A_SpawnItemEx("Red2huBossDeathFlame3",0,0,20,frandom(-20,20),frandom(-20,20),frandom(0,20))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
