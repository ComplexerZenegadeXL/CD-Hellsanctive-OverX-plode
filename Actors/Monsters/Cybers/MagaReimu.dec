	MRA1 QRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQRQR 3 A_CustomMissile("MReimuLaser",30)
	MRA1 PONML 6
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
