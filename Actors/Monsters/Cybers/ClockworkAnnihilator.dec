Actor ClockworkAnnihilator : ClockworkCyberdemon
{
  Scale 0.95
  Health 7000
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "NewCellPackPickup" 186 300
  DropItem "BFG10KGiver" 178 1
  DropItem "RailgunGiver" 184 1
  Obituary "$CFClockworkAnnihilatorObit"
  //SeeSound "Clockwork/Sight"
  Tag "$CFClockAnni"
  States 
  {    
  Spawn: 
	INNI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	INNI A 10 A_Look
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	INNI AB 3 A_Chase
	TNT1 A 0 A_PlaySound("monsters/clhoof")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_PlaySound("monsters/clhoof")
	INNI A 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI A 3 A_Chase	
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Playsound("monsters/clhoof")
	INNI C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI D 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	INNI D 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAnniGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Missile:
	TNT1 A 0 A_Jump(110,"RailgunCharge","InfernalRockets")
	TNT1 A 0 A_Jump(80,"MiniDTBFG","BFG15k")
	TNT1 A 0 A_Jump(20,"OverkillAttack")
  EMinigun:	
	TNT1 A 0 A_JumpIfCloser(400,"EASG")
  Actuallyfireit:
	INNI E 14 A_FaceTarget
	INNI E 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_CustomMissile("TerminatorExplosiveTracer",50,25,frandom(1,-1),0)
    INNI F 2 Bright A_CustomMissile("TerminatorExplosiveTracer",50,-25,frandom(1,-1),0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, -12, 36, frandom(-6, -2), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIfCloser(400,"EASG")
	TNT1 A 0 A_Jump(18,"See")
	TNT1 A 0 A_SpidRefire	
	Goto Actuallyfireit+1	
  EASG:
	INNI E 14 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, -12, 36, frandom(-6, -2), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("TerminatorExplosiveTracer",50,25,frandom(-4,4),0)
    TNT1 AAAAAA 0 A_CustomMissile("TerminatorExplosiveTracer",50,-25,frandom(-4,4),0)
	INNI F 4 Bright A_CustomBulletAttack(9,6,12,Random(15,20),"Cyberpuff",0,CBAF_NORANDOM)
	INNI E 12
	TNT1 A 0 A_Jump(58,"See")
	TNT1 A 0 A_SpidRefire
	Goto EASG+2
  InfernalRockets:
    INNI E 12 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  InfernalRocketsLoop:
    TNT1 A 0 A_CustomMissile("CyberInfernalRocket",50,25)
    INNI F 8 Bright A_CustomMissile("CyberInfernalRocket",50,-25)
	INNI E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	INNI E 8
	Goto See
  RailgunCharge:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    INNI EE 5 A_FaceTarget
    INNI EEE 5 Bright A_FaceTarget
	TNT1 A 0 A_Jump(120,"Lasers")
	TNT1 A 0 A_Jump(80,"Morerailguns")
  Railgun:
	INNI E 10 Bright
	TNT1 A 0 A_CustomMissile("CardinalRail",50,25)
	INNI F 10 Bright A_CustomMissile("CardinalRail",50,-25)
	INNI E 15
	Goto See
  MoreRailguns:
	INNI E 10 Bright
	TNT1 A 0 A_CustomMissile("CardinalRail",50,25)
	INNI F 10 Bright A_CustomMissile("CardinalRail",50,-25)
	INNI E 8 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalRail",50,25)
	INNI F 10 Bright A_CustomMissile("CardinalRail",50,-25)
	INNI E 8 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalRail",50,25)
	INNI F 10 Bright A_CustomMissile("CardinalRail",50,-25)
	INNI E 15
	Goto See
  Lasers:
  	INNI E 10 Bright
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LasersLoop:
	TNT1 A 0 A_CustomMissile("CWClaser",50,25,frandom(-2,2))
	INNI F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	INNI E 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0
	Goto See
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	INNI E 18 Bright A_FaceTarget
	INNI E 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG15kLoop:
    TNT1 A 0 A_CustomMissile("Desolator15k",50,25,frandom(-1,1))
    INNI F 8 Bright A_CustomMissile("Desolator15k",50,-25,frandom(-1,1))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	Goto See
  MiniDTBFG:
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGCharge")
	INNI EEEEEEE 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  MiniDTBFGLoop:
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	TNT1 A 0 A_CustomMissile("ClockworkMiniDTBFG",50,25,frandom(-2,2))
	INNI F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-2,2))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	TNT1 A 0
	Goto See
  OverkillAttack:
	TNT1 A 0 A_PlaySound("lrball3/charge")
	INNI EEEEEEEEEEEE 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	TNT1 A 0 A_CustomMissile("Desolator15k",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ClockworkMiniDTBFG",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Desolator15k",50,-25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	INNI F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-2,2))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	TNT1 A 0 A_CustomMissile("Desolator15k",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ClockworkMiniDTBFG",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Desolator15k",50,-25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	INNI F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-2,2))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	TNT1 A 0 A_CustomMissile("Desolator15k",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ClockworkMiniDTBFG",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Desolator15k",50,-25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	INNI F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-2,2))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	TNT1 A 0 A_CustomMissile("Desolator15k",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ClockworkMiniDTBFG",50,25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Desolator15k",50,-25,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	INNI F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-2,2))
	INNI E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	Goto See	
  Death:
	INNI G 10 A_Scream
	INNI H 10 A_NoBlocking 
	INNI IIIIIJJJJJKKKKKLLLLLMMMMM 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	INNI NO 5
	INNI P -1
	Stop	
  }
}

Actor CyberInfernalRocket : CardinalRocket
{
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,0,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,45,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,90,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,135,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,180,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,225,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,270,6)
    TNT1 A 0 A_CustomMissile("CyberHellBoom",0,0,315,6)
	CROC B 6 Bright A_Explode(128,128,0)
	CROC CD 5 Bright A_SetTranslucent(0.75,1)
	Stop
  }
}

Actor CyberHellBoom : HellBoom
{
  Species "Cybers"
  DamageType "Cyber10k"
  States
  {
  Spawn:
	TNT1 AAAAA 3 A_SpawnItem("CyberHellFX",0,0)
	Stop
  }
}

Actor CyberHellFX : HellFX { Species "Cybers" DamageType "Cyber10k" }

//Illusions
Actor InsaneAnniGhostA
{
  Scale 0.95
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    INNI A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneAnniGhostB : InsaneAnniGhostA
{   
  States
  {
  Spawn:
    INNI B 2 A_FadeOut(0.18)
    Loop
  }
}
	
Actor InsaneAnniGhostC : InsaneAnniGhostA
{   
  States
  {
  Spawn:
    INNI C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneAnniGhostD : InsaneAnniGhostA
{   
  States
  {
  Spawn:
    INNI D 2 A_FadeOut(0.18)
    Loop
  }
}