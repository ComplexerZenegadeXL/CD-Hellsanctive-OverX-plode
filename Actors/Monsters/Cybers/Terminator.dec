Actor RMTerminator: Cyberdemon
{ 
  Health 8000
  Radius 28 
  Height 86 
  Mass 0x7FFFFFFF
  Speed 15 
  PainChance 1
  Scale 1.4
  Monster
  Obituary "$CFTerminatorObit"
  Species "Cybers"
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  +FLOORCLIP
  +NOTARGET
  +FIRERESIST
  +NORADIUSDMG
  +NOICEDEATH
  +BOSS
  +CANTSEEK
  +NOFEAR
  +DONTSPLASH
  +LOOKALLAROUND
  +NOEXTREMEDEATH
  +BOSSDEATH
  +NOTELEFRAG
  +DONTGIB
  +DONTMORPH
  +QUICKTORETALIATE
  +NODROPOFF
  +DONTRIP
  +NOTELEFRAG
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PlayerFireSword", 0.8
  DamageFactor "PlayerDTRG", 0.30
  DamageFactor "PlayerBHole", 0.0
  DamageFactor "CustomSpray", 0.0
  DamageFactor "BFG9500Ball", 0.0
  DamageFactor "PlayerPyro", 0.3
  DamageFactor "Extreme", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "HellComet", 0.2
  DamageFactor "T3rm", 0.0
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "PlayerRailPuff", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "C0mm4nder", 0.0
  DamageFactor "HFCyb3r", 0.0

  DamageFactor "Legendary", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "BFG10K", 0.65
  DamageFactor "BFGSplash", 0.0
  DamageFactor "BFGSpray", 0.0
  DamageFactor "Railg", 0.5

  DamageFactor "PlayerDevBall", 0.020
  DamageFactor "PlayerDevTracer", 0.020

  DamageFactor "SuperWeapon", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.0
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor 0.5
  DropItem "TrueLegendaryRune", 26
  SeeSound "monster/termsit" 
  PainSound "monster/termpin" 
  DeathSound "monster/termdth"
  AttackSound "plasmaminigun/fire"
  ActiveSound "Terminator/termact"

  PainChance "BFG9500Ball", 40
  PainChance "PlayerDevBall", 100
  PainChance "BFG10K", 100
  PainChance "PDTBFG", 100
  PainChance "PlayerDBFG10K2", 100
  PainChance "Legendary", 100 // 100
  PainChance "LegendaryPlayer", 100 // 100
  PainChance "LegendaryGuru", 256
  PainChance "LegendaryGuruPlayer", 256
  PainChance "PlayerDBFG2", 256
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "Explosion", 0.1
  MinMissileChance 200
  Tag "$CFTerm"
  var int user_amount;
  var int user_music;
  var int user_tier;
  var int user_missile;
  var int user_loop;
  var int user_lowlag;
  States 
  { 
  Spawn: 
    TERM A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_JumpIfInventory("RunesCheck",1,2)
	TNT1 A 0 ACS_NamedExecuteWithResult("BossToughness")
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	TERM A 10 A_Look 
	TRMI A 10 A_Look 
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TERM AABB 3 A_Chase
	TERM C 0 A_PlaySound("Terminator/terstepA")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_UnSetInvulnerable
    TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,604)
    TNT1 A 0 A_SetUserVar("user_music",1)
    TNT1 A 0 A_Jump(100,"Rush")
    TERM A 0 A_PlaySound("Terminator/terstepA")
    TERM AABB 3 A_Chase
    TERM C 0 A_PlaySound("Terminator/terstepA")
    TERM CCDD 3 A_Chase
    TNT1 A 0 A_Jump(26,"Teleport","ComboTel")
    Loop
  Rush:
    TERM A 0 A_PlaySound("Terminator/terstepA")
    TERM AA 0 A_Chase
    TERM A 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM A 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM B 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM B 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)    
    TERM A 0 A_PlaySound("Terminator/terstepA")
    TERM AA 0 A_Chase
    TERM C 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM C 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM D 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM AA 0 A_Chase
    TERM D 2 A_SpawnItemEx("TerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)   
    TNT1 A 0 A_Jump(38,"Teleport","ComboTel")
    TNT1 A 0 A_Jump(75,"See")   
    Loop
  Tier2:
   	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TERM L 3 Bright 
	TERM L 10 Bright
	TNT1 A 0 A_SpawnItemEx("TerminatorPulse",0,0,40)
	TERM LLLL 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_Giveinventory("TerminatorTier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TerminatorTier")
	TNT1 A 0 A_SetUserVar("user_tier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Tier3:
   	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TERM L 3 Bright 
	TERM L 10 Bright
	TNT1 A 0 A_SpawnItemEx("TerminatorPulse",0,0,40)
	TERM LLLL 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_Giveinventory("TerminatorTier",2)
    TNT1 A 0 ACS_NamedExecuteAlways("TerminatorTier")
	TNT1 A 0 A_SetUserVar("user_tier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Teleport:
    TERM E 1 A_UnSetShootable
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)
    TERM E 1 A_SetShootable
    Goto Normal
  ComboTel:
    TERM E 1 A_UnSetShootable
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner")
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)
    //TERM E 1 A_PlayWeaponSound("boss/teleport")
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)
    //TERM E 1 A_PlayWeaponSound("boss/teleport")
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)
    //TERM E 1 A_PlayWeaponSound("boss/teleport")
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)
    //TERM E 1 A_PlayWeaponSound("boss/teleport")
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeOut(0.1,0)
    TERM EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TERM E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TERM EEEEEEEEEEEE 0 A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM EEEEEEEEEEE 1 A_FadeIn(0.1)    
    TERM E 1 A_SetShootable
    Goto Normal
  Missile:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfTargetInLOS("UberHexaSG",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	TNT1 A 0 A_Jump(192,"Railgun","BFG9K","BFG10K","DTBFG","RedStar","DTDevastator","Exterminate")
	// TNT1 A 0 A_JumpifCloser(600,"UberHexaSG")
  Normal:   
    TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto Railgun
	TERM G 2 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	TERM H 0 A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TERM H 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"See","Missile")
    TNT1 A 0 A_SpidRefire
	Loop
  UberHexaSG:
	TERM G 5 A_FaceTarget
    TERM GGGGGG 0 A_SpawnItemEx("SSGShellCasing",25,-2,25,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	TNT1 A 0 A_PlaySound("weapons/hsgfire")
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",48,-17,frandom(-6,6),0)
    TERM H 2 Bright A_CustomBulletAttack(15.4,10.6,60,Random(5,9),"TerminatorPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"See","Missile")
    TNT1 A 0 A_SpidRefire
	Loop 
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	//TNT1 A 0 A_Changeflag(reflective,1)
	TNT1 A 0 A_SetUserVar("user_missile", 0)
    TERM EE 10 A_FaceTarget
  RailgunLoop:
	TNT1 A 0 A_JumpIf(user_missile > 40,"RailgunEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TERM E 2 Bright A_FaceTarget
    TERM F 1 Bright A_CustomMissile("CardinalRail",58,26,frandom(-2,3))
	Loop
  RailgunEnd:
	TERM E 15 Bright
	//TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K","DTBFG","RedStar","DTDevastator")
    Goto See	 
  BFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	TERM EEEEEEFF 4 A_FaceTarget
    TERM FFFFF 2 Bright A_CustomMissile("TerminatorBFG9500Ball",48,15,frandom(-4,4))
    TERM EE 4 A_FaceTarget   
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG","RedStar","DTDevastator")
    Goto See
  BFG10K:
	//TNT1 A 0 A_Changeflag(reflective,1)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_missile", 0)
    TERM JJJJJJJ 4 A_FaceTarget
  BFG10KLoop:
	TNT1 A 0 A_JumpIf(user_missile > 40,"BFG10KEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TERM J 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
    TERM K 1 Bright A_CustomMissile("Cardinal10K",48,-15,random(-4,4))
	Loop
  BFG10KEnd:
	TERM J 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TERM JJJJJ 3 A_FaceTarget	   
    TERM J 4 A_FaceTarget
	//TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(128,"DTBFG","RedStar","DTDevastator")
    Goto See
  DTBFG:
	TNT1 A 0 A_Jump(80,"FTwoDT")
	TNT1 A 0 A_PlaySound("Cardinal/9k")
    TERM EEEEEEF 6 A_Facetarget
    TERM FFF 4 Bright A_CustomMissile("CardinalDTBFG10KBall",48,15,random(-10,10))
    TERM EEE 4 A_FaceTarget
	TNT1 A 0 A_Jump(128,"RedStar","DTDevastator")
    Goto See	
  RedStar:
	TNT1 A 0 A_PlaySoundEx("monster/termsit2","TSIGHT")
	TNT1 A 0 A_Jump(80,"FTwoRS")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlayWeaponSound("star/load1")
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlayWeaponSound("star/load2")
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("star/load3")
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TERM E 0 A_FaceTarget
    TERM EEEE 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TERM E 0 A_FaceTarget
	TERM F 0 A_PlayWeaponSound("star/fire")
	TERM F 7 Bright A_CustomMissile("TerminatorRedStar",48,17,0) 
	TERM E 8 A_FaceTarget
	TERM F 0 A_PlayWeaponSound("star/fire")
	TERM F 7 Bright A_CustomMissile("TerminatorRedStar",48,17,0) 
	TERM E 8 A_FaceTarget
	TERM F 0 A_PlayWeaponSound("star/fire")
	TERM F 7 Bright A_CustomMissile("TerminatorRedStar",48,17,0) 
	TERM E 8 A_FaceTarget
	TERM F 0 A_PlayWeaponSound("star/fire")
	TERM F 7 Bright A_CustomMissile("TerminatorRedStar",48,17,0) 
	TERM E 8 A_FaceTarget
	TERM F 0 A_PlayWeaponSound("star/fire")
	TERM F 7 Bright A_CustomMissile("TerminatorRedStar",48,17,0) 
	TERM E 8 A_FaceTarget	   
	TERM E 2 A_Jump(128,"DTDevastator")
    Goto See
  DTDevastator:
    TNT1 A 0 A_PlaySoundEx("monster/termsit2","TSIGHT")
	TNT1 A 0 A_Jump(80,"FTwoDV")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    TERM E 0 A_Facetarget
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	TNT1 A 0 A_SpawnItemEx("TerminatorLineSpawner")
    TERM E 0 A_PlaySound ("devastator/charge")
  DevCharge:
	TNT1 A 0 A_JumpIf(user_missile > 55,"DevFire")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
    TERM E 2 A_Facetarget
	TNT1 A 0 A_SpawnItemEx("TerminatorLineSpawner")
	Loop
  DevFire:
    TERM F 0 A_PlaySound ("devastator/fire")
	TERM F 0 A_CustomMissile("TerminatorDevastator",48,17,frandom(-5,5))
	TERM F 0 A_CustomMissile("TerminatorDevastator",48,17,frandom(-5,5))
    TERM F 10 Bright A_CustomMissile("TerminatorDevastator",48,17,0)
    TERM E 50
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Exterminate:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM A 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM B 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(20,"FTwoRS","FTwoDT","FTwoDV")
	TNT1 A 0 A_SpidRefire
	Loop
  FTwoRS:
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	T3RM C 0 A_FaceTarget
	T3RM C 0 A_PlayWeaponSound("star/fire")
	T3RM D 2 Bright A_CustomMissile("TerminatorRedStar",48,20,0)
	T3RM A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM A 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM B 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM B 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM D 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM D 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM B 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM B 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM D 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM A 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM C 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	T3RM B 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(20,"FTwoRS","FTwoDT","FTwoDV")
	TNT1 A 0 A_SpidRefire
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Loop
  FTwoDT:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	T3RM AB 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FTwoDTLoop:
	T3RM AB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Goto FTwoDTLoop
	T3RM CC 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
 	T3RM C 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	T3RM C 0 A_CustomMissile("CardinalDTBFG10KBall",48,20,0)
	T3RM C 0 A_CustomMissile("CardinalDTBFG10KBall",48,20,30)
	T3RM C 0 A_CustomMissile("CardinalDTBFG10KBall",48,20,-30)
 	T3RM B 0 A_FaceTarget
    T3RM CBABAB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
 	T3RM B 0 A_FaceTarget
	T3RM ABABAB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_Stop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  FTwoDV:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	T3RM A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FTwoDVLoop:
	T3RM ABABAB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	T3RM B 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto FTwoDVLoop	
	T3RM ABABCC 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
 	T3RM C 0 A_FaceTarget
	T3RM A 0 A_PlaySound ("devastator/fire")
	T3RM C 0 A_CustomMissile("TerminatorDevastator",48,20,0)
	T3RM C 0 A_CustomMissile("TerminatorDevastator",48,20,30)
	T3RM C 0 A_CustomMissile("TerminatorDevastator",48,20,-30)
 	T3RM B 0 A_FaceTarget
    T3RM CBABAB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
 	T3RM B 0 A_FaceTarget
	T3RM ABABAB 2 Bright A_CustomMissile("TerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_Stop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Pain:
    TNT1 A 0 A_Jump(60,"Healing")	
    TNT1 A 0 A_Jump(128,"PainMissile")
    TERM L 3 	
    TERM L 3 A_Pain
    Goto See 
  PainMissile: 
    TERM L 3 	
    TERM L 3 A_Pain
    Goto Missile	   
  Pain.PlayerDBFG2:
    TNT1 A 0 A_Jump(128, "ComboTel")
    Goto PainMissile
  Healing:
	TNT1 A 0 A_PlaySound("monster/termsit")
    TNT1 A 0 A_SetInvulnerable
    TERM L 2 HealThing(600)
    TERM LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_SpawnItemEx("TerminatorLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TERM L 10 A_CustomMissile("TerminatorPulse")
    TERM L 5 A_CustomMissile("TerminatorPulse")
    TERM L 2 A_CustomMissile("TerminatorBigPulse")
    TNT1 A 0 A_UnSetInvulnerable
    TERM L 2
    Goto See
  Pain.Legendary:
  Pain.LegendaryPlayer:
  Pain.LegendaryGuruPlayer:
  Pain.PlayerDevBall:
  Pain.PDTBFG:
  Pain.BFG10K:
  Pain.BFG9500Ball:
  Pain.PlayerDBFG10K2:
  Pain.PlayerDBFG2:
    TNT1 A 0 A_Jump(200, "ComboTel")
    Goto PainMissile
  Death:
	TERM M 10 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TERM NNNOOO 5 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("TerminatorNukeDeath",0,0,0,0,0,0,0)
	TERM PPPQQQ 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TERM SSSTTT 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TERM UUUVVV 2 Bright A_CustomMissile("CFKaboom", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))   
	TNT1 A 0 A_SpawnItemEx("BfgUpgrade",0,0,64,frandom(1,8),0,2,frandom(0,360),0,192)
	TNT1 A 0 A_DropItem("TerminatorItem",1,64 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("ExplosiveMinigunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("PyroCannonGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HomingRocketLauncherGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("RapidShotgunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("UnbelieveabilitySphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TERM W 4
	TERM X 6 A_Fall
	TERM Y 6
	TERM Z 1 A_Playsound("Terminator/terstepA")
	TERM Z 5
	TERM [ -1 Bright
	Stop
  }
}

Actor TerminatorPuff : BulletPuff { Species "Cybers" DamageType "Cyber10k" }

Actor TerminatorNukeDeath : DarkDesNuke2 { Species "Cybers" DamageType "Cyber10k" Obituary "$CFTerminatorNukeDeathObit" }

Actor TerminatorNuke : CardinalFusionNuke
{
  Obituary "$CFTerminatorNukeObit"
  +DONTREFLECT
  States
  {
  Death:
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_SpawnItemEx("DarkDesNuke2")
	TNT1 A 0 A_Explode(Random(2500,5000),1024,0,1,666)
    Stop
  }
}

Actor TerminatorGhost
{
  Scale 1.4
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    TERM A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor TerminatorExplosiveTracer : SentientExplosiveTracer
{
  -THRUSPECIES
  +DONTREFLECT
  Species "Cybers"
  DamageType "Cyber10k"
}

Actor TerminatorBFG9500Ball : SentientBFG9500Ball
{
  -THRUSPECIES
  +DONTREFLECT
  Species "Cybers"
  DamageType "Cyber10k"
  States
  {
  Spawn:
    BFR3 AAABBB 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveRed2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom18", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRE3 AB 8 Bright A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BRE3 C 8 Bright A_BFGSpray("DesolatorCustomSprayRed",15,20)
    BRE3 DEF 8 Bright
    Stop    
  }
}

Actor TerminatorRedStar
{
  Radius 12
  Height 12
  Speed 28
  Damage (Random(300,600)) //250
  Scale 3.2
  Species "Cybers"
  DamageType "Cyber10k"
  Projectile
  RenderStyle Add
  +SEEKERMISSILE
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +DONTREFLECT
  +FOILINVUL
  +FORCERADIUSDMG
  +BRIGHT
  Alpha 0.8
  DeathSound "star/explode"
  Obituary "$CFTerminatorRedStarObit"
  States
  {
  Spawn:
    STAR ABCD 2 Bright A_CustomMissile("RedstarFX",0,0,0,0)
    Loop
  Death:
	TNT1 A 0 A_Explode(192,384,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
