	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    RFOG A 3 Bright A_Explode(12,64)
    RFOG BCDEF 3 Bright
    Stop
  }
}

Actor TerminatorLineSpawner : BluePowerLineSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAA 0 A_SpawnItemEx("TerminatorPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("TerminatorPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}
Actor TerminatorDarkLineSpawner : BluePowerLineSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAA 0 A_SpawnItemEx("TerminatorDarkPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("TerminatorDarkPowerLine",frandom(-48,-8),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}
Actor TerminatorPowerLine : RedPowerLine
{
  Scale 0.84
  States
  {
  Spawn:
    SPFX A 5 Bright
    TNT1 A 0 A_Jump(128,"FadeOut2")
  Normal:
    SPFX AAAAAAAA 1 Bright A_FadeOut(0.025)
    Stop
  FadeOut2:
    SPFX AAAAAAAA 1 Bright A_FadeOut(0.03)
    Stop
  }
}

Actor TerminatorDarkPowerLine : BluePowerLine
{
  Scale 0.84
  Translation "80:111=250:254"
  States
  {
  Spawn:
   SPFX A 5 Bright
   TNT1 A 0 A_Jump(128,"FadeOut2")
  Normal:
   SPFX AAAAAAAA 1 Bright A_FadeOut(0.025)
   Stop
  FadeOut2:
   SPFX AAAAAAAA 1 Bright A_FadeOut(0.03)
   Stop
  }
}

Actor TerminatorDevastator : FusionDevastatorBall { Damagetype "Cyber10k" +DONTREFLECT }

