Actor TerminatorPlasmaPuff
{
  Radius 6
  Height 6
  +NOBLOCKMAP
  +NOGRAVITY
  +ACTIVATEIMPACT
  +ACTIVATEPCROSS
  +DONTREFLECT
  +NOTELEPORT 
  +PUFFONACTORS
  +ALWAYSPUFF  
