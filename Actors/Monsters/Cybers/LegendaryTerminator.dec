Actor LegTerminatorStar : TerminatorRedStar
{
  Obituary "$CFLegTerminatorStarObit"
  States
  {
  Spawn:
	LRB1 ABCD 2 Bright A_CustomMissile("BluestarFX",0,0,0,0)
	Loop
  Death:  
	TNT1 A 0 A_Explode(192,384,0)
	 TNT1 A 0 Radius_Quake(15,20,0,20,0)
	 TNT1 A 0 A_SpawnItemEx("BlueDTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	 TNT1 A 20 A_SpawnItem("BlueDTBFGEx",0,-10)
	LRB1 E 3 Bright A_BFGSpray("LegTermCustomSpray2",15,20)
	 LRB1 FGHIJKLMNO 3 Bright
	Stop
  }
}

Actor LegTerminatorPulse : TerminatorPulse
{
  Obituary "$CFLegTerminatorPulseObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Explode(256,256,0,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("BlueDTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 20 A_SpawnItem("BlueDTBFGEx",0,-10)
	LRB1 E 3 Bright A_BFGSpray("LegTermCustomSpray2",15,20)
	LRB1 FGHIJKLMNO 3 Bright
	Stop
  }
}

Actor LegTerminatorBigPulse : TerminatorBigPulse
{
  Obituary "$CFLegTerminatorBigPulseObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Explode(656,656,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("BlueDTech10KShockwave", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 20 A_SpawnItem("BlueDTBFGEx",0,-10)
	LRB1 E 3 Bright A_BFGSpray("LegTermCustomSpray2",15,20)
	LRB1 FGHIJKLMNO 3 Bright
	Stop
  }
}

