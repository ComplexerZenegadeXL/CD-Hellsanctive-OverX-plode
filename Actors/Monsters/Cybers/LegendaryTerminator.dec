Actor LegendaryTerminator : RMTerminator
{
  Health 20000
  Speed 15
  Scale 1.4
  DamageFactor 0.5
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.15
  DamageFactor "Explosion", 0.1
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  BloodColor "Blue"
  DropItem ""
  DropItem "LegendaryRandomSphere" 16 1
  SeeSound "monster/dtermsit" 
  PainSound "monster/dtermpin" 
  DeathSound "monster/termdth"
  AttackSound "plasmaminigun/fire"
  ActiveSound "Terminator/dtermact"
  Obituary "$CFLegendaryTerminatorObit"
  +BRIGHT
  Tag "$CFLegTerm"
  var int user_script;
  var int user_script_type;
  States
  {
  Spawn:
	LTER A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,20)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",19)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  SpawnLoop:
	LTER A 10 A_Look
	TNT1 A 0 A_JumpIfHealthLower(20000,"Idle")
	Loop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("Cyberdemon",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  Idle:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	LTER AA 3 A_Wander
	TNT1 A 0 A_Look
	LTER BB 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_PlaySound("Terminator/terstepA")
	LTER CC 3 A_Wander
	TNT1 A 0 A_Look
	LTER DD 3 A_Wander
	TNT1 A 0 A_PlaySound("Terminator/terstepA")
	TNT1 A 0 A_Look
	TNT1 A 0 A_Jump(52,"Teleport","ComboTel")
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LTER AABB 3 A_Chase
	TNT1 A 0 A_PlaySound("Terminator/terstepA")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,704)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	LTER AABB 3 A_Chase
	TNT1 A 0 A_PlaySound("Terminator/terstepA")
	LTER CCDD 3 A_Chase
	TNT1 A 0 A_PlaySound("Terminator/terstepA")
	TNT1 A 0 A_Jump(52,"Teleport","ComboTel")
	Loop
  Rush:
	LTER A 0 A_PlaySound("Terminator/terstepA")
	LTER AA 0 A_Chase
	LTER A 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER A 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER B 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER B 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)     
	LTER A 0 A_PlaySound("Terminator/terstepA")
	LTER AA 0 A_Chase
	LTER C 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER C 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER D 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER AA 0 A_Chase
	LTER D 2 A_SpawnItemEx("LegendaryTerminatorGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)     
	TNT1 A 0 A_Jump(38,"Teleport","ComboTel")
	TNT1 A 0 A_Jump(75,"See")   
	Loop
  Teleport:
	LTER E 1 A_UnSetShootable
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)
	LTER E 1 A_SetShootable
	Goto Normal
  ComboTel:
	LTER E 1 A_UnSetShootable
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)
	//LTER E 1 A_PlayWeaponSound("boss/teleport")
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)
	//LTER E 1 A_PlayWeaponSound("boss/teleport")
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)
	//LTER E 1 A_PlayWeaponSound("boss/teleport")
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)
	//LTER E 1 A_PlayWeaponSound("boss/teleport")
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeOut(0.1,0)
	LTER EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	LTER E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LTER EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	LTER EEEEEEEEEE 1 A_FadeIn(0.1)    
	LTER E 1 A_SetShootable
	Goto Normal
  Missile:
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfTargetInLOS("UberHexaSG",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,600,0)
	TNT1 A 0 A_Jump(192,"Railgun","BFG9K","BFG10K","DTBFG","RedStar","DTDevastator","OneTwoPunch")
  Normal:   
	TNT1 A 0 A_JumpIfCloser(1500,1)
	Goto Railgun
	LTER G 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", 10, -12, 40, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LTER H 0 A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LTER H 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"See","Missile")
	TNT1 A 0 A_SpidRefire
	Loop 
  UberHexaSG:
	LTER G 5 A_FaceTarget
	LTER GGGGGG 0 A_SpawnItemEx("BlueShellCasing",25,-2,25,frandom(2,4),frandom(-3,-6),frandom(3,6),0)
	TNT1 A 0 A_PlaySound("Weapons/LegAutoShotgun",7)
	TNT1 A 0 A_PlaySound("weapons/hsgfire")
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("LegendaryBlueTracer",48,-17,frandom(6,-6),0)
	LTER H 2 Bright A_CustomBulletAttack(22.5,18.3,60,Random(9,15),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"See","Missile")
	TNT1 A 0 A_SpidRefire
	Loop 
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	TNT1 A 0 A_Changeflag(REFLECTIVE,1)
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	LTER EE 10 A_FaceTarget
   RailgunLoop:
	TNT1 A 0 A_JumpIf(user_missile > 40,"RailgunEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	LTER E 2 Bright A_FaceTarget
	LTER F 1 Bright A_CustomMissile("TrueLegendaryCyberRail",58,26,frandom(-2,3))
	Loop
   RailgunEnd:
	LTER E 15 Bright
	TNT1 A 0 A_ChangeFlag(REFLECTIVE,0)
	TNT1 A 0 A_Jump(128,"BFG9K","BFG10K","DTBFG","RedStar","DTDevastator")
	Goto See		 
  BFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	LTER EEEEEEFF 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG9KLoop:
	LTER F 1 Bright A_CustomMissile("LegTerminatorBFG9500Ball1",48,15,frandom(-4,4))
	LTER F 1 Bright A_CustomMissile("LegTerminatorBFG9500Ball2",48,15,frandom(-4,4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	LTER EE 4 A_FaceTarget   
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG","RedStar","DTDevastator")
	Goto See
  BFG10K:
	TNT1 A 0 A_Changeflag(reflective,1)
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	LTER JJJJJJJ 4 A_FaceTarget
  BFG10KLoop:
	TNT1 A 0 A_JumpIf(user_missile > 40,"BFG10KEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	LTER J 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Legendary10KProjectile",48,-15,frandom(-4,4))
	LTER K 1 Bright A_CustomMissile("TrueLegendary10KProjectile",48,-15,frandom(-4,4))
	Loop
  BFG10KEnd:
	LTER J 3 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	LTER JJJ 6 A_FaceTarget		
	LTER J 4 A_FaceTarget
	TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(128,"DTBFG","RedStar","DTDevastator")
	Goto See	
  DTBFG:
	TNT1 A 0 A_Jump(80,"FTwoDT")
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	LTER EEEEEEF 6 A_FaceTarget
	LTER FFFFF 4 Bright A_CustomMissile("LegAnniDTBFGBall",48,15,frandom(-10,10))
	LTER EEE 4 A_FaceTarget
	LTER A 0 A_Jump(128,"RedStar","DTDevastator")
	Goto See	
  RedStar:
	TNT1 A 0 A_PlaySoundEx("monster/dtermsit","TSIGHT")
	TNT1 A 0 A_Jump(80,"FTwoRS")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_PlayWeaponSound("star/load1")
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_PlayWeaponSound("star/load2")
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	TNT1 A 0 A_PlayWeaponSound("star/load3")
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER E 0 A_FaceTarget
	LTER EEEE 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LTER E 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RedStarLoop:
	LTER F 0 A_PlayWeaponSound("star/fire")
	LTER F 4 Bright A_CustomMissile("LegTerminatorStar",48,17,frandom(-10,10)) 
	LTER E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	LTER E 2 A_Jump(128,"DTDevastator")
	Goto See
  DTDevastator:
	TNT1 A 0 A_PlaySoundEx("monster/dtermsit","TSIGHT")
	TNT1 A 0 A_Jump(80,"FTwoDV")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LTER E 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryLineSpawner")
	LTER E 0 A_PlaySound ("devastator/charge")
  DevCharge:
	TNT1 A 0 A_JumpIf(user_missile > 55,"DevFire")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	LTER E 2 A_Facetarget
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryLineSpawner")
	Loop
  DevFire:
	LTER F 0 A_PlaySound ("devastator/fire")
	LTER FFFF 0 A_CustomMissile("TrueLegCybDevastatorBall",48,17,frandom(-5,5))
	LTER F 10 Bright A_CustomMissile("TrueLegCybDevastatorBall",48,17,0)
	LTER E 50
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	//TNT1 A 0 A_Jump(10,"Nuke")
	Goto See
  OneTwoPunch:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R AB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(20,"FTwoRS","FTwoDT","FTwoDV")
	TNT1 A 0 A_SpidRefire
	Loop
  FTwoRS:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	LT3R C 0 A_FaceTarget
	LT3R C 0 A_PlayWeaponSound("star/fire")
	LT3R D 2 Bright A_CustomMissile("LegTerminatorStar",48,20,0)
	LT3R A 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R A 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LT3R B 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R B 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LT3R D 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R D 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LT3R B 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R B 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LT3R D 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R A 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	LT3R C 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("YellowShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	LT3R B 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
	TNT1 A 0 A_StopSoundEx("Weapon")
	TNT1 A 0 A_Jump(20,"FTwoRS","FTwoDT","FTwoDV")
	TNT1 A 0 A_SpidRefire
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Loop
  FTwoDT:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	LT3R AB 0 A_FaceTarget
	LT3R ABABABABABCC 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,frandom(-8,8))
 	LT3R C 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	LT3R C 0 Bright A_CustomMissile("LegAnniDTBFGBall",48,20,0)
	LT3R C 0 Bright A_CustomMissile("LegAnniDTBFGBall",48,20,30)
	LT3R C 0 Bright A_CustomMissile("LegAnniDTBFGBall",48,20,-30)
 	LT3R B 0 A_FaceTarget
    LT3R CBABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
 	LT3R B 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	TNT1 A 0 A_Stop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  FTwoDV:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
 	LT3R A 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	LT3R B 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	LT3R B 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	LT3R B 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	LT3R B 0 A_FaceTarget
	LT3R ABABCC 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
    LT3R C 0 A_FaceTarget
	LT3R A 0 A_PlaySound ("devastator/fire")
	LT3R C 0 A_CustomMissile("TrueLegCybDevastatorBall",48,20,0)
	LT3R C 0 A_CustomMissile("TrueLegCybDevastatorBall",48,20,30)
	LT3R C 0 A_CustomMissile("TrueLegCybDevastatorBall",48,20,-30)
 	LT3R B 0 A_FaceTarget
    LT3R CBABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
 	LT3R B 0 A_FaceTarget
	LT3R ABABAB 2 Bright A_CustomMissile("LegTerminatorExplosiveTracer",48,-17,Random(-8,8))
	TNT1 A 0 A_Stop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Pain:
	TNT1 A 0 A_Jump(60,"Healing")	
	TNT1 A 0 A_Jump(128,"PainMissile")
	LTER L 3 	
	LTER L 3 A_Pain
	Goto See 
  PainMissile: 
	LTER L 3 	
	LTER L 3 A_Pain
	Goto Missile	   
  Healing:
	TNT1 A 0 A_PlaySound("monster/termsit")
	TNT1 A 0 A_SetInvulnerable
	LTER L 2 HealThing(550)
	LTER LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL 2 Bright A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LTER L 10 A_CustomMissile("LegTerminatorPulse")
	LTER L 5 A_CustomMissile("LegTerminatorPulse")
	LTER L 2 A_CustomMissile("LegTerminatorBigPulse")
	TNT1 A 0 A_UnSetInvulnerable
	LTER L 2
	Goto See
  Pain.Legendary:
  Pain.LegendaryPlayer:
  Pain.LegendaryGuruPlayer:
  Pain.PlayerDevBall:
  Pain.PDTBFG:
  Pain.BFG10K:
  Pain.BFG9500Ball:
  Pain.PlayerDBFG10K2:
  Pain.PlayerDBFG2:
  	TNT1 A 0 A_Jump(96, "ComboTel")
	Goto PainMissile
  Death:
	LTER M 10 A_Scream
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LTER NNNOOO 5 Bright A_CustomMissile("PainfulDeathKaboom",frandom(10,60),frandom(30,-30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("LegTerminatorNukeDeath",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	LTER PPPQQQ 2 Bright A_CustomMissile("PainfulDeathKaboom",frandom(10,60),frandom(30,-30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LTER SSSTTT 2 Bright A_CustomMissile("PainfulDeathKaboom",frandom(10,60),frandom(30,-30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LTER UUUVVV 2 Bright A_CustomMissile("PainfulDeathKaboom",frandom(10,60),frandom(30,-30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LTER W 4 A_ChangeFlag("BRIGHT",0)
	TNT1 A 0 A_SpawnItemEx("BlackholeGeneratorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BFGUpgrade",0,0,64,frandom(1,8),0,2,frandom(0,360),0,192)
	TNT1 A 0 A_DropItem("TerminatorItem",1,64 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	//TNT1 A 0 A_SpawnItemEx("LegendaryAssaultShotgunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryCoachgunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryLightMachineGunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryPlasmaticRifleGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryBFG10KGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryPlasmaticCannonGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryBFGGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("TrueLegendaryUltraSphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("UnbelieveabilitySphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	TNT1 A 0 A_DropItem("LegendaryDust",random(5,10),256)
	LTER X 6 A_Fall
	LTER Y 6
	LTER Z 1 A_PlaySound("Terminator/terstepA",CHAN_BODY)
	LTER Z 5 A_BossDeath
	LTER [ -1
	Stop
  }
}

Actor LegTermSmokeSpawner : RedParticleSpawner
{
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAA 0 A_SpawnItemEx("AHellionSmoke",frandom(-20,20),frandom(-20,20),frandom(12,100),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop		
  }
}

Actor LegTerminatorExplosiveTracer : LegSentientExplosiveTracer
{
  Species "Cybers"
  DamageType "Legendary"
  Obituary "$CFLegTerminatorExplosiveTracerObit"
}

Actor LegTerminatorNukeDeath : LegZombieSuicideBomb
{
  Species "Cybers"
  DamageType "Legendary"
  Obituary "$CFLegTerminatorNukeDeathObit"
}

Actor LegendaryTerminatorGhost
{
  Scale 1.4
  RenderStyle Translucent
  Alpha 0.75
  +NOTIMEFREEZE
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
 +CLIENTSIDEONLY
   +NONETID
  States
  {
  Spawn:
	TNT1 A 1
	LTER A 2 A_FadeOut(0.18,1)
	Goto Spawn+1
  }
}

Actor LegTerminatorBFG9500Ball1 : TLegCyberBFG9500Ball
{
  -THRUSPECIES
  +DONTREFLECT
  +FORCERADIUSDMG
  Species "Cybers"
  DamageType "Legendary"
  Obituary "$CFLegTerminatorBFG9500Ball1Obit"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_Explode(random(200,300),128,0,0)
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAAAA 0 A_CustomMissile("KaboomBlue", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	QRE3 AB 8 Bright A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	QRE3 C 8 Bright A_BFGSpray("LegTermCustomSpray2",15,20)
	QRE3 DEF 8 Bright
	Stop    
  }
}

Actor LegTerminatorBFG9500Ball2 : LegCyberBFG9500Ball
