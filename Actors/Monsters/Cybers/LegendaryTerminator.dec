	TNT1 AAAAAA 0 A_CustomMissile("KaboomGold", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	LFE3 AB 8 Bright A_SpawnItemEx("LegendaryGoldParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	LFE3 C 8 Bright A_BFGSpray("LegTermCustomSpray",15,20)
	LFE3 DEF 8 Bright
	Stop    
  }
}

