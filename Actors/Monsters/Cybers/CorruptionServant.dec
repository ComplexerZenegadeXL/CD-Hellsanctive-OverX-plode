Actor CorruptionServant
{
  Health 2500
  PainChance 10
  MeleeDamage 18
  Radius 24 
  Height 64 
  Mass 2000 
  Monster
  Speed 10 
  Scale 1.2
  BloodColor "DarkRed"
  Species "Nobles"
  DamageFactor "Hell", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Cyber10K", 0.0
  +NOTARGET
  +NOINFIGHTING
  +QUICKTORETALIATE
  +FLOORCLIP 
  +FASTMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  +NOICEDEATH
  DropItem "NewMaxHealthBonus", 200, 16
  DropItem "NewMaxArmorBonus", 200
  DropItem "DemonAmmoBoxPickup", 180, 200
  DropItem "ModdedSoulSphere", 60
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "ModdedSoulSphere" 64
  Obituary "$CFCorruptionServantObit"
  HitObituary "$CFCorruptionServantHitObit"
  SeeSound "monster/ar2sit" 
  ActiveSound "superbaron/act"
  PainSound "superbaron/pain"
  DeathSound "monster/ar2dth"
  MeleeSound "baron/melee"
  Tag "$CFCorrServ"
  var int user_lowlag;
  States 
  { 
  Spawn: 
    MDCS A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	MDCS A 10 Bright A_Look
    Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	MDCS AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1) 
    TNT1 A 0 A_Jump(100,"rush")
    MDCS AABB 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
    MDCS CCDD 3 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  Rush:
    TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS A 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS A 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS B 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS B 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS C 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS C 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase  
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS D 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    MDCS D 2 A_SpawnItemEx("MCTGHOST",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	MDCS AAAA 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("ServantFWSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
    TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Missile:  
	TNT1 A 0 A_Jump(100,"WComets","Spikes","MfireBalls","SComets","SBomb","DMatter","IceMissile","SnowStorm")
  Normal:
    MDCS EF 6 Bright A_FaceTarget 
	MDCS G 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, -3)
	MDCS G 8 Bright A_CustomMissile("NobleCorruptBaronBall", 32, 0, 5)
    MDCS IJ 6 Bright A_FaceTarget 
	MDCS K 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleCorruptBaronBall", 32, 0, -3)
	MDCS K 8 Bright A_CustomMissile("NobleCorruptBaronBall", 32, 0, 5)
	TNT1 A 0 A_Jump(100,"Wcomets","MfireBalls","Spikes","SComets","SBomb","Dmatter","IceMissile","SnowStorm")
    Goto See
  WComets:
    MDCS MN 8 A_FaceTarget
	MDCS O 0 A_CustomMissile("NobleWComet", 32, 0, 0)
	MDCS O 0 A_CustomMissile("NobleWComet", 32, 0, -5)
	MDCS O 0 A_CustomMissile("NobleWComet", 32, 0, 5)
	MDCS O 7 Bright A_CustomMissile("NobleWComet", 32, 0, 10)
	Goto Missile
  MFireBalls:
	MDC3 EF 6 Bright A_FaceTarget 
	MDC3 G 0 A_CustomMissile("NobleMiniFireBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, -3)
	MDC3 G 8 Bright A_CustomMissile("NobleMiniFireBall", 32, 0, 5)
    MDC3 IJ 6 Bright A_FaceTarget 
	MDC3 K 0 A_CustomMissile("NobleMiniFireBall", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleMiniFireBall", 32, 0, -3)
	MDC3 K 8 Bright A_CustomMissile("NobleMiniFireBall", 32, 0, 5)
	TNT1 A 0 A_Jump(100,"SComets","SBomb")
    Goto See
  SComets:
    MDC3 EF 6 Bright A_FaceTarget 
	MDC3 G 0 A_CustomMissile("Comet", 32, 0, 0)
	MDC3 G 0 A_CustomMissile("Comet", 32, 0, 5)
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, -5)
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, 8)
	MDC3 K 8 A_CustomMissile("Comet", 32, 0, -8)
    MDC3 IJ 6 A_FaceTarget 
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, 0)
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, 5)
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, -5)
	MDC3 K 0 A_CustomMissile("Comet", 32, 0, 8)
	MDC3 K 8 A_CustomMissile("Comet", 32, 0, -8)
	Goto See
  SBomb:
	MDC3 MN 8 Bright A_FaceTarget 
	MDC3 O 6 Bright A_CustomMissile("NoblePyroBlast", 32, 0, 0)
    TNT1 A 0 A_Jump(100,"IceMissile")
	Goto See
  Spikes:
	MDC2 MN 8 A_FaceTarget
	MDC2 O 0 A_CustomMissile("CIceSpikeSpawner", 32, 0, 0)
	MDC2 O 0 A_CustomMissile("CIceSpikeSpawner", 32, 0, -3)
	MDC2 O 0 A_CustomMissile("CIceSpikeSpawner", 32, 0, -5)
	MDC2 O 0 A_CustomMissile("CIceSpikeSpawner", 32, 0, 3)
	MDC2 O 8 Bright A_CustomMissile("CIceSpikeSpawner", 32, 0, 5)
	Goto See
  IceMissile:
    MDC2 EF 6 Bright A_FaceTarget 
	MDC2 G 0 A_CustomMissile("NobleFrostmissile3", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, -3)
	MDC2 G 8 Bright A_CustomMissile("NobleFrostmissile3", 32, 0, 5)
    MDC2 IJ 6 Bright A_FaceTarget 
	MDC2 K 0 A_CustomMissile("NobleFrostmissile3", 32, 0, 0)		
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, -5)
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, 3)
	TNT1 A 0 A_CustomMissile("NobleFrostmissile3", 32, 0, -3)
	MDC2 K 8 Bright A_CustomMissile("NobleFrostmissile3", 32, 0, 5)
	TNT1 A 0 A_Jump(100,"SnowStorm")
	Goto See
  SnowStorm:
	MDC2 MN 8 Bright A_FaceTarget 
	MDC2 O 6 Bright A_CustomMissile("NobleSnowStormBomb3", 32, 0, 0)
	TNT1 A 0 A_Jump(80,"Spikes")
	Goto See
  DMatter:
	MDC4 MN 8 Bright A_FaceTarget 
	MDC4 O 0 A_CustomMissile("DarkMatterBallRM", 32, 0, 0)
	MDC4 O 0 A_CustomMissile("DarkMatterBallRM", 32, 0, 5)
	MDC4 O 8 Bright A_CustomMissile("DarkMatterBallRM", 32, 0, -5)
	TNT1 A 0 A_Jump(100,"Missile")
	Goto See	   
  Melee:
    TNT1 A 0 A_Jump(80,"FireHands")
    MDCS EF 8 Bright A_FaceTarget 
    MDCS G 5 Bright A_MeleeAttack	
	MDCS IJ 8 Bright A_FaceTarget 
    MDCS K 5 Bright A_MeleeAttack	
	MDCS MN 8 Bright A_FaceTarget
	MDCS O 0 A_MeleeAttack
    MDCS O 5 Bright A_MeleeAttack	
    Goto See
  FireHands:
    MDC3 EF 8 Bright A_FaceTarget 
	MDC3 G 0 A_CustomMissile("ExplosiveMelee", 32, 0, 0)
    MDC3 G 2 Bright A_CustomMeleeAttack(30,"Pyro/FlamePoof","pyro/blastexplosion",1)
	MDC3 IJ 8 Bright A_FaceTarget 
	MDC3 K 0 A_CustomMissile("ExplosiveMelee", 32, 0, 0)
    MDC3 K 5 Bright A_CustomMeleeAttack(30,"Pyro/FlamePoof","pyro/blastexplosion",1)
	MDC3 MN 8 Bright A_FaceTarget 
    MDC3 OOO 0 A_CustomMissile("ExplosiveMelee", 32, 0, 0)
    MDC3 O 5 Bright A_CustomMeleeAttack(50,"Pyro/FlamePoof","pyro/blastexplosion",1)
	Goto See
  Pain: 
    MDCS Q 8 Bright A_Pain 
	TNT1 A 0 A_Jump(80,"Evade")
    Goto See
  Evade:
    MDCS E 1 A_FaceTarget
	MDCS E 0 A_SetAngle(angle+random(0,359))
	MDCS E 0 A_Recoil(-50)
	MDCS E 0 A_FaceTarget
	MDCS EEEEEEEEEEEEE 1 A_SpawnItemEx("MCTGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	Goto See
  XDeath:
  Death:
	MDCS R 8 Bright
	MDCS S 7 Bright A_Scream 
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
	MDCS U 5 Bright A_Fall 
	MDCS VW 5 Bright
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	MDCS X 4 Bright A_CustomMissile("PyroSoul",86,0,0,2,90)
	MDCS Z 4 Bright
	Stop
  XRaise:
  Raise:
	Stop
  } 
}

Actor CorruptionServantStandalone : CorruptionServant
{
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "ModdedSoulSphere" 64
  States
  {
  Death:
	MDCS R 8 Bright
	MDCS S 7 Bright A_Scream 
	TNT1 AAA 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
	MDCS U 5 Bright A_Fall 
	MDCS VW 5 Bright
	TNT1 AAAA 0 A_CustomMissile("SmokeFX", frandom(30,60), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	MDCS X 4 Bright A_CustomMissile("PyroSoul",86,0,0,2,90)
	MDCS Z 4 Bright
	TNT1 A 1 A_KillMaster
	Stop
  }
}

Actor SummonedCorruptionServantStandalone : CorruptionServantStandalone { -COUNTKILL }

Actor NobleCorruptBaronBall : CorruptBaronBall { DamageType "NobleComet" }

Actor NobleWComet : WComet { DamageType "NobleComet" }

Actor NobleMiniFireBall : MiniFireBall
{
  DamageType "NobleComet"
  Species "Nobles"
}

Actor NobleSnowStormBomb3 : SnowStormBomb3
{
  DamageType "NobleComet"
  Species "Nobles"
  -THRUSPECIES
  States
  {
  Death:
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	SHEX G  0 A_CustomMissile("NobleFrostbite",12,0,user_loop * 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 21,2)
    TNT1 A 0 A_Jump(256,"DeathLoop")
	SHEX DCEFG 3 Bright
    Stop
  }
}

Actor NobleFrostbite : Frostbite
{
  DamageType "NobleComet"
  Species "Nobles"
  -THRUSPECIES
}

Actor NobleFrostmissile3 : Frostmissile3
{
  DamageType "NobleComet"
  Species "Nobles"
  -THRUSPECIES
}

Actor NoblePyroBlast : PyroBlast
{
  DamageType "NobleComet"
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    SBL2 K 0 A_CustomMissile("NobleFirebombExplosion1",1,0,45)
    SBL2 K 0 A_CustomMissile("NobleFirebombExplosion1",1,0,135)
    SBL2 K 0 A_CustomMissile("NobleFirebombExplosion1",1,0,225)
    SBL2 K 0 A_CustomMissile("NobleFirebombExplosion1",1,0,315)
    SBL2 LMNOPQRSTUVW 1 Bright
    Stop
  }
}

Actor NobleFirebombExplosion1 : FirebombExplosion1
{
  DamageType "NobleComet"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	FRME A 0 A_PlaySound("pyro/blastexplosion")
	FRME A 3 Bright A_Explode
	FRME B 1 Bright A_Mushroom("PPyroball",8,MSF_STANDARD|MSF_DONTHURT)
	FRME B 2 Bright A_CustomMissile("NobleFirebombExplosion2",25,0,180)
	FRME CDEFGHIJKLMNOPQRS 3 Bright
	Stop
  }
}

Actor NobleFirebombExplosion2 : FirebombExplosion2
{
  DamageType "NobleComet"
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    FRME A 0
    FRME A 0 A_PlaySound("pyro/blastexplosion")
    FRME A 3 Bright A_Explode(64,136)
    FRME B 1 Bright
    FRME B 2 Bright A_CustomMissile("NobleFirebombExplosion3",20,0,180)
    FRME CDEFGHIJKLMNOPQRS 3 Bright
    Stop
  }
}

Actor NobleFirebombExplosion3 : FirebombExplosion3 { DamageType "NobleComet" }

Actor MCtGhost
{
  Scale 1.2
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    MDCS A 0 A_SpawnItemEx("MCTWalkFire",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    MDCS A 2 A_FadeOut(0.09)
    Loop
  }
}

Actor MCTWalkFire : CtWalkFire
{
  Scale 1.2
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    NQTF ABC 3 Bright
    TNT1 A 0 A_Jump(191,3)
    TNT1 A 0 A_CustomMissile("MCTWalkFire", 0, 24, 0)
    TNT1 A 0 A_CustomMissile("MCTWalkFire", 0, -24, 0)
    NQTF DEFGHIJKLMNO 3 Bright
    Stop
  }
}

Actor ServantFWSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_SpawnItemEx("CardinalFire",frandom(-20,20),frandom(-30,30),frandom(20,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}