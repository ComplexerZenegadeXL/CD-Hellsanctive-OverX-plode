    ARCR H 4 Bright A_SpawnItemEx("ArcradimusSuperMeteorSpawner",frandom(-768,-512),frandom(-1280,-1024),0,0,0,0,SXF_NOCHECKPOSITION,0) // (1250,-1250)
    ARCR H 4 Bright A_SpawnItemEx("ArcradimusSuperMeteorSpawner",frandom(-768,-512),frandom(1024,1280),0,0,0,0,SXF_NOCHECKPOSITION,0) // (1250,-1250)
    ARCR A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	ARCR H 107 Bright
	Goto See
  Melee:
    ARCR EF 8 Bright A_FaceTarget 
    ARCR G 6 Bright A_MeleeAttack
    ARCR G 0 A_Jump (128,1)
    Goto See
    ARCR ST 8 Bright A_FaceTarget 
    ARCR U 6 Bright A_MeleeAttack
    ARCR G 0 A_Jump (64,1)
    Goto See
    ARCR HI 8 Bright A_FaceTarget
    ARCR J 0 A_MeleeAttack
    ARCR J 6 Bright A_MeleeAttack
    Goto See
  Pain: 
    ARCR K 2 Bright
    ARCR K 2 Bright A_Pain 
    Goto See 
  Death.PlayerIce:
  Death:
	ARCR L 8 A_StopSound(6)
	ARCR M 8 A_Scream 
	ARCR N 8 
	ARCR O 8 A_NoBlocking 
	TNT1 A 0 A_DropItem("TerminatorItem",1,32 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("PyroCannon",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	ARCR PQ 8 
	ARCR R -1 
	Stop
  } 
}
Actor CFNuke
{
  Radius 8
  Height 10
  +NOBLOCKMAP
  +NOGRAVITY
  +FORCERADIUSDMG
  +FORCEYBILLBOARD
  Species "Cybers"
  DamageType "Cyber10K"
  Scale 3.0
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_SetTranslucent(0.75,1)
    TNT1 A 0 A_PlaySoundEx("Nuke/Boom", "Voice", 0, 2)
    TNT1 A 1 //A_Explode(5000, 512, 1)
    TNT1 A 0 Radius_Quake(7, 105, 0, 50, 0)
    TNT1 A 0 A_SpawnItemEx("CFNukeFlare", 0, 0, 0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("CFNukeFlare", 0, 0, 0,0,0,0,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("CFNukeSmokePillar", 0, 0, 0,0,0,4.8,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("NukeMushroom2", 0, 0, 0,1.5,0,5,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("NukeMushroom2", 0, 0, 0,1.5,0,5,90,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("NukeMushroom2", 0, 0, 0,1.5,0,5,180,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("NukeMushroom2", 0, 0, 0,1.5,0,5,270,SXF_CLIENTSIDE,0)
    NKE1 ABCDEFGHIJKLMN 9 Bright
    TNT1 A 0 A_SpawnItemEx("CFNukeMushroom", 0, 0, 500,0,0,0.5,0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("CFNukeSmokeMushroom", 0, 0, 500,0,0,0.5,0,SXF_CLIENTSIDE,0)
    NKE1 OPQRSTU 8 Bright A_FadeOut(0.05)
    Stop
  }
}

