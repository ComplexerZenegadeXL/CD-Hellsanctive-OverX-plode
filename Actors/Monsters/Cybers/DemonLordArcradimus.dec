Actor SFX_Explosion_m_Base
{
  +NOBLOCKMAP
  -COUNTITEM
  Projectile
  DeathSound "effects/explosion"
  SpawnID 203
  Radius 1
  Height 1
  Speed 0
  States
  {
  Spawn:
	TNT1 A 1 A_AlertMonsters
	TNT1 A 0 Radius_Quake(3, 28, 1, 4, 0)
	TNT1 A 0 A_Explode(128, 256)
	Goto Death
  Death:
	TNT1 A 0 A_Scream
	TNT1 A 1 A_SpawnItemEx("SFX_NoLight_ExpFire", 0, 0, 0, frandom(-2, 2), random(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)
	//TNT1 AAAA 0 A_SpawnItemEx("SFX_NoLight_ExpFire", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)					
	TNT1 AAAA 1 A_SpawnItemEx("SFX_NoLight_ExpFire_long", 0, 0, 0, 0.3 * frandom(-2, 2), 0.3 * frandom(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)
	TNT1 A 1 A_SpawnItemEx("SFX_NoLight_ExpFire_long", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)
	TNT1 AAAA 1 A_SpawnItemEx("SFX_NoLight_ExpFire", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)
	//TNT1 AAAA 0 A_SpawnItemEx("SFX_NoLight_ExpFire", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-2, 2), 0, SXF_CLIENTSIDE, 0)
	TNT1 A 5
	Stop
  }
}

