Actor ArcradimusSeekerComet : Comet
{
  Decal "Scorch"
  Speed 34
  Projectile
  +SEEKERMISSILE
  +DOOMBOUNCE
  +DONTSPLASH
  BounceCount 8
  BounceFactor 1
  Species "Cybers"
  DamageType "Cyber10K"
  States
  {
  Spawn:
	ARCM AAABBBCCCAAABBBCCCAAABBBCCCAAABBBCCC 1 Bright A_SpawnItemEx("ArcradimusCometTail")
	TNT1 A 0 A_SeekerMissile(90,90)
	ARCM ABC 1 Bright A_SpawnItemEx("ArcradimusCometTail")
	TNT1 A 0 A_SeekerMissile(90,90)
	ARCM ABC 1 Bright A_SpawnItemEx("ArcradimusCometTail")
	TNT1 A 0 A_SeekerMissile(90,90)
	ARCM ABC 1 Bright A_SpawnItemEx("ArcradimusCometTail")
  Fly:
	ARCM ABC 1 Bright A_SpawnItemEx("ArcradimusCometTail")
	Loop
  Death:
	TNT1 A 0 A_Explode(64,102)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	ARCM D 3 Bright A_SpawnItemEx("ArcradimusCometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	ARCM E 3 Bright A_SpawnItemEx("ArcradimusCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

