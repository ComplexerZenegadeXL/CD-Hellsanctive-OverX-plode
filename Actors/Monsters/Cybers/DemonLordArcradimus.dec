Actor SuperMeteor_m
{
  Scale 0.16
  Decal "Scorch"
  Projectile
  Speed 6
  +MTHRUSPECIES
  -NOGRAVITY
  -FLOAT
  +FLOORCLIP
  +DONTHURTSPECIES
  +SPAWNCEILING
  Species "Cybers"
  DamageType "Cyber10K"
  Radius 32 
  Height 32 
  RenderStyle Add
  SeeSound "Meteor/Fall" // "comet/launch"
  //DeathSound "Meteor/Crash"
  Damage (Random(50,90)) //20
  States
  {
  Spawn:
	EXN1 A 0
	EXN1 A 0 A_SpawnItemEx("SuperMeteor_m_FX", 0, 0, 0, frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	EXN1 A 1 Bright A_SpawnItemEx("SuperMeteor_m_TrailFX_Smoke", 0, 0, 0, frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	Loop
  Death:
	TNT1 A 0 // A_AlertMonsters
	TNT1 A 0 Radius_Quake(3, 28, 1, 4, 0)
    TNT1 A 0 A_PlaySound("Meteor/Crash")
	TNT1 A 0 A_Explode(random(160,170),192)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, Random(0,359))
	Goto EndAnimation
  EndAnimation:
	TNT1 A 0 A_SpawnItemEx("SuperMeteor_m_Explosion", 0, 0, 0, 0, 0, 0, -1, SXF_NOCHECKPOSITION)//A_CustomMissile("Meteor_m_Explosion",0+Random(5,80),0+Random(35,-35),0+Random(0,370))
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke", 0, 0, 0, frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	Stop
  }
}


