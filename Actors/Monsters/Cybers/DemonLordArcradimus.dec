  FloorSweep:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FloorSweepLoop:
    ARCR H 2 Bright A_SpawnItemEx("ArcradimusFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 14,1)
	Goto FloorSweepLoop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  FloorSweepLoop2:
	ARCR I 2 Bright A_SpawnItemEx("ArcradimusFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
