	TNT1 A 0 A_SpawnItemEx("ArcradimusFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ARCR AAA 0 A_Chase
    ARCR D 2 Bright A_SpawnItemEx("ArcradimusGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(25,"Teleport")
	TNT1 A 0 A_Jump(75,"See")	
    Loop	
  Teleport:
    ARCR A 1 Bright A_UnSetShootable
	ARCR AAAAAAAAAAAAA 0 A_SpawnItemEx("ArcradimusFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ARCR AAAAAAAAAA 1 A_FadeOut(0.1,0)
	ARCR AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    ARCR A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	ARCR AAAAAAAAAAAAA 0 A_SpawnItemEx("ArcradimusFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ARCR AAAAAAAAAA 1 A_FadeIn(0.1)
    ARCR A 1 Bright A_SetShootable
    Goto See
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_CheckFlag("FRIENDLY",5)
	TNT1 A 0 A_JumpIf(user_HellPortal == 1,2)
	TNT1 A 0 A_JumpIfHealthLower(7500,"HellPortal")
	TNT1 A 0 A_JumpIf(user_HellPortal2 == 1,2)
	TNT1 A 0 A_JumpIfHealthLower(3750,"HellPortal2")
	TNT1 A 0 A_Jump(168,"ArcradComets")
	TNT1 A 0 A_Jump(50,"BFG")
	TNT1 A 0 A_Jump(162,"SuperFallingMeteors","FireBombs","CometCombo","FloorSweep")
  Normal:
	ARCR EF 4 Bright A_FaceTarget 
