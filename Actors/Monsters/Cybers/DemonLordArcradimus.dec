	TNT1 AA 0 A_SpawnItemEx("CFThunderSpawner", frandom(-96,96), frandom(-96,96), frandom(48,96), 0, 0, 0, frandom(0,360))
	ARCR H 35 Bright A_SpawnItemEx("ArcradimusBallCharging1", 32, 0, 92)
	TNT1 A 0 A_SpawnItemEx("CFThunderSpawner", frandom(-64,64), frandom(-64,64), frandom(48,96), 0, 0, 0, frandom(0,360))
