Actor Cardihilator : CFAnnihilator 16567
{ 
  //$Category Monsters/LCA
  //$Sprite CARHA1
  //$Title "Cardihilator"
  Radius 40
  Mass 2500
  Health 6500
  Speed 10
  FloatSpeed 8
  PainChance 15
  PainChance "PDTBFG", 10
  PainChance "SoulToxic", 3
  PainChance "FatFlamer", 3
  PainChance "FiendFire", 3
  PainChance "Explosion", 35
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.1
  DamageFactor "PDTBFGTracer", 0.3
  DamageFactor "PlayerDevBall", 0.05
  DamageFactor "PlayerDevBall2", 0.05
  DamageFactor "PlayerDevTracer", 0.05
  DamageFactor "DBFG2", 0.0
  DropItem "BossLifeEssence" 204 25
  DropItem "BossArmorBonusMax" 204 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonicChaliceGiver" 64
  SeeSound "Cardihilator/Sight"
  PainSound "Cardihilator/Pain"
  DeathSound "Cardihilator/Death"
  ActiveSound "Cardinal/Active"
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +BOSS
  +BOSSDEATH
  +FLOAT
  +NOGRAVITY
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  -FLOORCLIP
  Obituary "$CFCardihilatorObit"
  Tag "$CFCardihi"
  var int user_loop;
  var int user_fusionnuke;
  var int user_script;
  var int user_script_type;
  States 
  { 
  Spawn:
	CARH A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,35)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",34)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
    CARH AB 2 Bright A_Look	  
    Loop
  See:
    CARH AB 2 Bright A_Chase  
    Loop
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K","Devastator")
	TNT1 A 0 A_Jump(8,"Nukes")
  Normal:
    CARH C 6 Bright A_FaceTarget   
	TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
	CARH D 2
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
    CARH C 4 Bright A_FaceTarget	  
    TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
	CARH D 2
    CARH C 4 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
	CARH D 2 Bright
    CARH C 4 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
	CARH D 2 Bright 
    CARH C 4 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("CardinalRocket", 40, -26, frandom(-6, 6))
    CARH D 6 Bright A_CustomMissile("CardinalRocket", 40, 26, frandom(-6, 6))
	CARH DC 4 Bright
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K")
    Goto See
  Seekers:
    CARH C 6 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH D 2 Bright
    CARH C 4 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH D 2 Bright
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH D 2 Bright
    CARH CC 2 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH D 2 Bright
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH D 2 Bright
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, -26, frandom(-8, 8))
    CARH D 6 Bright A_CustomMissile("CardinalHomingRocket", 40, 26, frandom(-8, 8))
	CARH DC 4 Bright
	TNT1 A 0 A_Jump(128,"Railgun","BFG10K","DTBFG10K")
    Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    CARH CCCCCCCCC 4  A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalRail",40,-26,0)
    CARH D 2 Bright A_CustomMissile("CardinalRail",40,26,0)
    CARH D 6 Bright A_FaceTarget
    CARH D 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalRail",40,-26,0)
    CARH D 2 Bright A_CustomMissile("CardinalRail",40,26,0)
    CARH C 14 Bright
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See	  
  BFG10K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	CARH CCCCCCC 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
    CARH C 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_CustomMissile("Cardinal10K", 40, -26, frandom(-4, 4))
    CARH D 3 Bright A_CustomMissile("Cardinal10K", 40, 26, frandom(-4, 4))
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	CARH CCCCC 4 Bright
	TNT1 A 0 A_Jump(128,"DTBFG10K")
    Goto See	  
  DTBFG10K:
   	TNT1 A 0 A_PlaySound("Cardinal/9k")
	CARH CCCCCDD 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("CardinalDTBFG10KBall", 40, -26, 0)
    CARH D 4 Bright A_CustomMissile("CardinalDTBFG10KBall", 40, 26, 0)	
	CARH DCC 4 Bright
    Goto See
  Devastator:
	TNT1 A 0 A_PlaySound("devastator/charge")
	CARH CCCCCCCCCCCCCCCCCCCCCCCC 4 Bright A_FaceTarget
	CARH C 0 A_PlaySound ("devastator/fire")
	TNT1 A 0 A_CustomMissile("FusionDevastatorBall", 40, -26, 0)
    CARH D 4 Bright A_CustomMissile("FusionDevastatorBall", 40, 26, 0)
	CARH DCC 4 Bright
    Goto See  
  Nukes:
    TNT1 A 0 A_JumpIf(user_fusionnuke == 1, "Missile")
    TNT1 A 0 A_SetUserVar("user_fusionnuke", 2)
	TNT1 A 0 A_PlaySound("weapons/nuclearmissilecharge",0,10.0)
	CARH F 3 Bright A_PlaySound("Cardihilator/Sight", CHAN_AUTO, 1.0, False, ATTN_NONE)
	TNT1 A 0 Radius_Quake(50,150,0,24,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NukesLoop:
	CARH FF 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CardinalRageFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 28,1)
	Goto NukesLoop
	TNT1 A 0 A_PlaySoundEx("Cardihilator/NukeFire", 1, 0, 2)
	CARH D 0 A_CustomMissile("CardinalFusionNuke", 40, -26, 0)
	CARH D 6 Bright A_CustomMissile("CardinalFusionNuke", 40, 26, 0)
	//TNT1 A 1 A_TakeInventory("FusionNuke",1)
	CARH CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC 4 Bright A_SpawnItemEX("CardinalFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(16,"PainRage")
	TNT1 A 0 A_Jump(128,"PainMissile")
    CARH E 3 Bright A_Pain
    CARH E 6 Bright
    Goto See
  PainMissile:
    CARH E 3 Bright A_Pain
    CARH E 6 Bright
    Goto Missile
  PainRage:
	TNT1 A 0 A_JumpIfCloser(1000,1)
	Goto Pain+1
    CARH E 3 Bright A_Pain
	TNT1 A 0 A_JumpIfInventory("CardinalToken",3,"See")	
    CARH EEEE 3 Bright
	TNT1 A 0 A_GiveInventory("CardinalToken",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    //TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 Radius_Quake(10,80,0,24,0)
	TNT1 A 0 A_GiveInventory("Health",750)
    TNT1 A 0 A_PlaySound("Cardinal/Laugh")	  
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainRageLoop:
	TNT1 A 0 Bright A_SpawnItemEx("CardinalRageFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CARH E 2 Bright A_SpawnItemEx("RainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 39,1)
	Goto PainRageLoop
	TNT1 A 0 Bright ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    CARH EE 3 Bright
	Goto See
  Death.PlayerIce:
    "####" "#" 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	"####" "#" 0 A_Jump(52,2)
	"####" "#" 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,12,0,0,0,0)
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death: 
   	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(52,2)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,12,0,0,0,0)
	CARH E 10 A_Scream
	CARH F 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARH GGGGG 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARH HHHHH 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    CARH IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARH JJJJJ 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    CARH KKKKK 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    CARH L 2
	CARH M 3
    Stop
  } 
}