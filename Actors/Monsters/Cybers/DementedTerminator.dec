Actor DTermLineSpawner : BluePowerLineSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAA 0 A_SpawnItemEx("DTermPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("DTermPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}

Actor DTermPowerLine : BluePowerLine
{
  Scale 1
  Translation "80:111=200:207"
  States
  {
  Spawn:
    SPFX A 5 Bright
    TNT1 A 0 A_Jump(128,"FadeOut2")
  Normal:
    SPFX AAAAAAAA 1 Bright A_FadeOut(0.025)
    Stop
  FadeOut2:
    SPFX AAAAAAAA 1 Bright A_FadeOut(0.035)
    Stop
  }
}
