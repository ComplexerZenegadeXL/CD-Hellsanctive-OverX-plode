  var int user_script;
  var int user_script_type;
  var int user_lowlag;
  States 
  { 
  Spawn:
    DTRM A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,12)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",29)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	DTRM AB 10 A_Look
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DTRM AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,602)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIf(user_tier == 1,2)
	TNT1 A 0 ACS_NamedExecuteWithResult("CFRuneCheck")
	DTRM A 2 A_Chase
	TNT1 A 0 A_Jump(48,"Rush")
	DTRM B 2 A_Chase
	TNT1 A 0 A_Jump(26,"Teleport")
	Loop
  Rush:
	DTRM A 0 A_Chase
	DTRM A 0 A_SpawnItemEx("DTermGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DTRM A 2 A_Chase
	DTRM A 0 A_Chase
	DTRM A 0 A_SpawnItemEx("DTermGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DTRM A 2 A_Chase
	DTRM A 0 A_Chase
	DTRM A 0 A_SpawnItemEx("DTermGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DTRM A 2 A_Chase
	DTRM A 0 A_Chase
	DTRM A 0 A_SpawnItemEx("DTermGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DTRM A 2 A_Chase
	TNT1 A 0 A_Jump(72,"See")
	Loop
  Tier2:
   	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	DTRM L 3 Bright 
	DTRM L 10 Bright
	TNT1 A 0 A_SpawnItemEx("TerminatorPulse",0,0,40)
	DTRM LLLL 2 Bright A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_Giveinventory("TerminatorTier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TerminatorTier")
	TNT1 A 0 A_SetUserVar("user_tier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Tier3:
   	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	DTRM L 3 Bright 
	DTRM L 10 Bright
	TNT1 A 0 A_SpawnItemEx("TerminatorPulse",0,0,40)
	DTRM LLLL 2 Bright A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_Giveinventory("TerminatorTier",2)
    TNT1 A 0 ACS_NamedExecuteAlways("TerminatorTier")
	TNT1 A 0 A_SetUserVar("user_tier",1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Teleport:  
	DTRM M 1 A_UnSetShootable
	DTRM MMMMMMMMMMMM 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM MMMMMMMMMMM 1 A_FadeOut(0.1,0)
	DTRM MMMMMMMMMMMMMMMMMMMMMMMM 0 A_Wander
	DTRM M 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	DTRM MMMMMMMMMMM 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM MMMMMMMMMMM 1 A_FadeIn(0.1)
	DTRM M 1 A_SetShootable
	Goto See
  Missile:
	TNT1 A 0 A_Jump(16,"PyroShot")
	TNT1 A 0 A_Jump(192,"Railgun","BFG9K","BFG10K","DTBFG","RedStar","OneTwoPunch","DTDevastator")
	TNT1 A 0 A_JumpifCloser(300,"UberHexaSG")
  Normal:
	DTRM G 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	DTRM H 2 Bright A_CustomMissile("TerminatorExplosiveTracer",70,-18,frandom(-8,8))
