  BFG9K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	TNT1 A 0 A_Jump(64,"F9K")
	TNT1 A 0 A_Jump(128,"R9K")
  L9K:
	TNT1 A 0 ThrustThing(Angle*256/360+192,15,0,0)
