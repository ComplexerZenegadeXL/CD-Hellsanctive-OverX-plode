Actor DTermPyroShot
{
  Projectile
  +SEEKERMISSILE
  +FORCERADIUSDMG
  +EXTREMEDEATH
  +DONTBLAST
  +NOGRAVITY
  +DONTREFLECT
  SeeSound "weapons/firbfi"
  DeathSound "Weapons/PCnnEx"
  Species "Cybers"
  DamageType "Cyber10K"
  Obituary "$CFDTermPyroShotObit"
  Alpha 1.0
  Scale 1.4
  RenderStyle Add
  Speed 35
  FastSpeed 45
  Damage (Random(600,1000)) //300
  Radius 16
  Height 16
  States
  {
  Spawn:
    TNT1 A 0
    HFBA ABC 1 A_SpawnItemEx("HFExTrail",0,0,0,0,0,0,0)
    Goto Spawn+2
  Death:
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,65,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,120,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,165,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,220,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,265,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,330,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_CustomMissile("TFuelExplosion01",0,0,375,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    HFBA D 0 A_Mushroom("DTermMushroomFireballs",8,MSF_STANDARD|MSF_DONTHURT)
	TNT1 A 0 A_Explode(1000,400,0,1)
    HFBA DEFGHIJKLMN 1 Bright 
	TNT1 AA 0 A_SpawnItemEx("PyroShotEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Stop
  }
}


