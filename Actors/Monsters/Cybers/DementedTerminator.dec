	DTRM J 2 Bright A_FaceTarget
	DTRM K 2 Bright A_CustomMissile("CardinalRail",83,-26,frandom(-2,3))
	DTRM J 2 Bright A_FaceTarget
	DTRM K 2 Bright A_CustomMissile("CardinalRail",83,-26,frandom(-2,3))
	TNT1 A 0 A_SetUserVar("user_missile",0)
  RailgunLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 15,"RailgunEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	DTRM J 1 Bright A_FaceTarget
	DTRM K 1 Bright A_CustomMissile("CardinalRail",83,-26,frandom(-2,3))
	Loop
  RailgunEnd:
	DTRM J 6 Bright 
	DTRM J 2 
