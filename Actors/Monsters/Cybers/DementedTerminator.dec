	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"Missile")
	TNT1 A 0 A_SpidRefire
	Loop
  UberHexaSG:
	DTRM G 6 A_FaceTarget
	DTRM GGGGGG 0 A_SpawnItemEx("SSGShellCasing",25,-25,70,frandom(2,4),frandom(-6,-3),frandom(3,6),0)
	TNT1 A 0 A_PlaySound("weapons/hsgfire")
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("MonsterTracer2",88,-17,frandom(-6,6),0)
	DTRM H 2 Bright A_CustomBulletAttack(15.4,10.6,60,frandom(5,9),"TerminatorPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_StopSoundEx("Weapon")	
	TNT1 A 0 A_Jump(15,"See")
	TNT1 A 0 A_SpidRefire
	Loop
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DTRM J 20 A_FaceTarget
	DTRM J 4 Bright A_FaceTarget
