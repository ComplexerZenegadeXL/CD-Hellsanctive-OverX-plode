  F9K:	
	DTRM J 22 A_FaceTarget
	DTRM K 8 A_FaceTarget
	DTRM KKKKKKKK 2 Bright A_CustomMissile("TerminatorBFG9500Ball",68,-15,frandom(-10,10))
	DTRM J 6 Bright 
	DTRM J 2
	TNT1 A 0 A_Stop
	Goto See
