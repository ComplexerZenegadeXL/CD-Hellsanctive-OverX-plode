	DTRM E 0 A_FaceTarget
	DTRM EEEE 2 Bright A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 0 A_FaceTarget
	DTRM EEEE 2 Bright A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 0 A_FaceTarget
	DTRM EEEE 2 Bright A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 0 A_FaceTarget
