  SeeSound "imp/attack"
  DeathSound "comet/explosion"
  BounceCount 3
  -NOGRAVITY
  +DOOMBOUNCE
  +DONTREFLECT
  +SKYEXPLODE
  +SPECTRAL
  +SEEKERMISSILE
  States
  {
  Spawn:
    TNT1 A 1
	TNT1 A 0 A_PlaySoundEx("HFCyb/rocket", 1, 0, 2)
	Goto Fly
  Fly:
	FRTB AB 1 Bright A_SpawnItemEx("HFCybFireballTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_CustomMissile ("SuperMeteor_m_TrailFX_Smoke", 0, 0, frandom (0, 360), 2, frandom (10, 40))
	Loop
  Death:
	TNT1 A 0 A_Explode(160,192)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, frandom(0,360))
    TNT1 AAAAAA 0 A_CustomMissile ("OrangeParticleSpawner", 0, 0, frandom (0, 360), 2, frandom (0, 180))
	TNT1 AAAAAAA 0 A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("CyberSuperMeteor_m_Explosion",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	EXPL A 0 Radius_Quake(15,20,0,20,0)
	BEXP B 0 A_Scream
    TNT1 A 0 A_ALertMonsters
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke", 0, 0, 0,frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	BOOM ABCDEFGHIJKLMNOP 2 Bright
	Stop
  }
}

/*
Actor CyberSuperMeteor_m_Explosion : SuperMeteor_m_Explosion { DamageType "Cyber10k" } */

Actor DTermFire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  RenderStyle Translucent
  Scale 0.4
  States
  {
  Spawn:
    SMOK ABCDEFGHIJKL 3 Bright A_FadeOut
    Stop
  }
}

Actor DTermFireFlame : Kaboom3 { Scale 0.5 }
Actor DTermFireParticleRed : LCABFGTrailParticleRed
{
  BounceType None
  BounceFactor 0
  Scale 0.04
  Alpha 0.95
  +CLIENTSIDEONLY
  -MISSILE
  -DOOMBOUNCE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  BurnOut:
    TNT1 A 0
    LSKR A 2 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor DTermFireParticleGold : DTermFireParticleRed
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  BurnOut:
    LPKG A 2 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor DTermFireSpawner : RedParticleSpawner
{
  +DONTSPLASH
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire3")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("DTermFireParticleRed",frandom(-32,10),frandom(-10,14),frandom(50,60),frandom(-2,2),frandom(-2,2),-2,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("DTermFireParticleGold",frandom(-32,10),frandom(-10,14),frandom(50,60),frandom(-2,2),frandom(-2,2),-2,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_SpawnItemEx("DTermFire",frandom(-32,10),frandom(-10,14),frandom(60,70),0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	TNT1 AAA 0 A_SpawnItemEx("DTermFireFlame",frandom(-32,10),frandom(-10,14),frandom(60,70),0,0,frandom(-7,-5),0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	TNT1 AAA 0 A_SpawnItemEx("DTermFire",frandom(-32,10),frandom(-10,14),frandom(60,70),0,0,frandom(-8,-6),0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	Stop
  }
}

Actor TerminatorTier : Inventory { Inventory.MaxAmount 2 }