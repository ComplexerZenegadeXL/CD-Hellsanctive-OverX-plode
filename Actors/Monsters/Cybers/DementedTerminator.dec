	TNT1 A 0 A_PlaySound("sentient/fire")
	DTRM N 2 Bright A_CustomMissile("TerminatorExplosiveTracer",88,-17,frandom(-8,8))
	DTRM O 0 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", -18, -15, 76, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("sentient/fire")
	DTRM O 2 Bright A_CustomMissile("TerminatorExplosiveTracer",88,-17,frandom(-8,8))
	TNT1 A 0 A_Stop
	Goto See
  TwoDT:
	TNT1 A 0 A_Jump(160,"FTwoDT")
	TNT1 A 0 A_Jump(128,"LTwoDT")
  RTwoDT:
	TNT1 A 0 ThrustThing(Angle*256/360+64,12,0,0)
	TNT1 A 0 A_Jump(256,"FTwoDT")
  LTwoDT:
	TNT1 A 0 ThrustThing(Angle*256/360+192,12,0,0)
  FTwoDT:
 	DTRM N 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	DTRM NONOPP 2 Bright A_CustomMissile("TerminatorExplosiveTracer",88,-17,frandom(-8,8))
 	DTRM P 0 A_FaceTarget
	DTRM P 0 A_CustomMissile("CardinalDTBFG10KBall",63,15,0)
	DTRM P 0 A_CustomMissile("CardinalDTBFG10KBall",63,15,30)
	DTRM P 0 A_CustomMissile("CardinalDTBFG10KBall",63,15,-30)
 	DTRM O 0 A_FaceTarget
	DTRM NONONO 2 Bright A_CustomMissile("TerminatorExplosiveTracer",88,-17,frandom(-8,8))
 	DTRM O 0 A_FaceTarget
	DTRM NONONO 2 Bright A_CustomMissile("TerminatorExplosiveTracer",88,-17,frandom(-8,8))
	TNT1 A 0 A_Stop
	Goto See			
  PyroShot:
	TNT1 A 0 A_PlaySoundEx("monster/dtermsit2","DTSIGHT")
	TNT1 A 0 A_SetUserVar("user_missile",0)
  PyroshotCharge:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"PyroShotCharged")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	DTRM E 2 A_FaceTarget
	DTRM EEEEEE 0 A_SpawnItemEx("DTermLineSpawner")
	DTRM E 2 A_FaceTarget
	Loop
  PyroShotCharged:
	TNT1 A 0 A_PlaySound("Cardinal/9k")
	DTRM F 2 A_FaceTarget
	DTRM FFFFFF 0 A_SpawnItemEx("DTermLineSpawner")
	DTRM FF 0 A_CustomMissile("DTermPyroShot",88,17,frandom(-6,6))
	DTRM E 12 Bright 
	DTRM E 2
	Goto See
  DTDevastator:
	TNT1 A 0 A_PlaySoundEx("monster/dtermsit2","DTSIGHT")
	TNT1 A 0 A_SetUserVar("user_missile",0)
	DTRM E 0 A_PlaySound ("devastator/charge")
  DevastatorLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 55,"DevastatorCharged")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SpawnItemEx("DTermLineSpawner")
	DTRM E 2 A_Facetarget
    Loop
  DevastatorCharged:
	DTRM F 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 2 A_Facetarget
	DTRM F 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 2 A_Facetarget
	DTRM F 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 2 A_Facetarget
	DTRM F 0 A_SpawnItemEx("DTermLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	DTRM E 2 A_Facetarget
	DTRM F 0 A_PlaySound ("devastator/fire")
	DTRM F 0 A_CustomMissile("TerminatorDevastator",78,17,-7)
	DTRM F 0 A_CustomMissile("TerminatorDevastator",78,17,7)
	DTRM FE 4 Bright A_FaceTarget
	DTRM E 46 Bright 
	DTRM E 2
	Goto See
  Pain:	
	DTRM L 2 A_Pain	
	DTRM L 2 Bright 
	DTRM L 2
	Goto See
  Pain.PlayerDevBall:
  Pain.PDTBFG:
  Pain.DTBFG10KBall:
  Pain.BFGSplash:
  Pain.BFGSpray:
  Pain.BFG10K:
  Pain.PlayerDBFG10K2:
  Pain.PlayerDBFG2:
	TNT1 A 0 A_Jump(96, "Teleport")
	Goto Missile
  Death.PlayerIce:
  Death:
	DTRM M 10 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),2,frandom(0,360))
	DTRM NNNOOO 5 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),2,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),2,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("DTermNukeDeath",0,0,0,0,0,0,0)
	DTRM PPPQQQ 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),2,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),2,frandom(0,360))
	DTRM SSSTTT 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),2,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),2,frandom(0,360))
	DTRM UUUVVV 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),2,frandom(0,360))
	DTRM W 4
	TNT1 A 0 A_SpawnItemEx("BfgUpgrade",0,0,64,frandom(1,8),0,2,frandom(0,360),0,192)
	TNT1 A 0 A_DropItem("TerminatorItem",1,64 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("ExplosiveMinigunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("PyroCannonGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HomingRocketLauncherGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("RapidShotgunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("UnbelieveabilitySphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 AA 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	DTRM X 6 A_Fall
	DTRM Y 2 A_BossDeath
	DTRM Z -1
	Stop
  }
}

Actor DTermNukeDeath : DarkDesNuke2
{
  Species "Cybers"
  DamageType "Cyber10K"
  Obituary "$CFDTermNukeDeathObit"
}

Actor DTermNuke : TerminatorNuke { Obituary "$CFDTermNukeObit" }

Actor DTermGhost
{
  Scale 1.4
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    DTRM A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor DTermRedStar
{
  Radius 14
  Height 14
  Speed 40
  Damage (Random(400,700)) //300
  Scale 3.5
  Species "Cybers"
  DamageType "Cyber10K"
  Projectile
  RenderStyle Add
  +SEEKERMISSILE
  +EXTREMEDEATH
  +SPAWNSOUNDSOURCE
  +DONTREFLECT
  +FOILINVUL
  +FORCERADIUSDMG
  Species "Cybers"
  +BRIGHT
  Alpha 0.8
  DeathSound "star/explode"
  Obituary "$CFDTermRedStarObit"
  States
  {
  Spawn:
    STAR ABCD 2 Bright A_CustomMissile("RedstarFX",0,0,0,0)
    Loop
  Death:
	TNT1 A 0 A_Explode(192,384,0)
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwave2", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 A_SpawnItemEx("RedDTBFGEx",0,0,-10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	STAR E 3 Bright A_BFGSpray("CustomSprayRed",35,15)
    STAR FGHIJKLMNO 3 Bright
    Stop
  }
}



