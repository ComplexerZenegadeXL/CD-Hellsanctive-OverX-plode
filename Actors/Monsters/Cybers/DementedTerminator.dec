	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	DTRM F 0 A_PlayWeaponSound("star/fire")
	DTRM F 2 Bright A_CustomMissile("DTermRedStar",78,17,0)
	DTRM F 6 Bright A_FaceTarget
