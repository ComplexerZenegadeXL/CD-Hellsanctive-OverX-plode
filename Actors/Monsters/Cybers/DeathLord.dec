Actor DeathLord : CFAnnihilator
{
  Monster
  Health 9000
  Radius 28
  Height 70
  Mass 1000
  Speed 16
  ReactionTime 17
  BloodColor "Orange"
  BloodType "NewBloodOrange"
  MinMissileChance 100//160
  MeleeRange 100
  PainChance 64
  PainThreshold 30
  PainChance "Crush", 256
  PainChance "Mine", 256
  PainChance "Explosion", 256
  PainChance "NuclearFire", 256
  PainChance "Ice", 96
  PainChance "PlayerLegendary", 96
  PainChance "PlayerNemesis", 96
  PainChance "RailG", 96
  PainChance "SatanGuard", 0
  PainChance "BFGSplash", 96
  +BOSS
  +NOFEAR
  +CANTSEEK
  +BOSSDEATH
  +NOICEDEATH
  +NEVERRESPAWN
  +FORCERADIUSDMG
  +NORADIUSDMG
  +DONTRIP
  +DONTMORPH
  +DONTBLAST
  //+TELESTOMP
  +NOTELEFRAG
  //+NOTIMEFREEZE
  +FLOORCLIP
  +NOTARGET
  +NOINFIGHTING
  +FASTMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +LOOKALLAROUND
  Species "CFBoss"
  DamageFactor "Acid", 1.5
  DamageFactor "Fire", 0.01
  DamageFactor "Ice", 0.1
  DamageFactor "PlayerIce", 0.1
  DamageFactor "Poison", 0.01
  DamageFactor "PlayerPoison", 0.01
  DamageFactor "PoisonCloud", 0.001
  DamageFactor "Crush", 0.1
  DamageFactor "Electric", 0.001
  DamageFactor "Disintegrate", 0.001
  DamageFactor "NuclearFire", 0.5
  DamageFactor "Explosion", 0.25
  DamageFactor "Mine", 0.25
  DamageFactor "Extreme", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "Player", 0.001
  DamageFactor "PyroShot", 0.001
  DamageFactor "PlayerPyro", 0.01
  DamageFactor "PlayerBHole", 0.025
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "UpBFG9500Ball", 0.5
  DamageFactor "UpBFGSplash", 0.15
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "PlayerDevBall", 0.02
  DamageFactor "PlayerDevBall2", 0.02
  DamageFactor "Players", 0.02
  DamageFactor "PlayerDevTracer", 0.02
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "Legendary", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "LegendaryPlayer", 0.015
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.015
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.1
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DamageFactor 0.5
  //No infighting
  DamageFactor "SatanGuard", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "Exos", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "Nobles", 0.0
  DamageFactor "UBDTR", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "DarkBruiserBFG10K", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "Commander", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "HellComet", 0.2
  DamageFactor "HFCyber", 0.0
  DamageFactor "HFCyb3r", 0.0
  DropItem "BossLifeEssence" 256 12
  DropItem "NemesisArmorBonus64" 256
  DropItem "UltraSphere" 128
  DropItem "HellstormBFGGiver" 64
  DropItem "HSBFGupgrade" 128 1
  DropItem "DemonicChaliceGiver" 96
  DropItem "SkullofPowerGiver" 96
  DropItem "DemonAmmoBoxPickup" 196 200
  DropItem "NewCellPackPickup" 196
  SeeSound "DeathLord/sight"
  ActiveSound "DeathLord/active"
  PainSound "DeathLord/pain"
  DeathSound "DeathLord/death"
  Obituary "$CFDeathLordObit"
  Tag "$CFDLord"
  var int user_amount;
  var int user_music;
  var int user_currenthp;
  var int user_missile;
  var int user_rage;
  var int user_speed;
  var int user_loopm;
  var int user_lowlag;
  var int user_loop;
  States
  {
  Spawn:
	LMDA A 0
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SetUserVar("user_rage",0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("BossAI",0,-1)
  SpawnLoop:
	LMDA A 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	Loop
  Idle:
	TNT1 A 0
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
  IdleLoop:
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Look
	LMDA AA 4 A_Wander
	TNT1 A 0 A_Look
	LMDA BB 4 A_Wander
	TNT1 A 0 A_PlaySound("DeathLord/Step")
	TNT1 A 0 A_Look
	LMDA CC 4 A_Wander
	TNT1 A 0 A_Look
	LMDA DD 4 A_Wander
	TNT1 A 0 A_PlaySound("DeathLord/Step")
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LMDA AABB 3 A_Chase
	TNT1 A 0 A_PlaySound("DeathLord/Step")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
  SeeLoop:
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,750)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_StopSound(1)
	LMDA AABB 3 A_Chase
	TNT1 A 0 A_PlaySound("DeathLord/Step")
	LMDA CCDD 3 A_Chase
	TNT1 A 0 A_PlaySound("DeathLord/Step")
	Loop
  Missile:
	TNT1 A 0 A_Jump(256,"ExplosiveMinigun","DemonTechShotgun","Pyrocannon","HellfireGauss","BFG10k","HellstormBFG","RapidShotgun")
  ExplosiveMinigun:
	LMDA EE 5 A_FaceTarget(45)
  ExplosiveMinigunLoop:
	TNT1 A 0 A_PlaySound("sentient/fire",1)
	TNT1 A 0 A_CustomMissile("TerminatorExplosiveTracer",62,21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("TerminatorExplosiveTracer",62,-21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	LMDA F 3 Bright A_FaceTarget
    TNT1 A 0 A_PlaySound("sentient/fire",1)
	TNT1 A 0 A_CustomMissile("TerminatorExplosiveTracer",62,21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("TerminatorExplosiveTracer",62,-21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	LMDA G 3 Bright A_FaceTarget
	TNT1 A 0 A_Jump(32,"See")
	Loop
  DemonTechShotgun:
	TNT1 A 0 A_PlaySound("DTShotgun/Pickup",1)
	LMDA EEEEE 4 A_FaceTarget(45)
  DemonTechShotgunLoop:
    TNT1 A 0 A_PlaySound("Weapons/ErasusFire",1)
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  DemonTechShotgunLoop2:
	TNT1 A 0 A_CustomMissile("RedZDemonTechProjectile2",62,21,user_loop,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,2)
	TNT1 A 0 A_Jump(256,"DemonTechShotgunLoop2")
	LMDA F 4 Bright A_FaceTarget
    TNT1 A 0 A_PlaySound("Weapons/ErasusFire",1)
	TNT1 A 0 A_SetUserVar("user_loop",-5)
  DemonTechShotgunLoop3:
	TNT1 A 0 A_CustomMissile("RedZDemonTechProjectile2",62,-21,user_loop,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,2)
	TNT1 A 0 A_Jump(256,"DemonTechShotgunLoop3")
	LMDA G 4 Bright A_FaceTarget
	TNT1 A 0 A_Jump(64,"See")
	Goto DemonTechShotgunLoop
  BFG10k:
    TNT1 A 0 A_PlaySound("weapons/charge15k",1)
	LMDA EEEEE 4 A_FaceTarget(45)
  BFG10kLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",1)
	TNT1 A 0 A_CustomMissile("Cardinal10K",62,21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Cardinal10K",62,-21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	LMDA F 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",1)
	TNT1 A 0 A_CustomMissile("Cardinal10K",62,21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	TNT1 A 0 A_CustomMissile("Cardinal10K",62,-21,frandom(-5,5),CMF_OFFSETPITCH,frandom(-2,2))
	LMDA G 5 Bright A_FaceTarget
	TNT1 A 0 A_Jump(64,"See")
	Loop
  PyroCannon:
	TNT1 A 0 A_PlaySound("DeathLord/Attack",2)
	LMDA IIIII 6 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/PCNNF",1)
	LMDA J 10 Bright A_CustomMissile("PyroShot",49)
	LMDA I 20
	Goto See
  HellfireGauss:
	LMDA IIIII 4 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HellfireGaussLoop:
	TNT1 A 0 A_PlaySound("Weapons/HFGaussFire",1)
	LMDA J 3 Bright A_CustomMissile("HFGaussProjectile",49,0,frandom(-4,4))
	LMDA I 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop
	TNT1 A 0 A_PlaySound("Weapons/HFGaussFire",1)
	LMDA J 3 Bright A_CustomMissile("HFGaussProjectile",49,0,frandom(-4,4))
	LMDA I 10
	Goto See
  HellstormBFG:
	TNT1 A 0 A_PlaySound("weapons/Hcharge10k",1)
	LMDA IIIII 4 A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HellstormBFGLoop:
	TNT1 A 0 A_PlaySound("Weapons/Hbfg10kfire",1)
	LMDA J 4 Bright A_CustomMissile("HSBFG10kShotDeathlord",49,0,frandom(-4,4))
	LMDA I 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	TNT1 A 0 A_PlaySound("Weapons/Hbfg10kfire",1)
	LMDA J 4 Bright A_CustomMissile("HSBFG10kShotDeathlord",49,0,frandom(-4,4))
	LMDA I 10 A_PlaySound("weapons/Hbfg10kcooldown",1)
	Goto See
  RapidShotgun:
    TNT1 A 0 A_JumpIfHealthLower (4500,"EmpoweredRapidShotgun")
	TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",1)
    LMDA EEEEE 4 A_FaceTarget(45)
  RapidShotgunLoop:
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",1)
	TNT1 AAAAAA 0 A_CustomMissile("MonsterTracer2",60,-21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 AAAAAA 0 A_CustomMissile("MonsterTracer2",60,21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 A_CustomBulletAttack(15,12.2,12,Random(10,20),"BulletPuff",0,CBAF_NORANDOM)
	LMDA F 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",1)
	TNT1 AAAAAA 0 A_CustomMissile("MonsterTracer2",60,-21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 AAAAAA 0 A_CustomMissile("MonsterTracer2",60,21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 A 0 A_CustomBulletAttack(15,12.2,12,Random(10,20),"BulletPuff",0,CBAF_NORANDOM)
	LMDA GG 2 A_FaceTarget
	TNT1 A 0 A_Jump(64,"See")
	Loop
  EmpoweredRapidShotgun:
    TNT1 A 0 A_PlaySound("HeavyChaingun/Sart",1)
	TNT1 A 0 A_PlaySound("DeathLord/Attack",2)
  EmpoweredRapidShotgunWait:
    TNT1 A 0 A_JumpIf(user_missile >= 10, "EmpoweredRapidShotgunLoop")
	TNT1 A 0 A_SpawnItem("EmpoweredSmokeSpawner")
	LMDA E 2 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  EmpoweredRapidShotgunLoop:
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",1)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",60,-21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 AAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",60,21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	LMDA F 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/12gaugefire",1)
	TNT1 AAAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",60,-21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	TNT1 AAAAA 0 A_CustomMissile("MinigunnerExplosiveTracer",60,21,frandom(-13,13),CMF_OFFSETPITCH,frandom(-4,4))
	LMDA G 4 A_FaceTarget
	TNT1 A 0 A_Jump(64,"See")
	Loop
  Pain:
	TNT1 A 0 A_Jump(64,2)
	TNT1 A 0 ACS_NamedExecuteAlways("BacklashDamage")
	TNT1 A 0 A_SetUserVar(user_missile,0)
	LMDA H 10 A_Pain
	Goto See
  Death.PlayerIce:
  Death:
	LMDA K 10
	TNT1 A 0 A_ScreamAndUnblock
	LMDA LMN 10
	TNT1 AAAAAAAA 0 A_SpawnItemEx("HFLavaMist",0,0,frandom(20,80),frandom(-8,8),frandom(-8,8),frandom(0,8))
	LMDA O 10
	TNT1 AAAAAAAA 0 A_SpawnItemEx("HFLavaMist",0,0,frandom(20,65),frandom(-8,8),frandom(-8,8),frandom(0,8))
	LMDA P 10
	TNT1 AAAAAAAA 0 A_SpawnItemEx("HFLavaMist",0,0,frandom(20,50),frandom(-8,8),frandom(-8,8),frandom(0,8))
	LMDA Q 10
	TNT1 AAA 0 A_SpawnItemEx("OrangeGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(0,10))
	TNT1 A 0 A_SpawnItemEx("NemesisArmorSphere",0,0,8,frandom(1,8),0,2,frandom(0,360),0,160)
	TNT1 A 0 A_SpawnItemEx("NemesisArmor",0,0,8,frandom(1,8),0,2,frandom(0,360),0,160)
	TNT1 A 0 A_SpawnItemEx("NemesisSphere",0,0,8,frandom(1,8),0,2,frandom(0,360),0,160)
	TNT1 A 0 A_SpawnItemEx("CFDoomsphere",0,0,8,frandom(1,8),0,2,frandom(0,360),0,32)
	TNT1 A 0 A_DropItem("TerminatorItem",1,22 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("IronMaiden",0,0,8,frandom(1,8),0,2,frandom(0,360),0,196)
	TNT1 A 0 A_SpawnItemEx("BigGasPickup",0,0,8,frandom(0,8),0,2,frandom(0,360),0,32)
	TNT1 A 0 A_SpawnItemEx("PyroCannon",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("ExplosiveRifleGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("ExplosiveMinigunGiver",0,0,8,frandom(0,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechShotgunGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("RapidShotgunGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	LMDA RSTU 10
  EndDrop:
	TNT1 A 0 A_BossDeath
	LMDA V -1
	Stop
  }
}

Actor EmpoweredSmoke : AHellionSmoke
{
  -NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    QMKF ABCDEFGHIJKL 2 Bright A_FadeOut
    Stop
  }
}

Actor EmpoweredSmokeSpawner : RedParticleSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAA 0 A_SpawnItemEx("EmpoweredSmoke",frandom(-36,36),frandom(-36,36),frandom(12,80),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop	
  }
}

Actor DeathLordIronMaidenToken : PowerIronMaiden { Powerup.Duration -5 }

Actor FieryBubbleShield
{
  RenderStyle Add
  YScale 2.0
  XScale 1.9
  Alpha 0.8
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	FBSD ABCDEFGH 1 Bright //A_FadeOut(0.1)
	Loop
  }
}
Actor PowerDeathLordIronMaidenIndicator : PowerDamage { DamageFactor "notarealdamagetype", 1.0 Powerup.Color "Red", 0.4 Powerup.Duration 18 }