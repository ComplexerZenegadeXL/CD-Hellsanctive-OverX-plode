	DCYB E 10 A_FaceTarget
	DCYB F 0 A_CustomMissile("DarkCyberHomer",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberHomer",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberHomer",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberHomer",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberHomer",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberHomer",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberHomer",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberHomer",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberHomer",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberHomer",54,22,0)
    DCYB E 8 A_FaceTarget			
	TNT1 A 0 A_Jump(128,"Railgun")
