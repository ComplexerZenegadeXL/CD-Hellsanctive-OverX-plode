	DCYB F 0 A_CustomMissile("DarkCyberRail",54,-22,frandom(-6,6))
    DCYB F 10 Bright A_CustomMissile("DarkCyberRail",54,22,frandom(-6,6))		
	DCYB E 15
	TNT1 A 0 A_Jump(128,"BFG9K")
	Goto See
  DTRailgun:
	DCYB E 10 A_FaceTarget
