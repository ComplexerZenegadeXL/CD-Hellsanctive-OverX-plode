	TNT1 A 0 A_SetShootable
	DCYB E 10 Bright A_FaceTarget
	DCYB F 0 A_CustomMissile("DarkCyberRail",54,-22,0)
    DCYB F 10 Bright A_CustomMissile("DarkCyberRail",54,22,0)			
	TNT1 A 0 A_UnSetShootable
	DCYB EEEE 0 A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCYB EEEEEEEEE 1 A_FadeOut(0.1,0)
	DCYB EEEEEEEEEEEEEEEEEE 0 A_Wander
	DCYB E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	DCYB E 20
	DCYB EEEE 0 A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCYB EEEEEEEEEE 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	DCYB E 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	DCYB F 0 A_CustomMissile("DarkDemo10K",54,-22,frandom(-4,4))	
	DCYB F 4 Bright A_CustomMissile("DarkDemo10K",54,22,frandom(-4,4))	
	DCYB E 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	DCYB F 0 A_CustomMissile("DarkDemo10K",54,-22,frandom(-4,4))	
	DCYB F 4 Bright A_CustomMissile("DarkDemo10K",54,22,frandom(-4,4))	
	DCYB E 8 A_FaceTarget		
	TNT1 A 0 A_UnSetShootable
	DCYB EEEE 0 A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCYB EEEEEEEEEE 1 A_FadeOut(0.1,0)
	DCYB EEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
	DCYB E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	DCYB E 20
	DCYB EEEE 0 A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCYB EEEEEEEEEE 1 A_FadeIn(0.1)	
	TNT1 A 0 A_SetShootable
	DCYB E 10 Bright A_FaceTarget
	DCYB F 0 A_CustomMissile("DarkCyberRail",54,-22,0)
    DCYB F 10 Bright A_CustomMissile("DarkCyberRail",54,22,0)
    Goto See		
  Pain:
	//TNT1 A 0 A_Jump(48,"Healing")
	TNT1 A 0 A_Jump(127,"PainMissile")
    DCYB G 10 A_Pain
    Goto See
  PainMissile:
	DCYB G 10 A_Pain
    Goto Missile
  Healing:
  	TNT1 A 0 A_PlaySoundEx("darkannih/see","Voice")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	DCYB G 2 HealThing(100)
    DCYB GGGGGGGGGGGG 4 Bright A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	DCYB G 2
    Goto See		
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	DCYB G 10 A_Scream
	DCYB H 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DCYB IIIII 2 Bright A_CustomMissile("Kaboom5", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DCYB JJJJJ 2 Bright A_CustomMissile("Kaboom5", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    DCYB KKKKK 2 Bright A_CustomMissile("Kaboom5", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DCYB LLLLL 1 Bright A_CustomMissile("Kaboom5", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DCYB MMMMM 1 Bright A_CustomMissile("Kaboom5", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GreenGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigGreenBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    DCYB NO 5
    DCYB P -1
    Stop	 		
  }
}

Actor DarkAnniFireSpawner : DarkCyberFireSpawner
{
  Radius 16
  Height 10
  Damage (Random(20,50)) //8
  RenderStyle Add
  Projectile
  +FLOORHUGGER
  +BLOODLESSIMPACT
  +THRUSPECIES
  +FORCERADIUSDMG
  +SEEKERMISSILE
  Speed 48
  FastSpeed 60
  Species "Cybers"
  DamageType "Cyber10K"
  Obituary "$CFDarkAnniFireSpawnerObit"
  SeeSound "weapons/diasht"
  DeathSound "weapons/firex3"
  States
  {
  Spawn: 
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")	
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")	
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")	
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")	
	TNT1 A 0 A_SeekerMissile(150,150)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
  Fly:
  	TNT1 A 0 A_SeekerMissile(14,0)
	TNT1 A 2 A_SpawnItemEx("DarkCyberFire")
	Loop
    }  
}	

