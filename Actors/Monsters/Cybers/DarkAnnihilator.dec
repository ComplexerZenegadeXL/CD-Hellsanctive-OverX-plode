  PainChance "SoulToxic", 5
  PainChance "FatFlamer", 5
  PainChance "FiendFire", 5
  PainChance "Explosion", 35
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.175
  DamageFactor "PDTBFGTracer", 0.35
  DamageFactor "PlayerDTRG", 0.3
  DamageFactor "DBFG2", 0.0
  DropItem "ModdedGreenArmor" 128
  DropItem "ModdedInvulnerabilitySphere" 32
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoPickup" 256 60
  DropItem "DemonAmmoBoxPickup" 200
  DropItem "NewCellPickup" 256 20
  DropItem "NewCellPackPickup" 250
  DropItem "DemonTechRailgunGiver" 160
  DropItem "BFG10KGiver" 178 1
  DropItem "BFG9500Giver" 180 1
  DropItem "RailgunGiver" 184 1
  Obituary "$CFDarkAnnihilatorObit"
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +QUICKTORETALIATE
  +MISSILEMORE
  +MISSILEEVENMORE
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +NOFEAR
  +AVOIDMELEE
  +DONTRIP
  SeeSound "darkannih/see"
  PainSound "monster/psopain"
  DeathSound "monsters/darkcyberdie"
  BloodColor "Green"
  Tag "$CFDarkAnni"
  var int user_loop;
  var int user_lowlag;
  States 
  {    
  Spawn: 
    DCYB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DCYB AAAA 10 A_Look
    Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DCYB A 3 A_Metal
	DCYB ABBCC 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)	
	TNT1 A 0 A_Jump(87,"Rush")
	//TNT1 A 0 A_Jump(250,"Railgun")
	DCYB A 3 A_Metal
	DCYB ABBCC 3 A_Chase
	DCYB D 3 A_Metal
	DCYB D 3 A_Chase
	Loop		
  Rush:
	TNT1 A 0 A_Metal
	DCYB AA 0 A_Chase
    DCYB A 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB A 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB B 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB B 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB C 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB C 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	TNT1 A 0 A_Metal
	DCYB AA 0 A_Chase
    DCYB D 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCYB AA 0 A_Chase
    DCYB D 2 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	TNT1 A 0 A_SpawnItemEx("DarkAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(87,"See")		
	Loop	
  Missile:
    TNT1 A 0 A_Jump(192,"Seeker","Railgun","DTRailgun","BFG9K","BFG15K","DTBFG","FloorStomp","BFGCombo","RageAttack")
  Rockets:
	DCYB E 10 A_FaceTarget
	DCYB F 0 A_CustomMissile("DarkCyberRocket",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberRocket",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberRocket",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberRocket",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberRocket",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberRocket",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberRocket",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberRocket",54,22,0)
    DCYB E 8 A_FaceTarget	
	DCYB F 0 A_CustomMissile("DarkCyberRocket",54,-22,0)
    DCYB F 6 Bright A_CustomMissile("DarkCyberRocket",54,22,0)
    DCYB E 8 A_FaceTarget		
	TNT1 A 0 A_Jump(128,"Seeker")
	Goto See
