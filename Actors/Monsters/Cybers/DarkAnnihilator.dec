	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCYB G 3 Bright A_PlaySoundEx("DarkCyber/Laugh","Voice")
