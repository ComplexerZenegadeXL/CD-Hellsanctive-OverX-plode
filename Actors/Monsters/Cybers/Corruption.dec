  DamageFactor "PlayerPyro", 0.3
  DamageFactor "PlayerBHole", 0.8
  DamageFactor "BFGSplash", 0.1
  DamageFactor "BFGSpray", 0.1
  DamageFactor "PDTBFG", 0.0
  DamageFactor "PDTBFGTracer", 0.0
