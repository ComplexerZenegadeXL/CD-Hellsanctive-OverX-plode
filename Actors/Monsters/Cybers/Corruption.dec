	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	DCSU PO 20 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCSU NM 20 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	DCSU MN 1 Bright A_VileTarget("MegaIceSpikeSpawner")
	DCSU MN 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-14)
  BestAttackLoop:
	DCSU O 0 A_CustomMissile("CorruptionIceSpikeSpawner", 66, 0, user_loop * 5)
	DCSU O 0 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 15,2)
	TNT1 A 0 A_Jump(256,"BestAttackLoop")
	DCSU O 10 Bright A_CustomMissile("CorruptionIceSpikeSpawner", 66, 0, -75)
	DCSU MN 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",-14)
  BestAttackLoop2:
	DCSU O 0 A_CustomMissile("PyroFireSpawner", 66, 0, user_loop * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 15,2)
	TNT1 A 0 A_Jump(256,"BestAttackLoop2")
	DCSU O 10 Bright A_CustomMissile("PyroFireSpawner", 66, 0, -75)
	DCSU MN 8 Bright A_FaceTarget 
	DCSU O 0 A_CustomMissile("PyroBlast", 66, 0, 0)
	DCSU O 0 A_CustomMissile("SnowStormBomb", 66, 0, 4)
	DCSU O 0 A_CustomMissile("SnowStormBomb", 66, 0, -4)
	DCSU O 0 A_CustomMissile("PyroBlast", 66, 0, 6)
	DCSU O 0 A_CustomMissile("PyroBlast", 66, 0, -6)
	DCSU O 0 A_CustomMissile("SnowStormBomb", 66, 0, 8)
	DCSU O 0 A_CustomMissile("SnowStormBomb", 66, 0, -8)
	DCSU O 0 A_CustomMissile("PyroBlast", 66, 0, 10)
	DCSU O 0 A_CustomMissile("PyroBlast", 66, 0, -10)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("Corruption/Sight","Body",0,2)
	DCSU PPOONNMM 2 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BestAttackLoop3:
	DCSU M 0 A_SpawnItemEx("LordArchonRainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	DCSU M 2 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 19,1)
	Goto BestAttackLoop3
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Melee:
	TNT1 A 0 A_Jump(80,"FireHands","DarkHands")
	DCS0 EF 3 Bright A_FaceTarget 
	DCS0 G 2 Bright A_CustomMeleeAttack(30,"baron/melee"," ","Cyber10K")
	DCS0 IJ 3 Bright A_FaceTarget 
	DCS0 K 2 Bright A_CustomMeleeAttack(30,"baron/melee"," ","Cyber10K")
	DCS0 MN 3 Bright A_FaceTarget
	DCS0 O 0 A_CustomMeleeAttack(30,"baron/melee"," ","Cyber10K")
	DCS0 O 2 Bright A_CustomMeleeAttack(30,"baron/melee"," ","Cyber10K")
	Goto See
  FireHands:
	DCS3 EF 3 Bright A_FaceTarget 
	DCS3 G 0 A_CustomMissile("ExplosiveMelee", 66, 0, 0)
	DCS3 G 2 Bright A_CustomMeleeAttack(30,"Pyro/FlamePoof","pyro/blastexplosion","Cyber10K")
	DCS3 IJ 3 Bright A_FaceTarget 
	DCS3 K 0 A_CustomMissile("ExplosiveMelee", 66, 0, 0)
	DCS3 K 2 Bright A_CustomMeleeAttack(30,"Pyro/FlamePoof","pyro/blastexplosion","Cyber10K")
	DCS3 MN 3 Bright A_FaceTarget 
	DCS3 O 0 A_CustomMissile("ExplosiveMelee", 66, 0, 0)
	DCS3 O 0 A_CustomMissile("ExplosiveMelee", 66, 0, 0)
	DCS3 O 0 A_CustomMissile("ExplosiveMelee", 66, 0, 0)
	DCS3 O 2 Bright A_CustomMeleeAttack(50,"Pyro/FlamePoof","pyro/blastexplosion","Cyber10K")
	Goto See
  DarkHands:
	DCS4 EF 2 Bright A_FaceTarget 
	DCS4 G 0 A_CustomMissile("CorruptionDarkMatter", 66, 0, 0)
	DCS4 G 2 Bright A_CustomMeleeAttack(40,"Pyro/FlamePoof","darkinquisitor/darkmatterdie","Cyber10K")
	DCS4 IJ 2 Bright A_FaceTarget 
	DCS4 K 0 A_CustomMissile("CorruptionDarkMatter", 66, 0, 0)
	DCS4 K 2 Bright A_CustomMeleeAttack(40,"Pyro/FlamePoof","darkinquisitor/darkmatterdie","Cyber10K")
	DCS4 MN 2 Bright A_FaceTarget 
	DCS4 O 0 A_CustomMissile("CorruptionDarkMatter", 66, 0, 0)
	DCS4 O 0 A_CustomMissile("CorruptionDarkMatter", 66, 0, 0)
	DCS4 O 0 A_CustomMissile("CorruptionDarkMatter", 66, 0, 0)
	 DCS4 O 2 Bright A_CustomMeleeAttack(60,"Pyro/FlamePoof","darkinquisitor/darkmatterdie","Cyber10K")
	Goto See
  Pain: 
	TNT1 A 0 A_Jump(50,"RageAttack")
	DCS0 Q 3 Bright A_Pain 
	TNT1 A 0 A_Jump(90,"evade")
	Goto See
  Evade:
	DCS3 E 1 A_FaceTarget
	DCS3 E 0 A_SetAngle(angle+random(0,359))
	DCS3 E 0 A_Recoil(-50)
	DCS3 E 0 A_FaceTarget
	DCS3 EEEEEEEEEEEEE 1 A_SpawnItemEx("CTGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	Goto See
  RageAttack:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	DCS0 Q 25 Bright
	DCS0 Q 45 Bright A_PlaySoundEx("Corruption/Sight","Body",0,2)
	DCS3 R 16 Bright
	DCS3 RRRRRRRRRRRR 2 Bright A_SpawnItemEx("CorruptionFlameSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
	DCS3 R 1 A_FaceTarget
	DCS3 R 0 A_CustomMissile("DarkDesNuke",66,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Minions:
	TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_PlaySoundEx("Corruption/Sight","Body",0,2)
   	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	DCSU MMMMMMMNNNNNN 5 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DCSU OOO 0 A_SpawnItemEx("CorruptionServants",0,0,0,0,0,0,0,32,64)
	DCSU O 2 A_SpawnItemEx("CorruptionFlameAndWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto See
  Death: 
	DCS0 Q 15 Bright
	DCS0 Q 15 Bright A_Scream 
	DCS3 Q 10 Bright  
	DCS3 R 16 Bright
	DCS3 RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR 4 Bright A_SpawnItemEx("CorruptionFlameAndWindSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("PyroCannonGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	DCS3 R 0 A_CustomMissile("DarkDesNuke",66,0,0)
	Stop
  } 
}

