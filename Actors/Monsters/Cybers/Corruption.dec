  DamageFactor "PlayerDevBall2", 0.0
  DamageFactor "PlayerDevTracer", 0.0
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Explosion", 0.25
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "PlayerLegendary", 0.1
  +MISSILEMORE
  +MISSILEEVENMORE
  +FASTMELEE
  +BOSS
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +NOPAIN
  +DONTHARMSPECIES
  +DONTRIP
  +NOICEDEATH
  +NOTELEFRAG
  Obituary "$CFCorruptionObit"
  HitObituary "$CFCorruptionHitObit"
  SeeSound "Corruption/Sight" 
  ActiveSound "Arcradimus/Active"
  PainSound "Corruption/pain"
  DeathSound "Corruption/Death"
  MeleeSound "baron/melee"
  MaxStepHeight 32
  MaxDropOffHeight 32
  Tag "$CFCorruption"
  var int user_music;
  var int user_loop;
  var int user_lowlag;
  States 
  { 
  Spawn: 
	 DCS0 A 0
	 TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 A 10 Bright A_Look
	Loop 
  See: 
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DCS0 AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1) 
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,717)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfInventory("RunesCheck",1,2)
	TNT1 A 0 A_Jump(100,"rush")
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 A 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 A 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 B 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DCS0 C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 C 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 D 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	DCS0 D 3 A_Chase 
	TNT1 A 0 A_SpawnItemEx("CorruptionWhiteFlamSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(30,"evade","SuperPhase")
