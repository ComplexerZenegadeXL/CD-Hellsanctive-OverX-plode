Actor SnowStormBomb
{
  Radius 13
  Height 8
  Speed 25
  FastSpeed 30
  Damage (Random(100,125)) //30
  Scale 1.1
  Alpha 0.75
  +SEEKERMISSILE 
  +SCREENSEEKER
  +EXTREMEDEATH
  +THRUSPECIES
  RENDERSTYLE Translucent
  Species "Cybers"
  DamageType "Cyber10K"
  Projectile
  SeeSound "icespike"
  DeathSound "iceexplode"
  var int user_loop;
  States
  {
  Spawn:
	FX05 ABC 2 A_SeekerMissile(15,0)
	TNT1 A 0 A_CustomMissile("ICBTrail",Random(4,6),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(4,6),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ICBTrail",Random(4,6),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(4,6),frandom(-2,2))
	Loop
  Death:
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	SHEX G  0 A_CustomMissile("Frostbite",12,0,user_loop * 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 21,2)
    TNT1 A 0 A_Jump(256,"DeathLoop")
	SHEX DCEFG 3 Bright
	Stop
  }
}

