Actor IUBall
{
  Scale 2.5
  Radius 15
  Height 17
  Speed 80
  FastSpeed 100
  Damage (Random(200,400)) //80
  Species "Cybers"
  DamageType "Cyber10K"
  Projectile
  +BRIGHT
  +EXTREMEDEATH
  +THRUSPECIES
  RenderStyle Normal
  SeeSound "comet/launch"
  DeathSound "PainLord/Explode1"
  Obituary "$CFIUBallObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Explode(24,64,0,1)
	TNT1 AAAAAAA 0 A_SpawnItemEx("CoFrozenWind", frandom(-8,8), frandom(-8,8), frandom(-8,8), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	IMBL AB 1 A_Tracer2
	TNT1 A 0 A_SpawnItemEx("IuBallTrail",-3,0,0,0,0,0,0,0,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("CoFrozenWind", frandom(-8,8), frandom(-8,8), frandom(-8,8), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	Loop
  Death:
	BXPO A 0 A_StopSound(CHAN_BODY)
	BXPO A 0 A_ChangeFlag("ICEDAMAGE", 1)
	BXPO A 0 A_ChangeFlag("NODAMAGETHRUST", 0)
	BXPO A 0 A_Explode(196,128,0) 
	BXPO A 0 A_Explode(64,800,0) 
	BXPO A 0 A_Explode(128,256,0) 
	BXPO AAAAAAAA 0 A_SpawnItemEx("CryoSmoke", 0, 0, 0, frandom(1, 3), 0, frandom(0, 1), frandom(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BXPO AAAA 0 A_SpawnItemEx("CryoSmoke2", 0, 0, 0, frandom(0.4, 1.2)*0.4, 0, frandom(0, 0.4), frandom(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
	BXPO ABCDEFGH 1 Bright
	BXPO IJKLLM 1 Bright A_FadeOut(0.1)
	Stop		
  }
}

