	DCS4 O 0 A_FadeTo(0.05,1.0)
	//DCS4 O 0 A_ChangeFlag("FLOAT",1)
	//DCS4 O 0 A_ChangeFlag("NOGRAVITY",1)
	DCS4 OOOOOOOOOOOOOOOOOOOOOOOOOOOOOO 0 A_ExtChase(0,0,0,0)
	TNT1 A 0 A_Recoil(0.1)
	//DCS4 O 0 A_ChangeFlag("FLOAT",0)
	//DCS4 O 0 A_ChangeFlag("NOGRAVITY",0)
	DCS4 O 0 A_FadeTo(1.0,1.0)
	DCS4 O 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	DCS4 O 0 A_FaceTarget
	Goto See
  Missile:
