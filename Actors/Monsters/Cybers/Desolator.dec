Actor Desolator : CFAnnihilator 17581
{
//$Category Monsters/CF
//$Sprite DESOA1C1
//$Title "Desolator"
  Health 6000
  PainChance 30
  PainChance "PDTBFG", 20
  PainChance "SoulToxic", 10
  PainChance "FatFlamer", 10
  PainChance "FiendFire", 10
  PainChance "Explosion", 70
  Species "Cybers"
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "NewCellPickup" 256 20
  DropItem "NewCellPackPickup" 250
  DropItem "BFG10KGiver" 200
  DropItem "RailgunGiver" 184 1
  Obituary "$CFDesolatorObit"
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.5
  DamageFactor "PDTBFGTracer", 0.8
  DamageFactor "DBFG2", 0.0
  SeeSound "Deso/Sight"
  PainSound "Deso/Pain"
  DeathSound "Deso/Death"
  Tag "$CFDeso"
  var int user_loop;
  States 
  {
  Spawn: 
	DESO A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DESO A 10 A_Look
	DESI A 10 A_Look
    Loop 
  See: 
    DESO A 3 A_Playsound("monsters/clhoof")
    DESO ABB 3 A_Chase		
    DESO C 3 A_Playsound("monsters/clhoof") 
    DESO CDD 3 A_Chase 		 
    Loop 
  Missile:
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","10kTracer","15kBall",/*"DTBFG",*/"BFG9500")
  Normal:
    DESO E 12 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
    TNT1 A 0 A_CustomMissile("CardinalRocket", 40, 26, 0)
    DESO F 8 Bright A_CustomMissile("CardinalRocket", 40, -26, 0)
    DESO E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
    Loop
	DESO E 12
	TNT1 A 0 A_Jump(128,"Seekers")
    Goto See
  Seekers:
	DESO E 12 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekersLoop:
    TNT1 A 0 A_CustomMissile("CardinalHomingRocket", 40, 26, 0)
    DESO F 10 Bright A_CustomMissile("CardinalHomingRocket", 40, -26, 0)
    DESO E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	DESO E 12
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	DESO EE 10 A_FaceTarget
	DESO E 10 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("CardinalRail", 40, 26, 0)
    DESO F 10 Bright A_CustomMissile("CardinalRail", 40, -26, 0)
	DESO E 12
	Goto See
  10kTracer:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DESO E 18 A_FaceTarget
	DESO E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  10kTracerLoop:
    TNT1 A 0 A_CustomMissile("Cardinal10K", 40, 26, frandom(-4,4))
    DESO F 6 Bright A_CustomMissile("Cardinal10K", 40, -26, frandom(-4,4))
    DESO E 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	DESO E 12
	TNT1 A 0 A_Jump(64,"BFG9500")
	Goto See
  15kBall:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	DESO E 18 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  15kBallLoop:
	DESO E 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("Desolator15k", 40, 26, frandom(-4,4))
    DESO F 6 Bright A_CustomMissile("Desolator15k", 40, -26, frandom(-4,4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
    DESO E 6 A_FaceTarget
	DESO E 12
	TNT1 A 0 A_Jump(64,"BFG9500")
	Goto See
  BFG9500:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	DESO E 15 A_FaceTarget
	DESO E 12 A_FaceTarget
	DESO F 6 A_FaceTarget
    TNT1 A 0 A_CustomMissile("DesolatorBFG9500Ball", 40, 26, 0)
    DESO F 4 Bright A_CustomMissile("DesolatorBFG9500Ball", 40, -26, 0)
	DESO E 12
	Goto See
  Pain:
	TNT1 A 0 A_Jump(61,"PainMissile")
    DESO G 10 A_Pain
    Goto See
  PainMissile:
	DESO G 10 A_Pain
    Goto Missile
  Death.PlayerIce:
  Death:
	DESO G 10 A_Scream
	DESO H 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DESO IIIII 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DESO JJJJJ 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    DESO KKKKK 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DESO LLLLL 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    DESO MMMMM 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    DESO NO 5
	TNT1 A 0 A_BossDeath
    DESO P -1
    Stop		
  Crush:
	BOCR A -1 A_PlaySound("gib/squish")
	Stop
  }
}	

Actor Desolator15k : Cybruiser15K { DamageType "Cyber10K" Species "Cybers" }

Actor DesolatorBFG9500Ball : SentientBFG9500Ball
{
  DamageType "Cyber10K"
  Species "Cybers"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwaveRed2", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("Kaboom18", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BRE3 AB 8 Bright A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BRE3 C 8 Bright A_BFGSpray("DesolatorCustomSprayRed",15,15)
    BRE3 DEF 8 Bright
    Stop    
  }
}

Actor DesolatorCustomSprayRed : CustomSpray
{
  DamageType "Cyber10K"
  Species "Cybers"
  States
  {
  Spawn:
    TNT1 A 0
    BRE2 A 6 Bright A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    BRE2 BCD 6 Bright 
    Stop
  }
}