Actor CorruptedCardinal : CFAnnihilator
{
  Monster
  Health 8000
  Height 100
  Radius 40
  Speed 10
  Mass 0x7FFFFFFF
  Scale 1.1
  MeleeDamage 10
  Species "Cybers"
  BloodColor "33 66 99"
  DamageFactor 0.5
  DamageFactor "PyroShot", 0.25
  DamageFactor "PlayerPyro", 0.25
  DamageFactor "PlayerBHole", 0.25
  DamageFactor "Player", 0.05
  DamageFactor "DBFG10K2", 0.0 // 0.05
  DamageFactor "PlayerDBFG10K2", 0.05
  DamageFactor "DBFG2", 0.0 // 0.05
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "PlayerDBFG2", 0.10
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "Legendary", 0.75 // Monster+player
  DamageFactor "SuperWeapon", 0.75
  DamageFactor "LegendaryPlayer", 0.75
  DamageFactor "PlayerLegendary", 0.75
  DamageFactor "LegendaryGuru", 0.75
  DamageFactor "LegendaryGuruPlayer", 0.75
  DamageFactor "PlayerDevBall", 0.65
  DamageFactor "PlayerDevTracer", 0.15
  DamageFactor "BFG10K", 0.65
  DamageFactor "BFG9500Ball", 0.1
  DamageFactor "CustomSpray", 0.1
  DamageFactor "BFGSplash", 0.1
  DamageFactor "BFGSpray", 0.1
  DamageFactor "Explosion", 0.1
  DamageFactor "PDTBFG", 0.1
  DamageFactor "PDTBFGTracer", 0.1
  DamageFactor "PDTPuff", 0.1
  DamageFactor "Cyber10K", 0.0 // Monster+player dev.
  // No infighting.
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "Legendary1", 0.0 // Leg Imp
  DamageFactor "VileFires", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "ZombieDev", 0.0
  DamageFactor "BeheComet", 0.0
  DropItem "BossLifeEssence", 192
  DropItem "BossArmorBonusMax", 192
  DropItem "DemonicChaliceGiver", 96, 1
  DropItem "UltraSphere", 256, 1
  Dropitem "D-BFGGiver", 256
  Dropitem "DCellPackPickup", 256, 32
  Dropitem "DCellPackPickup", 128, 24
  Dropitem "DCellPickup", 256, 10
  Dropitem "DCellPickup", 256, 10
  Dropitem "DCellPickup", 256, 10
  +DONTHARMSPECIES
  +QUICKTORETALIATE
  +NORADIUSDMG
  +NOGRAVITY
  //+FLOATBOB
  +FLOAT
  +BOSS
  +MISSILEMORE
  +MISSILEEVENMORE
  //+NOTARGET
  +FLOORCLIP
  +DONTMORPH
  +BOSSDEATH
  +NOICEDEATH
  +CANTSEEK
  +DONTGIB
  +DONTRIP
  // Pain Chances
  PainChance 2 // 5
  PainChance "DBFG2", 0
  PainChance "PlayerDBFG2", 0
  PainChance "DBFG10K2", 0
  PainChance "PlayerDBFG10K2", 0
  PainChance "SoulToxic", 5
  PainChance "Explosion", 40
  PainChance "BFG9500Ball", 40
  PainChance "PlayerDevBall", 100
  PainChance "BFG10K", 100
  PainChance "PDTBFG", 100
  PainChance "Legendary", 100 // 100
  PainChance "LegendaryPlayer", 100 // 100
  PainChance "LegendaryGuru", 256
  PainChance "LegendaryGuruPlayer", 256
  SeeSound "BlueCardinal/Sight"
  //PainSound "BlueCardinal/Pain"
  ActiveSound "BlueCardinal/Active"
  DeathSound "BlueCardinal/Death"
  Obituary "$CFCorruptedCardinalObit"
  Tag "$CFCorrCar"
  var int user_music;
  var int user_rageshot;
  var int user_lasershot;
  var int user_voidtravel;
  var int user_disappeared;
  var int user_mirrored;
  var int user_flashing;
  var int user_lowlag;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_loop;
  States
  {
  Spawn:
	BCRD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",44)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  SpawnLoop:
	BCRD AB 4 Bright A_Look
	//TNT1 A 0 A_JumpIfhealthLower(8000,"Idle")
	Loop
  Idle:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfHealthLower(4000,2) // 3000
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_JumpIf(user_disappeared < 1,"Disappear")
	TNT1 A 0 A_Jump(16,"Teleport")
	BCRD AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	BCRD BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	BCRD AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	BCRD BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	BCRD AA 2 Bright A_Wander
	TNT1 A 0 A_Look
	BCRD BB 2 Bright A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	BCRD AABB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,744)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnSetReflectiveInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfHealthLower(3000,2) // 3000
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_JumpIf(user_disappeared < 1,"Disappear")
	TNT1 A 0 A_Jump(100,"Rush")
	BCRD AABBAABBAABB 2 Bright A_Chase
	Loop
  Missile:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIfTargetInLos("Normal",90,JLOSF_NOSIGHT|JLOSF_DEADNOJUMP)//Excludes the looping in attacks on given to the killed enemy,it happened more than once.
	//TNT1 A 0 A_ClearTarget
	Goto See
  Normal:
	TNT1 A 0 A_JumpIfCloser(128,"Teleport")
	TNT1 A 0 A_Jump(64,"DBFG10K","Railgun","DBFG","DBFG10KBall","Lasers")
	BCRD CCCCC 1 Bright A_FaceTarget(45)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	TNT1 A 0 A_CustomMissile("BlueCardinalRocket",72,-30,0)
	BCRD DC 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueCardinalRocket",72,-30,0)
	BCRD DC 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueCardinalRocket",72,-30,0)
	BCRD DCC 5 Bright A_FaceTarget
	TNT1 A 0 A_JumpIfCloser(512,"Whirl")
	Goto See
  Rush:
	TNT1 A 0 A_PlaySound("BlueCardinal/Rush",CHAN_VOICE)
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	BCRD A 2 Bright A_SpawnItemEx("BlueCardinalGhost")
	TNT1 AAAA 0 A_Chase
	BCRD A 2 Bright A_SpawnItemEx("BlueCardinalGhost")
	TNT1 AAAA 0 A_Chase
	BCRD B 2 Bright A_SpawnItemEx("BlueCardinalGhostB")
	TNT1 AAAA 0 A_Chase
	BCRD B 2 Bright A_SpawnItemEx("BlueCardinalGhostB")
	TNT1 AAAA 0 A_Chase
	TNT1 A 0 A_Jump(16,"Teleport")
	TNT1 A 0 A_Jump(32,"See")
	Loop
  Whirl:
	TNT1 A 0 A_JumpIfCloser(128,"Teleport")
	TNT1 A 0 A_Jump(128,"DBFG10K")
	TNT1 A 0 A_PlaySound("BlueCardinal/Whirl",CHAN_VOICE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCC1 AABBCCDDABCDABCDABCD 2 Bright A_Chase(0,0)
	TNT1 A 0 A_UnSetShootable
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCC1 AABBCCDDAAB 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase(0,0,CHF_NIGHTMAREFAST)
	TNT1 A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCT1 BCCDDAABBCCD 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("BlueCardinal/Spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  WhirlLoop:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"WhirlLoop")
	BCC1 ABCD 2 Bright A_Chase(0,0)
	TNT1 A 0 A_PlaySound("BlueCardinal/Spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  WhirlLoop2:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"WhirlLoop2")
	BCC1 ABCD 2 Bright A_Chase(0,0)
	TNT1 A 0 A_PlaySound("BlueCardinal/Spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  WhirlLoop3:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"WhirlLoop3")
	BCC1 ABCD 2 Bright A_Chase(0,0)
	TNT1 A 0 A_PlaySound("BlueCardinal/Spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  WhirlLoop3:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"WhirlLoop3")
	BCC1 ABCDABCD 2 Bright A_Chase(0,0)
	BCC1 ABCD 3 Bright A_Chase(0,0)
	BCC1 ABCD 4 Bright A_Chase(0,0)
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("CyberRail/Charge")
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCC2 BABABA 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueCyberRail",88,-30,0)
	BCF1 A 4 Bright A_FaceTarget
	BCF1 A 6 Bright A_FaceTarget
	BCC2 A 4 Bright A_FaceTarget
	BCRD CC 5 A_FaceTarget
	//TNT1 A 0 A_Jump(128,"Missile")
	Goto Missile
  "DBFG":
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge") // 196 tics.
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCC2 BAABAABAABA 4 Bright A_FaceTarget
	BCC2 BABBABAB 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire",CHAN_AUTO)
	TNT1 A 0 A_CustomMissile("T3DBFGBall",72,0,random(-4,4),0,random(-4,4))
	BCF1 A 6 A_FaceTarget
	BCC2 AB 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgcooldown")
	BCRD C 4 A_FaceTarget
	Goto See
  "DBFG10K":
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2") // 196 tics.
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCC2 BA 4 Bright A_FaceTarget
	/*
	BCC2 BAB 3 Bright A_FaceTarget
	BCC2 ABABAB 2 Bright A_FaceTarget*/
  "DBFG10KHold":
	BCC2 AB 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2")
	BCF1 A 3 Bright A_CustomMissile("T3DBFG10kShot",72,0,random(-4,4),0,random(-4,4))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12)
	TNT1 A 0 A_CheckSight(2)
	TNT1 A 0 A_Jump(240,"DBFG10KHold")
	TNT1 A 0 A_PlaySound("Weapons/dbfgcooldown2")
	BCC2 AB 2
	BCRD CC 2
	BCRD AABB 6 Bright A_FaceTarget
	Goto See
  "DBFG10KBall":
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2") // 196 tics.
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCC2 BA 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2")
	BCF1 A 3 Bright A_CustomMissile("T3DBFG10KBall",72)
	Goto See //Missile
  "FlashBFGs":
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 A 0 A_PlaySound("BlueCardinal/Flash",CHAN_NOPAUSE)
	BCFL ABCDEDEDE 4 Bright A_FaceTarget
	BCFL DEDE 4 Bright A_FaceTarget
	BCFL DEDE 7 Bright A_FaceTarget
	BCFL DE 6 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_flashing",0)
  "Flashing":
	TNT1 A 0 A_JumpIf(user_flashing >= 6,"See") //Missile
	TNT1 A 0 A_SetUserVar("user_flashing",user_flashing+1)
	TNT1 A 0 A_UnSetShootable
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCFL EEEEE 1 Bright A_FadeOut(0.2,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 AAAA 0 A_Chase(0,0,CHF_NIGHTMAREFAST)
	TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	TNT1 A 0 A_FaceTarget
	BCFL EEEEE 1 A_FadeIn(0.2)
	BCFL DCBA 1 Bright A_FaceTarget
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2")
	BCF1 A 3 Bright A_CustomMissile("T3DBFG10KBall2",72)
	TNT1 A 0 A_JumpIf(user_flashing >= 6,"Missile")
	BCFL ABCDE 1 Bright A_FaceTarget
	Loop
   Lasers:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("BlueCardinal/Charge2",CHAN_NOPAUSE)
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC AB 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC CA 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC BC 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC AB 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC CA 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC BC 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",frandom(-1,1),frandom(-1,1),8)
	BCLC D 4
	//TNT1 A 0 A_PlaySound("BlueCardinal/Charge",CHAN_AUTO|CHAN_NOPAUSE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_lasershot",0)
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
  Lasering:
	TNT1 A 0 A_JumpIf(user_lasershot >= 24,"See")
	TNT1 A 0 A_SetUserVar("user_lasershot",user_lasershot+1)
	TNT1 A 0 A_PlaySound("Laser/Beam",CHAN_NOPAUSE)
	TNT1 A 0 Bright A_CustomMissile("LaserBeam",116,6,0,0)
	BCLR A 2 Bright A_CustomMissile("LaserBeam",116,-6,0,0)
	TNT1 A 0 Bright A_CustomMissile("LaserBeam",116,6,0,0)
	BCLR B 2 Bright A_CustomMissile("LaserBeam",116,-6,0,0)
	Loop
  Rage:
	TNT1 A 0 A_JumpIfCloser(128,"Teleport")
	TNT1 A 0 A_UnSetShootable
	BCRD E 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("BlueCardinal/Whirl",CHAN_VOICE)
	BCRD EEC 5 Bright A_FaceTarget
	BCRD E 5 Bright A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCRD C 5 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCRD C 5 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCRD C 5 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCRD C 5 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2") // 196 tics.
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCC2 B 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCC2 A 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCC2 BA 3 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCC2 B 3 Bright A_FaceTarget
	BCC2 AB 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCC2 AB 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueCardinalRagingSmokeSpawner",0,0,64,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_mirrored",0)
	TNT1 A 0 A_SetUserVar("user_rageshot",0)
	TNT1 A 0 A_SetShootable
  Raging:
	TNT1 A 0 A_JumpIf(user_rageshot >= 24,"RagingFinalBlow")     
	TNT1 A 0 A_SetUserVar("user_rageshot",user_rageshot+1)
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2")
	TNT1 A 0 A_FaceTarget
	BCF1 A 3 Bright A_CustomMissile("T3DBFG10kShot",72,0,frandom(6,-6),0,frandom(-4,4))
	BCC2 AB 1 Bright
	Loop
  RagingFinalBlow:
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire",CHAN_AUTO)
	TNT1 A 0 A_CustomMissile("T3DBFGBall",72,0,frandom(-4,4),0,frandom(-4,4))
	BCF1 AAA 2 A_FaceTarget
	BCC2 AB 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/dbfgcooldown")
	BCRD C 4 A_FaceTarget
	Goto See
  Pain:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(64,"PainMirror")
	TNT1 A 0 A_PlaySound("BlueCardinal/Pain")
	TNT1 A 0 A_Jump(32,"Rage","FlashBFGs")
	TNT1 A 0 A_Jump(64,"Teleport","Rage","FlashBFGs")
	TNT1 A 0 A_Jump(128,"Dodge")
	TNT1 A 0 A_Jump(128,"PainMissile")
	BCT1 X 8 Bright
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,16,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto See
  "PainMirror":
	TNT1 A 0 A_PlaySound("BlueCardinal/Pain")
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,0)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,45)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,90)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,135)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,180)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,225)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,270)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorOut",0,0,0,-16,0,0,315)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCFL AAAAA 1 Bright A_FadeOut(0.2,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,0)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,45)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,90)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,135)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,180)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,225)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,270)
	BCFL A 1 A_SpawnItemEx("BlueCardinalTeleportMirrorIn",-400,0,0,16,0,0,315)
	TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	TNT1 A 0 A_FaceTarget
	BCFL AAAAA 1 Bright A_FadeIn(0.2)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_Jump(32,"Rage")
	TNT1 A 0 A_Jump(64,"Teleport","Rage")
	TNT1 A 0 A_Jump(128,"Dodge")
	TNT1 A 0 A_Jump(128,"PainMissile")
	BCT1 X 8 Bright
	Goto See //Missile
  Pain.Legendary:
  Pain.LegendaryPlayer:
  Pain.PlayerDevBall:
  Pain.PDTBFG:
  Pain.BFG10K:
	TNT1 A 0 A_Jump(200,"Teleport")
	TNT1 A 0
	Goto PainMissile
  Pain.LegendaryGuru:
  Pain.LegendaryGuruPlayer:
	TNT1 A 0 A_JumpIf(user_mirrored < 1,"MirrorDodge")
	TNT1 A 0 A_Jump(256,"Teleport")
	TNT1 A 0
	Goto PainMissile
  "Dodge":
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Jump(128,3)
	TNT1 A 0 ThrustThing(angle*256/360+64,15,0,0)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 ThrustThing(angle*256/360+192,15,0,0)
	BCT1 X 8
	Goto PainMissile
  "MirrorDodge":
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_mirrored",1)
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 A 0 A_SpawnItemEx("LightBlueStruckGlow",0,0,48)
	BCT1 XXXXX 1 Bright A_FadeOut(0.2,0)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,0)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,45)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,90)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,135)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,180)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,225)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,270)
	TNT1 A 0 A_SpawnItemEx("BlueCardinalSplitMirror",0,0,0,-16,0,0,315)
	TNT1 A 90 // 20+64+20=104
	BCT1 XXXXX 1 Bright A_FadeIn(0.2)
	TNT1 A 0 A_SpawnItemEx("LightBlueStruckGlow",0,0,48)
	TNT1 A 0 A_SetShootable
	Goto PainMissile
  PainMissile:
	BCT1 X 8 Bright
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,16,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto Missile
  "Taunt":
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("BlueCardinal/Taunt",CHAN_VOICE)
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	BCT1 AB 4 Bright
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	BCT1 AB 3 Bright
	BCT1 A 2 Bright
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	BCT1 BABA 2 Bright
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	BCT1 B 2 Bright
	BCT1 AB 3 Bright
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	BCT1 AB 4 Bright
	TNT1 A 0 A_SpawnItemEx("BlueCardShield",Random(-1,1),Random(-1,1),8)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  "Teleport":
	TNT1 A 0 A_UnSetShootable
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCT1 XXXXXXXXXX 1 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase(0,0,CHF_NIGHTMAREFAST)
	//TNT1 AAAA 0 A_Wander // Removed on 2016-07-31
	TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	TNT1 A 0 A_FaceTarget
	// Dash.
	TNT1 A 0 A_Jump(192,3)
	TNT1 A 0 ThrustThing(angle*256/360+128,15,0,0)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 ThrustThing(angle*256/360,15,0,0)
	BCT1 XXXXXXXXXX 1 A_FadeIn(0.1)
	BCT1 X 20
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_Jump(70,"DBFG10K")
	TNT1 A 0 A_Jump(128,"Taunt")
	Goto See //Missile
  "Disappear":
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_disappeared",1)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	BCT1 XXXXXXXXXX 4 Bright A_FadeOut(0.1,0)
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 A 0 A_SetUserVar("user_voidtravel",0)
  "VoidTravel":
	TNT1 A 0 A_JumpIf(user_voidtravel >= Random(15,45),"Reappear")     
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	TNT1 A 35
	TNT1 A 0 A_SetUserVar("user_voidtravel",user_voidtravel+1)
	Loop
  "Reappear":
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase(0,0,CHF_NIGHTMAREFAST)
	TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("BlueCardLineSpawner")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 ThrustThing(angle*256/360+128,15,0,0)
	BCT1 XXXXXXXXXX 1 A_FadeIn(0.1)
	BCT1 X 20
	TNT1 A 0 A_ChangeVelocity(0,0,0,CVF_REPLACE)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_Jump(70,"DBFG10K")
	TNT1 A 0 A_Jump(128,"Taunt")
	Goto See
  Raise:
	Stop
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_PlaySound("BlueCardinal/Taunt",CHAN_VOICE)
	// Dying
	BCT1 AA 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCT1 BB 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	// Whirl Attack
	TNT1 A 0 A_PlaySound("BlueCardinal/Spit")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	// Dying
	BCT1 AABB 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCT1 AABB 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	// Whirl attack 2
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop2")
	// Dying
	BCT1 AABB 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCT1 AABB 2 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	// Whirl attack 3
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	// Dying
	BCT1 AABB 1 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	BCT1 AABB 1 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	// Whirl attack 4
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop4:
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,user_loop * 20,CMF_AIMDIRECTION,(user_loop - 8) * 5)
	TNT1 A 0 A_CustomMissile("BlueCardball",72,0,0,CMF_AIMDIRECTION,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 18,2)
	TNT1 A 0 A_Jump(256,"DeathLoop4")
	// Explode
	BCRD E 5 Bright A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	TNT1 A 0 A_SpawnItemEx("BlueFireSpawner",0,0,-12)
	BCRD E 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD F 2 Bright A_Scream
	BCRD FF 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD G 5 Bright A_NoBlocking
	BCRD G 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD H 2 Bright
	BCRD HH 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD I 2 Bright
	BCRD II 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD J 2 Bright
	BCRD J 3 A_SpawnItemEx("BlueCardRocketExplosion",frandom(-31,31),frandom(-31,31),frandom(39,99),frandom(1,2),frandom(1,2),frandom(-2,2),random(0,360))
	BCRD KL 8 Bright
	Stop
  }
}

//====================
Actor BlueCardinalRocket
{
  Game Doom
  SpawnID 127
  Projectile
  Radius 11
  Height 8
  Speed 20
  Damage (Random(50,125)) //19
  Species "Cybers"
  DamageType "DBFG2"
  +RANDOMIZE
  +DEHEXPLOSION
  +ROCKETTRAIL
  +SEEKERMISSILE
  SeeSound "weapons/rocklf"
  DeathSound "weapons/rocklx"
  States
  {
  Spawn:
	BCRC AB 4 Bright A_Tracer2
	TNT1 A 0 A_PlaySound("Weapons/homingbeep")
	Loop
  Death:
	BCRC C 8 Bright A_Explode
	BCRC D 6 Bright
	BCRC E 4 Bright
	Stop
  }
}


Actor BlueCardBall
{
  Projectile
  Radius 11
  Height 8
  Speed 18
  Scale 0.25
  Renderstyle Add
  Alpha 0.97
  Decal "Scorch"
  Damage (Random(50,85)) //15
  SeeSound "Imp/Attack"
  DeathSound "Imp/ShotX"
  +EXPLODEONWATER
  +FORCERADIUSDMG
  +DONTBLAST
  Species "Cybers"
  DamageType "DBFG2"
  Obituary "$CFBlueCardBallObit"
  States
  {
  Spawn:
	D3PP ABCDEFG 1 Bright A_SpawnItemEx("BlueCardballTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_Explode(128,128,0)
	TNT1 A 0 A_PlaySound("weapons/t2fbx1", 0, 0.75, 0, ATTN_NORM)
	TNT1 A 1 A_SpawnItemEx("BlueCardballExp")
	Stop
  }
}

Actor BlueCardballExp
{
  Scale 0.75
  Renderstyle Add
  Alpha 0.75
  +NOGRAVITY
  +NOINTERACTION
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	D3PX AB 1 Bright A_FadeOut(0.05,1)
	D3PX C 1 Bright A_FadeOut(0.045,1)
	D3PX D 1 Bright A_FadeOut(0.035,1)
	D3PX E 1 Bright A_FadeOut(0.025,1)
	D3PX F 1 Bright A_FadeOut(0.015,1)
  Continuous:
	D3PX G 1 Bright A_FadeOut(0.065,1)
	Loop
  }
}


Actor BlueCardballTrail : T3BaseEffect
{
  Scale 0.35
  Renderstyle Add
  Alpha 0.75
  +CLIENTSIDEONLY
 +NOINTERACTION
   +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	D3PP ABCDEFG 1 Bright A_FadeOut(0.1)
	Loop
  }
}

Actor BlueCardRocketExplosion : BlueCardinalRocket
{
  Speed 5
  Species "Cybers"
  DamageType "DBFG2"
  SeeSound ""
  DeathSound ""
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,1)
	Goto AltDeath
	TNT1 A 0 A_PlaySound("weapons/rockhit")
	Goto Death
  AltDeath:
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360),CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360),CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 1 A_Explode(128,128,0)
	Stop
  }
}


Actor BlueCardRocketExplosionBundle
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAA 1 A_SpawnItemEx("BlueCardRocketExplosion", frandom(-31,31), frandom(-31,31), frandom(39,-39), frandom(1,2), frandom(1,2), frandom(-2,2), random(0,360))
	Stop
  }
}

Actor BlueCardShield : T3BaseEffect
{
  YScale 2.0
  XScale 1.5
  RenderStyle Add
  Alpha 0.8
  States
  {
  Spawn:
	TNT1 A 0
	BCSH ABCDEFGH 1 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor BlueCardLineSpawner : BluePowerLineSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAAAA 0 A_SpawnItemEx("BlueCardPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("BlueCardPowerLine",frandom(-48,48),frandom(-48,48),frandom(0,48),0,0,frandom(2,8),0,SXF_CLIENTSIDE,0) 
	Stop  
  }
}


Actor BlueCardPowerLine : BluePowerLine
{
  Scale 0.84
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	SPFX A 5 Bright
	TNT1 A 0 A_Jump(128,"FadeOut2")
	Goto Normal
  Normal:
	SPFX AAAAAAAA 1 Bright A_FadeOut(0.025,1)
	Stop
  FadeOut2:
	SPFX AAAAAAAA 1 Bright A_FadeOut(0.03,1)
	Stop
  }
}

