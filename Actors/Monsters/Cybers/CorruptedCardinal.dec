	TNT1 A 0
	BCFL AAAAAAAAAA 2 A_FadeIn(0.1) // BCRDE
	BCFL AAAAA 1 A_FadeOut(0.2,1)
	Stop
  }
}

Actor BlueCardinalTeleportMirrorOut : BlueCardinalMirror
{
  Alpha 1.0
  States
  {
  Spawn:
	TNT1 A 0
	BCFL AAAAAAAAAA 2 A_FadeOut(0.1,1) // BCRDE
	Stop
  }
