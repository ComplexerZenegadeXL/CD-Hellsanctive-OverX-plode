  }
}

Actor BlueAnniFlameSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 AAAAAA 0 A_SpawnItemEx("BlueAnniFlame",frandom(-20,20),frandom(-20,20),frandom(40,80),0,0,frandom(2,6),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor CyberIceSpike : FRZRIceSpike
{
  Health 60
  DamageFactor "Cyber10k", 0.0
  Species "Cybers"
