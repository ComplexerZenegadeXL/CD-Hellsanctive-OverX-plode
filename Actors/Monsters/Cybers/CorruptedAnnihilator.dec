Actor CorruptedCyberLord : CFAnnihilator 
{
  Health 5500
  PainChance 32
  BloodColor "DarkBlue"
  PainChance "PDTBFG", 20
  PainChance "SoulToxic", 15
  PainChance "FatFlamer", 15
  PainChance "FiendFire", 15
  PainChance "Explosion", 80
  Mass 5500
  +QUICKTORETALIATE
  +MISSILEEVENMORE
  +NOICEDEATH
  +THRUSPECIES
  Speed 18
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "PlayerFireSword", 2.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "DBFG2", 0.0
  DropItem "FreezerRifleGiver" 128 1
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "MissileBoxPickup" 128 20
  Obituary "$CFCorruptedCyberLordObit"
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.3
  DamageFactor "PDTBFGTracer", 0.5
  SeeSound "monsters/clsee"
  PainSound "monsters/cyberlordpain"
  DeathSound "monsters/cldie"
  Tag "$CFCorrAnni"
  var int user_lowlag;
  States 
  {    
  Spawn: 
    4NNI A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	4NNI AA 10 A_Look
	4NII AA 10 A_Look
    Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	4NNI AABB 3 A_Chase
	4NNI A 3 A_Playsound("monsters/clhoof")
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(60,"Rush")
    4NNI A 3 A_Playsound("monsters/clhoof")
    4NNI ABB 3 A_Chase		
    4NNI C 3 A_Playsound("monsters/clhoof") 
    4NNI CDD 3 A_Chase 		 
    Loop
  Rush:
	TNT1 A 0 A_Metal
	4NNI AA 0 A_Chase
    4NNI A 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI A 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI B 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI B 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI C 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI C 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	TNT1 A 0 A_Metal
	4NNI AA 0 A_Chase
    4NNI D 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	4NNI AA 0 A_Chase
    4NNI D 2 A_SpawnItemEx("BlueAnniGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	TNT1 A 0 A_Jump(87,"See")		
	Loop
  Missile:
  Normal:
	TNT1 A 0 A_Jump(128,"Seekers","FloorStomp","BFG15K","Railgun")
    4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordRocket", 56, -26, 0)
    4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordRocket", 56, -26, 0)
    4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordRocket", 56, -26, 0)
	4NNI E 8
	TNT1 A 0 A_Jump(128,"Seekers","FloorStomp","Railgun","BFG15K","CryoRockets")
    Goto See
  Seekers:
	4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordHomer", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordHomer", 56, -26, 0)
    4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordHomer", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordHomer", 56, -26, 0)
    4NNI E 8 A_FaceTarget
    TNT1 A 0 A_CustomMissile("BCyberLordHomer", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberLordHomer", 56, -26, 0)
	4NNI E 8
	TNT1 A 0 A_Jump(128,"FloorStomp","Railgun","BFG15K","CryoRockets")
	Goto See
  FloorStomp:
    4NNI G 10 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	4NMA A 3 Bright A_PlaySoundEx("monsters/clsee","Voice")
	TNT1 A 0 A_FaceTarget
	4NMA A 3 Bright A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	4NMA A 3 Bright A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	4NMA A 3 Bright A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	4NMA A 3 Bright A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	4NMA A 3 Bright A_SpawnItemEx("BlueAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	4NMA A 7 A_FaceTarget
	4NMA A 5 A_FaceTarget
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	4NMA B 6 A_PlaySound("monsters/Darkcyberstomp")
	4NMA B 2 Bright A_SpawnItemEx("AnnihilatorSpikeSpawner",0,0,0,0,0,0,0) //A_VileTarget("AnnihilatorSpikeSpawner")
	4NMA B 20
	TNT1 A 0 A_Jump(128,"Railgun","BFG15K","CryoRockets")
    Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    4NNI EE 10 A_FaceTarget
	4NNI E 10 Bright A_FaceTarget
	TNT1 A 0 A_CustomRailgun(Random(60,80), 26, None, "Blue", RGF_NOPIERCING,1,2,"CyberRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
    4NNI F 10 Bright A_CustomRailgun(Random(60,80), -26, None, "Blue", RGF_NOPIERCING,1,2,"CyberRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	4NNI E 15
	TNT1 A 0 A_Jump(128,"BFG15K","CryoRockets")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	4NNI E 18 Bright A_FaceTarget
	4NNI E 6 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))	
	4NNI E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))	
	4NNI E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))
	4NNI E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))
	4NNI E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))
	4NNI E 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("BlueAnni15K",56,-26,frandom(-4, 4))
	4NNI F 4 Bright A_CustomMissile("BlueAnni15K",56,26,frandom(-4, 4))
	4NNI E 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	TNT1 A 0 A_Jump(87,"CryoRockets")
	Goto See
  CryoRockets:
    TNT1 A 0 A_PlaySound("weapons/charge15k")
    4NNI E 12 A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("BCyberCryoRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberCryoRocket", 56, -26, 0)
    4NNI E 12 A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("BCyberCryoRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberCryoRocket", 56, -26, 0)
	4NNI E 12 A_FaceTarget
    TNT1 A 0 Bright A_CustomMissile("BCyberCryoRocket", 56, 26, 0)
    4NNI F 6 Bright A_CustomMissile("BCyberCryoRocket", 56, -26, 0)
    4NNI E 8 A_FaceTarget
	Goto see
  Pain:
	TNT1 A 0 A_Jump(87,"PainMissile")
    4NNI G 10 A_Pain
    Goto See
  PainMissile:
	4NNI G 10 A_Pain
    Goto Missile
  Death.PlayerIce:
  Death:
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,2)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,12)
	4NNI G 10 A_Scream
	4NNI H 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    4NNI IIIII 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    4NNI JJJJJ 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    4NNI KKKKK 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CyberIceSpike", frandom(-256,256), frandom(-256,256), 0, 0, 0, 0, 0, SXF_SETMASTER|SXF_NOCHECKPOSITION, 0)
    4NNI LLLLL 1 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    4NNI MMMMM 1 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("CABigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    4NNI NO 5
    4NNI P -1
    Stop	
  }
}

Actor CABigBlueBloodCloud : BlueBloodCloud
{
  Speed 2
  Scale 1.5
}

Actor BCyberLordRocket : NewRocket
{
  Speed 20
  Damage (Random(40,80)) //20
  FastSpeed 24
  Species "Cybers"
  DamageType "Cyber10K"
  +MTHRUSPECIES
  Decal "LegRocketScorch"
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(4,6),frandom(-2,2)) 
    BMIS A 1 Bright
    Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode
    TNT1 A 1 A_SpawnItemEx("BlueRocketEx")
    Stop
  }
}

Actor BCyberLordHomer : CadaverRocket
{
  Speed 20
  FastSpeed 24
  Damage (Random(30,60)) //10
  Species "Cybers"
  DamageType "Cyber10K"
  Decal "LegRocketScorch"
  SeeSound "monster/homingrockfire"
  +MTHRUSPECIES
  States
  {
  Spawn:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    BHMI A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	BHMI A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    BHMI A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	BHMI A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    BHMI A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	BHMI A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    BHMI A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	BHMI A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))	
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(68,128)
    TNT1 A 1 A_SpawnItemEx("BlueRocketEx")
    Stop
  }
}

Actor BlueRocketEx
{
  RenderStyle Add
  Alpha 0.85
  +CLIENTSIDEONLY
  +NOGRAVITY
  States
  {
  Spawn:
    BMSL B 6 Bright
    BMSL CD 5 Bright
    Stop
  }
}

Actor BlueBFGShockwave : DTech10KShockwave 
{
  Scale 0.9
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    AHOG ABCDEFGHIJKLMNOPQR 1 Bright A_FadeOut(0.04)
    Stop
  }
}
Actor BlueAnniRailgunTrail
{
  RenderStyle Normal
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +DONTSPLASH
  +NOCLIP
  +NOINTERACTION
  +THRUACTORS
  Scale 1
  States
  {
  Spawn:
	TNT1 A 0
	RGPB ABCDEFGHIJKLMNOP 2 A_FadeOut(0.04)
	Stop
  }
}

Actor BlueAnni15K : BFG15KBall
{
  FastSpeed 50
  +MTHRUSPECIES
  Decal "LegRocketScorch"
  Species "Cybers"
  DamageType "Cyber10K"
  States
  {
  Spawn:
    BFS9 AB 2 Bright A_SpawnItemEx("CABFGTrailParticleBlue",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),Random(-20,20),SXF_CLIENTSIDE)
    Loop
  Death:
    TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueBFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))      
    BFE9 A 4 Bright A_Explode
    BFE9 BCDEF 4 Bright
    Stop
  }
}

Actor CABFGTrailParticleBlue : ProjectileTrailParticleGreen
{
  Scale 0.06
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    SPKB A 2 Bright A_FadeOut(0.015)
    Loop
  }
}

Actor BlueAnniFireSpawner : DukeFireSpawner
{
  Speed 25
  FastSpeed 30
  Damage (Random(20,50)) //8
  Species "Cybers"
  DamageType "Cyber10K"
  Obituary "$CFBlueAnniFireSpawnerObit"
  States
  {
  Spawn: 
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_CustomMissile("BlueAnniFire",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Loop  
  Death:
    TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BTRD K 4 Bright
    BTRD L 4 Bright A_Explode(32,86)
    BTRD MNO 3 Bright
    Stop
  }
}

Actor BlueAnniFire : DukeFire
{
  Species "Cybers"
  DamageType "Cyber10K"
  Obituary "$CFBlueAnniFireObit"
  States
  {
  Spawn:
    TNT1 A 0
    BTRD A 1 Bright A_Explode(25,68)
	BTRD ABBCDEFGHIJ 1 Bright A_FadeOut(0.05)
    Stop
  }
}

Actor BlueAnniGhostA
{
  Scale 1.1
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOCLIP
  States
  {
  Spawn:
    4NNI A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor BlueAnniFlame
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  RenderStyle Add
  Scale 0.5
  States
  {
  Spawn:
