Actor ClockworkCyberdemon : DarkCyberdemon
{
  Scale 0.9
  Health 5500
  PainChance 0
  Speed 20
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "BossArmorBonusMax" 200
  DropItem "BossArmorBonusMax" 200
  DropItem "BossArmorBonusMax" 200
  DropItem "NewCellPackPickup" 186 300
  DropItem "BFG10KGiver" 178
  DropItem "RailgunGiver" 184
  DropItem "ExplosiveShotgunGiver" 128
  DropItem "ExplosiveSSGGiver" 64
  Obituary "$CFClockworkCyberdemonObit"
  DamageFactor "Normal", 0.65
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.5
  DamageFactor "PDTBFGTracer", 0.8
  DamageFactor "HellComet", 0.7
  SeeSound "Clockwork/Sight"
  ActiveSound ""
  DeathSound "Clockwork/Death"
  +NOICEDEATH
  +NOBLOOD
  +NOEXTREMEDEATH
  +NOPAIN
  Tag "$CFClockCyb"
  States 
  {    
  Spawn: 
	CCYB A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CCYB A 10 A_Look
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_Hoof
    CCYB AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Hoof
    CCYB A 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB A 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB A 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB B 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB C 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB C 2 A_Chase
    TNT1 A 0 A_Metal
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB D 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CCYB D 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("InsaneCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)    
    Loop
  Missile:
    TNT1 A 0 A_Jump(128,"RailgunCharge","MiniDTBFG")
  EMinigun:  
    TNT1 A 0 A_JumpIfCloser(400,"EASG")
  ActuallyFireIt:
    CCYB E 14 A_FaceTarget
    CCYB E 2 A_FaceTarget
    TNT1 A 0 A_PlaySound("sentient/fire")
    CCYB F 2 Bright A_CustomMissile("TerminatorExplosiveTracer",50,-25,frandom(-1,1),0)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 A 0 A_JumpIfCloser(400,"EASG")
    TNT1 A 0 A_Jump(18,"See")
    TNT1 A 0 A_SpidRefire    
    Goto ActuallyFireIt+1
  EASG:
    CCYB E 14 A_FaceTarget
    TNT1 A 0 A_PlaySound("weapons/ExplosiveSG/fire",7)
    TNT1 A 0 A_SpawnItemEx("OrangeShellCasing", 0, 12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    TNT1 AAAAAA 0 A_CustomMissile("TerminatorExplosiveTracer",50,-25,frandom(-4,4),0)
    CCYB F 4 Bright A_CustomBulletAttack(9,6,6,Random(15,20),"Cyberpuff",0,CBAF_NORANDOM)
    CCYB E 12
    TNT1 A 0 A_Jump(128,"See")
    TNT1 A 0 A_SpidRefire
    Goto EASG+2
  RailgunCharge:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    CCYB EE 5 A_FaceTarget
    CCYB EEE 5 Bright A_FaceTarget
	TNT1 A 0 A_Jump(120,"Lasers")
    TNT1 A 0 A_Jump(80,"Morerailguns")
  Railgun:
    CCYB E 10 Bright
	CCYB F 10 Bright A_CustomMissile("CardinalRail",50,-25)
    CCYB E 15
    Goto See
  Morerailguns:
    CCYB E 10 Bright
	CCYB F 10 Bright A_CustomMissile("CardinalRail",50,-25)
    CCYB E 8 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CardinalRail",50,-25)
    CCYB E 8 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CardinalRail",50,-25)
    CCYB E 15
    Goto See
  Lasers:
    CCYB E 10 Bright
	CCYB F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
    CCYB E 4 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
    CCYB E 4 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
    CCYB E 4 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
    CCYB E 4 A_FaceTarget
	CCYB F 10 Bright A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
    CCYB E 4 A_FaceTarget
    Goto see
  MiniDTBFG:
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGCharge")
	CCYB EEEEEEE 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	CCYB F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-8,8))
	CCYB E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	CCYB F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-8,8))
	CCYB E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	CCYB F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-8,8))
	CCYB E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	CCYB F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,frandom(-8,8))
	CCYB E 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("LesserCardinal/BFGFire")
	CCYB F 8 Bright A_CustomMissile("ClockworkMiniDTBFG",50,-25,random(-8,8))
	CCYB E 5 A_FaceTarget
	Goto See
  Death:
	CCYB G 10 A_Scream
    CCYB H 10 A_NoBlocking
	CCYB IIIIIJJJJJKKKKK 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	CCYB LLLLLMMMMM 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))  
	CCYB NO 5
	CCYB P -1
	Stop  
  }
}

Actor CwClaser : SpecOpsLaser { Species "Cybers" DamageType "Cyber10k" Damage (Random(80,100)) }

Actor Cyberpuff : BulletPuff { Species "Cybers" DamageType "Cyber10k" }

Actor ClockworkMiniDTBFG : LesserCardinalMiniDTBFG
{
  Species "Cybers"
  DamageType "Cyber10k"
  Obituary "$CFClockworkMiniDTBFGObit"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("LesserCardinal/BFGIdle","Voice",1)
    CRS1 ABCDABCD 1 Bright A_SpawnItemEx("ProjectileTrailParticleOrange2",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_CustomMissile("ClockworkBFGProjectileAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    Loop  
  }
}

Actor ClockworkBFGProjectileAttack : LesserCardinalBFGProjectileAttack
{
  Species "Cybers"
  DamageType "Cyber10k"
  Obituary "$CFClockworkBFGProjectileAttackObit"
  States
  {
  Attack:
    TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomMissile("ClockworkLightningProjectile",-2,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto Death	
  }
}

Actor ClockworkLightningProjectile : LesserCardinalLightningProjectile { Species "Cybers" DamageType "Cyber10k" }

//Illusions
Actor InsaneCyberGhostA
{
  Scale 0.95
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    CCYB A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneCyberGhostB : InsaneCyberGhostA
{   
  States
  {
  Spawn:
    CCYB B 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneCyberGhostC : InsaneCyberGhostA
{   
  States
  {
  Spawn:
    CCYB C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneCyberGhostD : InsaneCyberGhostA
{   
  States
  {
  Spawn:
    CCYB D 2 A_FadeOut(0.18)
    Loop
  }
}