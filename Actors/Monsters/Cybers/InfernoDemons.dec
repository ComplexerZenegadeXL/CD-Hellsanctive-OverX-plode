	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,80,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,-20,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,-40,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,-60,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,-80,CMF_AIMDIRECTION,0)
	RDIA C 0 Radius_Quake(20,35,0,40,0)
    RDIA C 20 Bright
	RDIA B 20 Bright A_FaceTarget
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,0,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,20,CMF_AIMDIRECTION,0)
	RDIA B 0 A_CustomMissile("InfernoDemonFireBeam",0,0,40,CMF_AIMDIRECTION,0)
