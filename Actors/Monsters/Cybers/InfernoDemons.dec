Actor Infernodemon2 : Infernodemon1 
{
  Speed 10
  SeeSound "Infdem2/see"
  ActiveSound "Infdem2/active"
  States
  {
  Spawn:
    RDIA A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	RDIA A 10 A_Look
    Loop
  See:
    RDIA AAABBBB 2 A_Chase
    RDIA C 0 A_PlaySound("KoraxStep")
    RDIA CCCCDDDD 2 A_Chase
    RDIA A 0 A_PlaySound("KoraxStep")
    RDIA A 2 A_Chase
    Goto See
  Missile:
    TNT1 A 0
    TNT1 A 0 A_Jump(128, "FireBall","Seekers","Stomp","Tracers","Glyph")
    Goto See
  FireBall:
  	RDIA E 5 Bright A_FaceTarget
	RDIA F 0 A_CustomMissile("InfernoFireBalls",45,50,0,CMF_ABSOLUTEPITCH)
	RDIA F 0 A_CustomMissile("InfernoFireBalls",70,50,0,CMF_ABSOLUTEPITCH)
	RDIA F 0 A_CustomMissile("InfernoFireBalls",95,50,0,CMF_ABSOLUTEPITCH)
