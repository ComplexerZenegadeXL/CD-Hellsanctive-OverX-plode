Actor InfernodemonFireBeam
{
  Height 10
  Radius 10
  Projectile
  +DROPOFF
  -NOGRAVITY
  +FLOORHUGGER
  +SEEKERMISSILE
  +EXTREMEDEATH
  +DONTHURTSPECIES
  +DONTSPLASH
  Speed 22
  RenderStyle Add
  Alpha 0.75
  Damage (Random(25,45)) //10
  DamageType "HFCyb3r"
  ActiveSound "legfire/active"
  DeathSound "cyberrail/impact"
  Species "Cybers"
  ReactionTime 100
  States
  {
  Spawn:
    HK04 A 0 
    HK04 A 0 A_LoopActiveSound
  SpawnLoop:
    HK04 A 0 A_CountDown
    HK04 ABC 1 Bright A_SpawnItemEx("InfernodemonFireBeamTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    HK04 A 0 A_SeekerMissile(14,0)
    Loop
  Death:
    HK04 A 0 A_Explode(32,64,0)
    HK04 A 0 A_SpawnItemEx("InfernodemonFireBeamExplode")
    HK04 ABC 4
    Stop
  }
}

Actor InfernodemonFireBeamTrail : BFG9500Trail
{
  Scale 0.85
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    HK04 ABC 1 A_FadeOut(0.09)
    Goto Spawn+3
  }
}

Actor InfernodemonFireBeamExplode
{
  +DONTHURTSPECIES
  +NOGRAVITY
  +FLOORHUGGER
  Species "Cybers"
  DamageType "HFCyb3r"
  Speed 0
  Scale 1.25
  States
  {
  Spawn:
    HK05 A 0 A_Explode
    HK05 ABCDE 3 Bright
    Stop
  }
}

Actor InfernoFireballs
{
  Game Doom
  Radius 6
  Height 8
  Speed 50
  FastSpeed 60
  Damage (Random(120,160)) //35
  Projectile
  +RANDOMIZE
  +DONTREFLECT
  +EXTREMEDEATH
  Damagetype "HFCyb3r"
  RenderStyle Translucent
  Alpha 1
  Scale 1.0
  SeeSound "imp/attack"
  DeathSound "comet/explosion"
  States
  {
  Spawn:
	TNT1 A 1
	Goto Fly
  Fly:
	FRTB AB 1 Bright A_SpawnItemEx("HFCybFireballTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Loop
  Death:
	TNT1 A 0 A_Explode(160, 192)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, frandom(0,360))
    TNT1 AAAAAA 0 A_CustomMissile ("OrangeParticleSpawner", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 180))
	EXPL A 0 Radius_Quake(15,20,0,20,0)
	BEXP B 0 Bright A_Scream
    TNT1 A 0 A_AlertMonsters
	Goto EndAnimation
  EndAnimation:
	TNT1 A 0 A_SpawnItemEx("CyberSuperMeteor_m_Explosion", 0, 0, 0, 0, 0, 0, -1, SXF_NOCHECKPOSITION)//A_CustomMissile("Meteor_m_Explosion",0+Random(5,80),0+Random(35,-35),0+Random(0,370))
	TNT1 A 0 A_SpawnItemEx("SuperMeteor_m_FX_Smoke", 0, 0, 0, frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	Stop
  }
}

Actor FireSpark
{
  Projectile
  Speed 5
  Scale 0.1
  Gravity 0.5
  +HEXENBOUNCE
  +FORCEXYBILLBOARD
  -NOGRAVITY
  +NOTELEPORT
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOCLIP 
  RenderStyle Add
  States
  {
  Spawn:
    ORPA A 10 Bright
    ORPA A 1 Bright A_FadeOut
    Wait
  }
}


Actor LavaBall
{
  Radius 8
  Height 8
  Speed 45
  FastSpeed 55
  Damage 29
  DamageType "HFCyb3r"
  Obituary "$CFLavaBallObit"
  SpawnID 250
  Scale 1.0
  Projectile
  RenderStyle Add
  Alpha 0.95
  +SPECTRAL
  +DONTHARMSPECIES
  SeeSound "comet/launch"
  DeathSound "comet/explosion"
  States
  {
  Spawn: 
    TNT1 A 0 A_SpawnItemEx("LavaBallTrail",0,0,0)
    LBBL AB 4 Bright
    Loop
  Death:
    TNT1 AAA 0 A_SpawnItemEx("FireSpark", frandom(-5,5), frandom(-5,5), frandom(0,10), frandom(-5,5), frandom(-5,5), frandom(0,20), frandom(90,270), SXF_CLIENTSIDE)
    LBBL C 5 Bright A_Explode(32,92,0)
    LBBL DE 5 Bright
    Stop
  }
}

Actor LavaballTrail : BFG9500Trail
{
  Scale 0.85
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    LBBL AB 1 A_FadeOut(0.25)
    Goto Spawn+3
  }
}

