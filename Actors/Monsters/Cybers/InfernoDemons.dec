Actor PyroBomb
{
  Radius 10
  Height 10
  Speed 40
  FastSpeed 50
  Projectile
  SeeSound "weapons/justfi"
  DeathSound "weapons/firex3"
  RenderStyle Add
  Damage (Random(600,900))  //300
  DamageType "HFCyb3r"
  Scale 1.5
  Alpha 1.0
  Decal "Scorch"
  Species "Cybers"
  var int user_loop;
  +FORCERADIUSDMG
  +DONTHURTSPECIES
  States
  {
  Spawn:
	CMRA ABCDEFGHIJ 1 Bright
	Loop
  Death:
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("FireSpark", frandom(-5,5), frandom(-5,5), frandom(0,10), frandom(-5,5), frandom(-5,5), frandom(0,20), frandom(90,270), SXF_CLIENTSIDE)
  Loop1:	
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop1")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop2:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop2")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop3:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,-5)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop3")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop4:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,10)
    TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop4")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop5:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,-10)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop5")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop6:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,15)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop6")
    TNT1 A 0 A_SetUserVar("user_loop",0)
  Loop7:
	TNT1 A 0 A_CustomMissile("LavaBall",0,16,15 * user_loop,2,-15)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,2)
	TNT1 A 0 A_Jump(256,"Loop7")
	TNT1 A 0
	Stop
  }
}

