	RDIA F 0 A_CustomMissile("CyberSeekingComet",70,50,0,CMF_ABSOLUTEPITCH)
	RDIA F 0 A_CustomMissile("CyberSeekingComet",95,50,0,CMF_ABSOLUTEPITCH)
