  Tag "$CFExos"
  var int user_music;
  var int user_currenthp;
  var int user_lcounter;
  var int user_rush;
  var int user_pcount;
  var int user_missile;
  var int user_lowlag;
  States
  {
  Spawn:
	EXOS A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SetUserVar("user_pcount",0)
	TNT1 A 0 A_SetUserVar("user_lcounter",0)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("BossAI",0,1)
  SpawnLoop:
	EXOS A 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter+1)
	TNT1 A 0 A_JumpIf(user_lcounter < 34,"Idle")
	TNT1 A 0 A_CustomMissile("CFBeholderMassSpawner",20,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(32,"SpawnLoop2")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(32,"SpawnLoop2")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(64,"SpawnLoop2")
	///TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(128,"SpawnLoop2")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
  SpawnLoop2:
	EXOS A 10 A_Look
	TNT1 A 0 A_JumpIf(user_currenthp > Health,"Idle")
	Loop
  Idle:
	TNT1 A 0 A_CheckFlag(FRIENDLY,2)
	TNT1 A 0 A_JumpIfInventory("CFWasRaised",1,"Vanish")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_pcount",0)
	TNT1 A 0 A_CustomMissile("CFBeholderMassSpawner",20,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(32,"IdleLoop")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(32,"IdleLoop")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(64,"IdleLoop")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	//EXOS A 1 A_Jump(128,"IdleLoop")
	//TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto IdleLoop
  IdleLoop:
	EXOS AA 6 A_Wander
	TNT1 A 0 A_Look
	EXOS BB 6 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	EXOS CC 6 A_Wander
	TNT1 A 0 A_Look
	EXOS DD 6 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EXOS AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_CheckFlag(FRIENDLY,2)
	TNT1 A 0 A_JumpIfInventory("CFWasRaised",1,"Vanish")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIfInventory("RunesCheck",1,2)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,802)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0
	Goto SeeLoop
  SeeLoop:
	EXOS AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	EXOS CCDD 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	Loop
  See2:
	TNT1 A 0 A_CheckFlag(FRIENDLY,2)
	TNT1 A 0 A_JumpIfInventory("CFWasRaised",1,"Vanish")
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_lcounter",10+random(-5,5))
	Goto SeeLoop2
  SeeLoop2:
	EXOS AABB 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	EXOS CCDD 4 A_Chase
	TNT1 A 0 A_SpawnItemEx("ExosStep",0,0,5,0,0,-20)
	Loop
  Melee:
  Missile:
	TNT1 A 0 A_GiveInventory("ResetMonsterReflectInvul",1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_JumpIfTargetInLOS("Rockets",90,JLOSF_CLOSENOJUMP|JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,0,500)
	Goto ChainGuns
  ChainGuns:
	EXOS EEEE 8 A_FaceTarget(45)
	TNT1 A 0 A_SetUserVar("user_lcounter",50)
	TNT1 A 0 A_FaceTarget
	//TNT1 A 0 A_CheckLOF("ChainGunsLoop",CLOFF_JUMPENEMY|CLOFF_MUSTBESHOOTABLE,8192,0,0,0,0,0,AAPTR_DEFAULT)//Causes out-of-sync on-line. Bow and congratulations to the nitwit zandronum's developers!
	//TNT1 A 0 A_CheckLOF("MissileMiss",CLOFF_JUMP_ON_MISS|CLOFF_SKIPNONHOSTILE,8192,0,0,0,0,0,AAPTR_DEFAULT)//Causes out-of-sync on-line. Bow and congratulations to the nitwit zandronum's developers!
	//Goto MissileMiss2
  ChainGunsLoop:
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON,1.0,0)
	EXOS F 1 Bright A_CustomBulletAttack(4.3,2.6,1,random(20,50),"ExosBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_CustomMissile("MonsterExplosiveTracer2",77,23,frandom(-5,5),0)
	EXOS E 1 A_SpawnItemEx("RifleCasing",35,23,76,frandom(2,6),0,frandom(1,3),frandom(-35,-30),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON,1.0,0)
	EXOS F 1 Bright A_CustomBulletAttack(4.3,2.6,1,random(20,50),"ExosBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_CustomMissile("MonsterExplosiveTracer2",77,23,frandom(-5,5),0)
	EXOS E 1 A_SpawnItemEx("RifleCasing",35,23,76,frandom(2,6),0,frandom(1,3),frandom(-45,-40),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("hitler/fire",CHAN_WEAPON,1.0,0)
	EXOS F 1 Bright A_CustomBulletAttack(4.3,2.6,1,random(20,50),"ExosBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_CustomMissile("MonsterExplosiveTracer2",77,23,frandom(-5,5),0)
	EXOS E 1 A_SpawnItemEx("RifleCasing",35,23,76,frandom(2,6),0,frandom(1,3),frandom(-45,-40),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_JumpIf(user_lcounter < 1,"Rockets")
	TNT1 A 0 A_SetUserVar("user_lcounter",user_lcounter-1)
	TNT1 A 0 A_MonsterRefire(0,"See")
	Loop
  MissileMiss:
	TNT1 A 0 A_Jump(256,"Pain.Mine","See2","See2")
	Goto See
  MissileMiss2:
	TNT1 A 0 A_Jump(256,"Rockets","See")
	Goto See
  Rockets:
	TNT1 A 0 A_Jump(160,"Rockets2","Rockets3","Rockets4","Rockets4")
	EXOS G 4 A_FaceTarget(45)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMiniRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 A_JumpIfTargetInLOS("ChainGuns",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Rockets2:
	EXOS G 4 A_FaceTarget(45)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMissile",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMissile",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMissile",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMissile",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMissile",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMissile",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ExosMissile",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("ExosMissile",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 A_JumpIfTargetInLOS("ChainGuns",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Rockets3:
	EXOS G 4 A_FaceTarget(45)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PyroRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PyroRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PyroRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PyroRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PyroRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PyroRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PyroRocket",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("PyroRocket",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 A_JumpIfTargetInLOS("ChainGuns",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Rockets4:
	EXOS G 4 A_FaceTarget(45)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS H 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,-15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("M2HellStormBomb",79,15,0,CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
