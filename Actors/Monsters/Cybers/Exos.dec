	TNT1 A 0 A_SpawnItemEx("CFLineSpawner")
	EXOS G 4 A_JumpIfTargetInLOS("ChainGuns",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Teleport0:
	EXOS G 1 Bright A_UnSetShootable
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("Exos/TeleportIn",CHAN_AUTO,1.0,0)
	EXOS GGGGGGGGGG 1 Bright A_FadeOut(0.1,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_PlaySound("Exos/TeleportOut",CHAN_AUTO,1.0,0)
	TNT1 A 0 A_Recoil(0.1)
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Facetarget
	EXOS GGGGGGGGGG 1 A_FadeIn(0.1)
	TNT1 A 0 A_ChangeFlag(NOFEAR,1)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	EXOS G 1 A_SetShootable
	Goto See
  Teleport1:
	EXOS G 1 Bright A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,1)
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("Exos/TeleportIn",CHAN_AUTO,1.0,0)
	EXOS GGGGG 1 Bright A_FadeOut(0.2,0)
	TNT1 A 2
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase("","",CHF_NIGHTMAREFAST|CHF_NOPLAYACTIVE)
	TNT1 A 2 A_PlaySound("Exos/TeleportOut",CHAN_AUTO,1.0,0)
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_FaceTarget
	EXOS GGGGG 1 A_FadeIn(0.2)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,0)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(NOFEAR,1)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_ChangeFlag(LOOKALLAROUND,0)
	EXOS G 1 A_SetShootable
	TNT1 A 0 A_JumpIf(user_missile == 1,"Missile")
	Goto See
  Teleport2:
	EXOS G 1 Bright A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_TakeInventory("ProjHitCheck",1)
	TNT1 A 0 A_TakeInventory("ProjMissCheck",1)
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_PlaySound("Exos/TeleportIn",CHAN_AUTO,1.0,0)
	EXOS GGGGGGGGGG 1 Bright A_FadeOut(0.1,0)
	TNT1 A 2
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase("Teleport2Exit","",CHF_NIGHTMAREFAST|CHF_NOPLAYACTIVE)
  Teleport2Exit:
	TNT1 A 2 A_PlaySound("Exos/TeleportOut",CHAN_AUTO,1.0,0)
	TNT1 AAAA 0 A_SpawnItemEx("CFDarkLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget(45)
	EXOS G 1 A_FadeIn(0.1)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	EXOS G 1 A_SetShootable
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_lcounter",50)
	TNT1 A 0 A_CheckLOF("ChainGunsLoop",CLOFF_JUMPENEMY,8192,0,0,0,0,0,AAPTR_DEFAULT)
	Goto See2
  Wound:
	"####" "#" 8 A_ChangeFlag(NOPAIN,1)
	"####" "#" 8 A_Pain
	"####" "#" 0 A_JumpIfInventory("Tic",3,"Bleeding")
	"####" "#" 0 A_GiveInventory("Tic",1)
	"####" "#" 0 A_SetUserVar("user_missile",1)
	Goto See
  Pain.Crush:
	"####" "#" 0 A_ChangeFlag(NOPAIN,1)
	Goto Teleport1
  Bleeding:
	"####" "#" 0 A_ChangeFlag(NOBLOOD,0)
	"####" "#" 0 A_SetUserVar("user_missile",1)
	Goto Pain2
  Pain.BFG10K:
  Pain.Mine:
	"####" "#" 0 A_ChangeFlag(NOPAIN,1)
	"####" "#" 0 A_ChangeFlag(NOFEAR,0)
	"####" "#" 0 A_ChangeFlag(FRIGHTENED,1)
	"####" "#" 0 A_ChangeFlag(LOOKALLAROUND,1)
	"####" "#" 0 A_SetUserVar("user_missile",1)
	"####" "#" 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	"####" "#" 1
	"####" "#" 0 A_SetUserVar("user_currenthp",Health)
	Goto Teleport1
  Pain:
	EXOS I 7 A_ChangeFlag(NOPAIN,1)
	EXOS I 8 A_Pain
  Pain2:
	"####" "#" 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	"####" "#" 1 
	"####" "#" 0 A_SetUserVar("user_currenthp",Health)
	"####" "#" 0 A_JumpIf(user_pcount > 10,"NoPcIncr")
	"####" "#" 0 A_SetUserVar("user_pcount",user_pcount+1)
  NoPcIncr:
	TNT1 A 0 A_Jump(256-(20*user_pcount),"See")
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.7),"Teleport1")
	Goto See
  Death.PlayerIce:
  Death:
	EXOS I 4 A_Scream
	EXOS J 4 A_Fall
	TNT1 A 0 A_DropItem("TerminatorItem",1,16 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_TakeInventory("Tic",999999)
	EXOS KLMN 4
	TNT1 A 0 A_SpawnItemEx("ExosGib2",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib3",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib4",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,"DeathDrop")
	TNT1 A 0 A_Jump(96,"DeathNoDrop")
  DeathDrop:
	TNT1 A 0 A_SpawnItemEx("ImprovedMinigunGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	Goto DeathAfterDrop
  DeathNoDrop:
	TNT1 A 0 A_SpawnItemEx("ImprovedMinigunGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("ExosGib5",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_CLIENTSIDE,0)
  DeathAfterDrop:
	TNT1 A 0 A_PlaySound("Exos/Gib3",CHAN_BODY,1.0,0)
	EXOS PQ 4
	TNT1 A 0 A_BossDeath
	EXOS R -1
	Stop
  XDeath:
	EXOS I 4 A_Scream
	EXOS J 4 A_Fall
	TNT1 A 0 A_DropItem("TerminatorItem",1,16 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_BossDeath
	TNT1 A 0 A_TakeInventory("Tic",999999)
	EXOS KSMN 4
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("SmokeFX",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("Kaboom19",frandom(22,53),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib",0,0,8,frandom(1,8),0,2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib2",0,0,8,frandom(1,8),0,2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib3",0,0,8,frandom(1,8),0,2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("ExosGib4",0,0,8,frandom(1,8),0,2,frandom(0,360),SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisArmor",0,0,0,frandom(0,8),frandom(0,8),2,frandom(0,360),0,96)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",1) == 1,"XDeathDrop")
	TNT1 A 0 A_Jump(96,"XDeathNoDrop")
  XDeathDrop:
	TNT1 A 0 A_SpawnItemEx("ImprovedMinigunGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,0)
	Goto XDeathAfterDrop
  XDeathNoDrop:
	TNT1 A 0 A_SpawnItemEx("ImprovedMinigunGiver",0,0,8,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("ExosGib5",0,0,8,frandom(1,8),0,2,frandom(0,360),SXF_CLIENTSIDE,0)
  XDeathAfterDrop:
	TNT1 A 0 A_PlaySound("Exos/Gib3",CHAN_BODY,1.0,0)
	EXOS PQQ 4 A_FadeOut(0.6,1)
	Stop
  Vanish:
	EXOS A 4
	EXOS G 1 A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOBLOCKMAP,1)
	TNT1 A 0 A_ChangeFlag(THRUSPECIES,1)
	TNT1 AAAA 0 Bright A_SpawnItemEx("CFDarkLineSpawner")
	TNT1 A 0 A_PlaySound("Exos/TeleportIn",CHAN_AUTO,1.0,0)
	EXOS GGGGGGGGGGGGGGGGGGGG 1 Bright A_FadeOut(0.05,1)
	Stop
  }
}

Actor M2HellStormBomb : HellStormBombbase
{
  Species "Cybers"
  DamageType "Exos"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CopyFriendliness(AAPTR_TARGET)
	Goto MonsterFly
  Separate:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_StopSoundEx("SoundSlot7")
	TNT1 AAAAAA 0 A_CustomMissile("EFGRocketSmoke",frandom(4,6),frandom(-2,2),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("EFGRockeParticleTrail",frandom(4,6),frandom(-2,2),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("M2HellStormBomb1",0,0,frandom(-11,11),CMF_AIMDIRECTION|CMF_SAVEPITCH|CMF_OFFSETPITCH,frandom(-2.0,2.0))
	TNT1 A 1 A_Stop
	Stop
  Death:
	TNT1 A 0 A_Stop
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_ScreamAndUnblock
	TNT1 A 0 A_StopSoundEx("SoundSlot7")
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("CFKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 1 A_SpawnItemEx("ExosFlamethrowerShot",0,0,0,frandom(0,8),frandom(0,8),2,frandom(0,360),SXF_TRANSFERPOINTERS|SXF_SETMASTER,0)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	MISL B 4 Bright A_Explode(128,128,1,1)
	MISL CD 4 Bright
	Stop
  }
}

