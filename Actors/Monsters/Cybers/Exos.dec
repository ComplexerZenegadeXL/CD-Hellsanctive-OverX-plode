Actor CFBeholder
{
  Monster
  Health 100
  Height 18
  Radius 25
  Mass 50
  Speed 10
  FloatSpeed 10
  FastSpeed 10
  PainChance 256
  -COUNTKILL
  +NOTARGET
  +NOINFIGHTING
  +FLOAT
  +FLOATBOB
  +NOGRAVITY
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +ALWAYSFAST
  +NOFEAR
  +AVOIDMELEE
  +THRUSPECIES
  +AMBUSH
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +DONTHARMCLASS
  Species "Cybers"
  DamageType "Exos"
  DamageFactor "Exos", 0.0
  SeeSound "CFBeholder/See"
  ActiveSound "CFBeholder/Act"
  PainSound ""
  DeathSound "CFBeholder/Die"
  Tag "Beholder"
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 ThrustThingZ(0,13,0,1)
	Goto Idle
  Idle:
	ANPR A 2 A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	ANPR A 2 A_Chase
	Loop
  Melee:
  Missile:
	ANPR AA 1 A_FaceTarget
	ANPR A 1 A_GiveToTarget("CFMonstersAlerter",1)
	TNT1 A 0 A_GiveInventory("CFMonstersAlerter",1,AAPTR_MASTER)
	TNT1 A 0 A_AlertMonsters
	ANPR AAAA 4 A_FaceTarget
	Goto RunAway
  RunAway:
	TNT1 A 0 A_ChangeFlag(NoFear,0)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,1)
	ANPR AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("TeleportFog",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	ANPR AAAA 1 A_FadeOut(0.5,1)
	Stop
  Pain:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(NOFEAR,0)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,1)
	ANPR AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase("","")
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(NOFEAR,1)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	Goto Idle
  Death:
	ANPR B 4 A_Scream
	TNT1 A 0 A_Gravity
	TNT1 A 0 A_ChangeFlag(FloatBOB,0)
	ANPR CD 4
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_TakeInventory("Tic",999999)
	Goto Fall
  Fall:
	ANPR D 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	TNT1 A 0 A_PlaySound("CFBeholder/Crash",CHAN_BODY,1.0,0)
	ANPR E 4 A_Fall
	ANPR F 525
	ANPR FFFFFFFFFFFFFFFFFFFF 5 A_FadeOut(0.05,1)
	Stop
  }
}

Actor CFBeholderSpawner : ShadowSlaveSpawner
{
  +THRUACTORS
  +SERVERSIDEONLY
  States
  {
  Spawn:
	TNT1 A 5
	Goto Death
  Death:
	TNT1 A 1 A_Stop
	TNT1 A 5 A_SpawnItemEx("TeleportFog",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 1 A_SpawnItemEx("CFBeholder",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	Stop
  }
}

Actor CFBeholderMassSpawner : CFBeholderSpawner
{
  States
  {
  Spawn:
	TNT1 A 1 A_Jump(32,"Death")
	TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 1 A_Jump(32,"Death")
	TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 1 A_Jump(64,"Death")
	TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 1 A_Jump(128,"Death")
	TNT1 A 0 A_CustomMissile("CFBeholderSpawner",20,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Goto Death
  Death:
	TNT1 A 0
	Stop
  }
}

Actor "hit-testing" : FastProjectile
{
  Height 1
  Radius 1
  Speed 1000
  Renderstyle None
  Damage (0)
  +PAINLESS
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  +MTHRUSPECIES
  +DONTREFLECT
  +HITTRACER
  States
  {
  Spawn:
	TNT1 A 1
	Loop
  Death:
	TNT1 A 0
	TNT1 A 1 A_GiveToTarget("ProjMissCheck",1)
	Stop
  Crash:
  XDeath:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_TargetAsEnemy") != 1,"Miss")
	TNT1 A 1 A_GiveToTarget("ProjHitCheck",1)
	Stop
  Miss:
	TNT1 A 0
	TNT1 A 1 A_GiveToTarget("ProjMissCheck",1)
	Stop
  }
}
/*

Actor "hit-testing-puff"
{
  RenderStyle None
  +NOGRAVITY
  +NOBLOCKMAP
  +PAINLESS
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTREFLECT
  +HITTRACER
  +PUFFGETSOWNER
  States
  {
