  States
  {
  Spawn:
    TLCD A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TLCD AAZZ 10 Bright A_Look
    Loop
  See:
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,16)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_Jump(100,"Rush")
	TLCD A 3 Bright A_Hoof
    TLCD ABBCC 3 Bright A_Chase
    TLCD D 3 Bright A_Metal
    TLCD D 3 Bright A_Chase
    TNT1 A 0 A_Jump(50,"Teleport")
    Loop
  Rush:
    TNT1 A 0 A_Hoof
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD B 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD C 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD C 2 Bright A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(25,"Teleport")
	TNT1 A 0 A_Jump(75,"See")		
	Loop	
  Teleport:
    TLCD A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLCD AAAAAAAAAAAAA 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TLCD A 2
	TLCD AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TLCD A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLCD AAAAAAAAAAAAA 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TLCD A 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 A_UnsetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_CheckFlag("FRIENDLY",3)
	TNT1 A 0 A_JumpIf(user_LegendaryPortal == 1,2)
    TNT1 A 0 A_JumpIfHealthLower(4499,"LegendaryPortal")
	//TNT1 A 0 A_JumpIfCloser(200,"Pain.Fists")
    TNT1 A 0 A_JumpIfCloser(450,"TrueLegendaryStomp")
    TNT1 A 0 A_Jump(130,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","Homing","StompingBarrage","LegRevBalls","LegCybComets","TrueLegPlasmaBalls","HomingTrueLegPlasmaBalls")
	TNT1 A 0 A_Jump(72,"TrueLegendaryLostSouls","TrueLegendarySoulCombo","LegendaryTech","LegendaryThunder","LegThor","TrueLegendaryBFG","TrueBFGCombo","TrueLegendaryDevastator","SpikyStomp")
	TNT1 A 0 A_Jump(32,"TrueLegendaryLaserBeam")
	TNT1 A 0 A_Jump(18,"SuperLegendaryPlasmaticBomb")
	TNT1 A 0 A_Jump(16,"LegendaryDevastation")
	//TNT1 A 0 A_Jump(256,"TrueLegendaryLaserBeam")
  Normal:
