  TrueLegendaryRailgunLoop:
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26,frandom(-2,4))
	TLCD E 1 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 59,1)
	Goto TrueLegendaryRailgunLoop
	TLCD E 15 Bright ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_Jump(115,"TrueLegendaryLostSouls","TrueLegendarySoulCombo","LegendaryTech","LegendaryThunder","LegThor","TrueLegendaryBFG","TrueLegendaryDevastator","SpikyStomp")
	Goto See
  LegendaryStar:
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
