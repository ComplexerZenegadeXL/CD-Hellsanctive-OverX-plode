	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	Goto DeathLoop2
	TNT1 A 0 ACS_NamedExecuteAlways("SetDefaultSky",0,3)
	TNT1 A 0 A_SpawnItemEx("LegendaryNuke")
	TLCD H 10
	TLCD I 10
	TLCD JKL 10
	TLCD M 10 A_NoBlocking
	TLCD NO 10
	TLCD P 30
	TLCD P -1 A_BossDeath
	Stop
  }
}

Actor DeadlyTrueLegCyberStomp : TrueLegCyberStomp
{
  Damage (Random(5000,6000))
  States
  {
  Spawn:
    TNT1 A 10
	Stop
  Death:
 	TNT1 A 0 A_Explode(10000,200,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AA 0 A_SpawnItemEx("LCABFGTrailParticleBlue", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("KaboomBlue3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
     Stop
  }
}