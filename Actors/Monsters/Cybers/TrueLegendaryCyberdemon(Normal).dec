	LBE4 BB 20 Bright A_SpawnItem("TrueLegendaryCyberFlameSpawner",0,0,0,0)
	Goto See
  Death:
    TNT1 A 0 A_StopSound(6)
	TLCD G 10 Bright A_Scream
	TLCD H 10 Bright
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLCD GGGGG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLCD GGHHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLCD GHGHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    TLCD GHGHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, random(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    TLCD GHGHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLCD GHGHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLCD IHIHI 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 A 0 A_SpawnItem("TrueDeathBall")
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,35)
	TNT1 A 0 A_DropItem("LegendaryDust",random(6,12),256)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
    TLCD GHGHG 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(20,-20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 11,1)
	Goto DeathLoop
	TNT1 A 0 A_SetUserVar("user_loop",0)
    TLCD IHIHI 2 Bright A_CustomMissile("BlueKaboom", frandom(20,80), frandom(20,-20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
