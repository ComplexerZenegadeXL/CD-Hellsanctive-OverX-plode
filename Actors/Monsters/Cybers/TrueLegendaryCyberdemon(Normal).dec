  TrueLegendaryRailgun:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    TLCD EEEE 4 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
    TLCD E 1 A_GiveInventory("BossProtectionTierI",1) //A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TLCD EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD EEEEEEEEEEE 1 A_FadeOut(0.1,0)
	TLCD EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
    TLCD E 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLCD EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD EEEEEEEEEEE 1 A_FadeIn(0.1)
	TNT1 A 0 A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
    TLCD E 1
	TLCD EEEEEEEEEEEE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD EEEEEEEEEEE 1 A_FadeOut(0.1,0)
	TLCD EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 0 A_Wander
