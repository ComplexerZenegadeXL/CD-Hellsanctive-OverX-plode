Actor HellFireCyberdemon : Cyberdemon
{
  BloodColor "ff 50 00"
  MaxStepHeight 32
  MaxDropOffHeight 32
  +BRIGHT
  +DONTHARMSPECIES
  +FLOORCLIP
  +FIRERESIST
  +NORADIUSDMG
  +NOEXTREMEDEATH
  +NOICEDEATH
  +BOSS
  +NOTIMEFREEZE
  +CANTSEEK
  //+TELESTOMP
  +NOFEAR
  +DONTSPLASH
  +LOOKALLAROUND
  +BOSSDEATH
  +NOTELEFRAG
  +DONTGIB
  +DONTMORPH
  +QUICKTORETALIATE
  +NODROPOFF
  +DONTRIP
  SeeSound "HfCyber/See"
  PainSound "HFCyber/Pain"
  ActiveSound "HFCyber/Active"
  DeathSound "HFCyb/Laugh"
  Health 17000
  Scale 1.1
  Mass 0x7FFFFFFF
  Radius 40
  Height 100
  Speed 23
  Obituary "$CFHellFireCyberdemonObit"
  PainChance 8
  Species "Cybers"
  DamageFactor "PlayerFireSword", 0.0
  DamageFactor "PlayerDTRG", 0.8
  DamageFactor "DTRailgun", 1.0
  DamageFactor "PDTPuff", 0.1
  DamageFactor "RailG", 1.0
  DamageFactor "PlayerBHole", 0.25
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "Cyber10K", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.0
  DamageFactor "LegendaryPlayer", 0.0
  DamageFactor "BFGSplash", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "BFGSpray", 0.0
  DamageFactor "PlayerDevBall", 0.20
  DamageFactor "PlayerDevBall2", 0.2
  DamageFactor "PlayerDevTracer", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Extreme", 0.0
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "PDTPuff", 0.0
  DamageFactor "FreezerBurn", 0.0
  DamageFactor "SuperWeapon", 0.1
  DamageFactor "Fire", 0.0
  DamageFactor "Crush", 0.0
  DamageFactor "Suicide", 0.0
  DamageFactor "Telefrag", 0.0
  DamageFactor "Massacre", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "PlayerIce", 1.3
  DamageFactor "PlayerLegendary", 0.0
  DamageFactor "None", 0.4
  // no infight 4 u
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "FlamingBatshitBurglers", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0
  DamageFactor "CerEnergyBall", 0.0
  DamageFactor "LegMind", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleCOmet", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "HellComet", 0.2
  DamageFactor "Legendary1", 0.0
  DamageFactor "T3rm", 0.0
  DamageFactor "Terminator", 0.0
  DamageFactor "", 0.0
  DamageFactor "Ice", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "C0mm4nder", 0.0
  DamageFactor "UpBFGSplash", 0.3
  DamageFactor "Baby15K", 0.0
  DamageFactor "RST", 0.0
  MinMissileChance 200
  DamageFactor 0.65
  PainChance "BFG9500Ball", 256
  PainChance "PlayerDevBall", 100
  PainChance "BFG10K", 100
  PainChance "PDTBFG", 100
  PainChance "Legendary", 100 // 100
  PainChance "LegendaryPlayer", 100 // 100
  PainChance "LegendaryGuru", 256
  PainChance "LegendaryGuruPlayer", 256
  PainChance "PlayerDBFG2", 256
  PainChance "PlayerDBFG210K", 256
  PainChance "PlayerDBFG10K2", 256
  PainChance "DBFG210K", 256
  PainChance "DBFG2Splash", 256
  PainChance "DBFG2", 256
  PainChance "DBFG", 256
  PainChance "PlayerDBFG", 256
  PainChance "DBFG10K2", 256
  DamageFactor "Melee", 0.5
  DamageFactor "DBFG10K", 0.5
  DamageFactor "PlayerDBFG10K", 0.5
  DamageFactor "PlayerDBFG2", 0.5
  DamageFactor "PlayerDBFG210K", 0.5
  DamageFactor "PlayerDBFG", 0.5
  DamageFactor "DBFG", 0.5
  DamageFactor "DBFG2", 0.2
  DamageFactor "DBFG10K2", 0.2
  DamageFactor "DBFGSplash2", 0.2
  DamageFactor "PlayerNemesisBFG", 0.15
  DamageFactor "Normal", 0.8
  DamageFactor "PlayerNemesisPlasma", 0.2
  DamageFactor "Explosion", 0.4
  Tag "$CFHfCyb"
  var int user_music;
  var int user_hellfiredevastation;
  var int user_painrage;
  var int user_script;
  var int user_script_type;
  var int user_pain;
  var int user_servants;
  var int user_invasion;
  var int user_missile;
  var int user_soulstorm;
  var int user_loop;
  var int user_lowlag;
  States
  {
  Spawn:
    HFCY A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 A_JumpIf(user_script == 1,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,10)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",9)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,7)
  Idle:
    HFCY AAZZ 10 Bright A_Look
	//TNT1 A 0 A_AlertMonsters(0,AMF_EMITFROMTARGET)
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	HFCY A 3 Bright A_Hoof
    HFCY ABBCC 3 Bright A_Chase
    HFCY D 3 Bright A_Metal
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_JumpIf(user_music == 1,4)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,666)
    TNT1 A 0 ACS_NamedExecuteAlways("SetSky",0,1)
	TNT1 A 0 A_SetUserVar("user_music",1)
    HFCY A 3 Bright A_Hoof
    HFCY ABBCC 3 Bright A_Chase
    HFCY D 3 Bright A_Metal
    HFCY D 3 Bright A_Chase
	TNT1 A 0 A_Jump(100,"Rush","Teleport")
    Loop
  Rush:
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Hoof
	HFCY A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY B 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY C 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY C 2 Bright A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	HFCY D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HellFireCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 HealThing(1)
	TNT1 A 0 A_Jump(75,"See","HFTeleport")	
	Goto See
  HFTeleport:
    TNT1 A 0 A_UnSetShootable
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFireSpawner",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
    HFCY EEEEEEEEEE 1 Bright A_FadeOut(0.1,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFireSpawner",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
	HFCY EEEEEEEEEE 1 Bright A_FadeIn(0.1)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_SetShootable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 HealThing(2)
	Goto See
  Teleport:
    TNT1 A 0
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_ChangeFlag("NODAMAGE",1)
    TNT1 A 0 A_UnSetShootable
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFFireSpawned2",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
    HFCY GGGGGGGGGG 1 Bright A_FadeOut(0.1,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TNT1 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFFireSpawned2",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
    TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-100)
    HFCY GGGGGGGGGG 1 Bright A_FadeIn(0.1)
    TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
	TNT1 A 0 HealThing(2)
    Goto See
  Idle:
	TNT1 A 0 A_SetTranslucent(1)
	HFCY AA 3 A_Wander
	TNT1 A 0 A_Look
	HFCY BB 3 A_Wander
	TNT1 A 0 A_Look
	HFCY CC 3 A_Wander
	TNT1 A 0 A_Look
	HFCY DD 3 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 HealThing(20)
	Loop
  Missile:
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_JumpIfCloser(200, "Stomp")
	TNT1 A 0 A_JumpIfCloser(450, "DTShotgun")
    TNT1 A 0 A_Jump(130,"Seekers","FloorStomp","SeekerTracers","RandomTrap","Railgun","HFGauss","FuelRockets","FireBalls","HF10K","FlameRockets","FireBallsCombo")
	TNT1 A 0 A_Jump(90,"PyroBombs","PyroShot","UndeadWave","SoulsStorm")
	TNT1 A 0 A_Jump(50,"Burnnn","HellishAmbient","Army")
	TNT1 A 0 A_Jump(45,"Invasion","TheCall")
	TNT1 A 0 A_Jump(35,"Servants","HellfireCombo")
	TNT1 A 0 A_Jump(20,"HellfireDevastation")
  Rockets:
	TNT1 A 0 A_SetUserVar("user_missile",0)
  RocketsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 5,"RocketsEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
    HFCY E 1 A_FaceTarget
    HFCY F 1 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    HFCY E 1 A_FaceTarget
    HFCY F 1 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    HFCY E 1 A_FaceTarget
    HFCY F 1 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    HFCY E 1 A_FaceTarget
    HFCY F 1 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    HFCY E 1 A_FaceTarget
    HFCY F 1 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    HFCY E 1 A_FaceTarget
    HFCY F 4 Bright A_CustomMissile ("HFCyberRocket",56,-26,frandom(-6,6))
    Loop
  RocketsEnd:
    TNT1 A 0 A_Jump(128,"FuelRockets","Seekers","FloorStomp","SeekerTracers","RandomTrap","HFGauss","HF10K","Railgun","FireBalls","FlameRockets","FireBallsCombo","UndeadWave","PyroShot")
	Goto FuelRockets
  FlameRockets:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  FlameRocketsLoop:
	HFCY E 3 A_FaceTarget
    HFCY F 4 Bright A_CustomMissile ("HFCyberFlameRocket",56,-26,frandom(-6,6))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto FlameRocketsLoop
	TNT1 A 0 A_Jump(90,"PyroShot","Burnnn","UndeadWave")
	Goto See
  DTShotgun:
	HFCY E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DTShellCasing",26,26,58,frandom(2, 6),0,frandom(1, 3),frandom(80,90),SXF_CLIENTSIDE)
	TNT1 AAAAAAAA 0 A_CustomMissile("RedDemonTechTracer",56,-26,frandom(-6,6),0)
	TNT1 A 0 A_PlaySoundEx("Weapons/ErasusFire","Weapon")
	HFCY F 2 Bright A_CustomBulletAttack(20,18,8,Random(12,20)*5,"HFCyberDTShotgunPuff",0,CBAF_NORANDOM)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/ErasusPump",6)
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_Jump(20,"BurstShot")
	TNT1 A 0 A_JumpIfCloser(450, "DTShotgun")
	Goto RocketsEnd
  BurstShot:
    HFCY E 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DTShellCasing",26,26,58,frandom(2, 6),0,frandom(1, 3),frandom(80,90),SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySoundEx("Weapons/ErasusFire","Weapon")
	TNT1 A 0 A_PlaySound("Weapons/ErasusAmbient",5)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("HFCyberRedDemonTechProjectile",56,-26,frandom(-20,20))
	TNT1 A 0 A_PlaySound("Weapons/ErasusPump",6)
	HFCY E 15 Bright A_FaceTarget
	Goto RocketsEnd
  AntiAerial: //in case some pepega mobs annoys him
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(256,"SpecialBurn","Rockets","Seekers","HFGauss","HF10K","Railgun","FireBalls","FuelRockets","FlameRockets","FireBallsCombo","Burnnn")
	Goto FuelRockets
  PyroBombs:
	TNT1 A 0 A_SetUserVar("user_missile",0)
  BombsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 5,"BombEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
    HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX5",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX5",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX4",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX4",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX3",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX3",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX2",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX2",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX",40,-26,56)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BombPreparationFX",40,-26,56)
    HFCY F 6 Bright A_CustomMissile("PyroBomb",53,-26,0,0,0)
    Loop
  BombEnd:
    TNT1 A 0 A_Jump(128,"PyroShot","HellfireCombo")
	Goto see
  SpecialBurn:
    TNT1 A 0 A_SetUserVar("user_missile",0)
    HFCY A 0 A_PlaySoundEx("HFCyb/laugh","Voice")
    TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag(NODAMAGE,1)
	HFCY EEE 15 Bright A_FaceTarget 
  SpecialBurnLoop:
    TNT1 A 0 A_JumpIf(user_missile >= 30,"SpecialBurnEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
    HFCY E 2 Bright A_VileAttack
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 2 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 2 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 2 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 1 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 1 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 1 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	HFCY E 1 Bright A_VileAttack(0,500,100,269)
	HFCY E 0 A_VileTarget("FuelExplosionSpawner")
	loop
  SpecialBurnEnd:
	TNT1 A 0 A_ChangeFlag(NODAMAGE,0)
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    Goto See
  Stomp:
    TNT1 A 0 A_CheckFlag("Float","AntiAerial",AAPTR_TARGET)
	TNT1 A 0 A_CheckFlag("lookallaround","SpecialBurn",AAPTR_TARGET)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
    HFCY G 3 A_FaceTarget
	TNT1 A 0 A_Recoil(-50)
	HFCS A 5 A_FaceTarget		
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	TNT1 A 0 A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_CustomMissile("HFCyberStomp",10,0,0,0)
	HFCS B 8 A_FaceTarget
	TNT1 A 0 A_Jump(128,"FloorStomp","SeekerTracers","UndeadWave","FireBalls")
	Goto See
  Servants:
    TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_CheckFlag("Float","AntiAerial",AAPTR_TARGET)
	TNT1 A 0 A_CheckFlag("lookallaround","SpecialBurn",AAPTR_TARGET)
    TNT1 A 0 A_JumpIf(user_servants >= 1,"Army")	 
    TNT1 A 0 A_SetUserVar("user_Servants",user_Servants+1)
	HFCY G 3 A_FaceTarget
	HFCS A 5 A_FaceTarget		
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	TNT1 A 0 A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	HFCS G 0 A_CustomMissile("PentaLine1",0,0,-72,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-144,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-216,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-288,2)
    HFCS B 25 A_CustomMissile("PentaLine1",0,0,0,2)
	HFCY GGGGGGG 0 A_SpawnItemEx("HFire",frandom(-650,650),frandom(-650,650),0,0,0,0,SXF_NOCHECKPOSITION,0)
	HFCY GGGGGGGGGGGG 0 A_SpawnItemEx("HFire",frandom(-650,650),frandom(-650,650),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("HFireSpawner",0,0,20,30,0,0,90,0)
	HFCS B 0 A_SpawnItemEx("InfernoDemon1",0,0,20,10,0,0,90,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 AAAAAA 0 A_SpawnItemEx("HFireSpawner",0,0,20,30,0,0,270,0)
	HFCS B 0 A_SpawnItemEx("InfernoDemon2",0,0,20,10,0,0,270,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	HFCS B 400 A_FaceTarget
	Goto See
  Army:
    TNT1 A 0 A_CheckFlag("FRIENDLY","See")
	TNT1 A 0 A_CheckFlag("FLOAT","AntiAerial",AAPTR_TARGET)
	TNT1 A 0 A_CheckFlag("LOOKALLAROUND","SpecialBurn",AAPTR_TARGET)
	HFCY G 3 A_FaceTarget
	HFCS A 5 A_FaceTarget		
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	TNT1 A 0 A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	HFCS G 0 A_CustomMissile("PentaLine1",0,0,-72,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-144,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-216,2)
    HFCS G 0 A_CustomMissile("PentaLine1",0,0,-288,2)
    HFCS B 25 A_CustomMissile("PentaLine1",0,0,0,2)
	HFCY GGGGGGGGGGGGGGGG 0 A_SpawnItemEx("HFire",frandom(-650,650),frandom(-650,650),0,0,0,0,SXF_NOCHECKPOSITION,0)
	HFCY GGGGGGGGGGGG 0 A_SpawnItemEx("HFire",frandom(-1250,-250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	HFCS B 0 A_SpawnItemEx("Pyrodemon2",0,frandom(20,300),10,10,0,0,frandom(20,300),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	HFCS B 0 A_SpawnItemEx("Bruiserdemon2",0,frandom(20,300),10,10,0,0,frandom(20,300),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	HFCS BB 0 A_SpawnItemEx("RMAfrit2",0,frandom(20,300),10,10,0,0,frandom(20,300),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	HFCS BBBBBB 0 A_SpawnItemEx("HellfireBaron2",0,frandom(20,300),10,10,0,0,frandom(20,300),SXF_SETMASTER|SXF_NOCHECKPOSITION)
