	HFCY G 5 Bright A_SpawnItemEx("HFCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	HFCY G 5 Bright A_SpawnItemEx("HFCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	HFCY G 5 Bright A_SpawnItemEx("HFCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	HFCY G 5 Bright A_SpawnItemEx("HFCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	HFCY G 3 Bright A_SpawnItemEx("HFCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	HFCY G 5 A_FaceTarget
	HFCS A 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PainRageLoop:
	TNT1 A 0 Radius_Quake(10,80,0,24,0)	
	HFCS B 3 A_PlaySound("monsters/darkcyberstomp")
	HFCS B 2 Bright A_GiveInventory("StompTracersAttack")
	HFCS A 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
    TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Goto PainRageLoop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
    Goto See
  PainMissile:
    HFCY G 10 A_Pain
    Goto Teleport
  Pain.Legendary:
  Pain.LegendaryPlayer:
  Pain.LegendaryGuruPlayer:
  Pain.PlayerDevBall:
  Pain.PDTBFG:
  Pain.BFG10K:
  Pain.BFG9500Ball:
    TNT1 A 0 A_Jump(200, "Teleport")
    Goto PainMissile
  Pain.PlayerDBFG10K2:
  Pain.DBFG10K2:
  Pain.DBFG:
  Pain.PlayerDBFG:
  Pain.DBFG2:
  Pain.PlayerDBFG210K:
  Pain.DBFG210K:
  Pain.DBFG2Splash:
  Pain.PlayerDBFG2:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	Goto Insane
