    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
