	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    MISN A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    MISN A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    MISN A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    MISN A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
    CBEX A 3 Bright
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,135,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,225,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 0 A_CustomMissile("FuelExplosion01",0,0,315,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    CBEX B 3 Bright A_Explode(128,128,0)
    CBEX CDEFGHIJ 2 Bright
    Stop
  }
}

