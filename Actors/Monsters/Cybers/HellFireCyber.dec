Actor FuelRocket
{
  Radius 8
  Height 12
  Speed 50
  FastSpeed 60
  Damage (Random(80,150)) //30
  Projectile
  RenderStyle Add
  Species "Cybers"
  DamageType "Cyber10k"
  Alpha 0.95
  SeeSound "HFCyb/rocket"
  DeathSound "weapons/rocklx"
  DontHurtShooter
