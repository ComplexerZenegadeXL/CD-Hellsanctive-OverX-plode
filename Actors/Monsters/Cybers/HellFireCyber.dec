	HFCY F 1 Bright A_CustomMissile("FuelRocket",58,-26,frandom(-4, 4))
	Loop
  FuelRocketsEnd:
    TNT1 A 0 A_Jump(100,"PyroBombs","Pyroshot","Railgun","FireBalls","HF10K")
	Goto FlameRockets
  FireBalls:
    TNT1 A 0 A_PlaySound("weapons/charge15k")
    //TNT1 A 0 A_SetReflective
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	HFCY E 10 Bright A_FaceTarget
	HFCY E 4 Bright A_Facetarget
  FireBallsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 14, "FireBallsEnd")
    TNT1 A 0 A_SetUserVar("user_missile", user_missile+1)
	HFCY E 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("HFCyb/rocket")
	HFCY F 1 Bright A_CustomMissile("HFCyberFireBalls",58,-26,frandom(-9, 9))
	Loop
  FireBallsEnd:
	HFCY E 10 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	//TNT1 A 0 A_UnSetReflective
	TNT1 A 0 A_Jump(120,"FireBallsCombo","UndeadWave","Pyrobombs","Pyroshot")
	Goto See
  HF10K:
    //TNT1 A 0 A_Changeflag(reflective,1)
    TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_SetUserVar("user_missile", 0)
	HFCY E 10 Bright A_FaceTarget
	HFCY E 4 Bright A_FaceTarget
  HF10KLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 14, "HF10KEnd")
    TNT1 A 0 A_SetUserVar("user_missile", user_missile+1)
	HFCY E 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	HFCY F 1 Bright A_CustomMissile("HFCyber10K",58,-26,frandom(-8, 8))	
	HFCY E 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	HFCY F 1 Bright A_CustomMissile("HFCyber10K",58,-26,frandom(-8, 8))	
	Loop
  HF10KEnd:
	HFCY E 10 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	//TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(100,"PyroBombs","Pyroshot","Railgun")
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	//TNT1 A 0 A_Changeflag(reflective,1)
	TNT1 A 0 A_SetUserVar("user_Missile", 0)
    HFCY EE 10 A_FaceTarget
  RailgunLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 3, "RailgunEnd")
    TNT1 A 0 A_SetUserVar("user_Missile", user_Missile+1)
	TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFireSpawner",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
    HFCY EEEEEEEEEE 1 Bright A_FadeOut(0.1,0)
    TNT1 A 0 A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase(0, 0, CHF_NIGHTMAREFAST)
    TNT1 A 1 A_PlayWeaponSound("boss/teleport")
    TNT1 AAAAAAAAAAAA 0 A_SpawnItemEx("HFireSpawner",frandom(-64,64),frandom(-64,64),frandom(0,64),0,0,0,0,SXF_NOCHECKPOSITION)
	HFCY EEEEEEEEEE 1 A_FadeIn(0.1)
    HFCY E 1
    TNT1 A 0 A_ChangeVelocity(0, 0, 0, CVF_REPLACE)
	HFCY E 3 Bright A_FaceTarget
    HFCY F 2 Bright A_CustomMissile("HFRail",58,-26,frandom(-2,3))
	HFCY E 3 Bright A_FaceTarget
    HFCY F 1 Bright A_CustomMissile("HFRail",58,-26,frandom(-2,3))
	HFCY E 3 Bright A_FaceTarget
    HFCY F 2 Bright A_CustomMissile("HFRail",58,-26,frandom(-2,3))
	Loop
  RailgunEnd:
	HFCY E 10 Bright
	//TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(128,"UndeadWave","PyroBombs","Pyroshot","SoulsStorm","HellfireCombo","TheCall")
	Goto See
  PyroShot:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySoundEx("HFCyb/Laugh","Voice")
	HFCY EEEEEE 4 Bright A_FaceTarget 
	HFCY F 4 Bright A_FaceTarget  
