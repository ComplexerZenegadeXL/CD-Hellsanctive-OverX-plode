	HFCY F 0 A_CustomMissile("HFCyberFireballs",58, -26, -8)
	HFCY F 0 A_CustomMissile("HFCyberFireballs",58, -26, 8)
    HFCY F 4 Bright A_CustomMissile("PyroShot",58, -26, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_PlaySound("weapons/dtech10ksteam")
	HFCY EEEEEE 5 Bright A_SpawnItemEx("LegendaryCannonSmoke", 10, 12, 50, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(60,"SoulsStorm","HellFireCombo")
    Goto See
