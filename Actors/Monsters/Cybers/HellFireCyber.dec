Actor MiniHellFlame : RedParticleSpawner
{
  Scale 0.2
  Renderstyle Add
  Alpha 1.0
  +NOINTERACTION
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FIR1 ABCD 2 Bright A_FadeOut(0.1,0)
	FIR1 EFGHIJKL 1 Bright A_FadeOut(0.1,1)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor EternalFlame 
{
  Projectile
  Alpha 1
  Height 4
  Radius 2
  Gravity 0.52
  Bouncetype Doom
  BounceFactor 0.01
  WallBounceFactor 0.01
  Scale 1.5
  Renderstyle Add
  +DONTFALL
  -NOGRAVITY
  +NODAMAGETHRUST
  -EXTREMEDEATH
  +THRUSPECIES
  +DONTHARMSPECIES
  +NOTIMEFREEZE
  +FORCERADIUSDMG
  Species "Cybers"
  DamageType "HFCyb3r"
  var int user_fireloop;
}

Actor HellFlame : EternalFlame
{
  Species "Cybers"
  Damagetype "HFCyb3r"
  States
  {
  Spawn:
  Death:
	TNT1 A 0
	TNT1 A 0 A_JumpIf(waterlevel > 1, "OhGodOhFuck")
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	TNT1 A 0 A_SetUserVar("user_fireloop",random(0,8))
	TNT1 A 0 A_PlaySound("monster/ambientfire",7,1.0,1)
  DeathLoop:
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF AABBCC 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(39,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF DDEEFF 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(39,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF GGHHII 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(39,69)
	TNT1 A 0 A_JumpIf(user_fireloop >= 50,"Death2")	 
	TNT1 A 0 A_SetUserVar("user_fireloop",user_fireloop+1)
	HFHF KKLLMM 1 Bright A_SpawnItemEx("MiniHellFlame",frandom(-6,6),frandom(-6,6),frandom(0,3),frandom(-2,2),frandom(-2,2),frandom(2,7),frandom(0,360))
	TNT1 A 0 A_Explode(39,69)
	Loop
  Death2:
	TNT1 A 0 A_StopSound(7)
	HFHF MNOP 2 Bright
	Stop
  OhGodOhFuck:
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 1 A_ChangeFlag("MISSILE",0)
	Stop
  }
}

