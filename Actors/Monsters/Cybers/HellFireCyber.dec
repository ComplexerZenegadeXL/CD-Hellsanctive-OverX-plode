    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 0 A_SeekerMissile(0,2)
    TNT1 A 1 A_SpawnItemEx("ATracerPuff", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)	
    Loop
  }
}

Actor SeekerTracersAttackSpawner
{
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0
  Death:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_SpawnItemEx("HFCyberSeekerTracer",0,0,0,0,0,0,user_loop * 15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 22,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0
	Stop
  }
}

