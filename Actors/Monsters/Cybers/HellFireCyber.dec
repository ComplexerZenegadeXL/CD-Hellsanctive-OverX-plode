Actor HFCyberFireballs
{
  Radius 6
  Height 8
  Speed 50
  FastSpeed 60
  Damage (Random(150,300))
  Projectile
  +RANDOMIZE
  +DONTHARMSPECIES
  +DONTREFLECT
  +SEEKERMISSILE
  +EXTREMEDEATH
  Species "Cybers"
  Damagetype "HFCyb3r"
  RenderStyle Translucent
  Alpha 1
  Scale 1.0
  SeeSound "imp/attack"
  DeathSound "comet/explosion"
  States
  {
  Spawn:
	TNT1 A 1
	Goto Fly
  Fly:
	HFTB AB 1 Bright A_SpawnItemEx("HFCybFireballTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SeekerMissile(0,2)
	Loop
  Death:
	TNT1 A 0 A_Explode(128, 192)//Damage, Radius
	TNT1 A 0 A_SpawnItemEx("LCABaseScorch", 0, 0, 0, 0, 0, 0, frandom(0,360))
    TNT1 AAAA 0 A_CustomMissile ("OrangeParticleSpawner", 0, 0, frandom (0, 360), CMF_AIMDIRECTION, frandom (0, 180))
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_Scream
	Goto EndAnimation
  EndAnimation:
	TNT1 A 0 A_SpawnItemEx("CyberSuperMeteor_m_Explosion", 0, 0, 0, 0, 0, 0, -1, SXF_NOCHECKPOSITION) //A_CustomMissile("Meteor_m_Explosion",0+Random(5,80),0+Random(35,-35),0+Random(0,370))
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("HFCyberSuperMeteorSmoke", 0, 0, 0,frandom(-1.25, 1.25),frandom(-1.25, 1.25), frandom(0.25, 2.45), 0, SXF_CLIENTSIDE, 0)
	Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}

Actor HFCyberSuperMeteorSmoke : SuperMeteor_m_FX_Smoke { Scale 1.0 }

