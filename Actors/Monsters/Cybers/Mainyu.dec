  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    TNT1 A 0 A_Jump(256, "Puff1", "Puff2", "Puff3")
  Puff1:
    MNLI F 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    MNLI G 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    MNLI H 1 Bright A_FadeOut(0.1)
    Loop
  }
}
