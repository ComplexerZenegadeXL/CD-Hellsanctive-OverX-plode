	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 4 A_SpawnItemEx("MainyuStrikeBeamBlack",frandom(-1500,1500),frandom(-1500,1500),-1000,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 2 A_RadiusThrust(-1500,2048,RTF_NOIMPACTDAMAGE|RTF_NOTMISSILE)
	TNT1 A 30
	TNT1 A 0 A_PlaySound("MReimu/TeleportIn",7)
	TNT1 A 0 A_SpawnItemEx("MReimuTeleportEffect",0,0,40)
	2MA7 MMMLLLKKKJ 1 A_FadeIn(0.1)
    TNT1 A 0 A_SetUserVar("user_effect_type",53)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	2MA7 J 1
	TNT1 A 0 A_Jump(200,"ChangeMode")
	Goto MoreSee
  DarkStormRage:
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 4 A_SpawnItemEx("MReimuDarkMatterRain",frandom(-3000,3000),frandom(-3000,3000),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_VileTarget("MainyuBigStrikeBeamBlack")
	TNT1 AAAAAAAAAAAAAAAAAAAAAA 4 A_SpawnItemEx("MReimuDarkMatterRain2",frandom(-3000,3000),frandom(-3000,3000),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("MainyuBigStrikeBeamBlack",0,0,-1000)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("MainyuStrikeBeamBlack",frandom(-1500,1500),frandom(-1500,1500),-1000,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAA 2 A_RadiusThrust(-1500,2048,RTF_NOIMPACTDAMAGE|RTF_NOTMISSILE)
	TNT1 A 30
	TNT1 A 0 A_PlaySound("MReimu/TeleportIn",7)
	TNT1 A 0 A_SpawnItemEx("MReimuTeleportEffect",0,0,40)
	2MA7 MMMLLLKKKJ 1 A_FadeIn(0.1)
    TNT1 A 0 A_SetUserVar("user_effect_type",53)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	2MA7 J 1
	TNT1 A 0 A_Jump(200,"ChangeMode")
	Goto MoreSee
  SubliminationSword:
	2MA3 A 3 A_PlaySound("Mainyu/Attack8",2,1.0,0,ATTN_NONE)
	2MA3 BBBBBBB 3 A_SpawnItemEx("TrueNemesisHellionSmokeSpawner")
	TNT1 A 0 A_PlaySound("Mainyu/Sword")
	2MA3 CDEF 5
	TNT1 A 0 A_JumpIfTargetInLOS(2)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0 A_GiveToTarget("MainyuSubliminationGiver",1)
	2MA3 GHIJKL 4
	Goto MoreSee
  Shock:
	TNT1 A 0 A_PlaySound("Mainyu/Attack9",7)
	TNT1 A 0 A_PlaySound("Mainyu/HitscanWarn",6)
	2MA9 ABCDEEEFGHIJ 4
	TNT1 A 0 A_SetUserVar("user_missile",0)
  ShockLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 8,"ShockEnd")
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	2MA9 KL 4 A_CustomBulletAttack(2,2,1,random(20,50),"MainyuShockPuff",0,CBAF_NORANDOM)
	Loop
  ShockEnd:
	2MA9 MN 5
	TNT1 A 0 A_Jump(200,"ChangeMode")
	Goto MoreSee
  VoidTravel.Black:
	TNT1 A 0 A_PlaySound("Mainyu/Superattack3",1,1.0,0,ATTN_NONE)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	MAIT EFF 20 Fast
	TNT1 A 0 A_PlaySound("MReimu/Cast1")
	TNT1 A 0 A_SpawnItemEx("MReimuCastEffect2",0,0,50)
	MAIT J 60 Fast
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_ChangeFlag("NODAMAGE",1)
	TNT1 A 0 A_SetTranslucent(1.0)
	TNT1 A 0 A_RemoveChildren(1)
	TNT1 A 0 A_PlaySound("Mainyu/Disappear",7)
	TNT1 A 0 A_SpawnItemEx("MainyuVoidTravelEffect",0,0,50)
	TNT1 AAA 1 A_SpawnItemEx("MainyuVoidTravelFakeBlack")
	TNT1 A 30
	TNT1 A 0 A_SetUserVar("user_missile",0)
	Goto VoidTravelLoop
  VoidTravelEnd.Black:
	TNT1 A 0 A_PlaySound("MReimu/TeleportIn",7)
	TNT1 A 0 A_SpawnItemEx("MReimuTeleportEffect",0,0,40)
	2MA7 MMMLLLKKKJ 1 A_FadeIn(0.1)
    TNT1 A 0 A_SetUserVar("user_effect_type",53)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_ChangeFlag("NODAMAGE",0)
	2MA7 J 1 A_SetShootable
	Goto MoreSee
  Death:
	TNT1 A 0 A_ChangeFlag("NOGRAVITY",1)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 ACS_NamedExecuteAlways("ResetSectorColor",0)
	TNT1 A 0 A_JumpIf(user_mode == 1,"Death.Black")
	MAI2 LMN 4
	TNT1 A 0 A_RemoveChildren(1)
	TNT1 A 0 A_PlaySound("Mainyu/DeathSpeech",2,1.0,0,ATTN_NONE)
  DeathLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 85,"ActualDeath")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SpawnItemEx("MainyuDeathExplosion4",frandom(0,128),0,frandom(16,100),frandom(1,8),0,frandom(1,8),frandom(0,360),0,200)
	MAI2 N 4 A_SpawnItemEx("MainyuDeathExplosion3",0,0,32,frandom(-6,6),frandom(-6,6),frandom(-6,6))
	Loop
  Death.Black:
	2MA2 LMN 4
	TNT1 A 0 A_RemoveChildren(1)
	TNT1 A 0 A_PlaySound("Mainyu/DeathSpeech",2,1.0,0,ATTN_NONE)
	TNT1 A 0 A_GiveInventory("BlackMainyuDrop",random(1,5))
  DeathLoop.Black:
	TNT1 A 0 A_JumpIf(user_missile >= 85,"ActualDeath")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SpawnItemEx("MainyuDeathExplosion4",frandom(0,128),0,frandom(16,100),frandom(1,8),0,frandom(1,8),frandom(0,360),0,200)
	2MA2 N 4 A_SpawnItemEx("MainyuDeathExplosion3",0,0,32,frandom(-6,6),frandom(-6,6),frandom(-6,6))
	Loop
  ActualDeath:
	TNT1 A 0 A_PlaySound("Mainyu/DeathExplode",7,1.0,0,ATTN_NONE)
	TNT1 AA 0 A_SpawnItemEx("MainyuDeathExplosion",0,0,32)
	TNT1 AA 0 A_SpawnItemEx("MainyuDeathExplosion2",0,0,32)
	TNT1 A 0 A_Quake(7,90,0,3000)
	TNT1 A 0 A_JumpIfInventory("BlackMainyuDrop",0,"BetterDrops")
	TNT1 A 0 A_SpawnItemEx("SubliminationSwordGiver",0,0,8)
	TNT1 A 0 A_SpawnItemEx("NemesisOmegaSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 AA 0 A_DropItem("DemonicChaliceGiver",1,64)
	TNT1 AA 0 A_SpawnItemEx("SkullOfPowerGiver",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,64)
	TNT1 A 0 A_DropItem("TerminatorItem",1,16 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("LegendaryInvulnerabilitySphere",0,0,64,random(1,8),0,2,frandom(0,360),0,64)
	TNT1 AA 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	TNT1 AAAA 0 A_SpawnItemEx("CFManaPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 AA 0 A_SpawnItemEx("BigCFManaPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAA 3 A_SpawnItemEx("MainyuDeathExplosion4",frandom(0,128),0,frandom(16,100),frandom(1,8),0,frandom(1,8),frandom(0,360),0,120)
	TNT1 A 30
	TNT1 A 1
	Stop
  BetterDrops:
    TNT1 A 0 A_SpawnItemEx("SubliminationSwordGiver",0,0,8)
	TNT1 A 0 A_SpawnItemEx("NemesisOmegaSphere",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,128)
	TNT1 A 0 A_DropItem("DemonicChaliceUpgrade",1,64)
	TNT1 A 0 A_DropItem("SkullOfPowerUpgrade",1,128)
	TNT1 A 0 A_DropItem("TerminatorItem",1,128 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_DropItem("TerminatorItem",1,32 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("LegendaryInvulnerabilitySphere",0,0,64,random(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,50)
	TNT1 A 0 A_SpawnItemEx("IronMaiden",0,0,8,frandom(0,8),frandom(0,8),2,frandom(0,360),0,192)
	TNT1 AAAAAAAAA 0 A_SpawnItemEx("CFManaPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 AAAA 0 A_SpawnItemEx("BigCFManaPickup",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAA 3 A_SpawnItemEx("MainyuDeathExplosion4",frandom(0,128),0,frandom(16,100),frandom(1,8),0,frandom(1,8),frandom(0,360),0,120)
	TNT1 A 30
	TNT1 A 1
	Stop
  }
}

