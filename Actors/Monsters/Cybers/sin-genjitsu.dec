Actor sin-genjitsu : GenericBoss
{
  Health 0x7FFFFFFF
  Mass 0x7FFFFFFF
  +NORADIUSDMG
  +NOTIMEFREEZE
  +NOTELEFRAG
  +NODAMAGE
  -NOGRAVITY
  ActiveSound " "
  DeathSound " "
  SeeSound " "
  Tag "$CFSinG"
  States
  {
  Spawn:
	TNT1 A 0
    SING A 1 ACS_NamedExecuteAlways("SinGenjitsuFuckery",0)
	TNT1 A 0 A_RadiusGive("SingenjitsuFuckery",5000,RGF_PLAYERS|RGF_NOSIGHT)
	SING A 100
	TNT1 A 0 A_SpawnItemEx("TheParticleSpawnerToEndAllParticleSpawners",0,0,32)
