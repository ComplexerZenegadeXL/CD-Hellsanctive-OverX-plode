	TNT1 A 1 A_Jump(9,"Death")
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 5 bright A_SpawnItemEx("LordArchonMinions")
	Stop
  }
}

