Actor LordArchon
{ 
  Health 15000
  Scale 2
  Radius 40
  Height 110
  Mass 999999
  Speed 11
  Monster
  MeleeRange 384
  PainChance 6
  Obituary "$CFLordArchonObit"
  HitObituary "$CFLordArchonHitObit"
  BloodColor "ff 5f 00"
  +BOSS
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +NORADIUSDMG
  +DONTHARMSPECIES
  +NOTIMEFREEZE
  +NOPAIN
  +BRIGHT
  +NOICEDEATH
  +NOTELEFRAG
  Species "Cybers"
  DamageType "Hell"
  DamageFactor "Exos", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "HellComet", 0.2
  DamageFactor "Hell", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "DarkCyberRocket", 0.0
  DamageFactor "CyberRocket", 0.0
  DamageFactor "HFCyb3r", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "DBFG2", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.01
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "BFGSplash", 0.1
  DamageFactor "BFGSpray", 0.1
  DamageFactor "PDTBFG", 0.0
  DamageFactor "PDTBFGTracer", 0.0
  DamageFactor "PlayerDevBall", 0.0
  DamageFactor "PlayerDevBall2", 0.0
  DamageFactor "PlayerDevTracer", 0.0
  DamageFactor "Ice", 0.5
  DamageFactor "PlayerIce", 0.5
  DamageFactor "Explosion", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.3
  DamageFactor "PlayerNemesisBFG", 0.1
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.0
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.01
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8  
  DamageFactor 0.45
  MinMissileChance 10
  SeeSound "ArchonLord/see"
  ActiveSound "Arcradimus/Active"
  PainSound "ArchonLord/pain"
  DeathSound "ArchonLord/death"
  MaxStepHeight 32
  MaxDropOffHeight 32
  Tag "$CFArchon"
  var int user_delay;
  var int user_music;
  var int user_lowlag;
  var int user_loop;
  States 
  { 
  Spawn:
	PYLD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
  Idle:
	PYLD A 10 A_Look 
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PYLD AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,718)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	PYLD AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	PYLD CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(50,"Teleport","Avoid")
	Loop
  Rush:
	PYLD A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	PYLD AAA 0 A_Chase
	PYLD A 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD A 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD B 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD B 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	PYLD A 0 A_SpawnItemEx("LegendaryHoofStep",0,0,5,0,0,-20)
	PYLD AAA 0 A_Chase
	PYLD C 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD C 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD D 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD AAA 0 A_Chase
	PYLD D 2 A_SpawnItemEx("LordArchonGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(110,"Avoid")
	TNT1 A 0 A_Jump(40,"Teleport")
	TNT1 A 0 A_Jump(75,"See")	
	Loop	
  Teleport:
	PYLD M 1 A_UnSetShootable
	PYLD MMMMMMMMMMMMM 0 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD MMMMMMMMMM 1 A_FadeOut(0.1,0)
	PYLD MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 0 A_Wander
	PYLD M 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	PYLD MMMMMMMMMMMMM 0 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD MMMMMMMMMM 1 A_FadeIn(0.1)
	PYLD M 1 A_SetShootable
	Goto See
  Fly:
	PYLD M 5 A_FaceTarget
	PYLD M 0 A_SetUserVar("user_delay",0)
	PYLD M 0 ThrustThingZ(0,random(80,145),0,1)
	PYLD MMMM 5 A_Recoil(-10)
  FlyCheck:
	PYLD M 0 A_JumpIf(user_delay >= 105,"Land")
	PYLD M 0 A_SetUserVar("user_delay",user_delay+1)
	PYLD M 0 A_Explode(8,256)
	PYLD M 1 A_JumpIf(velz==0,"land")
	Loop
  Land:	
	PYLD M 0 A_SpawnItemEx("ShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	PYLD MMM 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	PYLD MMM 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	PYLD MMMMM 0 A_CustomMissile("CFKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	PYLD M 0 A_CustomMissile("Explosion",0,0,frandom(80,100),CMF_AIMDIRECTION,frandom(80,100))
	PYLD M 0 A_Explode(128,684)
	PYLD M 0 Radius_Quake(175,8,512,1024,0)
	PYLD M 0 A_SpawnItemEx("LandKaBoom")
	PYLD M 1
	Goto See
  Avoid:
	PYLD M 1 A_FaceTarget
	PYLD M 0 A_SetAngle(angle+frandom(0,360))
	PYLD M 0 A_Recoil(-50)
	PYLD M 0 A_FaceTarget
	PYLD MMMMMMMMMMMMM 1 A_SpawnItemEx("LordArchonGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	 
	PYLD M 0 A_SetAngle(angle+frandom(0,360))
	PYLD M 0 A_Recoil(-50)
	PYLD M 0 A_FaceTarget
	PYLD MMMMMMMMMMMMM 1 A_SpawnItemEx("LordArchonGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	PYLD M 0 A_SetAngle(angle+frandom(0,360))
	PYLD M 0 A_Recoil(-50)
	PYLD M 0 A_FaceTarget
	PYLD MMMMMMMMMMMMM 1 A_SpawnItemEx("LordArchonGhost2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)		
	Goto See  
  Melee:
  Missile:		
	TNT1 A 0 A_Jump(60,"Fly")
	TNT1 A 0 A_Jump(32,"Combo","BestAttack","Burning","Spam")	
	TNT1 A 0 A_Jump(192,"SeekComet","Comet","CometRain","Floor")	
	TNT1 A 0 A_Jump(48,"Help")
  Normal:
	PYLD EF 6 A_FaceTarget
	PYLD G 1 A_CustomMissile("LABall",64,0,0)
	PYLD G 0 A_CustomMissile("LABall",64,0,-4)
	PYLD G 1 A_CustomMissile("LABall",64,0,4)
	PYLD H 0 A_CustomMissile("LABall",64,0,-8)
	PYLD H 3 A_CustomMissile("LABall",64,0,8)
	PYLD IJ 6 A_FaceTarget
	PYLD K 1 A_CustomMissile("LABall",64,0,0)
	PYLD K 0 A_CustomMissile("LABall",64,0,-4)
	PYLD K 1 A_CustomMissile("LABall",64,0,4)
	PYLD K 0 A_CustomMissile("LABall",64,0,-8)
	PYLD L 3 A_CustomMissile("LABall",64,0,8)
	TNT1 A 0 A_Jump(110,"SeekComet")	
	Goto See
  SeekComet:
	PYLD PO 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekCometLoop:
	PYLD N 0 A_FaceTarget
	PYLD N 0 A_CustomMissile("LASeekerComet",104,-39,frandom(-2,2))
	PYLD N 5 A_CustomMissile("LASeekerComet",104,39,frandom(-2,2))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 8,1)
	Loop
	PYLD M 6 A_FaceTarget
	TNT1 A 0 A_Jump(110,"Comet","Avoid")
	Goto See	
  Comet:
	PYLD MN 6 A_FaceTarget
	PYLD O 1 A_CustomMissile("LAPyroComet",64,0,0)
	PYLD O 0 A_CustomMissile("LAPyroComet",64,0,-3)
	PYLD O 1 A_CustomMissile("LAPyroComet",64,0,3)
	PYLD O 0 A_CustomMissile("LAPyroComet",64,0,-6)
	PYLD O 1 A_CustomMissile("LAPyroComet",64,0,6)
	PYLD O 0 A_CustomMissile("LAPyroComet",64,0,-9)
	PYLD O 1 A_CustomMissile("LAPyroComet",64,0,9)	
	PYLD O 0 A_CustomMissile("LAPyroComet",64,0,-12)
	PYLD P 6 A_CustomMissile("LAPyroComet",64,0,12)
	TNT1 A 0 A_Jump(110,"CometRain")
	Goto See	
  CometRain:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("ArchonLord/see","Body",0,2)
	PYLD PPOONNMM 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  CometRainLoop:
	PYLD M 0 A_SpawnItemEx("LordArchonRainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	PYLD M 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,1)
	Loop
	PYLD M 0 A_SpawnItemEx("LordArchonRainCometSpawner",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	PYLD M 2 A_SpawnItemEx("LordArchonFlameSpawner")
	TNT1 A 0 A_Jump(140,"Fly")
	TNT1 A 0 A_Jump(110,"Floor")
	Goto See
  Burning:
	PYLD PPOONNMM 2 A_FaceTarget
	PYLD MMMMMMMMMMMMMMM 2 A_SpawnItemEx("LAFire",frandom(-1250,1250),frandom(-1250,1250),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Jump(140,"Fly")
	TNT1 A 0 A_Jump(110,"Floor")
	Goto See
  Floor:
	PYLD MNO 4 A_FaceTarget
	PYLD P 0 A_CustomMissile("ArchonLordTracer",0,40,0)
	PYLD P 0 A_CustomMissile("ArchonLordTracer",0,-40,0)
	PYLD P 0 A_CustomMissile("ArchonLordTracer",0,24,0)	
	PYLD P 0 A_CustomMissile("ArchonLordTracer",0,-24,0)
	PYLD P 0 A_CustomMissile("ArchonLordTracer",0,8,0)
	PYLD P 6 A_CustomMissile("ArchonLordTracer",0,-8,0)
	TNT1 A 0 A_Jump(110,"BestAttack","Avoid")
	Goto See	
  Combo:
	PYLD EF 18 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 10 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 10 A_FaceTarget
	PYLD IJ 18 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 10 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 10 A_FaceTarget  
	PYLD EF 16 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 8 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 8 A_FaceTarget
	PYLD IJ 16 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 8 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 8 A_FaceTarget  
	PYLD EF 14 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 7 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 7 A_FaceTarget
	PYLD IJ 14 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 7 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 7 A_FaceTarget  
	PYLD EF 12 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 6 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 6 A_FaceTarget
	PYLD IJ 12 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 6 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 6 A_FaceTarget  
	PYLD EF 10 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 5 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 5 A_FaceTarget
	PYLD IJ 10 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 5 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 5 A_FaceTarget  
	PYLD EF 8 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 4 A_CustomMissile("FastBBall",64,0,random(-18,18))
	PYLD H 4 A_FaceTarget
	PYLD IJ 8 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 4 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 4 A_FaceTarget  
	PYLD EF 6 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 3 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 3 A_FaceTarget
	PYLD IJ 6 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 3 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 3 A_FaceTarget 
	PYLD EF 5 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 2 A_FaceTarget
	PYLD IJ 5 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 2 A_FaceTarget 
	PYLD EF 5 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 2 A_FaceTarget
	PYLD IJ 5 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 2 A_FaceTarget 	
	PYLD EF 5 A_FaceTarget
	PYLD GGGGGGGGGGGGGG 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD G 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD H 2 A_FaceTarget
	PYLD IJ 5 A_FaceTarget
	PYLD KKKKKKKKKKKKKK 0 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD K 2 A_CustomMissile("FastBBall",64,0,frandom(-18,18))
	PYLD L 2 A_FaceTarget  
	TNT1 A 0 A_Jump(110,"Teleport","BestAttack")	
	Goto See
  BestAttack:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("ArchonLord/see","Body",0,2)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BestAttackLoop:
	PYLD M 0 A_FaceTarget
	PYLD M 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 24,1)
	Loop
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BestAttackLoop2:
	PYLD N 0 A_FaceTarget
	PYLD N 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 24,1)
	Loop
	PYLD O 0 A_CustomMissile("ArchonLordMegaBall",64,0,14)
	PYLD O 0 A_CustomMissile("ArchonLordMegaBall",64,0,-14)
	PYLD O 0 A_CustomMissile("ArchonLordMegaBall",64,0,7)
	PYLD O 0 A_CustomMissile("ArchonLordMegaBall",64,0,-7)
 	PYLD O 6 A_CustomMissile("ArchonLordMegaBall",64,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	PYLD PPPP 6 A_FaceTarget
	TNT1 A 0 A_Jump(148,"Teleport","Spam")
	Goto See
  Spam:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("ArchonLord/see","Body",0,2)
	PYLD M 0 A_FaceTarget
	PYLD M 0 A_CustomMissile("LordArchonMiniBallSpammer",64,0,0)
	PYLD MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 6 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	PYLD M 68
	Goto See
  Help:
  	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	PYLD EEFFGGHHHHHHHHHH 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD MMMMM 0 A_SpawnItemEx("LordArchonSpawners",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,64)
	PYLD H 2 A_SpawnItemEx("LordArchonFlameSpawner")
 	PYLD IIJJKKLLLLLLLLLL 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD LLLLL 0 A_SpawnItemEx("LordArchonSpawners",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,64)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	PYLD L 2 A_SpawnItemEx("LordArchonFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(64,"Teleport","Fly")
	PYLD Q 2
	PYLD Q 2 A_Pain
	Goto See
  Death: 
	PYLD R 2 A_Scream
	PYLD RRRRRRRRRRRSSSSSSSSSSSTTTTTTTTTTT 2 A_SpawnItemEx("LordArchonFlameSpawnerDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD R 2 A_NoBlocking 
	PYLD UUUUUUUUUUUVVVWWW 2 A_SpawnItemEx("LordArchonFlameSpawnerDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_DropItem("TerminatorItem",1,16 + 16 * ACS_NamedExecuteWithResult("BraceletsCheck"))
	TNT1 A 0 A_SpawnItemEx("PyroCannon",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryInvulnerabilitySphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	PYLD XXXYYY 2 A_SpawnItemEx("LordArchonFlameSpawnerDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PYLD Z -1
	Stop
  } 
}

Actor LABall : BBall2 { Species "Cybers" DamageType "Hell" }

Actor LASeekerComet : SeekerComet { Species "Cybers" DamageType "Hell" }

Actor LAPyroComet : PyroComet { Species "Cybers" DamageType "Hell" }

Actor ArchonLordTracer
{
  Radius 5
  Height 5
  Speed 38
  Damage (Random(75,90)) //18
  Species "Cybers"
  DamageType "Hell"
  RenderStyle Add
  Alpha 0.67
  Projectile
  +FLOORHUGGER
  +THRUGHOST
  -NOGRAVITY
  +DONTSPLASH
