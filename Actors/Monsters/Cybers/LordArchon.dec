Actor LAFire : IFire
{
  Obituary "$CFLAFireObit"
  Species "Cybers"
  DamageType "Hell"
  var int user_delay;
  Speed 8
  +NOCLIP
  YScale 2
  XScale 3
  States
  {
  Spawn:
	DFIR A 2 Bright
	TNT1 A 0 A_JumpIf(user_delay >= 60,"Death")
	TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Wander
	DFIR B 2 Bright A_Explode(Random(6,12),192)
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Wander
	DFIR C 2 Bright A_Explode(Random(6,12),192)
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Wander
	DFIR D 2 Bright A_Explode(Random(6,12),192)
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DFIR C 0 A_FireCrackle
	TNT1 A 0 A_Wander
	DFIR C 2 Bright A_Explode(Random(6,12),192)	
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Wander
	DFIR B 2 Bright A_Explode(Random(6,12),192)	
	Goto Spawn+1
  Death:
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DFIR E 2 Bright A_Explode(Random(6,12),128)	
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DFIR F 2 Bright A_Explode(Random(6,12),128)	
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DFIR G 2 Bright A_Explode(Random(6,12),128)	
	TNT1 A 0 A_SpawnItemEx("LAFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	DFIR H 2 Bright A_Explode(Random(6,12),128)	
	Stop
  }
}

