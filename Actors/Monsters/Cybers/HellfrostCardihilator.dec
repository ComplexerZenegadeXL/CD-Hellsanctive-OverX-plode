Actor MonsterFreezeBFGBolt
{
  Projectile
  Height 6
  Radius 6
  Speed 35
  Alpha 0.8
  RenderStyle Add
  ReactionTime 245
  Damage (Random(75,125)) //22
  +FORCEXYBILLBOARD
  +SEEKERMISSILE
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTREFLECT
  +DONTHARMSPECIES
  +NOTIMEFREEZE
  Species "CFBoss"
  DamageType "Ice"
  DeathSound "bolt/explode"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	TNT1 A 0 A_Seekermissile(5,5,SMF_LOOK|SMF_PRECISE)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckSeeker") == 1,"Enemy")
  "Friendly":
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_NULL)
	FBLS AAAA 1 Bright A_SpawnItemEx("FreezeBFGBoltTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Spawn
  Enemy:
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	FBLS A 1 Bright A_SpawnItemEx("FreezeBFGBoltTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Spawn
  Death:
	FBLS BCDE 1 Bright
	Stop
  XDeath:
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom6",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	FBLS BCDE 1 Bright
	Stop
  }
}

