Actor MonsterFreezerBall
{
  Projectile
  Height 16
  Radius 16
  Speed 15
  Alpha 0.95
  Scale 0.7
  RenderStyle Translucent
  Alpha 0.85
  Damage (Random(30,60)) //1000
  +RIPPER
  +THRUGHOST
  +BLOODLESSIMPACT
  +FORCERADIUSDMG
  +EXTREMEDEATH
  +NODAMAGETHRUST
  +SKYEXPLODE
  +FORCEXYBILLBOARD
  +DONTHARMSPECIES
  +THRUSPECIES
  +MTHRUSPECIES
  Species "CFBoss"
  DamageType "Ice"
  var int user_loop;
  Obituary "$CFMonsterFreezerBallObit"
  States
  {
  Spawn:
	TNT1 A 0 
	TNT1 A 0 A_PlaySound("devastator/fly",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_CustomMissile("MonsterFreezeBFGBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("MonsterFreezeLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,random(0,360))
