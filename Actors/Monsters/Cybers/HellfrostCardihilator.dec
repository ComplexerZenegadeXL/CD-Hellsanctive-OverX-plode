	TNT1 A 0 A_SpawnItemEx("T3DBFGBoltExpStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBoltExpStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("T3DBFGBoltExpImpactFlareSpawner",0,0,10,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("HellCardDBFGBoltExpSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_SETMASTER,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("T3DBFGBoltExpChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("T3DBFGBoltExpChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
