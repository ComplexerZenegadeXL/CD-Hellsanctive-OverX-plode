Actor FreezeBFGFlameStreamTrail
{
  Height 2
  Radius 2
  Speed 3
  Scale 1
  RenderStyle Add
  Alpha 0.32
  Damage (0)
  +MISSILE
  +DROPOFF
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
