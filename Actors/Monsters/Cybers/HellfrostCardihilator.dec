	Stop
  }
}

Actor FreezeBFGTrail
{
  Height 2
  Radius 1
  Speed 0
  Scale 1.45
  RenderStyle Add
  +MISSILE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	Goto Fade
  Fade:
	HBRB E 4 Bright A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

