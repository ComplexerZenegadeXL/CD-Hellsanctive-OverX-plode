	TNT1 A 20 A_SpawnItemEx("T3DBFGBallExp")
	Stop    
  }
}

Actor HellCardDBFGShockAttack : T3DBFGShockAttack
{
  +NOTIMEFREEZE
  Species "CFBoss"
