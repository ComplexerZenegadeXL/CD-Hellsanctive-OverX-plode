Actor HellfrostCardihilator : Cardihilator
{ 
  Health 7000
  Speed 14
  PainChance 15
  PainChance "PDTBFG", 10
  PainChance "SoulToxic", 3
  PainChance "FatFlamer", 3
  PainChance "FiendFire", 3
  PainChance "Explosion", 35
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Acid", 0.01
  DamageFactor "Fire", 0.1
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.001
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "BFGSplash", 0.5
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Explosion", 0.3
  DamageFactor "Mine", 0.3
  DamageFactor "Extreme", 0.0
  DamageFactor "Player", 0.01
  DamageFactor "PDTPuff", 0.0
  DamageFactor "PyroShot", 0.001
  DamageFactor "PlayerPyro", 0.01
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "Players", 0.02
  DamageFactor "PlayerDevBall", 0.02
  DamageFactor "PlayerDevBall2", 0.02
  DamageFactor "PlayerDevTracer", 0.02
  DamageFactor "PlayerBHole", 0.025
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.015
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.015
  DamageFactor "PlayerLegendary", 0.015
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "HellComet", 0.4
  DamageFactor 0.5
  DropItem "BossLifeEssence" 256 25
  DropItem "BossArmorBonusMax" 256 1
  DropItem "DemonAmmoBoxPickup" 128 200
  DropItem "DemonicChaliceGiver" 92
  DropItem "SkullOfPowerGiver" 92
  DropItem "FreezerRifleGiver" 256
  DropItem "LegendaryUltrasphere" 64
  DropItem "D-BFGGiver" 256
  DropItem "FreezerBFGGiver" 192
  DropItem "DCellPackPickup" 256 32
  DropItem "DCellPackPickup" 128 24
  DropItem "DCellPickup" 256 10
  DropItem "DCellPickup" 256 10
  DropItem "DCellPickup" 256 10
  SeeSound "FreezedCyberDemon/See"
  PainSound "BlueCardinal/Pain"
  ActiveSound "BlueCardinal/Active"
  DeathSound "BlueCardinal/Death"
  BloodColor "DarkBlue"
  +NOTIMEFREEZE
  +NOICEDEATH
  +BRIGHT
  +NOTELEFRAG
  Obituary "$CFHellfrostCardihilatorObit"
  Tag "$CFFrostCar"
  var int user_music;
  var int user_taunt;
  var int user_lowlag;
  States 
  { 
  Spawn:
	FCAR A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,24)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",23)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SpawnItemEx("FreezedCyberFlameSpawner")
	FCAR ABAB 2 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	FCAR AB 2 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,803)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIf(user_taunt == 0,"Seeloop")
	TNT1 A 0 A_PlaySound("FreezedCyberDemon/Active",2,1.0,0,ATTN_NONE)
	TNT1 A 0 A_SetUserVar("user_taunt",0)
  SeeLoop:
	FCAR AB 2 A_Chase
	TNT1 A 0 A_Jump(16,"Rush")
	Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("FrozenCardGhostA")
	TNT1 A 0 A_Chase
	FCAR A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FrozenCardGhostA")
	TNT1 A 0 A_Chase
	FCAR A 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FrozenCardGhostB")
	TNT1 A 0 A_Chase
	FCAR B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("FrozenCardGhostB")
	TNT1 A 0 A_Chase
	FCAR B 1 A_Chase
	TNT1 A 0 A_Jump(16,"SeeLoop")
	Loop
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K","FreezeRifle","DBFG","FreezeBFG")
  Normal:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	FCAR C 6 A_FaceTarget 	
	TNT1 A 0 A_CustomMissile("FreezedCyberRocket",45,-26,frandom(-6,6))
	FCAR D 6 A_CustomMissile("FreezedCyberRocket",45,26,frandom(-6,6))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	FCAR CC 6
	TNT1 A 0 A_Jump(128,"Seekers","Railgun","BFG10K","DTBFG10K")
	Goto See
  Seekers:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SeekersLoop:
	FCAR C 6 A_FaceTarget 	
	TNT1 A 0 A_CustomMissile("FreezedCyberHomer",45,-26)
	FCAR D 6 A_CustomMissile("FreezedCyberHomer",45,26)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	FCAR CC 6
	TNT1 A 0 A_Jump(128,"Railgun","BFG10K","DTBFG10K")
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	FCAR CCCCC 5 A_FaceTarget
	TNT1 A 0 A_CustomRailgun(Random(60,80), 26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	FCAR D 5 A_CustomRailgun(Random(60,80), -26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	FCAR CC 5 A_FaceTarget
	TNT1 A 0 A_CustomRailgun(Random(60,80), 26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	FCAR D 5 A_CustomRailgun(Random(60,80), -26, None, "Blue", RGF_NOPIERCING,1,2,"HellRailPuff",0,0,1250,0,40,0,"BlueAnniRailgunTrail")
	FCAR C 10
	TNT1 A 0 A_Jump(128,"BFG10K","DTBFG10K")
	Goto See	
  BFG10K:
	TNT1 A 0 A_PlaySound("Weapons/dbfgcharge2")
	FCAR CCCCC 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BFG10KLoop:
	TNT1 A 0 A_PlaySound("Weapons/dbfgfire2")
	TNT1 A 0 A_CustomMissile("HellCardDBFG10kShot",45,-26,frandom(-4,4))
	FCAR D 3 A_CustomMissile("HellCardDBFG10kShot",45,26,frandom(-4,4))
	FCAR C 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)
	FCAR C 20
	TNT1 A 0 A_Jump(128,"DTBFG10K")
	Goto See	
  DTBFG10K:
  	TNT1 A 0 A_PlaySound("Cardinal/9k")
	FCAR CCCCCC 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellCardDBFG10kBall",45,-26,0)
	FCAR D 8 A_CustomMissile("HellCardDBFG10kBall",45,26,0)
  	TNT1 A 0 A_PlaySound("Cardinal/9k")
	FCAR CCCCCC 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellCardDBFG10kBall",45,-26,0)
	FCAR D 8 A_CustomMissile("HellCardDBFG10kBall",45,26,0)
	FCAR C 8
	Goto See
  FreezeRifle:
	FCAR CC 5 A_FaceTarget 	
	TNT1 A 0 A_CustomMissile("HellCardFreezeBlast",45,-26,frandom(-6,6))
	FCAR D 3 A_CustomMissile("HellCardFreezeBlast",45,26,frandom(-6,6))
	FCAR C 3 A_FaceTarget
	TNT1 A 0 A_Jump(4,"See")
	TNT1 A 0 A_MonsterRefire(200,"See")
	Goto FreezeRifle+2
  DBFG:
    TNT1 A 0 A_PlaySound("Weapons/dbfgcharge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	FCAR CCCCCCCCCCCCCCCCCCCCCCC 5 A_FaceTarget
    TNT1 A 0 A_PlaySound("Weapons/dbfgfire", CHAN_AUTO)
	TNT1 A 0 A_CustomMissile("HellCardDBFGBall",45,-26,0,CMF_AIMOFFSET)
	FCAR D 8 A_CustomMissile("HellCardDBFGBall",45,26,0,CMF_AIMOFFSET)
    TNT1 A 0 A_PlaySound("Weapons/dbfgcooldown")
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	FCAR C 20
	Goto See
  FreezeBFG:
    TNT1 A 0 A_PlaySound("devastator/charge")
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	FCAR CCCCCCCCCCCCCCCCCCC 5 A_FaceTarget
	TNT1 A 0 A_PlaySound("devastator/fire",1)
	TNT1 A 0 A_CustomMissile("MonsterFreezerBall",45,-26,0,CMF_AIMOFFSET)
	FCAR D 8 A_CustomMissile("MonsterFreezerBall",45,26,0,CMF_AIMOFFSET)
	TNT1 A 0 A_SetUserVar("user_taunt",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	FCAR C 20
	Goto See
  Pain:
	FCAR E 6 A_Pain
	TNT1 A 0 A_Jump(128,"Missile","Summon")
	Goto See
  Summon:
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 A_Jump(100,"CryoDemons","FreezerBehemoths")
	FCAR E 1 A_CustomMissile("CryoImpSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoImpSummoner",58,-26,-22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoImpSummoner",58,-26,22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoImpSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  CryoDemons:
	FCAR E 1 A_CustomMissile("CryoDemonSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoDemonSummoner",58,-26,-22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoDemonSummoner",58,-26,22,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("CryoDemonSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  FreezerBehemoths:
	FCAR E 1 A_CustomMissile("FreezerBehemothSummoner",58,-26,-45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 3 A_FaceTarget
	FCAR E 1 A_CustomMissile("FreezerBehemothSummoner",58,-26,45,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	FCAR E 25 A_SpawnItemEx("FreezedCyberInvilFlameSpawner")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Death.PlayerIce:
  Death: 
	FCAR E 10 A_Scream
	FCAR F 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	FCAR GGGGG 2 A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	FCAR HHHHH 2 A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	FCAR IIIII 2 A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)	
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	FCAR JJJJJ 1 A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), random(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	FCAR KKKKK 1 A_CustomMissile("BlueKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	FCAR L 2
	FCAR M 3
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("CyberIceSpike",frandom(-256,256),frandom(-256,256),0,0,0,0,0,SXF_ABSOLUTEPOSITION|SXF_NOCHECKPOSITION,0)
	Stop
  } 
}

Actor HellCardDBFG10kShot : T3DBFG10kShot
{
  +THRUSPECIES
  +NOTIMEFREEZE
  Species "CFBoss"
  DamageType "Cyber10K"
  DeathType "Ice"
  States
  {
  Death:
  XDeath:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("T3DBFG10kDeathParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("T3DBFGShotShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(100,100,0)
	BG3X A 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",16,16,0,0,0,0,0,SXF_SETMASTER,0)
	BG3X B 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",-16,16,0,0,0,0,0,SXF_SETMASTER,0)
	BG3X C 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",16,-16,0,0,0,0,0,SXF_SETMASTER,0)
	BG3X D 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",-16,-16,0,0,0,0,0,SXF_SETMASTER,0)
	BG3X E 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",0,0,16,0,0,0,0,SXF_SETMASTER,0)
	BG3X F 3 Bright A_SpawnItemEx("HellCardDBFGShotShockwaveDmg",0,0,-16,0,0,0,0,SXF_SETMASTER,0)
	Stop
  }
}

Actor HellCardDBFGShotShockwaveDmg : T3DBFGShotShockwaveDmg
{
  +THRUSPECIES
  +NOTIMEFREEZE
  Species "CFBoss"
  DamageType "Cyber10K"
  DeathType "Ice"
}

Actor HellCardDBFG10kBall : T3DBFG10kBall
{
  +THRUSPECIES
  +NOTIMEFREEZE
  Species "CFBoss"
  DamageType "Cyber10K"
  DeathType "Ice"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_AlertMonsters
  SpawnLoop:
	TNT1 A 0 A_Jump(128,"SFX")
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 A 1 Bright A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 B 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 C 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 D 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	Loop
  SFX:
	TNT1 A 0 A_AlertMonsters
	TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 A 1 Bright A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 B 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 C 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(8,16),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	B3S1 D 1 Bright //A_SpawnItemEx("HellCardDBFGShockAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
	Goto Spawn   
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)	
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
