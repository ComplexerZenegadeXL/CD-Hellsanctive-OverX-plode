Actor LegBombTrail : LCABaseEffect
{
  Alpha 0.50
  Renderstyle Add
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  Scale 0.90
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SetScale(ScaleX -0.01, ScaleY -0.01)
	UBAL BDBDB 1 Bright A_FadeOut(0.05)
	Loop
  }
}

