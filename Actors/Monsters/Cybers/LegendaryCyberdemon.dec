	CYB2 G 3 Bright A_PlaySoundEx("Legcyber/laugh2","LAUGH2")
	CYB2 GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG 3 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")		
	TNT1 A 0 A_SetUserVar("user_loop",0)
