  DamageFactor "PlayerIce", 0.25
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.6
  DamageFactor 0.55
  PainChance "PlayerDBFG2", 256
  PainChance "DBFG2", 256
  PainChance "PlayerDBFG10K2", 256
  Speed 19
  PainChance 7
  BloodColor "Blue"
  Monster
  MinMissileChance 160
  DropItem "LegendaryUltraSphere" 215
  DropItem "LDemonAmmoBoxPickup" 256 
  //DropItem "LegendaryBFGGiver" 256 
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  DropItem "DemonicChaliceGiver" 128
  //DropItem "LegendaryPlasmaticRifle" 140
  DropItem "LegendaryAmmoSphere" 128
  DropItem "LegendaryDemonRune" 80
  //DropItem "LegendaryAssaultShotgunGiver" 100
  DropItem "TrueLegendaryUltraSphere" 45
  //DropItem "LegendaryBFG10KGiver" 200
  DropItem "LegendaryRandomSphere" 16
  DropItem "LegendaryInvisibilitySphere" 32
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +MISSILEMORE
  +FLOORCLIP
  +DONTMORPH
  +BOSSDEATH
  +NOICEDEATH
  +DONTGIB
  +DONTRIP
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NOICEDEATH
  +CANTSEEK
  +NOFEAR
  +NOTELEFRAG
  Species "Cybers"
  SeeSound "cyber/sight1"
  PainSound "Legcyber/pain"
  DeathSound "Legcyber/death"
  ActiveSound "Legcyber/laugh3"
  Obituary "$CFLegendaryCyberdemonObit"
  Tag "$CFLegCyb"
  var int user_music;
  var int user_loop;
  var int user_loop2;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    CYB2 A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	CYB2 AAZZ 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	CYB2 A 3 Bright A_Hoof
    CYB2 ABBCC 3 Bright A_Chase
    CYB2 D 3 Bright A_Metal
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,2)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	CYB2 A 3 Bright A_Hoof
    CYB2 ABBCC 3 Bright A_Chase
    CYB2 D 3 Bright A_Metal
    CYB2 D 3 Bright A_Chase
    TNT1 A 0 A_Jump(35,"Teleport")
	Loop
  Rush:
	TNT1 A 0 A_Hoof
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	CYB2 A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 B 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 C 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 C 2 Bright A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(25,"Teleport")
	TNT1 A 0 A_Jump(75,"See")		
	Loop	
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	CYB2 A 1 Bright A_UnSetShootable
	CYB2 AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE,SXF_NOCHECKPOSITION)
	CYB2 AAAAAAAAAA 1 A_FadeOut(0.1,0)
	CYB2 A 2
	CYB2 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    CYB2 A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	CYB2 AAAAAAAAAAAAA 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE,SXF_NOCHECKPOSITION)
	CYB2 AAAAAAAAAA 1 A_FadeIn(0.1)
    CYB2 A 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_JumpIfCloser(300,"LegendaryASG")
    TNT1 A 0 A_Jump(64,"Finder","LegBFG95K","LegendaryRailgun","LegendaryBFG10K","LegendaryStomp","LegendaryBFG15K","LegendaryDTBFG")
	TNT1 A 0 A_Jump(55,"LegendaryTech","LegendaryBFG","LegendaryDevastator")
	TNT1 A 0 A_Jump(45,"LegendaryCyberLaser")
	TNT1 A 0 A_Jump(50,"LegRevBall")
	TNT1 A 0 A_Jump(60,"RocketCombo")
	TNT1 A 0 A_Jump(40,"LegendaryPlasmaticBomb")
  Normal:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	CYB2 E 5 Bright A_FaceTarget
    CYB2 F 5 Bright A_CustomMissile("LegendaryRocket", 58, -26, frandom(-6, 6))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	//TNT1 A 0 A_Jump(256,"LegendaryASG")
    TNT1 A 0 A_Jump(64,"Finder","LegBFG95K","LegendaryRailgun","LegendaryBFG10K","LegendaryStomp","LegendaryBFG15K","LegendaryDTBFG")
	TNT1 A 0 A_Jump(55,"LegendaryTech","LegendaryBFG","LegendaryDevastator")
	TNT1 A 0 A_Jump(45,"LegendaryCyberLaser")
	TNT1 A 0 A_Jump(50,"LegRevBall")
	TNT1 A 0 A_Jump(60,"RocketCombo")
	TNT1 A 0 A_Jump(1,"LegendaryPlasmaticBomb")
	Goto See
  Pain:
    TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_Jump(45,"SoulsAndShield")
	TNT1 A 0 A_Jump(55,"Shield")
	TNT1 A 0 A_Jump(75,"Healing")
	TNT1 A 0 A_Jump(64,"PainMissile")
	TNT1 A 0 A_Jump(25,"Teleport")
    CYB2 G 10 Bright A_Pain
    Goto See
  Pain.DBFG10K2:
  Pain.PlayerDBFG10K2:
  Pain.DBFG2:
  Pain.PlayerDBFG2:
    TNT1 A 0 A_Jump(250, "Teleport")
	Goto PainMissile
  PainMissile:
    CYB2 G 10 Bright A_Pain
    Goto Missile
  Shield:
    TNT1 A 0 A_SetUserVar("user_effect_type",0)
	CYB2 G 10 Bright A_Pain
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  ShieldLoop:
    TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner",30,0,0 + user_loop*25)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner2",30,0,0 + user_loop*25,10,25)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner3",30,0,0 + user_loop*25,10,35)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner4",30,0,0 + user_loop*25,10,45)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner5",30,0,0 + user_loop*25,10,55)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,2)
	TNT1 A 0 A_Jump(256,"ShieldLoop")
	CYB2 G 145 Bright
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	Goto Missile
  SoulsAndShield:
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")	
	TNT1 A 0 A_SetUserVar("user_loop",0)
  SoulsAndShieldLoop:
    TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner",30,0,0 + user_loop*25)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner2",30,0,0 + user_loop*25,10,25)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner3",30,0,0 + user_loop*25,10,35)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner4",30,0,0 + user_loop*25,10,45)
	TNT1 A 0 A_CustomMissile("LegCyberShieldSpawner5",30,0,0 + user_loop*25,10,55)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 14,2)
	TNT1 A 0 A_Jump(256,"SoulsAndShieldLoop")
	TNT1 A 0 A_Blast(0,225,500,30)
	TNT1 A 0 A_Explode(120,650,0)
    CYB2 GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG 2 Bright A_CustomMissile("LegHomingSoulY",frandom(0,80),0,frandom(0,360),0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	Goto See
  Healing:
  	TNT1 A 0 A_PlaySoundEx("Legcyber/heal","HEAL")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",10)
	CYB2 G 2 Bright HealThing(400)
    CYB2 GGGGGGGGGGGGGGGGGGGGGGGG 2 Bright A_SpawnItemEx("DarkAnniFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")	
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	CYB2 G 2 Bright
    Goto See
  LegendaryASG:
	TNT1 A 0 A_JumpIfInventory ("ASGZAmmo", 16, "Reload")
	CYB2 E 4 Bright A_FaceTarget(45)
	TNT1 A 0 A_GiveInventory ("ASGZAmmo", 1)
	TNT1 A 0 A_SpawnItemEx("BlueShellCasing",26,26,58,frandom(2,6),0,frandom(1,3),frandom(80,90),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAA 0 Bright A_CustomMissile("LegendaryBlueTracer",58,-26,frandom(-6,6),0)
	CYB2 F 2 Bright A_CustomBulletAttack(8.0,3.0,6,frandom(40,60),"LegModdedBulletPuff",0,CBAF_NORANDOM)
	TNT1 A 0 A_PlaySoundEx("Weapons/LegAutoShotgun","Weapon")
	CYB2 E 2 Bright A_FaceTarget(45)
	TNT1 A 0 A_CPosRefire
	TNT1 A 0 A_JumpIfCloser(300,"LegendaryASG")
	TNT1 A 0 A_Jump(64,"Finder","LegendaryRailgun","LegendaryBFG10K","LegBFG95K","LegendaryBFG15K","LegendaryStomp","LegendaryDTBFG")
	TNT1 A 0 A_Jump(55,"LegendaryTech","LegendaryBFG","LegendaryDevastator")
	TNT1 A 0 A_Jump(52,"LegendaryCyberLaser")
	TNT1 A 0 A_Jump(50,"LegRevBall")
	TNT1 A 0 A_Jump(1,"LegendaryPlasmaticBomb")
	Goto See
  Reload:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_ChangeFlag("NoPain", 1)
    TNT1 A 0 A_PlaySound("lasgguy/asgout")
    CYB2 E 48 Bright A_TakeInventory ("ASGZAmmo", 16)
    CYB2 E 8 Bright A_PlaySound("lasgguy/asgin") 
	CYB2 E 20 Bright A_PlaySound("LShotgun/Cock")
    TNT1 A 0 A_ChangeFlag("NoPain", 0)
    Goto See
  LegendaryStomp:
	CYB2 G 10 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	LBE3 G 3 Bright A_PlaySoundEx("Legcyber/laugh4","LAUGH3")
	LBE3 GGGGGGGGGGGGGGGGGGGGGGGGGGGGG 3 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")					 
	CYB2 G 7 Bright A_FaceTarget
	LBE3 A 5 Bright A_FaceTarget
	TNT1 A 0 Radius_Quake(40,80,0,40,0)	
	LBE3 B 6 Bright A_PlaySound("monsters/darkcyberstomp")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryStompLoop:
    LBE3 B 0 A_CustomMissile("LegCyberQuake", 0, -48, user_loop*10)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"LegendaryStompLoop")
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,0,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,25,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-25,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,70,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-70,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,45,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-45,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,315,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-315,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,270,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-270,0)       
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,225,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-225,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,180,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-180,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,135,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-135,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,115,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-115,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,155,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-155,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-200,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,200,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-245,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,245,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-295,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,295,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-335,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,355,0)
    TNT1 A 0 A_CustomMissile("LegendaryCyberFireSpawner",0,0,90,0)
    LBE3 B 2 Bright A_CustomMissile("LegendaryCyberFireSpawner",0,0,-90,0)
	LBE3 B 20 Bright
	TNT1 A 0 A_Jump(64,"Finder","LegendaryTech","LegendaryBFG","LegendaryRailgun","LegendaryBFG10K","LegBFG95K","LegendaryBFG15K","LegendaryDTBFG")
	TNT1 A 0 A_Jump(52,"LegendaryCyberLaser")
	TNT1 A 0 A_Jump(50,"LegRevBall")
    Goto See
  LegendaryCyberLaser:
    CYB2 G 10 Bright A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_SpawnItemEx("LegendaryCyberFlameSpawner2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	CYB2 G 3 Bright A_PlaySoundEx("Legcyber/laugh4","LAUGH3")
	CYB2 GGGGGGGGGGGGGGGGGGGGGGGGGGGGG 3 Bright A_SpawnItemEx("LegendaryCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LegendaryCyberlaserLoop:
	LBBF A 10 Bright A_FaceTarget
	LBBF A 5 Bright A_FaceTarget
	LBBF A 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("RAGE", CHAN_VOICE|CHAN_NOPAUSE)
	LBBF B 10 Bright A_CustomMissile("LegCyberLaserBeam", 80, 0, 0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto LegendaryCyberlaserLoop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")					 
	LBBF A 5 Bright
	CYB2 G 5 Bright
	LBBF A 5 Bright
	CYB2 G 5 Bright
	Goto See
  LegBFG95K:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
    CYB2 EEF 10 Bright A_FaceTarget
	CYB2 F 10 Bright A_CustomMissile("LegCyberBFG9500Ball", 58, -26, 0)
	CYB2 E 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfgf")
    CYB2 EEF 10 Bright A_FaceTarget
	CYB2 F 10 Bright A_CustomMissile("LegCyberBFG9500Ball", 58, -26, 0)		
	CYB2 E 4 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfgf")
    CYB2 EEF 10 Bright A_FaceTarget
	CYB2 F 10 Bright A_CustomMissile("LegCyberBFG9500Ball", 58, -26, 0)		
	CYB2 E 10 Bright
	TNT1 A 0 A_Jump(64,"Finder","LegendaryTech","LegendaryBFG","LegendaryRailgun","LegendaryBFG10K","LegendaryBFG15K","LegendaryDTBFG","LegendaryDevastator")
	TNT1 A 0 A_Jump(52,"LegendaryCyberLaser")
	TNT1 A 0 A_Jump(50,"LegRevBall")
	TNT1 A 0 A_Jump(1,"LegendaryPlasmaticBomb")
	Goto See
  LegendaryRailgun:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    CYB2 EE 4 Bright A_FaceTarget
	CYB2 E 8 Bright A_FaceTarget
    CYB2 F 5 Bright A_CustomMissile("LegendaryCyberRail",58, -26)
	CYB2 EE 4 Bright A_FaceTarget
	CYB2 E 5 Bright A_FaceTarget
