Actor LegCybDevastatorBall
{
  Radius 16
  Height 16
  Damage (random(500,800)) //1050
  Speed 19
  Alpha 0.95
  Scale 0.7
  RenderStyle Translucent
  Species "Cybers"
  DamageType "Legendary"
  Alpha 0.85
  Projectile
  +FORCERADIUSDMG
  +FORCEXYBILLBOARD
  +EXTREMEDEATH
  +SKYEXPLODE
  +MTHRUSPECIES
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  var int user_loop;
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
    LGS2 A 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 AAA 0 A_CustomMissile("LegCybLiteShot",0,0,Random(0,360))
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	LGS2 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	LGS2 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 CCC 0 Bright A_CustomMissile("LegCybLiteShot",0,0,frandom(0,360))
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_CustomMissile("LegDevastatorTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	LGS2 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    Loop
  DTBFGSFX:
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("devastator/fly","Voice",1)
	TNT1 A 0 A_Explode(32,128,0)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
    LGS2 A 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 A 1 Bright A_CustomMissile("LegCybDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(32,128,0)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
    LGS2 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 A 1 Bright A_CustomMissile("LegCybDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(32,128,0)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
    LGS2 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 A 1 Bright A_CustomMissile("LegCybDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(32,128,0)
	TNT1 A 0 A_CustomMissile("LegCybDevastatorBolt",6,0,frandom(0,359),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGold2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LegDevastatorTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
    LGS2 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleGold",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	LGS2 A 1 Bright A_CustomMissile("LegCybDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
    Goto Spawn
  Death:
    TNT1 A 0
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("LegAnniDTBFGTracer",0,0,user_loop * 10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningGoldSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop2:
	TNT1 A 0 A_Explode(80,256)
	LGS2 A 6 Bright A_SpawnItemEx("LegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	LGS2 B 6 Bright A_SpawnItemEx("LegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	LGS2 C 6 Bright A_SpawnItemEx("LegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	LGS2 D 6 Bright A_SpawnItemEx("LegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Goto DeathLoop2
	TNT1 A 0 A_Explode(128,1024,0)
	TNT1 A 0 A_Explode(460,512,0)
	TNT1 A 0 A_Explode(618,256,0)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("LegDevastatorShockWave2",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItem("LegAnniDTBFGEx",0,-10)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	LGE1 D 0 A_CustomMissile("LegCybDevastatorBall2",0,0,user_loop * 18,2)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	LGE1 AAAAAABBBBBBCCCCCCDDDDDD 1 A_CustomMissile("LegKaboomDevastator22",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    LGE1 EF 6 Bright
    Stop    
  }
}

