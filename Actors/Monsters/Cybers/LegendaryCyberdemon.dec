    CYB2 G 3 Bright A_PlaySoundEx("Legcyber/laugh5","TBCSPT2")
	CYB2 GGGGGGGGGGGGGGGGGGG 3 Bright A_FaceTarget
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")	
	CYB2 E 10 Bright A_FaceTarget
	CYB2 F 0 A_PlayWeaponSound("lrball3/shot")
    CYB2 F 5 Bright A_CustomMissile("LegRevBall3", 58, -26)
	CYB2 E 10 Bright A_FaceTarget
	CYB2 F 0 A_PlayWeaponSound("lrball3/shot")
    CYB2 F 5 Bright A_CustomMissile("LegRevBall3", 58, -26)
	CYB2 E 10 Bright A_FaceTarget
	CYB2 F 0 A_PlayWeaponSound("lrball3/shot")
    CYB2 F 5 Bright A_CustomMissile("LegRevBall3", 58, -26)
	CYB2 E 20 Bright A_FaceTarget
	Goto See
  LegendaryPlasmaticBomb:
    TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierI",1) // A_SetInvulnerable
	TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",6)
	TNT1 A 0 A_PlaySoundEx("monster/laugh","TBBCSPT1")
    TNT1 A 0 A_PlaySound("Arcradimus/BFGCharge")
    CYB2 E 0 A_SpawnItemEx("LegendaryBombCharging1", 70, 0, 58)
	CYB2 EEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
	CYB2 E 0 A_SpawnItemEx("LegendaryBombCharging2", 70, 0, 58)
	CYB2 EEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
	CYB2 E 0 A_SpawnItemEx("LegendaryBombCharging3", 70, 0, 58)
	TNTT A 0 A_PlaySoundEx("Legcyber/laugh2","LAUGH2")
	CYB2 EEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
	CYB2 E 0 A_SpawnItemEx("LegendaryBombCharging4", 70, 0, 58)
	CYB2 EEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
	CYB2 E 0 A_SpawnItemEx("LegendaryBombCharging5", 70, 0, 58)
	CYB2 EEEEEEEEEEEEEEEEE 4 Bright A_FaceTarget
    CYB2 EF 4 Bright A_FaceTarget 
	TNT1 A 0 A_CustomMissile("LegendaryBomb",58,-26,0,0)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")
	CYB2 E 100 Bright 
	Goto See
  Death:
	TNT1 A 0 A_StopSound(6)
	CYB2 H 10 Bright
	CYB2 H 10 Bright A_Scream
	CYB2 H 132 Bright A_SpawnItemEx("LegendaryCyberdemonDeathEffect",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	CYB2 I 56 Bright
	CYB2 J 42 Bright
	CYB2 KL 10 Bright
	TNT1 A 0 A_CheckFlag("FRIENDLY","Death2")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckSpawnScore") < 160,"Death2")
	TNT1 A 0 A_Jump(64,"LegDeath") //32
	TNT1 A 0 A_Jump(52,"LegDeath2")
  Death2:
	TNT1 A 0 A_SpawnItemEx("DeathBall2")
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 A_DropItem("LegendaryDust",random(5,10),256)
	//TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,25)
	CYB2 M 10 Bright A_NoBlocking
	CYB2 NO 10 Bright
	CYB2 P 30
	CYB2 P -1
	Stop	
  LegDeath:
	TNT1 A 0 ACS_NamedExecuteAlways("IntermissionMusic")
	TNT1 A 0 A_SpawnItemEx("TrueDeathBall")
	CYB2 M 10 Bright A_NoBlocking
	CYB2 NO 10 Bright
	CYB2 P 200 
	TNT1 A 0 ACS_NamedExecuteAlways("SetTLCSky",0)
	CYB2 P 30 A_CustomMissile("TrueLegPentagram")
	TNT1 A 0 A_SpawnItemEx("DingySummoner")
	TNT1 A 0 A_SpawnItemEx("LegendaryRevivalSummoner")
	TNT1 A 0 A_SpawnItemEx("ResurrectorSummoner",0,0,0,30,0,0,72,0)
	TNT1 A 0 A_SpawnItemEx("ResurrectorSummoner",0,0,0,30,0,0,-72,0)
	TNT1 A 0 A_SpawnItemEx("ResurrectorSummoner",0,0,0,30,0,0,-222,0)
	TNT1 A 0 A_SpawnItemEx("ResurrectorSummoner",0,0,0,30,0,0,222,0)
	TNT1 A 0 A_SpawnItemEx("ResurrectorSummoner",0,0,0,30,0,0,365,0)
	Stop
  LegDeath2:
    TNT1 A 0 ACS_NamedExecuteAlways("IntermissionMusic")
	TNT1 A 0 A_SpawnItemEx("TrueDeathBall")
