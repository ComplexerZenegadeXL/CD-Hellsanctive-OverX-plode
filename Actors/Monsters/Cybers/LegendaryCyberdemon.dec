Actor LegendaryCyberdemon : Cyberdemon 16515
{
  //$Category Monsters/LCA
  //$Sprite CYBRA1
  //$Title "Legendary Cyberdemon"
  Health 6999
  Radius 40
  Height 110
  Scale 1.1
  Mass 0x7FFFFFFF
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
