Actor LegendaryHomingRocket : CardinalHomingRocket
{
  Radius 12
  Height 10
  Scale 1.1
  Decal "LegRocketScorch"
  Damage (Random(30,60))
  Speed 24
  FastSpeed 28
  Species "Cybers"
  DamageType "Legendary"
  SeeSound "monster/homingrockfire"
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    Loop	
  Homing:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	Goto StartSeek
  StartSeek:
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    LCKM A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))		
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(60,128)
    TNT1 A 1 A_SpawnItemEx("LegendaryBlueRocketEx",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Stop
  }
}

