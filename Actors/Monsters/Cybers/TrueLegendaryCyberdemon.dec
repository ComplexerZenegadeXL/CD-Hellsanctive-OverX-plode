	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("HomingTrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 16,1)
