	TNT1 A 0 A_SpawnItem("TLegCybDTBFGEx",0,-10)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop3:
	TNT1 A 0 A_CustomMissile("TrueLegCybDevastatorBall2",0,0,user_loop * 18,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop3")
	TRD5 AAAAAABBBBBBCCCCCCDDDDDD 1 A_CustomMissile("TrueLegKaboomDevastator22",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TRD5 EF 6 Bright
    Stop    
  }
}

