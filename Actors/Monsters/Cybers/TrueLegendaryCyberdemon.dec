Actor ExileMinion : Exile
{
  Species "Cybers"
  DamageFactor "Cyber10K", 0.0
  DamageFactor "UltimateLegendary", 0.0
  DamageFactor "Baby15K", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "BombBreath", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CacoComet", 0.0
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "BeheComet", 0.0
  DamageFactor "NobleComet", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "LegMind", 0.0
  DamageFactor "DemolisherEx", 0.0
  DamageFactor "DarkDemoEx", 0.0
  DamageFactor "CerChainguns", 0.0	
  DamageFactor "CerEnergyBall", 0.0
  +DONTHURTSPECIES
  +NOTIMEFREEZE
  +THRUSPECIES
  +NOTELEFRAG
  -COUNTKILL
  States
  {
  Spawn:
    VILE A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_Jump(64,"Rush")
    VILE A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
    VILE AABBCC 2 A_VileChase
    VILE D 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
    VILE DDEEFF 2 A_VileChase
    Loop
  Rush:
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
	VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE A 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE B 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE C 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE D 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE E 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE F 1 A_VileChase
    TNT1 A 0 A_SpawnItemEx("ExileFX",0,0)
    VILE F 1 A_VileChase
    TNT1 A 0 A_Jump(182,"See")
	Loop
  Missile:
    TNT1 A 0 Bright A_FaceTarget
    VILE G 10 Bright A_PlaySound("exile/voidstart")
    VILE H 8 Bright A_VileTarget
    VILE IJKLMN 8 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("exile/voidend")
    VILE O 8 Bright A_VileAttack
    VILE P 20 Bright
    Goto See	
  Heal:
    VILE "[\]" 10 Bright
    Goto See
  Pain:
    VILE Q 10 A_Pain
    Goto See
  Death:
    VILE Q 6
    VILE R 5 A_Scream
    VILE S 5 A_Fall
    VILE TUV 5
	VILE W 4 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    VILE XY 4
    VILE Z -1
    Stop
  XDeath:
	VILX A 4
	VILX B 3 A_XScream
	VILX C 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VILX D 3 A_Fall
	VILX E 3 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	VILX FG 3
	VILX H -1
	Stop
  }
}

