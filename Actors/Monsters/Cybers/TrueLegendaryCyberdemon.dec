    LULZ AAAAAAAAAAAAAAAAAAAAA 2 Bright A_SpawnItemEx("LegCybThorStrikeSpawner",frandom(-1650,1650),frandom(-1650,1650),0,0,0,0,SXF_NOCHECKPOSITION,64)
    TNT1 A 1 A_Die
    Goto Death
  Death:
    TNT1 A 0 A_StopSound(6)
    LULZ A 1 A_Stop
    Stop
  }
}

