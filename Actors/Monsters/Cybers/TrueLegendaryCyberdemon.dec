  Species "Cybers"
  SeeSound "tlcyb/sight"
  PainSound "Legcyber/pain"
  DeathSound "tlcyb/death"
  ActiveSound "tlcyb/laugh1"
  Obituary "$CFTrueLegendaryCyberdemonObit"
  Tag "$CFTlegCyb"
  var int user_LegendaryPortal;
  var int user_music;
  var int user_leapdelay;
  var int user_loop;
  var int user_loop2;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  States
  {
  Spawn:
    TLCD A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,3)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TLCD AAZZ 10 Bright A_Look
    Loop
  See:
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,16)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",19)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_Jump(100,"Rush")
	TNT1 A 0 A_UnsetInvulnerable
	TLCD A 3 Bright A_Hoof
    TLCD ABBCC 3 Bright A_Chase
    TLCD D 3 Bright A_Metal
    TLCD D 3 Bright A_Chase
    TNT1 A 0 A_Jump(50,"Teleport")
    TNT1 A 0 A_JumpIfCloser(1024, "See")
    //TNT1 A 0 A_Jump(32,"Leap")
    Loop
  Leap:
	LBE4 A 5 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_leapdelay",0)
	//TNT1 A 0 ThrustThing(angle*256/360, 20, 0, 0)
	TNT1 A 0 ThrustThingZ(0,random(30,35),0,1)
	TNT1 A 0 A_PlaySound("Legcyber/pain6")
	LBE4 AAAA 5 Bright A_Recoil(-10)
  LeapCheck:
	TNT1 A 0 A_JumpIf(user_leapdelay >= 105,"LeapLand")
	TNT1 A 0 A_SetUserVar("user_leapdelay",user_leapdelay+1)
	//TNT1 A 0 A_Explode(8,256)
	LBE4 A 1 Bright A_CheckFloor("LeapLand")
	Loop
  LeapLand:	
    TNT1 A 0 A_Explode(Random(10000,15000),512)
	TNT1 A 0 A_SpawnItem("LegendaryNuke")
	TNT1 A 0 A_SpawnItemEx("TLCFlyLandShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",frandom(-32, 32),frandom(-32, 32),0,0,0,0,0,SXF_CLIENTSIDE)  
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAA 0 A_CustomMissile("BlueKaboom",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	//TNT1 A 0 A_CustomMissile("LCAExplosionBundle",0,0,frandom(80,100),CMF_AIMDIRECTION,frandom(80,100))
	TNT1 A 0 Radius_Quake(175,8,512,1024,0)
	TNT1 A 0 A_SpawnItemEx("TLCFlyLandKaBoom")
	LBE4 B 6 Bright A_PlaySound("monsters/darkcyberstomp")
	LBE4 B 420 Bright
	Goto See
  Rush:
    TNT1 A 0 A_Hoof
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD A 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD B 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD C 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD C 2 Bright A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TLCD D 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("TLegendaryCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(25,"Teleport")
	TNT1 A 0 A_Jump(75,"See")		
	Loop	
  Teleport:
    TLCD A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TLCD AAAAAAAAAAAAA 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TLCD A 2
	TLCD AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    TLCD A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	TLCD AAAAAAAAAAAAA 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TLCD AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TLCD A 1 Bright A_SetShootable
    Goto See		
  Missile:
    TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance")							
    TNT1 A 0 A_FadeIn(1.0)
	TNT1 A 0 A_CheckFlag("FRIENDLY",3)
	TNT1 A 0 A_JumpIf(user_LegendaryPortal == 1,2)
    TNT1 A 0 A_JumpIfHealthLower(4499,"LegendaryPortal")
	TNT1 A 0 A_JumpIfCloser(200,"Pain.Fists")
    TNT1 A 0 A_JumpIfCloser(300,"TrueLegendaryStomp")
	TNT1 A 0 A_JumpIfCloser(350,"Leap")
    //TNT1 A 0 A_Jump(256,"TrueLegendarySoulCombo")
	TNT1 A 0 A_Jump(130,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","Homing","StompingBarrage","LegRevBalls","LegCybComets","TrueLegPlasmaBalls","HomingTrueLegPlasmaBalls")
	TNT1 A 0 A_Jump(72,"TrueLegendaryLostSouls","TrueLegendarySoulCombo","LegendaryTech","LegendaryThunder","LegThor","TrueLegendaryBFG","TrueBFGCombo","TrueLegendaryDevastator","SpikyStomp")
	TNT1 A 0 A_Jump(32,"TrueLegendaryLaserBeam")
	TNT1 A 0 A_Jump(20,"SuperLegendaryPlasmaticBomb")
	TNT1 A 0 A_Jump(18,"LegendaryDevastation")
	TNT1 A 0 A_Jump(16,"LegendaryRage")
	//TNT1 A 0 A_Jump(256,"LegendaryDevastation")
  Normal:
    TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
	TLCD E 3  Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryRocket", 58, -26, frandom(-2, 3))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Goto  NormalLoop
	TNT1 A 0 A_Jump(128,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","Homing","LegRevBalls","LegCybComets","TrueLegPlasmaBalls","HomingTrueLegPlasmaBalls")
	Goto See
  Homing:
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegendaryHomingRocket", 58, -26, frandom(-2, 3))
	TNT1 A 0 A_Jump(128,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","StompingBarrage","LegRevBalls","LegCybComets","TrueLegPlasmaBalls","HomingTrueLegPlasmaBalls")
	Goto See  
  LegCybComets:
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3  Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
    TLCD E 3 Bright A_FaceTarget
    TLCD F 3 Bright A_CustomMissile("LegCybComet", 58, -26)
    TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("LegCybComet", 58, -26)
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("LegCybComet", 58, -26,frandom(-4, 4))
	TNT1 A 0 A_Jump(128,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","StompingBarrage","LegRevBalls","TrueLegPlasmaBalls","HomingTrueLegPlasmaBalls")
	Goto See
  TrueLegPlasmaBalls:
    //TNT1 A 0 A_Changeflag(reflective,1)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  TrueLegPlasmaBallsLoop:
	TLCD E 3 Bright A_FaceTarget
    TLCD F 4 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 16,1)
	Goto TrueLegPlasmaBallsLoop
    TLCD E 6 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 2 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	TLCD E 3 Bright A_FaceTarget
    TLCD F 1 Bright A_CustomMissile("TrueLegendaryPlasmaBall", 58, -26,frandom(-4, 4))
	//TNT1 A 0 A_Changeflag(reflective,0)
	TNT1 A 0 A_Jump(128,"TrueLegendaryBFG10K","TrueLegendaryRailgun","LegendaryStar","StompingBarrage","LegRevBalls","HomingTrueLegPlasmaBalls")
	Goto See
