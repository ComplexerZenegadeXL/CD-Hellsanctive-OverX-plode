  DropItem "LegendaryInvisibilitySphere" 64
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  +NORADIUSDMG
  +MISSILEEVENMORE
  +NOTARGET
  +BOSS
  +REFLECTIVE
  +MISSILEMORE
  +FIRERESIST
  +FLOORCLIP
  +DONTMORPH
