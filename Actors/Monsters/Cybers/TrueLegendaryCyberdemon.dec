Actor FakeLegCyberRailgun : FakeLegCyber10K
{
  States
  {
  Spawn:
    TLCD E 1 Bright A_Look
    TLCD E 1 Bright A_PlayWeaponSound("boss/teleport")
	TLCD EE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Loop
  See:
    //TNT1 A 0 A_JumpIfInTargetLOS(1, 0, JLOSF_DEADNOJUMP, 0)
    TNT1 A 0 A_Jump(256,"Missile")
    TLCD AB 2 Bright A_Chase
    Loop	
  Missile:
    TNT1 A 0 A_PlaySound("weapons/rgcharge")
    TLCD EE 4 Bright A_FaceTarget
    TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 8 Bright A_FaceTarget
    TLCD F 9 Bright A_CustomMissile("TrueLegendaryCyberRail",58,-26)
	TLCD E 0 Bright A_FaceTarget
	Goto Death
  Death:
    TLCD E 1 Bright A_Stop
    TLCD E 1 Bright A_PlayWeaponSound("boss/teleport")
	TLCD EE 0 A_SpawnItemEx("TrueLegendaryLineSpawner",3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TLCD E 1 Bright A_FadeIn(0.1)
	Stop
  }
}

