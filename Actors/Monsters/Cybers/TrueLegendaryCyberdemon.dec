Actor TrueSmartFire : TrueFireSpawner
{
  Obituary "$CFTrueSmartFireObit"
  DamageType "Legendary"
  var int user_delay;
  Speed 10
  +NOCLIP
  +FORCERADIUSDMG
  YScale 1.8
  XScale 1.9
  States
  {
  Spawn:
    TFIR A 2 Bright
	TNT1 A 0 A_JumpIf(user_delay >= 60,"Death")
	TNT1 A 0 A_SetUserVar("user_delay",user_delay+1)
	TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Wander
    TFIR B 2 Bright A_Explode(Random(8,24),192)
	TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Wander
    TFIR C 2 Bright A_Explode(Random(8,24),192)
	TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Wander
    TFIR D 2 Bright A_Explode(Random(8,24),192)
	TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TFIR C 0 A_FireCrackle
	TNT1 A 0 A_Wander
    TFIR C 2 Bright A_Explode(Random(8,24),192)	
	TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Wander
    TFIR B 2 Bright A_Explode(Random(8,24),192)	
    Goto Spawn+1
  Death:
    TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TFIR E 2 Bright A_Explode(Random(8,24),128)	
    TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TFIR F 2 Bright A_Explode(Random(8,24),128)	
    TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TFIR G 2 Bright A_Explode(Random(8,24),128)	
    TNT1 A 0 A_SpawnItemEx("LVileFireSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TFIR H 2 Bright A_Explode(Random(8,24),128)		
    Stop
  }
}

