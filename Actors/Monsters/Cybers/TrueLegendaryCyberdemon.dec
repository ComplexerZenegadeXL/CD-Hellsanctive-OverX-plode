Actor TLegCybDTBFGBall : LegAnniDTBFGBall
{
  Damage (Random(500,600)) //180
  Speed 30
  Decal "BFG9500LightningBlue"
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"DTBFGSFX")
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
    TLS1 ABCD 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("TLegAnniDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Loop
  DTBFGSFX:
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_PlaySoundEx("weapons/dtech10kball","Voice",1)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TLS1 A 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TLS1 B 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TLS1 C 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(16,8),0,0,0,0,SXF_CLIENTSIDE)
    TLS1 D 1 Bright A_SpawnItemEx("BFGTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(12,22),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
    TNT1 A 0 A_SpawnItemEx("TLegAnniDTBFGTracerAttack",0,0,0,0,0,0,0,SXF_SETMASTER)
    Goto Spawn   
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(5,60,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 Bright A_CustomMissile("TLegCybDTBFGTracer",0,0,user_loop*10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlueSpawner", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)	
	TLS1 ABCD 6 Bright A_SpawnItemEx("DTech10KShockwaveBlue", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(480,240)
	TNT1 A 0 A_StopSoundEx("Voice")
	TNT1 A 0 Radius_Quake(15,20,0,20,0)
	TNT1 A 0 A_PlaySound("weapons/dtech10kexplode")
	TNT1 A 0 A_SpawnItemEx("DTech10KShockwaveBlue1", 0, 0, 15, 0, 0, 0, 0, SXF_CLIENTSIDE)
    TNT1 A 20 Bright A_SpawnItem("TLegCybDTBFGEx",0,-10)
    Stop    
  }
}

