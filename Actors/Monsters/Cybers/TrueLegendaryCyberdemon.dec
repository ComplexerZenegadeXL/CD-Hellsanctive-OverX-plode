	TNT1 A 0 A_Explode(80,256)
	TRD5 B 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(80,256)
	TRD5 C 6 Bright A_SpawnItemEx("TrueLegDevastatorShockWave",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
