	TRD5 A 1 Bright A_CustomMissile("CardinalDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("TrueLegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
    TRD5 B 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TRD5 A 1 Bright A_CustomMissile("CardinalDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0)
	TNT1 A 0 A_CustomMissile("TrueLegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
    TRD5 C 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TRD5 A 1 Bright A_CustomMissile("CardinalDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_CustomMissile("TrueLegCybDevastatorBolt",6,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,random(-40,40))
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlue2",frandom(-6,6),frandom(-6,6),frandom(-6,6),0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("TrueLegDevastatorTrail",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
    TRD5 D 1 Bright A_SpawnItemEx("ProjectileTrailParticleBlue",frandom(-12,12),frandom(-12,12),frandom(-12,12),frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(-20,20),SXF_CLIENTSIDE)
	TRD5 A 1 Bright A_CustomMissile("CardinalDTBFGTracerAttack",frandom(-10,10),0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_Explode(64,450,0)
    Goto Spawn
  Death:
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 Radius_Quake(3,35,0,10,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	TNT1 A 0 A_CustomMissile("TLegCybDTBFGTracer",0,0,user_loop*10,CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 36,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	TNT1 A 0 A_SpawnItemEx("DTBFGLightningBlueSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
	TNT1 A 0 A_SetUserVar("user_loop",0)
