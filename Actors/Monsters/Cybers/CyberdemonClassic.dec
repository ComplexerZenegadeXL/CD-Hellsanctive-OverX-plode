Actor Cyberdemon2 : CFAnnihilator
{
  //$Category Monsters/CF
  //$Sprite CYBRA1
  //$Title "Cyberdemon"
  Monster
  Health 4000
  Height 110
  Radius 40
  Mass 1000
  Speed 16
  PainChance 20
  MinMissileChance 160
  +BOSS
  +BOSSDEATH
  +FLOORCLIP
  +MISSILEMORE
  +DONTMORPH
  +NORADIUSDMG
  +DONTHARMSPECIES
  Species "Cybers"
  DropItem "BossLifeEssence", 128
  DropItem "BossArmorBonusMax", 128
  DropItem "RocketLauncherGiver", 128
  DropItem "MissilePickup" 128, 15
  DamageFactor "Cyber10K", 0.0
  DamageFactor "PDTBFG", 0.5
  DamageFactor "PDTBFGTracer", 0.8
  SeeSound "cyber/sight"
  PainSound "cyber/pain"
  DeathSound "cyber/death"
  ActiveSound "cyber/active"
  Obituary "$OB_CYBORG"
  Tag  "$CFCyb"
  States
  {
  Spawn:
	CYBR A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	CYBR A 10 A_Look
	Loop
  See:
	CYBR A 3 A_Hoof
	CYBR ABBCC 3 A_Chase
	CYBR D 3 A_Metal
	CYBR D 3 A_Chase
	Loop
  Missile:
	CYBR E 6 A_FaceTarget
	CYBR F 12 A_CustomMissile("CyberLordRocket",40,-26,0)
	CYBR E 12 A_FaceTarget
	CYBR F 12 A_CustomMissile("CyberLordRocket",40,-26,0)
	CYBR E 12 A_FaceTarget
	CYBR F 12 A_CustomMissile("CyberLordRocket",40,-26,0)
	Goto See
  Pain:
	CYBR G 10 A_Pain
	Goto See
  Death.PlayerIce:
	"####" "#" 5 A_GenericFreezeDeath
	"----" A 1 A_FreezeDeathChunks
	Wait
  Death:
	CYBR H 10
	CYBR I 10 A_Scream
	CYBR JKL 10
	CYBR M 10 A_NoBlocking
	CYBR NO 10
	CYBR P 30
	TNT1 A 0 A_BossDeath
	TNT1 A 0 A_KillMaster
	CYBR P -1
	Stop
  Crush:
	TNT1 A 0 A_PlaySound("gib/squish")
	BOCR A -1
	Stop
  }
}