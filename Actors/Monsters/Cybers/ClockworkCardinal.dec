Actor ClockworkCardinal : ClockworkCyberdemon
{ 
  Health 8000
  Speed 24
  Scale 1
  Mass 2500
  DropItem "BossLifeEssence" 200 25
  DropItem "BossArmorBonusMax" 200 1
  DropItem "NewCellPackPickup" 186 300
  DropItem "BFG10KGiver" 178 1
  DropItem "RailgunGiver" 184 1
  //SeeSound "Clockwork/Sight"
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FLOAT
  +NOGRAVITY	
  -FLOORCLIP
  +BRIGHT
  Obituary "$CFClockworkCardinalObit"
  Tag "$CFClockCar"
  var int user_script;
  var int user_script_type;
  States 
  { 
  Spawn:
	C4RD A 0
	TNT1 A 0 A_JumpIf(user_script == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,25)
	TNT1 A 0 A_SetUserVar("user_script",1)
	TNT1 A 0 A_SetUserVar("user_script_type",24)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	C4RD AB 4 A_Look
	Loop
  See:
	TNT1 A 0 A_SpawnItemEx("insanecardghost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	C4RD A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("insanecardghost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	C4RD B 2 A_Chase
	Loop
  Missile:
	TNT1 A 0 A_Jump(128,"RailgunCharge","Crockets")
	TNT1 A 0 A_Jump(100,"HCrockets")
	TNT1 A 0 A_Jump(90,"9k","10k")
	TNT1 A 0 A_Jump(50,"DTBFG")
	TNT1 A 0 A_Jump(40,"DEVA")
  ERotaryShotgun:	
	C4RD CC 5 A_FaceTarget
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
	TNT1 AAAA 0 A_CustomMissile("TerminatorExplosiveTracer",50,-25,frandom(-3.5,3.5),CMF_OFFSETPITCH,frandom(-1.5,1.5))
	C4RD D 2 A_SpawnItemEx("OrangeShellCasing",0,12,36,frandom(2,6),0,frandom(1,3),frandom(-90,-80),SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(18,"See")
	TNT1 A 0 A_SpidRefire	
	Goto ERotaryShotgun+3
  Crockets:
	C4RD CC 5 A_FaceTarget
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	TNT1 A 0 A_Jump(50,"See")
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("CyberInfernalRocket",50,-25,frandom(-6,6))
	C4RD C 12
	TNT1 A 0 A_Jump(100,"HCrockets","railguncharge")
	TNT1 A 0 A_Jump(50,"10k","9k")
	TNT1 A 0 A_Jump(20,"DTBFG")
	Goto See
  HCrockets:
	C4RD CC 5 A_FaceTarget
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	TNT1 A 0 A_Jump(50,"See")
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 6 A_FaceTarget
	C4RD D 4 A_CustomMissile("ClockworkCardinalFuelRocket",50,-25,frandom(-6,6))
	C4RD C 12
	TNT1 A 0 A_Jump(100,"RailgunCharge")
	TNT1 A 0 A_Jump(50,"10k","9k")
	TNT1 A 0 A_Jump(20,"DTBFG")
	Goto See
  DTBFG:
	TNT1 A 0 A_PlaySound("Cardinal/9k") 
	C4RD CCCCCCCCDDD 4 A_FaceTarget
	C4RD D 4 A_CustomMissile("CardinalDTBFG10KBall",50,-25)
	C4RD DCC 4
	TNT1 A 0 A_Jump(50,"DEVA")
	Goto See
  DEVA:
	TNT1 A 0 A_PlaySound("devastator/charge") 
	C4RD CCCCCCCCCCCCCCCCCC 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("devastator/fire")
	C4RD D 4 A_CustomMissile("FusionDevastatorBall",50,-25,0)
	C4RD DDCC 4
	Goto See
  9k:
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	C4RD CCCCCCC 4 A_FaceTarget
	C4RD D 3 A_CustomMissile("CardinalBFG9500Ball", 50, -25, frandom(-1,1)) 
	C4RD CCCC 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfgf")
	C4RD CCCCCCC 4 A_FaceTarget
	C4RD D 3 A_CustomMissile("CardinalBFG9500Ball", 50, -25, frandom(-1,1))
	C4RD CCC 12
	TNT1 A 0 A_Jump(80,"DTBFG")
	TNT1 A 0 A_Jump(30,"DEVA")
	Goto See
   10k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	C4RD CCCCC 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  10kLoop:
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	C4RD D 3 A_CustomMissile("Cardinal10K", 50, -25, frandom(4, -4))
	C4RD C 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 7,1)
	Loop	
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",0)
	TNT1 A 0 A_Jump(80,"9k")
	TNT1 A 0 A_Jump(15,"DTBFG","DEVA")
	Goto See
  RailgunCharge:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	C4RD CCCCC 5 A_FaceTarget
	TNT1 A 0 A_Jump(120,"Lasers")
	TNT1 A 0 A_Jump(80,"MoreRailguns","Erailgun")
	TNT1 A 0 A_Jump(50,"MoreErailguns")
	TNT1 A 0 A_Jump(30,"RailgunBarrage")
  Railgun:
	C4RD C 10
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 10
	Goto See
  MoreRailguns:
	C4RD C 10
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 8 A_FaceTarget
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 8 A_FaceTarget
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 12
	Goto See
  Lasers:
	C4RD C 10
	TNT1 A 0 A_SetUserVar("user_loop",0)
  10kLoop:
	C4RD D 8 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	C4RD CC 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Loop
	C4RD D 8 A_CustomMissile("CWClaser",50,-25,frandom(-2,2))
	C4RD C 12
	Goto See
  ERailgun:
	C4RD C 10
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
	TNT1 A 0 A_CustomMissile("CyberExplosiveRailgunImpact",50,-25)
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 12
	Goto See
	MoreERailguns:
	C4RD C 10
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
	TNT1 A 0 A_CustomMissile("CyberExplosiveRailgunImpact",50,-25)
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 8 A_FaceTarget
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
	TNT1 A 0 A_CustomMissile("CyberExplosiveRailgunImpact",50,-25)
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 12
	Goto See
  RailgunBarrage:
	C4RD C 10
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
	TNT1 A 0 A_CustomMissile("CyberExplosiveRailgunImpact",50,-25)
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 8 A_FaceTarget
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 8 A_FaceTarget
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 4 A_FaceTarget
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("ExplosiveRailgun/Fire")
	TNT1 A 0 A_CustomMissile("CyberExplosiveRailgunImpact",50,-25)
	C4RD D 8 A_CustomMissile("CardinalRail",50,-25)
	C4RD C 12
	Goto See
  Death:
	C4RD E 10 A_Scream
	C4RD F 10 A_NoBlocking
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	C4RD GGGGGHHHHHIIIII 2 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(20,-20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	C4RD JJJJJKKKKK 1 Bright A_CustomMissile("CFKaboom", frandom(20,80), frandom(20,-20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(20,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	C4RD L 5
	Stop
  } 
}

Actor CyberExplosiveRailgunImpact : ExplosiveRailgunImpact { MissileType "CyberExplosiveRailgunTrailExplodeSpawner" }

Actor CyberExplosiveRailgunTrailExplodeSpawner
{
  States
  {
  Spawn:
	TNT1 A 1 Nodelay A_SpawnItemEx("CyberExplosiveRailgunTrailExplode",random(0,4),0,0,random(0,4),0,random(-4,4),random(0,360))
	Stop
  }
}

Actor ClockworkCardinalFuelRocket : FuelRocket { -PIERCEARMOR } //I shouldn't need to remove a fucking pierce armor flag from a rocket

Actor ClockworkCardinalFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("monster/ambientfire3")
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("ClockworkCardinalFireEx",random(8,-8),random(4,-4),random(70,80),0,0,random(-4,-6),0,128,0)	
	TNT1 AAAA 0 A_SpawnItemEx("ClockworkCardinalFire",random(18,-18),random(14,-14),random(70,80),0,0,random(-6,-8),0,128,0)
	TNT1 A 1
	Stop
  }
}

Actor ClockworkCardinalFireEx : Kaboom6
{
  Speed 0
  Scale 0.85
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	FXPR AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor ClockworkCardinalFire : CardinalFire
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	2HD2 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor InsaneCardGhost
{
  Scale 1
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
	C4RD A 2 A_FadeOut(0.18)
	Loop
  }
}