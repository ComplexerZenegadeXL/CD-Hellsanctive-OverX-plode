Actor PhaseCyberdemon : DarkCyberdemon 17578
{
  //$Category Monsters/CF
  //$Sprite PSCPA1
  //$Title "Phase Cyberdemon"
  Health 7000 //6000
  Speed 18
  DamageFactor "Acid", 0.2
  DamageFactor "Fire", 0.2
  DamageFactor "Electric", 0.2
  DamageFactor "Disintegrate", 0.001
  DamageFactor "BFG9500Ball", 0.5
  DamageFactor "BFGSplash", 0.5
  DamageFactor "Poison", 0.3
  DamageFactor "PlayerPoison", 0.3
  DamageFactor "PoisonCloud", 0.3
  DamageFactor "Explosion", 0.75
  DamageFactor "Mine", 0.5
  DamageFactor "Extreme", 0.0
  DamageFactor "Player", 0.1
  DamageFactor "PDTPuff", 0.0
  DamageFactor "PyroShot", 0.0
  DamageFactor "PlayerPyro", 0.2
  DamageFactor "PDTBFG", 0.2
  DamageFactor "PDTBFGTracer", 0.2
  DamageFactor "Players", 0.1
  DamageFactor "PlayerDevBall", 0.2
  DamageFactor "PlayerDevBall2", 0.2
  DamageFactor "PlayerDevTracer", 0.1
  DamageFactor "PlayerBHole", 0.2
  DamageFactor "DBFG2", 0.0
  DamageFactor "DBFG10K2", 0.0
  DamageFactor "DBFGSplash2", 0.0
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "Legendary", 0.0
  DamageFactor "LegendaryPlayer", 0.50
  DamageFactor "PlayerLegendary", 0.50
  DamageFactor "PlayerHellfire", 0.1
  DamageFactor "SuperWeapon", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.15
  DamageFactor "Ice", 0.4
  DamageFactor "PlayerIce", 0.4
  DamageFactor "DTRailgun", 0.5
  DamageFactor "PDTPuff", 0.5
  DamageFactor "RailG", 0.6
  DamageFactor "HellComet", 0.6
  //DamageFactor 0.7
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "BossLifeEssence" 200
  DropItem "CFBossArmorBonusMax25" 200
  DropItem "CFBossArmorBonusMax25" 200
  DropItem "CFBossArmorBonusMax25" 200
  DropItem "CFBossArmorBonusMax25" 200
  DropItem "NewCellPackPickup" 186 300
  DropItem "NewCellPackPickup" 186 300
  DropItem "NewCellPackPickup" 186 300
  DropItem "BFG10KGiver" 178
  DropItem "RailgunGiver" 184
  DropItem "PhaseArmor" 96
  DropItem "PhaseSphere" 128
  Obituary "$CFPhaseCyberdemonObit"
  //SeeSound "monsters/darkcybersee"
  //PainSound "monster/psopain"
  //DeathSound "monsters/darkcyberdie"
  BloodColor "Purple"
  Tag "$CFPhCyb"
  var int user_nomore;
  var int user_phasestate;
  States 
  {    
  Spawn: 
	PSCP A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,5)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PSCP A 10 A_Look
	PSCI A 10 A_Look
	Loop 
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PSCP AABBCC 3 A_Chase
	PSCP A 3 A_Hoof
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_Jump(64,"Rush")
	TNT1 A 0 A_Jump(30,"Phase")
	PSCP A 3 A_Hoof
	PSCP ABBCC 3 A_Chase
	PSCP D 3 A_Metal
	PSCP D 3 A_Chase
	Loop
  Rush:
	TNT1 A 0 A_Hoof
	PSCP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP B 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP C 2 A_Chase
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(87,"See")	
	Loop
  Phase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	PSC3 G 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 1 A_SetTranslucent(0.55)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 1 A_SetTranslucent(0.35)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 1 A_SetTranslucent(0.15)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Goto Phased
  Phased:
	PSCP AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
  Phased2:
	PSCP AABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(12,"UnPhase")
	Loop	
  UnPhase:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP G 1 A_SetTranslucent(0.15)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP G 1 A_SetTranslucent(0.35)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP G 1 A_SetTranslucent(0.55)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSCP G 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetTranslucent(1)
	PSCP G 2 A_FaceTarget		
	Goto See
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(128,"HomingRockets","FloorStomp","Railgun","BFG15K","CloneAttack","Phase")
	//TNT1 A 0 A_JumpIf(user_nomore == 5,"Rockets")
	TNT1 A 0 A_Jump(64,"Kurwamac")
  Rockets:
	PSCP E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RocketsLoop:
	PSCP F 6 Bright A_CustomMissile("PhaseCyberRocket", 40, -24, frandom(-6, 6))
	PSCP E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 9,1)
	Goto RocketsLoop
	PSCP E 10
	TNT1 A 0 A_Jump(128,"HomingRockets","FloorStomp","Railgun","BFG15K")
	Goto See
  Kurwamac:
	TNT1 A 0 A_SetUserVar("user_nomore",user_nomore + 1)
	PSCP G 10 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 3 Bright A_PlaySoundEx("DarkCyber/Laugh","Voice")
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_loop",0)
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	TNT1 A 0
  KurwamacLoop:
	PSC3 B 6 A_PlaySound("monsters/darkcyberstomp")
	PSC3 B 1 A_CustomMissile("PhaseCyberFireSpawner2",0,0,user_loop*15,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 23,1)
	Goto KurwamacLoop+1
	PSC3 AA 5 A_FaceTarget
	TNT1 A 0 A_RadiusGive("ThePhaser2",2000,RGF_MONSTERS,1) 
	Goto See
  HomingRockets:
	PSCP E 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
  HomingRocketsLoop:
	PSCP F 6 Bright A_CustomMissile("PhaseCyberHomer", 40, -24, frandom(-8, 8))
	PSCP E 8 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 7,1)
	Goto HomingRocketsLoop
	PSCP E 10
	TNT1 A 0 A_Jump(128,"FloorStomp","Railgun","BFG15K")
	Goto See	
  FloorStomp:
	PSCP G 10 A_FaceTarget
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSC3 G 3 Bright A_PlaySoundEx("DarkCyber/Laugh","Voice")
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	PSCP G 7 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
	PSC3 A 5 A_FaceTarget
  FloorStompLoop:
	TNT1 A 0 Radius_Quake(10,8,0,24,0)	
	PSC3 B 6 A_PlaySound("monsters/darkcyberstomp")
	PSC3 B 2 A_CustomMissile("PhaseCyberFireSpawner",0,0,0,0)
	TNT1 A 0 A_CustomMissile("PhaseCyberFireSpawner",0,0,15,0)
	PSC3 B 2 A_CustomMissile("PhaseCyberFireSpawner",0,0,-15,0)
	TNT1 A 0 A_CustomMissile("PhaseCyberFireSpawner",0,0,30,0)
	PSC3 B 2 A_CustomMissile("PhaseCyberFireSpawner",0,0,-30,0)
	TNT1 A 0 A_CustomMissile("PhaseCyberFireSpawner",0,0,45,0)
	PSC3 B 2 A_CustomMissile("PhaseCyberFireSpawner",0,0,-45,0)	
	PSC3 AA 5 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 2,1)
	Goto FloorStompLoop
	PSC3 B 20
	TNT1 A 0 A_Jump(128,"Railgun","BFG15K","Phase")
	Goto See		
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	PSCP EE 10 A_FaceTarget
	PSCP E 10 Bright A_FaceTarget
	PSCP F 10 Bright A_CustomMissile("PhaseCyberRail",40,-24)
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	PSCP EE 10 A_FaceTarget
	PSCP E 10 Bright A_FaceTarget
	PSCP F 10 Bright A_CustomMissile("PhaseCyberRail",40,-24)
	PSCP E 15
	TNT1 A 0 A_Jump(128,"BFG15K")
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	PSCP E 18 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",0)
	PSCP E 6 Bright A_FaceTarget
  BFG15KLoop:
	PSCP F 4 Bright A_CustomMissile("PhaseCyber15KBall",40,-24,frandom(-4, 4))	
	PSCP E 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 8,1)
	Goto BFG15KLoop
	PSCP E 20 Bright A_PlaySound("weapons/bfg15kcooldown",CHAN_AUTO)	
	Goto See
  CloneAttack:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_loop",0)
	PSC3 G 3 Bright A_PlaySoundEx("DarkCyber/Laugh","Voice")
  CloneAttackLoop:
	TNT1 A 0 A_FaceTarget
	PSC3 G 3 Bright A_SpawnItemEx("PhaseCyberFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop + 1)
	TNT1 A 0 A_JumpIf(user_loop > 12,1)
	Goto CloneAttackLoop
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_loop",0)
	TNT1 A 0 A_Jump(256,"RocketClones","15kClones","MissileClones","RailgunClones")
  RocketClones:
	TNT1 AAA 0 A_SpawnItemEx("FakePhaseCyber1",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
	TNT1 A 1 A_SetUserVar("user_phasestate",1)
	Goto PhaseGhost
  15kClones:
	TNT1 AAA 0 A_SpawnItemEx("FakePhaseCyber2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
	TNT1 A 1 A_SetUserVar("user_phasestate",2)
	Goto PhaseGhost
  MissileClones:
	TNT1 AAA 0 A_SpawnItemEx("FakePhaseCyber3",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
	TNT1 A 1 A_SetUserVar("user_phasestate",3)
	Goto PhaseGhost
  RailgunClones:
	TNT1 AAA 0 A_SpawnItemEx("FakePhaseCyber4",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
	TNT1 A 1 A_SetUserVar("user_phasestate",4)
	Goto PhaseGhost
  PhaseGhost:
	TNT1 A 0 A_Hoof
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP B 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_Wander
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Hoof
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP B 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_Wander
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_Wander
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Hoof
	PSCP A 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP A 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP B 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP C 2 A_ExtChase(0,0)
	TNT1 A 0 A_Metal
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PSCP D 2 A_ExtChase(0,0)
	TNT1 A 0 A_SpawnItemEx("PhaseCyberGhostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 1 A_JumpIf(user_phasestate == 1,"Rockets")
	TNT1 A 1 A_JumpIf(user_phasestate == 2,"BFG15k")
	TNT1 A 1 A_JumpIf(user_phasestate == 3,"HomingRockets")
	TNT1 A 1 A_JumpIf(user_phasestate == 4,"Railgun")
	TNT1 A 0 A_SetUserVar("user_loop",0)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(87,"PainMissile")
	TNT1 A 0 A_Jump(32,"CloneAttack")
	PSCP G 10 A_Pain
	Goto See
  PainMissile:
	PSCP G 10 A_Pain
	Goto Missile
  Death:
	PSCP G 10 A_Scream
	PSCP H 10 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("MutantGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
