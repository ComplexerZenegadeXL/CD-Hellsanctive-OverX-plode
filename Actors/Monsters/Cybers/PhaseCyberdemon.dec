Actor PhaseCyberFireSpawner2 : PhaseCyberFireSpawner
{
  Damage 0
  States
  {
  Spawn: 
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 2 A_CustomMissile("PhaseCyberFire2",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
    Loop  
  Death:
    TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("PurpleKaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    PTRD K 4 Bright
    PTRD MNO 3 Bright
    Stop
  }
}

