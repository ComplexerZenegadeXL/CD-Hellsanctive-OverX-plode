Actor PhaseGhoul : Guardian 27902
{
  Health 1250
  PainChance 96
  SeeSound "PhaseGhoul/Sight"
  PainSound "PhaseGhoul/Pain"
  ActiveSound "PhaseGhoul/Active"
  DeathSound "PhaseGhoul/Death"
  Species "Skeletons"
  +MISSILEMORE
  +QUICKTORETALIATE
  +SHADOW
  +NOFEAR
  +NOICEDEATH
  +DONTHURTSPECIES
  +BOSS
  BloodColor "51 07 94"
  Speed 24
  DamageFactor 0.666
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Legendary", 0.25
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "LegendaryGuru", 0.25
  DamageFactor "LegendaryGuruPlayer", 0.25
  DamageFactor "Ice", 0.333
  DamageFactor "FreezerBurn", 0.333
  DamageFactor "CadaverRocket", 0
  DamageFactor "RevIce", 0.0
  Obituary "$CFPhaseGhoulObit"
  HitObituary "$CFPhaseGhoulHitObit"
  Tag "$CFPhRev"
  MeleeRange 100
  var int user_missile;
  var int user_fakedeath;
  var int user_lowlag;
  States
  {
  Spawn:
	PGHL A 0
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,5)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SpawnItemEx("PhaseGhoulASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 4 A_Look
	TNT1 A 0 A_SpawnItemEx("PhaseGhoulBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 4 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PGHL AABB 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	PGHL AA 1 A_SpawnItemEx("PhaseGhoulASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 0 A_Chase
	PGHL BB 1 A_SpawnItemEx("PhaseGhoulBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL B 0 A_Chase
	PGHL CC 1 A_SpawnItemEx("PhaseGhoulCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL C 0 A_Chase
	PGHL DD 1 A_SpawnItemEx("PhaseGhoulDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL D 0 A_Chase
	PGHL EE 1 A_SpawnItemEx("PhaseGhoulESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL E 0 A_Chase
	PGHL FF 1 A_SpawnItemEx("PhaseGhoulFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL F 0 A_Chase
	PGHL M 0 A_ChangeFlag("NOPAIN",1)
	Loop
  Melee:
	PGHL J 0 A_SkelWhoosh
	PGHL JJJ 1 A_SpawnItemEx("PhaseGhoulJspawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,2)
	PGHL A 0 A_RadiusGive("PhaseMindfuck",64,RGF_PLAYERS,1)
	PGHL KKK 1 A_SpawnItemEx("PhaseGhoulKSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,2)
	PGHL A 0 A_RadiusGive("PhaseMindfuck",64,RGF_PLAYERS,1)
	PGHL L 0 A_CustomMeleeAttack(random(6, 9)*7, "skeleton/melee")
	PGHL LLL 1 A_SpawnItemEx("PhaseGhoulLSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,2)
	PGHL A 0 A_RadiusGive("PhaseMindfuck",64,RGF_PLAYERS,1)
	PGHL L 0 A_Recoil(random(35, 45))
	PGHL L 0 ThrustThingZ(0, random(30, 40), 1, 1)
	Goto See
  Missile:
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_JumpIfCloser(192,"melee")
	TNT1 A 0 A_Jump(128,"Railgun","FamineBalls","BFG15K","Floorshits")
	TNT1 A 0 A_Jump(40,"Clones")
	Goto Normal
  Normal:
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  NormalLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 8,"MissileEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulMissile",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  MissileEnd:
	TNT1 A 0 A_Jump(128,6)
	TNT1 A 0 ThrustThingZ(0, random(30, 45), 0, 1)
	TNT1 A 0 ThrustThing(random(0, 359), random(20, 30), 1, 0)
	PGHL IIIIIIIII 1 A_SpawnItemEx("PhaseGhoulISpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(128,"Normal","Railgun","FamineBalls","BFG15K","Floorshits")
	Goto See
  Railgun:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoulRail",60,-16)
	PGHL HHHHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoulRail",60,-16)
	PGHL HHHHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoulRail",60,-16)
	PGHL HHHHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto MissileEnd
  FamineBalls:
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  FamineBallsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"MissileEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFamineBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto MissileEnd
  Floorshits:
	TNT1 A 0 A_FaceTarget
	PGHL JJJJJJ 1 A_SpawnItemEx("PhaseGhoulJSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL KKKKKK 1 A_SpawnItemEx("PhaseGhoulKSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,0)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,-5)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,5)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,-10)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,10)
	TNT1 A 0 A_FaceTarget
	PGHL LLLLLL 1 A_SpawnItemEx("PhaseGhoulLSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto MissileEnd
  Clones:
	PGHL M 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_PlaySound("PhaseGhoul/Attack")
	PGHL MMMMMMMMMMMMMMMMMMMM 1 A_SpawnItemEx("PhaseGhoulMSpawnerSubtract",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_SpawnItemEx("FakePhaseGhoul",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
	PGHL AA 1 A_SpawnItemEx("PhaseGhoulASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 0 A_Wander
	PGHL BB 1 A_SpawnItemEx("PhaseGhoulBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL B 0 A_Wander
	PGHL CC 1 A_SpawnItemEx("PhaseGhoulCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL C 0 A_Wander
	PGHL DD 1 A_SpawnItemEx("PhaseGhoulDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL D 0 A_Wander
	PGHL EE 1 A_SpawnItemEx("PhaseGhoulESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL E 0 A_Wander
	PGHL FF 1 A_SpawnItemEx("PhaseGhoulFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL F 0 A_Wander
	Goto See
  Pain:
	PGHL M 0 A_ChangeFlag("NOPAIN",1)
	PGHL M 0 A_RadiusGive("PhaseMindfuck",128,RGF_PLAYERS)	
	PGHL M 0 ThrustThingZ(0, random(30, 45), 0, 1)
	PGHL M 0 A_Pain
	PGHL MMMM 1 A_SpawnItemEx("PhaseGhoulMSpawnerSubtract",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL M 0 ThrustThing(frandom(0, 360), frandom(20, 30), 1, 0)
	PGHL M 0 A_Jump(128, "Missile")
	Goto See
  Pain.Legendary:
  Pain.LegendaryGuruPlayer:
  Pain.PlayerDTRG:
	PGHL M 0 A_Pain
	PGHL M 0 ThrustThingZ(0, frandom(30, 45), 0, 1)
	PGHL M 0 A_RadiusGive("PhaseMindfuck",512,RGF_PLAYERS)	
	PGHL M 0 A_Jump(128, "pain2")
	PGHL M 0 ThrustThing(angle/256*360+64, frandom(40, 50), 1, 0)
	Goto Pain3
  Pain2:
	PGHL M 0 ThrustThing(angle/256*360+192, frandom(40, 50), 1, 0)
  Pain3:
	PGHL MMMM 1 A_SpawnItemEx("PhaseGhoulMSpawnerSubtract",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL M 0 A_Jump(192, "Missile")
	Goto See
  XDeath:
  Death.PlayerIce:
  Death:
	PGHL MMMMMM 1 A_SpawnItemEx("PhaseGhoulMSpawnerSubtract",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIf(user_fakedeath == 1,2)	 
	TNT1 A 0 A_Jump(64,"FakeDeath")
	TNT1 A 0 A_Scream
	TNT1 A 0 A_SpawnItemEx("DemonAmmoPickup",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("DemonAmmoBoxPickup",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION,128)
	TNT1 A 0 A_SpawnItemEx("DemonTechRifleGiver",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION,128)
	TNT1 A 0 A_SpawnItemEx("BossLifeEssence",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("BossArmorBonusMax",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("PhaseSphere",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION,128)
	TNT1 A 0 A_SpawnItemEx("UltraSphere",0,0,12,frandom(-4,4),frandom(-4,4),frandom(1,2),0,SXF_NOCHECKPOSITION,128)
	PGHL NOPQR 6
	PGHL S 50
	TNT1 A 0 A_PlaySound("PhaseGhoul/BodyFade")
  DeathLoop:
	PHGL SS 4 A_SpawnItemEx("PhaseGhoulDeath",0,0,0,0,0,2)
	TNT1 A 0 A_FadeOut(0.1,1)
	Loop
  FakeDeath:
	TNT1 A 0 A_SetUserVar("user_fakedeath",1)
	TNT1 A 0 A_Scream
	PGHL NOPQR 6
	PGHL S 100
	PGHL SSSSS 30 A_Jump(40,"RevivePls")
	Goto RevivePls
  RevivePls:
	TNT1 A 0 A_PlaySound("PhaseGhoul/NotSoDeath",7,1.0,0,ATTN_NONE)
	TNT1 A -1 Thing_Raise(0)
	Goto Raise
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	PGHL RQPONM 6
	Goto See
  }
}

Actor SummonedPhaseGhoul : PhaseGhoul { -COUNTKILL }

Actor CorruptedPhaseGhoul : PhaseGhoul
{
  Species "Nobles"
  DamageFactor "NobleComet", 0.0
  DamageFactor "FiendFire", 0.0
  DamageFactor "DTFiendEx", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Cyber10K", 0.0
  DamageFactor "CadaverRocket", 0.0
  Tag "Corrupted Phase Ghoul"
  +DONTHURTSPECIES
  +THRUSPECIES
  -COUNTKILL
}

Actor PhaseGhoulMissile : PhaseCyberHomer
{
  Species "Skeletons"
  Damagetype "CadaverRocket"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck",80,RGF_PLAYERS)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("PurpleKaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
    PHRK B 6 Bright A_Explode
    PHRK CDEF 4 Bright A_SetTranslucent(0.75,1)
    Stop
  }
}

Actor PhaseGhoulRail : PhaseCyberRail { Species "Skeletons" DamageType "CadaverRocket" }

Actor PhaseGhoulFamineBall : PhaseArchonTracer { Species "Skeletons" DamageType "CadaverRocket" }

Actor PhaseGhoul15KBall : PhaseCyber15KBall
{
  Species "Skeletons"
  DamageType "CadaverRocket"
  States
  {
  Death:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,2)
	TNT1 A 0 A_RadiusGive("PhaseMindfuck",110,RGF_PLAYERS)
    TNT1 A 0 A_SpawnItemEx("PurpleBFGShockwave", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("PurpleKaboom13", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))      
    PFE1 A 4 Bright A_Explode
    PFE1 BCDEF 4 Bright
    Stop
  }
}

Actor PhaseGhoulFireSpawner : PhaseAFireSpawner
{
  Species "Skeletons"
  DamageType "CadaverRocket"
  Obituary "$CFPhaseGhoulFireSpawnerObit"
  States
  {
  Spawn: 
    TNT1 A 0
    TNT1 A 0 A_PlaySoundEx("monster/ambientfire2","Voice",1)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
	TNT1 A 1 A_CustomMissile("PhaseGhoulFire",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 1 A_Weave(3,0,1.0,0.0)	
    Loop
  }
}

Actor PhaseGhoulFire : PhaseArchonFire2
{
  Species "Skeletons"
  DamageType "CadaverRocket"
  Obituary "$CFPhaseGhoulFireObit"
}

Actor FakePhaseGhoul : PhaseGhoul
{
  +NOTARGET
  -COUNTKILL
  -SHOOTABLE
  -SOLID
  -BOSS
  States
  {
  Spawn:
	PGHL AA 1 A_SpawnItemEx("PhaseGhoulASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 0 A_Wander
	PGHL BB 1 A_SpawnItemEx("PhaseGhoulBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL B 0 A_Wander
	PGHL CC 1 A_SpawnItemEx("PhaseGhoulCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL C 0 A_Wander
	PGHL DD 1 A_SpawnItemEx("PhaseGhoulDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL D 0 A_Wander
	PGHL EE 1 A_SpawnItemEx("PhaseGhoulESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL E 0 A_Wander
	PGHL FF 1 A_SpawnItemEx("PhaseGhoulFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL F 0 A_Wander
  Idle:
	PGHL AA 1 A_SpawnItemEx("PhaseGhoulASpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL A 0 A_Chase
	PGHL BB 1 A_SpawnItemEx("PhaseGhoulBSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL B 0 A_Chase
	PGHL CC 1 A_SpawnItemEx("PhaseGhoulCSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL C 0 A_Chase
	PGHL DD 1 A_SpawnItemEx("PhaseGhoulDSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL D 0 A_Chase
	PGHL EE 1 A_SpawnItemEx("PhaseGhoulESpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL E 0 A_Chase
	PGHL FF 1 A_SpawnItemEx("PhaseGhoulFSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL F 0 A_Chase
	Loop
  Melee:
  Missile:
	TNT1 A 0 A_Jump(128,"FamineBalls","BFG15K","Floorshits")
	Goto Normal
  Normal:
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  NormalLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 4,"MissileEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	PGHL GGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulMissile",60,-16)
	PGHL HHHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  FamineBalls:
	TNT1 A 0 A_FaceTarget
	PGHL GGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetUserVar("user_missile",0)
  FamineBallsLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 6,"MissileEnd")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget
	PGHL GGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFamineBall",60,-16)
	PGHL HHHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  BFG15k:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL GGGGGG 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_CustomMissile("PhaseGhoul15KBall",60,-16)
	PGHL HHH 1 A_SpawnItemEx("PhaseGhoulGSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto MissileEnd
  Floorshits:
	TNT1 A 0 A_FaceTarget
	PGHL JJJJJJ 1 A_SpawnItemEx("PhaseGhoulJSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	PGHL KKKKKK 1 A_SpawnItemEx("PhaseGhoulKSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,0)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,-8)
	TNT1 A 0 A_CustomMissile("PhaseGhoulFireSpawner",0,0,8)
	TNT1 A 0 A_FaceTarget
	PGHL LLLLLL 1 A_SpawnItemEx("PhaseGhoulLSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Goto MissileEnd
  MissileEnd:
	PGHL IIIIIIIII 1 A_SpawnItemEx("PhaseGhoulISpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Die
	Goto Death
  Death:
	TNT1 AA 0 A_SpawnItemEx("PhaseGhoulMSpawnerSubtract",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	PGHL M 1 A_FadeOut
	Loop
  }
}
	
Actor PhaseGhoulASpawner : PhaseNightmareASpawner
{
  Scale 1.0
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("PhaseGhoulA", 0, 0, -20, frandom(-1.5,1.5), frandom(-1.5,1.5), frandom(3,7.5))
	Stop
  }
}

