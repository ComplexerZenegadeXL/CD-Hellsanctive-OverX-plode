Actor EnragedLegendaryRevenant : LegendaryRevenant
{
  Health 1600
  Height 84
  Speed 21 
  +BRIGHT
  SeeSound "ELEGRev/See"
  DeathSound "ELEGRev/Ded"
  ActiveSound "ELEGRev/See"
  BloodColor "Red"
  MeleeDamage 9
  DamageFactor 0.6
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.4
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DropItem "EnragedLegendaryArmor" 68
  DropItem "EnragedLegendarySphere" 72
  DropItem "LegendaryAmmoSphere" 88
  DropItem "ILDemonAmmoBoxPickup" 256 
  DropItem "ILDemonAmmoPickup" 256
  //DropItem "EnragedLegendaryPlasmaticCannonGiver" 64
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryPlasmaticRifle" 256
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFEnragedLegendaryRevenantObit"
  HitObituary "$CFEnragedLegendaryRevenantHitObit"
  Tag "$CFEnrRev"
  var int user_rageloop;
  States
  {
  Spawn:
  	EREV A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",10)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    EREV A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	EREV AAABBB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,404)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetUserVar(user_missile,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TNT1 A 0 A_Jump(100,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    EREV AAABBBCCC 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    EREV DDDEEEFFF 2 A_Chase
	TNT1 A 0 A_Jump(28,"Dodge")
	TNT1 A 0 A_Jump(16,"Teleport")
    Loop
  Rush:
  	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    EREV A 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase
    EREV B 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase	
    EREV C 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase	
    TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    EREV D 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase
    EREV E 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase
    EREV F 2 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	EREV AAAA 0 A_Chase	
	TNT1 A 0 A_Jump(28,"Dodge")
	TNT1 A 0 A_Jump(12,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
    Loop
  Teleport:
    EREV K 1 A_UnSetShootable
	EREV KKKKKKKKKK 1 A_FadeOut(0.1,0)
	EREV K 2
	EREV KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK 0 A_Wander
    EREV K 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	EREV KKKKKKKKKK 1 A_FadeIn(0.1)
    EREV K 1 A_SetShootable
    Goto See
  Dodge:
    EREV A 1 A_JumpIfTargetInLos(1)
	Goto See
  DodgeLoop:
	TNT1 A 0 A_JumpIf(user_missile >= 4,"See")
  	EREV A 1 A_SetAngle(frandom(0,360))
    TNT1 A 0 A_Recoil(-40)
	EREV AAAAAAAAAAAAA 1 A_SpawnItemEx("ELRGhost")
	EREV A 1 A_Stop	
    TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)	
    Loop
  Melee:
    EREV G 0 A_FaceTarget
    EREV G 1 A_Jump(127,4)
    EREV G 2 A_SkelWhoosh
    EREV H 2 A_FaceTarget
    EREV I 2 A_SkelFist
    Goto See
    EREV R 2 A_SkelWhoosh
    EREV S 2 A_FaceTarget
    EREV T 2 A_SkelFist
    Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_SetTranslucent(1)
    TNT1 A 0 A_Jump(48,"BestAttack")
    TNT1 A 0 A_Jump(156,"Rage","Rocket","DeadHands","Railgun","RandomAngle")
    TNT1 A 0 A_JumpIfCloser(350,"DashPunch")
  Normal:		
    EREV J 10 A_FaceTarget
    EREV K 0 A_CustomMissile("ELegRevBall",65,-13)	
    EREV K 10 A_CustomMissile("ELegRevBall",65,13)
    EREV K 10 A_FaceTarget
	TNT1 A 0 A_Jump(156,"Normal","Rocket")
    Goto See
  Rocket:		
    EREV JJJ 4 A_FaceTarget
    EREV K 0 A_CustomMissile("ELegRevRocket",65,-13)	
    EREV K 6 A_CustomMissile("ELegRevRocket",65,13)
	EREV J 3 A_FaceTarget
    EREV K 0 A_CustomMissile("ELegRevRocket",65,-13)	
    EREV K 6 A_CustomMissile("ELegRevRocket",65,13)
	EREV J 3 A_FaceTarget
    EREV K 0 A_CustomMissile("ELegRevRocket",65,-13)	
    EREV K 6 A_CustomMissile("ELegRevRocket",65,13)
    EREV K 6 A_FaceTarget
	TNT1 A 0 A_Jump(156,"RandomAngle")
    Goto See
  RandomAngle:		
    EREV J 10 A_FaceTarget
	EREV J 1 A_SetUserVar("user_missile",0)
  Randoming:
    EREV K 0 A_JumpIf(user_missile >= 24,"Ending")	 
    EREV K 0 A_SetUserVar("user_missile",user_missile+1)
	EREV K 0 A_SetAngle(random(0,359))	
    EREV K 0 A_CustomMissile("ELegRevBall",65,-13,random(0,360))	
    EREV K 2 A_CustomMissile("ELegRevBall",65,13,random(0,360))
    Loop
  Ending:
    TNT1 A 0 A_SetUserVar("user_missile",0)
    EREV K 1 A_Jump(156,"DeadHands")
    Goto See
  DeadHands:	
    EREV K 0 A_JumpIf(user_missile >= 4,"DeadHandsEnd")	 
    EREV GH 3 A_FaceTarget
    EREV I 3 A_CustomMissile("LegRevFloorDeadHands",0)
	EREV RS 3 A_FaceTarget
    EREV T 3 A_CustomMissile("LegRevFloorDeadHands",0)
	EREV K 0 A_SetUserVar("user_missile",user_missile+1)
	Loop
  DeadHandsEnd:
    TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_Jump(156,"Railgun")
    Goto See	
  Railgun:
    EREV J 1 A_PlaySound("ELEGRev/See")
	EREV J 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EREV J 2  A_FaceTarget
  RailgunCharge:
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	EREV K 0 A_JumpIf(user_missile >= 3,"RailgunFire")
    EREV J 6 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
    EREV J 6 A_FaceTarget
	EREV K 0 A_SetUserVar("user_missile",user_missile+1)
	Loop
  RailgunFire:
	TNT1 A 0 A_SetUserVar("user_missile",0)	
	EREV J 0 A_ChangeFlag("NOPAIN",1)
    EREV J 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	EREV K 0 A_FaceTarget	
	EREV K 0 A_PlayWeaponSound("monsters/darkcyberrail")
    EREV K 0 A_CustomMissile("ELegRevRailgunProj",70,-26)	
    EREV K 3 A_CustomMissile("ELegRevRailgunProj",70,26)
	EREV K 0 A_CustomMissile("ELegRevRailgunProj",70,-13)	
    EREV K 3 A_CustomMissile("ELegRevRailgunProj",70,13)
	TNT1 A 0 A_Jump(156,"Rage")
    Goto See
  Rage:
    EREV J 1 A_PlaySound("legendaryrevenant/attack1")
	EREV J 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EREV J 0 A_SetUserVar("user_missile",0)
	EREV J 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
  RageCharge:
    EREV K 0 A_JumpIf(user_missile >= 4,"Raging")	 
    EREV JJ 4 A_FaceTarget
	EREV K 0 A_SetUserVar("user_missile",user_missile+1)
	Loop	
  Raging:
    EREV J 0 A_ChangeFlag("NOPAIN",1)
    EREV J 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    EREV K 0 A_JumpIf(user_missile >= 32,"See")	 
    EREV K 0 A_SetUserVar("user_missile",user_missile+1)
	EREV K 0 A_FaceTarget	
    EREV K 0 A_CustomMissile("ELegRevBall2",70,-13,0)	
    EREV K 3 A_CustomMissile("ELegRevBall2",70,13,0)
    Loop  	 
  BestAttack:		
    EREV J 1 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	EREV J 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	EREV J 0 A_PlaySound("legendaryrevenant/attack2")
	EREV JJJJ 5 A_FaceTarget
	EREV J 2 A_PlayWeaponSound("lrball3/charge")
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
  BestStart:
    TNT1 A 0 A_JumpIf(user_rageloop == 15,"BestFire")
	TNT1 A 0 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
    EREV J 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
    EREV J 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
    EREV J 2 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
    EREV J 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_rageloop,user_rageloop+1)
	Loop
  BestFire:
    TNT1 A 0 A_SetUserVar(user_rageloop,0)
	EREV J 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
    EREV JJ 10 A_FaceTarget
  BestFire1:
    EREV K 0 A_JumpIf(user_missile >= 4,"BestFire2")	 
    EREV J 5 A_FaceTarget
	EREV J 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("ELegRevRailgunProj",70,-13)
    EREV K 3 A_CustomMissile("ELegRevRailgunProj",70,13)	
  BestFire2:
	EREV GH 3 A_FaceTarget
    EREV I 3 A_CustomMissile("LegRevFloorDeadHands",0)
	EREV RS 3 A_FaceTarget
    EREV T 3 A_CustomMissile("LegRevFloorDeadHands",0)
    EREV GH 3 A_FaceTarget
    EREV I 3 A_CustomMissile("LegRevFloorDeadHands",0)
	EREV RS 3 A_FaceTarget
    EREV T 3 A_CustomMissile("LegRevFloorDeadHands",0)
	EREV K 0 A_CustomMissile("ELegRevRocket",65,-13,0)	
    EREV K 6 A_CustomMissile("ELegRevRocket",65,13)
	EREV J 3 A_FaceTarget
    EREV K 0 A_CustomMissile("ELegRevRocket",65,-13,0)	
    EREV K 6 A_CustomMissile("ELegRevRocket",65,13)
    EREV K 0 A_PlayWeaponSound("lrball3/shot")
    EREV K 0 A_CustomMissile("ELegRevBall3",65,-13)    
	EREV K 10 A_CustomMissile("ELegRevBall3",65,13)
	EREV J 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    EREV K 10 A_FaceTarget
	Goto see
  DashPunch:
    TNT1 A 0 A_Jump(128,"Normal")
	TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-65)
    TNT1 A 0 A_SkelWhoosh	
	EREV GGGGGHHHHH 1 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LRDashPunch",32,0,0,CMF_AIMDIRECTION)
	EREV III 1 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EREV A 1 A_Stop	
	EREV A 1 A_FaceTarget
    TNT1 A 0 A_Recoil(-65)
    TNT1 A 0 A_SkelWhoosh	
	EREV RRRRRSSSSS 1 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LRDashPunch",32,0,0,CMF_AIMDIRECTION)
	EREV TTT 1 A_SpawnItemEx("ELRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	EREV A 1 A_Stop			
    Goto See
  Pain:
    TNT1 A 0 A_Jump(8,"Rage")	
  	TNT1 A 0 A_Jump(32,"Teleport","Fake")
    EREV L 3
    EREV L 3 A_Pain 
	TNT1 A 0 A_Jump(128,"Missile")
    Goto See
  Fake:
  	TNT1 A 0 A_JumpIf(user_fake >= 2,"See")	 
    TNT1 A 0 A_SetUserVar("user_fake",user_fake+1)
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
    TNT1 A 0 A_ChangeFlag("SOLID",0)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	TNT1 A 0 A_ChangeFlag("ISMONSTER",0)
	EREV LM 7
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SetUserVar("user_music",0)
	EREV N 7 A_PlaySoundEx("ELEGRev/Ded","body",0,1)
    EREV O 7
	EREV P 0 A_SpawnItemEx("BossArmorBonusMax")
	EREV P 7 A_SpawnItemEx("BossLifeEssence")
    EREV Q 17
	TNT1 A 0 A_Jump(54,"FakeDone")
	EREV QQQQQQQQQQQQQQQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	TNT1 A 0 A_Jump(54,"FakeDone")
	EREV QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	EREV Q 175
  FakeDone:
	EREV Q 0 A_PlaySound("misc/gibbed")
  	EREV Q 0 A_SpawnItemEx("EnragedRevenantRes",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	EREV Q 0 A_ChangeFlag("SHOOTABLE",1)
	TNT1 A 0 A_ChangeFlag("BRIGHT",1)
    EREV Q 5 A_ChangeFlag("SOLID",1)
	TNT1 A 0 A_ChangeFlag("ISMONSTER",1)
	EREV P 0 A_PlaySound("ELEGRev/See",CHAN_5,1.0,0,ATTN_NONE)
    EREV PONML 3
    Goto See
  Death:
	TNT1 A 0 A_StopSound
	EREV LLLLL 3 A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_Scream
	EREX AAABBBCCCDDDEEE 2  A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-10,10),frandom(-10,10),frandom(0,10),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(3,5),256)
	EREX FFGGHH 3  A_SpawnItemEx("EKaboomLN",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-10,10),frandom(-10,10),frandom(0,10),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_ChangeFlag("BRIGHT",0)
	EREX IJ 8
	EREX K 17
	EREX KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	EREX K -1
    Stop
  }
}

Actor ELegRevBall : LegRevBall
{
  Damage (Random(40,70)) //12
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Homing")	
  Normal:
    ERB1 ABCD 2 A_CustomMissile("ELegRevBallFX",0)
    Loop
  Homing:
	TNT1 A 0 A_SeekerMissile(15,0)
    ERB1 A 2 A_CustomMissile("ELegRevBallFX",0)
	TNT1 A 0 A_SeekerMissile(15,0)
    ERB1 B 2 A_CustomMissile("ELegRevBallFX",0)
	TNT1 A 0 A_SeekerMissile(15,0)
    ERB1 C 2 A_CustomMissile("ELegRevBallFX",0)
	TNT1 A 0 A_SeekerMissile(15,0)
    ERB1 D 2 A_CustomMissile("ELegRevBallFX",0)		
    Loop	
  Death:
	ERB1 ABCD 4 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Explode(48,96,0) 
	TNT1 A 0 A_PlaySound("weapons/clrocketexplode")
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ERB1 EFGHIJKLMNO 3
    Stop
  }
}

Actor ELegRevBallFX : LegRevBallFX
{   
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    ERBF PQ 4 Bright A_FadeOut(0.1)
    Loop
  Vanilla:
	TNT1 A 0
	Stop	  
  }
}

Actor ELegRevBall2 : LegRevBall2
{
  Speed 80
  Damage (Random(20,35)) //7
  States
  {
  Spawn: 
  	ERB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    ERB2 A 1 Bright A_SpawnItemEx("ELegRevBall2Trail",0,0,0,0,0,0,0,128)
  	ERB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    ERB2 B 1 Bright A_SpawnItemEx("ELegRevBall2Trail",0,0,0,0,0,0,0,128)
  	ERB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    ERB2 C 1 Bright A_SpawnItemEx("ELegRevBall2Trail",0,0,0,0,0,0,0,128)	
    Loop
  Death:
  	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner") 
    ERB2 EFGHIJKLMNO 3 Bright
    Stop
  }
}

Actor ELegRevBall2Trail : LegRevBall2Trail
{       
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {   
	Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	ERBE ABCDEFGHI 2 Bright 
	Stop
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor ELegRevBall3 : LegRevBall3
{
  Speed 38
  Damage (Random(200,300)) //88
  +STRIFEDAMAGE
  States
  {
  Spawn:
	RRBA A 0 A_CountDown
    RRBA AA 2 Bright A_SpawnItemEx("ELegRevBall3Trail")
    Loop
  Death:
    TNT1 A 0 A_Explode
    TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_PlaySound("lrball3/exp")	
    TNT1 AAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ELegRevSmallBall3",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(45,70),0,Random(-3,3),frandom(-14,14),SXF_NOCHECKPOSITION)
	MMSD A 8 Bright A_Explode(38,140)
    Stop
  }
}

Actor ELegRevBall3Trail : LegRevBall3Trail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
 {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(255, "Flash1", "Flash2", "Flash3", "Flash4")
  Flash1:
	RRB3 A 2 Bright A_FadeOut(0.08)
	Wait
  Flash2:
	RRB3 B 2 Bright A_FadeOut(0.08)
	Wait
  Flash3:
	RRB3 C 2 Bright A_FadeOut(0.08)
	Wait
  Flash4:
	RRB3 D 2 Bright A_FadeOut(0.08)
	Wait
  Vanilla:
	TNT1 A 0
	Stop   
  }
}

Actor ELegRevSmallBall3 : LegRevSmallBall3
{
  Speed 74
  Damage (Random(25,50)) //8
  States
  {
  Spawn:
    RRB3 A 0
	RRB3 A 0 A_CountDown
    RRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 AA 1 Bright A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	RRB3 A 0 A_SeekerMissile(1,8,SMF_LOOK)
	RRB3 BB 1 Bright A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	RRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 CC 1 Bright A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	RRB3 A 0 A_SeekerMissile(15,8,SMF_LOOK)
	RRB3 DD 1 Bright A_SpawnItemEx("ELegRevBall3Trail2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    TNT1 I 8 Bright A_Explode(8,80)
    TNT1 J 6 Bright
    TNT1 K 4 Bright
    Stop
  }
}


Actor ELegRevBall3Trail2 : LegRevBall3Trail2
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
   Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_Jump(256,"Flash1","Flash2","Flash3","Flash4")
  Flash1:
	RRB3 A 1 Bright A_FadeOut(0.125)
	Wait
  Flash2:
	RRB3 B 1 Bright A_FadeOut(0.125)
	Wait
  Flash3:
	RRB3 C 1 Bright A_FadeOut(0.125)
	Wait
  Flash4:
	RRB3 D 1 Bright A_FadeOut(0.125)
	Wait
  Vanilla:
    TNT1 A 0
	Stop   
  }
}


