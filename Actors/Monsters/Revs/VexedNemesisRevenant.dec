Actor VexedNemesisRevenant : NemesisRevenant 28014
{
  Health 3000
  Speed 15
  DamageFactor 0.55
  DamageFactor "Explosion", 0.10
  DamageFactor "PlayerDTRG", 0.25
  DamageFactor "DTRailgun", 0.25
  DamageFactor "PDTPuff", 0.05
  DamageFactor "RailG", 0.30
  DamageFactor "PyroShot", 0.05
  DamageFactor "PlayerPyro", 0.05
  DamageFactor "PlayerBHole", 0.05
  DamageFactor "PlayerDBFG", 0.05
  DamageFactor "PlayerDBFG2", 0.05
  PainChance "Explosion", 64
  PainChance "PlayerDTRG", 64
  PainChance "DTRailgun", 64
  PainChance "PDTPuff", 64
  PainChance "RailG", 64
  +FLOAT
  +NOGRAVITY
  +BRIGHT
  SeeSound "VexedRevenant/Sight"
  DeathSound "VexedRevenant/Death"
  ActiveSound " "
  Obituary "$CFVexedNemesisRevenantObit"
  Tag "$CFVexRev"
  States
  {
  Spawn:
	VNRV A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,5)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SpawnItemEx("VexedRevenantFireSpawner",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
  Idle:
	TNT1 A 0 A_PlaySound("VexedRevenant/Active",7,1.0,1)
  IdleLoop:
	VNRV AA 5 A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,727)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	VNRV AA 2 A_Chase
	TNT1 A 0 A_Jump(32,"Teleport")
	Loop
  Teleport:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(0,360),30,0,0)
	VNRV K 1 A_UnSetShootable
	VNRV KKKKKKKKKK 1 A_FadeOut(0.1,0)
	TNT1 A 0 A_Stop
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	VNRV K 1 A_PlaySound("boss/teleport",6)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(0,360),30,0,0)
	VNRV KKKKKKKKKK 1 A_FadeIn(0.1)
	TNT1 A 0 A_Recoil(0.1)
	TNT1 A 0 A_Stop
	VNRV K 1 A_SetShootable
	Goto See
  Melee:
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnsetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(10,"OhFuck")
	TNT1 A 0 A_Jump(60,"IonBeam","SuperRandomAngle","BigBalls")
	TNT1 A 0 A_Jump(156,"Lasers","HomingRocket","Railguns")
  Normal:	
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(0,360),30,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  NormalLoop:
    VNRV J 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("NemesisRevRocket",40,-13,0)  
	VNRV K 4 A_CustomMissile("NemesisRevRocket",40,13,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	VNRV K 4
	Goto See
  HomingRocket:	
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(0,360),30,0,0)
    TNT1 A 0 A_SetUserVar("user_loop",0)
  HomingRocketLoop:
	VNRV J 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("NemesisRevHomingRocket",40,-13,0)  
	VNRV K 4 A_CustomMissile("NemesisRevHomingRocket",40,13,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,1)
	Loop
	VNRV K 4
	Goto See
  Railguns:	
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(0,360),30,0,0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RailgunsLoop:
    VNRV J 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/darkcyberrail",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("NemesisRevRailLaser",45,-20,0)  
	VNRV K 4 A_CustomMissile("NemesisRevRailLaser",45,20,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
    VNRV K 4 
	Goto See
  IonBeam:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_PlaySound("lrball3/charge",CHAN_WEAPON)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 10,"IonBeamFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 ThrustThing(Angle*256/360+random(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	Goto IonBeam+5
  IonBeamFire:
	TNT1 A 0 A_PlaySound("NemesisCannon/BigLaser",CHAN_WEAPON)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonIonBeam",40,-13,0)  
	VNRV K 10 A_CustomMissile("NemesisRevCannonIonBeam",40,13,0)
	VNRV J 10 A_FaceTarget
	TNT1 A 0 A_CustomMissile("NemesisRevCannonIonBeam",40,-13,0)  
	VNRV K 10 A_CustomMissile("NemesisRevCannonIonBeam",40,13,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  SuperRandomAngle:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_SetUserVar("user_missile",0)
    TNT1 A 0 A_PlaySound("cydes/mischrg",5)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 8,"SuperRandomAngleFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	Goto SuperRandomAngle+5
  SuperRandomAngleFire:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	TNT1 A 0 A_JumpIf(user_missile >= 8,"See")   
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_SetAngle(random(0,359))  
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire",7)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonProj",40,-13,frandom(0,360))  
	VNRV K 2 A_CustomMissile("NemesisRevCannonProj",40,13,frandom(0,360))
	TNT1 A 0 A_SetAngle(frandom(0,360))  
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire",7)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonProj",40,-13,frandom(0,360))  
	VNRV K 2 A_CustomMissile("NemesisRevCannonProj",40,13,frandom(0,360))
	TNT1 A 0 A_SetAngle(frandom(0,360))  
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire",7)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonProj",40,-13,frandom(0,360))  
	VNRV K 2 A_CustomMissile("NemesisRevCannonProj",40,13,frandom(0,360))
	TNT1 A 0 A_SetAngle(frandom(0,360))  
	TNT1 A 0 A_PlaySound("NemesisCannon/Fire",7)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonProj",40,-13,frandom(0,360))  
	VNRV K 2 A_CustomMissile("NemesisRevCannonProj",40,13,frandom(0,360))
	Goto SuperRandomAngleFire+2
  Lasers:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",2)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 5,"LasersFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJJJ 2 A_FaceTarget
	Goto Lasers+4
  LasersFire:
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	TNT1 A 0 A_JumpIf(user_missile >= 60,"See")   
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget  
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),10,0,0)
	TNT1 A 0 A_CustomMissile("NemesisRevMiniLaser",40,-13,0)  
	VNRV K 2 Bright A_CustomMissile("NemesisRevMiniLaser",40,13,0)
	Goto LasersFire+2
  BigBalls:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",4)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_PlaySound("lrball3/charge",CHAN_WEAPON)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 10,"BigBallsFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	Goto BigBalls+5
  BigBallsFire:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  BigBallsFireLoop:
	TNT1 A 0 A_PlayWeaponSound("star/fire")
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",40,-13,0)  
	VNRV K 10 A_CustomMissile("MiniNemesisBFGBall",40,13,0)
	VNRV J 10 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 3,1)
	Loop
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  OhFuck:
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",4)
	TNT1 A 0 A_SetUserVar("user_missile",0)
	TNT1 A 0 A_PlaySound("VexedRevenant/Attack",2)
	TNT1 A 0 A_PlaySound("NemesisBFG/Charge",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_JumpIf(user_missile >= 20,"OhFuckFire")	 
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	Goto OhFuck+6
  OhFuckFire:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  OhFuckFireLoop:
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	TNT1 A 0 A_PlayWeaponSound("star/fire")
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",40,-13,0)  
	VNRV K 7 A_CustomMissile("MiniNemesisBFGBall",40,13,0)
	VNRV J 7 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop	
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",4)
	VNRV JJ 4 A_FaceTarget
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(-64,64),30,0,0)
	VNRV JJ 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("NemesisBFG/Fire",1)
	TNT1 A 0 A_CustomMissile("NemesisGuruBall",40,-13,0)  
	VNRV K 7 A_CustomMissile("NemesisGuruBall",40,13,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See
  Pain:
	TNT1 A 0 A_Jump(5,"OhFuck")
	TNT1 A 0 A_Jump(50,"Teleport")
	TNT1 A 0 A_Jump(30,"SuperRandomAngle","Lasers","BigBalls")  
	VNRV L 3 
	VNRV L 3 A_Pain 
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See
  Pain.RailG:
  Pain.PDTPuff:
  Pain.DTRailgun:
  Pain.PlayerDTRG:
  Pain.Explosion:
	Goto OhFuck
  Death:
	TNT1 A 0 A_RemoveChildren(1)
	TNT1 A 0 A_StopSound(7)
	VNRV LLLLL 3 A_SpawnItemEx("WhiteNemesisKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_Scream
	VNRV LLLLLLLLLLLLLLL 2 A_SpawnItemEx("WhiteNemesisKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-10,10),frandom(-10,10),frandom(0,10),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_NoBlocking
	VNRV LLLLLLLLLLLLLLLLLLLLLLLL 1 A_SpawnItemEx("WhiteNemesisKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-2,2),frandom(-2,2),frandom(-2,2),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_FadeOut(0.1,0)
	TNT1 A 0 A_SpawnItem("MiniNemesisDeathBall")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	VNRV L 1 A_SpawnItemEx("WhiteNemesisKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-2,2),frandom(-2,2),frandom(-2,2),0,SXF_TRANSFERPOINTERS)
	TNT1 A 0 A_FadeOut(0.1,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 10,1)
	Loop
	TNT1 A 100
	TNT1 A 0 A_JumpIfInTargetInventory("NemesisFragmentToken",1,3)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",6) == 0,2)
	TNT1 A 0 A_SpawnItemEx("NemesisFragmentSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,192)
	TNT1 A 0 A_Jump(100,"MoreStuff")
	TNT1 A 1
	Stop
  MoreStuff:
	TNT1 A 0 A_SpawnItem("HellionSmokeAttack")
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_SpawnItem("NemesisHKItemRandomizer")
	TNT1 A 1 A_SpawnItem("NemesisHKSuperItemRandomizer")
	TNT1 A 1
	Stop
  }
}

Actor VexedRevenantFireSpawner
{
  +NOINTERACTION
  +CLIENTSIDEONLY
  +ISMONSTER
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 2 A_Warp(AAPTR_MASTER,0,0,0,0,WARPF_ABSOLUTEANGLE|WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE|WARPF_COPYINTERPOLATION)
    TNT1 AAA 0 A_SpawnItemEx("VexedRevenantFire",15,0,frandom(20,40),frandom(0,-4),0,frandom(-6,-2),frandom(0,360))
    Loop
  }
}

Actor VexedRevenantFire
{
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  +NOTIMEFREEZE
  RenderStyle Add
  Scale 0.3
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	2HDT ABCDEFGHIJKL 1 Bright A_FadeOut
	Stop
  Vanilla:
	TNT1 A 0
	Stop
  }
}