Actor Pestilence : Guardian
{
  Monster
  Health 850
  Height 44
  Radius 20
  Mass 100
  Speed 7
  FloatSpeed 8
  BloodColor "Green"
  PainChance 80
  +FLOAT
  +NOGRAVITY
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  Species "Skeletons"
  DamageFactor "Acid", 0.3
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "CacoLich", 0.0
  DamageFactor "RevIce", 0.0
  DropItem "BossLifeEssence" 256 30
  DropItem "BossArmorBonusMax" 180
  SeeSound "PestilenceSee"
  ActiveSound "PestilenceActive"
  PainSound "PestilencePain"
  DeathSound "PestilenceDeath"
  Obituary "$CFPestilenceObit"
  Tag "$CFPest"
  var int user_lowlag;
  States
  {
  Spawn:
	PSEV B 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PSEV B 3 Bright A_Look
    TNT1 A 0 A_SpawnItemEx("PestilenceFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	PSEV B 3 Bright A_Look
    TNT1 A 0 A_SpawnItemEx("PestilenceFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PSEV BBBB 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    PSEV B 1 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("PestilenceFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    PSEV B 1 Bright A_Chase("","")
    TNT1 A 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEV B 1 Bright A_Chase("","")
    TNT1 A 0 A_SpawnItemEx("PestilenceFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    PSEV B 1 Bright A_Chase("","")
    TNT1 A 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    TNT1 A 0 A_Jump(7,"Dodge")
    Loop
  Dodge:
    TNT1 A 0 A_Jump(256,"DodgeRight","DodgeLeft")
  DodgeLeft:
    TNT1 A 0 ThrustThing(angle*256/360+192,15,0,0)
    TNT1 A 0 A_JumpIfTargetInLos("Missile",360,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
    Goto See
  DodgeRight:
    TNT1 A 0 ThrustThing(angle*256/360+64,15,0,0)
    TNT1 A 0 A_JumpIfTargetInLos("Missile",360,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
    Goto See
  Melee:
  Missile:
    TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"HardMissile")
    TNT1 A 0 A_Jump(21,"Dodge")
    TNT1 A 0 A_Jump(64,"Tracers")
    Goto Normal
  Normal:
    PSEV J 2 Bright A_FaceTarget(45)
    PSEV J 10 Bright A_FaceTarget(45)
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,-16,0)
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,11,0)
	PSEV JK 5 Bright
    Goto See
  Tracers:
    PSEV J 13 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("PestilenceTracers",44,-16,0)
    PSEV K 8 Bright A_CustomMissile("PestilenceTracers",44,11,0)
    PSEV K 6 Bright
    Goto See
  Pain:
    TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Pain.Hard")
    TNT1 A 0 A_Jump(42,"Dodge")
    TNT1 A 0 A_Jump(104,"Missile")
    PSEV L 10 Bright A_Pain
    Goto See
  Pain.Hard:
    TNT1 A 0 A_Jump(71,"Dodge")
    TNT1 A 0 A_Jump(116,"Missile")
    PSEV L 5 Bright A_Pain
    Goto See
  HardMissile:
    TNT1 A 0 A_Jump(21,"Dodge")
    TNT1 A 0 A_Jump(100,"HardTracers","AcidShots")
  Hard:
    PSEV J 2 Bright A_FaceTarget(45)
    PSEV J 10 Bright A_FaceTarget(45)
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,-16,0)
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,11,0)
	PSEV J 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,-16,0)
	TNT1 A 0 A_CustomMissile("PestilenceLaser",44,11,0)
	PSEV JK 5 Bright
    Goto See
  HardTracers:
    PSEV J 13 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("PestilenceTracers", 38, -24, 0)
    PSEV K 8 Bright A_CustomMissile("PestilenceTracers", 38, 24, 0) 
	PSEV K 6 Bright
    Goto See
  AcidShots:
    PSEV J 13 Bright A_FaceTarget
    TNT1 A 0 A_CustomMissile("PestilenceAcid", 38, -24, frandom(-15,15))
    TNT1 A 0 A_CustomMissile("PestilenceAcid", 38, -24, frandom(-15,15))
    TNT1 A 0 A_CustomMissile("PestilenceAcid", 38, 24, frandom(-15,15))
    PSEV K 8 Bright A_CustomMissile("PestilenceAcid", 38, 24, frandom(-15,15))
	PSEV K 6 Bright
    Goto See
  XDeath:
  Death:
    PSEX A 2 Bright
    PSEX AAA 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 AAA 0 A_SpawnItemEx("GreenParticleSpawner",0,0,40,0,0,0,0,SXF_CLIENTSIDE,0)
    PSEX B 0 Bright A_Scream
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX B 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(5,-5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX B 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX B 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX B 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX B 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    PSEX C 0 A_NoBlocking
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX C 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(5,-5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX C 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX C 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    TNT1 A 0 A_ChangeFlag(NoGravity,0)
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX D 1 Bright
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX D 1 Bright
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX D 1 Bright
    TNT1 AA 0 A_SpawnItem("PestilenceGasSpawner",0,0,0,0)
    PSEX D 1 Bright
    PSEX EFG 3 Bright
    PSEX HHHHHHHHHHH 3 Bright A_FadeOut(0.1,1)
    Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor SummonedPestilence : Pestilence { -COUNTKILL }

Actor PestilenceTracers : CadaverRocket
{
  PoisonDamage 20
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Skeletons"
  DamageType "SoulToxic"
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    HMIG AAAA 1 Bright A_SpawnItemEx("PestilenceTracersTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
    TNT1 A 0 A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6),0,SXF_TRANSFERPOINTERS,0)
    Loop
  Homing:
    TNT1 A 0 A_Tracer2
	HMIG AAAA 1 Bright A_SpawnItemEx("PestilenceTracersTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6),0,SXF_TRANSFERPOINTERS,0)
	TNT1 A 0 A_Tracer2
	HMIG AAAA 1 Bright A_SpawnItemEx("PestilenceTracersTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6),0,SXF_TRANSFERPOINTERS,0)
    TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  XDeath:
  Death:
    TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
    TNT1 AAA 0 A_CustomMissile("Kaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
    TNT1 A 0 A_Explode(30,164)
    MIS3 BBBBBB 1 Bright A_SpawnItemEx("CacoLichPoison",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
    MIS3 CDEF 4 Bright A_SetTranslucent(0.75,1)
    Stop
  }
}

Actor PestilenceTracersTrail : CFSpawnerFXBase
{
  Height 1
  Radius 1
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleGreen2",0,frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 1
	Stop
  }
}

Actor PestilenceFX : RedParticleSpawner
{
  Renderstyle Add
  Alpha 0.15
  +NONETID
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1,3)
    TNT1 A 0 A_SpawnItemEx("PestilenceGas",frandom(-18,18),frandom(-18,18),frandom(16,28),1,0,frandom(1,3),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
    TNT1 A 0 A_SpawnItemEx("PestilenceGas",frandom(-18,18),frandom(-18,18),frandom(10,8),1,0,frandom(-3,-1),0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
    PSEV B 2 Bright
    PSEV BB 1 Bright A_FadeOut(0.1,1)
    Stop
  Vanilla:
    TNT1 A 1
    Stop
  }
}
    

Actor PestilenceGasSpawner : RedParticleSpawner
{
  -NONETID
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 1 A_SpawnItemEx("CacoLichPoison",frandom(-18,18),frandom(-18,18),frandom(10,8),1,0,frandom(-3,-1),0,0)
    Stop
  }
}

Actor PestilenceGas : PoisonSoulGas
{
  Scale 0.35
  //+NONETID
}