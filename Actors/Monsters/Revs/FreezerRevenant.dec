{
  Mass 1
  States
  {
  Spawn:
	TNT1 D 0
	CRI1 A 1 A_SpawnItemEx("CorruptedIceSparkle",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Crash:
	CRI1 D 1 A_FadeOut(0.01)
	Loop
  }
}

Actor CorruptedIceSparkle
{
  Renderstyle Translucent
  Alpha 0.50
  Scale 0.10
  Radius 0
  Height 0
  +NOGRAVITY
  +NOBLOCKMAP
  +NOLIFTDROP
  +NOTARGET
  +DONTSQUASH
  +NOTELEOTHER
  +NONSHOOTABLE
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    CRI2 A 0 
    CRI2 ABC 4 A_FadeOut(0.10)
    Goto Spawn+1
  }
}