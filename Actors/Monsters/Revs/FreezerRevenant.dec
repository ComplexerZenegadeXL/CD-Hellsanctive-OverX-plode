}


Actor FreezerHoming : CadaverRocket
{
  Speed 20
  FastSpeed 24
  Damage (Random(30,50)) //10
  Species "Skeletons"
  DamageType "RevIce"
  Decal "LegRocketScorch"
  SeeSound "monster/homingrockfire"
  States
  {
  Spawn:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    CURO A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	CURO A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    CURO A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	CURO A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    CURO A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	CURO A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    CURO A 2 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	CURO A 3 Bright A_CustomMissile("ProjectileTrailParticleBlue",frandom(0,2),frandom(-2,2))	
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("BlueKaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(68,128)
    TNT1 A 1 A_SpawnItem("BlueHomingEx")
    Stop
  }
}

Actor BlueHomingEx
{
  RenderStyle Add
  Alpha 0.85
  +CLIENTSIDEONLY
  +NOGRAVITY
  States
  {
  Spawn:
	BMSL B 6 Bright
	BMSL CD 5 Bright
	Stop
  }
}

Actor FrostFire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  RenderStyle Add
  Scale 0.5
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_ChangeVelocity(frandom(-0.75,0.75),frandom(-0.75,0.75),frandom(-0.75,0.75))
	PLSS ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Bright A_FadeOut
	Stop
  }
}

Actor FrostFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 0 A_SpawnItemEx("FrostFire",frandom(6,12),frandom(6,-6),frandom(62,72),0,0,frandom(1,2),0,SXF_CLIENTSIDE)
    TNT1 A 1
    Stop
  }
}

