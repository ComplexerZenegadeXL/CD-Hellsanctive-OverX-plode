{
 States
 {
  Spawn:
	TNT1 A 0
	CRI1 C 1 A_SpawnItemEx("CorruptedIceSparkle",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Crash:
	CRI1 C 1 A_FadeOut(0.01)
	Loop
  }
}

