    Stop
  }
}


Actor CorruptedIce1
{
  Scale 0.50
  Health 1
  Radius 8
  Height 1
  Mass 4
  +CORPSE
  +NOTELEPORT
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	CRI1 A 1 A_SpawnItemEx("CorruptedIceSparkle",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Crash:
	CRI1 A 1 A_FadeOut(0.01)
	Loop
  }
}

Actor CorruptedCRI2 : CorruptedIce1
{
  States
  {
  Spawn:
	TNT1 A 0
	CRI1 B 1 A_SpawnItemEx("CorruptedIceSparkle",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Crash:
	CRI1 B 1 A_FadeOut(0.01)
	Loop
  }
}

