Actor FreezerRevenant : Guardian 18554
{
  //$Category Monsters/LCA/DJB
  //$Sprite CREVA1D1
  //$Title "Freezer Revenant"
  Health 750
  PainChance 80
  BloodColor "00 88 ff"
  DropItem "BossLifeEssence" 250
  DropItem "BossArmorBonusMax" 250
  DropItem "NewCellPackPickup" 250
  DropItem "FreezerRifleGiver" 100
  DropItem "FreezerBFGGiver" 16
  Obituary "$CFFreezerRevenantObit"
  HitObituary "$CFFreezerRevenantHitObit"
  -FASTMELEE
  -LONGMELEERANGE
  +NOBLOOD
  Tag "$CFIceRev"
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "RevIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  SeeSound "monsters/hfirerevenantsight"
  DeathSound "monsters/hfirerevenantdeath"
  ActiveSound "monsters/hfirerevenantactive"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    CREV A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",28)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
    CREV A 3 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",28)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
    CREV AAABBBCCCDDDEEEFFF 2 Bright A_Chase
    Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    CREV AAABBBCCC 2 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    CREV DDDEEEFFF 2 Bright A_Chase
    Loop
  Melee:
    TNT1 A 0 A_FaceTarget
    CREV G 6 Bright A_SkelWhoosh
    CREV H 6 Bright A_FaceTarget
    CREV I 6 Bright A_SkelFist
	Goto See
  Missile:
	TNT1 A 0 A_SetUserVar("user_effect_type",29)
    CREV JJJJ 4 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",30)
	TNT1 A 0 A_CustomMissile("FreezerHoming",40,14,0)  
    CREV K 4 Bright A_CustomMissile("FreezerHoming",40,-14,0)
	CREV KKKKK 4 Bright
	Goto See
  Pain:
    TNT1 A 0 A_Jump(87,"MissilePain")
	TNT1 A 0 A_SetUserVar("user_effect_type",30)
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	CREV L 0 A_SpawnItemEx("CorruptedIce1", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LL 0 A_SpawnItemEx("CorruptedCRI2", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LLL 0 A_SpawnItemEx("CorruptedIce3", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LLLL 0 A_SpawnItemEx("CorruptedIce4", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    CREV L 2 Bright A_Pain		
    CREV L 8 Bright
	Goto See
  MissilePain:
	TNT1 A 0 A_SetUserVar("user_effect_type",30)
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	CREV L 0 A_SpawnItemEx("CorruptedIce1", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LL 0 A_SpawnItemEx("CorruptedCRI2", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LLL 0 A_SpawnItemEx("CorruptedIce3", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	CREV LLLL 0 A_SpawnItemEx("CorruptedIce4", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    CREV L 2 Bright A_Pain		
    CREV L 8 Bright
    Goto Missile	
  Death.PlayerIce:
  Death:
    CREV LM 7 Bright
    CREV N 7 Bright A_Scream
    CREV O 7 Bright A_NoBlocking
    TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
    CREV P -1 Bright
    Stop
  XDeath:
	CREX A 5 Bright A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
    CREX B 4 Bright A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    CREX C 4 Bright A_NoBlocking
    CREX D 4 Bright A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
    CREX E 4 Bright
    CREX F -1 Bright
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    CREV ONML 7 Bright
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	CREX FEDCBA 5 Bright
	Goto See
  }
}


Actor RevFreezeBlast
{
  Game Doom
  SpawnID 51
  Radius 13
  Height 8
  Speed 55
  Damage 8
  Projectile
  +RANDOMIZE
  RenderStyle Add
  Alpha 0.75
  Scale 0.9
  Species "Skeletons"
  DamageType "RevIce"
  SeeSound "weapons/iceshot"
  DeathSound "weapons/icehit"
  DamageType "Ice"
  Decal "FreezeBlastMelt"
  States
  {
  Spawn:
    FBLS A 6 Bright A_SpawnItem("FreezeBlastTrail")
    Loop
  Death:
    TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    FBLS BCDE 4 Bright
    Stop
  }
}
Actor FRZRRevBomb
{
  Radius 13
  Height 8
  Speed 25
  FastSpeed 30
  Damage (Random(20,35)) //6
  Scale 1.5
  Alpha 0.75
  RenderStyle Translucent
  Species "Skeletons"
  DamageType "RevIce"
  Projectile
  SeeSound "icespike"
  DeathSound "iceexplode"
  var int user_loop;
  States
  {
  Spawn:
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 A 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 B 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 C 1 Bright	
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	SHEX G 0 A_Explode(16,51,0)
  DeathLoop:
	SHEX G 0 A_CustomMissile("FRZRBehBombProj",0,0,user_loop *15,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 20,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	SHEX DCEFG 3 Bright
	Stop
  }
}

