Actor WidowMaker : Guardian 
{
  Health 750
  Speed 10
  PainChance 60
  +DONTHARMCLASS
  +DONTHARMSPECIES
  +MISSILEMORE
  +MISSILEEVENMORE
  +AVOIDMELEE
  +QUICKTORETALIATE
  +NODROPOFF
  Radius 22
  Height 60
  DamageFactor "CadaverRocket", 0.0
  DropItem "MinigunGiver" 255
  DropItem "LifeEssence" 150
  DropItem "ArmorBonusMax" 150
  DropItem "BackPack" 30
  SeeSound "widowmaker/sight"
  ActiveSound "widowmaker/act"
  PainSound "widowmaker/pain"
  DeathSound "widowmaker/death"
  Obituary "$CFWidowMakerObit"
  Tag "$CFWidow"
  States
  {
  Spawn:
    WDMK A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	WDMK O 10 A_Look
    Loop
  See:
    TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    WDMK AAABBB 2 A_Chase
    TNT1 A 0 A_SpawnItemEx("BonyStep",0,0,5,0,0,-20)
    WDMK CCCDDD 2 A_Chase
    Loop
  Melee:
    "####" "#" 0 A_FaceTarget
	"####" "#" 0 A_PlaySound("player/normjump")
    "####" "#" 8 A_Recoil(25)
	"####" "#" 0 A_PlaySound("plyrland")
    Goto Normal
	Pause:
	WDMK E 10
	Goto See
  Missile:
    TNT1 A 0 A_Jump(128,"SeekMissile","SeekMissile2")
  Normal:
    TNT1 A 0 A_PlaySound("weapons/mgunspinstart")
    WDMK E 10 A_FaceTarget
	TNT1 A 0 A_PlaySoundEx("weapons/mgunspin","Voice")
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(30,34),0,frandom(-5,5),0)
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 12, 6, 28, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySoundEx("weapons/minigunfire","Weapon")
    WDMK F 2 Bright A_CustomBulletAttack(11.5,4.0,1,Random(9,5),"WMPuff",0,CBAF_NORANDOM)
    WDMK E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("MonsterTracer",frandom(30,34),0,frandom(-5,5),0)
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 12, 6, 30, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySoundEx("weapons/minigunfire","Weapon")
    WDMK F 2 Bright A_CustomBulletAttack(11.5,4.0,1,Random(9,5),"WMPuff",0,CBAF_NORANDOM)
    WDMK E 3 A_FaceTarget
	TNT1 A 0 A_Jump(16,"Pause","SeekMissile")
	TNT1 A 0 A_StopSoundEx("Voice")
    TNT1 A 0 A_CPosRefire
    Goto See //Normal+2
  SeekMissile:
    WDMK EE 6 A_FaceTarget
	WDMK F 4 Bright A_CustomMissile("HellFireRocket",40,0,0)
	WDMK E 3 A_FaceTarget
	WDMK F 4 Bright A_CustomMissile("HellFireRocket",40,0,0)
	WDMK E 3 Bright
	Goto See
  SeekMissile2:
    WDMK G 0 //A_JumpIf(ceilingz-floorz<=175,"SeekMissile")
    WDMK G 1 A_FaceTarget
	WDMK G 5 
	WDMK G 1 A_FaceTarget
	WDMK G 3 A_PlaySound("widowmaker/beep")
	WDMK G 1 A_FaceTarget
	WDMK G 3 A_PlaySound("widowmaker/beep")
	WDMK G 1 A_FaceTarget
	WDMK G 3 A_PlaySound("widowmaker/beep")
	WDMK G 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("widowmaker/launch")
    WDMK H 4 Bright
	WDMK H 0 A_CustomMissile("widowmakerMiniRockets",55,40,-25,90) 
	WDMK H 0 A_CustomMissile("widowmakerMiniRockets",55,25,0,90) 
	WDMK H 0 A_CustomMissile("widowmakerMiniRockets",55,10,25,90) 
    WDMK H 2 Bright A_FaceTarget
	WDMK G 2
    Goto See
  Pain:
    TNT1 A 0 A_Jump(80,"PainMissile")
    WDMK I 5
    WDMK I 5 A_Pain
    Goto See
   PainMissile:
    WDMK I 5
    WDMK I 5 A_Pain
    Goto Missile
  Death:
  	WDMK P 7 A_Scream
	WDMK Q 7 
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WDMK R 7
    TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WDMK S 7 A_NoBlocking
	WDMK T -1
  Stop
  XDeath:
	WDMK I 7 A_Scream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	WDMK I 2 Bright 
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WDMK IIJJJ 1 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WDMK JJJKK 1 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	WDMK KKLLL 1 Bright A_CustomMissile("Kaboom17", frandom(10,50), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    WDMK M 6 A_NoBlocking
    WDMK N -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	WDMK TSRQP 4
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	WDMK NMLKI 4
	Goto See
  }   
}

Actor SummonedWidowMaker : WidowMaker { -COUNTKILL }

Actor WMPuff : CyNoblePuff { Species "Skeletons" DamageType "CadaverRocket" }

Actor WidowmakerMiniRockets : HellfireRocket
{
  Radius 10
  Height 10
  Speed 24
  Scale 0.7
  Damage (Random(12,36)) //6
  +SCREENSEEKER
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_Jump(128,"Homing")
  Normal:
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    Loop
  Homing:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2))
    CBRK A 1 Bright A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2))		
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(30,78)
    TNT1 A 1 A_SpawnItemEx("RocketEx")
    Stop
  }
}