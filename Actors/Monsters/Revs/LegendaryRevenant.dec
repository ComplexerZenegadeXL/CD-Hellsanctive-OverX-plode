  Actor LegendaryRevenant 16509
  {
  //$Category Monsters/LCA
  //$Sprite LREVA1D1
  //$Title "Legendary Revenant"
  Health 1350
  Radius 20
  Height 56
  Mass 1000
  Speed 12
  PainChance 55
  Monster
  MeleeRange 88
  MeleeThreshold 196
  +NORADIUSDMG
  +FLOORCLIP
  +QUICKTORETALIATE
  +NODROPOFF
  +MISSILEMORE
  +MISSILEEVENMORE  
  +NOICEDEATH
  +DONTGIB
  +FASTMELEE
  +BOSS
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +NOTARGET
  +NOTIMEFREEZE
  +NODROPOFF
  +NOFEAR
  +NOTELEFRAG
  Scale 1.1
  SeeSound "legendaryrevenant/see"
  PainSound "legendaryrevenant/pain"
  DeathSound "legendaryrevenant/death"
  ActiveSound "legendaryrevenant/idle"
  MeleeSound "skeleton/melee"
  BloodColor "Blue"
  MeleeDamage 7
  DamageFactor 0.55
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Legendary1", 0.0
  DamageFactor "LegendaryPlayer", 0.2
  DamageFactor "Legendary", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "CadaverRocket", 0.0
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.25
  DamageFactor "RevIce", 0.0
  DamageFactor "RevFire", 0.0
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  Species "Skeletons"
  DamageType "Legendary"
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryArmor" 127
  DropItem "LegendaryDemonRune" 64
  DropItem "LegendaryAmmoSphere" 88
  DropItem "LDemonAmmoPickup" 256
  DropItem "LDemonAmmoBoxPickup" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 180
  DropItem "SalvationSphere" 100
  DropItem "LegendaryRandomSphere" 16
  Obituary "$CFLegendaryRevenantObit"
  HitObituary "$CFLegendaryRevenantHitObit"
  Tag "$CFLegRev"
  var int user_loop;
  var int user_missile;
  var int user_fake;
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
  	LREV A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
  Idle:
    LREV A 10 Bright A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LREV AAABBBCCC 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
    TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,7)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    TNT1 A 0 A_Jump(100,"Rush")
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    LREV AAABBBCCC 2 Bright A_Chase
    TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
    LREV DDDEEEFFF 2 Bright A_Chase
	TNT1 A 0 A_Jump(28,"Dodge")
	TNT1 A 0 A_Jump(16,"Teleport")
    Loop
  Rush:
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	LREV A 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase
	LREV B 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase	
	LREV C 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase	
	TNT1 A 0 A_SpawnItemEx("LegendaryBonyStep",0,0,5,0,0,-20)
	LREV D 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase
	LREV E 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase	
	LREV F 2 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LREV AAAA 0 A_Chase	
	TNT1 A 0 A_Jump(28,"Dodge")
	TNT1 A 0 A_Jump(12,"Teleport")
	TNT1 A 0 A_Jump(75,"See")
	Loop
  Teleport:
    LREV K 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LREV KKKKKKKKKK 1 A_FadeOut(0.1,0)
	LREV K 2
	LREV KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK 0 A_Wander
    LREV K 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LREV KKKKKKKKKK 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LREV K 1 Bright A_SetShootable
    Goto See
  Dodge:
    LREV A 1 A_JumpIfTargetInLos(1)
	Goto See
  	LREV A 1 Bright A_SetAngle(frandom(0,360))
    TNT1 A 0 A_Recoil(-40)
	LREV AAAAAAAAAAAAA 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 A_Stop	
  	LREV A 1 A_SetAngle(frandom(0,360))
    TNT1 A 0 A_Recoil(-40)	
	LREV AAAAAAAAAAAAA 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 A_Stop	
  	LREV A 1 A_SetAngle(frandom(0,360))
    TNT1 A 0 A_Recoil(-40)
	LREV AAAAAAAAAAAAA 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 A_Stop	
  	LREV A 1 A_SetAngle(frandom(0,360))
    TNT1 A 0 A_Recoil(-40)
	LREV AAAAAAAAAAAAA 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 A_Stop		
    Goto See
  Melee:
    LREV G 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
    LREV G 1 Bright A_Jump(127,4)
    LREV G 2 Bright A_SkelWhoosh
    LREV H 2 Bright A_FaceTarget
    LREV I 2 Bright A_SkelFist
    Goto See
    LREV R 2 Bright A_SkelWhoosh
    LREV S 2 Bright A_FaceTarget
    LREV T 2 Bright A_SkelFist
    Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",3)
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(48,"BestAttack")
    TNT1 A 0 A_Jump(156,"Rage","Rocket","DeadHands","Railgun","RandomAngle")
    TNT1 A 0 A_JumpIfCloser(350,"DashPunch")
  Normal:		
    LREV J 10 Bright A_FaceTarget
    LREV K 0 A_CustomMissile("LegRevBall",65,-13,0)	
    LREV K 10 Bright A_CustomMissile("LegRevBall",65,13,0)
    LREV K 10 Bright A_FaceTarget
	TNT1 A 0 A_Jump(156,"Normal","Rocket")
    Goto See
  Rocket:		
    LREV J 3 Bright A_FaceTarget
    LREV K 0 A_CustomMissile("LegRevRocket",65,-13,0)	
    LREV K 6 Bright A_CustomMissile("LegRevRocket",65,13,0)
    LREV K 6 Bright A_FaceTarget
	LREV J 3 Bright A_FaceTarget
    LREV K 0 A_CustomMissile("LegRevRocket",65,-13,0)	
    LREV K 6 Bright A_CustomMissile("LegRevRocket",65,13,0)
    LREV K 6 Bright A_FaceTarget
	TNT1 A 0 A_Jump(156,"RandomAngle")
    Goto See
  RandomAngle:		
    LREV J 10 Bright A_FaceTarget
	LREV J 1 Bright A_SetUserVar("user_missile",0)
  Randoming:
    LREV K 0 A_JumpIf(user_missile >= 24,"Ending")	 
    LREV K 0 A_SetUserVar("user_missile",user_missile+1)
	LREV K 0 A_SetAngle(random(0,359))	
    LREV K 0 A_CustomMissile("LegRevBall",65,-13,frandom(0,360))	
    LREV K 2 Bright A_CustomMissile("LegRevBall",65,13,frandom(0,360))
    Loop
  Ending:
    LREV K 1 Bright A_Jump(156,"DeadHands")
    Goto See
  DeadHands:	
    LREV GH 3 Bright A_FaceTarget
    LREV I 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	LREV RS 3 Bright A_FaceTarget
    LREV T 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
    LREV GH 3 Bright A_FaceTarget
    LREV I 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	LREV RS 3 Bright A_FaceTarget
    LREV T 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	TNT1 A 0 A_Jump(156,"Railgun")
    Goto See	
  Railgun:
    LREV J 1 Bright A_PlaySound("legendaryrevenant/see")
	LREV J 0 A_SetInvulnerable
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LREV J 1 Bright A_FaceTarget
	LREV J 1 Bright A_SetUserVar("user_missile",0)
	LREV JJJJJJJJ 4 A_FaceTarget
	LREV J 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LREV J 0 A_UnSetInvulnerable
	LREV K 0 A_FaceTarget	
	LREV K 0 A_PlayWeaponSound("monsters/darkcyberrail")
    LREV K 0 A_CustomMissile("LegRevRailgunProj",70,-26,0)	
    LREV K 3 Bright A_CustomMissile("LegRevRailgunProj",70,26,0)
	TNT1 A 0 A_Jump(156,"Rage")
    Goto See
  Rage:
    LREV J 1 Bright A_PlaySound("legendaryrevenant/attack1")
	LREV J 0 A_GiveInventory("BossProtectionTierI",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LREV J 1 Bright A_FaceTarget
	LREV J 1 Bright A_SetUserVar("user_missile",0)
	LREV JJJJJJJJ 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LREV J 0 A_ChangeFlag("NOPAIN",1)
    LREV J 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
  Raging:
    LREV K 0 A_JumpIf(user_missile >= 28,"See")	 
    LREV K 0 A_SetUserVar("user_missile",user_missile+1)
	LREV K 0 A_FaceTarget	
    LREV K 0 A_CustomMissile("LegRevBall2",70,-13,0)	
    LREV K 3 Bright A_CustomMissile("LegRevBall2",70,13,0)
    Loop	
  BestAttack:		
    LREV J 1 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	LREV J 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	LREV J 0 A_PlaySound("legendaryrevenant/attack2")
	LREV JJJJJJ 4 Bright A_FaceTarget
	LREV J 2 Bright A_PlayWeaponSound("lrball3/charge")
	LREV JJJJJJJJJJJJJJJ 4 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LREV J 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	LREV J 10 Bright A_FaceTarget
	LREV K 0 A_PlayWeaponSound("lrball3/shot")
    LREV K 0 A_CustomMissile("LegRevBall3",65,-13,0)	
    LREV K 10 A_CustomMissile("LegRevBall3",65,13,0)
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
    LREV K 10 A_FaceTarget
  DashPunch:
    TNT1 A 0 A_Jump(128,"Normal")
	TNT1 A 0 A_FaceTarget
    TNT1 A 0 A_Recoil(-65)
    TNT1 A 0 A_SkelWhoosh	
	LREV GGGGG 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV HHHHH 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LRDashPunch",32,0,0,CMF_AIMDIRECTION)
	LREV III 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 Bright A_Stop	
	LREV A 1 Bright A_FaceTarget
    TNT1 A 0 A_Recoil(-65)
    TNT1 A 0 A_SkelWhoosh	
	LREV RRRRR 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV SSSSS 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LRDashPunch",32,0,0,CMF_AIMDIRECTION)
	LREV TTT 1 Bright A_SpawnItemEx("LRGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	LREV A 1 Bright A_Stop			
    Goto See
  Pain:
    TNT1 A 0 A_Jump(8,"Rage")	
	TNT1 A 0 A_Jump(128,"Fake") //32
  	TNT1 A 0 A_Jump(21,"Teleport")
	TNT1 A 0 A_Jump(128,"PainMissile")
    LREV L 3 Bright
    LREV L 3 Bright A_Pain 
    Goto See
  PainMissile: 
    LREV L 3 Bright	
    LREV L 3 Bright A_Pain
    Goto Missile	
  Fake:
  	TNT1 A 0 A_JumpIf(user_fake >= 2,"See")	 
    TNT1 A 0 A_SetUserVar("user_fake",user_fake+1)
	TNT1 A 0 A_ChangeFlag("SHOOTABLE",0)
    TNT1 A 0 A_ChangeFlag("SOLID",0)
	TNT1 A 0 A_ChangeFlag("ISMONSTER",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LREV LM 7
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SetUserVar("user_music",0)
	LREV N 7 A_PlaySoundEx("legendaryrevenant/death","body",0,1)
    LREV O 7
	LREV P 0 A_SpawnItemEx("BossArmorBonusMax",0,0,0,0,0,0,0,0,64)
	LREV P 7 A_SpawnItemEx("BossLifeEssence",0,0,0,0,0,0,0,0,64)
    LREV Q 17
	LREV QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	LREV Q 175
	LREV Q 0 A_PlaySound("misc/gibbed")
  	LREV Q 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	LREV Q 0 A_ChangeFlag("SHOOTABLE",1)
    LREV Q 5 A_ChangeFlag("SOLID",1)
	TNT1 A 0 A_ChangeFlag("ISMONSTER",1)
	LREV P 0 A_PlaySoundEx("legendaryrevenant/see","body",0,1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LREV PONML 5
    Goto See
  Death:
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,37)
	TNT1 A 0 A_DropItem("LegendaryDust",random(3,5),256)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("GetCVar",3) == 1, "Death2")
	TNT1 A 0 A_StopSound(6)
	LREV LM 7
	LREV N 7 A_Scream
	LREV O 7 A_NoBlocking
	LREV P 7
	LREV Q 17
	LREV QQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREV QQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))	
	LREV QQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREV QQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	LREV QQQQQQQQQQQQQ 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREV Q -1
	Stop
  Death2:
	TNT1 A 0 A_StopSound(6)
	LREV LLLLL 3 A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-4,4),frandom(-4,4),frandom(0,4),0)
	TNT1 A 0 A_Scream
	LREX AAABBBCCCDDDEEE 2 Bright A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-10,10),frandom(-10,10),frandom(0,10),0)
	TNT1 A 0 A_NoBlocking
	LREX FFGGHH 3 Bright A_SpawnItemEx("PainfulDeathKaboom",frandom(-32,32),frandom(-40,40),frandom(16,48),frandom(-10,10),frandom(-10,10),frandom(0,10),0)
	LREX IJ 8
	LREX K 17
	LREX KKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREX KKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))	
	LREX KKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREX KKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128))
	LREX KKKKKKKKKKKKK 2 A_SpawnItemEx("LRUndeadHand",frandom(-128,128),frandom(-128,128),-9999)
	LREX K -1
	Stop
  }
}

Actor LegRevBall
{
  Radius 8
  Height 8
  Speed 42
  Damage (Random(20,30)) //5
  Scale 1.5
  Projectile
  RenderStyle Add
  +SPAWNSOUNDSOURCE
  +SEEKERMISSILE
  +NOTIMEFREEZE
  Alpha 0.8
  SeeSound "lrball1/shot"
  DeathSound "lrball1/exp"
  Species "Skeletons"
  DamageType "Legendary"
  Decal "CacoScorch"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Homing")	
  Normal:
    LRB1 ABCD 2 A_CustomMissile("LegRevBallFX",0,0,0,0)
    Loop
  Homing:
	TNT1 A 0 A_SeekerMissile(15,0)
    LRB1 A 2 A_CustomMissile("LegRevBallFX",0,0,0,0)
	TNT1 A 0 A_SeekerMissile(15,0)
    LRB1 B 2 A_CustomMissile("LegRevBallFX",0,0,0,0)
	TNT1 A 0 A_SeekerMissile(15,0)
    LRB1 C 2 A_CustomMissile("LegRevBallFX",0,0,0,0)
	TNT1 A 0 A_SeekerMissile(15,0)
    LRB1 D 2 A_CustomMissile("LegRevBallFX",0,0,0,0)		
    Loop	
  Death:
	LRB1 ABCD 4 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(48,64,0) 
	TNT1 A 0 A_PlaySound("weapons/clrocketexplode")
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    LRB1 EFGHIJKLMNO 3
    Stop
  }
}

Actor LegRevBallFX
{   
  Radius 2
  Height 2
  Speed 0
  Projectile
  RenderStyle Add
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  Scale 0.9
  Alpha 0.67
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LRBF PQ 4 Bright A_FadeOut(0.1)
    Loop
  Vanilla:
    TNT1 A 0
	Stop	  
  }
}

Actor LegRevBall2
{
  Radius 5
  Height 5
  Projectile
  Speed 75
  Damage (Random(20,30)) //6
  Species "Skeletons"
  DamageType "Legendary"
  +RANDOMIZE
  +NOTIMEFREEZE
  RenderStyle Add
  Alpha 0.8
  Scale 1
  SeeSound "lrball2/shot"
  DeathSound "lrball2/exp"
  Decal "Scorch"
  States
  {
  Spawn: 
  	LRB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    LRB2 A 1 Bright A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	LRB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    LRB2 B 1 Bright A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
  	LRB2 A 0 A_ChangeVelocity(1,frandom(-1.5,1.5),frandom(-1,1),CVF_RELATIVE)
    LRB2 C 1 Bright A_SpawnItemEx("LegRevBall2Trail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)	
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    LRB2 EFGHIJKLMNO 3 Bright
    Stop
  }
}

