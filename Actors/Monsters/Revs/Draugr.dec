Actor Draugr : Guardian
{
  Monster
  Health 900
  Mass 800
  Height 56
  Radius 18
  Speed 4
  YScale 0.78
  XScale 0.7
  BloodColor "Green"
  MeleeRange 360
  ReactionTime 25
  PainChance "Mine", 128
  PainChance 28
  +FLOORCLIP
  +AVOIDMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  DamageType "Draugr"
  DamageFactor "Acid", 0.8
  DamageFactor "Fire", 0.1
  //No infighting
  DamageFactor "Revenant", 0.0
  DamageFactor "Draugr", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "RevIce", 0.0
  DropItem "BossLifeEssence", 200, 8
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "MissilePickup", 250, 10
  DropItem "MineAmmoRandomizer", 180, 2
  DropItem "HandGrenadeAmmo", 200, 6
  DropItem "AmmoPack", 190, 3
  SeeSound "SUPA6"
  ActiveSound "SUPA6"
  PainSound "SUPA5"
  DeathSound "DraugrDie"
  Obituary "$CFDraugrObit"
  Tag "$CFDraugr"
  States
  {
  Spawn:
	DRAU A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DRAU A 10 A_Look
	Loop
  See:
	DRAU AAAA 1 A_Chase("","")
	DRAU AA 1 A_Chase
	DRAU BBBB 1 A_Chase("","")
	DRAU BB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	DRAU CCCC 1 A_Chase("","")
	DRAU CC 1 A_Chase
	DRAU DDDD 1 A_Chase("","")
	DRAU DD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	TNT1 A 0 Healthing(1)
	Loop
  HardChoice:
	TNT1 A 0 A_Jump(110,"Meteors")
	TNT1 A 0 A_Jump(89,"Grenades")
	TNT1 A 0 A_Jump(52,"PyroRockets")
	Goto Normal
  Melee:
  Missile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 //A_CustomMissile("BribeCaco",1,0,0,2,-90)
	TNT1 A 0 A_Jump(128,"Meteors")
	TNT1 A 0 A_Jump(80,"Grenades")
	TNT1 A 0 A_Jump(25,"PyroRockets")
  Normal:
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Hard")
	DRAU EE 5 A_FaceTarget(45)
	DRAU F 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	DRAU G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	DRAU F 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	DRAU G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	DRAU E 9
	Goto See
  Meteors:
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Meteors.Hard")
	DRAU EE 5 A_FaceTarget(45)
	DRAU F 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,11,0)
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,-11,0)
	DRAU E 15
	Goto See
  PyroRockets:
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"PyroRockets.Hard")
	DRAU III 4 A_FaceTarget(45)
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU II 5 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU II 5 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU I 18
	Goto See
  Grenades:
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"Grenades.Hard")
	DRAU II 5 A_FaceTarget(45)
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	TNT1 A 0 A_CustomMissile("DraugrGrenade",44,0,frandom(-5,5))
	DRAU I 18
	Goto See
  Hard:
	DRAU EE 5 A_FaceTarget
  HardLoop:
	DRAU F 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	DRAU G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,11,frandom(-7,7))
	TNT1 A 0 A_CustomMissile("RevMiniRocket",44,-11,frandom(-7,7))
	TNT1 A 0 A_Jump(11,3)
	TNT1 A 0 A_JumpIfTargetInLOS("HardLoop",130,0,600)
	TNT1 A 0 A_Jump(16,1)
	Loop
	DRAU E 9
	Goto See
  Meteors.Hard:
	DRAU EE 5 A_FaceTarget
	DRAU F 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,11,0)
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,-11,0)
	DRAU E 2 A_FaceTarget
	DRAU G 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,11,0)
	TNT1 A 0 A_CustomMissile("DraugrMeteor",44,-11,0)
	DRAU E 15
	Goto See
  PyroRockets.Hard:
	DRAU II 7 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrScan",10,0,0,CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,0)
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU II 5 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("DraugrScan",10,0,frandom(360,0),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,0)
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU II 5 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 AAA 0 A_CustomMissile("DraugrScan",10,0,frandom(360,0),CMF_ABSOLUTEANGLE|CMF_ABSOLUTEPITCH,0)
	TNT1 A 0 A_CustomMissile("DraugrMissile",44,0,frandom(-5,5))
	DRAU I 18
	Goto See
  Grenades.Hard:
	DRAU II 5 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
	TNT1 A 0 A_CustomMissile("DraugrGrenade",44,0,frandom(-5,5))
	DRAU I 3 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrGrenade",44,0,frandom(-5,5))
	DRAU I 3 A_FaceTarget
	DRAU J 3 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DraugrGrenade",44,0,frandom(-5,5))
	DRAU I 18
	Goto See
  Pain:
	TNT1 A 0// A_CustomMissile("BribeCaco",1,0,0,2,-90)
	TNT1 A 0 A_Jump(48,"PainMissile")
	DRAU H 3 A_Pain
	DRAU H 5
	Goto See
  PainMissile:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DRAU H 3 A_Pain
	DRAU H 5
	Goto Missile
  XDeath:
  Death:
	DRAU H 4 A_Scream
	DRAU K 3
	DRAU L 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,44,0,0,0,0,SXF_CLIENTSIDE)
	DRAU M 4 A_Fall
	DRAU NOPQRSTU 4
	DRAU V -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DRAU UTSRQPONMLK 4
	Goto See
  }
}

Actor SummonedDraugr : Draugr { -COUNTKILL }

Actor DraugrMeteor : GuardianTracer
{
  Speed 20
  FastSpeed 24
  +DONTHARMSPECIES
}

Actor RevMiniRocket : MiniRocket
{
  Species "Skeletons"
  Damagetype "CadaverRocket"
  Damage (Random(24,40))
  States
  {
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,1,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_Explode(2,30,1,1)
	TNT1 A 0 A_SetTranslucent(0.85,1)
	H2BL JKLMN 4 Bright
	Stop
  }
}

Actor DraugrMissile : Rocket
{
  Speed 26
  Damage (Random(64,128)) //24
  -ROCKETTRAIL
  +DONTHARMSPECIES
  Species "Skeletons"
  DamageType "CadaverRocket"
  SeeSound "rocket/fire"
  States
  {
  Spawn:
	MIS9 A 2 Bright A_SpawnItemEx("DraugrMissileTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(Random(90,110),128,0)
	TNT1 AAAAAAAAAA 0 A_CustomMissile("DraugrFireSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 1 A_SpawnItem("RocketEx")
	Stop
  }
}

Actor DraugrMissileTrail
{
  Height 1
  Radius 1
  RenderStyle None
  +NOTIMEFREEZE
  +DONTBLAST
  +NOTELEPORT
  +NOTONAUTOMAP
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	TNT1 A 0 A_CustomMissile("MissileTrail",0,frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",0,frandom(-2,2),0,CMF_AIMDIRECTION)
	TNT1 A 1 A_SpawnItemEx("FireSpawnerTail",-3,0,8)
	Stop
  Vanilla: 
	TNT1 A 0
	Stop
  }
}

Actor DraugrFireSpawner : BaseFireSpawner
{
  Damage (Random(50,60))
  Species "Skeletons"
  DamageType "CadaverRocket"
  States
  {
  Death:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_NoGravity
	TNT1 A 0 A_SpawnItemEx("BaseFireSpawnerExplodeFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("DraugrFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AAAA 0 A_SpawnItemEx("DraugrFlare",0,0,0,frandom(2,4),frandom(2,4),CMF_AIMDIRECTION,frandom(0,360),SXF_TRANSFERPOINTERS|SXF_NOCHECKPOSITION,64)
	FRTM CDE 3 Bright
	Stop
  }
}

Actor DraugrFlare : BaseFireFlare
{
  Species "Skeletons"
  DamageType "CadaverRocket" 
  Obituary "$CFDraugrFlareObit"
}

Actor DraugrGrenade
{
  Projectile
  Height 6
  Radius 6
  Speed 30
  FastSpeed 24
  Scale 0.75
  Gravity 0.4
  Bouncetype Doom
  WallBounceFactor 0.25
  BounceFactor 0.36
  Reactiontime 245
  Damage (Random(50,110)) //20
  +DONTSPLASH
  +DOOMBOUNCE
  -NOGRAVITY
  -GRENADETRAIL
  -ROCKETTRAIL
  +DONTHARMSPECIES
  Species "Skeletons"
  DamageType "CadaverRocket"
  SeeSound "Weapons/GrenadeBounce"
  DeathSound "Weapons/RockLX"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_StopSound
  SpawnLoop:
	GRND A 1 A_CustomMissile("GrenadeTrail",frandom(-1,1),frandom(-1,1))
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("Kaboom3",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2",0,0,random(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE,0)
	TNT1 AAAAA 0 A_CustomMissile("ExplosiveFrag",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_Explode(random(120,130),128,0)
	TNT1 A 1 A_SpawnItem("RocketEx")
	Stop  
  }
}

Actor ExplosiveFrag
{
  Projectile
  Height 4
  Radius 4
  Speed 11
  Scale 0.3
  Decal "Scorch"
  Gravity 1.0
  Bouncetype Hexen
  BounceFactor 1.05
  BounceCount 3
  WallBounceFactor 1.05
  ReactionTime 245
  Damage 1
  +HEXENBOUNCE
  -NOGRAVITY
  +DONTHARMSPECIES
  Species "Skeletons"
  DamageType "CadaverRocket"
  SeeSound "ZZZFragBounce"
  DeathSound "PulseNail/hit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_StopSound
  SpawnLoop:
	BALL A 1 Bright
	TNT1 A 0 A_Countdown
	Loop
  Death:
	TNT1 A 0 A_Explode(35,90,0)
	TNT1 AAA 0 A_SpawnItemEX("Kaboom9",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(0,360))
	TNT1 AAA 0 A_SpawnItemEX("SmokeFX4",0,0,0,frandom(-2,2),frandom(-2,2),frandom(-2,2),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,1,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SetTranslucent(0.85,1)
	MISL BCD 4 Bright
	Stop
  }
}