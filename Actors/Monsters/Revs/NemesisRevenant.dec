  MoreLasersLoop:
	NMRV JJJ 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("NemesisCannon/Laser",7)
	TNT1 A 0 A_CustomMissile("NemesisRevCannonLaser",65,-13,0)  
