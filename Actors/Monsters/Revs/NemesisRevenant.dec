	NMRV J 1 Bright A_SetUserVar("user_missile",0)
	NMRV JJJJJJ 4 Bright A_FaceTarget
    TNT1 A 0 A_ChangeFlag("NOPAIN",1)
  Raging2:
	TNT1 A 0 A_JumpIf(user_missile >= 20,"See")   
	TNT1 A 0 A_SetUserVar("user_missile",user_missile+1)
	TNT1 A 0 A_FaceTarget  
	TNT1 A 0 A_CustomMissile("NemesisRevComet",70,-13,frandom(-10,10))  
	NMRV K 8 Bright A_CustomMissile("NemesisRevComet",70,13,frandom(-10,10))  
	Loop
  BestAttack:	
    TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_SetUserVar("user_effect_delay",2)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	NMRV J 1 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_PlaySound("NemesisRevenant/attack2",CHAN_VOICE)
