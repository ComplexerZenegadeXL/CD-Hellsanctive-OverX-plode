	NMRV K 6 Bright A_FaceTarget
	NMRV J 3 Bright A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 6,1)
	Loop
	TNT1 A 0 A_Jump(156,"Rocket","HomingMissiles")
