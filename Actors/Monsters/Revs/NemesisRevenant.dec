	NMRV GH 3 Bright A_FaceTarget
	NMRV I 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	NMRV RS 3 Bright A_FaceTarget
	NMRV T 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	NMRV GH 3 Bright A_FaceTarget
	NMRV I 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	NMRV RS 3 Bright A_FaceTarget
	NMRV T 3 Bright A_CustomMissile("LegRevFloorDeadHands",0,0,0)
	NMRV GH 3 Bright A_FaceTarget
