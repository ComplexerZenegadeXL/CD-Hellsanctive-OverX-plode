Actor NemesisRevComet : Comet
{
  Radius 8
  Height 8
  Speed 45
  Damage (Random(25,30)) //6
  Scale 0.45
  Species "Skeletons"
  DamageType "Nemesis"
  +NOTIMEFREEZE
  +SEEKERMISSILE
  SeeSound "weapons/firbfi"
  DeathSound "weapons/hellex"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Jump(128,"Homing")
  Normal:
	TNT1 A 0 A_BishopMissileWeave
	NNCM A 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0  A_BishopMissileWeave
	NNCM B 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0  A_BishopMissileWeave
	NNCM C 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Homing:
	TNT1 A 0 A_SeekerMissile(15,0)
	TNT1 A 0  A_BishopMissileWeave
	NNCM A 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0  A_BishopMissileWeave
	NNCM B 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0  A_BishopMissileWeave
	NNCM C 1 Bright A_SpawnItemEx("NemesisRevCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_Explode(64,120,0)
	NNCM DE 3 Bright
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("NemesisRevCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

