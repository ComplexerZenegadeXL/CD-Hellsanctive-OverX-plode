	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_BishopMissileWeave
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	NMIS A 1 Bright A_CustomMissile("ProjectileTrailParticleNemesis",frandom(0,2),frandom(-2,2))	
    TNT1 A 0 A_PlaySound("monster/homingrockbeep")
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("NemesisWhiteParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("WhiteNemesisKaboom3",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX2",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("LegendaryDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(70,128)
	TNT1 A 1 A_SpawnItem("NemesisRocketEx")
	Stop
  }
}

