  DashPunch:
	TNT1 A 0 A_Jump(128,"Normal")
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_Recoil(-65)
	TNT1 A 0 A_SkelWhoosh  
	NMRV GGGGG 1 Bright A_SpawnItemEx("NemesisRevGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	NMRV HHHHH 1 Bright A_SpawnItemEx("NemesisRevGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_CustomMissile("LRDashPunch",32,0,0,CMF_AIMDIRECTION)
	NMRV III 1 Bright A_SpawnItemEx("NemesisRevGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
