Actor InsanityRevenant : Guardian
{
  PainChance 70
  Health 950
  Speed 12
  DamageFactor "Normal", 0.65
  SeeSound "famine/sight"
  PainSound "guardian/pain"
  DeathSound "famine/death"
  ActiveSound "famine/active"
  Obituary "$CFInsanityRevenantObit"
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "DemonAmmoBoxPickup" 128 200
  MeleeThreshold 60
  +QUICKTORETALIATE
  -LONGMELEERANGE
  +MISSILEEVENMORE
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOGRAVITY
  +DONTFALL
  +FLOAT
  +NOGRAVITY	
  -FLOORCLIP
  Tag "$CFInsRev"
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
	INRV B 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",37)
	TNT1 A 0 A_SetUserVar("user_effect_delay",4)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	INRV BB 4 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	//TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	INRV BB 4 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_effect_type",37)
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	INRV BB 4 Bright A_Chase
	TNT1 A 0 A_Jump(7,"Evade")
	Loop
   Evade:
	TNT1 A 0 A_Jump(128,19)
	TNT1 A 0 ThrustThing(Angle*256/360+64,20,0,0)
	INRV BBBBBBBB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,20,0,0)
	INRV BBBBBBBB 2 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See 
  Melee:
  Missile:
	TNT1 A 0 A_Jump(100,"Railguns","lasers","FastRockets","BFG15K") 
  Spam:
	INRV JJJJ 5 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GuardianTracer2",54,-16,frandom(-3,3))
	INRV KK 3 Bright A_CustomMissile("GuardianTracer2",54,16,frandom(-3,3)) 
	INRV K 7 Bright A_FaceTarget
	TNT1 A 0 A_Jump(60,"pause")
	TNT1 A 0 A_SpidRefire
	Goto Spam+4
  Pause:
	INRV B 10 Bright
	Goto see
  Railguns:
	TNT1 A 0 A_changeflag("Nopain",1)
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	INRV JJJJ 5 A_FaceTarget
	INRV J 4 A_FaceTarget
    TNT1 A 0 A_PlaySound("railgunner/chargedshot")
	TNT1 A 0 A_CustomMissile("ELegRevRailgunProj",54,-16,0)
	INRV K 4 Bright A_CustomMissile("ELegRevRailgunProj",54,16,0) 
	TNT1 A 0 A_ChangeFlag("Nopain",0)
	Goto see
  Lasers:
	TNT1 A 0 A_PlaySound("weapons/rgcharge")
	INRV JJJJ 5 A_FaceTarget
	INRV J 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	TNT1 A 0 A_CustomMissile("InsaneBonerLaser",54,-16,0)
	INRV K 0 A_CustomMissile("InsaneBonerLaser",54,16,0) 
	INRV JJ 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	TNT1 A 0 A_CustomMissile("InsaneBonerLaser",54,-16,0)
	INRV K 0 A_CustomMissile("InsaneBonerLaser",54,16,0) 
	INRV JJ 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("monsters/fusionfire")
	TNT1 A 0 A_CustomMissile("InsaneBonerLaser",54,-16,0)
	INRV K 0 A_CustomMissile("InsaneBonerLaser",54,16,0) 
	Goto See
  BFG15K:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
	INRV JJJJJ 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CerebralIncarnate10kBall",54,-16,0)
	INRV K 10 Bright A_CustomMissile("CerebralIncarnate10kBall",54,16,0) 
	TNT1 A 0 
	INRV J 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CerebralIncarnate10kBall",54,-16,0)
	INRV K 10 Bright A_CustomMissile("CerebralIncarnate10kBall",54,16,0) 
	INRV J 4 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CerebralIncarnate10kBall",54,-16,0)
	INRV K 10 Bright A_CustomMissile("CerebralIncarnate10kBall",54,16,0) 	
    Goto See
  FastRockets:
	INRV JJJJ 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("WarShoulderRocketHoming",54,-16,0)
	INRV K 10 Bright A_CustomMissile("WarShoulderRocketHoming",54,16,0) 
	INRV JJ 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("WarShoulderRocketHoming",54,-16,0)
	INRV K 10 Bright A_CustomMissile("WarShoulderRocketHoming",54,16,0) 
	INRV JJ 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("WarShoulderRocketHoming",54,-16,0)
	INRV K 10 Bright A_CustomMissile("WarShoulderRocketHoming",54,16,0) 
    Goto See
  Pain:
	INRV L 10 Bright A_Pain
	TNT1 A 0 A_Jump(104,"Missile")
	Goto See
  Death:
  XDeath:
	INRV L 2 Bright
	INRV LLL 1 Bright A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),Random(-3,6))
	TNT1 A 0 A_Scream
	TNT1 A 0 A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	INRV LLLLL 1 Bright A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	TNT1 A 0 A_NoBlocking
	TNT1 AA 0 A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	INRV LLL 1 Bright A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	TNT1 AA 0 A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	INRV LLLL 1 Bright  A_SpawnItemEx("CFKaboom",0,0,10,frandom(-5,5),frandom(-5,5),frandom(-3,6))
	TNT1 AAA 1
	Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor BonerFire
{
  +MISSILE
  +DONTSPLASH
  +CLIENTSIDEONLY
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  RenderStyle Add
  Scale 0.3
  States
  {
  Spawn:
	2HD2 ABCDEFGHIJKL 2 Bright A_FadeOut
	Stop
  }
}

Actor BonerFireSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_PlaySound("monster/ambientfire")
    TNT1 AAAA 0 A_SpawnItemEx("BonerFire",frandom(-12,12),frandom(-12,12),frandom(25,50),0,0,frandom(-5,0),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor SummonedInsanityRevenant : InsanityRevenant { -COUNTKILL }

Actor GuardianTracer2 : GuardianTracer { Speed 18 -SEEKERMISSILE }

Actor InsaneBonerLaser : SpecOpsLaser { Species "Skeletons" Damagetype "CadaverRocket" Damage (Random(40,80)) } //15