Actor PatriarchVexedNemesisZombie : VexedNemesisZombie { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisAssaultCaptain : VexedNemesisAssaultCaptain { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisImp : VexedNemesisImp { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisCommando : VexedNemesisCommando { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisRevenant : VexedNemesisRevenant { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisCydestroyer : VexedNemesisCydestroyer { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisExile : VexedNemesisExile { Species "NemesisPatriarch" +THRUSPECIES }
Actor PatriarchVexedNemesisExileFinal : VexedNemesisExileFinal { Species "NemesisPatriarch" +THRUSPECIES }

Actor VexedSquad1Spawner
{
  States
  {
  Spawn:
	TNT1 AA 0 NoDelay A_SpawnItemEx("VexedSquad1Spawner2",frandom(-250,250),frandom(-250,250),0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	TNT1 AA 0 A_SpawnItemEx("VexedSquad1Spawner3",frandom(-250,250),frandom(-250,250),0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor VexedSquad1Spawner2
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 0 A_SpawnItemEx("PatriarchVexedNemesisZombie",0,0,0,0,0,0,frandom(0,360),SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor VexedSquad1Spawner3
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 0 A_SpawnItemEx("PatriarchVexedNemesisAssaultCaptain",0,0,0,0,0,0,frandom(0,360),SXF_NOCHECKPOSITION,0,tid)
