Actor PatriarchTerminator : RMTerminator
{
  Species "NemesisPatriarch"
  +THRUSPECIES
  Tag "$CFPatriarchTerminator"
  States
  {
  See:
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,604)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_Jump(100,"Rush")
	TERM A 0 A_PlaySound("Terminator/terstepA")
	TERM AABB 3 A_Chase
	TERM C 0 A_PlaySound("Terminator/terstepA")
	TERM CCDD 3 A_Chase
	TNT1 A 0 A_Jump(40,"Teleport","ComboTel")
	Loop
  Tier2:
	TNT1 A 0
	Goto See
  Tier3:
	TNT1 A 0
	Goto See
  Death:
	TERM M 10 A_Scream
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TERM NNNOOO 5 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("EFGFusionNukeFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_CustomMissile("TerminatorEFGFusionNukeExplode",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER,0)
	TERM PPPQQQ 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TERM SSSTTT 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_SpawnItemEx("GibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("BigRedBloodCloud",frandom(10,80),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TERM UUUVVV 2 Bright A_CustomMissile("CFKaboom",frandom(10,60),frandom(-30,30),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TERM W 4
	TNT1 A 0 A_SpawnItemEx("BfgUpgrade",0,0,64,frandom(1,8),0,2,frandom(0,360),0,192)
	TNT1 A 0 A_SpawnItemEx("ExplosiveMinigunGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("DemonTechDevastatorGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("BFG10KGiver",0,0,64,frandom(0,8),0,2,frandom(1,360),0,0)
	TNT1 A 0 A_SpawnItemEx("PyroCannonGiver",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TERM "X" 6 A_Fall
	TERM "Y" 6
	TERM "Z" 1 A_Playsound("Terminator/terstepA",CHAN_BODY)
	TERM "Z" 5 A_Bossdeath
	TNT1 A 0 A_KillMaster
	TERM "[" -1
	Stop
  }
}

