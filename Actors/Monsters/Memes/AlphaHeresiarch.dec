Actor MonsterNemesisPlasmaSpread : NemesisPlasmaSpread
{
  Species "SatanGuard"
  Damagetype "SatanGuard"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("NemesisPlasmaFly",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_SetUserVar("user_chance",0)
	TNT1 A 0 A_SetUserVar("user_lcount",0)
	HEFX A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEFX B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEFX A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEFX B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEFX A 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	HEFX B 1 Bright A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto Spawnloop
  Spawnloop:
	HEFX A 1 Bright A_Weave(user_lcount,user_lcount,2.0+(user_lcount*0.1),1.0+(user_lcount*0.1))
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaTrailFX-A",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("MonsterNemesisPlasmaSeek",0,0,0,velx*0.5,vely*0.5,(velz+frandom(-3,3))*0.5,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_SpawnItemEx("MonsterNemesisPlasmaSpray",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_JumpIf(user_lcount < 5,3)
	TNT1 A 0 A_Jump(96,2)
	TNT1 A 0  A_CustomMissile("MonsterFastNemesisPlasmaSpray",0,0,frandom(0,360),CMF_AIMDIRECTION | CMF_TRACKOWNER,frandom(-45,45))
	HEFX B 1 Bright A_Weave(user_lcount,user_lcount,2.0+(user_lcount*0.1),1.0+(user_lcount*0.1))
	TNT1 A 0 A_SpawnItemEx("NemesisPlasmaTrailFX-B",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("MonsterNemesisPlasmaSeek",0,0,0,velx*0.5,vely*0.5,(velz+frandom(-3,3))*0.5,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0  A_SpawnItemEx("MonsterNemesisPlasmaSpray",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,128+user_chance)
	TNT1 A 0 A_JumpIf(user_lcount < 5,3)
	TNT1 A 0 A_Jump(96,2)
	TNT1 A 0 A_CustomMissile("MonsterFastNemesisPlasmaSpray",0,0,frandom(0,360),CMF_AIMDIRECTION | CMF_TRACKOWNER,frandom(-45,45))
	TNT1 A 0 A_JumpIf(user_lcount > 100,2)
	TNT1 A 0 A_SetUserVar("user_lcount",user_lcount+1)
	TNT1 A 0 A_JumpIf(user_chance > 96,"SpawnLoop")
	TNT1 A 0 A_SetUserVar("user_chance",user_chance+15)
	Loop
  }
}

