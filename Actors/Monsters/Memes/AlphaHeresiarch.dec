	TNT1 A 0 A_CustomMissile("HeresiarchWraith",35,0,-140,CMF_AIMDIRECTION)
	TNT1 A 0 A_CustomMissile("HeresiarchWraith",35,0,-160,CMF_AIMDIRECTION)
	TNT1 A 0 A_SpawnItemEx("HeresiDeathFlare1",0,0,64)
	HIER R 6 Bright
