	TNT1 A 0 A_PlaySound("DoomShadowDeathXPL",5)
	HIER Q 1 Bright A_CustomMissile("Kaboom25",frandom(38,100),frandom(-5,5),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
