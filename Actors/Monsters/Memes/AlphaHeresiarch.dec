	TNT1 A 0 A_SpawnItemEx("PartialKakuhou",0,0,8,frandom(0,8),frandom(0,8),CMF_AIMDIRECTION,frandom(0,360),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_BossDeath
	HIER X -1
	Stop
