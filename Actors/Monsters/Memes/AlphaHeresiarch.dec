	HIER QQ 1 Bright A_CustomMissile("Kaboom23",frandom(38,100),frandom(-5,5),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_PlaySound("DoomShadowDeathXPL",7)
