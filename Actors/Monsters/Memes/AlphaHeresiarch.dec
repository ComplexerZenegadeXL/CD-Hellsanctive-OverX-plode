Actor IsACFHeresiarch : Inventory {}
Actor InRage : Inventory {}

Actor NightmareSummonerSpam : ExileCaster
{
  Speed 30
  +THRUACTORS
  +NOTIMEFREEZE
  +SERVERSIDEONLY
  var int user_chance;
  var int user_lcount;
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("NemesisPlasmaFly",CHAN_VOICE,1.0,1)
	TNT1 A 0 A_SetUserVar("user_chance",0)
	TNT1 A 0 A_SetUserVar("user_lcount",0)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto SpawnLoop
  SpawnLoop:
	TNT1 A 1 A_Weave(user_lcount,user_lcount,2.0,1.0)
	TNT1 A 0 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("Nightmare",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,user_chance)
	TNT1 AA 1 A_SpawnItemEx("BlueFire",frandom(-2,2),frandom(-2,2),frandom(4,9),frandom(-3,3),frandom(-3,3),frandom(3,8),frandom(0,360),SXF_CLIENTSIDE)
	TNT1 A 1 A_Weave(user_lcount,user_lcount,2.0,1.0)
	TNT1 A 0 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("Nightmare",0,0,0,velx*0.9,vely*0.9,(velz+frandom(-3,3))*0.9,angle+frandom(-11,11),SXF_TRANSFERPITCH | SXF_SETMASTER,user_chance)
	TNT1 AA 1 A_SpawnItemEx("BlueFire",frandom(-2,2),frandom(-2,2),frandom(4,9),frandom(-3,3),frandom(-3,3),frandom(3,8),frandom(0,360),SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIf(user_lcount > 100,2)
	TNT1 A 0 A_SetUserVar("user_lcount",user_lcount+1)
	TNT1 A 0 A_JumpIf(user_chance > 255,"SpawnLoop")
	TNT1 A 0 A_SetUserVar("user_chance",user_chance+1)
	Loop
  Death:
	TNT1 AAA 0 A_StopSound(CHAN_VOICE)
	TNT1 A 0 A_SpawnItemEx("BlueFlare2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAAAAA 1 A_SpawnItemEx("BlueFire",frandom(-2,2),frandom(-2,2),frandom(4,9),frandom(-3,3),frandom(-3,3),frandom(3,8),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("Nightmare",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AA 1 A_SpawnItemEx("BlueFire",frandom(-2,2),frandom(-2,2),frandom(4,9),frandom(-3,3),frandom(-3,3),frandom(3,8),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 1
	Stop
  }
}

