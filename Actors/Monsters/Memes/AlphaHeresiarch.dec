  Pain:
	HIER P 1 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,2)
	HIER P 6
