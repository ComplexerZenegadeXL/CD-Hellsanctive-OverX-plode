Actor PatriarchTrueLegendarySentient : TrueLegendarySentient
{
  DropItem "LegendaryUltraSphere" 215
  DropItem "LDemonAmmoBoxPickup" 256 
  DropItem "LDemonAmmoPickup" 256
  //DropItem "LegendaryBFGGiver" 256
  DropItem "BossLifeEssence" 256 
  DropItem "BossArmorBonusMax" 256 
  DropItem "SkullofPowerGiver" 192
  //DropItem "LegendaryPlasmaticRifleGiver" 256
  DropItem "LegendaryAmmoSphere" 256
  DropItem "LegendaryDemonRune" 256
  //DropItem "LegendaryAssaultShotgunGiver" 256
  DropItem "LegendaryArmor" 256
  //DropItem "LegendaryPlasmaticCannonGiver" 256 
  DropItem "LegendarySphere" 256
  DropItem "LegendaryTimeFreezeSphere" 256
  DropItem "LegendaryShellPickup" 256 4
  DropItem "LegendaryShellBoxPickup" 256
  DropItem "LegendaryBulletBoxPickup" 256 
  //DropItem "LegendaryLightMachineGunGiver" 256
  DropItem "ExplosiveMinigunGiver" 256 
  DropItem "TrueLegendaryBFGUpgrade" 250
  Species "NemesisPatriarch"
  +THRUSPECIES
  Tag "$CFPatriarchTrueLegendarySentient"
  States
  {
  TrueProtonCannon:
	TNT1 A 0 
	Goto TrueLegBomb
  MyBabies:
	TNT1 A 0 
	Goto TrueLegBomb
  Death:
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
    TLSN H 2 Bright A_Scream
	TLSN A 0 A_NoBlocking
  DeathLoop:
	TLSN A 0 A_JumpIf(user_tlsdelay >= 65, "Death2")
	TLSN H 2 Bright A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto DeathLoop
  Death2:
    TNT1 AAAA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLSN A 0 A_SpawnItemEx("TrueDeathBall")
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
  Death2Loop:
	TLSN A 0 A_JumpIf(user_tlsdelay >= 65, "KamikazeDecide")
	TLSN I 2 A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto Death2Loop
  KamikazeDecide:
    TNT1 AAAA 0 A_SpawnItemEx("LegBlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)		
	TNT1 AAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TLSN A 0 A_SpawnItemEx("TrueDeathBall")
    TLSN A 0 A_SetUserVar(user_tlsdelay, 0)
	TLSN A 0 A_JumpIfTargetInLOS(1)
	Goto NOKAMIKAZE4U
  KamikazeCharge:
	TLSN A 0 A_PlaySound("TrueLegSent/See", CHAN_AUTO, 1.0, False, ATTN_NONE)
	KamikazeChargeLoop:
	TLSN A 0 A_JumpIf(user_tlsdelay >= 40, "KamikazeGo")
    TLSN P 2 Bright A_FaceTarget
	TLSN A 0 A_CustomMissile("PainfulDeathKaboom", frandom(20,80), frandom(-20,20), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TLSN A 0 A_SpawnItemEx("LegendaryCyberFlameSpawner3",0,0,0,0,0,0,128)
	TLSN A 0 A_SpawnItemEx("TrueLegSentientFireSpawner",0,0,0,0,0,0,0,128)
	TLSN A 0 A_SetUserVar(user_tlsdelay, user_tlsdelay+1)
	Goto KamikazeChargeLoop
  KamikazeGo:
    TLSN A 0 A_CustomMissile("PatriarchTrueLegSentKamikaze", 48, 0, 0)
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	Stop
  NOKAMIKAZE4U:
	TLSN JKLM 10 Bright
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(-10,10),frandom(-10,10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(-30,30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TLSN A 0 A_SpawnItemEx("TrueDeathBall")
	TNT1 A 0
	Stop
  }
}
Actor PatriarchTrueLegSentKamikaze : TrueLegSentKamikaze
{
  States
  {
  Death:
    TLSN A 0 A_ChangeFlag(NoBlockMap, 1)
	TLSN A 0 A_SpawnItemEx("TrueDeathBall")
	TLSN HIJKLM 10 Bright 
	TNT1 AAAAAAAA 0 A_SpawnItemEx("BlueGibbedGenerator",frandom(10,-10),frandom(10,-10),frandom(20,60),0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAAAAAAAA 0 A_CustomMissile("BigBlueBloodCloud", frandom(10,80), 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile("SmokeFX3", frandom(10,60), frandom(30,-30), frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
	TNT1 A 0
	Stop
  }
}

Actor TrueLegTeamSpawner
{
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("TrueLegTeamSpawner2",0,-250,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	TNT1 A 0 A_SpawnItemEx("TrueLegTeamSpawner3",0,250,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor TrueLegTeamSpawner2
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 0 A_SpawnItemEx("PatriarchTrueLegendaryCyberdemon",0,0,0,0,0,0,frandom(0,360),SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor TrueLegTeamSpawner3
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
