Actor TouretteSchabbs  //the only way to fix this enemy is to delete it but I put too much effort into the Tourettes meme
{
  Monster
  Health 2500
  GibHealth 2000
  Height 56
  Radius 20
  Mass 200
  Speed 8
  PainChance 190
  MinMissileChance 64
  +BOSS
  +BOSSDEATH
  +DONTMORPH
  +NOTIMEFREEZE
  +FLOORCLIP
  +LOOKALLAROUND
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +AVOIDMELEE
  +NEVERRESPAWN
  +CANTSEEK
  +THRUSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +NOICEDEATH
  Species "SS"
  DamageType "SS"
  DamageFactor "SS", 0.0
  DamageFactor "PlayerPyro", 0.05
  DamageFactor "BFG9500Ball", 0.05
  DamageFactor "BFGSplash", 0.05
  DamageFactor "UpBFG9500Ball", 0.05
  DamageFactor "UpBFGSplash", 0.05
  DamageFactor "Legendary", 0.05
  DamageFactor "PlayerLegendary", 0.05
  DamageFactor "Legendary1", 0.05
  DamageFactor "HFCyber", 0.05
  DamageFactor "Cyber10K", 0.05
  DamageFactor "PlayerHellfire", 0.05
  DamageFactor "LegendaryPlayer", 0.05
  DamageFactor "LegendaryGuruPlayer", 0.05
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  RadiusDamageFactor 0.2
  DropItem "PortableMedCell", 256, 1
  DropItem "PortableMedkit", 256
  DropItem "ArmorPlate", 256
  DropItem "ShieldSphere", 256, 7
  SeeSound "Schabbs/See"
  ActiveSound "Schabbs/Active"
  PainSound "Schabbs/Pain"
  DeathSound "Schabbs/Death"
  Obituary "$CFTouretteSchabbsObit"
  Tag "$CFTouretteSchabbs"
  var int user_music;
  var int user_heal;
  States
  {
  Spawn:
  	SBBS A 0
  	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  SpawnLoop:
	SBBS A 10 A_Look
	Loop
  Idle:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_SetUserVar("user_music",0)
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS AA 6 A_Wander
	TNT1 A 0 A_Look
	SBBS BB 6 A_Wander
	TNT1 A 0 A_Look
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS CC 6 A_Wander
	TNT1 A 0 A_Look
	SBBS DD 6 A_Wander
	TNT1 A 0 A_Look
	Loop
  See:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,800)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIfTargetInLOS(2,90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS,500,0)
	TNT1 A 0 A_Jump(256,2)
	TNT1 A 0
	SBBS AABB 3 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	SBBS CCDD 3 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("LegendaryFootStep",0,0,5,0,0,-20)
	Loop
  Pain:
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"PainShield")
	TNT1 A 0 A_Jump(64,"NoPainShield")
  PainShield:
	TNT1 A 0 A_GiveInventory("SuperZombieShieldSphere",1)
  NoPainShield:
	SBBS P 6 A_Pain
	Goto See
	Death:
	"####" "#" 53 A_Scream
	SBBS GH 6
	SBBS I 6 A_NoBlocking
	SBBS A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BossDeath
	SBBS J -1
	Stop
  XDeath:
	TNT1 A 0 A_XScream
	SBBS G 6 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	SBBS H 6
	SBBS I 6 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BossDeath
	SBBS J -1
	Stop
  }
}