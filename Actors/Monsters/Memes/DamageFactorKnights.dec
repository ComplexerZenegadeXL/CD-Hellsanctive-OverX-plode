Actor DeathKnightSquadSpawner
{
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("DeathKnightSquadSpawner2",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	TNT1 A 0 A_SpawnItemEx("DeathKnightSquadSpawner3",0,200,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	TNT1 A 0 A_SpawnItemEx("DeathKnightSquadSpawner3",0,-200,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}

