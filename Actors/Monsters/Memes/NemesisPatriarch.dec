	OMNI E 3 A_FaceTarget
	TNT1 A 0 A_CustomMissile("MReimuHomingSuperBall",38,0,-30)
	TNT1 A 0 A_CustomMissile("MReimuHomingSuperBall",38,0,30)
	TNT1 A 0 A_CustomMissile("MReimuSuperBall",38,0,-15)
	TNT1 A 0 A_CustomMissile("MReimuSuperBall",38,0,15)
	OMNI F 8 A_CustomMissile("MReimuHomingSuperBall",38,0,0)
