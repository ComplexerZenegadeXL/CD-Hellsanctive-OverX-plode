Actor NemesisPatriarchSummoner 29099
{
  Monster
  -COUNTKILL
  +NOTIMEFREEZE
  +NODAMAGE
  -SHOOTABLE
  Scale 1.1
  States
  {
  Spawn:
	OMNI V 10
	OMNI V 100
	TNT1 A 0 A_SpawnItemEx("NemesisPatriarchSummonEffectSpawner")
	TNT1 A 0 A_CustomMissile("NemesisPentaLine1",0,0,-72,2)
    TNT1 A 0 A_CustomMissile("NemesisPentaLine1",0,0,-144,2)
    TNT1 A 0 A_CustomMissile("NemesisPentaLine1",0,0,-216,2)
    TNT1 A 0 A_CustomMissile("NemesisPentaLine1",0,0,-288,2)
    TNT1 A 0 A_CustomMissile("NemesisPentaLine1",0,0,0,2)
	TNT1 A 0 A_PlaySound("Patriarch/Spawn",1,1.0,0,ATTN_NONE)
	TNT1 A 0 A_Quake(8,2300,0,8000)
	OMNI V 60
	OMNI VVVVVVVVVV 20 A_SpawnItemEx("NemesisLightning",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,0,0,64)
	OMNI VVVVVVVVVVVVVVVVVVVV 20 A_SpawnItemEx("NemesisHKCometRain",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("NemesisPatriarchSummonEffectSpawner2")
	TNT1 A 0 A_SpawnItemEx("NemesisPatriarchLightningSpawner")
	OMNI VVVVVVVVVVVVVVVVVVVV 20 A_SpawnItemEx("NemesisLightning",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,0,0,64)
	OMNI VVVVVVVVVV 20 A_SpawnItemEx("NemesisHKCometRain",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,SXF_NOCHECKPOSITION,0)
	OMNI VVVVVVVVVVVVVVVVVVVVVVVV 20 A_SpawnItemEx("NemesisLightning",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,0,0,64)
	TNT1 A 0 A_PlaySound("NemesisPortal/Open",7)
	TNT1 AAA 0 A_SpawnItemEx("NemesisPatriarchSummonEffect",0,0,130)
	OMNI VVVVVVVVVVVVVVVVVVVVVVVVV 20 A_SpawnItemEx("NemesisLightning",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,0,0,64)
	TNT1 A 0 A_PlaySound("NemesisPortal/Loop",6,1.0,1)
	OMNI VUTSRQPON 20 A_SpawnItemEx("NemesisLightning",frandom(-2000,2000),frandom(-2000,2000),0,0,0,0,0,0,64)
	TNT1 A 10 A_SpawnItemEx("NemesisPatriarch",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TELEFRAG,0,tid)
	TNT1 A 0 A_StopSound(6)
	Stop
  }
}

