	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,-90)
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,90)
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,-45)
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,45)
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,-30)
	TNT1 A 0 A_CustomMissile("MiniNemesisBFGBall",38,0,30)
