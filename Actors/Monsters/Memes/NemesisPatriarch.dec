	TNT1 A 0 A_SpawnItemEx("EWAVE",0,-37,110)
	OMNI WWWWWWW 5 A_FaceTarget
	TNT1 A 0 A_CustomMissile("CommanderBrainWave",38,0,-45)
	TNT1 A 0 A_CustomMissile("CommanderBrainWave",38,0,45)
	OMNI X 30 A_CustomMissile("EmpoweredBrainwave",38,0,0)
