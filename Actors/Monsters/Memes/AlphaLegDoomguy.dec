	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GuruTrigger",1)
	LGBG EEEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EEEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("Weapons/GuruCharge",6)
	LGBG EEEEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_GiveInventory("CFGuruCharge",5)
  Gurucharger:
	TNT1 A 0 A_TakeInventory("CFGuruCharge",1)
	LGBG EEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGBG EEEE 1 A_FaceTarget
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LDoomguySmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIfInventory("CFGuruCharge",1,"Gurucharger")
	TNT1 A 0 A_FaceTarget
	LGBG FFF 1 A_Quake(4,2,0,2,"none")
	TNT1 A 0 A_UnSetInvulnerable
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_StopSound(5)
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_PlaySound("Weapons/GuruFire",5)
	TNT1 A 0 A_PlaySound("Weapons/GuruAddFire",6)
	TNT1 A 0 A_CustomMissile("RTLBBall",32,0,0,CMF_TRACKOWNER)
	Goto See
  LegRailgun:
	TNT1 A 0 A_PlaySound("weapons/railselect",CHAN_ITEM)
	LGRG E 2
	TNT1 A 0 A_PlaySound("weapons/rgcharge",CHAN_WEAPON)
	LGRG EEEEE 4 A_FaceTarget
	LGRG E 8 A_FaceTarget
	LGRG F 2 A_CustomMissile("LegDoomguyRail",32,0,0,CMF_TRACKOWNER)
	Goto See
  RageLegRailgun:
	TNT1 A 0 A_PlaySound("weapons/railselect",CHAN_ITEM)
	LGRG E 2
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_PlaySound("weapons/rgcharge",CHAN_WEAPON)
	LGRG EEEE 4 A_FaceTarget
	LGRG E 4 A_FaceTarget
	LGRG F 2 A_CustomMissile("LegDoomguyRail",32,0,0,CMF_TRACKOWNER)
	TNT1 A 0 A_UnSetInvulnerable
	Goto Missile
  RageAlert:
	TNT1 A 0 A_PlaySound("legendary/defense",CHAN_BODY)
	TNT1 A 0 A_SetInvulnerable
	TNT1 A 0 A_FaceTarget
	LGFT E 5 A_PlaySound("legdoomguy/rage1",CHAN_VOICE,1.0,0,ATTN_NONE)
	TNT1 A 0 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LGFT EEEE 2 A_FaceTarget
	LGFT EEEE 2 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("legdoomguy/rage2",CHAN_VOICE,1.0,0,ATTN_NONE)
	LGFT EEEE 2 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("ALWAYSFAST",1)
	TNT1 A 0 A_SetUserVar("user_enraged",1)
	TNT1 A 0 A_UnsetInvulnerable
	Goto NotEnraged
  Rekt:
	TNT1 AAA 0 A_StopSound
	TNT1 A 0 A_PlaySound("legdoomguy/rekt",CHAN_VOICE,0.8,0,ATTN_NONE)
	TNT1 A 0 A_TakeInventory("MarineKilled",1)
	Goto See
  IgnoreDamage:
	LG47 A 1 A_UnSetShootable
	TNT1 AAAA 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("boss/teleport",CHAN_VOICE)
	LG47 AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TNT1 A 2
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"InvisibleHunt")
	TNT1 A 0 A_ChangeFlag("NOFEAR",0)
	TNT1 A 0 A_ChangeFlag("FRIGHTENED",1)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase("","",CHF_NOPLAYACTIVE)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 2 A_PlaySound("boss/teleport",CHAN_BODY)
	TNT1 AAAA 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_ChangeFlag("FRIGHTENED",0)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_Facetarget
	LG47 AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetTranslucent(1)
	LG47 A 1 A_SetShootable
	Goto PainMissile
  InvisibleHunt:
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIGHTENED",0)
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Chase("InvisibleHuntEnd","",CHF_NOPLAYACTIVE)
  InvisibleHuntEnd:
	TNT1 A 2 A_PlaySound("boss/teleport",CHAN_BODY)
	TNT1 AAAA 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_ChangeFlag("FRIGHTENED",0)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_Facetarget
	LG47 AAAAA 1 A_FadeIn(0.2)
	TNT1 A 0 A_SetTranslucent(1)
	LG47 A 1 A_SetShootable
	Goto Missile
  Wound:
	TNT1 A 0 A_JumpIfInventory("Tic",2,"Pain")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_ClassBossHealth
	Goto See
  Pain:
	TNT1 A 0 A_SetUserVar("user_timer",0)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_Jump(48,"IgnoreDamage","IgnoreDamage","Protection")
	Goto PainMissile
  Pain.BFG9500Ball:
  Pain.BFGSplash:
  Pain.UpBFG9500Ball:
  Pain.UpBFGSplash:
  Pain.PDTBFG:
  Pain.PlayerDBFG2:
  Pain.PlayerDBFG10K2:
  Pain.PlayerDBFGSplash2:
	TNT1 A 0 A_SetUserVar("user_timer",0)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_Jump(128,"IgnoreDamage","IgnoreDamage","IgnoreDamage","Protection")
  Goto PainMissile
  Pain.PlayerDevBall:
  Pain.PlayerDevBall2:
  Pain.Players:
  Pain.PDTBFGTracer:
  Pain.PlayerDevTracer:
  Pain.PlayerPyro:
  Pain.NuclearFire:
	TNT1 A 0 A_SetUserVar("user_timer",0)
	TNT1 A 0 A_ChangeFlag("NOFEAR",1)
	TNT1 A 0 A_ChangeFlag("FRIENDLY",0)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,1)
	TNT1 A 0 A_Jump(128,"Protection","Protection","Protection","IgnoreDamage")
	Goto PainMissile
  PainMissile:
	LG47 E 3 A_GiveInventory("LegZombieStrafing",1)
	LG47 E 3 A_GiveInventory("LegZombieStrafing",1)
	Goto Missile
  Protection:
	TNT1 A 0 A_JumpIf(user_protected == 1,2)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_ProtectionForLegDoomguy",0)
	TNT1 A 0
	TNT1 A 0 A_PlaySound("legendary/defense",CHAN_BODY)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.5),"RageProtection")
	TNT1 A 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	LG47 E 1 HealThing(((user_currenthp - Health)*0.75)+1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	TNT1 A 0 A_Jump(128,"PainMissile")
	TNT1 A 0
	Goto See
  RageProtection:
	TNT1 A 0 A_JumpIf((user_currenthp - Health) <= 0,2)
	LG47 E 1 HealThing(((user_currenthp - Health)*0.95)+1)
	TNT1 A 0 A_SetUserVar("user_currenthp",Health)
	LG47 AABB 1 A_Chase("","TryBFG3")
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 CCDD 1
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 AABB 1 A_Chase("","TryBFG3")
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 CCDD 1
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 AABB 1 A_Chase("","TryBFG3")
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 CCDD 1
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 AABB 1 A_Chase("","TryBFG3")
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 CCDD 1
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 AABB 1 A_Chase("","TryBFG3")
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	LG47 CCDD 1
	TNT1 A 0 A_SpawnItemEx("CFLegLineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("LHellionSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_JumpIf(user_quaddamage == 1,2)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.25),"UseQuadDamage")
	TNT1 A 0 A_JumpIf(user_enraged == 1,2)
	TNT1 A 0 A_JumpIfHealthLower((ACS_NamedExecuteWithResult("CF_SpawnHealth")*0.5),"RageAlert")
	TNT1 A 0
	Goto TryBFG3
  UseQuadDamage:
	TNT1 A 0 A_PlaySound("legdoomguy/quaddmg",CHAN_VOICE,1.0,0,ATTN_NONE)
	TNT1 A 0 A_GiveInventory("LegDoomguyDoubleDamagePowerUp",1)
	TNT1 A 0 A_GiveInventory("RingOfRegenerationHalfQuiet",1)
	TNT1 A 0 ACS_NamedExecutealways("CF_QuadDamageLDG",0)
	GoTo TryBFG3
  Death:
	TNT1 A 0 A_StopSound
	TNT1 A 0 A_ChangeFlag("Bright",0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryCoachgunGiver",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,0)
	//TNT1 A 0 A_SpawnItemEx("LegendaryAssaultShotgunGiver",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,160)
	//TNT1 A 0 A_SpawnItemEx("LegendaryPlasmaticRifleGiver",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,160)
	//TNT1 A 0 A_SpawnItemEx("LegendaryPlasmaticCannonGiver",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,160)
	//TNT1 A 0 A_SpawnItemEx("LegendaryBFGGiver",0,0,12,frandom(0,8),frandom(0,8),2,frandom(0,360),0,160)
	TNT1 A 0 A_DropItem("LegendaryDust",random(5,10),256)
	LG47 O 5 A_Scream
	LG47 P 5 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,75)
	TNT1 A 0 ACS_NamedExecuteAlways("TrueLegendaryRune",0,30)
	LG47 Q 5 A_SpawnItem("BodyCrash",0,0,0,0)
	LG47 R 5
	TNT1 A 0 A_SpawnItemEx("LegDoomguySoulEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
	LG47 TU 5
	TNT1 A 20
	TNT1 A 0 //A_PlaySoundEx("brain/spit","Voice",0,2)
	TNT1 A 1 //A_SpawnItemEx("LegendaryHeroSoul",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TELEFRAG)
	TNT1 A 1
	Stop
  }
}

Actor LegDoomguyGhostA
{
  Height 56
  Radius 20
  Speed 0
  Scale 1.1
  RenderStyle Translucent
  Alpha 0.7
  +MISSILE
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	LG47 A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor LegDoomguyGhostB : LegDoomguyGhostA
{
  States
  {
  Fade:
	LG47 B 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegDoomguyGhostC : LegDoomguyGhostA
{
  States
  {
  Fade:
	LG47 C 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegDoomguyGhostD : LegDoomguyGhostA
{
  States
  {
  Fade:
	LG47 D 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor LegDoomguyRail : TrueLegendaryCyberRail { Damage (Random(25,50)*10) }

Actor LegDoomguyDoubleDamagePowerUp : PowerupGiver
{
  +NOTIMEFREEZE
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  Powerup.Duration 0x7FFFFFFD
  Powerup.Type "Power2xDamage"
}

Actor RTLBBall
{
  Projectile
  Height 6
  Radius 11
  Speed 15
  Scale 0.25
  Renderstyle Add
  Damage 125
  +RIPPER
  +FOILINVUL
  +BLOODLESSIMPACT
  +FORCERADIUSDMG
  +NODAMAGETHRUST
  +DONTBLAST
  +SKYEXPLODE
  +DONTREFLECT
  +NOTIMEFREEZE
  +FORCEXYBILLBOARD
  +THRUSPECIES
  +MTHRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +QUICKTORETALIATE
  DamageType "LegendaryGuru"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
	TNT1 A 0 A_PlaySound("Weapons/GuruFly",5,1.0,1)
	Goto Fly
  AfterAttack:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(300,64,0,1)
  Fly:
	TNT1 A 0 A_SpawnItemEx("CFGuruTrailSpark",frandom(-28,28),frandom(-28,28),frandom(-28,28),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruTrail",-3,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	YBAL A 1 Bright
	TNT1 AAA 0 A_CustomMissile("RTLBLiteShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_CustomMissile("LRTLBBolt",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Loop
  Attack:
	TNT1 A 0 A_CustomRailgun(8*random(1,8),0,None,"Yellow",RGF_SILENT|RGF_FULLBRIGHT,1,2,"RTLBFGRailgunSlugPuff")
	Goto AfterAttack
  Death:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_PlaySound("Weapons/GuruBlast3",5,1.0,0)
	//COLLATERAL DAMAGE EFFECTS
	TNT1 A 0 A_Explode(3000,486,0,1)
	TNT1 A 0 A_BFGSpray("CFGuruSpray",15,20)
	//IMPACT STUFF
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowX",0,0,10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SpawnItemEx("CFGuruStruckGlowY",0,0,10,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("CFGuruSphereSmoke",frandom(-126,126),frandom(-126,126),frandom(-66,66),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("CFGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAAAAAAAAAAAAAA 2 A_SpawnItemEx("CFGuruChunkSpark",frandom(-126,126),frandom(-126,126),frandom(-66,66),0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}
Actor RTLBFGRailgunSlugPuff : BulletPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  DamageType "LegendaryGuru"
}


Actor RTLBLiteShot
{
  Projectile
  Height 12
  Radius 8
  Speed 32
  RenderStyle Add
  Alpha 0.85
  Reactiontime 12
  Damage 20
  +FOILINVUL
  +THRUGHOST
  +DONTREFLECT
  +THRUACTORS
  +THRUSPECIES
  +MTHRUSPECIES
  +FORCERADIUSDMG
  +QUICKTORETALIATE
  +NOTIMEFREEZE
  Damagetype "LegendaryGuru"
  SeeSound "weapons/devlit"
  DeathSound "weapons/devzap"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_TARGET, AAPTR_DEFAULT)
  Fly:
	TNT1 A 0 A_CountDown
	LLIT A 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT A 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT A 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT B 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT B 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT B 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT C 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT C 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	LLIT C 1 Bright A_SpawnItemEx("LegLiteTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,32,0,360,"Attack")
	Loop
  Attack:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	TNT1 A 0 A_Explode(20*random(1,8),64,0,1)
	Goto Fly
  Death:
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_DEFAULT, AAPTR_DEFAULT)
	LLIT DEFGHIJKLMNO 1 Bright
	Stop
  }
}

Actor LRTLBBolt
{
  Projectile
  Height 6
  Radius 6
  Speed 35
  RenderStyle Add
  Alpha 0.8
  ReactionTime 170
  Damage 25
  +FOILINVUL
  +DONTREFLECT
  +SEEKERMISSILE
  +HITTRACER
  +NOTIMEFREEZE
  +THRUSPECIES
  +MTHRUSPECIES
  DamageType "LegendaryGuru"
  DeathSound "bolt/explode"
  States
  {
  Spawn:
	TNT1 A 0 A_CountDown
	TNT1 A 0 A_Seekermissile(5,5,SMF_LOOK)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CF_CheckSeeker") == 1,"Enemy")
  "Friendly":
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_RearrangePointers(AAPTR_DEFAULT, AAPTR_DEFAULT, AAPTR_NULL)
	LVS1 AAAA 1 Bright A_SpawnItemEx("LegBoltTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Spawn
  Enemy:
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	LVS1 A 1 Bright A_SpawnItemEx("LegBoltTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Goto Spawn
  Death:
	LVS1 LMN 2 Bright
	Stop
  Crush:
  XDeath:
	TNT1 A 0 ACS_NamedExecuteAlways("CF_DmgInvul",0,AAPTR_TRACER,1)
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("LegendaryGoldParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("LegKaboomDevastator15",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
  Vanilla:
	LVS1 LMN 2 Bright
	Stop
  }
}

