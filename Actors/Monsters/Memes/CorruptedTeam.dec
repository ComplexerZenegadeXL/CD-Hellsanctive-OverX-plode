Actor CorruptTeamSpawner
{
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_SpawnItemEx("CorruptTeamSpawner2",0,-250,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	TNT1 A 0 A_SpawnItemEx("CorruptTeamSpawner3",0,250,0,0,0,0,0,SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor CorruptTeamSpawner2
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 0 A_SpawnItemEx("CorruptedCardinal",0,0,0,0,0,0,random(0,360),SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}
Actor CorruptTeamSpawner3
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A random(0,10)
	TNT1 A 0 A_SpawnItemEx("TeleportFog")
	TNT1 A 0 A_SpawnItemEx("CorruptedSentient",0,0,0,0,0,0,random(0,360),SXF_NOCHECKPOSITION,0,tid)
	Stop
  }
}