Actor PatriarchCorruption : Corruption
{
  +THRUSPECIES
  Species "NemesisPatriarch"
  DamageFactor 0.55
  States
  {
  Death: 
	DCS0 Q 15 Bright
	DCS0 Q 15 Bright A_Scream 
	DCS3 Q 10 Bright  
	DCS3 RR 8 Bright
	DCS3 RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR 2 Bright A_SpawnItemEx("CorruptionFlameAndWindSpawner", 0, 0, 40, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 A 0 A_NoBlocking
	TNT1 A 0 A_SpawnItemEx("PyroCannon",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("HellfireUltrasphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,0)
	TNT1 A 0 A_SpawnItemEx("LegendaryPowerShard",0,0,64,frandom(1,8),0,2,frandom(0,360),0,64)
	TNT1 A 0 A_SpawnItemEx("LegendaryAmmoSphere",0,0,64,frandom(1,8),0,2,frandom(0,360),0,192)
	DCS3 R 0 A_CustomMissile("DarkDesNuke",66,0,0)
	TNT1 A -1
	Stop
	}
}

