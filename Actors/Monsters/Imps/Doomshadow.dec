  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_SpawnItemEx("HadesFire",frandom(-10,10),frandom(-10,10),0,frandom(-8,8),frandom(-8,8),frandom(20,40),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
