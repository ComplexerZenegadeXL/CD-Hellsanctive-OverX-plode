Actor ShadowMinion
{
  Monster
  Health 80
  Height 56
  Radius 18
  Mass 100
  Speed 5
  Alpha 0.7
  RenderStyle Translucent
  PainChance 200
  PainChance "Shadow", 0
  PainChance "AdvancedImp", 0
  -COUNTKILL
  +FLOORCLIP
  +NOTARGET
  +NOINFIGHTING
  +THRUSPECIES
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  //No Infighting
  DamageFactor "Shadow", 0.0
  DamageFactor "AdvancedImp", 0.0
  DropItem "LifeEssence", 100, 2
  DropItem "ArmorBonusMax", 100, 2
  PainSound "Shadow/pain"
  DeathSound "Shadow/death"
  ActiveSound "Shadow/active"
  Obituary "$CFShadowMinionObit"
  Tag "$CFShadowMinion"
  States
  {
  Spawn:
	TNT1 A 0
	SHDW E 10 A_Look
	Loop
  Idle:
	SHDW EEEEEEEEEEEEEEEEEEEEEEEEEEEE 10 A_Look
	TNT1 A 0 A_JumpIfInventory("Tic",10,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  See:
	SHDW A 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostA",0,0,0,CMF_AIMDIRECTION)
	SHDW A 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostA",0,0,0,CMF_AIMDIRECTION)
	SHDW A 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostA",0,0,0,CMF_AIMDIRECTION)
	SHDW B 1 A_Chase
	TNT1 B 0 A_CustomMissile("ShadowGhostB",0,0,0,CMF_AIMDIRECTION)
	SHDW B 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostB",0,0,0,CMF_AIMDIRECTION)
	SHDW B 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostB",0,0,0,CMF_AIMDIRECTION)
	SHDW C 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostC",0,0,0,CMF_AIMDIRECTION)
	SHDW C 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostC",0,0,0,CMF_AIMDIRECTION)
	SHDW C 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostC",0,0,0,CMF_AIMDIRECTION)
	SHDW D 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostD",0,0,0,CMF_AIMDIRECTION)
	SHDW D 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostD",0,0,0,CMF_AIMDIRECTION)
	SHDW D 1 A_Chase
	TNT1 A 0 A_CustomMissile("ShadowGhostD",0,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_JumpIfInventory("Tic",10,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Missile:
	TNT1 A 0 A_JumpIfInventory("Tic",10,"Vanish")
	TNT1 A 0 A_GiveInventory("Tic",1)
	SHDW E 30 A_FaceTarget
  MissileLoop:
	SHDW F 5
	SHDW G 5 Bright A_CustomMissile("ShadeMissile",32,9,0)
	SHDW F 5
	SHDW E 20
	SHDW E 1 A_SpidRefire
	Loop
  Pain:
	SHDW H 4
	SHDW H 4 A_Pain
	Goto See
  Vanish:
	SHDW H 2 A_FadeOut(0.1,1)
	Wait
  Death:
	SHDW I 6 A_Scream
	SHDW J 5
	SHDW K 5 A_CustomMissile("Shadowtorso",0,0,0,CMF_AIMDIRECTION)
	SHDW L 5 A_Fall
	SHDW MNOP 6 
	SHDW P 525
	SHDW P 5 A_FadeOut(0.1,1)
	Wait
  XDeath:
	SHDX A 8
	SHDX B 6 A_XScream
	SHDX C 6 
	SHDX D 6 A_Fall
	SHDX EFG 6
	SHDX G 525
	SHDX G 5 A_FadeOut(0.1,1)
	Wait
  }
}

