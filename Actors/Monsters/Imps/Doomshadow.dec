Actor DoomWraith
{
  Projectile
  Damage (0)
  BounceCount 10
  Obituary "$CFDoomWraithObit"
  Speed 15
  Height 5
  Radius 5
  Species "Imps"
  DamageType "ImpComet"
  +RIPPER
  -NOGRAVITY
  +BLOODLESSIMPACT
  +NOEXPLODEFLOOR
  -FLOORCLIP
  Gravity 0.2
  var int user_loop;
  States
  {
  Spawn:
	DWRT AAAAA 1 Bright A_SpawnItemEx("Kaboom10",0,0,0,frandom(-5,5),frandom(-5,5),frandom(-5,5),frandom(0,360))
	TNT1 A 0 A_Explode(10,80,0,0,72)
	TNT1 A 0 A_RadiusGive("HavocSteal",100,RGF_MONSTERS,1)
	TNT1 A 0 A_RadiusGive("HavocSteal2",100,RGF_PLAYERS,1)
	DWRT BBBBB 1 Bright A_SpawnItemEx("Kaboom10",0,0,0,frandom(-5,5),frandom(-5,5),frandom(-5,5),frandom(0,360))
	TNT1 A 0 A_Explode(10,80,0,0,72)
	TNT1 A 0 A_RadiusGive("HavocSteal",100,RGF_MONSTERS,1)
	TNT1 A 0 A_RadiusGive("HavocSteal2",100,RGF_PLAYERS,1)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,"Death")
	Goto Spawn
  Death:
	TNT1 A 0
	TNT1 A 0 A_ScaleVelocity(0.3)
	TNT1 A 0 A_ChangeFlag(HEXENBOUNCE,1)
	TNT1 A 0 A_UnSetSolid
	TNT1 A 0 A_Scream
	TNT1 A 0 A_SpawnItemEx("Kaboom12",0,0,0,frandom(-5,5),frandom(-5,5),frandom(-5,5),frandom(0,360))
	TNT1 AAAAAA 0 A_SpawnItemEx("Kaboom10",0,0,0,frandom(-5,5),frandom(-5,5),frandom(-5,5),frandom(0,360))
	TNT1 A 0 A_Explode(20,160,0,0,138)
	DWRT HIJKLMMM 4 Bright A_FadeOut
	TNT1 A 1
  Stop
  }
}

