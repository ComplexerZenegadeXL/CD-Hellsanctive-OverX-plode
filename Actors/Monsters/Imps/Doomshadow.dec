Actor HadesSoulSpawner : Kaboom10Spawner
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
  Normal:
	TNT1 A 1 A_SpawnItemEx("HadesSoul",frandom(-20,20),frandom(-20,20),0,0,0,frandom(2,7),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Stop
  Vanilla:
	TNT1 A 1 A_Jump(18,"BackToSpawn")
	Stop
  BackToSpawn:
	TNT1 A 1
	GoTo Normal
  }
}

