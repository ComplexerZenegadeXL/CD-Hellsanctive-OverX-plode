Actor DoomShadow : Imp
{
  Monster
  Health 650
  Height 56
  Radius 18
  Mass 1200
  Speed 8
  BloodColor "Green"
  Renderstyle Translucent
  Alpha 0.8
  PainChance "Mine", 10
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance 40
  +FLOORCLIP
  +NOTARGET
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +THRUSPECIES
  +DONTHARMSPECIES
  DamageType "AdvancedImp"
  DamageFactor "Acid", 0.4
  DamageFactor "Fire", 0.4
  //No Infighting
  DamageFactor "Shadow", 0.0
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "Nightshade", 0.0
  DropItem "BossLifeEssence", 200, 16
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "NemesisArmorBonusMax", 200
  DropItem "ShadowSlaveOrb", 24, 1
  SeeSound "Poe/Sight"
  ActiveSound "Poe/active"
  PainSound "Poe/pain"
  DeathSound "Poe/death"
  Obituary "$CFDoomShadowObit"
  Tag "$CFDShadow"
  var int user_loop;
  var int user_lowlag;
  States
  {
  Spawn:
	DSHD A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:	
	DSHD A 1 A_Look
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrailSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Loop
  Pain:
	TNT1 A 0
	DSHD H 5 A_Pain
	Goto See
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DSHD BBCC 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	DSHD B 1 A_Chase
	TNT1 A 0 A_TakeInventory("Tic",999)
	//TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,2)
	//TNT1 A 0 A_Jump(256,2)
	//TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,15,0,0,0,0,random(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD B 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD B 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD B 1 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD C 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD C 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD C 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD C 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD D 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD D 1 A_Chase("","",CHF_FASTCHASE)
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD D 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD D 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD E 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD E 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD E 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DSHD E 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("DoomShadowTrail2Spawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Loop
  Melee:
  Missile:
	TNT1 A 0 A_Jump(60,"DoomWraith")
	TNT1 A 0 A_Jump(55,"VileAttack")
	TNT1 A 0 A_Jump(35,"ShadowCall")
	Goto MissileLoop
  MissileLoop:
	DSHD F 5 A_FaceTarget
	DSHD G 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("ShadeMissile",32,0,0,CMF_TRACKOWNER)
	DSHD G 3 Bright A_FaceTarget
	TNT1 A 0 A_Jump(15,"See")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 A_Jump(19,"ShadowCall")
	DSHD F 1 A_SpidRefire
	Loop
  DoomWraith:
	DSHD F 7 A_FaceTarget
	DSHD G 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("DoomWraith2",32,0,0,CMF_TRACKOWNER)
	DSHD G 3 Bright A_Recoil(20)
	DSHD H 7
	GoTo See
  VileAttack:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	DSHD F 4 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DShadowTargeter",22,0,0,0,0,0,0,SXF_TRANSFERPOINTERS | SXF_SETMASTER)
	DSHD F 1 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DShadowTargeter",22,0,0,0,0,0,0,SXF_TRANSFERPOINTERS | SXF_SETMASTER)
	DSHD F 1 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("DShadowTargeter",22,0,0,0,0,0,0,SXF_TRANSFERPOINTERS | SXF_SETMASTER)
  VileChargeLoop:
	TNT1 A 0 A_JumpIfInventory("Tic",105,"VileChargeEnd")
	DSHD F 1 A_FaceTarget
	TNT1 A 0 A_VileTarget("DShadowHadesAttack")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_JumpIfTargetInLos("VileChargeLoop",360)
	TNT1 A 0
	GoTo See
  VileChargeEnd:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_JumpIfTargetInLos("VileExplode",360)
	DSHD G 4
	GoTo See
  VileExplode:
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	DSHD G 3 A_VileTarget("DShadowHadesExplode")
	DSHD G 4 A_FaceTarget
	GoTo See
  ShadowCall:
	DSHD E 35
	TNT1 A 0 A_JumpIfInTargetInventory("TrueLegendaryRune2Token",1,"ShadowCall.Hard")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 10,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,45,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 10,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,-45,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_SETMASTER|SXF_NOCHECKPOSITION)
	GoTo See
  ShadowCall.Hard:
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("SuperShadow",0,45,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("SuperShadow",0,-45,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,15,0,0,0,0,frandom(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,15,0,0,0,0,frandom(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,15,0,0,0,0,frandom(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("ShadowMinionCount") >= 18,"See")
	TNT1 A 0 A_SpawnItemEx("ShadowMinion",0,15,0,0,0,0,frandom(0,360),SXF_SETMASTER|SXF_NOCHECKPOSITION)
	GoTo See
  XDeath:
  Death:
	DSHD H 30 A_Scream
  DeathLoop:
	TNT1 A 0 A_PlaySound("DoomShadowDeathXPL",CHAN_AUTO,1.0,0)
	DSHD HH 1 Bright A_CustomMissile("Kaboom10",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))  
	DSHD HH 1 Bright A_CustomMissile("Kaboom10",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 4,1)
	Goto DeathLoop
	TNT1 A 0 A_PlaySound("DoomShadowDeathXPL",CHAN_AUTO,1.0,0)
	DSHD HHHH 1 Bright A_CustomMissile("Kaboom12",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))  
	TNT1 AA 0 A_CustomMissile("Kaboom12",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("Kaboom10",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))  
	DSHD HH 1 Bright A_CustomMissile("Kaboom10",frandom(10,50),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_PlaySound("DoomWraithSpawn",CHAN_AUTO,1.0,0)
	TNT1 A 0 A_PlaySound("SoulRazeLaugh3",CHAN_AUTO,1.0,0)
	TNT1 AA 0 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAAAA 0 A_CustomMissile("SmokeFX",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("BigRedBloodCloud",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAA 0 A_CustomMissile("RedBloodCloud",frandom(30,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SetUserVar("user_loop",-3)
  DeathLoop2:
	TNT1 A 0 A_CustomMissile("DoomWraith",35,0,user_loop * 45,CMF_AIMDIRECTION | CMF_TRACKOWNER)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 5,2)
	TNT1 A 0 A_Jump(256,"DeathLoop2")
	DSHD N 4 Bright A_Fall
	DSHD MOPQRS 4 Bright
	TNT1 A 0 A_KillChildren
	DSHD T 525
	TNT1 A 0 A_RemoveChildren
	DSHD T 5 A_FadeOut(0.1,1)
	Wait
  XRaise:
  Raise:
	Stop
  }
}

Actor SummonedDoomShadow : DoomShadow { -COUNTKILL }

Actor HavocSteal : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
	TNT1 A 0
	TNT1 A 0 A_GiveToTarget("Health",2)
	TNT1 A 1
	Stop
  }
}
Actor HavocSteal2 : CustomInventory
{
  +INVENTORY.ALWAYSPICKUP
  States
  {
  PickUp:
	TNT1 A 0
	TNT1 A 0 A_GiveToTarget("Health",4)
	TNT1 A 1
	Stop
  }
}

Actor DoomShadowTrailSpawner
{
  Height 56
  Radius 1
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1 A_SpawnItemEx("DoomShadowTrail",0,0,0,frandom(-6,6),frandom(-6,6),frandom(-6,6),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor DoomShadowTrail2Spawner
{
Height 56
Radius 1
+NOINTERACTION
+NOBLOCKMAP
+CLIENTSIDEONLY
+NONETID
States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1 A_SpawnItemEx("DoomShadowTrail2",0,0,0,frandom(-5,3),frandom(-5,5),frandom(-3,3),frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor DoomShadowTrail
{
  Renderstyle Translucent
  Alpha 0.6
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	DSHD A 4
	DSHD A 1 A_FadeOut(0.125,1)
	Wait
  }
}

Actor DoomShadowTrail2
{
  Renderstyle Translucent
  Alpha 0.6
  +MISSILE
  +DROPOFF
  +NOGRAVITY
  +NOINTERACTION
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +THRUACTORS
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AA 0 A_Jump(256,"Spawn1","Spawn2","Spawn3","Spawn4")
  Spawn1:
	DSHD CDEB 4
	DSHD B 1 A_FadeOut(0.125,1)
	Wait
  Spawn2:
	DSHD BCDE 4
	DSHD E 1 A_FadeOut(0.125,1)
	Wait
  Spawn3:
	DSHD EBCD 4
	DSHD D 1 A_FadeOut(0.125,1)
	Wait
  Spawn4:
	DSHD DEBC 4
	DSHD C 1 A_FadeOut(0.125,1)
	Wait
  }
}

Actor DSHadowTargeter
{
  Health 50
  Height 5
  Radius 5
  Speed 1
  Mass 5555
  +ISMONSTER
  -COUNTKILL
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOCLIP
  +NOPAIN
  +NODAMAGE
  +NOTARGET
  +CANTSEEK
  +DONTBLAST
  +NORADIUSDMG
  +INVULNERABLE
  +NONSHOOTABLE
  Species "Imps"
  DamageType "ImpComet"
  Obituary "$CFDSHadowTargeterObit"
  Tag "Shadow"
  States
  {
  Spawn:
	TNT1 A 0 A_GiveInventory("Tic",3)
	TNT1 A 0 A_JumpIfInventory("Tic",70,"Death")
	TNT1 AAA 1 A_Chase("","")
	TNT1 A 1 A_LookEx(0,0,0,0,360,"Missile")
	Loop
  See:
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("AlreadyTargeted",1,"ClearTarget")
	TNT1 AA 1 A_FaceTarget
	Goto VileStart
  VileStart:
	TNT1 A 0 A_GiveToTarget("AlreadyTargeted",1)
	TNT1 A 0 A_TakeInventory("Tic",500)
	Goto VileCharge
  VileCharge:
	TNT1 A 0 A_JumpIfInventory("Tic",105,"VileAttack")
	TNT1 A 1 A_FaceTarget
	TNT1 A 0 A_VileTarget("DShadowHadesAttack2")
	TNT1 A 0 A_GiveInventory("Tic",1)
	TNT1 A 0 A_JumpIfTargetInLos("VileCharge",360)
	Goto Death
  VileAttack:
	TNT1 A 0 A_JumpIfTargetInLos("VileExplode",360)
	TNT1 A 0 A_TakeFromTarget("AlreadyTargeted",1)
	TNT1 A 1
	GoTo Death
  VileExplode:
	TNT1 A 0
	TNT1 A 1 A_VileTarget("DShadowHadesExplode2")
	TNT1 A 0 A_TakeFromTarget("AlreadyTargeted",1)
	TNT1 A 1 A_FaceTarget
	GoTo Death
  Death:
	TNT1 A 0
	TNT1 A 0 A_TakeFromTarget("AlreadyTargeted",1)
	TNT1 A 1
	Stop
  ClearTarget:
	TNT1 A 1
	TNT1 A 0 A_ClearTarget
	GoTo Spawn
  }
}

Actor DShadowHadesAttack
{
  RenderStyle None
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +NOTONAUTOMAP
  +NOINTERACTION
  +CLIENTSIDEONLY
  //+NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("HadesSoulSpawner",0,0,-9999,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 AA 0 A_SpawnItemEx("Kaboom10Spawner",0,0,-9999,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 1 A_SpawnItemEx("HadesFire",frandom(-20,20),frandom(-20,20),frandom(-45,45),0,0,0,frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor HadesSoul : DoomShadowTrail
{
  Alpha 1.0
  Scale 0.8
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 1 A_Jump(60,"WithSound")
	DSOL ABCD 3 Bright A_SpawnItemEx("Kaboom10",0,0,0)
	DSOL D 1 Bright A_FadeOut(0.1,1)
	Wait
  WithSound:
	TNT1 A 0
	TNT1 A 1 A_Jump(10,"WithSound1")
	TNT1 A 0 A_PlaySound("SoulRazeSouls",CHAN_AUTO,1.0,0)
	DSOL ABCD 3 Bright A_SpawnItemEx("Kaboom10",0,0,0)
	DSOL D 1 Bright A_FadeOut(0.1,1)
	Wait
  WithSound1:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("SoulRazeLaugh1",CHAN_AUTO,1.0,0)
	DSOL ABCD 3 Bright A_SpawnItemEx("Kaboom10",0,0,0)
	DSOL D 1 Bright A_FadeOut(0.1,1)
	Wait
  }
}

Actor HadesFire : OrangeFire
{
  Scale 0.3
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	FRR1 ABCDEFGHIJKL 2 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor DSHadowHadesExplode
{
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +DONTSPLASH
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  Obituary "$CFDSHadowHadesExplodeObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("SoulRazeLaugh2",6,1.0,0)
	TNT1 A 0 A_PlaySound("SoulRazeLaugh3",7,1.0,0)
	TNT1 A 0 A_Explode(50,500,0,0,50)
	TNT1 A 1 A_SpawnItemEx("DSHadowHadesExplodeFX",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor DSHadowHadesExplodeFX
{
  +DONTBLAST
  +NONSHOOTABLE
  +NOINTERACTION
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 AAAAA 0 A_SpawnItemEx("Kaboom12Spawner",0,0,-9999,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 AAAAAAA 0 A_SpawnItemEx("HadesFireSpawner",0,0,-9999,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 1 A_SpawnItemEx("SoulRazeSprite",0,0,-9999,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	Stop
  }
}

Actor Kaboom10Spawner
{
  Projectile
  Height 8
  Radius 1
