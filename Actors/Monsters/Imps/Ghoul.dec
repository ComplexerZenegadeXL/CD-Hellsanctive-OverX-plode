Actor Ghouls : Inventory {}
Actor CFGhoul : Imp
{
Monster
  Health 150
  Height 56
  Radius 16
  Speed 7
  Damage (10)
  MeleeRange 70
  MaxStepHeight 64
  PainChance "Mine", 256
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance "Goreling", 256
  PainChance 10
  +FLOAT
  +FLOORCLIP
  +DROPOFF
  +NOTARGET
  +SLIDESONWALLS
  +MISSILEMORE
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  DamageFactor "Acid", 1.35
  DamageFactor "Fire", 0.7
  DamageFactor "Ghoul", 0.0
  //No Infighting
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DamageFactor "GlaucomaGas", 0.0
  DamageFactor "Glaucoma", 0.0
  DropItem "LifeEssence", 200, 4
  DropItem "CFArmorBonusMax5", 200
  DropItem "PartialKakuhou", 100, 1
  SeeSound "monster/vulsit"
  ActiveSound "monster/vulact"
  MeleeSound "monster/vulhit"
  PainSound "monster/vulpai"
  DeathSound "monster/vuldth"
  Obituary "$CFGhoulObit"
  HitObituary "$CFGhoulHitObit"
  Tag "$CFGhoul"
  States
  {
  Spawn:
	GHOL A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_GiveInventory("GHOULS",1)
  Idle:
	GHOL A 10 A_Look
	Loop
  Wander:
	TNT1 A 0 A_Gravity
	GHOL AAAA 1 A_Look
	TNT1 A 0 A_Wander
	GHOL BBBB 1 A_Look
	TNT1 A 0 A_Wander
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHOL CCCC 1 A_Look
	TNT1 A 0 A_Wander
	GHOL DDDD 1 A_Look
	TNT1 A 0 A_Wander
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 A_Gravity
	GHOL AA 1 A_Chase("","")
	TNT1 A 0 A_Gravity
	GHOL A 1 A_Chase
	TNT1 A 0 A_Gravity
	GHOL BB 1 A_Chase("","")
	TNT1 A 0 A_Gravity
	GHOL B 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHOL CC 1 A_Chase("","")
	GHOL C 1 A_Chase
	GHOL DD 1 A_Chase("","")
	GHOL D 1 A_Chase
	TNT1 A 0 A_Gravity
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHUL A 0 A_Jump(60,"Dodge")
	Loop
  Dodge:
	TNT1 A 0 A_Jump(255,"Strafe","FastChase")
	Goto See
  Strafe:
	GHOL A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	GHUL A 5 ThrustThing(angle*256/360+64,30,0,0)
	Goto See
  Left:
	GHOL A 5 ThrustThing(angle*256/360+192,30,0,0)
	Goto See
  Back:
	GHOL A 5 ThrustThing(angle*256/360+128,30,0,0)
	Goto See
  BackLeftRange:
	GHOL A 5 ThrustThing(angle*256/360+frandom(133,187),30,0,0)
	Goto See
  BackRightRange:
	GHOL A 5 ThrustThing(angle*256/360+frandom(69,123),30,0,0)
	Goto See
  FastChase:
	GHOL A 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL A 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL B 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL B 1 A_FastChase
	TNT1 A 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHOL C 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL C 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL D 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL D 1 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_FastChase
	GHOL A 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL A 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL B 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL B 1 A_FastChase
	TNT1 A 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	GHOL C 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL C 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL D 1 A_FastChase
	TNT1 A 0 A_FastChase
	GHOL D 1 A_FastChase
	TNT1 A 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(30,"See")
	Loop
  Melee:
	GHOL EF 3 A_FaceTarget
	GHOL G 3 A_CustomMissile("GhoulAttack",30,0,0)
	GHOL GG 2 A_JumpIfInventory("SuccessfulBite",1,"Detect")
	Goto See
  Detect:
	TNT1 A 0 A_ChangeFlag(Invulnerable,1)
	GHOL E 15 A_ChangeFlag(Invulnerable,0)
	GHUL E 1
	TNT1 A 0 A_TakeInventory("SuccessfulBite",1)
  End:
	TNT1 A 0 HealThing(30)
	TNT1 A 0 A_JumpIfInventory("BiteCountShot",5,"KakuHou")
	TNT1 A 0 A_JumpIfTargetInLos("See",360)
	TNT1 A 0 A_ClearTarget
	Goto Wander
  KakuHou:
	GHOL FG 5 A_FaceTarget
	TNT1 A 0 A_TakeInventory("BiteCountShot",5)
	TNT1 A 0 A_CustomMissile("GhoulShot",38,0,0)
	GHOL H 5
	Goto See
  Missile:
	TNT1 A 0 A_Jump(16,"KakuHou")
	GHOL A 1 A_Jump(100,"RightCharge","LeftCharge")
  Charge:
	TNT1 A 0 A_ClearTarget
	TNT1 A 0 A_LookEx(0,0,0,0,0,"Charging")
	GHOL E 2
	Goto Wander
  Charging:
	GHOL E 4 A_FaceTarget
	GHOL E 1 A_JumpIfCloser(70,"Melee")
	TNT1 A 0 ThrustThingZ(0,18,0,0)
	TNT1 A 0 A_SkullAttack(20)
	GHOL E 1 A_Recoil(-17)
	GHOL E 5 A_JumpIfCloser(70,"Melee")
	GHOL E 2 A_Stop
	TNT1 A 0 A_Gravity
	GHOL H 5
	Goto See
  RightCharge:
	TNT1 A 0 ThrustThing(angle*256/360+frandom(69,5),30,0,0)
	GHOL A 5
	GHOL A 1 A_Stop
	Goto Charge
  LeftCharge:
	TNT1 A 0 ThrustThing(angle*256/360+frandom(133,251),30,0,0)
	GHOL A 5
	GHOL A 1 A_Stop
	Goto Charge
  Pain:
	GHOL H 4 A_Pain
	TNT1 A 0 A_Jump(90,"Dodge")
	Goto See
  Death:
	GHOL I 3
	TNT1 A 0 A_TakeInventory("Ghouls",1)
	GHOL J 3 A_ScreamAndUnblock
	GHOL KLM 4
	TNT1 A 0 A_SpawnItem("BodyCrash",0,0,0,0)
	GHOL N -1
	Stop
  XDeath:
	GHOL O 5
	TNT1 A 0 A_TakeInventory("Ghouls",1)
	TNT1 A 0 A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,30)
	GHOL PQ 4
	TNT1 A 0 A_NoBlocking
	GHOL RSTU 3
	GHOL V -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	GHOL NMLKJIH 3
	TNT1 A 0 A_GiveInventory("Ghouls",1)
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	GHOL UTSRQPO 4
	TNT1 A 0 A_GiveInventory("Ghouls",1)
	Goto See
  Pain.Goreling:
	TNT1 A 0 A_JumpIfInventory("Ghouls",1,"See")
	TNT1 A 0 A_SpawnItemEx("BloodConsumeFX",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop
  }
}

Actor SummonedCFGhoul : CFGhoul { -COUNTKILL }

Actor GhoulAttack
{
  Projectile
  Speed 36
  Height 6
  Radius 6
  Damage (random(35,40))
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  Obituary "$CFGhoulAttackObit"
  States
  {
  Spawn:
	TNT1 A 2
  Crash:
  Death:
	TNT1 A 1
	Stop
  XDeath:
	TNT1 A 0
	TNT1 A 0 A_GiveToTarget("BiteCountShot",1)
	TNT1 A 0 A_GiveToTarget("BiteCount",1)
	TNT1 A 1 A_GiveToTarget("SuccessfulBite",1)
	Stop
  }
}

Actor GhoulShot
{
  Projectile
  Height 5
  Radius 8
  Speed 30
  Damage (Random(6,12))
  +RIPPER
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  SeeSound "Kagune/Spawn"
  DeathSound "Kagune/Crash"
  Obituary "$CFGhoulShotObit"
  States
  {
  Spawn:
	TNT1 A 1
	TNT1 A 0 A_PlaySound("Kagune/Spawn",0,1.0,0)
  Fly:
	KAGU PPPPPPPPPP 2 A_SpawnItemEx("KaguneGas",frandom(-5,5),frandom(-3,3),frandom(-3,3),0,0,0,frandom(0,360))
	Goto Death
  Death:
	TNT1 A 0
	TNT1 A 1
	TNT1 AAAA 0 A_SpawnItemEx("KaguneGas",frandom(5,-5),frandom(3,-3),frandom(3,-3),frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(0,360))
	TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("KaguneShard",0,0,0,25,frandom(-16,16),velz+frandom(-13,13),0,0,0)
	Stop
  }
}

Actor KaguneShard
{
  Projectile
  Speed 18
  Radius 3
  Height 3
  DeathSound "Shard/Hit"
  Damage (Random(4,6))
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:
	KAGU A 1 Bright A_SpawnItemEx("KaguneGas2",random(1,-1),random(1,-1),random(1,-1),0,0,0,random(0,360))
	Loop
  Death:
	TNT1 A 1
	TNT1 AAAA 0 A_SpawnItemEx("KaguneGas2",random(1,-1),random(1,-1),random(1,-1),random(5,-5),random(5,-5),random(5,-5),random(0,360))
	Stop
  }
}

Actor KaguneGas : RedBloodCloud { +NOBLOCKMAP Scale 0.2 }
Actor KaguneGas2 : RedBloodCloud { +NOBLOCKMAP Scale 0.03 }
Actor SuccessfulBite : Inventory {}
Actor BiteCount : Inventory { Inventory.MaxAmount 11 }
Actor BiteCountShot : Inventory { Inventory.MaxAmount 5 }