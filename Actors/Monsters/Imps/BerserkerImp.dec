Actor BerserkerImp : Devil
{
  Monster
  Health 450
  Radius 18
  Speed 10
  Damage (24)
  MaxStepHeight 64
  MeleeRange 78
  MeleeDamage 35
  PainChance "Mine", 128
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance 15
  +SLIDESONWALLS
  +DROPOFF
  +FLOAT
  +QUICKTORETALIATE
  +FLOORCLIP
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  DamageType "AdvancedImp"
  DamageFactor "Acid", 3.5
  //No Infighting
  DamageFactor "Glaucoma", 0
  DamageFactor "GlaucomaGas", 0
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DropItem "LifeEssence", 200, 4
  DropItem "CFArmorBonusMax5", 200
  DropItem "PartialKakuhou", 100, 1
  SeeSound "BerserkImp/See"
  ActiveSound "BerserkImp/Active"
  PainSound "BerserkImp/Pain"
  DeathSound "BerserkImp/Death"
  Obituary "$CFBerserkerImpObit"
  HitObituary "$CFBerserkerImpHitObit"
  Tag "$CFBersImp"
  States
	{
  Spawn:
	FIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_GiveInventory("GHOULS",1)
  Idle:
	FIMP A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_Gravity
	FIMP AAABBB 1 A_Chase
	TNT1 A 0 A_Gravity
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	FIMP CCCDDD 1 A_Chase
	TNT1 A 0 A_Gravity
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  Melee:
	FIMP EFG 3 A_FaceTarget
	TNT1 A 0 A_CustomMeleeAttack(random(25,35),"imp/melee","None")
	FIMP FE 1
	Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"Spikes")
  Normal:
	FIMP EF 4 A_FaceTarget
	FIMP G 2 A_FaceTarget
	TNT1 A 0 A_ChangeFlag("THRUSPECIES",1)
	TNT1 A 0 A_Recoil(-15)
	TNT1 A 0 A_SkullAttack(20)
	TNT1 A 0 A_Gravity
	FIMP G 25
	FIMP FE 4 A_Stop
	TNT1 A 0 A_ChangeFlag("THRUSPECIES",0)
	TNT1 A 0 A_JumpIfCloser(70,"Melee")
	FIMP E 3
	Goto See
  Spikes:
	FIMP E 4 A_FaceTarget
	FIMP F 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("SpineProjectile",29,8)
	FIMP FG 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("SpineProjectile",32,0)
	FIMP G 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("SpineProjectile",32,0)
	FIMP G 2 A_FaceTarget
	TNT1 A 0 A_CustomMissile("SpineProjectile",32,0)
	FIMP FEE 3
	Goto See
  Pain:
	TNT1 A 0 A_Jump(128,"SpikePain")
	TNT1 A 0 A_Jump(37,"Missile")
	FIMP H 5 A_Pain
	Goto See
  SpikePain:
	TNT1 AAAAAAAAAAAAA 0 A_CustomMissile("SpineProjectile",frandom(15,42),frandom(-4,4),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	FIMP HHHHH 3 A_Pain
	Goto See
  Death:
	TNT1 A 0 A_TakeInventory("Ghouls",1)
	FIMP I 4
	TNT1 A 0 A_ScreamAndUnblock
	FIMP JKL 4
	GHUL N 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	FIMP M -1
	Stop
  XDeath:
	FIMP N 3
	TNT1 A 0 A_TakeInventory("Ghouls",1)
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_XScream
	FIMP O 3
	TNT1 A 0 A_NoBlocking
	FIMP PQRST 3
	FIMP U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	FIMP LKJI 4
	TNT1 A 0 A_GiveInventory("Ghouls",1)
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	FIMP TSRQPN 3
	TNT1 A 0 A_GiveInventory("Ghouls",1)
	Goto See
  }
}

Actor SpineProjectile : KaguneShard
{
  Speed 22
  BounceCount 3
  BounceFactor 1.2
  WallBounceFactor 1.1
  Damage (Random(4,8))
  +RIPPER
  +HEXENBOUNCE
}