Actor Hellion : Imp
{
  Monster
  Health 210
  Radius 18
  Height 54
  Mass 120
  Speed 6
  BloodColor "Yellow"
  PainChance "Mine", 128
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance 60
  +NOTARGET
  +FLOORCLIP
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  DamageFactor "Acid", 0.7
  DamageFactor "Fire", 0.1
  //No Infighting
  DamageFactor "VileFires", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "Shadow", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DropItem "LifeEssence", 200, 8
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  SeeSound "monster/hlnsit"
  PainSound "monster/hlnpai"
  DeathSound "monster/hlndth"
  ActiveSound "monster/hlnact"
  Obituary "$CFHellionObit"
  HitObituary "$CFHellionHitObit"
  Tag "$CFHellion"
  var int user_health;
  var int user_lowlag;
  States
  {
  Spawn:
	H2LN A 0
	TNT1 A 0 A_GiveInventory("NoControl",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	H2LN A 7 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN AAAABBBBCCCCDDDD 1 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(40,"Revive")
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN AAAABBBBCCCCDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN EEEFFF 1 A_Chase
	Loop
  Revive:
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN AAAABBBBCCCCDDDD 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN EEEEFFFF 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN AAAABBBBCCCCDDDD 1 A_VileChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	H2LN EEEEFFFF 1 A_VileChase
	TNT1 A 0 A_Jump(72,"See")
	Loop
  QuadRevive:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_SpawnItemEx("DarkHellionReviveGhost")
	H2LN GGGG 2 Bright A_SpawnItemEx("CFHellionResRadius",0,0,0,frandom(-20,20),frandom(-20,20),0,frandom(0,360),SXF_CLIENTSIDE)
	H2LN HGHG 10 Bright
	TNT1 A 0 A_Explode(30,36,0)
	TNT1 A 0 A_SetUserVar("user_health",Health - 20)
	TNT1 A 0 A_JumpIf(user_health < 1,"Kill")
	TNT1 A 0 A_GiveInventory("ScriptToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetCurrentHealth",0,user_health)
	Goto See
  Heal:
	TNT1 A 0 A_ChangeFlag(NOPAIN,1)
	TNT1 A 0 A_Jump(20,"QuadRevive")
	H2LN GHG 10 Bright
	TNT1 A 0 A_Explode(10,36,0)
	TNT1 A 0 A_SetUserVar("user_health",Health - 10)
	TNT1 A 0 A_JumpIf(user_health < 1,"Kill")
	TNT1 A 0 A_GiveInventory("ScriptToken",1)
	TNT1 A 0 ACS_NamedExecuteAlways("CF_SetCurrentHealth",0,user_health)
	Goto See
  Melee:
  Missile:
	H2LN G 0 A_VileStart
	H2LN GHIJ 6 Bright A_FaceTarget
	TNT1 A 0 A_Jump(53,"Spreadshot")
	TNT1 A 0 A_Jump(39,"Tracers")
	H2LN K 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,frandom(-2,2),0,0)
	H2LN K 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,frandom(-2,2),0,0)
	H2LN K 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,frandom(-2,2),0,0)
	H2LN K 5 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,frandom(-2,2),0,0)
	H2LN KKKKK 1 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,random(-2,2),0,0)
	H2LN L 7
	Goto See
  Spreadshot:
	H2LN KKKKK 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,0,0,0)
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,-20,0,0)
	TNT1 A 0 A_CustomMissile("HellionBall",32,0,20,0,0)
	H2LN L 7
	Goto See
  Tracers:
	H2LN KKKK 4 Bright A_FaceTarget
	TNT1 A 0 A_CustomMissile("HellionTracer1",32,5,0,0,0)
	TNT1 A 0 A_CustomMissile("HellionTracer2",32,-5,0,0,0)
	H2LN L 7
	Goto See
  Pain:
	H2LN M 2
	H2LN M 2 A_Pain
	Goto See
  Kill:
	TNT1 A 0 A_Die
	Goto Death
  XDeath:
  Death:
	H2LN N 6
	H2LN O 6 A_Scream
	H2LN PQR 6
	H2LN S 6 A_Fall
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	Goto Fall
  Fall:
	H2LN S 1 A_CheckFloor("Land")
	TNT1 A 0 A_JumpIfInventory("Tic",525,"Land")
	TNT1 A 0 A_GiveInventory("Tic",1)
	Loop
  Land:
	TNT1 A 0 A_TakeInventory("Tic",999999)
	TNT1 A 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_ChangeFlag(CORPSE,1)
	TNT1 A 0 A_ChangeFlag(SOLID,0)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,0)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	H2LN T 1
	HLDT AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 2 Bright A_SpawnItemEx("HellionCorpseIgnition",0,0,0)
	HLDT BBBCCCDDD 2 Bright A_SpawnItemEx("HellionCorpseIgnition",0,0,0)
	HLDT EFG 3
	TNT1 A 0 A_RemoveChildren
	HLDT H -1
	Stop
  /*XDeath:
	H2LN U 5
	H2LN V 5 A_XScream
	H2LN W 5
	H2LN X 5 A_NoBlocking
	H2LN YZ 5
	H2L2 "AB" 5
	H2L2 C 63000 CanRaise
	Stop*/
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,0)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	HLDT HGFE 4
	H2LN TSRQPON 6
	Goto See
  }
}

Actor SummonedHellion : Hellion { -COUNTKILL }

Actor HellionCorpseIgnition : RedParticleSpawner
{
  -CLIENTSIDEONLY
  -NOINTERACTION
  +NOTARGET
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  -SOLID
  -SHOOTABLE
  +RIPPER
  +THRUSPECIES
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  -PIERCEARMOR
  Species "Imps"
  DamageType "ImpComet"
  Obituary "$CFHellionCorpseIgnitionObit"
  States
  {
  Spawn:
	TNT1 A 0 A_Explode(random(1,4),50)
	TNT1 A 0 A_PlaySound("monster/ambientfire")
	TNT1 AA 0 A_SpawnItemEx("GhostFire",frandom(-18,18),frandom(-18,18),frandom(5,12),0,0,frandom(2,5),0,SXF_CLIENTSIDE,0)
	TNT1 A 1
	Stop
  }
}

Actor HellionBall : CacodemonBall
{
  Damage 5
  Speed 15 
  Scale 0.9
  Decal "DoomImpScorch"
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +THRUGHOST
  +FORCEXYBILLBOARD
  Species "Imps"
  DamageType "ImpComet"
  SeeSound "hellion/ballfire"
  DeathSound "Hellion/balldth"
  States
  {
  Spawn:
	H2BL AAABBB 1 Bright A_SpawnItemEx("HellionPuff",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	H2BL JKLMN 3 Bright
	Stop
  }
}

Actor HellionPuff
{   
  Radius 3
  Height 3
  Scale 0.7
  RenderStyle Add
  Alpha 1.0
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	H2BL ABCDEFGHI 1 Bright A_FadeOut(0.1,1)
	Wait
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor HellionTracer1 : HellionBall
{
  Speed 35
  Scale 1.3
  Damage (Random(15,20)) //3
  Decal "DoomImpScorch'"
  +SEEKERMISSILE
  +HEXENBOUNCE
  BounceCount 3
  BounceFactor 1.2
  WallBounceFactor 1.2
  SeeSound "HellionTracerFire"
  DeathSound "HellionTracerHit"
  States
  {
  Spawn:
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(3,70,0)
	TNT1 A 0 A_Weave(3,3,1,1.5)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Explode(3,70,0)
	TNT1 A 0 A_Weave(3,3,1,1.5)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,1,1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,1,1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,1,1.5)
	TNT1 A 0 A_Explode(3,70,0)
	TNT1 A 0 A_SeekerMissile(18,9)
	Loop
  Death:
	TNT1 A 0 A_Explode(15,64,0)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	CFCF QRSTUVWXYZZZZZZZZZ 3 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor HellionTracer2 : HellionTracer1
{ 
  States
  {
  Spawn:
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,-1,-1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,-1,-1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,-1,-1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,-1,-1.5)
	TNT1 A 0 A_Explode(3,70,0)
	CFFX N 1 Bright A_SpawnItemEx("HellionTracerTail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,3,-1,-1.5)
	TNT1 A 0 A_Explode(3,70,0)
	TNT1 A 0 A_SeekerMissile(18,9)
	Loop
  }
}

Actor HellionTracerTail : HellionPuff
{   
  Scale 1.3
  States
  {
  Spawn:
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	CFFX NNNOOOOPPPP 1 Bright A_FadeOut(0.1,1)
	Wait
  }
}

Actor DarkHellionReviveGhost : RedParticleSpawner
{
  Scale 1.25
  Renderstyle Translucent
  Alpha 0.7
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	HELN GHGHG 10 Bright
	Goto Fade
  Fade:
	HELN G 1 Bright A_FadeOut(0.1,1)
	Loop
  }
}

Actor CFHellionResRadius : HellionResRadius
{
  RenderStyle None
  +NOEXPLODEFLOOR
  States
  {
  Spawn:
	TNT1 AAAAA 2 A_VileChase
	Stop
  Heal:
	TNT1 A 1
	Stop
  }
}