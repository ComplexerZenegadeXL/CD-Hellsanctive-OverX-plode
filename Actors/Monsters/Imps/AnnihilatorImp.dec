Actor AnnihilatorImp : Imp 16662
{
  //$Category Monsters/LCA
  //$Sprite RIMPA1
  //$Title "Annihilator Imp"
  Scale 1.1
  Health 400
  PainChance 60
  PainChance "SoulToxic", 20
  PainChance "FatFlamer", 20
  PainChance "FiendFire", 20
  PainChance "Explosion", 90
  +DONTHARMCLASS
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +MISSILEEVENMORE
  +FASTMELEE
  +AVOIDMELEE
  SeeSound "cimp/sight"
  PainSound "cimp/pain"
  DeathSound "cimp/death"
  ActiveSound "cimp/active"
  MeleeSound "weapons/fistwiff"
  MeleeDamage 6
  DamageType "ImpComet"
  DamageFactor "Cyber10K", 0.5
  DamageFactor "PDTBFG", 0.6
  DamageFactor "PDTBFGTracer", 0.9
  DropItem "LifeEssence" 256
  DropItem "ArmorBonusMax" 256
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "BulletMagPickup" 256 5
  DropItem "BulletBoxPickup" 128
  DropItem "MissilePickup" 256 5
  DropItem "MissileBoxPickup" 128 10
  DropItem "NewShellPickup" 256 4
  DropItem "NewShellBoxPickup" 128
  DropItem "AssaultRifleGiver" 100 1
  DropItem "AssaultShotgunGiver" 90 1
  DropItem "RocketLauncherGiver" 30 1
  DropItem "GrenadeLauncherGiver" 15 1
  Obituary "$CFAnnihilatorImpObit"
  HitObituary "$CFAnnihilatorImpHitObit"
  Tag "$CFAnniImp"
  States
  {
  Spawn:
    RIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	RIMP A 10 A_Look
	RIMI A 10 A_Look
    Loop
  See:
    RIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	RIMP CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop
  Pause:
	RIMP E 10
	Goto See
  Pause2:
	RIMP G 10
	Goto See
  Melee: 
    RIMP EF 5 A_FaceTarget
    RIMP G 4 A_MeleeAttack
	RIMP FE 5 A_FaceTarget
    Goto See 
  Lunge:
	TNT1 A 0 A_JumpIfCloser(300,1)
	Goto See
	TNT1 A 0 A_PlaySound("weapons/fistwiff")
	RIMP EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	RIMP G 2 A_Recoil(-30)
	RIMP G 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	RIMP G 6 
	RIMP F 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	RIMP E 1 A_ScaleVelocity(0)
	Goto See
  Missile:
    TNT1 A 0 A_Jump(64,"ARifle")
    TNT1 A 0 A_JumpIfCloser(200, "Nades")
    TNT1 A 0 A_JumpIfCloser(250, "Lunge")
    TNT1 A 0 A_JumpIfCloser(300, "ASG")
    RIMP E 6 A_FaceTarget
    RIMP W 10 Bright A_CustomMissile("CyberImpRocket")
	RIMP F 5
	RIMP G 6 A_FaceTarget
    RIMP V 10 Bright A_CustomMissile("CyberImpRocket")
	RIMP G 5
	TNT1 A 0 A_Jump(32,"Homing")
    Goto See
  ARifle:
    RIMP G 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/assaultrifle")
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    RIMP V 2 Bright A_CustomBulletAttack(15.4,0,1,frandom(9,15),"AnniImpPuff",0,CBAF_NORANDOM)
    RIMP G 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/assaultrifle")
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    RIMP V 2 Bright A_CustomBulletAttack(15.4,0,1,frandom(9,15),"AnniImpPuff",0,CBAF_NORANDOM)
    RIMP G 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/assaultrifle")
    TNT1 A 0 A_SpawnItemEx("RifleCasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    RIMP V 2 Bright A_CustomBulletAttack(15.4,0,1,frandom(9,15),"AnniImpPuff",0,CBAF_NORANDOM)
    RIMP G 10 A_FaceTarget
	TNT1 A 0 A_Jump(64,"Pause2")
    TNT1 A 0 A_CPosRefire
    Goto ARifle+1
  ASG:
    RIMP E 8 A_FaceTarget
	RIMP E 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("ShellCasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("ProjectileBullet",40,0,frandom(-10,10),0)
	TNT1 A 0 A_CustomBulletAttack(22.5, 18.3, 4,Random(9,15),"AnniImpPuff",0,CBAF_NORANDOM)
	RIMP W 2 Bright A_PlaySoundEx("AShotgun/Fire","Weapon")
    TNT1 A 0 A_Jump(64,"Pause")
    TNT1 A 0 A_SpidRefire
	Goto ASG+1
  Homing:
    RIMP E 6 A_FaceTarget
    RIMP W 10 Bright A_CustomMissile("CyberImpHomer")
	RIMP F 15
	RIMP G 6 A_FaceTarget
    RIMP V 10 Bright A_CustomMissile("CyberImpHomer")
	RIMP G 5
    Goto See
  Nades:
    RIMP E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    RIMP W 10 Bright A_CustomMissile("CyberImpGrenade")
	RIMP F 5
	RIMP G 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("Weapons/GrenadeFire")
    RIMP V 10 Bright A_CustomMissile("CyberImpGrenade")
	RIMP G 5
    Goto See
  Pain:
    RIMP H 2
    RIMP H 2 A_Pain
    Goto See
  Death:
    RIMP I 8
    RIMP J 8 A_Scream
    RIMP K 6
    RIMP L 6 A_NoBlocking
	RIMP M 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    RIMP M -1
    Stop
  XDeath:
	RIMP N 5 A_PlaySound("weapons/rocklx")
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	RIMP O 0 A_CustomMissile("RocketArm2",30,-10,270)
	RIMP O 0 A_CustomMissile("RocketArm",30,10,93)
    RIMP O 5 A_XScream
	RIMP P 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("CyberImpDeathRocket",0,0,28)
	RIMP P 5 A_SpawnItemEx("AnnihilatorImpExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    RIMP Q 5 A_NoBlocking
    RIMP RST 5
    RIMP U -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    RIMP ML 8
    RIMP KJI 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	RIMP UTSRQPON 4
	Goto See
  }
}

Actor SummonedAnnihilatorImp : AnnihilatorImp { -COUNTKILL }

Actor AnnihilatorImpExplosion
{
  Species "Imps"
  DamageType "ImpComet"
  States
  {
    Spawn:
	TNT1 A 0
	TNT1 A 0 A_Explode(80,100,0,0,100,0,0,"None")
	Stop
  }
}

Actor RocketArm : BodyPart1
{
  Radius 12
  Height 10
  Speed 4
  +DOOMBOUNCE
  +DROPOFF
  +MISSILE
  States
  {
  Spawn:
    AIRM ABCD 3
    Loop
  Crash:
	AIRM H 525
	"####" "###########" 8 A_FadeOut(0.1,1)
	Stop
  }
} 

Actor RocketArm2 : RocketArm
{
  States
  {
  Spawn:
    AIR2 ABCD 3
    Loop
  Crash:
	AIR2 H 525
	"####" "###########" 8 A_FadeOut(0.1,1)
	Stop
  }
} 

Actor CyberImpRocket : CyberLordRocket
{
  Damage (random(15,20)) //4
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Death:
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(40,128,0)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }  
}

Actor CyberImpHomer : CyberLordHomer
{
  Damage (random(10,15)) //5
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	HMIS A 3 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	HMIS A 3 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	HMIS A 3 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
	TNT1 A 0 A_Tracer2
	TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
    HMIS A 2 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(0,2),frandom(-2,2))
	HMIS A 3 Bright A_CustomMissile("ProjectileTrailParticleOrange",frandom(0,2),frandom(-2,2))	
	TNT1 A 0 A_PlaySound("monster/homingrockbeep")
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), 2, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), 2, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(34,128)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}

Actor CyberImpGrenade : CyberLordGrenade { Damage (Random(30,50)) Species "Imps" DamageType "ImpComet" }

Actor AnniImpPuff : BulletPuff { Species "Imps" DamageType "ImpComet" }

Actor CyberImpDeathRocket : CyberImpRocket
{
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("MissileTrail",frandom(4,6),frandom(-2,2)) 
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleOrange",frandom(4,6),frandom(-2,2)) 
	Goto Death
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("Kaboom3", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX2", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAAA 0 A_SpawnItemEx("Debris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
    TNT1 A 0 A_Explode(64,128,0)
    TNT1 A 1 A_SpawnItemEx("RocketEx",0,0,0,0,0,0,0)
    Stop
  }
}
