Actor LegendaryImp 16504
{
  //$Category Monsters/LCA
  //$Sprite LEGNA1
  //$Title "Legendary Imp"
  Health 999
  Radius 20
  Height 56
  Mass 100
  Speed 8
  PainChance 50
  Monster
  MeleeDamage 15
  DamageFactor 0.75
  DamageFactor "Exos", 0.0
  DamageFactor "Hell", 0.0
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "Legendary", 0.0
  DamageFactor "Moloch", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Nemesis", 0.0
  DamageFactor "Void", 0.0
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuru", 0.0
  DamageFactor "LegendaryGuruPlayer", 0.3
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDTRG", 0.5
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.3
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "Explosion", 0.5 //0.5
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DamageFactor "AdvancedImp", 0.0
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticRifle" 30 1
  DropItem "LegendarySphere" 90 1
  DropItem "LegendaryPowerSphere" 85 1
  DropItem "LDemonAmmoBoxPickup" 200
  DropItem "LDemonAmmoPickup" 250
  DropItem "LegendaryRandomSphere" 16 1
  Species "Imps"
  +FLOAT
  +NOTARGET
  +BOSS
  +BOSSDEATH
  +AVOIDMELEE
  +NOTIMEFREEZE
  +NOGRAVITY
  +FLOORCLIP
  +MISSILEMORE
  +QUICKTORETALIATE
  +MISSILEEVENMORE
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  +NOICEDEATH
  +DONTGIB
  +NORADIUSDMG
  +NOFEAR
  +NOTELEFRAG
  SeeSound "legimp/sight"
  PainSound "legimp/pain"
  DeathSound "legimp/death"
  ActiveSound "legimp/active"
  Obituary "$CFLegendaryImpObit"
  HitObituary "$CFLegendaryImpHitObit"
  BloodColor "Blue"
  MeleeSound "imp/melee"
  Tag "$CFLegImp"
  var int user_music;
  var int user_effect_type;
  var int user_effect_quantity;
  var int user_effect_delay;
  var int user_lowlag;
  States
  {
  Spawn:
    LEGN A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    LEGN AQ 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LEGN AABBCCDD 3 Bright A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
    TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,3)
	TNT1 A 0 A_SetUserVar("user_music",1)
    LEGN AABBCCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(50,"AirDodge")
	Loop
  AirDodge:
	LEGN A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	LEGN A 0
	LEGN A 0 ThrustThing(angle*256/360+64,30,0,0)
	LEGN A 5 Bright
	Goto See
  Left:
	LEGN A 0
	LEGN A 0 ThrustThing(angle*256/360+192,30,0,0)
	LEGN A 5 Bright
	Goto See
  Back:
	LEGN A 0
	LEGN A 0 ThrustThing(angle*256/360+128,30,0,0)
	LEGN A 5 Bright
	Goto See
  BackLeftRange:
	LEGN A 0
	LEGN A 0 ThrustThing(angle*256/360+random(133,187),30,0,0)
	LEGN A 5 Bright
	Goto See
  BackRightRange:
	LEGN A 0
	LEGN A 0 ThrustThing(angle*256/360+random(69,123),30,0,0)
	LEGN A 5 Bright 
	Goto See
  Melee:
    LEGN EF 6 Bright A_FaceTarget
    LEGN F 5 Bright A_MeleeAttack
	Goto See
  Missile:
    TNT1 A 0 A_SetShootable
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
    TNT1 A 0 A_FadeIn(1.0)
    TNT1 A 0 A_Jump(32,"Super") //32
    TNT1 A 0 A_Jump(64,"Seeker")
  Normal:
    LEGN OP 8 Bright A_FaceTarget
	LEGN P 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("LegendaryBall", 28, 0, 0)
	TNT1 A 0 A_CustomMissile("LegendaryBall", 28, 0, -5)
	TNT1 A 0 A_CustomMissile("LegendaryBall", 28, 0, 5)
	TNT1 A 0 A_CustomMissile("LegendaryBall", 28, 0, -10)
	TNT1 A 0 A_CustomMissile("LegendaryBall", 28, 0, 10)
	TNT1 A 0 A_Jump(88,"Seeker")
	Goto See
  Seeker:
	LEGN OP 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
    LEGN P 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
    LEGN P 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
	LEGN P 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
    LEGN P 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
    LEGN P 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LEGN P 6 Bright A_CustomMissile("LegImpSeekBall",32,20,0)
	Goto See
  Super:
	TNT1 A 0 A_JumpIfCloser(200,"Normal")
	TNT1 A 0 A_PlaySound ("legimp/chargingsound")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	LEGN O 0 A_FaceTarget
	LEGN OOOOO 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN O 0 A_FaceTarget
	LEGN OOOOO 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN O 0 A_FaceTarget
	LEGN OOOOO 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN O 0 A_FaceTarget
	LEGN OOOOO 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN O 0 A_FaceTarget
	LEGN OOOOO 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 0 A_FaceTarget
	LEGN PPPPP 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 0 A_FaceTarget
	LEGN PPPPP 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 0 A_FaceTarget
	LEGN PPPPP 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 0 A_FaceTarget
	LEGN PPPPP 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 0 A_FaceTarget
	LEGN PPPPP 2 Bright A_SpawnItemEx("LegImpLineSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	LEGN P 6 Bright A_CustomMissile ("LegendaryImpBlueBall",28,0,0)
	TNT1 A 0 A_playSound ("legimp/fiyabetch")
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Rush:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryImpGhost")	
	LEGN A 1 Bright A_Chase
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Teleport:
    LEGN A 1 Bright A_UnSetShootable
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LEGN AAAAAAAAAA 1  A_FadeOut(0.1,0)
	LEGN A 2 
	LEGN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    LEGN A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	LEGN AAAAAAAAAA 1 A_FadeIn(0.1)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
    LEGN A 1 Bright A_SetShootable
    Goto See		
  Pain:
    TNT1 A 0 A_Jump(50,"Teleport")
    LEGN H 2 Bright
	LEGN H 2 Bright A_Pain
	Goto See
  Death:
    TNT1 A 0 A_StopSound(6)
	LEGN I 8
    LEGN J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(2,3),256)
    LEGN K 6
    LEGN L 6 A_NoBlocking
    LEGN M 1
    LEGN N -1
	Stop
  }
}

Actor LegendaryImpGhost
{
  Scale 1.1
  Radius 20
  Height 56
  Speed 0
  Alpha 0.7
  Projectile
  RenderStyle Translucent
  +CLIENTSIDEONLY
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    LEGN A 2 A_FadeOut(0.10)
    Goto Spawn+1
  Vanilla:
    TNT1 A 0
	Stop		
  }
}

Actor LegendaryImpBlueBall
{
  Height 15
  Radius 10
  Speed 25
  FastSpeed 27
  Damage (Random(120,300))
  Species "Imps"
  DamageType "Legendary"
  Decal "BFG9500LightningBlue"
  Projectile
  SeeSound "imp/attack"
  DeathSound "BFG9K/Explode"
  Renderstyle Add
  +RANDOMIZE
  +FORCERADIUSDMG
  +NOTIMEFREEZE
  Scale 1.2
  States
  {
  Spawn:
	TNT1 A 0 NoDelay A_PlaySound("legball/fly",6,1.0,1)
	Goto Fly
  Fly:
	LIBB A 3 Bright A_CustomMissile("LegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailA")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailB")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailC")
	LIBB B 3 Bright A_CustomMissile("LegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailA")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailB")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailC")
	LIBB C 3 Bright A_CustomMissile("LegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailA")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailB")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailC")
	LIBB D 3 Bright A_CustomMissile("LegBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailA")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailB")
	TNT1 A 0 A_SpawnItemEx("BlueBallTrailC")
	Loop
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_Explode(158,138,0)
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	LIBE ABCDEFG 4
	Stop
  }
}

Actor BlueBallTrailA
{ 
  +NOINTERACTION
  +NOTIMEFREEZE
  +CLIENTSIDEONLY
  RenderStyle Add
  Alpha 0.45
  Scale 0.5
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TLBB AAAAAAAAAAAAAA 1 Bright A_FadeOut(0.015)
	Wait
  Vanilla:
    TNT1 A 0
	Stop	
  }
}

Actor BlueBallTrailB : BlueBallTrailA
{ 
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TLBB BBBBBBBBBBBB 1 Bright A_FadeOut(0.02)
	Wait
  }
}

Actor BlueBallTrailC : BlueBallTrailA
{ 
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TLBB CCCCCCCCCCCC 1 Bright A_FadeOut(0.02)
	Wait
  }
}

Actor LegBallAttack
{
  Projectile
  Height 3
  Radius 3
  Speed 25
  FastSpeed 25
  +LOOKALLAROUND
  +QUICKTORETALIATE
  +NOTARGET
  +NOTIMEFREEZE
  Species "Imps"
  DamageType "Legendary"
  Obituary "$CFLegBallAttackObit"
  //+ISMONSTER
  //+NOCLIP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CopyFriendliness(AAPTR_TARGET)
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 AAAAA 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_MASTER, AAPTR_NULL)
	TNT1 A 1 A_CustomRailgun(5,0,None,"Blue",RGF_SILENT|RGF_FULLBRIGHT,0,12,"LegendaryImpPuff",0,0,0,0,10,0,"Leg10kRailParticle")
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor LegendaryImpPuff : ImpRailPuff
{
  +THRUSPECIES
  +MTHRUSPECIES
  +PUFFGETSOWNER
  +BLOODLESSIMPACT
  DamageType "Legendary"
}


Actor LegendaryBallTrail : NightBallTrail
{
  Scale 0.8
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LKBT GHIJKL 1 A_FadeOut(0.1)
	Stop
  }
}

Actor LegendaryBall
{
  Radius 8
  Height 6
  Speed 20
  Damage (Random(50, 90)) //20
  Species "Imps"
  DamageType "Legendary"
  Scale 0.8
  FastSpeed 25
  Projectile
  RenderStyle Add
  Alpha 0.85
  SeeSound "Null"
  DeathSound "imp/shotx"
  Decal "DoomImpScorch"
  +NOTIMEFREEZE
  +DONTHARMSPECIES
  States
  {
  Spawn:
    LKB1 ABC 1 Bright A_SpawnItemEx("LegendaryBallTrail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)	
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6",0,0, frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4",0,0, frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))		
    LKB1 DEFGH 3 Bright
    Stop
  }   
}

Actor LegImpSeekBall
{
  Radius 8
  Height 8
  Speed 35
  FastSpeed 19
  Damage (Random(20,30))
  Species "Imps"
  DamageType "Legendary"
  Projectile
  +SEEKERMISSILE
  +RIPPER
  +NOBOSSRIP
  +BLOODLESSIMPACT
  +NOTIMEFREEZE
  DeathSound "phaseimp/shotx"
  RenderStyle Add
  Decal "DoomImpScorch"
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(12,0)
	TNT1 A 0 A_BishopMissileWeave
    LIM1 A 1 Bright A_SpawnItemEx("LegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BishopMissileWeave
    LIM1 B 1 Bright A_SpawnItemEx("LegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BishopMissileWeave
	LIM1 C 1 Bright A_SpawnItemEx("LegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BishopMissileWeave
    LIM1 D 1 Bright A_SpawnItemEx("LegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("LegendaryBlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("LegendaryKaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("LegendarySmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    LIM1 EFG 3 Bright
    Stop
  }
}

Actor LegImpSeekBallTrail : BFG9500Trail
{
  Scale 1
  +NOTIMEFREEZE
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    LIM1 GHIJKL 1 A_FadeOut(0.1)
	Stop
  }
}

Actor LegImpLineSpawner : BluePowerLineSpawner
{
  +NOTIMEFREEZE
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_CustomMissile("LegendaryBlueSparkleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAA 0 A_SpawnItemEx("LegendaryBluePowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("LegendaryBluePowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}