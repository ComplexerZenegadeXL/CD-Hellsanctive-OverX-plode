Actor DarkCatharsi : Imp
{
  Monster
  Health 450
  Height 56
  Radius 18
  Mass 100
  Speed 6
  BloodColor "Green"
  PainChance "SoulToxic", 60
  PainChance "FatFlamer", 60
  PainChance "FiendFire", 60
  PainChance "Mine", 128
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance "SoulToxic", 0
  PainChance "Cacolich", 0
  PainChance 30
  +NODROPOFF
  +NORADIUSDMG
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +FLOORCLIP
  +AVOIDMELEE
  +DONTHARMSPECIES
  DamageType "AdvancedImp"
  DamageFactor "Fire", 0.7
  RadiusDamageFactor 0.25
  //No Infighting
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "Shadow", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "SoulToxic", 0.25
  DamageFactor "Cacolich", 0.25
  DamageFactor "ImpComet", 0.0
  DropItem "LifeEssence", 235, 20
  DropItem "CFArmorBonusMax5", 185
  DropItem "CFArmorBonusMax5", 185
  DropItem "CFArmorBonusMax5", 185
  DropItem "CFArmorBonusMax5", 185
  DropItem "ShieldSphere", 32, 1
  DropItem "NewCellPickup" 256
  DropItem "NewCellPackPickup" 128
  SeeSound "catharsi/sit"
  PainSound "catharsi/pain"
  DeathSound "catharsi/death"
  ActiveSound "imp/active"
  Obituary "$CFDarkCatharsiObit"
  Tag "$CFDCatharsi"
  var int user_lowlag;
  States
  {
  Spawn:
	DCTH A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	DCTH A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	DCTH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	DCTH AABB 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	DCTH CCDD 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(62,"Boost")
	Loop
  Boost:
	DCTH A 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH A 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostA",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH B 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH B 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostB",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	DCTH C 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH C 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostC",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH D 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	DCTH D 1 A_Chase
	TNT1 A 0 A_Chase
	TNT1 A 0 A_SpawnItemEx("CatharsiGhostD",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(50,"See")
	Loop
  Melee:
  Missile:
	//TNT1 A 0 A_ChangeFlag(NoTarget,1)
	//TNT1 A 0 A_CustomMissile("BribeCaco",1,0,0,2,-90)
	DCTH E 1 A_Jump(30,"BFG10K")
	DCTH EEE 5 A_FaceTarget
	//TNT1 A 0 A_ChangeFlag(NoTarget,0)
  MissileLoop:
	DCTH E 2
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire")
	DCTH F 2 Bright A_CustomMissile("Catharsi15K",30,8,random(4,-8),0)
	DCTH E 4 A_FaceTarget
	DCTH E 1 A_Jump(32,"Break")
	DCTH E 1 A_CPosRefire
	Loop
  Break:
	DCTH E 15
	Goto See
  BFG10K:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("weapons/charge15k",CHAN_WEAPON)
	DCTH EEEEE 6 A_FaceTarget
	//TNT1 A 0 A_ChangeFlag(NoTarget,0)
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kfire",CHAN_WEAPON)
	DCTH F 3 Bright A_CustomMissile("Catharsi10K",30,8,random(4,-8),0)
	DCTH E 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("weapons/bfg15kcooldown",CHAN_WEAPON)	
	Goto See
  Pain:
	DCTH G 3 A_Pain
	Goto See
  XDeath:
  Death:
	DCTH GGGG 8 A_PlaySound("monster/homingrockbeep",6)
	DCTH O 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Explode(80,300,XF_NOTMISSILE) 
	TNT1 A 0 A_CustomMissile("Catharsi10K",30,0,0,2,-90)
	TNT1 AAAAAAA 0 A_CustomMissile("Catharsi10K",30,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	DCTH P 5 A_XScream
	TNT1 A 0 A_NoBlocking
	DCTH QRSTUV 3
	DCTH W -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	DCTH WVUTSRQP 4
	DCTH G 5
	Goto See
  }
}

Actor SummonedDarkCatharsi : DarkCatharsi { -COUNTKILL }

Actor Catharsi15k
{
  Projectile
  Height 15
  Radius 15
  Speed 35
  Scale 0.5
  RenderStyle Add
  Alpha 0.75
  Damage (Random(15,30)) //5
  +RANDOMIZE
  +FORCERADIUSDMG
  +STRIFEDAMAGE
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  SeeSound "weapons/bfg15kfire"
  DeathSound "weapons/bfg95explode"
  States
  {
  Spawn:
	BFS1 AB 2 Bright A_SpawnItemEx("BFGTrailParticleGreen",frandom(-8,8),frandom(-8,8),frandom(-8,8),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-20,20),SXF_CLIENTSIDE)
	Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0) 
	TNT1 AAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE1 A 4 Bright A_Explode(20,134)
	BFE1 BCDEF 4 Bright
	Stop
  }
}

Actor Catharsi10K : FastProjectile
{
  Projectile
  Height 1
  Radius 1
  Speed 200
  Scale 0.15
  RenderStyle Add
  Alpha 0.85
  +NOEXTREMEDEATH
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  DeathSound "weapons/bfg95explode"
  Obituary "$CFCatharsi10KObit"
  States
  {
  Spawn:
	TRA2 A 10 Bright
	Loop
  Death:
  XDeath:
	TNT1 A 1 A_SpawnItemEx("Catharsi10KEx",0,0,0,0,0,0,0,SXF_SETMASTER,0)
	Stop
  }
}

Actor Catharsi10KEx
{
  Height 8
  Radius 11
  Scale 0.85
  Renderstyle Add
  Alpha 0.75
  Damage (Random(80,100))
  +NOGRAVITY
  +NOBLOCKMAP
  +NOTELEPORT
  +FORCERADIUSDMG
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("BFGShockwave",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_SpawnItemEx("GreenParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAAA 0 A_CustomMissile("Kaboom13",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	BFE1 A 4 Bright A_Explode(100,100,0)
	BFE1 BCDEF 4 Bright
	Stop
  }
}

Actor CatharsiGhostA
{
  Height 56
  Radius 2
  RenderStyle Translucent
  Alpha 0.7
  +NONSHOOTABLE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  +NONETID
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	DCTH A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop
  }
}

Actor CatharsiGhostB : CatharsiGhostA
{
  States
  {
  Fade:
	DCTH B 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor CatharsiGhostC : CatharsiGhostA
{
  States
  {
  Fade:
	DCTH C 2 A_FadeOut(0.1,1)
	Loop
  }
}

Actor CatharsiGhostD : CatharsiGhostA
{
  States
  {
  Fade:
	DCTH D 2 A_FadeOut(0.1,1)
	Loop
  }
}