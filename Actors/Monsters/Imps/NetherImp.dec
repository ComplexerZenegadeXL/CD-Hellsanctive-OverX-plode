Actor NetherImp : Imp 17551
{
  //$Category Monsters/CF
  //$Sprite NIMPA1
  //$Title "Nether Imp"
  Obituary "$CFNetherImpObit"
  HitObituary "#CFNetherImpHitObit"
  Health 200
  Speed 9
  Scale 1.1
  Painchance 80
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "CFManaPickup" 70 30
  SeeSound "devil/Sight"
  PainSound "voidimp/Pain"
  DeathSound "devil/Death"
  ActiveSound "superimp/Active"
  BloodColor "Green"
  Tag "$CFNether"
  +MISSILEMORE
  +DONTHARMSPECIES
  var int user_lowlag;
  States
  {
  Spawn:
    NIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	NIMP A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
  	TNT1 A 0 A_Jump(46,"Evade")
    NIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	NIMP CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	NIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	NIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	TNT1 A 0 A_JumpIfTargetInLOS("Missile")
	Goto See
  Melee: 
    NIMP EF 5 A_FaceTarget
    NIMP G 4 A_CustomMeleeAttack(20)
	NIMP FE 5 A_FaceTarget
    Goto See 
  Missile:
    NIMP E 0 A_Jump(256,"Lightning","Fireballs","Comet")
    Goto See
  Lightning:
    NIMP EF 8 Bright A_FaceTarget
    NIMP G 6 Bright A_CustomMissile("NetherLightning", 34, 0, 0)
    NIMP FEF 8 Bright A_FaceTarget
    NIMP G 6 Bright A_CustomMissile("NetherLightning", 34, 0, 0)
    Goto See
  Fireballs:
    NIMP IJ 8 Bright A_FaceTarget
    NIMP K 4 Bright A_CustomMissile("NetherBall", 34, 0, 0)
    NIMP K 0 A_CustomMissile("NetherBall", 34, 0, 6)
    NIMP K 4 Bright A_CustomMissile("NetherBall", 34, 0, -6)
    Goto See
  Comet:
    NIMP IJ 10 Bright A_FaceTarget
    NIMP K 4 Bright A_CustomMissile("NetherImpComet", 34, 0, 0)
    NIMP JIJ 6 Bright A_FaceTarget
    NIMP K 4 Bright A_CustomMissile("NetherImpComet", 34, 0, 0)
    Goto See
  Pain:
    NIMP H 2 
    NIMP H 2 A_Pain
    Goto See
  Death:
    NIMP L 8 A_Scream
    NIMP MN 6
    NIMP O 6 A_Fall
    NIMP P -1
    Stop
  XDeath:
    NIMP Q 3 
	NIMP R 3 A_XScream
	NIMP S 3 A_SpawnItemEx("GreenGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	NIMP T 3 A_Fall
	NIMP UVW 3
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	NIMP X -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	NIMP PONML 6
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	NIMP XWVUTRSQ 3
  Goto See
  }
}

Actor SummonedNetherImp : NetherImp { -COUNTKILL }

Actor NetherBall
{
  Projectile
  Species "Imps"
  Damagetype "ImpComet"
  Radius 8
  Height 6
  Speed 20
  Damage (Random(20,35)) //6
  Renderstyle Add
  Alpha 0.67
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  Decal DoomImpScorch
  States
  {
  Spawn:
    IBA2 AAAABBBB 1 Bright A_SpawnItemEx("NetherImpBallFX")
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    IBA2 CDE 4 Bright
    Stop
  }
}

Actor NetherImpBallFX : BFG9500Trail
{
  Scale 1.2
  Alpha 0.9
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 1
    IBAT ABCDEF 1 A_FadeOut(0.1)
    Stop
  }
}

Actor NetherLightning : FastProjectile
{
  Species "Imps"
  Damagetype "ImpComet"
  Radius 8
  Height 6
  Speed 50
  Damage (Random(15,30)) //5
  +FORCEXYBILLBOARD
  SeeSound "NetherLightning"
  DeathSound "imp/shotx"
  Missileheight 8
  Missiletype "NetherLightningTrailSpawner"
  Renderstyle Add
  Scale 0.2
  States
  {
  Spawn:
	NLIG ABCDE 1 Bright
    Loop
  Death:
	TNT1 A 0 A_SpawnItemEx("YellowParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("KaboomGoldBabySent", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SetScale(0.75)
    NLIT ABCDEFG 1 Bright
    Stop
  }
}

Actor NetherLightningTrailSpawner : ImpBallTrail
{
  States
  {
  Spawn:
	TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AA 0 A_SpawnItemEx("NetherLightningTrail", frandom(-5, 5), frandom(-5, 5), frandom(-5, 5), 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Stop
  }
}

Actor NetherLightningTrail : ImpballTrail
{
  Scale 0.2
  Renderstyle Add
  Alpha 0.8
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 A 1
    TNT1 A 0 A_Jump(255, "Puff1", "Puff2", "Puff3")
  Puff1:
    NLIG F 1 Bright A_FadeOut(0.1)
    Loop
  Puff2:
    NLIG G 1 Bright A_FadeOut(0.1)
    Loop
  Puff3:
    NLIG H 1 Bright A_FadeOut(0.1)
    Loop
  }
}

Actor NetherImpComet : HDComet
{
  Radius 6
  Height 6
  Speed 30
  FastSpeed 26
  Damage (Random(20,35)) //7
  Scale 0.5
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:
	HCMT AAAABBBBCCCC 1 Bright A_SpawnItemEx("NetherCometTail")
	Loop
  Death:
	TNT1 A 0 A_Explode(40,88)
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	HCMT DE 3 Bright
	TNT1 A 0 A_SpawnItemEx("NetherCometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}

Actor NetherCometTail : HDCometTail
{
  Scale 0.6
  +NOINTERACTION
  +NOBLOCKMAP
}

Actor NetherCometDeath : HDCometDeath
{
  Scale 0.75
  +NOINTERACTION
  +NOBLOCKMAP
}