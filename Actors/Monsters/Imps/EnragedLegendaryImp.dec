Actor EnragedLegendaryImp : LegendaryImp
{
  Health 1200
  Speed 14
  PainChance 50
  MeleeDamage 20
  DamageFactor 0.6
  DamageFactor "PlasmaBall", 2.0
  DamageFactor "LegendaryPlayer", 0.25
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.1
  DamageFactor "PlayerDBFG10K2", 0.1
  DamageFactor "DBFG2", 0.1
  DamageFactor "PlayerDBFG2", 0.1
  DamageFactor "PlayerNemesisPlasma", 0.5
  DamageFactor "PlayerNemesisBFG", 0.25
  DamageFactor "Lightning", 0.5
  DamageFactor "NemesisBall", 0.2
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "Ice", 0.25
  DamageFactor "PlayerIce", 0.25
  DamageFactor "BFGSplash", 0.4
  DamageFactor "None", 0.4
  DamageFactor "Normal", 0.8
  DamageFactor "HellComet", 0.4
  DropItem "EnragedLegendarySphere" 70
  DropItem "LegendaryPowerSphere" 85
  DropItem "ILDemonAmmoBoxPickup" 200
  DropItem "ILDemonAmmoPickup" 250
  DropItem "LegendaryBossLifeEssence" 256
  DropItem "LegendaryBossArmorBonusMax" 256
  DropItem "LegendaryBossLifeEssence" 128
  DropItem "LegendaryBossArmorBonusMax" 128
  //DropItem "EnragedLegendaryPlasmaticRifleGiver" 76
  DropItem "LegendaryRandomSphere" 16
  Species "Imps"
  +BRIGHT
  SeeSound "ELegImp/Sight"
  PainSound "ELegImp/pain"
  DeathSound "ELegImp/death"
  ActiveSound "ELegImp/active"
  BloodColor "Red"
  MeleeSound "imp/melee"
  Obituary "$CFEnragedLegendaryImpObit"
  HitObituary "$CFEnragedLegendaryImpHitObit"
  Tag "$CFEnrImp"
  var int user_missile;
  States
  {
  Spawn:
	IEGN A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",2)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
    IEGN AQ 10 A_Look
	Loop
  See: 
	TNT1 A 0 A_SetUserVar("user_effect_type",20)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IEGN AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,401)
	TNT1 A 0 A_SetUserVar("user_music",1)
    IEGN AABBCCDD 3 A_Chase
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(50,"AirDodge")
	Loop
  AirDodge:
	IEGN A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	GoTo See
  Right:
	IEGN A 5 ThrustThing(angle*256/360+64,30,0,0)
	GoTo See
  Left:
	IEGN A 5 ThrustThing(angle*256/360+192,30,0,0)
	GoTo See
  Back:
	IEGN A 5 ThrustThing(angle*256/360+128,30,0,0)
	GoTo See
  BackLeftRange:
	IEGN A 5 ThrustThing(angle*256/360+frandom(133,187),30,0,0)
	GoTo See
  BackRightRange:
	IEGN A 5 ThrustThing(angle*256/360+frandom(69,123),30,0,0)
	GoTo See
  Melee:
    IEGN EF 6 A_FaceTarget
    IEGN F 5 A_MeleeAttack
	Goto See
  Missile:
    TNT1 A 0 A_Jump(32,"Super")
    TNT1 A 0 A_Jump(64,"Seeker")
  Normal:
    IEGN EF 8 A_FaceTarget
	IEGM F 1 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, 0)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, -5)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, 5)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, -10)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, 10)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, -15)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, 15)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, -20)
	TNT1 A 0 A_CustomMissile("ILegendaryBall", 28, 0, 20)
	TNT1 A 0 A_Jump(88,"Seeker")
	Goto See
  Seeker:
	IEGN EF 10 A_FaceTarget
  SeekerLoop:
    TNT1 A 0 A_JumpIf(user_missile >= 6,"Detox")
	TNT1 A 0 A_PlaySound("imp/attack")
	IEGM F 6 A_CustomMissile("ILegImpSeekBall",32,20,0)
    IEGM F 2 A_FaceTarget
	TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  Super:
	TNT1 A 0 A_JumpIfCloser(200,"Normal")
	TNT1 A 0 A_PlaySound ("legimp/chargingsound")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
  SuperLoop1:
    TNT1 A 0 A_JumpIf(user_missile >= 5,"SuperLoop2")
	IEGN E 0 A_FaceTarget
	IEGN EEEEE 2 A_SpawnItem("ILegImpLineSpawner")
    TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  SuperLoop2:
	TNT1 A 0 A_JumpIf(user_missile >= 10,"SuperFire")
	IEGN E 0 A_FaceTarget
	IEGN FFFFF 2 A_SpawnItem("ILegImpLineSpawner")
    TNT1 A 0 A_SetUserVar(user_missile,user_missile+1)
	Loop
  SuperFire:
    TNT1 A 0 A_SetUserVar(user_missile,0)
	IEGM F 0 A_CustomMissile ("LegendaryImpRedBall",28,0,-5)
	IEGM F 0 A_CustomMissile ("LegendaryImpRedBall",28,0,5)
	TNT1 A 0 A_playSound ("legimp/fiyabetch")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Rush:
	TNT1 A 0 A_SpawnItemEx("ILegendaryImpGhost")	
	IEGN A 1 A_Chase
	TNT1 A 0 A_Jump(24,"See")
	Loop
  Teleport:
    TNT1 A 0 A_SetUserVar("user_effect_type",20)
	IEGN A 1 A_UnSetShootable
	IEGN AAAAAAAAAA 1  A_FadeOut(0.1,0)
	IEGN A 2 
	IEGN AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
    IEGN A 1 A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	IEGN AAAAAAAAAA 1 A_FadeIn(0.1)
    IEGN A 1 A_SetShootable
    Goto See		
  Pain:
    TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_Jump(50,"Teleport")
    IEGN H 2 
	IEGN H 2 A_Pain
  Detox:
    TNT1 A 0 A_SetUserVar(user_missile,0)
	Goto See
  Death:
    TNT1 A 0 A_StopSound(6)
	IEGN I 8 A_ChangeFlag("BRIGHT",0)
    IEGN J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("EnragedDust",random(2,4),256)
    IEGN K 6
    IEGN L 6 A_NoBlocking
    IEGN M 1
    IEGN N -1
	Stop
  }
}

Actor ILegendaryImpGhost : LegendaryImpGhost
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 1
    IEGN A 2 A_FadeOut(0.10)
    Goto Spawn+1
  }
}

Actor LegendaryImpRedBall : LegendaryImpBlueBall
{
  Damage (Random(200,400))
  Speed 20
  Decal "BFG9500LightningRed"
  States
  {
  Spawn:
    IIBB ABAC 3 Bright A_SpawnItemEx("ILegBallAttack",0,-5,0,0,0,0,0,SXF_SETMASTER)
	TNT1 A 0 A_CustomMissile("RedBallTrailA", 0, 0, 90, 0, 0)
	TNT1 A 0 A_CustomMissile("RedBallTrailB", 0, 0, 90, 0, 0)
	TNT1 A 0 A_CustomMissile("RedBallTrailC", 0, 0, 90, 0, 0)
    TNT1 A 0 A_Playsound ("legball/fly")
	Loop
  Death:
	TNT1 A 0 A_Explode(158,138)
    IIBE ABCDEFG 4
	TNT1 A 0 Radius_Quake(20,12,0,12,0)
	Stop
  }
}

Actor RedBallTrailA : BlueBallTrailA
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	ILBB AAAAAAAAAAAAAA 1 Bright A_FadeOut(0.015)
	Wait
  }
}

Actor RedBallTrailB : BlueBallTrailA
{ 
  States
  {
  Spawn:
	ILBB BBBBBBBBBBBB 1 Bright A_FadeOut(0.02)
	Wait
  }
}

Actor RedBallTrailC : BlueBallTrailA
{ 
  States
  {
  Spawn:
	ILBB CCCCCCCCCCCC 1 Bright A_FadeOut(0.02)
	Wait
  }
}

Actor ILegBallAttack : LegBallAttack
{
  Obituary "$CFILegBallAttackObit"
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 AAAAA 1 A_Look
	Stop
  See:
    TNT1 A 0
	TNT1 A 1 A_JumpIfCloser(1250,"Attack")
	Stop
  Attack:
    TNT1 A 0
	TNT1 A 0 A_FaceTarget
	TNT1 A 1 A_CustomRailgun(10,0,NONE,"Red",1,1,2)
	Goto Death	
  Death:
	TNT1 A 1
	Stop
  }
}

Actor ILegendaryBallTrail : LegendaryBallTrail
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    IKBT GHIJKL 1 A_FadeOut(0.1)
	Stop
  }
}

Actor ILegendaryBall : LegendaryBall
{
  Speed 23
  Damage (Random(50,90)) //23
  FastSpeed 30
  States
  {
  Spawn:
    IIM1 AB 1 Bright A_SpawnItemEx("ILegendaryBallTrail",0,0,2,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
    TNT1 AAA 0 A_CustomMissile("EnragedHellionSmokeSpawner", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))		
    IIM1 CDE 3 Bright
    Stop
  }   
}


Actor ILegImpSeekBall : LegImpSeekBall
{
  Speed 39
  FastSpeed 42
  Damage (Random(12,18))
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(12,0)
	TNT1 A 0 A_BishopMissileWeave
    IIM1 A 1 Bright A_SpawnItemEx("ILegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_BishopMissileWeave
    IIM1 B 1 Bright A_SpawnItemEx("ILegImpSeekBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("EnragedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("EnragedHellionSmokeSpawner", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    IIM1 CDE 3 Bright
    Stop
  }
}

Actor ILegImpSeekBallTrail : LegImpSeekBallTrail
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
    IIM1 GHIJKL 1 A_FadeOut(0.1)
	Stop
  }
}

Actor ILegImpLineSpawner : LegImpLineSpawner
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 AAA 0 A_CustomMissile("EnragedSparkleSpawner",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAAAAA 0 A_SpawnItemEx("LegendaryRedPowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 	
	TNT1 A 1 A_SpawnItemEx("LegendaryRedPowerLine",frandom(-32,32),frandom(-32,32),frandom(8,48),0,0,frandom(1,4),0,SXF_CLIENTSIDE,0) 
    Stop  
  }
}

Actor EnragedLegBallAttack : LegBallAttack
{
  Speed 25
  FastSpeed 30
  //Tag "\c[m6]Enraged\c- \c[z3]Legendary Imp\c-"
  Obituary "$CFEnragedLegBallAttackObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CopyFriendliness(AAPTR_TARGET)
	TNT1 A 0 A_RearrangePointers(AAPTR_NULL, AAPTR_TARGET, AAPTR_NULL)
	TNT1 AAAAA 1 A_LookEx(LOF_NOSOUNDCHECK|LOF_NOSEESOUND,0,1250,0,360,"Attack")
	Goto Death
  Attack:
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_RearrangePointers(AAPTR_MASTER, AAPTR_MASTER, AAPTR_NULL)
	TNT1 A 1 A_CustomRailgun(5,0,None,"Red",RGF_SILENT|RGF_FULLBRIGHT,0,12,"LegendaryImpPuff",0,0,0,0,10,0,"EnragedImpRailParticle")
	Goto Death
  Death:
	TNT1 A 1
	Stop
  }
}

Actor EnragedImpRailParticle : BFG9500Trail
{
  Scale 0.05
  Alpha 0.95
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	LSKR A 2 Bright
	Stop
  }
}