Actor VexedNemesisImpGhostA : NemesisImpGhost
{
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 1
	Goto Fade
  Fade:
	VSI2 A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1 Bright
	Stop	
  }
}

