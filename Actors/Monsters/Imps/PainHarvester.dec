Actor PainHarvester : Devil
{
  Monster
  Health 180
  Speed 4
  Radius 16
  PainChance "Mine", 128
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  PainChance 30
  BloodColor Black
  ReactionTime 25
  +AVOIDMELEE
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  DamageType "AdvancedImp"
  DamageFactor "AdvancedImp", 0.0
  DamageFactor "HellionFire", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "Catharsi15k", 0.0
  DamageFactor "Catharsi10K", 0.0
  DropItem "LifeEssence", 200, 4
  DropItem "CFArmorBonusMax5", 200
  SeeSound "harvester/sight"
  ActiveSound "imp/active"
  MeleeSound "imp/melee"
  PainSound "imp/pain"
  DeathSound "harvester/death"
  Obituary "$CFPainHarvesterObit"
  Tag "$CFPainHar"
  States
  {
  Spawn:
	PNHV A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PNHV A 10 A_Look
	Loop
  See:
	PNHV AAAAAABBBBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	PNHV CCCCCCDDDDDD 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  Melee:
  Missile:
	//TNT1 A 0 A_ChangeFlag(NoTarget,1)
	//TNT1 A 0 A_CustomMissile("BribeCaco",1,0,0,2,-90)
	PNHV EFGH 4 Bright A_FaceTarget(45)
	//TNT1 A 0 A_ChangeFlag(NoTarget,0)
	TNT1 A 0 A_CustomMissile("PainisHarvesterBall",32,0,0,CMF_TRACKOWNER)	
	PNHV IJK 5 Bright A_FaceTarget
	PNHV L 5 Bright
	PNHV M 4
	Goto See
  Pain:
	PNHV N 6 A_Pain
    Goto See
  Death:
	PNHV O 6 A_Scream
	PNHV PQR 6 
	PNHV S 5 //A_SpawnItemEx("SoulHarvesterGhost",0,0,32,0,0,0,0,SXF_CLIENTSIDE)
	PNHV T 4 A_Fall
	TNT1 A 0 A_SpawnItem("BodyCrash",0,0,0,0)
	PNHV UV 3
	PNHV W -1
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	PNHV X 3 A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	PNHV Y 3 //A_SpawnItemEx("SoulHarvesterGhost",0,0,32,0,0,0,0,SXF_CLIENTSIDE)
	PNHV Z 3
	PNHV "[" 3 A_Fall
	PNHV "]" 3
	PNHW A -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	PNHV WVUTSRQPO 5
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	PNHV "]" 3
	PNHV "[" 3
	PNHV ZYX 3
	Goto See
  }
}

Actor SummonedPainHarvester : PainHarvester { -COUNTKILL }

