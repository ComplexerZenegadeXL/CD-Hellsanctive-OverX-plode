	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	TNT1 A 0 A_ScaleVelocity(0.9)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_SeekerMissile(20,30)
	TNT1 A 0 A_ScaleVelocity(0.8)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.7)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.6)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.5)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.4)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM DDD 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.3)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM EEE 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.2)
	TNT1 A 0 A_SeekerMissile(20,30)
	PHMM FFF 1 Bright A_SpawnItemEx("PainBallTrail",0,0,1,0,0,0,180,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_ScaleVelocity(0.1)
	Goto Death
  Death:
	TNT1 AAAAAAA 0 A_CustomMissile("PHSpreadShot",0,0,frandom(-4,4),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(-4.0,4.0))
	Goto XDeath
  XDeath:
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	TNT1 A 0 A_SetTranslucent(1.0,1)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,1,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom8",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))		
	SRBA EFGHIJJJJJJ 2 Bright A_FadeOut(0.1,1)
	Stop
  }
}

Actor PainBallTrail : ImpBallTrail
{
  +NONETID
  +NOINTERACTION
  +NOBLOCKMAP
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	SCRT ABCDE 1 Bright A_FadeOut(0.1,0)
	SCRT E 1 Bright A_FadeOut(0.1,1)
	Wait
  }
}

Actor PHSpreadShot : DoomImpBall
{
  Projectile
  Height 6
  Radius 8
  Speed 15
  FastSpeed 20
  Scale 0.8
  BounceType Hexen
  BounceCount 5
  BounceFactor 1.2
  WallBounceFactor 1.2
  Renderstyle Add
  Decal "DoomImpScorch"
  Damage (Random(5,12))
  +HEXENBOUNCE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  Species "Imps"
  DamageType "ImpComet"
  Obituary "$CFPHSpreadShotObit"
  States
  {
  Spawn:
	PBAL AA 1 Bright A_SpawnItemEx("ShadePuff2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Seekermissile(5,7)
	TNT1 A 0 A_Weave(1,3,2,1)
	PBAL AA 1 Bright A_SpawnItemEx("ShadePuff2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Seekermissile(5,7)
	TNT1 A 0 A_Weave(1,3,2,1)
	PBAL BB 1 Bright A_SpawnItemEx("ShadePuff2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Seekermissile(5,7)
	TNT1 A 0 A_Weave(1,3,2,1)
	PBAL BB 1 Bright A_SpawnItemEx("ShadePuff2",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	TNT1 A 0 A_Seekermissile(5,7) 
	TNT1 A 0 A_Weave(1,3,2,1)
	Loop
  Death:
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	PBAL HIJKLM 3 Bright A_FadeOut(0.1,1)
	Stop
  XDeath:
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	TNT1 A 0 A_SpawnItemEx("PurpleParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AAA 0 A_CustomMissile("Kaboom8",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	PBAL HIJKLM 3 Bright A_FadeOut(0.1,1)
	Stop
  }
}