	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	WARI O 1 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	WARI O 1 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	WARI O 1 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	WARI O 1 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	WARI O 1 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("BlueFire",-7,19,53,0,0,6,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	Goto SuperMelee2
