  Pain:
	TNT1 A 0 A_TakeInventory("ImpSuperMelee",1)
	WARI H 3 A_Pain
	WARI H 4
	Goto See
  XDeath:
  Death:
	WARI R 3 A_Scream
	WARI S 3 A_NoBlocking
	WARI TU 4
	TNT1 A 0 A_SpawnItem("BodyCrash")
	WARI V -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
