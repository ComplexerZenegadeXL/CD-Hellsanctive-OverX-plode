	WARI P 1 Bright A_JumpIfCloser(72,"SuperMelee")
	TNT1 A 0 A_Stop
	TNT1 A 0 A_ChangeFlag("THRUSPECIES",1)
	WARI F 1 A_SkullAttack(18)
