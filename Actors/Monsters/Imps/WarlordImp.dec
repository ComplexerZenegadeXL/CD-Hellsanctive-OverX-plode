  FireBalls:
	TNT1 A 0 A_TakeInventory("ImpSuperMelee",3)
	WARI IJ 6 Bright A_FaceTarget
	TNT1 A 0 HealThing(5)
	TNT1 AA 0 A_SpawnItemEx("BlueShieldFX",frandom(-22,22),frandom(-22,22),frandom(6,58),0,0,0,frandom(0,360))
