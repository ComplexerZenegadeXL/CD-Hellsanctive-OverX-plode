Actor SummonedWarlordImp : WarlordImp { -COUNTKILL }

Actor WarlordMeleeAttack : PaladinMeleeAttack
{
  Speed 73
  Damage(Random(15,25))
  +PIERCEARMOR
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:
	TNT1 A 1
	Goto Death
  }
}

Actor ImpSuperMelee : CustomInventory { Inventory.MaxAmount 3 }