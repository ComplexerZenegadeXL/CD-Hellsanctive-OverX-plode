Actor Poltergeist : Imp 16661
{
  //$Category Monsters/LCA
  //$Sprite FZAGA1C1
  //$Title "Poltergeist"
  Obituary "$CFPoltergeistObit"
  HitObituary "$CFPoltergeistHitObit"
  Health 120
  Speed 10
  PainChance 60
  MeleeDamage 6
  BloodColor "Blue"
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  DropItem "LifeEssence" 256
  DropItem "ArmorBonusMax" 256
  DropItem "BossLifeEssence" 128
  DropItem "BossArmorBonusMax" 128
  DropItem "NewCellPickup" 164 20
  DropItem "NewCellPackPickup" 120 100
  DropItem "FreezerRifleGiver" 54 1
  SeeSound "agaures/sight"
  PainSound "agaures/pain"
  DeathSound "agaures/death"
  ActiveSound "agaures/active"
  MeleeSound "agaures/scratch"
  RenderStyle Translucent
  Alpha 0.5
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +FASTMELEE
  +NOICEDEATH
  Tag "$CFPoltergeist"
  var int user_loop;
  var int user_lowlag;
  States
  {
  Spawn:
    FZAG A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    FZAG A 10 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZ1G A 10 Bright A_Look
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	FZAG AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
    TNT1 A 0 A_Jump(50,"Evade")
    TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    FZAG AA 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZAG BB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZAG CC 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZAG DD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Loop
  Evade:
    TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	TNT1 A 0 A_SpawnItemEx("FRZRAGFlameSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Melee:
    FZAG W 8 Bright A_FaceTarget
    FZAG X 1 Bright A_PlaySound("agaures/swing")
    FZAG X 7 Bright A_FaceTarget
    FZAG Y 6 Bright A_MeleeAttack
    Goto See
  Lunge:
	TNT1 A 0 A_JumpIfCloser(300,1)
	Goto See
	TNT1 A 0 A_PlaySound("agaures/swing")
	FZAG WW 7 Bright A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	FZAG W 2 Bright A_Recoil(-30)
	FZAG W 3 Bright A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	FZAG X 6 Bright
	FZAG Y 2 Bright A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	FZAG Y 1 Bright A_ScaleVelocity(0)
	Goto See
  Normal:
    FZAG EF 8 Bright A_FaceTarget
    FZAG G 6 Bright A_CustomMissile("FreezerAgauresBall", 37, 0, 0, 0, 0)
  Missile:
	FZAG A 0 A_Jump(128, "Missile2", "Missile4", "Lunge")
	FZAG A 0 A_JumpIfCloser(250, "Missile3")
    Goto See
  Missile2:
    FZAG EF 8 Bright A_FaceTarget
	FZAG G 0 A_CustomMissile("SpeedyAgauresBall", 37, 0, -10, 0, 0)
    FZAG G 6 Bright A_CustomMissile("SpeedyAgauresBall", 37, 0, 10, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	FZAG EF 8 Bright A_FaceTarget
    FZAG G 6 Bright A_CustomMissile("FreezerAgauresBall", 37, 0, 0, 0, 0)
	FZAG EF 8 Bright A_FaceTarget
	FZAG G 0 A_CustomMissile("SpeedyAgauresBall", 37, 0, -10, 0, 0)
    FZAG G 6 Bright A_CustomMissile("SpeedyAgauresBall",37,0,10,0,0)
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	FZAG EF 8 Bright A_FaceTarget
	FZAG G 0 A_CustomMissile("FreezerAgauresBall", 37, 0, -10, 0, 0)
	FZAG G 0 A_CustomMissile("SpeedyAgauresBall", 37, 0, 0, 0, 0)
    FZAG G 6 Bright A_CustomMissile("FreezerAgauresBall", 37, 0, 10, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Missile3:
    FZAG WW 6 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("devil/scream")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  Missile3Loop:
    FZAG X 1 Bright A_CustomMissile("PoltFlameShot", 45, 0, 0, 0, 0)
	FZAG X 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 24,1)
	Goto Missile3Loop
	FZAG X 1 Bright A_CustomMissile("PoltFlameShot", 45, 0, 0, 0, 0)
    Goto See
  Missile4:
    FZAG EF 8 Bright A_FaceTarget
    FZAG G 6 Bright A_CustomMissile("FRZRPoltBomb", 37, 0, 0, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	FZAG EF 8 Bright A_FaceTarget
	FZAG G 0 A_CustomMissile("FRZRPoltBomb", 37, 0, -10, 0, 0)
	FZAG G 0 A_CustomMissile("FRZRPoltBomb", 37, 0, 0, 0, 0)
    FZAG G 6 Bright A_CustomMissile("FRZRPoltBomb", 37, 0, 10, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	FZAG AAAA 3 Bright A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Pain:
    FZAG H 2 Bright
    FZAG H 2 Bright A_Pain
    Goto See
  Death.PlayerIce:
  Death:
    FZAG I 8
    FZAG J 8 A_Scream
    FZAG KL 6 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FZAG M 6 A_NoBlocking
    FZAG N -1
    Stop
  XDeath:
    FZAG O 5 A_XScream
    FZAG P 5 A_GiveInventory("XDeathCheck",1)
    FZAG Q 5 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    FZAG R 5 A_NoBlocking
    FZAG STU 5
    FZAG V -1
    Stop
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    FZAG ML 8
    FZAG KJI 6
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	FZAG VUTRSQPO 6
	Goto See
  }
}

Actor SummonedPoltergeist : Poltergeist { -COUNTKILL }

