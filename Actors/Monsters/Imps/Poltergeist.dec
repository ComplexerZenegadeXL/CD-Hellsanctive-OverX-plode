Actor Kaboom9Blue : Kaboom9
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	BXPO AABBCDEFGHIJKLM 1 Bright A_FadeOut(0.05)
	Stop
  }
}

Actor FreezerAgauresBall
{
  Radius 8
  Height 16
  Speed 10
  Damage (Random(15,25)) //5
  Species "Imps"
  DamageType "Ice"
  RenderStyle Add
  Alpha 0.67
  Projectile
  +THRUGHOST
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  States
  {
  Spawn:
    TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
    FLVB AAABBB 1 Bright A_SpawnItemEx("AgauresBallTrail", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE, 0)
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
    Loop
  Death:
    TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9Blue", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    FLVB CDE 3 Bright
    Stop
  }
}

Actor SpeedyAgauresBall : FreezerAgauresBall { Speed 15 }

Actor AgauresBallTrail
{   
  Radius 0
  Height 1
  Projectile
  RenderStyle Add
  Alpha 0.75
  States
  {
  Spawn:
    TNT1 A 1
	TNT1 A Random(5,7)
    FLTR ABCDEFG 2 Bright
    Stop 
  }
}

Actor FRZRAGFlameSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    TNT1 AAAA 0 A_SpawnItemEx("FRZRFlame2",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor FRZRFlame2 : FRZRFlame { Scale 0.2 }

Actor FRZRPoltBomb : FRZRBehBomb
{
  Species "Imps"
  DamageType "Ice"
  States
  {
  Spawn:
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 A 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 B 1 Bright
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	TNT1 A 0 A_CustomMissile("FRZRBehBombTrail",frandom(-2,2),frandom(-2,2))	
	TNT1 A 0 A_CustomMissile("ProjectileTrailParticleBlue",frandom(-2,2),frandom(-2,2))
	FX05 C 1 Bright	
	Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAA 0 A_CustomMissile("Bluekaboom4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	TNT1 A 0 A_Explode(32,102,0)
	TNT1 A 0 A_PlaySound("icespike",7)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  DeathLoop:
	SHEX G 0 A_CustomMissile("FRZRPoltBombProj",0,0,user_loop * 15,CMF_AIMDIRECTION)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 21,2)
	TNT1 A 0 A_Jump(256,"DeathLoop")
	SHEX DCEFG 3 Bright
	Stop
  }
}

Actor FRZRPoltBombProj : FRZRBehBombProj
{
  Species "Imps"
  DamageType "Ice"
  States
  {
  Spawn:
	ISHR AB 2 Bright
	Loop
  Death:
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	Stop
  }
}
