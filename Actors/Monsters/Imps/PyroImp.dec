Actor PyroImp : Imp 14564
{
  Health 100
  Radius 20
  Height 56
  Speed 9
  PainChance 80
  Mass 100
  Monster 
  +FLOORCLIP
  +DONTHURTSPECIES
  +MISSILEMORE
  PainChance "SoulToxic", 60
  PainChance "FatFlamer", 0
  PainChance "FiendFire", 0
  DamageFactor "ImpComet", 0.0
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "DemonAmmoPickup" 70 60
  DropItem "GasPickup" 70 60
  SeeSound "imp/sight"
  PainSound "imp/pain"
  DeathSound "imp/death"
  ActiveSound "imp/active"
  MeleeSound "imp/melee"
  Obituary "$CFPyroImpObit"
  HitObituary "$CFPyroImpHitObit"
  MeleeDamage 3
  Tag "$CFPyroImp"
  var int user_lowlag;
  States
  {
  Spawn:
    PRIM A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	PRIM A 10 A_Look
	PRII A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	PRIM AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
  	TNT1 A 0 A_Jump(46,"Evade")
    PRIM AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	PRIM CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	PRIM AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	PRIM AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Melee:
	PRIM EF 5 A_FaceTarget
    PRIM G 5 A_MeleeAttack
	PRIM FE 5 A_FaceTarget
  Missile:
	PRIM EF 6 A_FaceTarget
	PRIM G 0 A_CustomMissile ("PyroImpBallNoGravity",32,0,5,0,0)
	PRIM G 0 A_CustomMissile ("PyroImpBallNoGravity",32,0,-5,0,0)
    PRIM G 5 A_CustomMissile ("PyroImpBallNoGravity",32,0,0,0,0)
	Goto See
  Pain:
    PRIM H 4 A_Pain
    Goto See
  XDeath:
  Death:
    PRIM N 5 A_SpawnItemEx("PyroImpExplosion", 0, 0, 30)
    PRIM O 5 A_XScream
    PRIM P 5
    PRIM Q 5 A_Fall
    PRIM RST 5
    PRIM U -1
    Stop
  XRaise:
  Raise:
    TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	PRIM UTSRQPON 4
    Goto See
  }
}

Actor SummonedPyroImp : PyroImp { -COUNTKILL }

Actor PyroImpBall : DoomImpBall
{
  RenderStyle Add
  Species "Imps"
  DamageType "Fire"
  +RANDOMIZE
  +LOWGRAVITY
  -NOGRAVITY
  States
  {
  Spawn:
    BAL1 A 1 Bright A_SpawnItemEx("ImpBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    BAL1 A 0 A_SpawnItemEx ("PyroImpBallFire", frandom(-1,1), frandom(-1,1), frandom(-1,1), 0, 0, 0 , frandom(0,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION, 0)
    BAL1 B 1 Bright A_SpawnItemEx("ImpBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    BAL1 B 0 A_SpawnItemEx ("PyroImpBallFire", frandom(-1,1), frandom(-1,1), frandom(-1,1), 0, 0, 0 , frandom(0,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION, 0)
    Loop
  Death:
	BAL1 C 0 A_CustomMissile ("PyroImpBallFire2", 0, 0, 0, 0)
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BAL1 C 3 Bright A_Explode (5, 56, 1)
    BAL1 CCCCCCCCC 0 A_SpawnItemEx ("PyroImpBallFire", frandom(-1,1), frandom(-1,1), frandom(-1,1), 6, 0, frandom(-1,1) , frandom(0,360),SXF_CLIENTSIDE|SXF_NOCHECKPOSITION, 0)
    BAL1 DE 4 Bright
    Stop
  }
}

Actor PyroImpBallNoGravity : PyroImpBall
{
  +NOGRAVITY
  Speed 15
  FastSpeed 19
  Species "Imps"
  DamageType "Fire"
  States
  {
  Death:
    TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    BAL1 C 3 Bright A_Explode (5, 56, 1)
    BAL1 CCCCCCCCC 0 A_SpawnItemEx ("PyroImpBallFire", frandom(1,-1), frandom(1,-1), frandom(1,-1), 6, 0, frandom(1,-1) , frandom(0,360), 0, 0)
    BAL1 DE 3 Bright
    Stop
  }
}

Actor PyroImpFire
{
  Radius 6
  Height 8
  Damage 0
  Scale 0.7
  Renderstyle Add
  +NOBLOCKMAP
  +NOGRAVITY
  +MISSILE
  +NOTELEPORT
  +DONTSPLASH
  +RANDOMIZE
  States
  {
  Spawn:
    CFCF ABCDEFGHIJKLMNOP 2 Bright 
    Stop
  }
}

Actor PyroImpBallFire : PyroImpFire
{
  Scale 0.4
  States
  {
  Spawn:
    TNT1 A 2
    CFCF ABCDEFGHIJKLMNOP 1 Bright 
    Stop
  }
}

Actor PyroImpBallFire2
{
  Species "Imps"
  DamageType "Fire"
  Scale 2.0
  Radius 8
  Height 40
  Renderstyle Add
  Alpha 0.90
  Projectile
  -NOGRAVITY
  +LOWGRAVITY
  +NOEXPLODEFLOOR
  +NODAMAGETHRUST
  +THRUGHOST
  States
  {
  Spawn:
    CFCF PON 2 Bright 
	CFCF A 1 Bright A_PlaySound("weapons/onfire")
	CFCF A 1 Bright A_Explode (4, 56,0)
	CFCF BCDEFGHIJKLM 2 Bright A_Explode (4, 56,0)
	CFCF A 1 Bright A_PlaySound ("weapons/onfire")
	CFCF A 1 Bright A_Explode (4, 56,0)
	CFCF BCDEFGHIJKLM 2 Bright A_Explode(4, 56,0)
	CFCF A 1 Bright A_PlaySound ("weapons/onfire")
	CFCF A 1 Bright A_Explode (4, 56,0)
	CFCF BCDEFGHIJKLM 2 Bright A_Explode (4, 56,0)
	CFCF NOP 2 Bright 
    Stop
  }
}

Actor PyroImpExplosion
{
  Radius 6
  Height 8
  Damage 0
  Scale 0.8
  RenderStyle Add
  Species "Imps"
  DamageType "Fire"
  Alpha 0.7
  +NOBLOCKMAP
  +NOGRAVITY
  States
  {
  Spawn:
    MISL B 0 A_PlaySound ("weapons/rocklx")
  	MISL B 4 Bright A_Explode (15, 72, 1)
	MISL CDE 6 Bright
	Stop
  }
}