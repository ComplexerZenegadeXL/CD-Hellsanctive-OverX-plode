Actor LegendaryPhaseImp : LegendaryImp 17501
{
  //$Category Monsters/CF
  //$Sprite LPHAA1C1
  //$Title "Legendary Phase Imp"
  Health 999
  Speed 15
  Scale 1.1
  DamageFactor 0.75
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "DBFG10K2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "DBFG2", 0.65
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerLegendary", 0.2
  DamageFactor "LegendaryGuru", 0.1
  DamageFactor "LegendaryGuruPlayer", 0.1
  DamageFactor "HellComet", 0.4
  DropItem "LegendarySphere" 80 1
  DropItem "LegendaryPowerSphere" 85
  DropItem "LDemonAmmoBoxPickup" 250
  DropItem "LDemonAmmoPickup" 250
  DropItem "BossLifeEssence" 256
  DropItem "BossArmorBonusMax" 256
  //DropItem "LegendaryPlasmaticRifleGiver" 45
  -FLOAT
  -NOGRAVITY
  Tag "$CFLegPhImp"
  Species "Imps"
  SeeSound "LPhaseImp/sight"
  PainSound "LPhaseImp/pain"
  DeathSound "LPhaseImp/death"
  ActiveSound "LPhaseImp/active"
  Obituary "$CFLegendaryPhaseImpObit"
  HitObituary "$CFLegendaryPhaseImpHitObit"
  BloodColor "Blue"
  MeleeSound "imp/melee"
  var int user_loop;
  States
  {
  Spawn:
	LPHA A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",1)
	TNT1 A 0 ACS_NamedExecuteWithResult("Miss Chance",0,10)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,1)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	LPHA A 10 A_Look
	Loop
  Remove:
	TNT1 A 1
	TNT1 A 0 A_SpawnItemEx("DoomImp",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_ChangeFlag("COUNTKILL", FALSE)
	TNT1 A 0
	Stop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	LPHA AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,301)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(46,"Evade","Rush")
	LPHA AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
	LPHA CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,0,0)
	TNT1 A 0 A_Jump(46,"Phase")	
    Loop
  Rush:
	TNT1 A 0 A_SetUserVar("user_loop",0)
  RushLoop:
	LPHA A 1 A_Chase
	LPHA A 0 A_Chase
	LPHA A 1 A_Chase
	LPHA A 0 A_Chase
	LPHA B 1 A_Chase
	LPHA A 0 A_Chase
	LPHA B 1 A_Chase
	LPHA A 0 A_Chase
	LPHA C 1 A_Chase
	LPHA A 0 A_Chase
	LPHA C 1 A_Chase
	LPHA A 0 A_Chase
	LPHA D 1 A_Chase
	LPHA A 0 A_Chase
	LPHA D 1 A_Chase
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 2,1)
	Loop
	TNT1 A 0 A_Jump(48,"See")
	Goto Rush
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	LPHA AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	LPHA AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Phased:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	LPHA AABBCCDDAABBCCDD 1 A_ExtChase(0,0)
	LPHA AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase","PhasedRun")
	Goto Phased+33
  Melee:
	LPHA EF 5 A_FaceTarget
	LPHA G 5 A_MeleeAttack
	LPHA FE 5 A_FaceTarget	
    Goto See
  Missile:
	TNT1 A 0 A_Jump(128,"FastMissile")
	TNT1 A 0 A_Jump(64,"Surprise","Laser")
	TNT1 A 0 Bright A_PlaySound("LPhaseImp/attack",7)
	LPHA EF 6 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 4
	LPHA F 4 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(64,192),16,0,0)
	LPHA FEF 4
	TNT1 A 0 A_Stop
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 4
	LPHA F 4 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(64,192),16,0,0)
	LPHA FEF 4
	TNT1 A 0 A_Stop
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 4
	LPHA F 4 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FEF 3
	TNT1 A 0 A_Stop
	Goto See
  FastMissile:
	TNT1 A 0 Bright A_PlaySound("LPhaseImp/attack",7)
	LPHA EF 4 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 2
	LPHA F 2 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),32,0,0)
	LPHA FEF 2
	TNT1 A 0 A_Stop
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 2
	LPHA F 2 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),32,0,0)
	LPHA FEF 2
	TNT1 A 0 A_Stop
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 2
	LPHA F 2 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	LPHA G 3 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FEF 3
	TNT1 A 0 A_Stop
	Goto See
  Laser:
	TNT1 A 0 Bright A_PlaySound("LPhaseImp/attack",7)
	LPHA EF 6 A_FaceTarget
	TNT1 A 0 Bright A_PlaySound("imp/attack")
	TNT1 A 0 A_SetUserVar("user_loop",0)
  LaserLoop:
	LPHA G 4 Bright A_CustomMissile("LegPhaseLaser", 32, 0, 0)
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 9,1)
	TNT1 A 0 ThrustThing(Angle*256/360+frandom(64,192),32,0,0)
	LPHA F 6
	TNT1 A 0 A_MonsterRefire(64,"See")
	TNT1 A 0 A_Jump(100,"See")
	Goto Laser+1
  Surprise:
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	LPHA E 2 A_FaceTarget
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	LPHA E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	LPHA E 1 A_SetTranslucent(0.55)
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	LPHA E 1 A_SetTranslucent(0.35)
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	LPHA E 1 A_SetTranslucent(0.15)
	TNT1 A 0 A_SpawnItem("BHellionSmokeSpawner",0,0,0,0)
	Goto SurprisePhased
  SurprisePhased:
	LPHA A 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA A 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA B 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA B 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA C 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA C 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA D 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA D 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	TNT1 A 0 A_JumpIfCloser(200,"SurpriseUnphase")
	TNT1 A 0 A_Jump(8,"Unphase")
	Loop
  SurpriseUnphase:
	TNT1 A 0 A_SetUserVar("user_effect_type",1)
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_PlaySound("LPhaseImp/Sight",7)
	LPHA EF 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	LPHA FE 4
	LPHA F 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	LPHA G 5 Bright A_CustomMissile("LegImpSeekBall", 32, 0, 0)
	TNT1 A 0 A_Jump(128,"PhaseRun")
	Goto See
  Phase:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	LPHA E 2 A_FaceTarget
	LPHA E 1 A_SetTranslucent(0.75)
	LPHA E 1 A_SetTranslucent(0.55)
	LPHA E 1 A_SetTranslucent(0.35)
	LPHA E 1 A_SetTranslucent(0.15)
	//TNT1 AA 0 A_SpawnItemEx("FakeLegendaryPhaseImp",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERPOINTERS)
	Goto Phased
  UnPhase:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	LPHA E 1 A_SetTranslucent(0.15)
	LPHA E 1 A_SetTranslucent(0.35)
	LPHA E 1 A_SetTranslucent(0.55)
	LPHA E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	LPHA E 2 A_FaceTarget	
    Goto See
  Pain:
	TNT1 A 0 A_Jump(32,"PhaseRun")
	LPHA H 2
	LPHA H 2 A_Pain
	Goto See
  PhaseRun:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,1)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	LPHA E 2 A_FaceTarget
	LPHA E 1 A_SetTranslucent(0.75)
	LPHA E 1 A_SetTranslucent(0.55)
	LPHA E 1 A_SetTranslucent(0.35)
	LPHA E 1 A_SetTranslucent(0.15)
	Goto PhasedRun
  PhasedRun:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_SetUserVar("user_loop",0)
  PhasedRunLoop:
	LPHA A 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA A 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA B 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA B 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA C 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA C 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA D 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	LPHA D 1 A_ExtChase(0,0)
	LPHA A 0 A_ExtChase(0,0)
	TNT1 A 0 A_SetUserVar("user_loop",user_loop+1)
	TNT1 A 0 A_JumpIf(user_loop == 2,1)
	Loop
	TNT1 A 0 A_Jump(64,"UnPhaseRun")
	Goto PhasedRun
  UnPhaseRun:
	TNT1 A 0 A_SetUserVar("user_effect_type",2)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	LPHA E 1 A_SetTranslucent(0.15)
	LPHA E 1 A_SetTranslucent(0.35)
	LPHA E 1 A_SetTranslucent(0.55)
	LPHA E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	LPHA E 2 A_FaceTarget	
    Goto See
  Death:
	LPHA I 8 //A_SetTranslucent(1)
	LPHA J 8 A_Scream
	LPHA K 6
	LPHA L 6 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(2,4),256)
	LPHA M -1
	Stop
  XDeath:
	TNT1 A 0 A_SetTranslucent(1)
	LPHA N 3 
	LPHA O 3 A_XScream
	LPHA P 3 A_SpawnItemEx("BlueGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	LPHA Q 3 A_Fall
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,19)
	TNT1 A 0 A_DropItem("LegendaryDust",random(2,4),256)
	LPHA RST 3
	LPHA U -1
	Stop
  }
}

Actor LegPhaseLaser : LegRedLaser { Damage (Random(8,24)) }

Actor FakeLegendaryPhaseImp : LegendaryPhaseImp
{
  +NOTARGET
  -COUNTKILL
  +THRUSPECIES
  -BOSS
  Health 150
  Renderstyle Translucent
  Alpha 0.15
  SeeSound " "
  DeathSound " "
  Tag "\c[z3]Legendary Phase Imp\c-"
  States
  {
  Spawn:
	LPHA AABBCCDDAABBCCDD 1 A_Wander
	LPHA AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_ExtChase(0,0)
	TNT1 A 0 A_Die
	Goto Death
  Death:
	LPHA H 5
	TNT1 AAA 0 A_CustomMissile("SmokeFX3",frandom(10,60),0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))  
	TNT1 AAA 0 A_CustomMissile("BlueKaboom3",frandom(10,60),frandom(10,-10),frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	LPHA H 1 A_FadeOut(0.1,1)
  Wait
  }
}