Actor CryoImp : Imp
{
  Obituary "$CFCryoImpObit"
  HitObituary "$CFCryoImpHitObit"
  Health 100
  Radius 20
  Height 56
  Mass 100
  Speed 9
  PainChance 80
  MeleeDamage 3
  DamageFactor "PlayerFireSword", 2.0
  PainChance "SoulToxic", 60
  PainChance "FatFlamer", 60
  PainChance "FiendFire", 60
  DropItem "FreezerRifleGiver" 28 1
  DamageFactor "ImpComet", 0.0
  DropItem "LifeEssence" 125
  DropItem "ArmorBonusMax" 125
  DropItem "DemonAmmoPickup" 70 60
  Species "Imps"
  SeeSound "frostimp/See"
  PainSound "frostimp/freeze"
  DeathSound "frostimp/shatter"
  MeleeSound "imps/melee"
  DamageFactor "Ice", 0.0
  DamageFactor "PlayerIce", 0.0
  DamageFactor "FreezerBurn", 0.0
  Tag "$CFIceImp"
  +NOBLOOD
  +MISSILEMORE
  +QUICKTORETALIATE
  +NOICEDEATH
  var int user_lowlag;
  States
  {
  Spawn:
    ICEY A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ICEY AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
  	TNT1 A 0 A_Jump(46,"Evade")
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ICEY CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ICEY AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	ICEY AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Melee:
    TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY EF 5 A_FaceTarget
    TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY G 5 A_MeleeAttack
    TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY FE 5 A_FaceTarget	
    TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Goto See
  Missile:
    TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    ICEY EF 6 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	TNT1 A 0 A_CustomMissile("FrostCoveredBall",32,0,8,0)
	TNT1 A 0 A_CustomMissile("FrostCoveredBall",32,0,-8,0)
    ICEY G 5 A_CustomMissile("FrostCoveredBall",32,0,0,0)
    ICEY FE 4 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("FImpWindSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
    Goto See
  Pain:
    ICEY H 2 
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(4,-4),frandom(4,-4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("ShatteringIce1", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 AA 0 A_SpawnItemEx("ShatteringIce2", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_SpawnItemEx("ShatteringIce3", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_SpawnItemEx("ShatteringIce4", frandom(-8,8), frandom(-8,8), frandom(16,48), frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICEY H 2 A_Pain
    Goto See
  XDeath:
  Death.PlayerIce:
  Death:
    ICEY H 4
	ICEY H 1 A_ScreamAndUnblock
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	ICEY H 0 A_IceGuyDie
    Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor FImpWindSpawner : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAA 0 A_SpawnItemEx("ImpFrozenWind",3,frandom(-2,2),frandom(0,30),1,0,frandom(1,2),frandom(90,270),SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}
Actor ImpFrozenWind
{
  +MISSILE
  +DONTSPLASH
  +NOBLOCKMAP
  +NOGRAVITY
  +NOTELEPORT
  +FORCEXYBILLBOARD
  +THRUACTORS
  Scale 0.4
  RenderStyle Normal
  States
  {
  Spawn:
    TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
    TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
    PLSS JKLMNOPQRSTUVWXYZ 2 Bright A_FadeOut
	Stop
  Vanilla:
    TNT1 A 0
    Stop
  }
}
Actor FrostCoveredBall
{
  Projectile
  Radius 8
  Height 16
  Speed 18
  FastSpeed 22
  Damage (Random(10,20)) //4
  Scale 0.50
  RenderStyle Add
  Species "Imps"
  DamageType "Ice"
  SeeSound "frostimp/missile"
  DeathSound "frostimp/impact"
  Alpha 0.67
  +DONTHARMSPECIES
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    ICE1 A 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 A 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 B 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE)  
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	ICE1 B 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    ICE1 C 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	ICE1 C 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 D 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 D 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    ICE1 E 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 E 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 F 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 F 1 Bright A_SpawnItemEx("FrostBallTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE) 
	TNT1 A 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    Loop
  Death:
	TNT1 A 0 A_RadiusGive("MonsterSlow",32,RGF_PLAYERS,1)
	TNT1 AAAAAAA 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAA 0 A_SpawnItemEx("IceDebris",0,0,0,frandom(-4,4),frandom(-4,4),frandom(4,8),0,SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom6", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
    ICE1 GHI 4 
    Stop
  }
}

Actor FrostBallTrail
{
  Radius 8
  Height 16
  Scale 0.30
  RenderStyle Add
  Alpha 0.67
  Projectile
  +CLIENTSIDEONLY
  +RANDOMIZE
  States
  {
  Spawn:
    ICE1 G 4 Bright 
    Goto Death
  Death:
    TNT1 AAA 0 A_SpawnItemEx("CIIceSparkle", 0, 0, 0, frandom(-2, 2), frandom(-2, 2), frandom(-1, 1),0,SXF_CLIENTSIDE)
    ICE1 G 1 A_FadeOut(0.05)
    Goto Death+3
  }
}

Actor CIIceSparkle
{
  Renderstyle Translucent
  Alpha 0.5
  Radius 0
  Height 0
  +NOGRAVITY
  +NOBLOCKMAP
  +NOLIFTDROP
  +NOTARGET
  +DONTSQUASH
  +NOTELEOTHER
  +NONSHOOTABLE
  +CLIENTSIDEONLY
  +NOINTERACTION
  States
  {
  Spawn:
    ICE2 A 0
    ICE2 ABC 4 A_FadeOut(0.10)
    Goto Spawn+1
  }
}

Actor ShatteringIce1
{
  Scale 0.50
  Health 1
  Radius 8
  Height 1
  Mass 4
  +CORPSE
  +NOTELEPORT
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
    TNT1 A 0
    ICEC A 1 A_SpawnItemEx("ShatterIceSparkle",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    Loop
  Crash:
    ICEC A 1 A_FadeOut(0.01)
    Loop
 }
}

Actor ShatteringIce2 : ShatteringIce1
{
  Mass 3
  States
  {
  Crash:
    ICEC B 1 A_FadeOut(0.01)
    Loop
  }
}

Actor ShatteringIce3 : ShatteringIce1
{
  Mass 2
  States
  {
  Crash:
    ICEC C 1 A_FadeOut(0.01)
    Loop
   }
}

Actor ShatteringIce4 : ShatteringIce1
{
  Mass 1
  States
  {
  Crash:
    ICEC D 1 A_FadeOut(0.01)
    Loop
  }
}

Actor ShatterIceSparkle : CIIceSparkle { Scale 0.1 }