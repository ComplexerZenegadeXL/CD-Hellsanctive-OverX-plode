Actor CFStoneImp : Imp 30342
{
  Monster
  Health 500
  Height 58
  Radius 20
  Mass 600
  Scale 1.15
  Speed 3
  FastSpeed 4
  MeleeRange 70
  BloodColor "0 0 0"
  BloodType "StoneBitsSpawner"
  PainChance 8
  PainChance "Stun", 0
  PainChance "Mine", 0
  PainChance "Explosion", 0
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  +NOFEAR
  +FLOORCLIP
  +DONTRIP
  +NORADIUSDMG
  +NOBLOODDECALS
  +QUICKTORETALIATE
  +DONTHARMSPECIES
  +NOICEDEATH
  DamageType "Stun"
  DamageFactor "Acid", 0.0
  DamageFactor "Fire", 0.1
  DamageFactor "Ice", 0.1
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "PoisonCloud", 0.0
  DamageFactor "Electric", 0.01
  DamageFactor "Disintegrate", 0.25
  DamageFactor "AdvancedImp", 0.2
  DamageFactor "PDTBFG", 0.5
  DamageFactor "PDTBFGTracer", 0.5
  DamageFactor "PlayerDevTracer", 0.25
  DamageFactor 0.95
  //No Infighting
  DamageFactor "Stun", 0.0
  DamageFactor "HellionFire", 0.0
  DropItem "LifeEssence", 200, 4
  DropItem "CFArmorBonusMax5", 200
  DropItem "ShieldSphere", 32, 1
  SeeSound "imp/sight"
  ActiveSound "imp/active"
  PainSound "imp/pain"
  DeathSound "imp/death"
  Obituary "$CFStoneImpObit"
  Tag "$CFStoneImp"
  var int user_lowlag;
  States
  {
  Spawn:
	GIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	GIMP A 10 A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	GIMP AAAAAABBBBBB 1 A_Chase
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	GIMP AAAAAABBBBBB 1 A_Chase("Melee","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	GIMP CCCCCCDDDDDD 1 A_Chase("Melee","")
	TNT1 A 0 A_SpawnItemEx("HoofStep",0,0,5,0,0,-20)
	GIMP A 0 A_Jump(30,"Missile")
	Loop
  Melee:
	GIMP EF 8 A_FaceTarget
	GIMP G 6 A_CustomMeleeAttack(8*random(3,7),"stoneimp/hit","None","Stun")
	Goto See
  Missile:
	TNT1 A 0 A_JumpIfTargetInLos("Missile2",90,JLOSF_DEADNOJUMP|JLOSF_TARGETLOS)
	Goto See
  Missile2:
	GIMP EF 4 A_FaceTarget
	GIMP G 2 A_CustomMissile("LobbedRock",37,10,0,CMF_OFFSETPITCH)
	Goto See
  Pain:
	GIMP H 2
	GIMP H 2 A_Pain
	TNT1 A 0 A_Jump(128,"Missile")
	Goto See
  XDeath:
  Death:
	TNT1 A 0 A_Jump(128,"RePetrification")
	GIMP I 6 A_ScreamAndUnblock
	TNT1 A 0 A_PlaySound("StoneArmor/Destroy",0,1.5,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("StoneBitsSpawner",0,0,35)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX3",36,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	GIMP J 5
	GIMP K 4
	GIMP L 3
	GIMP M 3
	GIMP N -1
	Stop
  RePetrification:
	GIMP I 6 A_ScreamAndUnblock
	TNT1 A 0 A_PlaySound("StoneArmor/Destroy",0,1.5,0)
	TNT1 AAAAAA 0 A_SpawnItemEx("StoneBitsSpawner",0,0,35)
	TNT1 A 0 A_SpawnItemEx("CFDoomImp",0,0,1,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 AAAA 0 A_CustomMissile("SmokeFX3",36,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	GIMP JJJJJJJJJJ 1 A_FadeOut(0.3,1)
	Stop
  XRaise:
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	GIMP ML 8
	GIMP KJI 6
	Goto See
  }
}

Actor CFDoomImp : Imp
{
  Health 200
  Mass 600
  PainChance 200
  PainChance "AdvancedImp", 0
  MeleeDamage 4
  +QUICKTORETALIATE
  +NORADIUSDMG
  +DONTRIP
  +NOBLOODDECALS
  +DONTHURTSPECIES
  +DONTHARMCLASS
  //No Infighting
  Damagefactor "Stun", 0.0
  Damagefactor "HellionFire", 0.0
  DropItem "LifeEssence", 196
  DropItem "LifeEssence", 196
  DropItem "LifeEssence", 196
  DropItem "LifeEssence", 196
  DropItem "CFArmorBonusMax5", 196
  DropItem "CFArmorBonusMax5", 196
  DropItem "CFArmorBonusMax5", 196
  States
  {
  Spawn:
	TROO A 10 A_Look
	Loop
  See:
	TROO AAAABBBB 1 A_Chase
	TROO A 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TROO CCCCDDDD 1 A_Chase
	TROO A 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  Melee:
  Missile:
	TROO EFG 4 A_FaceTarget
	TROO G 1 A_CustomComboAttack("NewDoomImpBall",32,random(10,24),"imps/melee","Melee",1)
	Goto See
  Pain:
	TROO H 2
	TROO H 2 A_Pain
	Goto See
  Death:
	TROO I 6
	TROO J 6 A_Scream
	TROO K 5
	TROO L 5 A_Fall
	TROO M 1 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TROO M -1
	Stop
  XDeath:
	TROO N 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TROO O 3 A_XScream
	TROO P 3
	TROO Q 3 A_Fall
	TROO RST 3
	TROO U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TROO TSRQPON 5
	Goto See
  }
}

Actor LobbedRock
{
  Projectile
  Height 6
  Radius 3
  Scale 0.7
  Speed 20
  VSpeed 3
  BounceType Doom
  BounceCount 10
  Damage (Random(15,30))
  -NOGRAVITY
  +DOOMBOUNCE
  +BOUNCEONACTORS
  Species "Imps"
  DamageType "ImpComet"
  SeeSound "stoneimp/hit"
  States
  {
  Spawn:
	STNB ABCDEFGH 3
	Loop
  Death:
	TNT1 A 0 A_ChangeFlag("MISSILE",0)
	STNB H 200
	STNB H 5 A_FadeOut(0.1,1)
	Wait
  }
}

Actor NewDoomImpBall : DoomImpBall
{
  Speed 19
  FastSpeed 25
  Scale 1.28
  Decal "DoomImpScorch"
  Damage (random(5,20))
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  Species "Imps"
  DamageType "ImpComet"
  States
  {
  Spawn:	
	BAL8 AB 1 Bright A_SpawnItemEx("DoomImpBallTrail",0,0,frandom(-3,3),0,0,0,0,SXF_CLIENTSIDE,0)	
	Loop
  Crash:
  Death:
	BAL8 CDE 3 Bright
	Stop
  XDeath:
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("Kaboom10",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_Explode(12,80,0)
	BAL8 CDE 3 Bright
	Stop
  }
}

Actor DoomImpBallTrail
{
RenderStyle Add
  +CLIENTSIDEONLY
  +NOINTERACTION
  +NOBLOCKMAP
  +FORCEXYBILLBOARD
  States
  {
  Spawn:
	TNT1 A 1
	BAL8 AB 1 Bright A_FadeOut(0.15,1)
	Goto Spawn+1
  }
}

Actor StoneBitsSpawner2 : StoneBitsSpawner
{
  States
  {
  Spawn:
	TNT1 A 0
	Goto High
	TNT1 A 0
	Goto Medium
	TNT1 A 0
  Low:
	TNT1 AA 0 A_SpawnItemEx("StoneBitsSmall",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-5,11),0,SXF_ABSOLUTEPOSITION | SXF_ABSOLUTEANGLE | SXF_ABSOLUTEMOMENTUM)
	Goto SpawnPuff
  Medium:
	TNT1 AAA 0 A_SpawnItemEx("StoneBitsMedium",0,0,0,frandom(-8,8),frandom(-8,8),frandom(-5,11),0,SXF_ABSOLUTEPOSITION | SXF_ABSOLUTEANGLE | SXF_ABSOLUTEMOMENTUM)
	Goto SpawnPuff
  High:
	TNT1 AAAAA 0 A_SpawnItemEx("StoneBitsLarge",0,0,0,frandom(-8, 8),frandom(-8,8),frandom(-5,11),0,SXF_ABSOLUTEPOSITION | SXF_ABSOLUTEANGLE | SXF_ABSOLUTEMOMENTUM)
  SpawnPuff:
	PUFF A 4
	PUFF ABCD 4
	Stop
  }
}