Actor AbyssalImp : Imp
{
  Monster
  Health 800
  Height 56
  Radius 20  //40
  //RenderRadius 40
  Mass 100
  Speed 8
  PainChance 50
  MeleeDamage 15
  BloodColor "Black"
  +NOFEAR
  +FLOAT
  +AVOIDMELEE
  +NOGRAVITY
  +FLOORCLIP
  +MISSILEMORE
  +MISSILEEVENMORE
  +QUICKTORETALIATE
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  +DONTHARMCLASS
  +DONTGIB
  +NORADIUSDMG
  +NOTARGET
  +NOINFIGHTING
  DamageType "AbyssalSatyr"
  DamageFactor "PDTBFG", 0.25
  DamageFactor "PDTBFGTracer", 0.25
  DamageFactor "PlayerDevBall", 0.125
  DamageFactor "PlayerDevBall2", 0.125
  DamageFactor "PlayerDevTracer", 0.125
  DamageFactor "LegendaryPlayer", 0.3
  DamageFactor "LegendaryGuruPlayer", 0.3
  //No Infighting
  DamageFactor "AbyssalSatyr", 0.0
  DamageFactor "SatanGuard", 0.0
  DamageFactor "Imps", 0.0
  DamageFactor "VileFires", 0.0
  DamageFactor "Heterodox", 0.0
  DamageFactor "Damned", 0.0
  DropItem "FearOrb", 8, 1
  DropItem "LifeEssence", 96, 16
  DropItem "ArmorBonusMax", 96, 16
  DropItem "NewShellPickup", 16, 12
  SeeSound "legimp/sight"
  PainSound "legimp/pain"
  DeathSound "legimp/death"
  ActiveSound "legimp/active"
  MeleeSound "imp/melee"
  Obituary "$CFAbyssalImpObit"
  HitObituary "$CFAbyssalImpHitObit"
  Tag "$CFAbImp"
  var int user_lcounter;
  var int user_lowlag;
  States
  {
  Spawn:
	ABBN A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnFireOnActor",0,34)
  Idle:
	ABBN AA 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	ABBN AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0
	ABBN AABBCCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Teleport1")
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(50,"AirDodge")
	Loop
  AirDodge:
	TNT1 A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	TNT1 A 0 ThrustThing(angle*256/360+64,30,0,0)
	ABBN A 5 Bright
	Goto See
  Left:
	TNT1 A 0 ThrustThing(angle*256/360+192,30,0,0)
	ABBN A 5 Bright
	Goto See
  Back:
	TNT1 A 0 ThrustThing(angle*256/360+128,30,0,0)
	ABBN A 5 Bright
	Goto See
  BackLeftRange:
	TNT1 A 0 ThrustThing(angle*256/360+random(133,187),30,0,0)
	ABBN A 5 Bright
	Goto See
  BackRightRange:
	TNT1 A 0 ThrustThing(angle*256/360+random(69,123),30,0,0)
	ABBN A 5 Bright 
	Goto See
  Melee:
	ABBN EF 6 Bright A_FaceTarget
	ABBN F 5 Bright A_MeleeAttack
	Goto See
  WrongTarget:
	TNT1 A 0 A_ClearTarget
	//TNT1 A 0 A_ChangeFlag(FRIENDLY,0)
	//TNT1 A 0 ACS_NamedExecuteAlways("CF_SetSpecies",0,4)
	Goto See		
  Missile:
	TNT1 A 0 A_JumpIfInTargetInventory("IsAnAbyssalSatyr",1,"WrongTarget")
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_UnsetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_Jump(128,"TrailBouncers")
	Goto Normal
  Normal:
	ABBN EEEEEE 5 A_FaceTarget
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 5
	ABBN F 6 A_FaceTarget
	TNT1 A 0 A_CustomMissile("AbyssalImpFireball",47,0,0,CMF_TRACKOWNER)
	ABBM F 35
	TNT1 A 0 A_Jump(64,"TrailBouncers")
	Goto See
  TrailBouncers:
	ABBN EEEEEEF 5 A_FaceTarget
	TNT1 AA 0 A_CustomMissile("GroundShadowRift",0,0,frandom(-15,15),CMF_AIMDIRECTION|CMF_TRACKOWNER)
	ABBM F 40
	Goto See
  Rush:
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("AbyssalImpGhost",0,0,0,0,0,0,0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,0)
	ABBN A 1 Bright A_Chase
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Teleport1:
	ABBN A 1 A_UnSetShootable
	ABBN AAAAAAAAAA 1 A_FadeOut(0.1,0)
	TNT1 A 2 
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	TNT1 A 0 A_Recoil(0.1)
	TNT1 A 2 A_PlayWeaponSound("hellion/smokeloop")
	ABBN AAAAAAAAAA 1 A_FadeIn(0.1)
	ABBN A 1 A_SetShootable
	Goto See		
  Pain.Crush:
	TNT1 A 0 A_Jump(60,"Teleport1")
  Pain:
	TNT1 A 0 A_Jump(50,"Teleport1")
	ABBN H 2 Bright
	ABBN H 7 Bright A_Pain
	Goto See
  Vanish:
	ABBN D 2 A_FadeOut(0.1,1)
	Wait
  XDeath:
  Death:
	ABBN I 6 A_ScreamAndUnblock
	ABBN JKLMN 6
	ABBN N 2 A_FadeOut(0.1,1)
	Wait
  XRaise:
  Raise:
	Stop
  }
}