Actor InsaneAnnihilatorImp : AnnihilatorImp
{
  Health 450
  DamageFactor "Normal", 0.65
  DropItem "LifeEssence" 256
  DropItem "ArmorBonusMax" 256
  DropItem "BossLifeEssence" 128 25
  DropItem "BossArmorBonusMax" 128 1
  DropItem "BulletMagPickup" 256 5
  DropItem "BulletBoxPickup" 128
  DropItem "MissilePickup" 256 5
  DropItem "MissileBoxPickup" 128 10
  DropItem "NewShellPickup" 256 4
  DropItem "NewShellBoxPickup" 128
  DropItem "ExplosiveMinigunGiver" 70 1
  DropItem "ExplosiveShotgunGiver" 60 1
  Obituary "$CFInsaneAnnihilatorImpObit"
  HitObituary "$CFInsaneAnnihilatorImpHitObit"
  Tag "$CFInsAnniImp"
  var int user_lowlag;
  States
  {
  Spawn:
    IAMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	IAMP A 10 A_Look
	IAMI A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	IAMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(87,"Rush")
	TNT1 A 0 A_ChangeFlag(NoDropOff,1)
    IAMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	IAMP CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
    Loop
  Rush:
	IAMP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostA",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP A 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP B 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostB",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP C 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostC",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	IAMP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	IAMP D 2 A_Chase
	TNT1 A 0 A_SpawnItemEx("InsaneAimpghostD",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 A 0 A_Jump(87,"See")		
	Loop
  Melee: 
    IAMP EF 5 A_FaceTarget
    IAMP G 4 A_MeleeAttack
	IAMP FE 5 A_FaceTarget
    Goto See 
  Lunge:
	TNT1 A 0 A_JumpIfCloser(300,1)
	Goto See
	TNT1 A 0 A_PlaySound("weapons/fistwiff")
	IAMP EF 7 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,25,0,1)
	IAMP G 2 A_Recoil(-30)
	IAMP G 3 A_CustomMissile("PinkyLunge",18,0,0,CMF_AIMDIRECTION)
	IAMP G 6 
	IAMP F 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	IAMP E 1 A_ScaleVelocity(0)
	Goto See
  Missile:
    TNT1 A 0 A_Jump(64,"ARifle") //64 "ARifle"
    TNT1 A 0 A_JumpIfCloser(250,"Lunge")
    TNT1 A 0 A_JumpIfCloser(300,"ASG")
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    IAMP EE 7 A_FaceTarget
    IAMP W 10 Bright A_CustomMissile("CBImpBFG15K",32,10,frandom(-2,2)) 
	IAMP F 5
	IAMP G 6 A_FaceTarget
    IAMP V 10 Bright A_CustomMissile("CBImpBFG15K",32,-10,frandom(-2,2)) 
	IAMP G 5
	TNT1 A 0 A_Jump(32,"Homing")
    Goto See
   Homing:
	TNT1 A 0 A_PlaySound("weapons/charge15k")
    IAMP EE 7 A_FaceTarget
    IAMP W 10 Bright A_CustomMissile("InsaneimpHoming15K",32,10,frandom(-2,2))
	IAMP F 15
	IAMP G 6 A_FaceTarget
    IAMP V 10 Bright A_CustomMissile("InsaneimpHoming15K",32,-10,frandom(-2,2))
	IAMP G 5
    Goto See
  ARifle:
    IAMP G 10 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("Orangeshellcasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    IAMP V 2 Bright A_CustomMissile("InsaneimpTracer",32,-10,frandom(-6,6))
    IAMP G 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("Orangeshellcasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    IAMP V 2 Bright A_CustomMissile("InsaneimpTracer",32,-10,frandom(-6,6))
    IAMP G 2 A_FaceTarget
	TNT1 A 0 A_PlaySound("sentient/fire")
    TNT1 A 0 A_SpawnItemEx("Orangeshellcasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(-90, -80), SXF_CLIENTSIDE)
    IAMP V 2 Bright A_CustomMissile("InsaneimpTracer",32,-10,frandom(-6,6))
    IAMP G 10 A_FaceTarget
	TNT1 A 0 A_Jump(64,"Pause2")
    TNT1 A 0 A_CPosRefire
    Goto ARifle+1
  ASG:
    IAMP E 8 A_FaceTarget
	IAMP E 10 A_FaceTarget
	TNT1 A 0 A_SpawnItemEx("Orangeshellcasing", 0, -12, 36, frandom(2, 6), 0, frandom(1, 3), frandom(80, 90), SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("InsaneimpTracer",32,10,frandom(-7,7))
	TNT1 A 0 A_CustomBulletAttack(16.5, 12.3, 4, Random(9,15), "AnniImpPuff",0,CBAF_NORANDOM)
	IAMP W 2 Bright A_PlaySoundEx("weapons/ExplosiveSG/fire","Weapon")
    TNT1 A 0 A_Jump(64,"Pause")
    TNT1 A 0 A_SpidRefire
	Goto ASG+1
  Pause:
	IAMP E 10
	Goto See
  Pause2:
	IAMP G 10
	Goto See
  Pain:
    IAMP H 2
    IAMP H 2 A_Pain
    TNT1 A 0 A_Jump(80,"Missile")
	Goto See
  Death:
  XDeath:
	TNT1 A 0 A_PlaySound("CerebralImp/ChargeDeath")
	TNT1 A 0 A_FaceTarget
	IAMP HHHHHHHHHHHHHHHHHHHHHHHHH 2 A_SpawnItemEx("CerebralImpSmokeSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 A 0 A_PlaySound("weapons/bfg95explode",7)
	TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 32, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom14", 32, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
    IAMP N 2
	TNT1 A 0 A_CustomMissile("IRocketarm2",30,-10,270)
	TNT1 A 0 A_CustomMissile("IRocketarm",30,10,93)
	TNT1 A 0 A_SpawnItemEx("CyberImpDeathRocket",0,0,28)
    IAMP O 2 A_XScream
	IAMP P 2 A_SpawnItemEx("AnnihilatorImpExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    IAMP Q 2 A_NoBlocking
    IAMP RST 2
    IAMP U -1
	Stop
  XRaise:
  Raise:
	Stop
  }
}

Actor SummonedInsaneAnnihilatorImp : InsaneAnnihilatorImp { -COUNTKILL }

Actor InsaneImpHoming15K : Cybruiser15k
{
  Species "Imps"
  DamageType "ImpComet"
  +SEEKERMISSILE
  States
  {
  Spawn:
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    TNT1 AA 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",Frandom(-8,8),Frandom(-8,8),Frandom(-8,8),Frandom(-1,1),Frandom(-1,1),Frandom(-1,1),Frandom(-20,20),SXF_CLIENTSIDE)
    CFS1 A 4 Bright
	TNT1 A 0 A_SeekerMissile(15,8,SMF_LOOK)
    TNT1 AA 0 A_SpawnItemEx("ProjectileTrailParticleOrange2",Frandom(-8,8),Frandom(-8,8),Frandom(-8,8),Frandom(-1,1),Frandom(-1,1),Frandom(-1,1),Frandom(-20,20),SXF_CLIENTSIDE)
	CFS1 B 4 Bright
    Loop
  }
}

Actor InsaneimpTracer : BabySentientExplosiveTracer
{
  Species "Imps"
  DamageType "ImpComet"
  Decal "DoomImpScorch"
}

//Gore stuff
Actor IRocketArm
{
  Radius 12
  Height 10
  Speed 4
  +DOOMBOUNCE
  +DROPOFF
  +MISSILE
  +NOBLOCKMAP
   States
  {
  Spawn:
    IIRM ABCD 3
    Loop
  Death:
	IIRM E -1
	Loop
  }
} 

Actor IRocketArm2
{
  Radius 12
  Height 10
  Speed 4
  +DOOMBOUNCE
  +DROPOFF
  +MISSILE
  +NOBLOCKMAP
  States
  {
  Spawn:
    IIR2 ABCD 3
    Loop
  Death:
	IIR2 E -1
	Loop
  }
} 

//After images
Actor InsaneAImpGhostA
{
  Scale 1.05
  RenderStyle Translucent
  Alpha 0.75
  +NOGRAVITY
  +CLIENTSIDEONLY
  +DONTSPLASH
  +NOINTERACTION
  +NOBLOCKMAP
  +NOCLIP
  States
  {
  Spawn:
    IAMP A 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneAImpGhostB : InsaneAImpGhostA
{   
  States
  {
  Spawn:
    IAMP B 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneAImpGhostC : InsaneAImpGhostA
{   
  States
  {
  Spawn:
    IAMP C 2 A_FadeOut(0.18)
    Loop
  }
}

Actor InsaneAImpGhostD : InsaneAImpGhostA
{   
  States
  {
  Spawn:
    IAMP D 2 A_FadeOut(0.18)
    Loop
  }
}