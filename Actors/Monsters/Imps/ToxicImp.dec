Actor ToxicImp : Imp 21769
{
  Health 150
  Speed 9
  PainChance 70
  DropItem "LifeEssence" 100
  DropItem "ArmorBonusMax" 100
  DropItem "DemonAmmoPickup" 100
  SeeSound "TImp/sight"
  BloodColor "Red"
  PainSound "TImp/pain"
  DamageFactor "Poison", 0.0
  DamageFactor "PlayerPoison", 0.0
  DamageFactor "SoulToxic", 0.0
  DamageFactor "PoisonCloud", 0.0
  +MISSILEMORE
  +FLOORCLIP
  +QUICKTORETALIATE
  Obituary "$CFToxicImpObit"
  HitObituary "$CFToxicImpHitObit"
  Tag "$CFToxicImp"
  var int user_lowlag;
  States
  {
  Spawn:
    TIMP A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
  Idle:
	TIMP A 10 A_Look
	TIMI A 10 A_Look
    Loop
  See:
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	TIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_Jump(46,"Evade")
	TIMP AABB 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	TIMP CCDD 3 A_Chase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)	
    Loop
  Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	TIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	TIMP AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Melee:
    TIMP EF 5 A_FaceTarget
    TIMP G 5 A_MeleeAttack
    TIMP FE 5 A_FaceTarget		
    Goto See
  Missile:
    TIMP EF 6 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
    TIMP G 5 Bright A_CustomMissile("ToxicBall", 32, 0, 0)
	TIMP FE 4 
    Goto See
  Pain:
    TIMP H 6 A_Pain
    Goto See
  Death:
    TIMP J 8 A_Scream
    TIMP K 6
	TNT1 AAA 0 A_SpawnItemEx("TImpPoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
    TIMP L 6 A_Fall
    TIMP M -1
    Stop
  XDeath:
	TIMP N 3 A_XScream
	TIMP O 3 A_GiveInventory("XDeathCheck",1)
	TNT1 AAAA 0 A_SpawnItemEx("TImpPoison",0,0,20,frandom(-8,8),frandom(-8,8),frandom(-6,6))
	TIMP P 3 A_SpawnItemEx("GibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TIMP Q 3 A_Fall
	TIMP RST 3
	TIMP U -1
    Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
    TIMP MLKJ 5
    Goto See
  XRaise:
    TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	TIMP UTSRQPON 4
	Goto See
  }
}

Actor SummonedToxicImp : ToxicImp { -COUNTKILL }

Actor ToxicBall
{
  Radius 8
  Height 8
  Speed 15
  FastSpeed 19
  Damage (Random(5,7))
  Species "Imps"
  DamageType "ImpComet"
  Scale 0.9
  Projectile
  +NOBOSSRIP
  +BLOODLESSIMPACT
  DeathSound "barbcomet/explosion"
  RenderStyle Add
  Decal "DoomImpScorch"
  States
  {
  Spawn:
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    BRTB A 1 Bright A_SpawnItemEx("BarbCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_Weave(3,0,1.0,0.0)
    BRTB B 1 Bright A_SpawnItemEx("BarbCometTail",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
    Loop
  Death:
	TNT1 A 0
	TNT1 A 0 A_SpawnItemEx("GreenParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE) 
	TNT1 AAA 0 A_CustomMissile("Kaboom7", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))
	TNT1 AAAAA 0 A_SpawnItemEx("TImpPoison",0,0,10,frandom(-4,4),frandom(-4,4),frandom(-2,4))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4", 0, 0, frandom(0,360), CMF_AIMDIRECTION, frandom(0,360))	
    BRTB CDEFG 3 Bright
    Stop
  }
}

Actor GHellionSmokeSpawner2 : RedParticleSpawner
{
  States
  {
  Spawn:
    TNT1 A 0
    TNT1 AAAA 0 A_SpawnItemEx("PoisonSoulGas",frandom(-12,12),frandom(-12,12),frandom(12,64),0,0,frandom(1,3),0,SXF_CLIENTSIDE,0)
    TNT1 A 1
    Stop
  }
}

Actor GHellionSmoke3 : GHellionSmoke { Scale 0.2 }
Actor TImpPoison : BarbatosPoison  { Species "Imps" DamageType "ImpComet" }