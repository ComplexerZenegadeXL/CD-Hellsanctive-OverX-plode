Actor Salamander : Imp
{
  Monster
  Health 400
  Height 60
  Radius 18
  Mass 800
  Speed 5
  PainChance 20
  BloodColor "Orange"
  BloodType "NewBloodOrange"
  MeleeRange 75
  ReactionTime 18
  PainChance "Mine", 128
  PainChance "AdvancedImp", 0
  PainChance "Shadow", 0
  +FLOORCLIP
  +MISSILEMORE
  +DONTHARMSPECIES
  DamageFactor "Acid", 0.7
  DamageFactor "AdvancedImp", 0.2
  DamageFactor "Shadow", 0.2
  //No Infighting
  DamageFactor "Fire", 0.0
  DamageFactor "Nightshade", 0.0
  DamageFactor "AfritComet", 0.0
  DamageFactor "HellionFire", 0.0
  DropItem "LifeEssence", 200, 8
  DropItem "CFArmorBonusMax5", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  DropItem "CFArmorBonusMax1", 200
  SeeSound "imp/sight"
  ActiveSound "imp/active"
  PainSound "imp/pain"
  DeathSound "imp/death"
  Obituary "$CFSalamanderObit"
  HitObituary "$CFSalamanderHitObit"
  Tag "$CFSalam"
  States
 {
  Spawn:
	SALA A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
 Idle:		
	SALA A 10 A_Look
	Loop
  See:
	SALA AAAABBBBCCCCDDDD 1 A_Chase
	TNT1 A 0 A_Jump(15,"Pounce")
	Loop
  Melee:
  Missile:
	TNT1 A 0 A_Jump(120,"Spread")
	TNT1 A 0 A_Jump(70,"Comet")
	SALA EF 3 A_FaceTarget
	TNT1 A 0 A_Jump(60,"Pounce")
	SALA G 4 A_CustomComboAttack("SalamanderBall",40,8,"imp/melee","Melee")
	SALA FEF 3 A_FaceTarget 
	SALA G 4 A_CustomComboAttack("SalamanderBall",40,8,"imp/melee","Melee")
	SALA FEF 3 A_FaceTarget 
	SALA G 4 A_CustomComboAttack("SalamanderBall",40,8,"imp/melee","Melee")
	SALA FE 3
	Goto See
  Spread:
	SALA EF 3 A_FaceTarget
	TNT1 A 0 A_Jump(40,"Pounce")
	SALA G 5 A_CustomMissile("SalamanderBall",40,0,0)
	TNT1 A 0 A_CustomMissile("SalamanderBall",40,0,20)
	TNT1 A 0 A_CustomMissile("SalamanderBall",40,0,-20)
	SALA FE 3
	TNT1 A 0 A_Jump(70,"Comet")
	Goto See
  Comet:
	SALA EF 4 A_FaceTarget
	TNT1 A 0 A_Jump(20,"Pounce")
	SALA G 4 A_CustomComboAttack("SalamanderComet",40,8,"imp/melee")
	SALA FE 4 A_FaceTarget
	Goto See
  Pain:
	SALA H 4 A_Pain
	TNT1 A 0 A_Jump(40,"Pounce")
	SALA H 4
	Goto See
  Pounce:
	SALA F 1
	TNT1 A 0 A_Recoil(random(-35,-25))
	TNT1 A 0 ThrustThingZ(0,random(16,8),0,0)
	SALA FF 1
  Flight:
	SALA F 1 A_JumpIf(velz==0,"land")
	Loop
  Land:
	TNT1 A 0 A_JumpIfCloser(75,"Melee")
	SALA F 2 A_Stop
	Goto See
  Death:
	SALA I 5
	SALA J 5 A_Scream
	SALA KL 5
	SALA M 5 A_Fall
	TNT1 A 0 A_SpawnItem("BodyCrash",0,0,0,0)
	SALA M -1
	Stop
  XDeath:
	SALA N 3 A_SpawnItemEx("OrangeGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	SALA O 3 A_XScream
	TNT1 A 0 A_GiveInventory("XDeathCheck",1)
	SALA P 3 
	SALA Q 3 A_Fall
	SALA RST 3
	SALA U -1
	Stop
  Raise:
	TNT1 A 0 A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0 A_JumpIfInventory("XDeathCheck",1,"XRaise")
	SALA LKJI 5
	Goto See
  XRaise:
	TNT1 A 0 A_TakeInventory("XDeathCheck",1)
	SALA TSRQPON 4
	Goto See
  }
}

Actor SummonedSalamander : Salamander { -COUNTKILL }

Actor SalamanderBall
{
  Projectile
  Height 10
  Radius 8
  Speed 18
  FastSpeed 22
  RenderStyle Add
  Damage (Random(30,60)) //10
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Species "Imps"
  Damagetype "Fire"
  SeeSound "imp/attack"
  DeathSound "imp/shotx"
  States
  {
  Spawn:
	FRTM AB 1 Bright A_SpawnItemEx("AfritTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Death:
	FRTM C 4 Bright
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE)
	TNT1 AAA 0 A_CustomMissile("Kaboom9",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AAA 0 A_CustomMissile("SmokeFX4",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))	
	FRTM CDE 3 Bright
	Stop
  }
}

Actor FireSpawnerTail : CometTail { Scale 0.47 +NOINTERACTION +NOBLOCKMAP }

Actor BaseFireSpawner
{
  Projectile
  Height 6
  Radius 3
  Scale 0.5
  Speed 30
  FastSpeed 30
  Gravity 0.2
  RenderStyle Add
  MaxStepHeight 4
  Decal "DoomImpScorch"
  Damage 1
  -NOGRAVITY
  +STRIFEDAMAGE
  +NOEXTREMEDEATH
  +NODAMAGETHRUST
  +DONTHARMSPECIES
  +DONTHURTSPECIES
  Species "Imps"
  DamageType "Fire"
  DeathType "Fire"
  DeathSound "Welder/FlameHit"
  Obituary "$CFBaseFireSpawnerObit"
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_PlaySound("Welder/PyroShotFly",CHAN_BODY,1.0,1)
  SpawnLoop:
	FRTB A 1 A_SpawnItemEx("FireSpawnerTail",0,0,0)
	Loop
	/*
  Death:
	TNT1 AAA 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_NoGravity
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,128)
	TNT1 AA 0 A_CustomMissile("Kaboom69",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX7",0,0,frandom(0,360),2,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("WelderFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AAAA 0 A_SpawnItemEx("WelderFlare",0,0,0,frandom(2,4),frandom(2,4),2,frandom(0,360),SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	FRTM CDE 3 Bright
	Stop
	*/
  }
}

Actor PlayerFlamethrowerShot : BaseFireSpawner
{
  Damage (random(40,50))
  Species "Player"
  DamageType "PyroShot"
  States
  {
  Death:
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_NoGravity
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("Kaboom69",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("WelderFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	TNT1 AAAA 0 A_SpawnItemEx("WelderFlare",0,0,0,frandom(2,4),frandom(2,4),2,frandom(0,360),SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER,64)
	FRTM CDE 3 Bright
	Stop
  }
}

Actor SalamanderFlameShot : BaseFireSpawner
{
  Species "Imps"
  Damage (Random(15,25))
  States
  {
  Death:
	FRTM C 3 Bright
	TNT1 A 0 A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Stop
	TNT1 A 0 A_NoGravity
	TNT1 A 2 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	TNT1 AA 2 A_CustomMissile("Kaboom69",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 5 A_CustomMissile("SmokeFX7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 2 A_SpawnItemEx("SalamanderFlare",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_SETMASTER)
	FRTM CDE 3 Bright
	Stop
  }
}

Actor BaseFireFlare
{
  Projectile
  Height 4
  Radius 4
  Speed 1
  Gravity 0.52
  BounceFactor 0.01
  WallBounceFactor 0.01
  Renderstyle Add
  Alpha 1.0
  MaxStepHeight 4
  Damage 1
  +DOOMBOUNCE
  +DONTFALL
  -NOGRAVITY
  +STRIFEDAMAGE
  -NOCLIP
  +RIPPER
  +BLOODLESSIMPACT
  +NODAMAGETHRUST
  -EXTREMEDEATH
  +DONTHURTSPECIES
  +DONTHARMSPECIES
  DamageType "Fire"
  DeathType "Fire"
  States
  {
  Spawn:
	TNT1 A 0
	CFCF A 1 Bright A_SetArg(4,12)
	Goto Normal
  Normal:
	TNT1 A 0 A_JumpIf(waterlevel > 1, "Nop")
	TNT1 A 0 A_ChangeFlag(MOVEWITHSECTOR,1)
	CFCF AABBCC 1 Bright A_SpawnItemEx("CFFlareFire",frandom(-3,3),frandom(-3,3),frandom(0,7),0,0,frandom(2,7),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64)
	TNT1 A 0 A_FadeOut(0.015,0)
	TNT1 A 0 A_Explode(5+random(1,4),50,0,0)
	CFCF DDEEFF 1 Bright A_SpawnItemEx("CFFlareFire",frandom(-3,3),frandom(-3,3),frandom(0,7),0,0,frandom(2,7),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64+1)
	TNT1 A 0 A_FadeOut(0.015,0)
	TNT1 A 0 A_Explode(5+random(1,4),50,0,0)
	CFCF GGHHII 1 Bright A_SpawnItemEx("CFFlareFire",frandom(-3,3),frandom(-3,3),frandom(0,7),0,0,frandom(2,7),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64+2)
	TNT1 A 0 A_FadeOut(0.015,0)
	TNT1 A 0 A_Explode(5+random(1,4),50,0,0)
	CFCF KKLLMM 1 Bright A_SpawnItemEx("CFFlareFire",frandom(-3,3),frandom(-3,3),frandom(0,7),0,0,frandom(2,7),frandom(0,360),SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,64+3)
	TNT1 A 0 A_FadeOut(0.015,0)
	TNT1 A 0 A_Explode(5+random(1,4),50,0,0)
	TNT1 A 0 A_CountdownArg(4,"Death")
	TNT1 A 0 A_ChangeVelocity(velx/2,vely/2,velz,CVF_REPLACE)
	Loop
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_ChangeFlag(THRUACTORS,1)
	TNT1 A 0 A_ChangeFlag(RIPPER,0)
	TNT1 A 0 A_ChangeVelocity(velx/10,vely/10,velz,CVF_REPLACE)
	CFCF ABCDEFGHIJKLMNOP 1 Bright A_SetScale(ScaleX-0.06,ScaleY-0.06)
	Stop
  Nop:
	TNT1 A 1 A_ChangeFlag("MISSILE",0)
	Stop
  }
}

Actor BaseFireSpawnerExplodeFX : CFSpawnerFXBase
{
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 AA 0 A_CustomMissile("Kaboom69",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 AA 0 A_CustomMissile("SmokeFX7",0,0,frandom(0,360),CMF_AIMDIRECTION,frandom(0,360))
	TNT1 A 1
	Stop
  }
}

Actor WelderFlare : BaseFireFlare
{
  Species "Player"
  Obituary "$CFWelderFlareObit"
}

Actor SalamanderFlare : BaseFireFlare
{
  Species "Imps"
  Obituary "$CFSalamanderFlareObit"
}

Actor SalamanderComet : Comet
{
  Species "Imps"
  DamageType "Fire"
  States
  {
  Spawn:
	COMT AAABBBCCC 1 Bright A_SpawnItemEx("AfritTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
  SpawnLoop:
	COMT AAABBBCCC 1 Bright A_SpawnItemEx("AfritTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_CLIENTSIDE,0)
	Loop
  Death:
	TNT1 A 0 A_Explode(64,102)
	TNT1 A 0 A_SetTranslucent(0.75,1)
	TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
	TNT1 AAAA 0 A_CustomMissile("SalamanderFlameShot",0,0,frandom(0,360),CMF_AIMDIRECTION|CMF_TRACKOWNER,frandom(0,360))
	COMT D 3 Bright A_SpawnItemEx("CometDeathGlow",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	COMT E 3 Bright A_SpawnItemEx("CometDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	Stop
  }
}