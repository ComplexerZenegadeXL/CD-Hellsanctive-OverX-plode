	TNT1 A 0 A_SpawnItemEx("BlackProjParticleSuperLarge2",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
	TNT1 A 0 A_CustomMissile("NemesisImpLaserBallAttack",random(-1,1),random(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	CLBB D 3 Bright A_SpawnItemEx("BlackProjParticleSuperLarge2",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("BlackProjParticleSuperLarge2",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
	TNT1 A 0 A_CustomMissile("NemesisImpLaserBallAttack",random(-1,1),random(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	CLBB D 3 Bright A_SpawnItemEx("BlackProjParticleSuperLarge2",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
	TNT1 A 0 A_SpawnItemEx("BlackProjParticleSuperLarge2",0,0,0,0,frandom(-1,1),frandom(-1,1),frandom(0,360))
	TNT1 A 0 A_CustomMissile("NemesisImpLaserBallAttack",frandom(-1,1),frandom(-2,2),0,CMF_AIMDIRECTION|CMF_TRACKOWNER)
	Loop
  Death:
	TNT1 A 0 A_StopSound(6)
	TNT1 A 0 A_Explode(158,138,0)
