  DamageFactor "UpBFG9500Ball", 0.5
  DamageFactor "UpBFGSplash", 0.15
  DamageFactor "PDTBFG", 0.03
  DamageFactor "PDTBFGTracer", 0.03
  DamageFactor "PlayerDevBall", 0.2
  DamageFactor "PlayerDevBall2", 0.2
  DamageFactor "Player", 0.4
  DamageFactor "PlayerDevTracer", 0.02
  DamageFactor "DBFG2", 0.2
  DamageFactor "DBFG10K2", 0.2
  DamageFactor "DBFGSplash2", 0.2
  DamageFactor "PlayerDBFG", 0.05
  DamageFactor "PlayerDBFG2", 0.65
  DamageFactor "PlayerDBFG10K2", 0.65
  DamageFactor "PlayerDBFGSplash2", 0.65
  DamageFactor "PlayerHellfire", 0.3
  DamageFactor "DiscoBFG", 0.2
  DamageFactor "Normal", 0.8
  DamageFactor "None", 0.4
  DamageFactor "Players", 0.75
  DamageFactor "Marine", 0.75
  DamageFactor "NemesisBeam", 0.25
  DropItem "NemesisSphere" 70
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "NemesisHealthBonusMax", 256
  DropItem "NemesisArmorBonus32", 256
  DropItem "LegendaryPowerSphere" 85
  DropItem "NLDemonAmmoBoxPickup" 200 
  DropItem "NLDemonAmmoPickup" 256
  //DropItem "NemesisRifleGiver" 50
  SeeSound "NemesisImp/sight"
  ActiveSound "NemesisImp/active"
  PainSound "NemesisImp/pain"
  DeathSound "NemesisImp/death"
  Obituary "$CFNemesisImpObit"
  HitObituary "$CFNemesisImpHitObit"
  Tag "$CFNemImp"
  var int user_phase2;
  var int user_deathtimer;
  var int user_deathtimeractive;
  States
  {
  Spawn:
	NSIN A 0
	TNT1 A 0 A_GiveInventory("VileStaffResistance",3)
	TNT1 A 0 ACS_NamedExecuteAlways("WimpyMode",0,2)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,2,4)
	TNT1 A 0 ACS_NamedExecuteAlways("SpawnEffects",0)
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
  Idle:
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Idle2")
	NSIN AQ 10 Bright A_Look
	Loop
  Idle2:
	NSI2 A 10 Bright A_Look
	Loop
  See:
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_JumpIf(user_deathtimer > 10,2)
	TNT1 A 0 A_SetUserVar("user_effect_type",23)
	TNT1 A 0 A_SetUserVar("user_effect_delay",6)
	TNT1 A 0 A_SetUserVar("user_effect_quantity",1)
	TNT1 A 0 A_JumpIf(user_lowlag == 1,"MoreSee")
	TNT1 A 0 A_JumpIfTargetInLOS("MoreSee",0,0,0,0)
	NSIN AABB 3 A_Chase
	Loop
  MoreSee:
	TNT1 A 0 A_SetUserVar("user_lowlag",1)
	TNT1 A 0 A_JumpIf(user_deathtimeractive == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("NemesisDeathTimerForVexed",0)
	TNT1 A 0 A_SetUserVar("user_deathtimeractive",1)
	TNT1 A 0 A_JumpIf(user_music == 1,3)
	TNT1 A 0 ACS_NamedExecuteAlways("CFMusic",0,705)
	TNT1 A 0 A_SetUserVar("user_music",1)
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"See2")
	TNT1 A 0 A_JumpIfHealthLower(600,"LoseWings")
	NSIN AABBCCDD 3 Bright A_Chase
	TNT1 A 0 A_Jump(30,"Teleport")
	TNT1 A 0 A_Jump(62,"Rush")
	TNT1 A 0 A_Jump(50,"AirDodge")
	Loop
  See2:
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_ChangeFlag(NOPAIN,0)
	TNT1 A 0 A_Jump(46,"Evade","Rush2")
	NSI2 AABB 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
	NSI2 CCDD 3 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("LegendaryHumanishStep",0,0,5,0,0,-20)
	TNT1 A 0 A_Jump(46,"Phase")	
    Loop
  Phased:
	NSI2 AABBCCDDAABBCCDD 1 A_ExtChase(0,0)
	NSI2 AABBCCDDAABBCCDDAABBCCDDAABBCCDD 1 A_Chase
	TNT1 A 0 A_Jump(24,"UnPhase","PhasedRun")
	Goto Phased+32
  AirDodge:
	TNT1 A 0 A_Jump(256,"Right","Left","Back","BackLeftRange","BackRightRange")
	TNT1 A 0
	GoTo See
  Right:
	TNT1 A 0 ThrustThing(angle*256/360+64,30,0,0)
	NSIN A 5 Bright
	Goto See
  Left:
	TNT1 A 0 ThrustThing(angle*256/360+192,30,0,0)
	NSIN A 5 Bright
	Goto See
  Back:
	TNT1 A 0 ThrustThing(angle*256/360+128,30,0,0)
	NSIN A 5 Bright
	Goto See
  BackLeftRange:
	TNT1 A 0 ThrustThing(angle*256/360+random(133,187),30,0,0)
	NSIN A 5 Bright
	Goto See
  BackRightRange:
	TNT1 A 0 ThrustThing(angle*256/360+random(69,123),30,0,0)
	NSIN A 5 Bright 
	Goto See
	Evade:
	TNT1 A 0 A_Jump(128,7)
	TNT1 A 0 ThrustThing(Angle*256/360+64,16,0,0)
	NSI2 AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
	TNT1 A 0 ThrustThing(Angle*256/360+192,16,0,0)
	NSI2 AAAA 3 A_Chase
	TNT1 A 0 A_Stop
	Goto See
  Phase:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	NSI2 E 2 A_FaceTarget
	NSI2 E 1 A_SetTranslucent(0.75)
	NSI2 E 1 A_SetTranslucent(0.55)
	NSI2 E 1 A_SetTranslucent(0.35)
	NSI2 E 1 A_SetTranslucent(0.15)
	Goto Phased
  UnPhase:
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	NSI2 E 1 A_SetTranslucent(0.15)
	NSI2 E 1 A_SetTranslucent(0.35)
	NSI2 E 1 A_SetTranslucent(0.55)
	NSI2 E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	NSI2 E 2 A_FaceTarget	
 	Goto See2
  Melee:
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Melee2")
	NSIN EF 6 Bright A_FaceTarget
	NSIN F 5 Bright A_MeleeAttack
	Goto See
  Melee2:
	NSI2 EF 5 A_FaceTarget
	NSI2 G 5 A_MeleeAttack
	NSI2 FE 5 A_FaceTarget	
 	Goto See2
  Missile:
	TNT1 A 0 A_SetShootable
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	TNT1 A 0 A_SetTranslucent(1)
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Missile2")
	TNT1 A 0 A_Jump(32,"Super")
	TNT1 A 0 A_Jump(64,"Seeker","Laser")
	Goto Normal
  Missile2:
	TNT1 A 0 A_JumpIfCloser(250,"Lunge")
	TNT1 A 0 A_Jump(64,"Laser2","Super2")
	NSI2 EF 4 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 5 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	NSI2 FE 3
	NSI2 F 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 3 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),16,0,0)
	NSI2 FEF 3
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 3 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	NSI2 FE 3
	NSI2 F 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 3 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),16,0,0)
	NSI2 FEF 3
	TNT1 A 0 A_Stop
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 3 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	NSI2 FE 3
	NSI2 F 3 A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSI2 G 3 Bright A_CustomMissile("NemesisImpBallSeek", 32, 0, 0)
	NSI2 FEF 3
	TNT1 A 0 A_Stop
	Goto See2
  Lunge:
	NSI2 AA 3 A_FaceTarget
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,1)
	TNT1 A 0 ThrustThingZ(0,20,0,1)
	NSI2 F 2 A_Recoil(-30)
	NSI2 F 3 A_CustomMissile("GoreImpLunge",18,0,0,CMF_AIMDIRECTION)
	TNT1 A 0 A_PlaySound("imps/melee")
	NSI2 F 6
	NSI2 F 2 A_ScaleVelocity(0.2)
	TNT1 A 0 A_ChangeFlag(SLIDESONWALLS,0)
	NSI2 F 1 A_ScaleVelocity(0)
	Goto See
  Normal:
	NSIN EF 8 Bright A_FaceTarget
	NSIM F 1 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, 0)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, -5)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, 5)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, -10)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, 10)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, -15)
	TNT1 A 0 A_CustomMissile("NemesisImpBall", 28, 0, 15)
	TNT1 A 0 A_Jump(100,"Seeker","Normal")
	Goto See
  Seeker:
	NSIN EF 10 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	NSIM F 2 Bright A_FaceTarget
	TNT1 A 0 A_PlaySound("imp/attack")
	NSIM F 4 Bright A_CustomMissile("NemesisImpBallSeek",32,20,0)
	TNT1 A 0 A_Jump(64,"Seeker","Normal")
	Goto See
  Laser:
	TNT1 A 0 A_PlaySound("NemesisImp/Sight")
	TNT1 A 0 A_Facetarget
	NSIN EEEFFF 4 Bright A_FaceTarget
	TNT1 A 0 A_SpawnItem("NemesisHellionSmokeSpawner",0,0,0,0)
	NSIM F 4 Bright A_CustomMissile("NemesisImpLaser", 32, 0, 0)
	TNT1 A 0 A_FaceTarget
	NSIM F 4
	TNT1 A 0 A_FaceTarget
	TNT1 A 0 A_MonsterRefire(64,"See")
	TNT1 A 0 A_Jump(100,"See")
	Goto Laser+1
  Laser2:
	TNT1 A 0 A_PlaySound("NemesisImp/Sight")
	TNT1 A 0 A_Facetarget
	NSI2 EEE 4 Bright A_SpawnItem("NemesisHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_Facetarget
	NSI2 FFF 4 Bright A_SpawnItem("NemesisHellionSmokeSpawner",0,0,0,0)
	TNT1 A 0 A_Facetarget
	TNT1 A 0 A_SpawnItem("NemesisHellionSmokeSpawner",0,0,0,0)
	NSI2 G 4 Bright A_CustomMissile("NemesisImpLaser", 32, 0, 0)
	TNT1 A 0 A_Facetarget
	TNT1 A 0 ThrustThing(Angle*256/360+random(64,192),32,0,0)
	NSI2 G 4
	TNT1 A 0 A_Facetarget
	TNT1 A 0 A_MonsterRefire(64,"See2")
	TNT1 A 0 A_Jump(100,"See2")
	Goto Laser2+1
  Super:
	TNT1 A 0 A_JumpIfCloser(200,"Normal")
	TNT1 A 0 A_PlaySound ("legimp/chargingsound")
	TNT1 A 0 A_GiveInventory("BossProtectionTierIII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	NSIN EEEEEEEEEEFFFFFFFFFFFF 5 Bright A_FaceTarget
	NSIM F 6 Bright A_CustomMissile ("NemesisImpLaserBall",28,0,0)
	TNT1 A 0 A_playSound ("legimp/fiyabetch")
	TNT1 A 0 A_FaceTarget
	NSIN FF 5 Bright A_FaceTarget
	NSIN FF 5 Bright
	NSIM F 6 Bright A_CustomMissile ("NemesisImpLaserBall",28,0,0)
	TNT1 A 0 A_playSound ("legimp/fiyabetch")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See
  Super2:
	TNT1 A 0 A_JumpIfCloser(200,"Laser2")
	TNT1 A 0 A_PlaySound ("legimp/chargingsound")
	TNT1 A 0 A_GiveInventory("BossProtectionTierII",1) //A_SetInvulnerable
    TNT1 A 0 ACS_NamedExecuteAlways("BossResistanceBuff")
	TNT1 A 0 A_FaceTarget
	NSI2 EEEEEEEEEEFFFFFFFFFFFF 5 Bright A_FaceTarget
	NSI2 G 6 Bright A_CustomMissile ("NemesisImpLaserBall",28,0,0)
	TNT1 A 0 A_PlaySound ("legimp/fiyabetch")
	TNT1 A 0 A_FaceTarget
	NSI2 FF 5 Bright A_FaceTarget
	NSI2 FF 5 Bright
	NSI2 G 6 Bright A_CustomMissile ("NemesisImpLaserBall",28,0,0)
	TNT1 A 0 A_playSound ("legimp/fiyabetch")
	TNT1 A 0 ACS_NamedExecuteAlways("TakeResistance") //A_UnSetInvulnerable
	Goto See2
  Rush:
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_SpawnItemEx("NemesisImpGhost")  
	NSIN A 1 Bright A_Chase
	TNT1 A 0 A_Jump(84,"See")
	Loop
  Rush2:
	NSI2 A 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 A 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 B 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 B 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 C 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 C 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 D 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 D 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 A 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 A 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 B 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 B 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 C 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 C 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 D 1 A_Chase
	NSI2 A 0 A_Chase
	NSI2 D 1 A_Chase
	NSI2 A 0 A_Chase
	TNT1 A 0 A_Jump(48,"See2")
	Loop
  Teleport:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	NSIN A 1 Bright A_UnSetShootable
	NSIN AAAAAAAAAA 1 Bright A_FadeOut(0.1,0)
	NSIN A 2 Bright
	TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
	NSIN A 1 Bright A_PlayWeaponSound("boss/teleport")
	TNT1 A 0 A_Recoil(0.1)
	NSIN AAAAAAAAAA 1 Bright A_FadeIn(0.1)
	NSIN A 1 Bright A_SetShootable
	Goto See	
  Pain:
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Pain2")
	TNT1 A 0 A_Jump(50,"Teleport")
	NSIN H 2 Bright
	NSIN H 2 Bright A_Pain
	Goto See
  Pain2:
	TNT1 A 0 A_Jump(32,"PhaseRun")
	NSI2 H 2 Bright
	NSI2 H 2 Bright A_Pain
	Goto See2
  PhaseRun:
	TNT1 A 0 A_UnSetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,1)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	NSI2 E 2 A_FaceTarget
	NSI2 E 1 A_SetTranslucent(0.75)
	NSI2 E 1 A_SetTranslucent(0.55)
	NSI2 E 1 A_SetTranslucent(0.35)
	NSI2 E 1 A_SetTranslucent(0.15)
	Goto PhasedRun
  PhasedRun:
	TNT1 A 0 A_SetUserVar("user_effect_type",0)
	NSI2 A 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 A 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 B 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 B 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 C 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 C 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 D 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 D 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 A 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 A 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 B 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 B 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 C 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 C 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 D 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	NSI2 D 1 A_ExtChase(0,0)
	NSI2 A 0 A_ExtChase(0,0)
	TNT1 A 0 A_Jump(64,"UnPhaseRun")
	Loop
  UnPhaseRun:
	TNT1 A 0 A_SetUserVar("user_effect_type",22)
	TNT1 A 0 A_SetShootable
	TNT1 A 0 A_ChangeFlag(FRIGHTENED,0)
	TNT1 A 0 A_PlaySound("phaseimp/teleport")
	NSI2 E 1 A_SetTranslucent(0.15)
	NSI2 E 1 A_SetTranslucent(0.35)
	NSI2 E 1 A_SetTranslucent(0.55)
	NSI2 E 1 A_SetTranslucent(0.75)
	TNT1 A 0 A_SetTranslucent(1)
	NSI2 E 2 A_FaceTarget	
	Goto See2
  LoseWings:
	TNT1 A 0 A_ChangeFlag("NOPAIN",1)
	TNT1 A 0 A_ChangeFlag("FLOAT",0)
	TNT1 A 0 A_ChangeFlag("NOGRAVITY",0)
	NSIN H 4 Bright
	NSIN H 7 Bright A_Pain
	TNT1 A 0 A_SpawnItemEx("BlackGibbedGenerator",0,0,0,0,0,0,0,SXF_CLIENTSIDE,0)
	TNT1 A 0 A_SpawnItemEx("NemesisImpWing1",0,0,0,10,0,4)
	TNT1 A 0 A_SpawnItemEx("NemesisImpWing2",0,0,0,10,0,4)
	TNT1 A 0 A_SetUserVar("user_phase2",1)
	NSI2 H 7 Bright
	TNT1 A 0 A_ChangeFlag("NOPAIN",0)
	Goto See2
  Death:
	TNT1 A 0 A_JumpIf(user_phase2 == 1,"Death2")
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 ACS_NamedExecuteWithResult("VexCheck",0,10)
	NSIN I 8
	NSIN J 8 A_Scream
	NSIN K 6
	NSIN L 6 A_NoBlocking
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("NemesisDust",random(2,4),256)
	NSIN M 1
	TNT1 A 0 A_Jump(100,"MoreStuff")
	NSIN N -1
	Stop
  MoreStuff:
	NSIN N 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack")
	NSIN NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN 1 A_SpawnItem("NemesisZombieItemRandomizer")
	NSIN N 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	NSIN N -1
	Stop
  VexedSpawn:
	NSIN H 3 Bright A_Pain
	NSIN H 0 A_PlaySoundEx("brain/spit",7,0,2)
	NSIN HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisLightning")
	NSIN HHHHHHHHHHHH 2 Bright A_SpawnItemEx("VexedNemesisFlameSpawner")
	TNT1 A 0 A_SpawnItemEx("VexedNemesisImp",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop	
  Death2:
	TNT1 A 0 A_CheckFlag("FRIENDLY",2)
	TNT1 A 0 ACS_NamedExecuteWithResult("VexCheck",1,10)
	NSI2 I 8 A_SetTranslucent(1)
	NSI2 J 8 A_Scream
	TNT1 A 0 ACS_NamedExecuteAlways("LegendaryRunes",0,25)
	TNT1 A 0 A_DropItem("NemesisDust",random(2,4),256)
	NSI2 K 6
	NSI2 L 6 A_Fall
	TNT1 A 0 A_Jump(100,"MoreStuff2")
	NSI2 M -1
	Stop
  MoreStuff2:
	NSI2 M 100
	TNT1 A 0 A_SpawnItemEx("HellionSmokeAttack")
	NSI2 MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM 1 A_SpawnItem("NemesisZombieItemRandomizer")
	NSI2 M 1 A_SpawnItem("NemesisZombieSuperItemRandomizer")
	NSI2 M -1
	Stop
  VexedSpawn2:
	NSI2 H 3 Bright A_Pain
	NSI2 H 0 A_PlaySoundEx("brain/spit",7,0,2)
	NSI2 HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH 2 Bright A_GiveInventory("NemesisSoulEvent",1)
	TNT1 A 0 A_SpawnItemEx("NemesisLightning")
	NSI2 HHHHHHHHHHHH 2 Bright A_SpawnItemEx("VexedNemesisFlameSpawner")
	TNT1 A 0 A_SpawnItemEx("VexedNemesisImp",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	TNT1 A 0
	Stop
  }
}

