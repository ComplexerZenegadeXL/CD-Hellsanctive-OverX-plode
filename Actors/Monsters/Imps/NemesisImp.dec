Actor NemesisImpGhost
{
  Projectile
  Height 56
  Radius 20
  Speed 0
  Scale 1.1
  RenderStyle Translucent
  Alpha 0.7
  +NOTIMEFREEZE
  +NOINTERACTION
  +NOBLOCKMAP
  +CLIENTSIDEONLY
  States
  {
  Spawn:
	TNT1 A 0
	TNT1 A 0 A_CheckSight("Vanilla")
	TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("CheckVanilla") == 1, "Vanilla")	TNT1 A 1
	Goto Fade
  Fade:
	NSIN A 2 A_FadeOut(0.1,1)
	Loop
  Vanilla:
	TNT1 A 1
	Stop	
  }
}
