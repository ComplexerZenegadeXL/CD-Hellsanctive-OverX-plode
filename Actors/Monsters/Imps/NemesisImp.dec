	CLBB D 1 Bright A_FadeOut(0.2)
	Loop
  }
}

Actor NemesisImpLaserBallAttack : LegBallAttack
{
  Speed 7
  FastSpeed 9
  Obituary "$CFNemesisImpLaserBallAttackObit"
