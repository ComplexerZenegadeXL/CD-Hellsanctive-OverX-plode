Actor Ghorul : CFGhoul //sprites found in Grosshive
{
  -COUNTKILL
  +NOINFIGHTING
  Damage (18)
  SeeSound "Ghorul/Sight"
  PainSound "Ghorul/pain"
  DeathSound "Ghorul/death"
  ActiveSound "Ghorul/active"
  DropItem "BossLifeEssence" 180 25
  DropItem "PartialKakuhou" 112 1
  DropItem "PartialKakuhou" 112 1
  DropItem "PartialKakuhou" 112 1
  DropItem "CFArmorBonusMax5", 150
  DropItem "CFArmorBonusMax5", 150
  DropItem "CFArmorBonusMax5", 150
  DropItem "CFArmorBonusMax1", 150
  DropItem "CFArmorBonusMax1", 150
  DropItem "CFArmorBonusMax1", 150
  Species "Imps"
  MeleeSound "monster/vulhit"
  Obituary "$CFGhorulObit"
  HitObituary "$CFGhorulHitObit"
  Health 565
  Tag "$CFGhorul"
  States
   {
  Spawn:
	KAKJ A 0
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_GiveInventory("Ghouls",1)
  Idle:
	KAKJ A 10 A_Look
	Loop
  Wander:
	TNT1 A 0 A_Gravity
	KAKJ AAAA 1 A_Look
	KAKJ A 0 A_Wander
	KAKJ BBBB 1 A_Look
	KAKJ B 0 A_Wander
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ CCCC 1 A_Look
	KAKJ C 0 A_Wander
	KAKJ DDDD 1 A_Look
	KAKJ D 0 A_Wander
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	Loop
  See:
	TNT1 A 0 A_Gravity
	KAKJ A 1 A_Chase
	TNT1 A 0 A_Gravity
	KAKJ AA 1 A_Chase("","")
	TNT1 A 0 A_Gravity
	KAKJ B 1 A_Chase
	TNT1 A 0 A_Gravity
	KAKJ BB 1 A_Chase("","")
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ C 1 A_Chase
	KAKJ CC 1 A_Chase("","")
	KAKJ D 1 A_Chase
	KAKJ DD 1 A_Chase("","")
	TNT1 A 0 A_Gravity
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ A 0 A_Jump(60,"Dodge")
	Loop
  Pain.Mine:
  Dodge:
	KAKJ A 0 A_Jump(255,"Strafe","FastChase")
	Goto See
  Strafe:
	KAKJ A 0 A_Jump(255,"Right","Left","Back","BackLeftRange","BackRightRange")
	Goto See
  Right:
	KAKJ A 0 ThrustThing(angle*256/360+64,30,0,0)
	KAKJ A 5
	GoTo See
  Left:
	KAKJ A 0 ThrustThing(angle*256/360+192,30,0,0)
	KAKJ A 5
	Goto See
  Back:
	KAKJ A 0 ThrustThing(angle*256/360+128,30,0,0)
	KAKJ A 5
	Goto See
  BackLeftRange:
	KAKJ A 0 ThrustThing(angle*256/360+frandom(133,187),30,0,0)
	KAKJ A 5
	Goto See
  BackRightRange:
	KAKJ A 0 ThrustThing(angle*256/360+frandom(69,123),30,0,0)
	KAKJ A 5
	Goto See
  FastChase:
	KAKJ A 1 A_FastChase
	KAKJ A 0 A_FastChase
	KAKJ A 1 A_FastChase
	KAKJ A 0 A_FastChase
	KAKJ B 1 A_FastChase
	KAKJ B 0 A_FastChase
	KAKJ B 1 A_FastChase
	KAKJ B 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ C 1 A_FastChase
	KAKJ C 0 A_FastChase
	KAKJ C 1 A_FastChase
	KAKJ C 0 A_FastChase
	KAKJ D 1 A_FastChase
	KAKJ D 0 A_FastChase
	KAKJ D 1 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ D 0 A_FastChase
	KAKJ A 1 A_FastChase
	KAKJ A 0 A_FastChase
	KAKJ A 1 A_FastChase
	KAKJ A 0 A_FastChase
	KAKJ B 1 A_FastChase
	KAKJ B 0 A_FastChase
	KAKJ B 1 A_FastChase
	KAKJ B 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ C 1 A_FastChase
	KAKJ C 0 A_FastChase
	KAKJ C 1 A_FastChase
	KAKJ C 0 A_FastChase
	KAKJ D 1 A_FastChase
	KAKJ D 0 A_FastChase
	KAKJ D 1 A_FastChase
	KAKJ D 0 A_FastChase
	TNT1 A 0 A_SpawnItemEx("HumanishStep",0,0,5,0,0,-20)
	KAKJ A 0 A_Jump(30,"See")
	Loop
  Melee:
	KAKJ EF 3 A_FaceTarget(60,27)
	KAKJ G 3 A_CustomMissile("GhorulAttack",30,0,Angle,CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
	KAKJ GG 2 A_JumpIfInventory("SuccessfulBite",1,"Detect")
	Goto See
  Detect:
	KAKJ A 0 A_ChangeFlag(Invulnerable,1)
	KAKJ E 15 A_ChangeFlag(Invulnerable,0)
	KAKJ E 1
	KAKJ A 0 A_TakeInventory("SuccessfulBite",1)
  End:
	//KAKJ A 0 HealThing(20)
	KAKJ A 0 A_JumpIfInventory("BiteCountShot",5,"KakuHou2")
	KAKJ A 0 A_JumpIfTargetInLos("See",360)
	KAKJ A 0 A_ClearTarget
	Goto Wander
  KakuHou:
	KAKJ FG 4 A_FaceTarget(60,27)
	KAKJ G 0 A_CustomMissile("GhoulShot",38,0,Angle,CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
	KAKJ H 5
	Goto See
  KakuHou2:
	KAKJ FG 5 A_FaceTarget(60,27)
	KAKJ G 0 A_TakeInventory("BiteCountShot",5)
	KAKJ GGGGG 0 A_CustomMissile("GhoulShot",38,0,Angle+frandom(-12,12),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
	KAKJ H 9
	Goto See
  Missile:
	KAKJ A 1 A_Jump(24,"Shards")
	TNT1 A 0 A_Jump(32,"KakuHou")
	KAKJ A 1 A_Jump(42,"Acid")
	KAKJ A 1 A_Jump(100,"RightCharge","LeftCharge")
  Charge:
	KAKJ A 0 A_ClearTarget
	KAKJ A 0 A_LookEx(0,0,0,0,0,"Charging")
	KAKJ E 2
	Goto Wander
  Shards:
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,35,2,-8)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-35,2,-8)
	KAKJ E 0 A_FaceTarget(62,26)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,55,2,0)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-55,2,0)
	KAKJ E 0 A_FaceTarget(62,26)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,75,2,8)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-75,2,8)
	KAKJ E 0 A_FaceTarget(62,26)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,95,2,16)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-95,2,16)
	KAKJ E 0 A_FaceTarget(62,26)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,115,2,20)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-115,2,20)
	KAKJ E 0 A_FaceTarget(62,26)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,125,2,28)
	KAKJ E 1 A_CustomMissile("GhoulWingFX",40,10,-125,2,28)
  ShardLoop:
	TNT1 A 0 A_FaceTarget(62,26)
	KAKJ E 3 A_CustomMissile("GhoulWingFX",40,10,125,2,28)
	KAKJ E 3 A_CustomMissile("GhoulWingFX",40,10,-125,2,28)
	TNT1 A 0 A_CustomMissile("KaguneShard2",frandom(48,70),frandom(45,78),angle+frandom(-18,18),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch+random(18,-18))
	TNT1 A 0 A_CustomMissile("KaguneShard2",frandom(48,70),frandom(-78,-45),angle+frandom(-18,18),CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch+random(18,-18))
	TNT1 A 0 A_JumpIfTargetInLOS("ShardLoop",170,JLOSF_CLOSENOJUMP,700,200)
	TNT1 A 0 A_Jump(32,1)
	Loop
	KAKJ E 6
	Goto Acid
  Acid:
	KAKJ EF 4 A_FaceTarget(62,26)
	KAKJ G 1 Bright
	KAKJ GG 1 Bright A_CustomMissile("KaguneGas",18,0,angle,CMF_ABSOLUTEPITCH|CMF_ABSOLUTEANGLE ,pitch)
    KAKJ G 2 Bright
	KAKJ G 2
	Goto See
  Charging:
	KAKJ E 4 A_FaceTarget(60,27)
	KAKJ E 1 A_JumpIfCloser(70,"Melee")
	KAKJ E 0 ThrustThingZ(0,18,0,0)
	TNT1 A 0 A_SkullAttack(20)
	KAKJ E 1 A_Recoil(-17)
	KAKJ EEEEE 1 A_JumpIfCloser(70,"Melee")
	KAKJ E 2 Thing_Stop(0)
	TNT1 A 0 A_Gravity
	KAKJ H 5
	Goto See
  RightCharge:
	KAKJ A 0 ThrustThing(angle*256/360+frandom(69,5),30,0,0)
	KAKJ A 5
	KAKJ A 1 Thing_Stop(0)
	Goto Charge
  LeftCharge:
	KAKJ A 0 ThrustThing(angle*256/360+frandom(133,251),30,0,0)
	KAKJ A 5
	KAKJ A 1 Thing_Stop(0)
	Goto Charge
  Pain:
	KAKJ H 4 A_Pain
	KAKJ H 0 A_Jump(90,"Dodge")
	Goto See
  XDeath:
  Death: 
	KAKJ I 3
	TNT1 A 0 A_TakeInventory("Ghouls",1)
	KAKJ J 3 A_ScreamAndUnblock
	KAKJ KLM 4
	KAKJ N 0 A_SpawnItemEx("BodyCrash",0,0,0,0,0,0,0,0,SXF_CLIENTSIDE)
	KAKJ N -1
	Stop
  XRaise:
  Raise:
	TNT1 A 0  A_GiveInventory("NoCountKill",1)
	TNT1 A 0 ACS_NamedExecuteAlways("ModifyMonster",0,1)
	TNT1 A 0 A_SpawnItemEx("VileHealEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	KAKJ NMLKJIH 3
    TNT1 A 0 A_GiveInventory("Ghouls",1)
	Goto See
  Pain.Goreling:
	TNT1 A 0 A_JumpIfInventory("Ghouls",1,"See")
    TNT1 A 0 A_SpawnItemEx("BloodConsumeFX",0,0,32,0,0,0,0,SXF_NOCHECKPOSITION)
	Stop
  }
}

Actor GhoulWingFX
{
  +NOGRAVITY
  +THRUACTORS
  +BOUNCEONFLOORS
  +BOUNCEONWALLS
  +BOUNCEONCEILINGS
  +NOINTERACTION
  +NOBLOCKMAP
  BounceCount 999
  BounceFactor 0.99
  WallBounceFactor 0.99
  Renderstyle Add
  Scale 0.2
  Projectile
  Height 1
  Radius 1
  Speed 20
  var int user_counter;
  States
   {
    Spawn:
	 TNT1 A 0 A_SetUserVar("user_counter",user_counter + 1)
	 L5NR A 1 Bright
	 TNT1 AA 0 A_SpawnItemEx("HadesFire",frandom(-1,1),frandom(-1,1),frandom(-1,2),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	 TNT1 AAAA 1 A_SpawnItemEx("HadesFire",frandom(-1,1),frandom(-1,1),frandom(-2,3),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,78)
	 TNT1 AAAAA 1 A_SpawnItemEx("KaguneGas",0,0,frandom(1,0),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
	 TNT1 AAAAA 1 A_SpawnItemEx("KaguneGas2",frandom(-2,2),frandom(-2,2),frandom(-1,1),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,80)
	 TNT1 A 0 A_JumpIf(user_counter >= 8, 1)
  	 Loop
	 L5NR A 1 Bright A_FadeOut
	 TNT1 A 0 A_SpawnItemEx("KaguneGas",frandom(-4,4),frandom(-4,4),frandom(-3,7),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,78)
	 L5NR A 1 Bright A_FadeOut
	 TNT1 A 0 A_SpawnItemEx("HadesFire",frandom(-4,4),frandom(-4,4),frandom(-3,7),frandom(-1,1),frandom(-1,1),frandom(-1,1),0,SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,78)
	 L5NR A 1 Bright A_FadeOut
	 Wait
   }
 }

Actor KaguneShard2 : KaguneShard { Speed 44 Damage (18) }

Actor GhorulAttack : GhoulAttack { Obituary "$CFGhorulAttackObit" Damage (Random(38,50)) }
