// Rocket
pointlight BCARDROCKET
{
    color 0.2 0.6 1.0
    size 56
}

flickerlight BCARDROCKET_X1
{
    color 0.2 0.6 1.0
    size 64
    secondarySize 72
    chance 0.3
}

flickerlight BCARDROCKET_X2
{
    color 0.1 0.3 0.5
    size 80
    secondarySize 88
    chance 0.3
}

flickerlight BCARDROCKET_X3
{
    color 0.1 0.2 0.3
    size 96
    secondarySize 104
    chance 0.3
}


object BlueCardinalRocket
{
    frame BCRCA { light BCARDROCKET    }
    frame BCRCB { light BCARDROCKET    }

    frame BCRCC { light BCARDROCKET_X1 }
    frame BCRCD { light BCARDROCKET_X2 }
    frame BCRCE { light BCARDROCKET_X3 }
}


object BlueCardRocketExplosion
{
    frame BCRCA { light BCARDROCKET    }
    frame BCRCB { light BCARDROCKET    }

    frame BCRCC { light BCARDROCKET_X1 }
    frame BCRCD { light BCARDROCKET_X2 }
    frame BCRCE { light BCARDROCKET_X3 }
}